[{"start": 49.81, "end": 55.26, "text": "黄叔"}, {"start": 55.26, "end": 56.46, "text": "永年醒了"}, {"start": 56.46, "end": 58.06, "text": "夜来睡得可好"}, {"start": 58.06, "end": 59.26, "text": "恕罪恕罪"}, {"start": 60.26, "end": 62.46, "text": "你看我醉成什么样子"}, {"start": 62.46, "end": 63.66, "text": "永年不必说话"}, {"start": 67.42, "end": 68.62, "text": "且先吃了这杯茶"}, {"start": 68.62, "end": 69.82, "text": "刚刚真下的"}, {"start": 71.42, "end": 81.82, "text": "多谢多谢多谢黄叔"}, {"start": 81.82, "end": 83.22, "text": "酒席已备好"}, {"start": 83.22, "end": 84.82, "text": "请先生入席吧"}, {"start": 86.42, "end": 87.22, "text": "什么"}, {"start": 88.02, "end": 89.22, "text": "还要喝酒"}, {"start": 89.22, "end": 91.62, "text": "百年佳酿 恭候嘉宾"}, {"start": 93.02, "end": 94.42, "text": "刘黄叔啊"}, {"start": 94.42, "end": 97.42, "text": "你看你已经连续陪了我三天了"}, {"start": 98.22, "end": 100.82, "text": "叫张松暂生归多去啊"}, {"start": 100.82, "end": 102.42, "text": "永年这话就见外了"}, {"start": 103.02, "end": 105.22, "text": "你主公是无皇兄"}, {"start": 105.22, "end": 106.62, "text": "你是当今国士"}, {"start": 107.02, "end": 108.82, "text": "刘备能与君共罪"}, {"start": 108.82, "end": 110.42, "text": "实乃大魏平生啊"}, {"start": 112.22, "end": 113.42, "text": "区区在下"}, {"start": 113.42, "end": 115.02, "text": "手无缚鸡之力"}, {"start": 115.02, "end": 117.02, "text": "胸无出无贼之策"}, {"start": 117.42, "end": 118.82, "text": "谈何国士啊"}, {"start": 119.62, "end": 121.02, "text": "展观多爱"}, {"start": 121.02, "end": 123.22, "text": "与万君从中取上将首级"}, {"start": 123.22, "end": 125.02, "text": "那是关于张妃他们的事"}, {"start": 125.42, "end": 127.02, "text": "先生能与笑谈之间"}, {"start": 127.02, "end": 129.02, "text": "便骂得草草狗血喷头"}, {"start": 129.02, "end": 130.02, "text": "烟族破灭"}, {"start": 130.22, "end": 131.62, "text": "不是国士是神"}, {"start": 134.02, "end": 136.02, "text": "这和黄叔过奖了"}, {"start": 136.02, "end": 137.22, "text": "过奖了"}, {"start": 137.22, "end": 138.42, "text": "请先生更衣"}, {"start": 138.42, "end": 139.62, "text": "我在外恭候"}, {"start": 140.82, "end": 141.62, "text": "黄叔请"}, {"start": 157.04, "end": 157.64, "text": "主公"}, {"start": 157.84, "end": 159.24, "text": "内府有要事禀报"}, {"start": 159.44, "end": 160.44, "text": "什么事啊"}, {"start": 161.44, "end": 162.64, "text": "永年不是外人"}, {"start": 162.64, "end": 163.64, "text": "但说无妨"}, {"start": 164.44, "end": 166.24, "text": "夫人请主公过去一趟"}, {"start": 168.04, "end": 169.24, "text": "他不知道"}, {"start": 169.44, "end": 171.04, "text": "我在招待国士吗"}, {"start": 172.24, "end": 173.24, "text": "去告诉夫人"}, {"start": 173.64, "end": 174.84, "text": "不管有什么事情"}, {"start": 175.44, "end": 176.44, "text": "以后再说"}, {"start": 177.04, "end": 177.64, "text": "遵命"}, {"start": 178.24, "end": 178.84, "text": "来"}, {"start": 181.99, "end": 184.79, "text": "孙夫人是孙犬之妹"}, {"start": 185.19, "end": 186.59, "text": "青春年少"}, {"start": 186.99, "end": 188.79, "text": "又远离故土"}, {"start": 189.39, "end": 191.19, "text": "黄叔在这里"}, {"start": 191.19, "end": 193.39, "text": "已经陪了在下三天了"}, {"start": 195.35, "end": 200.22, "text": "还是快快回府吧"}, {"start": 200.22, "end": 202.22, "text": "妻子无衣服"}, {"start": 202.62, "end": 204.62, "text": "兄弟无生存"}, {"start": 205.02, "end": 207.62, "text": "何况是永年这样的国士"}, {"start": 207.82, "end": 209.82, "text": "更应该肝胆相照"}, {"start": 211.02, "end": 212.62, "text": "妻子什么时候不能见"}, {"start": 213.22, "end": 215.22, "text": "而永年千里而来"}, {"start": 215.82, "end": 217.82, "text": "我一年能见上几回啊"}, {"start": 218.22, "end": 218.62, "text": "来"}, {"start": 219.02, "end": 219.62, "text": "不用理他"}, {"start": 220.22, "end": 221.02, "text": "咱们接着喝"}, {"start": 232.08, "end": 233.48, "text": "看来永年兄"}, {"start": 233.48, "end": 235.28, "text": "很喜欢饮制新花春啊"}, {"start": 235.88, "end": 237.48, "text": "待先生归属时"}, {"start": 237.48, "end": 238.48, "text": "带上三车"}, {"start": 238.88, "end": 240.88, "text": "两车留给我皇兄刘璋"}, {"start": 241.08, "end": 242.48, "text": "一车留给先生"}, {"start": 243.68, "end": 244.88, "text": "多谢黄叔"}, {"start": 251.59, "end": 252.19, "text": "主公"}, {"start": 253.39, "end": 254.19, "text": "怎么了"}, {"start": 254.59, "end": 255.19, "text": "夫人"}, {"start": 255.79, "end": 256.99, "text": "夫人有些发火了"}, {"start": 256.99, "end": 258.39, "text": "请主公回去一趟呐"}, {"start": 258.59, "end": 259.59, "text": "夫人发火"}, {"start": 259.59, "end": 260.99, "text": "我就不能发火吗"}, {"start": 263.57, "end": 264.17, "text": "下去"}, {"start": 266.07, "end": 267.47, "text": "再敢扰我待客"}, {"start": 267.47, "end": 268.67, "text": "军法从事"}, {"start": 269.07, "end": 269.67, "text": "遵命"}, {"start": 280.22, "end": 281.62, "text": "都是因为我"}, {"start": 282.22, "end": 283.82, "text": "还是请黄叔"}, {"start": 283.82, "end": 287.18, "text": "快快回府吧"}, {"start": 287.18, "end": 287.98, "text": "主公啊"}, {"start": 288.38, "end": 289.18, "text": "我看"}, {"start": 289.78, "end": 290.78, "text": "你还是过去吧"}, {"start": 291.38, "end": 292.38, "text": "夫人脾气大"}, {"start": 292.38, "end": 293.78, "text": "还是不要得罪她"}, {"start": 294.78, "end": 296.18, "text": "好在张大人是朋友"}, {"start": 296.18, "end": 297.38, "text": "也不会见笑的"}, {"start": 297.38, "end": 303.23, "text": "人在屋檐下"}, {"start": 303.63, "end": 305.03, "text": "安能不低头"}, {"start": 306.03, "end": 307.23, "text": "荆州说到底"}, {"start": 307.83, "end": 309.23, "text": "还是向东吴借来的"}, {"start": 309.83, "end": 311.23, "text": "夫人就是仗着这个"}, {"start": 311.63, "end": 313.43, "text": "才敢向主公发火呀"}, {"start": 319.22, "end": 320.62, "text": "发脾气我就会害怕吗"}, {"start": 322.56, "end": 323.96, "text": "就算得罪了孙权"}, {"start": 323.96, "end": 324.96, "text": "又能怎么样"}, {"start": 326.16, "end": 327.96, "text": "就算得罪了整个江东"}, {"start": 328.56, "end": 330.96, "text": "我也不能失去永年这位朋友"}, {"start": 331.56, "end": 331.96, "text": "来"}, {"start": 340.65, "end": 341.25, "text": "请"}, {"start": 352.98, "end": 354.38, "text": "汉之毛贼义"}, {"start": 354.58, "end": 356.18, "text": "都持强凝弱"}, {"start": 356.78, "end": 358.98, "text": "侵占大汉城市"}, {"start": 360.38, "end": 362.78, "text": "黄叔是汉室宗亲"}, {"start": 363.18, "end": 364.18, "text": "仁义之名"}, {"start": 364.18, "end": 365.58, "text": "文娱天下"}, {"start": 365.78, "end": 369.62, "text": "李夏"}, {"start": 370.82, "end": 374.22, "text": "张松心有不平啊"}, {"start": 374.62, "end": 376.22, "text": "有何心有不平的"}, {"start": 377.42, "end": 379.42, "text": "我刘备何德何能"}, {"start": 380.82, "end": 383.42, "text": "能有荆州这样一个七身之地"}, {"start": 384.02, "end": 385.82, "text": "已经是心满意足了"}, {"start": 386.02, "end": 387.42, "text": "岂敢多往"}, {"start": 388.42, "end": 390.42, "text": "黄叔之言差矣"}, {"start": 391.02, "end": 393.02, "text": "以你的凶财大略"}, {"start": 393.42, "end": 395.42, "text": "别说是占据周军"}, {"start": 396.02, "end": 398.82, "text": "便是取许昌而居朝廷"}, {"start": 398.82, "end": 400.22, "text": "亦非奋败"}, {"start": 400.82, "end": 406.9, "text": "你醉了"}, {"start": 407.3, "end": 411.06, "text": "我刘备世代为汉臣"}, {"start": 411.86, "end": 413.46, "text": "永不敢叛汉"}, {"start": 418.66, "end": 419.66, "text": "到了今天"}, {"start": 420.46, "end": 423.46, "text": "还有人念念不忘自己是汉臣"}, {"start": 425.46, "end": 428.06, "text": "真是难得"}, {"start": 429.06, "end": 430.46, "text": "在我看来"}, {"start": 430.86, "end": 433.26, "text": "荆州东勇孙全"}, {"start": 433.46, "end": 435.66, "text": "常怀虎拒之心"}, {"start": 436.06, "end": 437.26, "text": "北有曹操"}, {"start": 437.46, "end": 439.66, "text": "早有京吞之意"}, {"start": 440.26, "end": 441.66, "text": "区区荆州"}, {"start": 443.06, "end": 444.86, "text": "非久恋之地啊"}, {"start": 445.86, "end": 446.66, "text": "是啊"}, {"start": 447.86, "end": 450.06, "text": "这个我知道"}, {"start": 451.46, "end": 453.06, "text": "但天下之大"}, {"start": 455.49, "end": 456.69, "text": "舍荆州"}, {"start": 457.49, "end": 460.69, "text": "而我刘备安身立命之地啊"}, {"start": 461.29, "end": 463.29, "text": "黄叔恕我直言"}, {"start": 464.29, "end": 466.49, "text": "一州有显色百处"}, {"start": 467.29, "end": 468.49, "text": "卧野千里"}, {"start": 469.09, "end": 471.89, "text": "民因国富良享足位"}, {"start": 472.49, "end": 474.49, "text": "川中智能之士"}, {"start": 474.49, "end": 477.29, "text": "无不久目黄叔之德"}, {"start": 478.09, "end": 481.29, "text": "黄叔若能起荆襄之君"}, {"start": 481.49, "end": 482.89, "text": "长驱西至"}, {"start": 483.29, "end": 485.09, "text": "以蜀中为基本"}, {"start": 485.29, "end": 488.09, "text": "数年之内则罢业可成"}, {"start": 488.29, "end": 490.29, "text": "汉氏兴矣"}, {"start": 490.29, "end": 495.41, "text": "郑年啊"}, {"start": 496.21, "end": 497.61, "text": "我当你是国士"}, {"start": 498.41, "end": 501.21, "text": "你怎么能说出这等悖逆之话呀"}, {"start": 502.01, "end": 502.81, "text": "别忘了"}, {"start": 503.81, "end": 506.81, "text": "你主刘继玉也是汉族皇亲"}, {"start": 507.61, "end": 509.41, "text": "是我同宗皇兄"}, {"start": 510.21, "end": 512.21, "text": "我怎能骨肉相识"}, {"start": 512.21, "end": 513.81, "text": "寝夺他的蜀地呢"}, {"start": 517.45, "end": 520.25, "text": "刘继玉随居一州牧"}, {"start": 520.65, "end": 522.85, "text": "却非贤君名主"}, {"start": 523.65, "end": 525.25, "text": "他秉性暗弱"}, {"start": 525.65, "end": 527.45, "text": "不能任贤用奴"}, {"start": 528.25, "end": 530.45, "text": "更有汉中张鲁"}, {"start": 530.65, "end": 532.85, "text": "他十四侵犯西川"}, {"start": 533.45, "end": 534.45, "text": "我来之计"}, {"start": 534.85, "end": 536.85, "text": "他已经大军压境"}, {"start": 538.05, "end": 541.65, "text": "竟把川蜀两县的土地说服"}, {"start": 541.65, "end": 543.25, "text": "强行受教"}, {"start": 543.85, "end": 545.45, "text": "那刘继玉对此"}, {"start": 545.45, "end": 547.85, "text": "竟然诺诺不至一词"}, {"start": 549.25, "end": 550.05, "text": "整日间"}, {"start": 550.85, "end": 552.85, "text": "只知对着美女作话"}, {"start": 553.65, "end": 554.85, "text": "这等君主"}, {"start": 555.45, "end": 557.05, "text": "能保有西川吗"}, {"start": 557.45, "end": 559.25, "text": "他配保有西川吗"}, {"start": 560.65, "end": 563.85, "text": "时下川中人心离散"}, {"start": 564.25, "end": 566.05, "text": "惶惶不可终日"}, {"start": 566.45, "end": 567.65, "text": "皇叔不娶"}, {"start": 567.65, "end": 570.05, "text": "难道要拱手让与张鲁"}, {"start": 570.65, "end": 572.25, "text": "或者坐视他"}, {"start": 572.45, "end": 574.25, "text": "落于曹操之手吗"}, {"start": 584.83, "end": 585.23, "text": "几位"}, {"start": 585.63, "end": 587.43, "text": "请随我来"}, {"start": 587.63, "end": 601.4, "text": "西川四十一郡祥图"}, {"start": 603.91, "end": 604.71, "text": "此图"}, {"start": 605.11, "end": 607.51, "text": "张松用了整整三年的时间"}, {"start": 607.51, "end": 608.31, "text": "把它画完"}, {"start": 608.91, "end": 612.71, "text": "书中地理形成山川险要"}, {"start": 613.31, "end": 614.51, "text": "兵营军阵"}, {"start": 614.71, "end": 616.11, "text": "府库钱粮"}, {"start": 616.31, "end": 617.51, "text": "尽在土中"}, {"start": 617.91, "end": 619.31, "text": "谁得到此图"}, {"start": 619.51, "end": 621.71, "text": "谁就能得到半个西川"}, {"start": 622.91, "end": 625.31, "text": "皇叔请过目"}, {"start": 636.85, "end": 638.25, "text": "皇叔为何不看"}, {"start": 643.65, "end": 644.65, "text": "我岂不知"}, {"start": 645.65, "end": 650.13, "text": "这图是天下之宝啊"}, {"start": 650.33, "end": 652.53, "text": "但这有如是林家的美玉"}, {"start": 653.53, "end": 655.33, "text": "君子岂能窥视"}, {"start": 655.93, "end": 656.73, "text": "况且"}, {"start": 657.33, "end": 658.33, "text": "这美玉"}, {"start": 658.73, "end": 660.53, "text": "是我自家皇兄的"}, {"start": 661.73, "end": 662.53, "text": "所以"}, {"start": 663.33, "end": 667.72, "text": "我不能看"}, {"start": 668.72, "end": 669.52, "text": "皇叔啊"}, {"start": 670.12, "end": 670.92, "text": "皇叔"}, {"start": 670.92, "end": 672.12, "text": "永年这是为何"}, {"start": 672.32, "end": 674.52, "text": "请皇叔不要再推辞了"}, {"start": 675.12, "end": 676.32, "text": "你若再推辞"}, {"start": 676.32, "end": 678.12, "text": "西川的百姓不答应"}, {"start": 678.12, "end": 680.92, "text": "大汉的百姓也不答应啊"}, {"start": 681.72, "end": 682.32, "text": "皇叔"}, {"start": 683.12, "end": 685.12, "text": "自董卓之乱之后"}, {"start": 685.72, "end": 687.92, "text": "汉时如西辰之日"}, {"start": 688.12, "end": 689.32, "text": "气息艳艳"}, {"start": 690.12, "end": 693.12, "text": "刘氏诸侯相继被人并吞"}, {"start": 694.77, "end": 697.77, "text": "如今就只有西川还姓刘"}, {"start": 698.57, "end": 701.57, "text": "可是书中誓死百姓都明白"}, {"start": 701.97, "end": 702.97, "text": "这个刘义州"}, {"start": 703.17, "end": 705.37, "text": "只怕是维持不了多久"}, {"start": 705.97, "end": 708.17, "text": "你如不娶不出两年"}, {"start": 708.57, "end": 710.57, "text": "义州一为一主"}, {"start": 711.97, "end": 713.17, "text": "你所声称的"}, {"start": 713.57, "end": 714.97, "text": "汉贼不两立"}, {"start": 714.97, "end": 716.17, "text": "王爷不偏安"}, {"start": 716.57, "end": 718.37, "text": "又有何意义"}, {"start": 718.77, "end": 720.57, "text": "岂非空眼吗"}, {"start": 722.82, "end": 723.62, "text": "皇叔啊"}, {"start": 724.42, "end": 725.82, "text": "为汉室忠心"}, {"start": 725.82, "end": 727.82, "text": "我甘愿赴被主之名"}, {"start": 728.22, "end": 729.42, "text": "舍弃刘章"}, {"start": 729.42, "end": 731.22, "text": "引皇叔入川"}, {"start": 732.02, "end": 734.82, "text": "还望皇叔以天下为重"}, {"start": 735.82, "end": 737.22, "text": "听张宗一言"}, {"start": 738.22, "end": 740.42, "text": "先娶西川为基本"}, {"start": 740.82, "end": 743.42, "text": "然后备途汉中"}, {"start": 743.82, "end": 745.82, "text": "再后收取中原"}, {"start": 746.22, "end": 747.62, "text": "匡政天朝"}, {"start": 748.62, "end": 752.42, "text": "如此皇叔可名垂青史"}, {"start": 752.42, "end": 754.42, "text": "忘故流芳啊"}, {"start": 757.84, "end": 758.84, "text": "禀主公"}, {"start": 759.04, "end": 760.64, "text": "蜀道曲起"}, {"start": 761.24, "end": 762.64, "text": "千山万水"}, {"start": 763.44, "end": 764.84, "text": "车不能方轨"}, {"start": 765.24, "end": 766.64, "text": "马不能连配"}, {"start": 767.44, "end": 769.84, "text": "从来都是一手难工啊"}, {"start": 770.64, "end": 773.64, "text": "现在有了永年兄这幅图"}, {"start": 774.24, "end": 776.24, "text": "又有永年兄做内应"}, {"start": 777.24, "end": 780.84, "text": "义州唾手可得呀"}, {"start": 789.18, "end": 790.78, "text": "永年御献西川"}, {"start": 791.18, "end": 793.18, "text": "乃是对大汉的一片忠诚"}, {"start": 794.18, "end": 795.58, "text": "你是汉室之后"}, {"start": 795.98, "end": 797.58, "text": "可不要负了永年"}, {"start": 797.58, "end": 799.38, "text": "一片赤诚之心呢"}, {"start": 799.58, "end": 817.12, "text": "永年请起"}, {"start": 818.99, "end": 819.79, "text": "永年啊"}, {"start": 820.39, "end": 822.59, "text": "刘备深谢你一片好意"}, {"start": 823.59, "end": 825.79, "text": "只是这仁义二字"}, {"start": 826.59, "end": 828.39, "text": "是我刘备的立身之本"}, {"start": 828.79, "end": 830.19, "text": "行使之命啊"}, {"start": 830.79, "end": 833.79, "text": "刘备就算九破之死"}, {"start": 834.79, "end": 836.79, "text": "也不能娶刘继义的西川"}, {"start": 836.99, "end": 843.8, "text": "天哪"}, {"start": 844.4, "end": 848.36, "text": "我蜀中为何就得不到"}, {"start": 848.36, "end": 850.36, "text": "贤君名主啊"}, {"start": 850.96, "end": 854.76, "text": "川民为何不能长治久安哪"}, {"start": 855.16, "end": 859.33, "text": "主公的脾气就是这么倔"}, {"start": 860.13, "end": 861.33, "text": "他心意已决"}, {"start": 861.33, "end": 863.33, "text": "从不做背信弃义之事"}, {"start": 863.53, "end": 864.53, "text": "永年兄"}, {"start": 876.68, "end": 880.68, "text": "你要真是想让刘皇叔入主属中"}, {"start": 881.08, "end": 883.88, "text": "那在下有一个办法"}, {"start": 884.28, "end": 885.28, "text": "什么办法"}, {"start": 885.68, "end": 887.68, "text": "西川不是面临险境吗"}, {"start": 888.68, "end": 890.28, "text": "只要你主公刘璋"}, {"start": 890.68, "end": 892.88, "text": "请我主公领兵铸川"}, {"start": 893.28, "end": 894.68, "text": "以计张若"}, {"start": 895.88, "end": 898.48, "text": "我家主公必去无疑"}, {"start": 898.88, "end": 900.68, "text": "刘皇叔刚刚说过"}, {"start": 900.88, "end": 903.28, "text": "刘皇叔刚才已经说了"}, {"start": 903.48, "end": 906.28, "text": "他意已决不去"}, {"start": 908.28, "end": 909.48, "text": "是在人为嘛"}, {"start": 911.48, "end": 912.28, "text": "你放心"}, {"start": 912.88, "end": 915.28, "text": "我自会想办法逼他去"}, {"start": 917.08, "end": 918.28, "text": "有这等法子"}, {"start": 919.48, "end": 927.4, "text": "永年你是我义州特使"}, {"start": 927.6, "end": 929.4, "text": "专程前往许昌朝贡"}, {"start": 930.0, "end": 932.4, "text": "草草不予相助也就罢了"}, {"start": 933.2, "end": 935.2, "text": "岂能将你乱绑打回呀"}, {"start": 936.0, "end": 936.6, "text": "主公"}, {"start": 937.8, "end": 940.0, "text": "在下连死都不惧"}, {"start": 940.4, "end": 942.2, "text": "何惧草草的棍棒"}, {"start": 944.91, "end": 946.91, "text": "在下悲愤的事"}, {"start": 947.11, "end": 948.91, "text": "草草正如此无礼"}, {"start": 949.91, "end": 951.11, "text": "入籍主公"}, {"start": 951.11, "end": 953.31, "text": "入籍我西川四十一军"}, {"start": 953.51, "end": 954.71, "text": "仕臣军民"}, {"start": 955.71, "end": 956.51, "text": "是啊"}, {"start": 958.11, "end": 959.11, "text": "想当年"}, {"start": 959.91, "end": 961.91, "text": "董卓在朝为相的时候"}, {"start": 962.31, "end": 964.51, "text": "他不过是军门一校尉而已"}, {"start": 965.51, "end": 966.31, "text": "论出身"}, {"start": 966.51, "end": 968.11, "text": "我是皇室宗亲"}, {"start": 968.51, "end": 969.91, "text": "他只是个宦官之后"}, {"start": 970.51, "end": 971.31, "text": "而如今"}, {"start": 971.71, "end": 974.51, "text": "他却视主公你为残序败流"}, {"start": 974.91, "end": 976.31, "text": "不配做义州之主"}, {"start": 977.71, "end": 979.51, "text": "那草草甚至暗藏"}, {"start": 979.51, "end": 981.31, "text": "夺取西川之心"}, {"start": 982.11, "end": 983.71, "text": "草草想图我西川"}, {"start": 984.31, "end": 984.91, "text": "正是"}, {"start": 986.31, "end": 988.71, "text": "在许昌大操场上"}, {"start": 989.51, "end": 991.31, "text": "那草草当入我的面"}, {"start": 991.71, "end": 993.31, "text": "悬要他的并位"}, {"start": 993.71, "end": 994.51, "text": "问道"}, {"start": 995.11, "end": 999.11, "text": "你们西川有如此的精兵强将吗"}, {"start": 999.71, "end": 1002.51, "text": "你们主公知道天下大事吗"}, {"start": 1003.51, "end": 1003.91, "text": "主公"}, {"start": 1004.31, "end": 1005.51, "text": "他这是在威胁你"}, {"start": 1005.71, "end": 1006.91, "text": "归乡于他呀"}, {"start": 1010.05, "end": 1013.05, "text": "草草确实有篡汉自立之心"}, {"start": 1013.85, "end": 1016.05, "text": "这是人所周知啊"}, {"start": 1017.45, "end": 1018.45, "text": "事已至此"}, {"start": 1019.65, "end": 1020.45, "text": "我当如何"}, {"start": 1026.23, "end": 1027.03, "text": "你们说呀"}, {"start": 1027.83, "end": 1029.83, "text": "主公不必过于多虑"}, {"start": 1030.63, "end": 1032.43, "text": "臣归属途中"}, {"start": 1032.43, "end": 1034.43, "text": "以私德一策"}, {"start": 1035.23, "end": 1035.83, "text": "快说"}, {"start": 1037.43, "end": 1038.63, "text": "荆州刘备"}, {"start": 1039.03, "end": 1040.63, "text": "与主公同宗"}, {"start": 1041.03, "end": 1043.23, "text": "他仁慈宽厚"}, {"start": 1043.43, "end": 1044.63, "text": "胸怀大志"}, {"start": 1045.23, "end": 1046.63, "text": "手下有关羽"}, {"start": 1046.83, "end": 1047.63, "text": "张飞"}, {"start": 1048.03, "end": 1050.23, "text": "赵云等数十猛将"}, {"start": 1050.43, "end": 1051.83, "text": "赤壁熬兵时"}, {"start": 1051.83, "end": 1053.63, "text": "就连草草都对他"}, {"start": 1053.63, "end": 1055.03, "text": "文风淡烈"}, {"start": 1055.83, "end": 1058.63, "text": "如果主公能前始节好"}, {"start": 1058.63, "end": 1060.63, "text": "那荆州引他为外援"}, {"start": 1061.43, "end": 1062.63, "text": "非但张鲁"}, {"start": 1062.63, "end": 1065.03, "text": "就连草草也不敢犯"}, {"start": 1067.83, "end": 1069.63, "text": "何不请他率军入川呢"}, {"start": 1070.83, "end": 1071.43, "text": "不可"}, {"start": 1071.83, "end": 1072.83, "text": "断断不可"}, {"start": 1073.43, "end": 1074.03, "text": "主公"}, {"start": 1074.23, "end": 1075.83, "text": "若听了张颂之言"}, {"start": 1076.03, "end": 1078.43, "text": "西川之地既属刘备"}, {"start": 1078.63, "end": 1080.23, "text": "此策万不可行"}, {"start": 1080.63, "end": 1081.63, "text": "你的意思是说"}, {"start": 1083.43, "end": 1085.83, "text": "刘备想趁势屠我西川"}, {"start": 1086.43, "end": 1087.03, "text": "正是"}, {"start": 1087.03, "end": 1088.83, "text": "刘备远得人心"}, {"start": 1088.83, "end": 1089.83, "text": "尽得民望"}, {"start": 1090.43, "end": 1092.63, "text": "更兼诸葛亮庞统之志"}, {"start": 1093.03, "end": 1094.43, "text": "观张赵之勇"}, {"start": 1095.23, "end": 1097.23, "text": "如果赵他入蜀中"}, {"start": 1097.23, "end": 1099.23, "text": "请问主公如何相待"}, {"start": 1100.03, "end": 1102.43, "text": "主公若以不取代之"}, {"start": 1102.63, "end": 1105.03, "text": "刘备岂肯浮低坐小"}, {"start": 1105.63, "end": 1107.83, "text": "主公若以克里相待"}, {"start": 1108.43, "end": 1110.83, "text": "那么一国岂能容二主"}, {"start": 1111.43, "end": 1112.43, "text": "时间已长"}, {"start": 1112.63, "end": 1114.43, "text": "刘备若反客为主"}, {"start": 1114.83, "end": 1117.43, "text": "主公又该当如何呀"}, {"start": 1118.63, "end": 1119.43, "text": "这"}, {"start": 1119.63, "end": 1121.43, "text": "黄泉之言有理啊"}, {"start": 1122.23, "end": 1124.23, "text": "汉中张颂犯戒"}, {"start": 1124.43, "end": 1126.23, "text": "乃险戒之急"}, {"start": 1127.03, "end": 1128.83, "text": "刘备如果入川"}, {"start": 1128.83, "end": 1130.63, "text": "必成心腹大患"}, {"start": 1131.23, "end": 1133.23, "text": "况且刘备原本为"}, {"start": 1133.23, "end": 1134.63, "text": "士之萧雄"}, {"start": 1135.23, "end": 1138.03, "text": "他先是曹操便图谋害"}, {"start": 1138.43, "end": 1141.23, "text": "后从孙泉更夺荆州"}, {"start": 1142.03, "end": 1144.23, "text": "此人心术如此"}, {"start": 1144.43, "end": 1147.43, "text": "岂可置于暗踏之监护"}, {"start": 1148.83, "end": 1150.83, "text": "况且我还听说"}, {"start": 1151.23, "end": 1153.63, "text": "有人出使许昌回来"}, {"start": 1153.63, "end": 1154.83, "text": "路过荆州"}, {"start": 1156.03, "end": 1158.03, "text": "是不是你和刘备"}, {"start": 1158.43, "end": 1159.63, "text": "商量好了吧"}, {"start": 1161.63, "end": 1162.23, "text": "丽颜"}, {"start": 1162.83, "end": 1165.43, "text": "你是说我沟通刘备了"}, {"start": 1166.03, "end": 1167.43, "text": "有何证据啊"}, {"start": 1168.03, "end": 1171.03, "text": "那你为何要去荆州啊"}, {"start": 1172.03, "end": 1174.83, "text": "荆州刘备仰慕主公"}, {"start": 1175.43, "end": 1177.63, "text": "闻我出使许昌"}, {"start": 1177.83, "end": 1179.63, "text": "特迎荆州境界"}, {"start": 1180.03, "end": 1182.43, "text": "托我带来了绸缎千匹"}, {"start": 1182.83, "end": 1184.23, "text": "美酒百坛"}, {"start": 1184.43, "end": 1185.83, "text": "女月十名"}, {"start": 1186.03, "end": 1187.23, "text": "敬献主公"}, {"start": 1188.23, "end": 1189.23, "text": "丽颜呢丽颜"}, {"start": 1190.43, "end": 1192.23, "text": "我向曹操入宫"}, {"start": 1192.63, "end": 1194.83, "text": "曹操将我棍棒打出"}, {"start": 1195.23, "end": 1198.03, "text": "而如今刘备给主公入宫"}, {"start": 1198.43, "end": 1200.83, "text": "你却要诬陷我为奸人"}, {"start": 1201.63, "end": 1205.23, "text": "难道你的心像与曹操吗"}, {"start": 1205.43, "end": 1206.03, "text": "你"}, {"start": 1206.63, "end": 1207.43, "text": "好了好了"}, {"start": 1208.83, "end": 1210.03, "text": "且说君情吧"}, {"start": 1211.23, "end": 1213.03, "text": "如果不请刘备相助"}, {"start": 1214.03, "end": 1216.23, "text": "张鲁率军亲我西川"}, {"start": 1216.43, "end": 1217.43, "text": "如何抵挡"}, {"start": 1218.43, "end": 1219.83, "text": "毕竟绝关"}, {"start": 1220.03, "end": 1222.43, "text": "深沟高雷已聚之"}, {"start": 1225.43, "end": 1226.43, "text": "天真"}, {"start": 1226.83, "end": 1229.23, "text": "马超是何等的孝勇"}, {"start": 1229.83, "end": 1231.43, "text": "深沟高雷"}, {"start": 1231.63, "end": 1234.23, "text": "能挡得住西梁铁骑吗"}, {"start": 1235.83, "end": 1236.43, "text": "主公"}, {"start": 1237.23, "end": 1240.43, "text": "刚才有人说我勾结了刘备"}, {"start": 1241.63, "end": 1242.63, "text": "我看这里"}, {"start": 1242.83, "end": 1245.63, "text": "有人勾结了张鲁才是真的呢"}, {"start": 1246.03, "end": 1246.63, "text": "张僧"}, {"start": 1246.83, "end": 1248.03, "text": "你胡说八道"}, {"start": 1248.23, "end": 1248.83, "text": "丽颜"}, {"start": 1250.23, "end": 1252.03, "text": "张鲁去年来犯"}, {"start": 1252.63, "end": 1254.03, "text": "你就劝主公"}, {"start": 1254.23, "end": 1255.63, "text": "毕竟绝关"}, {"start": 1255.83, "end": 1257.83, "text": "深沟高雷已聚之"}, {"start": 1258.03, "end": 1259.43, "text": "结果怎么样呢"}, {"start": 1259.63, "end": 1260.83, "text": "并败巫侠"}, {"start": 1260.83, "end": 1262.23, "text": "格地赔银"}, {"start": 1262.63, "end": 1265.23, "text": "今年张鲁拎马超来犯"}, {"start": 1265.23, "end": 1268.03, "text": "你又劝主公毕竟绝关"}, {"start": 1268.03, "end": 1270.23, "text": "深沟高雷已聚之"}, {"start": 1270.43, "end": 1273.03, "text": "难道我们西川是劳地"}, {"start": 1273.03, "end": 1275.63, "text": "永远就只能毕竟绝关"}, {"start": 1276.23, "end": 1278.43, "text": "难道我们主公是昏君"}, {"start": 1278.43, "end": 1280.23, "text": "就永远只能躲藏于"}, {"start": 1280.23, "end": 1282.63, "text": "深沟高雷的后面吗"}, {"start": 1284.5, "end": 1285.3, "text": "主公"}, {"start": 1286.1, "end": 1287.3, "text": "我们越是这样"}, {"start": 1287.3, "end": 1289.1, "text": "那张鲁胆子就越大"}, {"start": 1289.5, "end": 1291.7, "text": "为什么他永远是贱"}, {"start": 1291.7, "end": 1294.1, "text": "而我们就自干是盾"}, {"start": 1294.7, "end": 1295.9, "text": "长期以往"}, {"start": 1295.9, "end": 1298.5, "text": "贱必能击穿盾"}, {"start": 1300.37, "end": 1301.17, "text": "主公"}, {"start": 1302.17, "end": 1303.17, "text": "刘备之人"}, {"start": 1303.17, "end": 1304.97, "text": "天下无人不知"}, {"start": 1305.97, "end": 1306.97, "text": "如果主公"}, {"start": 1306.97, "end": 1308.97, "text": "连自己的皇室血脉"}, {"start": 1308.97, "end": 1309.97, "text": "都信不过"}, {"start": 1309.97, "end": 1313.17, "text": "那么天下还有谁也能可信"}, {"start": 1314.57, "end": 1316.17, "text": "请主公恕罪"}, {"start": 1316.77, "end": 1318.97, "text": "在下不忍作势"}, {"start": 1318.97, "end": 1320.57, "text": "西川威望"}, {"start": 1323.69, "end": 1328.05, "text": "告退了"}, {"start": 1332.55, "end": 1333.75, "text": "武艺已决"}, {"start": 1334.95, "end": 1336.55, "text": "派法政为正使"}, {"start": 1336.55, "end": 1337.55, "text": "前往荆州"}, {"start": 1348.58, "end": 1349.38, "text": "孝治"}, {"start": 1350.38, "end": 1352.18, "text": "你主公想让我"}, {"start": 1352.18, "end": 1354.58, "text": "带兵入川抵抗张鲁"}, {"start": 1355.58, "end": 1356.38, "text": "正是"}, {"start": 1357.18, "end": 1358.38, "text": "我主公"}, {"start": 1358.38, "end": 1360.38, "text": "邀皇叔入川"}, {"start": 1360.38, "end": 1361.78, "text": "如大汉"}, {"start": 1362.38, "end": 1368.56, "text": "望云霓呀"}, {"start": 1368.76, "end": 1381.59, "text": "为何"}, {"start": 1381.79, "end": 1382.79, "text": "孝治兄"}, {"start": 1383.59, "end": 1385.39, "text": "我们也有难处"}, {"start": 1385.79, "end": 1386.59, "text": "你看"}, {"start": 1387.19, "end": 1388.99, "text": "曹操虎视于北"}, {"start": 1389.39, "end": 1391.39, "text": "孙全狼窝于南"}, {"start": 1392.39, "end": 1394.99, "text": "再说本来我们兵马也不多"}, {"start": 1395.59, "end": 1397.79, "text": "如果主公分兵入川"}, {"start": 1398.39, "end": 1399.79, "text": "我们就有丧失"}, {"start": 1399.79, "end": 1401.19, "text": "荆州的危险"}, {"start": 1404.86, "end": 1406.06, "text": "世元这话"}, {"start": 1406.66, "end": 1408.66, "text": "我听着像是托词"}, {"start": 1409.26, "end": 1409.86, "text": "诸位"}, {"start": 1410.46, "end": 1412.46, "text": "时下曹孙刘三方"}, {"start": 1412.46, "end": 1415.26, "text": "已成三足鼎立之势"}, {"start": 1415.26, "end": 1416.46, "text": "你望我"}, {"start": 1416.46, "end": 1417.46, "text": "我望你"}, {"start": 1418.06, "end": 1419.06, "text": "他望他"}, {"start": 1419.26, "end": 1421.66, "text": "谁都不敢轻易起兵"}, {"start": 1422.66, "end": 1423.66, "text": "为何呢"}, {"start": 1424.46, "end": 1426.06, "text": "因为三家偷盼着"}, {"start": 1426.06, "end": 1427.86, "text": "另外两家打起了"}, {"start": 1427.86, "end": 1430.06, "text": "自己好从中毛利"}, {"start": 1430.26, "end": 1431.66, "text": "于是乎"}, {"start": 1432.46, "end": 1434.86, "text": "三家一时也就打不起来了"}, {"start": 1434.86, "end": 1435.66, "text": "比如"}, {"start": 1436.66, "end": 1438.86, "text": "曹操在中原实行三策"}, {"start": 1439.06, "end": 1440.06, "text": "养民"}, {"start": 1440.26, "end": 1441.06, "text": "吞啃"}, {"start": 1441.26, "end": 1442.06, "text": "休战"}, {"start": 1442.06, "end": 1443.46, "text": "所为何来"}, {"start": 1444.46, "end": 1447.46, "text": "其实他就是早看破这一点了"}, {"start": 1448.86, "end": 1451.46, "text": "孝之兄所言极是"}, {"start": 1451.86, "end": 1454.66, "text": "在下不敢高谈阔论了"}, {"start": 1455.06, "end": 1457.66, "text": "只好说些俗气话了"}, {"start": 1458.86, "end": 1459.66, "text": "请讲"}, {"start": 1460.26, "end": 1463.46, "text": "大军西川好用甚久"}, {"start": 1464.46, "end": 1466.26, "text": "而荆州地狭"}, {"start": 1467.06, "end": 1469.86, "text": "我们拿不出更多的粮饷了"}, {"start": 1469.86, "end": 1470.66, "text": "世元"}, {"start": 1471.06, "end": 1472.66, "text": "这可不是俗话"}, {"start": 1473.46, "end": 1475.46, "text": "反而说了句实在话"}, {"start": 1475.86, "end": 1476.66, "text": "同样"}, {"start": 1477.46, "end": 1479.86, "text": "我也跟列位说句实在话"}, {"start": 1480.66, "end": 1482.86, "text": "我主要皇叔入川"}, {"start": 1483.26, "end": 1485.06, "text": "主要是想借皇叔"}, {"start": 1485.26, "end": 1487.66, "text": "和各位将军的威名"}, {"start": 1487.66, "end": 1489.26, "text": "来震慑张罗"}, {"start": 1489.26, "end": 1489.86, "text": "还有"}, {"start": 1490.06, "end": 1492.26, "text": "西川物产丰盛"}, {"start": 1492.26, "end": 1493.66, "text": "粮饷富足"}, {"start": 1493.66, "end": 1495.86, "text": "而且我主有言在先"}, {"start": 1495.86, "end": 1497.66, "text": "皇叔若能入川"}, {"start": 1497.86, "end": 1501.06, "text": "粮饷全部由树中供给"}, {"start": 1510.07, "end": 1510.87, "text": "孝之"}, {"start": 1511.67, "end": 1512.67, "text": "既然你主公"}, {"start": 1512.67, "end": 1514.47, "text": "把话都说到这个份上了"}, {"start": 1515.07, "end": 1517.07, "text": "我深为感动"}, {"start": 1519.68, "end": 1521.88, "text": "是经奸臣当道"}, {"start": 1521.88, "end": 1523.28, "text": "汉氏轻微"}, {"start": 1523.28, "end": 1525.88, "text": "在天下各州墓里的汉氏血脉"}, {"start": 1526.08, "end": 1528.48, "text": "也只有皇兄留记忆于我了"}, {"start": 1528.88, "end": 1531.08, "text": "皇兄有难我岂能袖手"}, {"start": 1531.68, "end": 1534.28, "text": "皇兄有命我岂能不尊呢"}, {"start": 1534.68, "end": 1535.68, "text": "只是如今"}, {"start": 1536.28, "end": 1538.88, "text": "确实两相匮乏"}, {"start": 1539.28, "end": 1541.08, "text": "所以才为难他"}, {"start": 1541.48, "end": 1542.68, "text": "如此说来"}, {"start": 1543.48, "end": 1545.48, "text": "皇叔答应入川了"}, {"start": 1545.88, "end": 1547.68, "text": "府中前途"}, {"start": 1547.68, "end": 1549.08, "text": "灿烂啊"}, {"start": 1550.28, "end": 1551.28, "text": "对了 皇叔"}, {"start": 1551.48, "end": 1554.28, "text": "我这儿有一封张松给你的信"}, {"start": 1571.8, "end": 1575.0, "text": "原来孝之与永年是至交啊"}, {"start": 1575.8, "end": 1576.6, "text": "正是"}, {"start": 1577.0, "end": 1578.8, "text": "不瞒皇叔与各位"}, {"start": 1579.2, "end": 1581.0, "text": "就是我劝张松"}, {"start": 1581.2, "end": 1582.6, "text": "把西川相途"}, {"start": 1582.8, "end": 1584.0, "text": "献于皇叔的"}, {"start": 1590.19, "end": 1591.99, "text": "一将无能"}, {"start": 1592.39, "end": 1594.59, "text": "累死三军"}, {"start": 1595.19, "end": 1596.59, "text": "如果人主无能"}, {"start": 1596.59, "end": 1598.59, "text": "岂不祸满天下"}, {"start": 1599.59, "end": 1601.59, "text": "书中有实之事"}, {"start": 1601.59, "end": 1603.99, "text": "谁都知道刘章昏庸"}, {"start": 1604.39, "end": 1605.39, "text": "西川"}, {"start": 1605.59, "end": 1608.19, "text": "迟早会落入贼人之手"}, {"start": 1608.19, "end": 1609.39, "text": "与其如此"}, {"start": 1609.39, "end": 1611.59, "text": "不如让有德者举之"}, {"start": 1613.82, "end": 1614.62, "text": "皇叔"}, {"start": 1615.02, "end": 1617.22, "text": "此次刘章面对张鲁的威胁"}, {"start": 1617.22, "end": 1618.82, "text": "是惊慌失措"}, {"start": 1618.82, "end": 1619.62, "text": "为此"}, {"start": 1621.59, "end": 1623.79, "text": "我等求皇叔入川"}, {"start": 1623.79, "end": 1626.79, "text": "还望皇叔顺势而为"}, {"start": 1627.39, "end": 1630.59, "text": "莫失良机啊 皇叔"}, {"start": 1631.99, "end": 1632.79, "text": "孝之兄"}, {"start": 1636.52, "end": 1638.52, "text": "难得你一片热忱"}, {"start": 1639.72, "end": 1642.52, "text": "只是我与刘继玉乃同宗"}, {"start": 1643.12, "end": 1644.32, "text": "此次入川"}, {"start": 1644.72, "end": 1647.72, "text": "我只是帮他抵抗张鲁"}, {"start": 1647.72, "end": 1649.12, "text": "报敬安民"}, {"start": 1649.12, "end": 1650.72, "text": "绝无非分之想"}, {"start": 1656.34, "end": 1659.14, "text": "交辽尚存意志"}, {"start": 1659.74, "end": 1662.74, "text": "狡兔犹藏三窟"}, {"start": 1663.54, "end": 1665.94, "text": "何况人无"}, {"start": 1666.54, "end": 1667.54, "text": "况且"}, {"start": 1667.94, "end": 1669.94, "text": "荆州东有孙权"}, {"start": 1669.94, "end": 1671.14, "text": "北有曹操"}, {"start": 1671.14, "end": 1672.74, "text": "难以回旋"}, {"start": 1672.74, "end": 1674.54, "text": "而益州户口百万"}, {"start": 1674.54, "end": 1675.74, "text": "土广财富"}, {"start": 1675.74, "end": 1677.14, "text": "可资大业"}, {"start": 1678.14, "end": 1680.54, "text": "更有张松与我等为内助"}, {"start": 1681.54, "end": 1683.54, "text": "如此天赐良机"}, {"start": 1685.96, "end": 1686.56, "text": "皇叔"}, {"start": 1695.48, "end": 1696.28, "text": "孝之啊"}, {"start": 1697.28, "end": 1698.08, "text": "当时"}, {"start": 1699.08, "end": 1702.08, "text": "与乌水火相敌者曹操"}, {"start": 1703.08, "end": 1705.88, "text": "曹操以疾 乌以宽"}, {"start": 1706.48, "end": 1708.68, "text": "曹操以暴 乌以仁"}, {"start": 1709.48, "end": 1711.68, "text": "曹操以绝 乌以忠"}, {"start": 1712.68, "end": 1715.68, "text": "没与操相反 则事可长"}, {"start": 1715.88, "end": 1720.1, "text": "是我本 是我命"}, {"start": 1721.1, "end": 1722.5, "text": "屈尔代之的话"}, {"start": 1723.1, "end": 1724.7, "text": "请族家不要再说了"}, {"start": 1725.7, "end": 1739.89, "text": "大哥也真是"}, {"start": 1740.69, "end": 1742.49, "text": "到手的地盘他都不要"}, {"start": 1743.29, "end": 1743.89, "text": "哼"}, {"start": 1744.69, "end": 1746.09, "text": "等跟大哥入了川"}, {"start": 1747.09, "end": 1748.69, "text": "不管他同意不同意"}, {"start": 1749.89, "end": 1751.09, "text": "你我只管动手"}, {"start": 1751.49, "end": 1752.89, "text": "先站了一周再说"}, {"start": 1755.6, "end": 1757.0, "text": "你们以为主公"}, {"start": 1757.4, "end": 1759.6, "text": "真的不想娶西川吗"}, {"start": 1760.4, "end": 1761.0, "text": "军师"}, {"start": 1761.6, "end": 1762.6, "text": "先生来了"}, {"start": 1762.6, "end": 1763.6, "text": "先生请坐"}, {"start": 1769.66, "end": 1770.66, "text": "先生喝完酒"}, {"start": 1774.34, "end": 1775.74, "text": "先生刚才说什么来着"}, {"start": 1776.34, "end": 1777.74, "text": "照先生的意思"}, {"start": 1777.74, "end": 1779.14, "text": "是大哥心里想"}, {"start": 1779.14, "end": 1780.34, "text": "这嘴上不说呀"}, {"start": 1782.49, "end": 1785.09, "text": "主公胸有大志"}, {"start": 1786.09, "end": 1788.49, "text": "一直梦想忠心汉食"}, {"start": 1789.29, "end": 1790.69, "text": "要想忠心汉食"}, {"start": 1791.29, "end": 1792.69, "text": "就少不了土地"}, {"start": 1793.49, "end": 1795.89, "text": "一周卧绕千里"}, {"start": 1796.29, "end": 1798.69, "text": "主公岂能不动心呢"}, {"start": 1800.95, "end": 1803.95, "text": "那他为何一再拒绝"}, {"start": 1804.35, "end": 1805.55, "text": "张松和法政呢"}, {"start": 1806.15, "end": 1806.75, "text": "就是啊"}, {"start": 1810.17, "end": 1810.97, "text": "这其一"}, {"start": 1812.17, "end": 1814.37, "text": "刘章是奉了天子使命"}, {"start": 1814.97, "end": 1816.97, "text": "出掌西川的"}, {"start": 1817.37, "end": 1820.37, "text": "而且已经至川十多年了"}, {"start": 1821.37, "end": 1822.77, "text": "主公要娶西川"}, {"start": 1824.17, "end": 1824.97, "text": "必须要到"}, {"start": 1825.57, "end": 1827.77, "text": "不得不娶的时候才能娶"}, {"start": 1829.17, "end": 1830.77, "text": "起码让世人看得见"}, {"start": 1830.77, "end": 1831.77, "text": "也是如此"}, {"start": 1832.97, "end": 1833.57, "text": "否则"}, {"start": 1834.77, "end": 1836.17, "text": "西川的官吏"}, {"start": 1836.77, "end": 1837.97, "text": "这心不服啊"}, {"start": 1839.17, "end": 1841.77, "text": "蜀中的百姓也会唾骂"}, {"start": 1842.97, "end": 1843.97, "text": "这个道理"}, {"start": 1845.17, "end": 1847.37, "text": "主公是再明白不过了"}, {"start": 1847.97, "end": 1849.77, "text": "主公要不娶西川"}, {"start": 1850.57, "end": 1851.57, "text": "就不会入川"}, {"start": 1852.17, "end": 1852.77, "text": "入了"}, {"start": 1853.57, "end": 1854.77, "text": "早晚必娶"}, {"start": 1855.37, "end": 1856.17, "text": "何时娶"}, {"start": 1857.37, "end": 1860.37, "text": "这必须要等待时机呀"}, {"start": 1862.77, "end": 1863.17, "text": "好"}, {"start": 1863.57, "end": 1863.97, "text": "好"}, {"start": 1866.17, "end": 1866.77, "text": "再者"}, {"start": 1868.57, "end": 1869.97, "text": "张松和法政二人"}, {"start": 1871.37, "end": 1872.97, "text": "他们是真心的"}, {"start": 1873.97, "end": 1875.57, "text": "要主公娶西川"}, {"start": 1876.77, "end": 1878.37, "text": "还是奉了刘章之命"}, {"start": 1878.57, "end": 1879.37, "text": "前来试探"}, {"start": 1880.17, "end": 1880.77, "text": "这要"}, {"start": 1881.57, "end": 1882.57, "text": "视目相看"}, {"start": 1883.97, "end": 1884.77, "text": "你们两个"}, {"start": 1885.77, "end": 1887.37, "text": "跟随主公这么多年了"}, {"start": 1887.77, "end": 1888.97, "text": "怎么就不明白呢"}, {"start": 1889.77, "end": 1891.17, "text": "那主公做事"}, {"start": 1891.57, "end": 1893.57, "text": "向来是滴水不漏啊"}, {"start": 1897.06, "end": 1897.86, "text": "明白了"}, {"start": 1898.06, "end": 1898.86, "text": "明白了"}, {"start": 1900.06, "end": 1903.56, "text": "我和二哥一入了川"}, {"start": 1904.36, "end": 1905.96, "text": "不管大哥愿意不愿意"}, {"start": 1906.96, "end": 1908.16, "text": "如果大哥不动手"}, {"start": 1908.76, "end": 1909.56, "text": "我们就下手"}, {"start": 1909.96, "end": 1910.36, "text": "不"}, {"start": 1915.37, "end": 1916.17, "text": "你们俩"}, {"start": 1917.77, "end": 1918.77, "text": "谁都不能娶"}, {"start": 1920.17, "end": 1920.57, "text": "为何"}, {"start": 1923.95, "end": 1927.15, "text": "这靖州必须要有重兵把守"}, {"start": 1927.95, "end": 1929.35, "text": "你们二人还有子弓"}, {"start": 1929.75, "end": 1930.75, "text": "必须得留下"}, {"start": 1931.15, "end": 1932.55, "text": "才能镇得住孙全"}, {"start": 1933.75, "end": 1934.75, "text": "这齐二呢"}, {"start": 1935.75, "end": 1937.75, "text": "主公如果把你们二位重将"}, {"start": 1937.75, "end": 1938.75, "text": "调往西川"}, {"start": 1940.15, "end": 1942.95, "text": "那刘章岂不是更担心了吗"}, {"start": 1943.35, "end": 1944.35, "text": "他的部署"}, {"start": 1944.95, "end": 1946.55, "text": "岂不是更寒心了吗"}, {"start": 1947.95, "end": 1948.95, "text": "那我们不去"}, {"start": 1949.55, "end": 1950.95, "text": "谁替大哥打一招啊"}, {"start": 1951.35, "end": 1952.35, "text": "刘章岸弱"}, {"start": 1953.35, "end": 1954.35, "text": "他的手下"}, {"start": 1954.75, "end": 1957.15, "text": "没有几个能争善战的将军"}, {"start": 1959.55, "end": 1961.75, "text": "主公有皇中魏炎相随"}, {"start": 1964.11, "end": 1964.91, "text": "还有在下"}, {"start": 1966.11, "end": 1967.71, "text": "足能够对付川军"}, {"start": 1968.51, "end": 1970.71, "text": "如果实在不行"}, {"start": 1971.51, "end": 1973.11, "text": "再调你们二位重将"}, {"start": 1973.51, "end": 1974.31, "text": "也不迟啊"}, {"start": 1975.71, "end": 1976.31, "text": "好"}, {"start": 1976.71, "end": 1977.31, "text": "军师"}, {"start": 1977.51, "end": 1978.51, "text": "来 喝"}, {"start": 1978.71, "end": 1979.31, "text": "来"}, {"start": 1979.71, "end": 1980.31, "text": "喝"}, {"start": 1989.82, "end": 1991.02, "text": "五弟刘玄德"}, {"start": 1991.22, "end": 1993.42, "text": "果然是仁义时君哪"}, {"start": 1995.42, "end": 1996.62, "text": "我卓发征一请"}, {"start": 1996.82, "end": 1998.62, "text": "他立刻带兵入川了"}, {"start": 1999.62, "end": 2001.82, "text": "这已经是半个月前的事了"}, {"start": 2002.62, "end": 2003.62, "text": "刘备此时"}, {"start": 2003.82, "end": 2005.82, "text": "已经进入川境"}, {"start": 2007.42, "end": 2009.22, "text": "真是兵贵神速啊"}, {"start": 2009.22, "end": 2010.42, "text": "他们现在在哪里"}, {"start": 2011.42, "end": 2014.02, "text": "据报刘备大军一锅四马关"}, {"start": 2014.22, "end": 2016.22, "text": "沿途秋毫未损"}, {"start": 2016.82, "end": 2017.82, "text": "好啊"}, {"start": 2018.62, "end": 2020.22, "text": "真是仁义之君"}, {"start": 2020.42, "end": 2022.22, "text": "就有仁义之师啊"}, {"start": 2022.82, "end": 2023.42, "text": "主公"}, {"start": 2024.42, "end": 2026.83, "text": "在下觉得"}, {"start": 2027.23, "end": 2028.63, "text": "刘备越是这样"}, {"start": 2028.83, "end": 2030.23, "text": "我们越要小心啊"}, {"start": 2030.43, "end": 2032.03, "text": "真是在收买人心啊"}, {"start": 2033.83, "end": 2035.43, "text": "请问黄大人"}, {"start": 2036.03, "end": 2037.83, "text": "倘若秋毫无犯"}, {"start": 2038.03, "end": 2039.23, "text": "是实在的事"}, {"start": 2039.23, "end": 2042.03, "text": "秋毫无犯是收买人心"}, {"start": 2042.23, "end": 2044.03, "text": "莫非你是想让人家"}, {"start": 2044.23, "end": 2045.83, "text": "奸淫烧杀吗"}, {"start": 2048.81, "end": 2049.61, "text": "荒唐"}, {"start": 2051.21, "end": 2051.81, "text": "主公"}, {"start": 2052.01, "end": 2053.61, "text": "此次刘备入川"}, {"start": 2053.81, "end": 2055.41, "text": "只带了三万人马"}, {"start": 2055.81, "end": 2058.61, "text": "关张 赵等将军一个没带"}, {"start": 2059.41, "end": 2062.01, "text": "这是像取西川的样子吗"}, {"start": 2063.61, "end": 2065.81, "text": "主公有十万大军"}, {"start": 2066.01, "end": 2068.61, "text": "刘备就凭这三万人马"}, {"start": 2068.61, "end": 2070.81, "text": "想攻占我义州"}, {"start": 2071.01, "end": 2072.41, "text": "这可能吗"}, {"start": 2073.81, "end": 2075.61, "text": "永年说得是啊"}, {"start": 2077.21, "end": 2078.01, "text": "主公"}, {"start": 2078.41, "end": 2080.41, "text": "刘备千里而来"}, {"start": 2080.61, "end": 2082.81, "text": "且已经进入川境"}, {"start": 2084.01, "end": 2085.41, "text": "在下之见"}, {"start": 2085.81, "end": 2088.61, "text": "是请主公顺将而下"}, {"start": 2089.01, "end": 2090.41, "text": "迎他一程"}, {"start": 2091.01, "end": 2093.01, "text": "这既是主公之礼"}, {"start": 2093.21, "end": 2095.61, "text": "又可以试探其君"}, {"start": 2096.21, "end": 2097.01, "text": "不错"}, {"start": 2097.61, "end": 2098.81, "text": "我是该去啊"}, {"start": 2099.21, "end": 2101.21, "text": "你看迎到哪里"}, {"start": 2101.41, "end": 2103.81, "text": "福城是川东重镇"}, {"start": 2104.01, "end": 2106.41, "text": "而且是水路两路码头"}, {"start": 2106.61, "end": 2107.41, "text": "都方便"}, {"start": 2107.61, "end": 2110.81, "text": "主公就在福城相迎好了"}, {"start": 2111.41, "end": 2112.21, "text": "永年"}, {"start": 2113.21, "end": 2116.01, "text": "你立即准备车程仗漫"}, {"start": 2116.61, "end": 2119.61, "text": "令上将张任率军三千"}, {"start": 2119.81, "end": 2121.21, "text": "随同我去福城"}, {"start": 2121.41, "end": 2122.41, "text": "告诉他"}, {"start": 2122.81, "end": 2124.21, "text": "所率兵士"}, {"start": 2124.41, "end": 2126.81, "text": "务必个个是川军壮士"}, {"start": 2127.41, "end": 2129.61, "text": "营中要骑甲鲜明"}, {"start": 2129.81, "end": 2132.21, "text": "士族的刀枪要闪亮"}, {"start": 2132.81, "end": 2135.21, "text": "定要向刘备展示一下"}, {"start": 2135.41, "end": 2137.21, "text": "我属中的军威"}, {"start": 2138.21, "end": 2139.41, "text": "主公明鉴"}, {"start": 2140.01, "end": 2140.81, "text": "不可呀"}, {"start": 2143.1, "end": 2145.1, "text": "主公是义州之主"}, {"start": 2145.3, "end": 2147.5, "text": "岂可轻身前去福城"}, {"start": 2147.9, "end": 2151.1, "text": "况且如果刘备起了谋反之心"}, {"start": 2151.3, "end": 2153.9, "text": "顺势将主公拿下了怎么办"}, {"start": 2154.3, "end": 2155.5, "text": "主公若有难"}, {"start": 2155.7, "end": 2157.7, "text": "川叔必是大乱"}, {"start": 2159.7, "end": 2161.3, "text": "李大人呢 李大人"}, {"start": 2161.5, "end": 2165.1, "text": "为何人人在你眼里都是贼呢"}, {"start": 2166.1, "end": 2170.3, "text": "为何既请人家又防着人家"}, {"start": 2171.3, "end": 2174.7, "text": "主公 李爷所律有理啊"}, {"start": 2175.1, "end": 2177.3, "text": "请归请 防归防"}, {"start": 2177.5, "end": 2179.9, "text": "刀枪无情不得不防啊"}, {"start": 2180.1, "end": 2182.1, "text": "请主公纳其忠言"}, {"start": 2182.3, "end": 2185.1, "text": "不要轻身履兵离冤哪"}, {"start": 2185.5, "end": 2186.5, "text": "黄泉"}, {"start": 2186.9, "end": 2187.7, "text": "黄泉"}, {"start": 2187.9, "end": 2189.1, "text": "你这是在离间"}, {"start": 2189.3, "end": 2191.7, "text": "主公和刘备的皇室亲情"}, {"start": 2195.3, "end": 2196.1, "text": "在下以为"}, {"start": 2196.3, "end": 2198.3, "text": "宜人不用 用人不宜"}, {"start": 2198.5, "end": 2199.5, "text": "明君也"}, {"start": 2200.3, "end": 2201.9, "text": "妾用 妾宜"}, {"start": 2202.1, "end": 2204.3, "text": "半盈半聚 用君也"}, {"start": 2204.9, "end": 2207.3, "text": "敢请主公三思"}, {"start": 2217.46, "end": 2218.66, "text": "无意早已决"}, {"start": 2219.06, "end": 2221.86, "text": "都是儿等三番五次的进缠"}, {"start": 2222.06, "end": 2223.26, "text": "你们如果有本事"}, {"start": 2223.46, "end": 2225.46, "text": "去杀张鲁 去灭曹操啊"}, {"start": 2225.66, "end": 2227.06, "text": "如果没有这个本领"}, {"start": 2227.26, "end": 2229.46, "text": "就不要阻止我出营刘备"}, {"start": 2232.41, "end": 2234.21, "text": "主公 主公"}, {"start": 2234.41, "end": 2235.81, "text": "不能去啊 主公"}, {"start": 2236.01, "end": 2236.61, "text": "让开"}, {"start": 2237.01, "end": 2238.61, "text": "主公"}, {"start": 2239.01, "end": 2241.61, "text": "我与人人相会 如亲之兰"}, {"start": 2241.81, "end": 2243.21, "text": "你却屡次如我"}, {"start": 2243.61, "end": 2244.01, "text": "左右"}, {"start": 2244.01, "end": 2244.41, "text": "在"}, {"start": 2244.61, "end": 2245.01, "text": "主公"}, {"start": 2245.01, "end": 2246.61, "text": "与我把黄武恒拉开"}, {"start": 2246.81, "end": 2247.41, "text": "若"}, {"start": 2248.21, "end": 2250.45, "text": "松口"}, {"start": 2251.05, "end": 2251.85, "text": "畜生"}, {"start": 2252.25, "end": 2253.25, "text": "松口"}, {"start": 2255.45, "end": 2256.25, "text": "松口"}, {"start": 2256.45, "end": 2257.25, "text": "畜生"}, {"start": 2261.3, "end": 2263.5, "text": "主公 主公"}, {"start": 2263.7, "end": 2266.1, "text": "不能去啊 主公"}, {"start": 2266.9, "end": 2270.3, "text": "去不得啊 主公"}, {"start": 2285.96, "end": 2286.56, "text": "主公"}, {"start": 2286.56, "end": 2288.16, "text": "郭佑政臣家中正子"}, {"start": 2288.16, "end": 2289.36, "text": "黄光和众议之言"}, {"start": 2289.36, "end": 2290.76, "text": "主公不能不听啊"}, {"start": 2290.96, "end": 2292.96, "text": "现在阻止刘备还不晚"}, {"start": 2293.16, "end": 2294.96, "text": "如果让刘备进入福城"}, {"start": 2294.96, "end": 2296.76, "text": "让他进入川树之地"}, {"start": 2297.36, "end": 2299.16, "text": "那就是龙入海虎进山"}, {"start": 2299.36, "end": 2301.56, "text": "川树之地尽失啊 主公"}, {"start": 2303.96, "end": 2305.56, "text": "刘备是我宗兄"}, {"start": 2305.96, "end": 2307.16, "text": "血脉相亲"}, {"start": 2307.96, "end": 2309.56, "text": "儿等为何一再蛊惑"}, {"start": 2309.76, "end": 2311.16, "text": "再言者必斩"}, {"start": 2311.56, "end": 2311.96, "text": "主公"}, {"start": 2311.96, "end": 2312.36, "text": "让开"}, {"start": 2312.36, "end": 2314.56, "text": "去不得啊 主公"}, {"start": 2314.96, "end": 2315.56, "text": "主公"}, {"start": 2315.56, "end": 2316.96, "text": "左右 乱报打散"}, {"start": 2316.96, "end": 2317.36, "text": "遵命"}, {"start": 2317.36, "end": 2317.96, "text": "主公"}, {"start": 2318.16, "end": 2341.69, "text": "闪开 闪开"}, {"start": 2341.69, "end": 2342.49, "text": "你想干什么"}, {"start": 2342.49, "end": 2344.09, "text": "义州同事王磊"}, {"start": 2345.29, "end": 2348.09, "text": "弃血而诫"}, {"start": 2348.69, "end": 2352.09, "text": "吾闻两药苦口利于病"}, {"start": 2352.69, "end": 2354.29, "text": "种言逆耳"}, {"start": 2355.29, "end": 2356.89, "text": "利于刑"}, {"start": 2357.69, "end": 2361.29, "text": "今日主公亲身入险境"}, {"start": 2362.29, "end": 2363.09, "text": "必然"}, {"start": 2364.29, "end": 2366.09, "text": "有去无回"}, {"start": 2366.69, "end": 2370.09, "text": "若主公斩张诵 拒刘备"}, {"start": 2370.69, "end": 2373.29, "text": "则西川老幼兴盛"}, {"start": 2373.89, "end": 2376.69, "text": "主公今夜兴盛哪"}, {"start": 2377.49, "end": 2378.69, "text": "而越是剑"}, {"start": 2379.09, "end": 2380.29, "text": "我越是要去"}, {"start": 2381.09, "end": 2382.69, "text": "西川连年败落"}, {"start": 2382.89, "end": 2385.09, "text": "就是败在你们这些庸臣手里"}, {"start": 2385.89, "end": 2388.29, "text": "苍天哪"}, {"start": 2388.49, "end": 2391.09, "text": "王鼠啊"}, {"start": 2391.09, "end": 2413.1, "text": "将军"}, {"start": 2413.1, "end": 2414.5, "text": "三千金状皆一点急"}, {"start": 2414.9, "end": 2415.9, "text": "请将军下令"}, {"start": 2416.3, "end": 2417.5, "text": "主公已出义州"}, {"start": 2417.9, "end": 2420.3, "text": "前往福城会见刘备"}, {"start": 2420.9, "end": 2424.1, "text": "各营四经造饭 五经出营"}, {"start": 2424.5, "end": 2426.3, "text": "随我护卫主公"}, {"start": 2426.7, "end": 2427.5, "text": "遵命"}, {"start": 2430.69, "end": 2432.69, "text": "张将军 张将军"}, {"start": 2433.69, "end": 2434.49, "text": "张将军"}, {"start": 2434.69, "end": 2435.29, "text": "黄大人"}, {"start": 2435.29, "end": 2439.77, "text": "你 你怎么弄得一身伤血啊"}, {"start": 2440.17, "end": 2440.77, "text": "张将军"}, {"start": 2441.37, "end": 2443.97, "text": "你真的只带三千人去福城"}, {"start": 2444.57, "end": 2446.57, "text": "主公命我率三千金状护驾"}, {"start": 2447.37, "end": 2449.37, "text": "我等自然奉命行事"}, {"start": 2450.17, "end": 2452.57, "text": "如果主公一受奸人蒙蔽"}, {"start": 2452.77, "end": 2453.97, "text": "正前往虎口"}, {"start": 2454.37, "end": 2455.17, "text": "你怎么办"}, {"start": 2455.77, "end": 2456.77, "text": "你身为将军"}, {"start": 2456.97, "end": 2458.37, "text": "难道就见死不救吗"}, {"start": 2459.57, "end": 2461.97, "text": "大人 此话何意"}, {"start": 2463.57, "end": 2465.17, "text": "刘备是虎狼之辈"}, {"start": 2465.57, "end": 2467.37, "text": "手下既是百战之士"}, {"start": 2467.77, "end": 2469.17, "text": "如果他在福城动手"}, {"start": 2469.17, "end": 2470.17, "text": "劫杀主公"}, {"start": 2470.97, "end": 2471.97, "text": "你三千人"}, {"start": 2472.17, "end": 2473.37, "text": "如何敌得过他们"}, {"start": 2473.57, "end": 2475.17, "text": "如何获得助主公啊"}, {"start": 2475.37, "end": 2477.37, "text": "那以大人之见"}, {"start": 2478.17, "end": 2479.17, "text": "我该怎么办"}, {"start": 2479.97, "end": 2481.57, "text": "你带三万人前往"}]