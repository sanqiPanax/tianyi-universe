[{"start": 62.77, "end": 68.49, "text": "敬请上路,老主公去吧。"}, {"start": 68.49, "end": 70.49, "text": "工医老公,都是我害了你啊!"}, {"start": 70.49, "end": 71.49, "text": "不!"}, {"start": 71.49, "end": 78.72, "text": "既身中树剑,你引我们上钩,"}, {"start": 78.72, "end": 84.13, "text": "我败在这位老江手里也不冤枉,来吧!"}, {"start": 84.13, "end": 201.22, "text": "除了韩当周泰率一万多残军冲出国口外,"}, {"start": 201.22, "end": 205.75, "text": "其余均在此被歼灭。"}, {"start": 205.75, "end": 207.75, "text": "叛将副使人彌芳,二人无路可逃。"}, {"start": 207.75, "end": 210.75, "text": "只好反隔一击,"}, {"start": 210.75, "end": 216.7, "text": "抓住了五主将马忠,向陛下投诚。"}, {"start": 216.7, "end": 218.02, "text": "现在想要逃争"}, {"start": 218.02, "end": 223.86, "text": "斩首"}, {"start": 226.11, "end": 226.59, "text": "诺"}, {"start": 234.55, "end": 236.79, "text": "吴将承朴来进邯郸周泰"}, {"start": 237.23, "end": 238.51, "text": "被沙漠科一箭射中"}, {"start": 238.91, "end": 239.71, "text": "当场毙命"}, {"start": 240.15, "end": 244.52, "text": "承朴乃东吴头号战将"}, {"start": 245.4, "end": 246.64, "text": "威名垂三代"}, {"start": 246.92, "end": 248.04, "text": "他死于此意"}, {"start": 249.36, "end": 251.8, "text": "东吴三军必然心寒"}, {"start": 253.84, "end": 255.76, "text": "沙漠科率五万蛮兵出战"}, {"start": 256.32, "end": 257.08, "text": "又立此功"}, {"start": 257.8, "end": 259.32, "text": "陛下该重重奖赏他"}, {"start": 260.92, "end": 262.56, "text": "沙漠科是要赏"}, {"start": 263.52, "end": 265.12, "text": "但更要赏的是黄忠"}, {"start": 271.17, "end": 271.73, "text": "黄忠呢"}, {"start": 273.13, "end": 273.49, "text": "他"}, {"start": 295.58, "end": 296.1, "text": "陛下"}, {"start": 300.25, "end": 302.85, "text": "老将军的血快要流干了"}, {"start": 303.33, "end": 350.58, "text": "伤亡六七万"}, {"start": 350.98, "end": 361.02, "text": "陛下圣明"}, {"start": 364.14, "end": 366.34, "text": "臣只是挨了几箭罢了"}, {"start": 366.34, "end": 372.54, "text": "杨夕"}, {"start": 373.74, "end": 375.1, "text": "等伤势痊愈"}, {"start": 376.22, "end": 379.7, "text": "我招人送你回成都"}, {"start": 379.7, "end": 389.82, "text": "要看着陛下功去尽兴"}, {"start": 391.34, "end": 391.66, "text": "好"}, {"start": 393.27, "end": 394.23, "text": "我就是抬"}, {"start": 395.23, "end": 397.15, "text": "要把你抬进荆州"}, {"start": 402.16, "end": 404.48, "text": "只打过两回败仗"}, {"start": 404.48, "end": 408.9, "text": "差之战"}, {"start": 409.58, "end": 411.66, "text": "臣输给了云长"}, {"start": 411.94, "end": 422.48, "text": "这仗不该输啊"}, {"start": 422.48, "end": 423.36, "text": "至今"}, {"start": 424.48, "end": 427.0, "text": "臣也不负云长啊"}, {"start": 427.72, "end": 428.72, "text": "韩生啊"}, {"start": 428.72, "end": 431.31, "text": "你年纪"}, {"start": 431.75, "end": 433.27, "text": "若跟云长一般"}, {"start": 434.07, "end": 435.95, "text": "云长一定胜不了你"}, {"start": 440.7, "end": 442.86, "text": "说这话臣爱听啊"}, {"start": 446.12, "end": 448.44, "text": "再就是这次败仗"}, {"start": 449.88, "end": 451.76, "text": "臣虽然失败了"}, {"start": 452.48, "end": 454.48, "text": "可陛下却大胜"}, {"start": 454.84, "end": 462.56, "text": "九泉之下"}, {"start": 463.0, "end": 464.6, "text": "遇到了云长"}, {"start": 465.96, "end": 467.84, "text": "臣就有得说了"}, {"start": 468.12, "end": 475.78, "text": "陛下封我为五湖上将"}, {"start": 476.02, "end": 480.07, "text": "知不知"}, {"start": 483.98, "end": 484.66, "text": "你父"}, {"start": 484.66, "end": 540.11, "text": "义王三"}, {"start": 540.47, "end": 563.96, "text": "君精锐"}, {"start": 564.36, "end": 570.16, "text": "传三军听令"}, {"start": 570.52, "end": 574.42, "text": "义灵"}, {"start": 574.78, "end": 587.72, "text": "卓鲁迅觐见"}, {"start": 591.52, "end": 593.44, "text": "你们把我囚禁在此"}, {"start": 595.94, "end": 597.66, "text": "已经十三天了吧"}, {"start": 600.18, "end": 600.78, "text": "是"}, {"start": 615.06, "end": 616.62, "text": "蜀公 陆迅来了"}, {"start": 625.0, "end": 625.76, "text": "陆迅"}, {"start": 626.56, "end": 627.32, "text": "我军"}, {"start": 628.56, "end": 629.88, "text": "复制口大败"}, {"start": 631.16, "end": 632.6, "text": "十万精锐"}, {"start": 633.56, "end": 635.0, "text": "折损大半"}, {"start": 636.61, "end": 638.65, "text": "上将军城埔甘宁"}, {"start": 639.81, "end": 642.01, "text": "前将军攀章无忠"}, {"start": 643.17, "end": 643.89, "text": "阵亡"}, {"start": 645.48, "end": 646.36, "text": "现在"}, {"start": 646.96, "end": 648.84, "text": "刘备大军直逼义灵"}, {"start": 650.76, "end": 654.82, "text": "那是我中原最后一道平仗"}, {"start": 655.1, "end": 656.18, "text": "义灵若是"}, {"start": 656.98, "end": 659.66, "text": "蜀军便是一马平砖必去荆州"}, {"start": 660.34, "end": 661.82, "text": "而荆州在师"}, {"start": 665.03, "end": 665.75, "text": "东吴"}, {"start": 667.19, "end": 667.87, "text": "无咎"}, {"start": 683.99, "end": 684.71, "text": "陆迅"}, {"start": 686.23, "end": 688.15, "text": "我拜你为东吴大都督"}, {"start": 688.15, "end": 689.31, "text": "统领三军"}, {"start": 689.47, "end": 690.71, "text": "迎战刘备"}, {"start": 696.83, "end": 697.51, "text": "主公"}, {"start": 697.99, "end": 699.27, "text": "在下有一问"}, {"start": 700.47, "end": 701.99, "text": "请主公直言"}, {"start": 703.67, "end": 704.27, "text": "问吧"}, {"start": 704.71, "end": 707.19, "text": "主公囚禁陆迅十三天"}, {"start": 708.19, "end": 710.55, "text": "是在等前线的战报吧"}, {"start": 711.59, "end": 713.59, "text": "复制口如果大胜了"}, {"start": 714.67, "end": 716.39, "text": "主公必不会用我"}, {"start": 719.38, "end": 721.22, "text": "如今复制口大败"}, {"start": 722.62, "end": 724.66, "text": "主公才被迫用得我"}, {"start": 725.06, "end": 726.34, "text": "复制口大胜"}, {"start": 728.37, "end": 729.73, "text": "我不但不会用你"}, {"start": 731.01, "end": 732.49, "text": "还会指你养疯卖傻"}, {"start": 732.49, "end": 733.89, "text": "祸乱军心之罪"}, {"start": 734.09, "end": 736.54, "text": "此一大败"}, {"start": 740.21, "end": 741.97, "text": "也可见你有先见之明"}, {"start": 743.53, "end": 744.25, "text": "陆迅"}, {"start": 746.07, "end": 747.43, "text": "姑爷想问你一句"}, {"start": 749.33, "end": 751.73, "text": "你之所以在营外大发狂言"}, {"start": 752.97, "end": 754.69, "text": "不也想以此而触动我"}, {"start": 755.09, "end": 757.25, "text": "急我请你出山吗"}, {"start": 760.12, "end": 761.56, "text": "请主公恕罪"}, {"start": 770.65, "end": 771.57, "text": "可惜啊"}, {"start": 772.05, "end": 774.01, "text": "被你那些风话言中了"}, {"start": 775.61, "end": 777.25, "text": "你说我大军出击"}, {"start": 778.25, "end": 779.77, "text": "是为虎驱羊"}, {"start": 780.01, "end": 781.17, "text": "报心救虎"}, {"start": 783.09, "end": 786.88, "text": "句句就对"}, {"start": 786.88, "end": 787.8, "text": "此一战"}, {"start": 789.62, "end": 791.1, "text": "损失了我东吴"}, {"start": 791.1, "end": 792.74, "text": "大半的骑兵战甲"}, {"start": 795.69, "end": 796.89, "text": "老臣看则"}, {"start": 797.53, "end": 799.29, "text": "说你是晴天之助"}, {"start": 800.25, "end": 801.73, "text": "并以全家性命"}, {"start": 802.09, "end": 803.65, "text": "担保你担此大任"}, {"start": 804.17, "end": 805.25, "text": "想来"}, {"start": 807.1, "end": 808.94, "text": "江东反对此意者"}, {"start": 810.91, "end": 812.19, "text": "也不在少数吧"}, {"start": 812.47, "end": 813.79, "text": "实备于看则"}, {"start": 814.19, "end": 815.35, "text": "如此看来"}, {"start": 816.71, "end": 818.71, "text": "江东文武必不服我"}, {"start": 823.76, "end": 824.76, "text": "在下"}, {"start": 825.64, "end": 827.08, "text": "乃一介书生"}, {"start": 828.56, "end": 830.16, "text": "才疏德薄"}, {"start": 831.16, "end": 832.6, "text": "不配当此重任"}, {"start": 832.84, "end": 843.32, "text": "先兄孙策"}, {"start": 843.6, "end": 845.16, "text": "提令江东时"}, {"start": 845.44, "end": 846.92, "text": "二十一岁"}, {"start": 848.48, "end": 850.4, "text": "我继承父兄大业"}, {"start": 851.28, "end": 852.92, "text": "年方十八"}, {"start": 854.36, "end": 855.72, "text": "周瑜驰逼建功"}, {"start": 855.72, "end": 857.04, "text": "也不过三十岁"}, {"start": 857.4, "end": 858.12, "text": "鲁迅"}, {"start": 858.6, "end": 860.68, "text": "江东自古英雄出少年"}, {"start": 861.4, "end": 862.84, "text": "现在是威王之际"}, {"start": 863.24, "end": 864.36, "text": "我既然用你"}, {"start": 865.0, "end": 866.52, "text": "定与你荣辱与共"}, {"start": 866.76, "end": 868.12, "text": "生死同命"}, {"start": 876.1, "end": 877.18, "text": "谢主公"}, {"start": 880.8, "end": 882.4, "text": "江边已设好将坛"}, {"start": 882.84, "end": 883.84, "text": "明日午时"}, {"start": 884.04, "end": 885.88, "text": "江东文武旗帜坛下"}, {"start": 886.48, "end": 887.84, "text": "我会登坛拜帅"}, {"start": 888.72, "end": 889.72, "text": "为你扬位"}, {"start": 891.45, "end": 895.4, "text": "末将遵命"}, {"start": 898.82, "end": 900.02, "text": "邯郸周泰"}, {"start": 901.18, "end": 902.42, "text": "末将在"}, {"start": 903.1, "end": 903.78, "text": "孤"}, {"start": 904.3, "end": 906.94, "text": "将十万精锐托付给你们"}, {"start": 908.18, "end": 910.18, "text": "你们却轻举妄动"}, {"start": 911.14, "end": 912.22, "text": "首战"}, {"start": 912.82, "end": 914.38, "text": "便挣我七万将士"}, {"start": 915.82, "end": 916.54, "text": "四白"}, {"start": 916.74, "end": 921.35, "text": "夺君位丧尽"}, {"start": 922.15, "end": 923.35, "text": "动无万机"}, {"start": 926.38, "end": 928.18, "text": "末将罪无可赦"}, {"start": 928.98, "end": 930.34, "text": "愿受君罚"}, {"start": 931.46, "end": 932.02, "text": "大人"}, {"start": 933.34, "end": 933.94, "text": "在"}, {"start": 935.54, "end": 937.26, "text": "将这两个败军之将"}, {"start": 937.58, "end": 938.34, "text": "拖下去"}, {"start": 938.94, "end": 940.1, "text": "应前正法"}, {"start": 940.26, "end": 940.9, "text": "诺"}, {"start": 941.14, "end": 941.74, "text": "主公"}, {"start": 942.22, "end": 942.9, "text": "主公"}, {"start": 943.98, "end": 945.02, "text": "邯郸周泰"}, {"start": 945.22, "end": 946.22, "text": "罪敢论战"}, {"start": 946.38, "end": 947.38, "text": "可其二人"}, {"start": 947.58, "end": 949.42, "text": "为东吴立过书勋"}, {"start": 949.9, "end": 952.5, "text": "恳请主公暂设其死"}, {"start": 952.86, "end": 955.66, "text": "令其回到镇前将功折罪"}, {"start": 955.86, "end": 957.26, "text": "法不正令不行"}, {"start": 957.5, "end": 959.22, "text": "今要关头更要严刑俱法"}, {"start": 959.46, "end": 960.14, "text": "拖下去"}, {"start": 960.66, "end": 961.18, "text": "诺"}, {"start": 962.82, "end": 963.58, "text": "主公呢"}, {"start": 963.58, "end": 964.3, "text": "我意已决"}, {"start": 964.5, "end": 965.7, "text": "你不必多费唇舌"}, {"start": 966.98, "end": 967.54, "text": "且慢"}, {"start": 978.86, "end": 981.02, "text": "主公授我大都督之职"}, {"start": 982.58, "end": 984.22, "text": "依主公之授权"}, {"start": 985.02, "end": 986.98, "text": "三军将士的生死"}, {"start": 987.86, "end": 989.98, "text": "当归兵马大都督执掌"}, {"start": 991.97, "end": 993.01, "text": "你有何意啊"}, {"start": 993.29, "end": 994.69, "text": "赴池口之战"}, {"start": 995.81, "end": 997.37, "text": "邯郸周泰二家"}, {"start": 998.17, "end": 998.89, "text": "有罪"}, {"start": 999.69, "end": 1000.57, "text": "可也有功"}, {"start": 1001.97, "end": 1004.29, "text": "罪在清帅出击遭敌埋伏"}, {"start": 1004.65, "end": 1005.09, "text": "功"}, {"start": 1005.89, "end": 1006.97, "text": "则是射杀了"}, {"start": 1006.97, "end": 1009.05, "text": "蜀军的五虎上将黄忠"}, {"start": 1009.89, "end": 1011.97, "text": "为夷灵的坚守与加固"}, {"start": 1012.53, "end": 1014.33, "text": "争取了二十天的时间"}, {"start": 1015.37, "end": 1016.33, "text": "这二十天"}, {"start": 1017.09, "end": 1019.17, "text": "现在看来是微不足道"}, {"start": 1020.01, "end": 1020.97, "text": "可在日后"}, {"start": 1021.33, "end": 1022.85, "text": "极有可能成为"}, {"start": 1022.85, "end": 1024.97, "text": "五鼠之战胜负之关键"}, {"start": 1025.93, "end": 1026.85, "text": "末将建议"}, {"start": 1027.45, "end": 1030.33, "text": "剥夺邯郸周泰二将军中之职"}, {"start": 1031.49, "end": 1033.85, "text": "罚往军前效力"}, {"start": 1037.41, "end": 1038.37, "text": "你是大都督"}, {"start": 1039.53, "end": 1040.49, "text": "就都听你的吧"}, {"start": 1042.05, "end": 1043.49, "text": "谢主公恩典"}, {"start": 1043.85, "end": 1044.65, "text": "谢我作甚"}, {"start": 1045.93, "end": 1047.05, "text": "又不是我宽恕你们"}, {"start": 1049.03, "end": 1051.23, "text": "末将叩谢大都督"}, {"start": 1053.3, "end": 1053.74, "text": "听着"}, {"start": 1054.74, "end": 1056.82, "text": "你们折损了主公七万精锐"}, {"start": 1057.38, "end": 1059.42, "text": "日后定当斩杀七万蜀军"}, {"start": 1061.06, "end": 1061.66, "text": "否则"}, {"start": 1062.66, "end": 1065.1, "text": "本都督两罪并罚"}, {"start": 1065.74, "end": 1066.54, "text": "遵命 遵命"}, {"start": 1069.46, "end": 1070.06, "text": "鲁迅"}, {"start": 1071.22, "end": 1072.34, "text": "战事之事"}, {"start": 1073.74, "end": 1074.82, "text": "就都交给你了"}, {"start": 1076.06, "end": 1077.14, "text": "我刚接到来信"}, {"start": 1077.66, "end": 1079.14, "text": "太夫人救兵复发"}, {"start": 1080.3, "end": 1081.46, "text": "我要回监业去了"}, {"start": 1089.14, "end": 1090.58, "text": "恭送主公"}, {"start": 1105.22, "end": 1105.74, "text": "禀陛下"}, {"start": 1106.58, "end": 1108.14, "text": "这些营寨都是吴军新住的"}, {"start": 1108.78, "end": 1110.62, "text": "十天前我率少级探查时"}, {"start": 1110.98, "end": 1111.98, "text": "对面还一无所有"}, {"start": 1112.58, "end": 1114.02, "text": "现在吴军已掌山寨"}, {"start": 1114.3, "end": 1115.02, "text": "平险拘守"}, {"start": 1115.58, "end": 1116.58, "text": "作我大军进路"}, {"start": 1117.38, "end": 1118.3, "text": "也就是说"}, {"start": 1118.3, "end": 1119.62, "text": "吴军在十天里"}, {"start": 1119.62, "end": 1120.5, "text": "不声不响地"}, {"start": 1120.5, "end": 1122.18, "text": "住起了几十座营寨"}, {"start": 1122.34, "end": 1123.66, "text": "本事不小啊"}, {"start": 1125.38, "end": 1126.18, "text": "查清楚了吗"}, {"start": 1126.38, "end": 1127.58, "text": "领军的将军是谁"}, {"start": 1129.42, "end": 1130.9, "text": "据刚刚招获的俘虏说"}, {"start": 1131.5, "end": 1132.1, "text": "半月前"}, {"start": 1132.86, "end": 1134.06, "text": "孙权任命陆迅"}, {"start": 1134.06, "end": 1134.98, "text": "为都务大都督"}, {"start": 1135.98, "end": 1136.74, "text": "陆迅"}, {"start": 1137.1, "end": 1139.83, "text": "我没有听说过"}, {"start": 1140.43, "end": 1140.83, "text": "陛下"}, {"start": 1141.63, "end": 1142.79, "text": "陆迅 自薄言"}, {"start": 1143.27, "end": 1143.99, "text": "吴郡人士"}, {"start": 1144.79, "end": 1145.63, "text": "此人乃是"}, {"start": 1145.87, "end": 1147.63, "text": "汉城校尉陆鱼之孙"}, {"start": 1148.07, "end": 1149.75, "text": "九江都尉陆郡之子"}, {"start": 1150.35, "end": 1152.03, "text": "柬吴侯 孙策之婿"}, {"start": 1152.91, "end": 1154.47, "text": "据说此人三年前"}, {"start": 1154.75, "end": 1156.03, "text": "做过吕蒙的副都督"}, {"start": 1156.67, "end": 1158.27, "text": "专门掌管粮饷军械"}, {"start": 1159.03, "end": 1159.79, "text": "不到两个月"}, {"start": 1160.47, "end": 1161.43, "text": "即被孙权罢免"}, {"start": 1162.07, "end": 1162.99, "text": "此后未再担任过"}, {"start": 1162.99, "end": 1163.71, "text": "任何军职"}, {"start": 1164.79, "end": 1165.87, "text": "只在家中读书"}, {"start": 1166.95, "end": 1167.59, "text": "多大了"}, {"start": 1168.35, "end": 1169.07, "text": "二十七岁"}, {"start": 1169.39, "end": 1175.01, "text": "孙子笨"}, {"start": 1175.49, "end": 1177.29, "text": "看来通吾真是无人可用了"}, {"start": 1177.81, "end": 1179.53, "text": "竟然拎住个书生来做都督"}, {"start": 1180.69, "end": 1182.33, "text": "且不说他从未统兵征战"}, {"start": 1182.85, "end": 1184.21, "text": "只怕连他帐下的将军"}, {"start": 1184.85, "end": 1185.81, "text": "也未必服他"}, {"start": 1186.49, "end": 1186.93, "text": "陛下"}, {"start": 1188.41, "end": 1189.01, "text": "臣觉得"}, {"start": 1190.17, "end": 1192.13, "text": "孙权既然敢在危急关头"}, {"start": 1192.53, "end": 1193.33, "text": "任用此人"}, {"start": 1194.85, "end": 1195.61, "text": "这就足以证明"}, {"start": 1196.05, "end": 1198.7, "text": "此人不可小识"}, {"start": 1199.06, "end": 1200.18, "text": "且试试他的能力"}, {"start": 1201.22, "end": 1202.22, "text": "关兴听令"}, {"start": 1202.34, "end": 1202.74, "text": "在"}, {"start": 1204.3, "end": 1206.1, "text": "陆迅在十天之内"}, {"start": 1206.62, "end": 1207.98, "text": "住起的这些营寨"}, {"start": 1208.9, "end": 1211.58, "text": "朕令你在五日之内攻破"}, {"start": 1211.98, "end": 1212.38, "text": "令必"}, {"start": 1213.1, "end": 1213.9, "text": "马梁传命"}, {"start": 1214.14, "end": 1214.58, "text": "在"}, {"start": 1214.9, "end": 1216.54, "text": "待吴军山寨攻破后"}, {"start": 1216.78, "end": 1218.26, "text": "三军即行开进"}, {"start": 1218.58, "end": 1219.9, "text": "至萧亭扎营"}, {"start": 1220.26, "end": 1220.78, "text": "诺"}, {"start": 1221.38, "end": 1222.14, "text": "此攻击寨口"}, {"start": 1222.14, "end": 1230.09, "text": "我军屡粗退敌"}, {"start": 1230.09, "end": 1231.93, "text": "但他们依然踩着尸体往上来了"}, {"start": 1232.45, "end": 1232.93, "text": "战"}, {"start": 1233.21, "end": 1234.05, "text": "诺"}, {"start": 1234.73, "end": 1236.82, "text": "禀将军"}, {"start": 1236.9, "end": 1237.46, "text": "禀将军"}, {"start": 1237.62, "end": 1239.42, "text": "蜀将关兴带其部下突破南城"}, {"start": 1239.66, "end": 1240.62, "text": "送将军阵亡"}, {"start": 1240.9, "end": 1241.3, "text": "战"}, {"start": 1241.86, "end": 1242.22, "text": "诺"}, {"start": 1242.42, "end": 1243.42, "text": "报"}, {"start": 1243.9, "end": 1244.34, "text": "将军"}, {"start": 1244.46, "end": 1245.62, "text": "蜀军火箭射入营中"}, {"start": 1245.82, "end": 1246.74, "text": "后营起火"}, {"start": 1247.22, "end": 1247.62, "text": "战"}, {"start": 1248.14, "end": 1248.86, "text": "死战"}, {"start": 1249.22, "end": 1249.74, "text": "遵命"}, {"start": 1251.96, "end": 1252.36, "text": "海当"}, {"start": 1252.88, "end": 1254.0, "text": "计战快两个时辰了"}, {"start": 1254.24, "end": 1254.72, "text": "这时候"}, {"start": 1254.96, "end": 1256.64, "text": "如果有一支精兵能冲出营寨"}, {"start": 1256.96, "end": 1258.64, "text": "定能杀蜀军一个出其不意"}, {"start": 1258.8, "end": 1259.76, "text": "人仰马分哪"}, {"start": 1260.24, "end": 1261.04, "text": "不行啊"}, {"start": 1262.72, "end": 1265.2, "text": "大都督令我们坚守不战"}, {"start": 1266.8, "end": 1267.92, "text": "你忘记了吗"}, {"start": 1268.24, "end": 1269.2, "text": "五尺口之败"}, {"start": 1269.4, "end": 1270.88, "text": "令我二人名声扫地"}, {"start": 1270.88, "end": 1271.84, "text": "此时不建功"}, {"start": 1271.84, "end": 1272.96, "text": "更待何时啊"}, {"start": 1273.64, "end": 1276.28, "text": "击寨进攻太过冒险"}, {"start": 1276.84, "end": 1278.64, "text": "万一丢了营寨怎么办"}, {"start": 1278.92, "end": 1280.28, "text": "我宁可和他们拼了"}, {"start": 1280.8, "end": 1281.96, "text": "也不厌坐着挨打"}, {"start": 1282.8, "end": 1284.6, "text": "我领三千人马冲出营寨"}, {"start": 1285.08, "end": 1285.76, "text": "你坚守阵地"}, {"start": 1285.76, "end": 1286.24, "text": "站住"}, {"start": 1286.56, "end": 1287.04, "text": "不行"}, {"start": 1287.24, "end": 1287.96, "text": "将军"}, {"start": 1289.28, "end": 1289.88, "text": "二位将军"}, {"start": 1290.04, "end": 1290.76, "text": "大都督降令"}, {"start": 1290.88, "end": 1291.72, "text": "放弃索尔山寨"}, {"start": 1291.72, "end": 1292.6, "text": "后撤三十里"}, {"start": 1293.28, "end": 1294.0, "text": "胡说"}, {"start": 1297.3, "end": 1300.02, "text": "大都督严令我们坚守二十日"}, {"start": 1300.86, "end": 1302.06, "text": "为何十日不当"}, {"start": 1302.06, "end": 1303.38, "text": "你轻言厚辄"}, {"start": 1303.82, "end": 1304.3, "text": "就是"}, {"start": 1304.58, "end": 1305.3, "text": "朝令夕改"}, {"start": 1305.5, "end": 1306.38, "text": "如同儿戚"}, {"start": 1307.26, "end": 1307.98, "text": "大都督说了"}, {"start": 1308.14, "end": 1308.94, "text": "入围令不撤"}, {"start": 1309.38, "end": 1310.06, "text": "战无赦"}, {"start": 1313.02, "end": 1314.9, "text": "我们原本就欠鲁迅一条命"}, {"start": 1315.22, "end": 1316.22, "text": "他爱斩就斩"}, {"start": 1316.3, "end": 1317.02, "text": "我不撤"}, {"start": 1317.14, "end": 1317.66, "text": "不"}, {"start": 1318.5, "end": 1319.58, "text": "回禀大都督"}, {"start": 1321.1, "end": 1322.18, "text": "韩当周泰"}, {"start": 1323.58, "end": 1325.02, "text": "奉命即撤"}, {"start": 1325.58, "end": 1326.1, "text": "遵命"}, {"start": 1329.51, "end": 1330.31, "text": "左弓弩手"}, {"start": 1330.31, "end": 1331.23, "text": "上城放箭"}, {"start": 1331.47, "end": 1332.39, "text": "箭矢射击后"}, {"start": 1332.51, "end": 1333.47, "text": "轻言厚辄"}, {"start": 1338.75, "end": 1339.19, "text": "陛下"}, {"start": 1339.75, "end": 1340.99, "text": "吴军二十五座营寨"}, {"start": 1341.19, "end": 1342.95, "text": "不到十日就被我全部攻克"}, {"start": 1343.31, "end": 1344.27, "text": "战敌两千多"}, {"start": 1344.67, "end": 1346.51, "text": "韩当周泰弃寨西逃了"}, {"start": 1351.52, "end": 1352.12, "text": "万兴"}, {"start": 1353.24, "end": 1353.96, "text": "你怎么了"}, {"start": 1355.97, "end": 1356.77, "text": "你受伤了"}, {"start": 1358.21, "end": 1358.69, "text": "陛下"}, {"start": 1359.05, "end": 1360.57, "text": "这些都是吴军的心"}, {"start": 1364.05, "end": 1365.37, "text": "你们这仗打得不错"}, {"start": 1366.21, "end": 1367.89, "text": "让你的部下休整几天"}, {"start": 1368.57, "end": 1370.05, "text": "以后再全军开进"}, {"start": 1370.93, "end": 1372.33, "text": "等过了夷令山脉"}, {"start": 1373.33, "end": 1374.73, "text": "咱们就是一马平川"}, {"start": 1375.25, "end": 1376.61, "text": "可以直下荆乡了"}, {"start": 1378.09, "end": 1378.57, "text": "去"}, {"start": 1379.33, "end": 1381.33, "text": "把身上的血迹擦一擦"}, {"start": 1383.52, "end": 1384.04, "text": "遵命"}, {"start": 1387.95, "end": 1388.51, "text": "陛下"}, {"start": 1389.39, "end": 1390.15, "text": "少级探保"}, {"start": 1390.15, "end": 1391.27, "text": "三十里外山坡上"}, {"start": 1391.27, "end": 1392.39, "text": "又出现吴军寨墙"}, {"start": 1393.23, "end": 1394.15, "text": "约有二十余座"}, {"start": 1395.83, "end": 1396.63, "text": "又有了"}, {"start": 1412.02, "end": 1412.54, "text": "陛下"}, {"start": 1412.86, "end": 1413.7, "text": "给我两万军"}, {"start": 1413.94, "end": 1415.22, "text": "我十日之内攻破它"}, {"start": 1416.14, "end": 1422.9, "text": "营寨之后"}, {"start": 1424.68, "end": 1425.88, "text": "三十里外"}, {"start": 1425.88, "end": 1427.72, "text": "再出现吴军营寨怎么办"}, {"start": 1428.08, "end": 1429.6, "text": "那末将就再攻破它"}, {"start": 1430.12, "end": 1430.84, "text": "我就不信"}, {"start": 1431.16, "end": 1432.44, "text": "吴军能在座座山上"}, {"start": 1432.44, "end": 1433.28, "text": "都住满了营寨"}, {"start": 1435.89, "end": 1436.77, "text": "那倒不会"}, {"start": 1442.62, "end": 1444.02, "text": "你率领三万精兵"}, {"start": 1445.22, "end": 1446.42, "text": "绕过这些山寨"}, {"start": 1447.82, "end": 1449.06, "text": "直取三十里外的"}, {"start": 1449.06, "end": 1449.86, "text": "吴军营寨"}, {"start": 1450.74, "end": 1452.02, "text": "只要把那里的营寨"}, {"start": 1452.02, "end": 1452.78, "text": "拔除了"}, {"start": 1453.42, "end": 1454.3, "text": "这里的敌军"}, {"start": 1454.3, "end": 1455.54, "text": "就成了瓮中之边"}, {"start": 1455.94, "end": 1456.9, "text": "不攻自破"}, {"start": 1457.7, "end": 1458.06, "text": "遵命"}, {"start": 1468.71, "end": 1469.83, "text": "关键在于"}, {"start": 1469.83, "end": 1474.57, "text": "必须要越过夷令山脉"}, {"start": 1475.89, "end": 1477.53, "text": "才能进入荆乡平原"}, {"start": 1481.02, "end": 1482.54, "text": "而越过夷令山脉"}, {"start": 1484.58, "end": 1486.5, "text": "又必须拔除这些钉子"}, {"start": 1489.79, "end": 1490.59, "text": "蜀军张包"}, {"start": 1490.59, "end": 1492.15, "text": "率军猛攻我夷灵城"}, {"start": 1492.59, "end": 1494.35, "text": "大都督始终不肯发兵救援"}, {"start": 1494.75, "end": 1496.67, "text": "还说什么孙桓必能牵手"}, {"start": 1499.63, "end": 1500.23, "text": "刘备"}, {"start": 1500.23, "end": 1502.11, "text": "十日之内连破我两道营寨"}, {"start": 1503.15, "end": 1504.07, "text": "进军数百里"}, {"start": 1504.79, "end": 1505.47, "text": "大都督"}, {"start": 1505.47, "end": 1506.71, "text": "居然没有退兵之策"}, {"start": 1507.71, "end": 1508.99, "text": "大都督为何不让我目睬"}, {"start": 1508.99, "end": 1509.63, "text": "大都督声仗"}, {"start": 1520.78, "end": 1522.14, "text": "参拜大都督"}, {"start": 1526.74, "end": 1527.62, "text": "人都到齐了吗"}, {"start": 1529.81, "end": 1530.41, "text": "后将军"}, {"start": 1530.81, "end": 1531.57, "text": "附军未到"}, {"start": 1540.67, "end": 1541.15, "text": "站住"}, {"start": 1545.09, "end": 1546.41, "text": "率杖点兵"}, {"start": 1547.49, "end": 1548.73, "text": "本都督都到了"}, {"start": 1549.93, "end": 1551.05, "text": "你为何耻误啊"}, {"start": 1551.45, "end": 1552.65, "text": "末将营寨太远"}, {"start": 1553.01, "end": 1553.77, "text": "因此耻误"}, {"start": 1554.37, "end": 1555.49, "text": "既然耻误"}, {"start": 1556.41, "end": 1558.17, "text": "为什么不叩败谢罪啊"}, {"start": 1559.13, "end": 1560.01, "text": "恕我直言"}, {"start": 1560.41, "end": 1562.57, "text": "本将不败不战自退的都督"}, {"start": 1566.52, "end": 1567.08, "text": "来人"}, {"start": 1567.6, "end": 1567.96, "text": "在"}, {"start": 1572.88, "end": 1573.44, "text": "拉出去"}, {"start": 1574.6, "end": 1575.56, "text": "打四师军棍"}, {"start": 1576.32, "end": 1576.68, "text": "诺"}, {"start": 1577.68, "end": 1578.08, "text": "陆迅"}, {"start": 1578.72, "end": 1580.12, "text": "有能耐去和刘备打呀"}, {"start": 1580.4, "end": 1581.96, "text": "在我身上耍足威风"}, {"start": 1582.2, "end": 1585.0, "text": "本都督的威风无处不在"}, {"start": 1586.32, "end": 1587.12, "text": "我先打你"}, {"start": 1588.44, "end": 1589.28, "text": "再打刘备"}, {"start": 1590.76, "end": 1592.44, "text": "四师军棍算个屁"}, {"start": 1594.87, "end": 1595.83, "text": "说得好"}, {"start": 1596.27, "end": 1599.54, "text": "军机在先"}, {"start": 1599.94, "end": 1601.14, "text": "口出不讯在后"}, {"start": 1602.34, "end": 1603.98, "text": "捉打八师军棍"}, {"start": 1604.62, "end": 1605.02, "text": "诺"}, {"start": 1606.14, "end": 1606.66, "text": "陆迅"}, {"start": 1607.74, "end": 1608.42, "text": "陆迅"}, {"start": 1608.98, "end": 1609.78, "text": "陆迅"}, {"start": 1610.58, "end": 1611.18, "text": "大都督"}, {"start": 1617.4, "end": 1618.76, "text": "我知道你要说什么"}, {"start": 1619.88, "end": 1620.64, "text": "你想说"}, {"start": 1621.8, "end": 1623.84, "text": "傅俊是主公的内地"}, {"start": 1624.96, "end": 1627.24, "text": "打伤了主公面子上不好看"}, {"start": 1628.12, "end": 1629.96, "text": "可是军法无情"}, {"start": 1630.32, "end": 1633.51, "text": "还有犯者"}, {"start": 1634.75, "end": 1636.43, "text": "我必请出王界"}, {"start": 1638.23, "end": 1638.63, "text": "斩"}, {"start": 1639.75, "end": 1640.39, "text": "诺"}, {"start": 1644.7, "end": 1646.26, "text": "蜀军连破我两道营寨"}, {"start": 1646.62, "end": 1647.94, "text": "本部已失去了屏障"}, {"start": 1648.38, "end": 1649.86, "text": "下面的仗怎么打呀"}, {"start": 1650.74, "end": 1651.58, "text": "三十里外"}, {"start": 1653.06, "end": 1654.34, "text": "我已经为你们住好了"}, {"start": 1654.34, "end": 1655.34, "text": "第三道营寨"}, {"start": 1655.62, "end": 1656.42, "text": "共二十座"}, {"start": 1657.42, "end": 1659.26, "text": "你和邯郸所部尽助把守"}, {"start": 1660.98, "end": 1661.66, "text": "这一次"}, {"start": 1662.78, "end": 1664.74, "text": "你们只需要守五天"}, {"start": 1665.46, "end": 1667.46, "text": "五天之内仍然不准出击"}, {"start": 1668.82, "end": 1669.78, "text": "五天之后"}, {"start": 1671.06, "end": 1672.98, "text": "如果蜀军攻击猛烈"}, {"start": 1675.33, "end": 1676.93, "text": "你们就继续后撤罢了"}, {"start": 1678.01, "end": 1678.89, "text": "五十里外"}, {"start": 1680.21, "end": 1681.45, "text": "我会为你们准备好"}, {"start": 1681.45, "end": 1682.57, "text": "第四道营寨"}, {"start": 1683.21, "end": 1684.01, "text": "请问大都督"}, {"start": 1684.49, "end": 1685.65, "text": "我们一退再退"}, {"start": 1685.97, "end": 1687.33, "text": "退到什么时候是逃啊"}, {"start": 1690.48, "end": 1691.36, "text": "这个嘛"}, {"start": 1693.86, "end": 1695.42, "text": "到时候你们自会知道"}, {"start": 1696.06, "end": 1697.58, "text": "恳请大都督开恩"}, {"start": 1698.26, "end": 1699.9, "text": "现在就告诉我们"}, {"start": 1700.46, "end": 1701.78, "text": "已安军心"}, {"start": 1702.98, "end": 1703.94, "text": "大都督"}, {"start": 1705.18, "end": 1705.86, "text": "好吧"}, {"start": 1709.23, "end": 1710.75, "text": "我们最后的防线"}, {"start": 1712.03, "end": 1713.15, "text": "是萧亭山"}, {"start": 1714.95, "end": 1716.31, "text": "蜀军攻到那里"}, {"start": 1717.47, "end": 1719.03, "text": "应该是两个月后吧"}, {"start": 1721.96, "end": 1723.32, "text": "我们现在要做的"}, {"start": 1724.92, "end": 1726.88, "text": "就是要争取一切时间"}, {"start": 1728.24, "end": 1729.4, "text": "拖垮蜀军"}, {"start": 1730.0, "end": 1731.08, "text": "以待天时"}, {"start": 1731.88, "end": 1732.8, "text": "两个月后"}, {"start": 1734.04, "end": 1736.0, "text": "我自有三十万雄兵"}, {"start": 1737.2, "end": 1738.44, "text": "从天而降"}, {"start": 1742.18, "end": 1743.94, "text": "三十万雄兵从天而降"}, {"start": 1744.1, "end": 1745.66, "text": "简直就是痴人说梦啊"}, {"start": 1746.06, "end": 1747.94, "text": "我担心大都督并无良策"}, {"start": 1748.62, "end": 1750.34, "text": "他现在是表面镇定"}, {"start": 1751.1, "end": 1752.7, "text": "内心恐惧不安哪"}, {"start": 1752.86, "end": 1754.18, "text": "主公让他做大都督"}, {"start": 1754.26, "end": 1755.58, "text": "早晚得大祸临头啊"}, {"start": 1755.94, "end": 1756.5, "text": "不说了"}, {"start": 1757.14, "end": 1758.22, "text": "战死报国罢"}, {"start": 1758.5, "end": 1759.3, "text": "死又何惧啊"}, {"start": 1759.5, "end": 1760.98, "text": "怕就怕活得窝囊死的冤"}, {"start": 1766.76, "end": 1771.79, "text": "丞相 丞相"}, {"start": 1772.59, "end": 1774.47, "text": "陛下的大军又告捷了"}, {"start": 1776.28, "end": 1777.68, "text": "进展到何程度了"}, {"start": 1778.32, "end": 1779.96, "text": "陛下在富池口设伏"}, {"start": 1780.4, "end": 1782.96, "text": "一举歼灭了吴军精锐七万余"}, {"start": 1783.44, "end": 1785.04, "text": "之后灰尸东进"}, {"start": 1785.44, "end": 1787.8, "text": "先后攻破吴军三道连营"}, {"start": 1787.8, "end": 1789.4, "text": "进九十多座营寨"}, {"start": 1791.0, "end": 1793.44, "text": "陛下现已深入吴径二百里了"}, {"start": 1793.8, "end": 1796.2, "text": "吴军上下是一片混乱"}, {"start": 1798.85, "end": 1799.93, "text": "想不到啊"}, {"start": 1801.05, "end": 1802.89, "text": "进展得如此顺的"}, {"start": 1804.17, "end": 1804.77, "text": "是啊"}, {"start": 1806.09, "end": 1808.33, "text": "孙全用陆迅为大都督"}, {"start": 1808.77, "end": 1810.61, "text": "此人太过稚嫩"}, {"start": 1811.09, "end": 1812.53, "text": "在军中有无威信"}, {"start": 1813.05, "end": 1815.49, "text": "连吃败仗也是在所难免的"}, {"start": 1816.57, "end": 1818.29, "text": "孙全并不会打仗"}, {"start": 1818.73, "end": 1820.01, "text": "凡战必败"}, {"start": 1821.01, "end": 1822.73, "text": "但是他有一条好处"}, {"start": 1822.81, "end": 1824.61, "text": "就是有知人知命"}, {"start": 1825.89, "end": 1827.33, "text": "知道谁是梁家"}, {"start": 1827.89, "end": 1830.17, "text": "知道该找谁为自己打仗"}, {"start": 1830.93, "end": 1833.33, "text": "周瑜 鲁素 吕蒙"}, {"start": 1833.33, "end": 1834.53, "text": "他就用对了"}, {"start": 1836.25, "end": 1837.77, "text": "如今用陆迅"}, {"start": 1838.61, "end": 1841.89, "text": "看来陆迅也有过人之处"}, {"start": 1845.7, "end": 1847.46, "text": "陛下还有什么话捎来吗"}, {"start": 1847.86, "end": 1848.94, "text": "陛下传话说"}, {"start": 1848.94, "end": 1851.34, "text": "蜀军年内定可荡平东吴"}, {"start": 1851.74, "end": 1854.46, "text": "请丞相斟酌迁都何处"}, {"start": 1859.0, "end": 1861.2, "text": "丞相 怎么了"}, {"start": 1865.26, "end": 1866.1, "text": "没什么"}, {"start": 1867.1, "end": 1868.46, "text": "只是有些担心"}, {"start": 1870.46, "end": 1872.46, "text": "可担心什么我也不清楚"}, {"start": 1873.1, "end": 1875.1, "text": "现在就想到荡都了"}, {"start": 1876.58, "end": 1877.94, "text": "远隔两千里"}, {"start": 1878.34, "end": 1879.54, "text": "我仿佛就能听见"}, {"start": 1879.54, "end": 1880.86, "text": "将士们的笑声"}, {"start": 1884.46, "end": 1885.34, "text": "举笔来"}, {"start": 1886.18, "end": 1887.66, "text": "我给陛下回一封信"}, {"start": 1887.94, "end": 1889.5, "text": "你亲自送到军中"}, {"start": 1894.22, "end": 1896.06, "text": "吴军败退了五十里"}, {"start": 1896.74, "end": 1900.1, "text": "这第三道连营又有劲势了"}, {"start": 1900.58, "end": 1902.3, "text": "对 这可怎么办"}, {"start": 1902.62, "end": 1904.34, "text": "这陆迅误国误军"}, {"start": 1904.34, "end": 1906.78, "text": "再不撤换东吴无救"}, {"start": 1907.26, "end": 1909.62, "text": "是 自从陆迅挂帅后"}, {"start": 1909.98, "end": 1912.26, "text": "我军是打一仗败一仗"}, {"start": 1912.7, "end": 1913.82, "text": "再照这么下去"}, {"start": 1914.26, "end": 1915.18, "text": "不出半年"}, {"start": 1915.78, "end": 1916.86, "text": "刘备的皇妻"}, {"start": 1916.98, "end": 1918.86, "text": "就可以插到剑叶的城头上了"}, {"start": 1919.74, "end": 1921.14, "text": "待会主公来了"}, {"start": 1921.5, "end": 1922.62, "text": "我们一起进剑"}, {"start": 1922.82, "end": 1924.82, "text": "请主公换帅"}, {"start": 1925.1, "end": 1927.74, "text": "对 我就是寇破头颅"}, {"start": 1928.02, "end": 1930.3, "text": "也要寇请主公罢免陆迅"}, {"start": 1930.3, "end": 1931.26, "text": "罢免陆迅"}, {"start": 1931.26, "end": 1932.82, "text": "对对对 罢免陆迅"}, {"start": 1933.02, "end": 1934.46, "text": "紫布 你有何意啊"}, {"start": 1937.7, "end": 1940.46, "text": "主公用陆迅为帅"}, {"start": 1941.46, "end": 1943.34, "text": "我原本就不同意"}, {"start": 1944.9, "end": 1946.38, "text": "我言已尽"}, {"start": 1946.5, "end": 1949.26, "text": "只待殉国罢了"}, {"start": 1949.34, "end": 1951.7, "text": "紫布之中 故甚为感动"}, {"start": 1952.1, "end": 1953.42, "text": "但殉国之言"}, {"start": 1953.7, "end": 1955.34, "text": "故不以为然"}, {"start": 1956.98, "end": 1965.5, "text": "主公"}, {"start": 1965.74, "end": 1967.1, "text": "要逼宫不成吗"}, {"start": 1972.54, "end": 1973.3, "text": "听着"}, {"start": 1973.7, "end": 1975.1, "text": "我是不会换陆迅"}, {"start": 1977.51, "end": 1978.71, "text": "打仗的门法"}, {"start": 1978.91, "end": 1981.03, "text": "千奇百怪 层出不穷"}, {"start": 1981.27, "end": 1982.47, "text": "我不重视过程"}, {"start": 1982.67, "end": 1984.71, "text": "只重视最终的结果"}, {"start": 1985.63, "end": 1988.35, "text": "别说陆迅现在连败三阵"}, {"start": 1988.99, "end": 1990.31, "text": "就是连败十阵"}, {"start": 1990.43, "end": 1991.87, "text": "我也绝不会换他"}, {"start": 1993.96, "end": 1994.72, "text": "主公"}, {"start": 1995.6, "end": 1996.8, "text": "邯郸周泰"}, {"start": 1997.08, "end": 1999.04, "text": "在富池口只败一阵"}, {"start": 1999.32, "end": 2000.56, "text": "你就要杀他们"}, {"start": 2000.88, "end": 2003.32, "text": "为何陆迅连战皆败"}, {"start": 2003.56, "end": 2005.64, "text": "你却置若罔闻哪"}, {"start": 2006.04, "end": 2006.6, "text": "记着"}, {"start": 2007.48, "end": 2008.64, "text": "败与败不同"}, {"start": 2009.6, "end": 2011.16, "text": "邯郸周泰之败"}, {"start": 2012.0, "end": 2014.24, "text": "损失东吴几万将士"}, {"start": 2014.4, "end": 2015.56, "text": "而陆迅之败"}, {"start": 2015.84, "end": 2018.36, "text": "只不过留给刘备了几座空营"}, {"start": 2018.8, "end": 2020.08, "text": "并无多大损害"}, {"start": 2022.43, "end": 2023.11, "text": "所以"}, {"start": 2023.95, "end": 2025.47, "text": "二者不可并论"}, {"start": 2026.11, "end": 2028.43, "text": "就算陆迅损兵不多"}, {"start": 2028.71, "end": 2030.79, "text": "但丧成师弟之罪"}, {"start": 2030.79, "end": 2032.07, "text": "也非同小可"}, {"start": 2032.63, "end": 2034.51, "text": "主公若不予追究"}, {"start": 2034.71, "end": 2036.27, "text": "以后守成将士"}, {"start": 2036.27, "end": 2038.95, "text": "岂不可以个个弃成而逃了吗"}, {"start": 2038.95, "end": 2040.51, "text": "主公"}, {"start": 2040.79, "end": 2061.77, "text": "蜀军多"}, {"start": 2062.85, "end": 2063.97, "text": "吴军胜"}, {"start": 2065.57, "end": 2066.41, "text": "更何况"}, {"start": 2067.25, "end": 2068.53, "text": "蜀军铁技"}, {"start": 2068.77, "end": 2069.93, "text": "胜过吴军"}, {"start": 2071.41, "end": 2073.65, "text": "所以丢几座城池"}, {"start": 2074.13, "end": 2075.05, "text": "必不可免"}, {"start": 2077.46, "end": 2078.9, "text": "我东吴所需的"}, {"start": 2079.74, "end": 2081.22, "text": "不是几座城池"}, {"start": 2082.22, "end": 2083.38, "text": "几土寨墙"}, {"start": 2083.82, "end": 2084.78, "text": "而是军力"}, {"start": 2088.06, "end": 2088.7, "text": "记住"}, {"start": 2089.66, "end": 2091.94, "text": "只要军力和斗志二者在"}, {"start": 2092.94, "end": 2094.46, "text": "不管失掉多少城池"}, {"start": 2094.7, "end": 2096.14, "text": "我们都能把它拿回来"}, {"start": 2096.7, "end": 2100.01, "text": "主公"}, {"start": 2100.61, "end": 2103.17, "text": "臣原本不想说话"}, {"start": 2103.69, "end": 2106.09, "text": "但有些忍耐不住"}, {"start": 2107.69, "end": 2108.29, "text": "说吧"}, {"start": 2108.89, "end": 2114.86, "text": "请主公亲自前往江口大营督战"}, {"start": 2115.66, "end": 2116.58, "text": "臣以为"}, {"start": 2117.18, "end": 2118.42, "text": "关键时刻"}, {"start": 2118.94, "end": 2121.38, "text": "主公在与不在"}, {"start": 2122.34, "end": 2124.46, "text": "大不相同啊"}, {"start": 2140.12, "end": 2142.04, "text": "各位将军都到齐了吗"}, {"start": 2142.32, "end": 2143.2, "text": "启禀大都督"}, {"start": 2143.32, "end": 2144.04, "text": "都到齐了"}, {"start": 2150.98, "end": 2153.06, "text": "你们有谁能够告诉我"}, {"start": 2153.3, "end": 2155.02, "text": "自本都挂帅以来"}, {"start": 2155.46, "end": 2157.18, "text": "我军败了多少阵了"}, {"start": 2164.34, "end": 2165.62, "text": "怎么没人说话呀"}, {"start": 2167.06, "end": 2167.94, "text": "回大都督"}, {"start": 2168.3, "end": 2169.7, "text": "你已经连败四阵了"}, {"start": 2170.14, "end": 2171.26, "text": "自你挂帅以来"}, {"start": 2171.38, "end": 2172.46, "text": "末将打的败仗"}, {"start": 2172.62, "end": 2173.86, "text": "比从军以来都多"}, {"start": 2178.7, "end": 2180.66, "text": "你心中有气对吧"}, {"start": 2181.02, "end": 2181.54, "text": "不错"}, {"start": 2181.74, "end": 2182.78, "text": "我气冲斗牛"}, {"start": 2183.1, "end": 2184.18, "text": "夫君 放肆"}, {"start": 2185.86, "end": 2187.5, "text": "傅将军说得在理"}, {"start": 2188.46, "end": 2189.38, "text": "不算放肆"}, {"start": 2192.24, "end": 2192.76, "text": "接着说"}, {"start": 2192.96, "end": 2193.72, "text": "说就说"}, {"start": 2194.24, "end": 2195.72, "text": "我傅军从军为什么"}, {"start": 2195.96, "end": 2197.92, "text": "一是保主公 保江东父老"}, {"start": 2198.2, "end": 2199.64, "text": "二是为了杀敌建功"}, {"start": 2200.08, "end": 2201.2, "text": "如果只打败仗"}, {"start": 2201.32, "end": 2202.52, "text": "那便是欺食大辱"}, {"start": 2202.84, "end": 2203.96, "text": "我生不如死"}, {"start": 2207.47, "end": 2210.07, "text": "还有谁是和傅将军一样想法的"}, {"start": 2210.15, "end": 2211.19, "text": "大都督"}, {"start": 2211.27, "end": 2229.69, "text": "我等你与将军见证"}, {"start": 2229.89, "end": 2231.89, "text": "我们已经是退无可退了"}, {"start": 2233.97, "end": 2235.13, "text": "列位将军请看"}, {"start": 2236.85, "end": 2239.69, "text": "那就是伊岭山脉最后一道山梁"}, {"start": 2240.65, "end": 2241.65, "text": "越过它"}, {"start": 2242.61, "end": 2245.05, "text": "就是一马平川直下金香"}, {"start": 2245.17, "end": 2246.65, "text": "再无险关可守"}, {"start": 2250.23, "end": 2251.55, "text": "我已经在那里"}, {"start": 2252.11, "end": 2254.35, "text": "住齐了五十座坚固的营寨"}, {"start": 2255.23, "end": 2257.23, "text": "那也是我军最后的防线"}, {"start": 2257.95, "end": 2259.23, "text": "从今日起"}, {"start": 2260.23, "end": 2261.67, "text": "自本都以下"}, {"start": 2262.15, "end": 2263.43, "text": "所有将士"}, {"start": 2264.59, "end": 2267.03, "text": "都必须和营寨共存亡"}, {"start": 2267.23, "end": 2269.23, "text": "我等愿意死"}, {"start": 2272.44, "end": 2273.36, "text": "拿酒来"}, {"start": 2273.44, "end": 2274.16, "text": "诺"}, {"start": 2274.24, "end": 2313.13, "text": "八师 死战不退"}, {"start": 2314.21, "end": 2315.45, "text": "击败刘备"}, {"start": 2315.65, "end": 2318.61, "text": "死战不退 击败刘备"}, {"start": 2318.69, "end": 2319.29, "text": "陛下"}, {"start": 2319.37, "end": 2321.09, "text": "末将眼看就要攻下山寨了"}, {"start": 2321.21, "end": 2322.89, "text": "可是吴军就像换了个魂似的"}, {"start": 2322.97, "end": 2324.05, "text": "各个死战不退"}, {"start": 2324.45, "end": 2325.97, "text": "左营一万兵勇猛攻炮战"}, {"start": 2326.05, "end": 2327.01, "text": "血人一天"}, {"start": 2327.85, "end": 2329.01, "text": "也没能得手"}, {"start": 2330.61, "end": 2331.97, "text": "右营攻打陆彦平"}, {"start": 2332.29, "end": 2334.13, "text": "也遭到了吴军的猛烈抵抗"}, {"start": 2334.89, "end": 2335.89, "text": "伤亡不小"}, {"start": 2335.97, "end": 2353.13, "text": "吴军正在做困兽一刀"}, {"start": 2354.33, "end": 2355.33, "text": "这说明"}, {"start": 2355.89, "end": 2358.01, "text": "他们知道自己的死期不远了"}, {"start": 2361.95, "end": 2362.67, "text": "听令"}, {"start": 2365.74, "end": 2367.26, "text": "各营组成干死队"}, {"start": 2368.78, "end": 2370.66, "text": "由各营将军亲自率领"}, {"start": 2371.26, "end": 2372.82, "text": "明天继续攻打"}, {"start": 2373.22, "end": 2376.22, "text": "三天之内务必全部攻占"}, {"start": 2377.06, "end": 2378.22, "text": "遵命"}, {"start": 2380.82, "end": 2381.54, "text": "陛下"}, {"start": 2386.49, "end": 2387.41, "text": "我军征战"}, {"start": 2387.97, "end": 2388.97, "text": "一快两个月了"}, {"start": 2390.05, "end": 2391.57, "text": "将士们都极为疲惫"}, {"start": 2392.41, "end": 2393.61, "text": "可否休息一天"}, {"start": 2395.36, "end": 2396.24, "text": "待后天"}, {"start": 2396.8, "end": 2397.72, "text": "再攻山寨"}, {"start": 2397.96, "end": 2410.86, "text": "你们疲惫了吗"}, {"start": 2417.32, "end": 2419.84, "text": "吴军比你们更疲惫"}, {"start": 2423.07, "end": 2424.39, "text": "平兵战平兵"}, {"start": 2425.15, "end": 2427.27, "text": "就看谁能刺出最后一枪"}, {"start": 2429.74, "end": 2430.66, "text": "这个时候"}, {"start": 2432.1, "end": 2434.02, "text": "谁要是敢停下来喘口气"}, {"start": 2434.62, "end": 2435.94, "text": "那么对手的枪精"}, {"start": 2435.94, "end": 2437.54, "text": "就会刺到你的胸膛上"}, {"start": 2442.7, "end": 2443.94, "text": "把后军各营"}, {"start": 2444.38, "end": 2446.3, "text": "全部调至萧廷前线"}, {"start": 2447.26, "end": 2448.58, "text": "从明天开始"}, {"start": 2449.3, "end": 2450.46, "text": "轮番攻杀"}, {"start": 2451.7, "end": 2453.22, "text": "哪怕他吴军营寨"}, {"start": 2453.62, "end": 2455.06, "text": "就是一座泰山"}, {"start": 2456.1, "end": 2457.98, "text": "我也要一寸一寸的"}, {"start": 2458.3, "end": 2459.58, "text": "把他砍平了"}, {"start": 2461.34, "end": 2462.02, "text": "遵命"}]