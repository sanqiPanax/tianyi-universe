[{"start": 12.43, "end": 161.35, "text": "我成就大业的时机到了。"}, {"start": 161.35, "end": 193.88, "text": "夫君为何如此高兴?"}, {"start": 194.88, "end": 203.92, "text": "曹操率军到了关渡,"}, {"start": 203.92, "end": 209.34, "text": "许诚必然空虚。"}, {"start": 210.34, "end": 212.34, "text": "我率军齐袭,"}, {"start": 212.34, "end": 215.34, "text": "这是千载难逢的好机会啊。"}, {"start": 216.34, "end": 217.34, "text": "夫君,"}, {"start": 217.34, "end": 221.72, "text": "此事还需从长计议,"}, {"start": 221.72, "end": 224.72, "text": "毕竟曹操不是等闲之辈。"}, {"start": 225.72, "end": 226.72, "text": "夫君,"}, {"start": 226.72, "end": 232.16, "text": "这次我定要夺取许诚。"}, {"start": 232.16, "end": 235.16, "text": "杀!"}, {"start": 235.16, "end": 236.16, "text": "主公,"}, {"start": 236.16, "end": 237.16, "text": "我们的阵脚已经乱了。"}, {"start": 237.16, "end": 238.16, "text": "依在下之见,"}, {"start": 238.16, "end": 240.16, "text": "我们还是撤军吧。"}, {"start": 240.16, "end": 241.16, "text": "不,"}, {"start": 241.16, "end": 517.1, "text": "在战!"}, {"start": 517.1, "end": 518.1, "text": "主公,"}, {"start": 518.1, "end": 519.1, "text": "巨战者死,"}, {"start": 519.1, "end": 521.1, "text": "都给我冲出去!"}, {"start": 521.1, "end": 522.1, "text": "你看,"}, {"start": 522.1, "end": 525.1, "text": "曹操的铁骑已经冲破我们的中军大阵了。"}, {"start": 525.1, "end": 527.1, "text": "再不撤就了!"}, {"start": 529.74, "end": 530.74, "text": "夫君,"}, {"start": 530.74, "end": 532.74, "text": "我们的阵脚已经乱了。"}, {"start": 532.74, "end": 534.74, "text": "再不撤就来不及了!"}, {"start": 535.74, "end": 536.74, "text": "主公!"}, {"start": 536.74, "end": 539.66, "text": "不行!"}, {"start": 539.66, "end": 542.97, "text": "快把主公架走!"}, {"start": 542.97, "end": 543.97, "text": "撤!"}, {"start": 543.97, "end": 544.97, "text": "主公!"}, {"start": 544.97, "end": 545.97, "text": "撤!"}, {"start": 545.97, "end": 677.54, "text": "是来取我性命的吧?"}, {"start": 677.54, "end": 678.54, "text": "员工,"}, {"start": 678.54, "end": 680.54, "text": "你对我有恩,"}, {"start": 680.54, "end": 683.54, "text": "刘备今日是来报恩的。"}, {"start": 683.54, "end": 692.1, "text": "你如何报答我?"}, {"start": 692.1, "end": 694.1, "text": "请员工先走,"}, {"start": 694.1, "end": 696.1, "text": "我替你抵抗曹军。"}, {"start": 696.1, "end": 699.95, "text": "刘备,"}, {"start": 699.95, "end": 701.95, "text": "你带了多少人马?"}, {"start": 701.95, "end": 703.95, "text": "不足五千。"}, {"start": 703.95, "end": 713.67, "text": "我堂堂七十万大军都败了。"}, {"start": 714.67, "end": 716.67, "text": "你区区几千人,"}, {"start": 716.67, "end": 718.67, "text": "又有何用?"}, {"start": 718.67, "end": 720.67, "text": "你七十万大军都败了?"}, {"start": 720.67, "end": 722.67, "text": "我的天哪!"}, {"start": 722.67, "end": 723.67, "text": "你这个仗,"}, {"start": 723.67, "end": 725.67, "text": "是怎么打的?"}, {"start": 725.67, "end": 726.67, "text": "这七十万大军,"}, {"start": 726.67, "end": 728.67, "text": "就是伸直了脖子,"}, {"start": 728.67, "end": 729.67, "text": "让曹军砍,"}, {"start": 729.67, "end": 731.67, "text": "那也得砍这几天几夜啊!"}, {"start": 731.67, "end": 732.67, "text": "三弟,"}, {"start": 732.67, "end": 734.92, "text": "请员工快走,"}, {"start": 734.92, "end": 735.92, "text": "重整旗鼓,"}, {"start": 735.92, "end": 737.92, "text": "再战曹操。"}, {"start": 738.92, "end": 740.92, "text": "恨死我也,"}, {"start": 740.92, "end": 742.92, "text": "苍天助贼,"}, {"start": 742.92, "end": 746.58, "text": "不助我!"}, {"start": 746.58, "end": 747.58, "text": "快走吧,"}, {"start": 747.58, "end": 748.58, "text": "再不走就来不及了,"}, {"start": 748.58, "end": 749.58, "text": "走吧!"}, {"start": 753.58, "end": 803.93, "text": "人民知道,"}, {"start": 803.93, "end": 804.93, "text": "倘若正面厮杀,"}, {"start": 804.93, "end": 806.93, "text": "他绝非我敌!"}, {"start": 806.93, "end": 808.93, "text": "银儿使出连环奸计,"}, {"start": 808.93, "end": 810.93, "text": "一战茶的功夫,"}, {"start": 810.93, "end": 812.93, "text": "他竟然使出三道奸计来!"}, {"start": 813.93, "end": 815.93, "text": "先是虚言求和,"}, {"start": 816.93, "end": 818.93, "text": "再者就是将天子让给我,"}, {"start": 818.93, "end": 820.93, "text": "还要放出宫里,"}, {"start": 820.93, "end": 822.93, "text": "来扰乱我的军心!"}, {"start": 825.93, "end": 826.93, "text": "主公,"}, {"start": 826.93, "end": 828.93, "text": "是四道奸计,"}, {"start": 828.93, "end": 830.93, "text": "主公,"}, {"start": 830.93, "end": 834.93, "text": "那曹操之所以请你喝茶,"}, {"start": 834.93, "end": 836.93, "text": "就是要有意拖延战计,"}, {"start": 836.93, "end": 839.93, "text": "分明是想利用那,"}, {"start": 839.93, "end": 841.93, "text": "太阳熄射的光线,"}, {"start": 841.93, "end": 843.93, "text": "刺射我军目。"}, {"start": 846.93, "end": 849.93, "text": "是我过失,"}, {"start": 850.93, "end": 853.93, "text": "是我糊涂啊!"}, {"start": 855.93, "end": 856.93, "text": "此战,"}, {"start": 856.93, "end": 857.93, "text": "错在于我,"}, {"start": 857.93, "end": 859.93, "text": "连累三军的!"}, {"start": 862.93, "end": 863.93, "text": "主公,"}, {"start": 865.93, "end": 867.93, "text": "主公切勿过于悲伤,"}, {"start": 867.93, "end": 868.93, "text": "这常言道,"}, {"start": 868.93, "end": 869.93, "text": "胜败,"}, {"start": 869.93, "end": 871.93, "text": "乃兵家之常嘛,"}, {"start": 871.93, "end": 872.93, "text": "况且我们,"}, {"start": 872.93, "end": 873.93, "text": "主公,"}, {"start": 873.93, "end": 875.93, "text": "在下痛定思痛,"}, {"start": 875.93, "end": 877.93, "text": "反倒想起一个人了。"}, {"start": 879.93, "end": 881.93, "text": "想起谁了?"}, {"start": 882.93, "end": 884.93, "text": "别嫁天锋,"}, {"start": 884.93, "end": 885.93, "text": "主公啊,"}, {"start": 885.93, "end": 887.93, "text": "战前天锋,"}, {"start": 887.93, "end": 888.93, "text": "曾多次奏剑,"}, {"start": 888.93, "end": 890.93, "text": "曹贼善战,"}, {"start": 890.93, "end": 893.93, "text": "灭曹未必非战不可,"}, {"start": 893.93, "end": 895.93, "text": "应当随机应变,"}, {"start": 895.93, "end": 897.93, "text": "以静制动而。"}, {"start": 897.93, "end": 898.93, "text": "主公如果专注于"}, {"start": 898.93, "end": 900.93, "text": "富国强兵,"}, {"start": 900.93, "end": 901.93, "text": "那三五年后,"}, {"start": 901.93, "end": 903.93, "text": "定当不战而胜。"}, {"start": 907.82, "end": 909.82, "text": "回当初不听他言,"}, {"start": 909.82, "end": 911.82, "text": "才惨遭失败呀!"}, {"start": 913.82, "end": 915.82, "text": "天锋现在在哪?"}, {"start": 915.82, "end": 916.82, "text": "在冀州大牢。"}, {"start": 918.82, "end": 920.82, "text": "他怎么在冀州大牢呢?"}, {"start": 920.82, "end": 921.82, "text": "主公你忘了,"}, {"start": 921.82, "end": 924.82, "text": "是你把他关进大牢的。"}, {"start": 926.96, "end": 927.96, "text": "主公,"}, {"start": 927.96, "end": 928.96, "text": "你不是要把那天锋的手机"}, {"start": 928.96, "end": 930.96, "text": "和那曹操的脑袋,"}, {"start": 930.96, "end": 931.96, "text": "摆在一起,"}, {"start": 931.96, "end": 932.96, "text": "一把火,"}, {"start": 932.96, "end": 933.96, "text": "烧了祭旗吗?"}, {"start": 934.96, "end": 935.96, "text": "快快快,"}, {"start": 935.96, "end": 936.96, "text": "快去传令,"}, {"start": 936.96, "end": 938.96, "text": "立即开示天锋。"}, {"start": 938.96, "end": 939.96, "text": "另外,"}, {"start": 939.96, "end": 940.96, "text": "派我的车驾"}, {"start": 940.96, "end": 942.96, "text": "把他接到关渡大帐来,"}, {"start": 942.96, "end": 943.96, "text": "我要重用他。"}, {"start": 944.96, "end": 945.96, "text": "遵命。"}, {"start": 945.96, "end": 946.96, "text": "快去快去。"}, {"start": 946.96, "end": 959.51, "text": "依在下之见,"}, {"start": 959.51, "end": 961.51, "text": "开示天锋即可,"}, {"start": 961.51, "end": 965.51, "text": "然未必需要重用啊。"}, {"start": 965.51, "end": 969.2, "text": "为何啊?"}, {"start": 969.2, "end": 973.28, "text": "你有所不知,"}, {"start": 973.28, "end": 974.28, "text": "在下刚刚接到"}, {"start": 974.28, "end": 976.28, "text": "冀州守将来报,"}, {"start": 977.28, "end": 979.28, "text": "说主公你在关渡"}, {"start": 979.28, "end": 980.28, "text": "战败一时,"}, {"start": 980.28, "end": 982.28, "text": "传回冀州以后,"}, {"start": 982.28, "end": 984.28, "text": "所有的文臣武将"}, {"start": 984.28, "end": 985.28, "text": "和满城的百姓"}, {"start": 985.28, "end": 987.28, "text": "无不震痛,"}, {"start": 987.28, "end": 989.28, "text": "唯有那天锋小人,"}, {"start": 989.28, "end": 993.28, "text": "他在狱中居然高声欢笑,"}, {"start": 993.28, "end": 994.28, "text": "得意忘形,"}, {"start": 994.28, "end": 995.28, "text": "狂妄地吹嘘,"}, {"start": 995.28, "end": 996.28, "text": "说什么,"}, {"start": 996.28, "end": 1001.84, "text": "在下实在是不敢直言。"}, {"start": 1002.84, "end": 1003.84, "text": "说,"}, {"start": 1003.84, "end": 1014.94, "text": "那天锋在狱中养天长孝,"}, {"start": 1014.94, "end": 1016.94, "text": "他说你是庸主,"}, {"start": 1016.94, "end": 1017.94, "text": "刚必自用,"}, {"start": 1017.94, "end": 1019.94, "text": "不足以为谋,"}, {"start": 1019.94, "end": 1021.94, "text": "他的先见之名你不听,"}, {"start": 1021.94, "end": 1024.94, "text": "所以必然有今天这个大败。"}, {"start": 1025.94, "end": 1027.94, "text": "这狗狗狠,"}, {"start": 1027.94, "end": 1030.83, "text": "这个贼子竟敢"}, {"start": 1030.83, "end": 1032.83, "text": "如此地藐视我啊。"}, {"start": 1032.83, "end": 1035.14, "text": "在,"}, {"start": 1035.14, "end": 1038.77, "text": "主公。"}, {"start": 1038.77, "end": 1040.77, "text": "持我配戒,"}, {"start": 1040.77, "end": 1042.77, "text": "立即前往冀州大牢,"}, {"start": 1042.77, "end": 1044.77, "text": "立战天锋。"}, {"start": 1044.77, "end": 1045.77, "text": "遵命。"}, {"start": 1045.77, "end": 1053.46, "text": "副帅,"}, {"start": 1053.46, "end": 1054.46, "text": "各路拜兵"}, {"start": 1054.46, "end": 1055.46, "text": "已经陆续回营了,"}, {"start": 1055.46, "end": 1056.46, "text": "清点过后"}, {"start": 1056.46, "end": 1057.46, "text": "仍有近四十万,"}, {"start": 1057.46, "end": 1058.46, "text": "我们主要损失在于"}, {"start": 1058.46, "end": 1060.46, "text": "资重和战车。"}, {"start": 1060.46, "end": 1061.46, "text": "副帅,"}, {"start": 1061.46, "end": 1063.46, "text": "我军虽然守战失利,"}, {"start": 1063.46, "end": 1064.46, "text": "但兵马"}, {"start": 1064.46, "end": 1065.46, "text": "仍旧是曹军的两倍以上,"}, {"start": 1065.46, "end": 1067.46, "text": "足以再战。"}, {"start": 1067.46, "end": 1068.46, "text": "好,"}, {"start": 1068.46, "end": 1074.22, "text": "我们定要汲取教训,"}, {"start": 1074.22, "end": 1076.22, "text": "大破曹军,"}, {"start": 1076.22, "end": 1081.17, "text": "三军五日内休整,"}, {"start": 1081.17, "end": 1083.17, "text": "准备再战。"}, {"start": 1083.17, "end": 1100.62, "text": "你真是料事如神哪,"}, {"start": 1100.62, "end": 1101.62, "text": "你说过,"}, {"start": 1101.62, "end": 1106.57, "text": "曹操善于用兵,"}, {"start": 1106.57, "end": 1108.57, "text": "伐曹必败,"}, {"start": 1108.57, "end": 1110.57, "text": "我刚刚听到消息,"}, {"start": 1110.57, "end": 1112.57, "text": "主公果然在关渡大败了。"}, {"start": 1112.57, "end": 1121.64, "text": "我多么希望我言错呀,"}, {"start": 1121.64, "end": 1125.72, "text": "可不幸又被我言中了。"}, {"start": 1126.72, "end": 1127.72, "text": "我想,"}, {"start": 1127.72, "end": 1128.72, "text": "过不了几日,"}, {"start": 1128.72, "end": 1131.72, "text": "主公定会重新启用大人。"}, {"start": 1131.72, "end": 1139.83, "text": "你不了解我家主公,"}, {"start": 1139.83, "end": 1142.83, "text": "我家主公是外宽内极,"}, {"start": 1142.83, "end": 1144.83, "text": "喜怒无常。"}, {"start": 1144.83, "end": 1146.83, "text": "如果我军大胜曹军,"}, {"start": 1146.83, "end": 1148.83, "text": "主公欢喜之余,"}, {"start": 1148.83, "end": 1151.83, "text": "定会不计前嫌立刻射我。"}, {"start": 1151.83, "end": 1157.83, "text": "可现在主公大败,"}, {"start": 1157.83, "end": 1161.53, "text": "那一定是恼羞成。"}, {"start": 1161.53, "end": 1172.78, "text": "我明,"}, {"start": 1172.78, "end": 1174.78, "text": "不久已。"}, {"start": 1174.78, "end": 1175.78, "text": "并别嫁,"}, {"start": 1175.78, "end": 1185.65, "text": "主公叩谕,"}, {"start": 1185.65, "end": 1186.65, "text": "全封谢军备主,"}, {"start": 1186.65, "end": 1188.65, "text": "罪无可赦,"}, {"start": 1188.65, "end": 1190.65, "text": "定其自尽。"}, {"start": 1190.65, "end": 1191.65, "text": "你能告诉我,"}, {"start": 1191.65, "end": 1197.4, "text": "是许佑还是郭徒挑唆主公的吗?"}, {"start": 1197.4, "end": 1198.4, "text": "明白了。"}, {"start": 1198.4, "end": 1211.78, "text": "老李啊,"}, {"start": 1211.78, "end": 1219.14, "text": "麻烦你给我取笔墨来,"}, {"start": 1219.14, "end": 1222.14, "text": "我要给主公写一封遗书。"}, {"start": 1222.14, "end": 1223.14, "text": "是。"}, {"start": 1223.14, "end": 1225.14, "text": "这位军师啊,"}, {"start": 1235.28, "end": 1240.04, "text": "我不想死在这牢中,"}, {"start": 1240.04, "end": 1243.04, "text": "待会儿可否允许我在星光下自问,"}, {"start": 1243.04, "end": 1249.94, "text": "我想最后看一眼天相,"}, {"start": 1249.94, "end": 1254.7, "text": "竟凭尊义,"}, {"start": 1254.7, "end": 1313.38, "text": "诸草无诸元哪。"}, {"start": 1313.38, "end": 1353.68, "text": "恩天!"}, {"start": 1353.68, "end": 1354.68, "text": "丞相,"}, {"start": 1354.68, "end": 1367.1, "text": "此意啊,"}, {"start": 1367.1, "end": 1369.1, "text": "霍军斩首八万余级,"}, {"start": 1369.1, "end": 1372.1, "text": "交霍军械资助无数啊。"}, {"start": 1372.1, "end": 1373.1, "text": "袁绍,"}, {"start": 1373.1, "end": 1376.1, "text": "袁绍已经退回关渡大营,"}, {"start": 1376.1, "end": 1377.1, "text": "挖沟助寨,"}, {"start": 1377.1, "end": 1380.1, "text": "归缩着再也不敢接战了。"}, {"start": 1380.1, "end": 1383.1, "text": "我们折损了多少将士?"}, {"start": 1383.1, "end": 1387.11, "text": "生余两万,"}, {"start": 1387.11, "end": 1390.11, "text": "盟约七千多。"}, {"start": 1390.11, "end": 1395.98, "text": "真是大获全胜,"}, {"start": 1395.98, "end": 1402.3, "text": "是我起兵以来从未有过的大胜。"}, {"start": 1402.3, "end": 1403.3, "text": "丞相,"}, {"start": 1403.3, "end": 1405.3, "text": "将士们都乐疯了,"}, {"start": 1405.3, "end": 1407.3, "text": "说照这样打下去啊,"}, {"start": 1407.3, "end": 1409.3, "text": "卓妍就可以打进冀州了。"}, {"start": 1409.3, "end": 1412.3, "text": "如果帝军突然此时来袭你怎么办?"}, {"start": 1412.3, "end": 1413.3, "text": "什么?"}, {"start": 1413.3, "end": 1416.79, "text": "袁绍要来袭击?"}, {"start": 1416.79, "end": 1418.79, "text": "我是说如果,"}, {"start": 1418.79, "end": 1424.94, "text": "你瞅瞅他们明顶大罪的样子,"}, {"start": 1424.94, "end": 1429.94, "text": "如果袁绍此时来袭我们必然大败。"}, {"start": 1429.94, "end": 1435.07, "text": "虽然帝军没有来,"}, {"start": 1435.07, "end": 1437.07, "text": "但是身为中军主将,"}, {"start": 1437.07, "end": 1441.07, "text": "就要设想他们前来偷袭。"}, {"start": 1441.07, "end": 1444.25, "text": "知道了,"}, {"start": 1444.25, "end": 1446.25, "text": "我立刻加强步防。"}, {"start": 1446.25, "end": 1452.26, "text": "我们虽然大胜袁绍,"}, {"start": 1452.26, "end": 1457.26, "text": "但是敌强我弱的基本态势没有改变。"}, {"start": 1457.26, "end": 1461.26, "text": "袁绍手里还有四五十万人马,"}, {"start": 1461.26, "end": 1462.26, "text": "青州,"}, {"start": 1462.26, "end": 1463.26, "text": "幽州,"}, {"start": 1463.26, "end": 1465.26, "text": "宾州,"}, {"start": 1465.26, "end": 1468.26, "text": "还会继续供给他粮饷兵马。"}, {"start": 1468.26, "end": 1473.06, "text": "如果袁绍支持而后勇,"}, {"start": 1473.06, "end": 1477.5, "text": "后头的仗就更难打。"}, {"start": 1477.5, "end": 1481.58, "text": "还有,"}, {"start": 1481.58, "end": 1486.58, "text": "我们的粮草不多了。"}, {"start": 1489.58, "end": 1490.58, "text": "丞相,"}, {"start": 1490.58, "end": 1492.58, "text": "刚才在庆功宴上,"}, {"start": 1492.58, "end": 1495.58, "text": "你说我们还有百日之粮啊?"}, {"start": 1495.58, "end": 1498.58, "text": "我骗你们的,"}, {"start": 1498.58, "end": 1501.58, "text": "实际上只有十日之粮。"}, {"start": 1501.58, "end": 1508.27, "text": "那么,"}, {"start": 1508.27, "end": 1510.27, "text": "末将建议丞相班师,"}, {"start": 1510.27, "end": 1513.27, "text": "我军是功成凯旋,"}, {"start": 1513.27, "end": 1515.27, "text": "袁军是败而心乱,"}, {"start": 1515.27, "end": 1517.27, "text": "袁绍见我等退兵,"}, {"start": 1517.27, "end": 1519.27, "text": "必然是恶手成亲,"}, {"start": 1519.27, "end": 1521.27, "text": "断然不敢追杀呀。"}, {"start": 1521.27, "end": 1525.32, "text": "我何尝不想退军,"}, {"start": 1525.32, "end": 1529.46, "text": "你着实可惜。"}, {"start": 1529.46, "end": 1539.82, "text": "终于不在我身边啊,"}, {"start": 1539.82, "end": 1541.82, "text": "他若在,"}, {"start": 1541.82, "end": 1544.82, "text": "定能帮我一决进退。"}, {"start": 1544.82, "end": 1549.92, "text": "公子,"}, {"start": 1549.92, "end": 1552.92, "text": "丞相在此信中问我进退,"}, {"start": 1552.92, "end": 1561.33, "text": "丞相在信中言,"}, {"start": 1561.33, "end": 1563.33, "text": "军中粮草殆尽,"}, {"start": 1563.33, "end": 1565.33, "text": "难以久战,"}, {"start": 1565.33, "end": 1568.33, "text": "如果袁绍得知我军粮草不济,"}, {"start": 1568.33, "end": 1570.33, "text": "会坚守不战,"}, {"start": 1570.33, "end": 1573.33, "text": "我军早晚要陷入被冻之。"}, {"start": 1573.33, "end": 1577.18, "text": "丞相还说,"}, {"start": 1577.18, "end": 1580.18, "text": "现在退军甚为可惜,"}, {"start": 1580.18, "end": 1583.18, "text": "等于是主动放弃了大好局面,"}, {"start": 1583.18, "end": 1585.18, "text": "给袁绍以喘息之计。"}, {"start": 1585.18, "end": 1590.8, "text": "新先生,"}, {"start": 1590.8, "end": 1592.8, "text": "父亲在信里面,"}, {"start": 1592.8, "end": 1594.8, "text": "把进退立毙,"}, {"start": 1594.8, "end": 1596.8, "text": "样样都说到了,"}, {"start": 1596.8, "end": 1598.8, "text": "那咱们是应该进呢,"}, {"start": 1598.8, "end": 1600.8, "text": "还是应该退啊?"}, {"start": 1600.8, "end": 1602.8, "text": "公子问得好,"}, {"start": 1602.8, "end": 1606.59, "text": "那我问你,"}, {"start": 1606.59, "end": 1608.59, "text": "丞相是什么意思?"}, {"start": 1608.59, "end": 1620.29, "text": "我告诉你,"}, {"start": 1620.29, "end": 1622.29, "text": "其实丞相,"}, {"start": 1622.29, "end": 1624.29, "text": "早有意退军,"}, {"start": 1624.29, "end": 1626.29, "text": "只不过他不愿意直说,"}, {"start": 1626.29, "end": 1627.29, "text": "其意,"}, {"start": 1627.29, "end": 1629.29, "text": "是想让我劝他退军,"}, {"start": 1629.29, "end": 1630.29, "text": "这样一来,"}, {"start": 1630.29, "end": 1632.29, "text": "他就可以和前方的将军讲,"}, {"start": 1632.29, "end": 1634.29, "text": "军中粮草殆尽,"}, {"start": 1634.29, "end": 1636.29, "text": "寻衣力劝班师,"}, {"start": 1636.29, "end": 1638.29, "text": "我不得已而从之。"}, {"start": 1638.29, "end": 1648.06, "text": "这太聪明了。"}, {"start": 1649.06, "end": 1651.06, "text": "丞相的聪明,"}, {"start": 1651.06, "end": 1653.06, "text": "不是天下第一,"}, {"start": 1653.06, "end": 1655.06, "text": "也是天下第二。"}, {"start": 1655.06, "end": 1662.22, "text": "那这天下第一是谁啊?"}, {"start": 1662.22, "end": 1668.06, "text": "虚伪以待吧。"}, {"start": 1672.34, "end": 1677.48, "text": "父亲既然希望你劝他退军,"}, {"start": 1677.48, "end": 1680.48, "text": "那你打算怎么劝呢?"}, {"start": 1680.48, "end": 1686.38, "text": "我非但不劝丞相退军,"}, {"start": 1686.38, "end": 1699.52, "text": "丞相万万不可撤军,"}, {"start": 1699.52, "end": 1701.52, "text": "袁绍虽大败,"}, {"start": 1701.52, "end": 1704.52, "text": "但他仍然拥有四周富裕之地,"}, {"start": 1704.52, "end": 1707.52, "text": "万千田牧不但能够生产出无尽的粮食,"}, {"start": 1707.52, "end": 1709.52, "text": "也能生长出无尽的兵马,"}, {"start": 1709.52, "end": 1711.52, "text": "时间立袁绍,"}, {"start": 1711.52, "end": 1712.52, "text": "不立丞相,"}, {"start": 1712.52, "end": 1714.52, "text": "但战局立丞相,"}, {"start": 1714.52, "end": 1715.52, "text": "不离袁绍。"}, {"start": 1715.52, "end": 1717.52, "text": "丞相应抓住战机,"}, {"start": 1717.52, "end": 1718.52, "text": "成胜再战。"}, {"start": 1718.52, "end": 1719.52, "text": "在下以为,"}, {"start": 1719.52, "end": 1722.52, "text": "此时此刻最可怕的不是粮草殆尽,"}, {"start": 1722.52, "end": 1724.52, "text": "乃是丞相的心病。"}, {"start": 1725.52, "end": 1727.52, "text": "丞相初战大杰,"}, {"start": 1727.52, "end": 1729.52, "text": "反而顾虑重重,"}, {"start": 1729.52, "end": 1731.52, "text": "欲胜俱败,"}, {"start": 1731.52, "end": 1733.52, "text": "欲尽俱错。"}, {"start": 1733.52, "end": 1742.82, "text": "没有这等臣子,"}, {"start": 1742.82, "end": 1744.82, "text": "何愁袁士不灭?"}, {"start": 1744.82, "end": 1748.1, "text": "丞相,"}, {"start": 1748.1, "end": 1750.1, "text": "是否班师啊?"}, {"start": 1750.1, "end": 1752.1, "text": "敢言班师者,"}, {"start": 1752.1, "end": 1754.1, "text": "斩!"}, {"start": 1754.1, "end": 1756.1, "text": "传令三军,"}, {"start": 1756.1, "end": 1758.1, "text": "备好兵器军械,"}, {"start": 1758.1, "end": 1760.1, "text": "准备再战。"}, {"start": 1760.1, "end": 1762.1, "text": "遵命!"}, {"start": 1762.1, "end": 1763.1, "text": "丞相,"}, {"start": 1763.1, "end": 1765.1, "text": "那粮草怎么办?"}, {"start": 1765.1, "end": 1767.1, "text": "徐州屯有数万粮草,"}, {"start": 1767.1, "end": 1769.1, "text": "立刻派飞机前往徐州,"}, {"start": 1769.1, "end": 1771.1, "text": "调运粮草。"}, {"start": 1771.1, "end": 1772.1, "text": "遵命!"}, {"start": 1772.1, "end": 1784.68, "text": "军师,"}, {"start": 1784.68, "end": 1789.72, "text": "在下仔细看过了,"}, {"start": 1789.72, "end": 1790.72, "text": "曹军布下三重防卫。"}, {"start": 1790.72, "end": 1792.72, "text": "第一重是护卫营,"}, {"start": 1792.72, "end": 1794.72, "text": "驻扎在大营数里之外,"}, {"start": 1794.72, "end": 1797.72, "text": "分布于东南西北四角。"}, {"start": 1797.72, "end": 1799.72, "text": "第二重是巡计,"}, {"start": 1799.72, "end": 1800.72, "text": "每隔一个时辰,"}, {"start": 1800.72, "end": 1803.72, "text": "便有一校卫带百计巡防。"}, {"start": 1803.72, "end": 1805.72, "text": "这第三重,"}, {"start": 1805.72, "end": 1806.72, "text": "才是哨位。"}, {"start": 1806.72, "end": 1814.95, "text": "军师快看,"}, {"start": 1814.95, "end": 1816.95, "text": "那边出了一个单计。"}, {"start": 1816.95, "end": 1823.07, "text": "这肯定是,"}, {"start": 1823.07, "end": 1825.07, "text": "曹营派出求救的信石,"}, {"start": 1825.07, "end": 1827.07, "text": "派快马火速追上,"}, {"start": 1827.07, "end": 1829.07, "text": "将其吃饭。"}, {"start": 1829.07, "end": 1830.07, "text": "诺!"}, {"start": 1835.46, "end": 1863.66, "text": "有封信!"}, {"start": 1863.66, "end": 1898.94, "text": "不出我的所料。"}, {"start": 1899.94, "end": 1900.94, "text": "这回,"}, {"start": 1901.94, "end": 1902.94, "text": "曹阿满,"}, {"start": 1903.94, "end": 1906.94, "text": "你的死期到了。"}, {"start": 1906.94, "end": 1912.29, "text": "主公,"}, {"start": 1912.29, "end": 1914.29, "text": "冀州幽州的援兵,"}, {"start": 1914.29, "end": 1916.29, "text": "今天已经陆续到达。"}, {"start": 1916.29, "end": 1918.29, "text": "青州的十万粮草,"}, {"start": 1918.29, "end": 1920.29, "text": "估计明天也可运到。"}, {"start": 1920.29, "end": 1921.29, "text": "这样算来,"}, {"start": 1921.29, "end": 1923.29, "text": "我军有马军八万,"}, {"start": 1923.29, "end": 1925.29, "text": "步军二十五万,"}, {"start": 1925.29, "end": 1927.29, "text": "水军十万,"}, {"start": 1927.29, "end": 1929.29, "text": "总计不下四十三万。"}, {"start": 1929.29, "end": 1930.29, "text": "另外,"}, {"start": 1930.29, "end": 1933.29, "text": "粮草足可支应百日。"}, {"start": 1933.29, "end": 1938.39, "text": "我军虽然损失了一部分,"}, {"start": 1939.39, "end": 1942.39, "text": "但亦然是兵广粮多。"}, {"start": 1942.39, "end": 1945.25, "text": "传令,"}, {"start": 1945.25, "end": 1947.25, "text": "三军十日内休整,"}, {"start": 1947.25, "end": 1952.07, "text": "之后如何灭草?"}, {"start": 1952.07, "end": 1956.53, "text": "有一件小事,"}, {"start": 1956.53, "end": 1958.53, "text": "望主公听了,"}, {"start": 1958.53, "end": 1959.53, "text": "不要动怒。"}, {"start": 1959.53, "end": 1960.53, "text": "说,"}, {"start": 1960.53, "end": 1962.53, "text": "叶军太守密报,"}, {"start": 1962.53, "end": 1965.53, "text": "该军本该拨付五万粮草的,"}, {"start": 1965.53, "end": 1968.53, "text": "但由于许幽之子坚守自盗,"}, {"start": 1968.53, "end": 1970.53, "text": "贪污了三万多,"}, {"start": 1970.53, "end": 1973.53, "text": "因而耽误了此次粮草。"}, {"start": 1974.53, "end": 1977.53, "text": "这难道还是小事吗?"}, {"start": 1977.53, "end": 1979.53, "text": "大敌当前,"}, {"start": 1979.53, "end": 1981.53, "text": "粮草性命攸关,"}, {"start": 1981.53, "end": 1987.25, "text": "许子贪污之事,"}, {"start": 1987.25, "end": 1989.25, "text": "许幽知不知情?"}, {"start": 1989.25, "end": 1992.25, "text": "其子在牢中招供说,"}, {"start": 1992.25, "end": 1994.25, "text": "许幽略知一二,"}, {"start": 1994.25, "end": 1996.25, "text": "因为那三万多粮饷,"}, {"start": 1996.25, "end": 1999.25, "text": "就是为其父母修府邸的。"}, {"start": 1999.25, "end": 2000.25, "text": "我父母,"}, {"start": 2000.25, "end": 2010.57, "text": "这是咱且前各想,"}, {"start": 2010.57, "end": 2012.57, "text": "等战事过后,"}, {"start": 2012.57, "end": 2015.57, "text": "我要严查重办。"}, {"start": 2015.57, "end": 2021.44, "text": "主公啊,主公!"}, {"start": 2021.44, "end": 2022.44, "text": "主公,"}, {"start": 2022.44, "end": 2024.44, "text": "那草贼败相已现,"}, {"start": 2024.44, "end": 2027.44, "text": "我们是胜机在望了。"}, {"start": 2033.31, "end": 2035.31, "text": "郭徒也在。"}, {"start": 2035.31, "end": 2036.31, "text": "草草,"}, {"start": 2036.31, "end": 2038.31, "text": "如何败相已现了?"}, {"start": 2039.31, "end": 2040.31, "text": "回主公,"}, {"start": 2040.31, "end": 2042.31, "text": "今夜初更时分,"}, {"start": 2042.31, "end": 2044.31, "text": "在下亲率部族,"}, {"start": 2044.31, "end": 2047.31, "text": "到那曹军大寨探营,"}, {"start": 2047.31, "end": 2050.31, "text": "但见他不防严密,"}, {"start": 2050.31, "end": 2053.31, "text": "竟然没有一丝携带。"}, {"start": 2053.31, "end": 2055.31, "text": "既然如此,"}, {"start": 2055.31, "end": 2057.31, "text": "败相何来?"}, {"start": 2057.31, "end": 2058.31, "text": "主公,"}, {"start": 2058.31, "end": 2059.31, "text": "你别急嘛,"}, {"start": 2059.31, "end": 2060.31, "text": "且听我说,"}, {"start": 2060.31, "end": 2063.31, "text": "当我正欲拨马归营时,"}, {"start": 2063.31, "end": 2065.31, "text": "忽然看见那曹营"}, {"start": 2065.31, "end": 2067.31, "text": "远门处冲出一计,"}, {"start": 2067.31, "end": 2070.31, "text": "竟直奔着徐州方向而去,"}, {"start": 2070.31, "end": 2071.31, "text": "而是……"}, {"start": 2071.31, "end": 2072.31, "text": "知道了,"}, {"start": 2072.31, "end": 2074.31, "text": "那必定是信使。"}, {"start": 2076.31, "end": 2083.94, "text": "信使?"}, {"start": 2083.94, "end": 2085.94, "text": "敢问郭徒大人,"}, {"start": 2085.94, "end": 2087.94, "text": "这个信使深夜出营,"}, {"start": 2087.94, "end": 2089.94, "text": "又有何干呢?"}, {"start": 2091.94, "end": 2092.94, "text": "主公,"}, {"start": 2092.94, "end": 2096.94, "text": "当下我们正与曹军对垒,"}, {"start": 2096.94, "end": 2098.94, "text": "他们大胜之后却避垒森严,"}, {"start": 2098.94, "end": 2100.94, "text": "这天到这般时候,"}, {"start": 2100.94, "end": 2102.94, "text": "放出单人毒计,"}, {"start": 2102.94, "end": 2103.94, "text": "其中一定有诈,"}, {"start": 2103.94, "end": 2105.94, "text": "于是在下急令快马,"}, {"start": 2105.94, "end": 2106.94, "text": "豁速追上,"}, {"start": 2106.94, "end": 2107.94, "text": "用乱剑将其射翻,"}, {"start": 2107.94, "end": 2110.94, "text": "然后从他的腰间,"}, {"start": 2110.94, "end": 2113.94, "text": "搜出了曹操的军令。"}, {"start": 2113.94, "end": 2114.94, "text": "主公,"}, {"start": 2114.94, "end": 2130.55, "text": "那曹操,"}, {"start": 2130.55, "end": 2133.55, "text": "分明是粮草已尽,"}, {"start": 2133.55, "end": 2135.55, "text": "兵器缺乏,"}, {"start": 2135.55, "end": 2137.55, "text": "他已经难以支撑了,"}, {"start": 2137.55, "end": 2138.55, "text": "所以,"}, {"start": 2138.55, "end": 2140.55, "text": "这才急令徐州,"}, {"start": 2140.55, "end": 2142.55, "text": "发运粮草兵器,"}, {"start": 2142.55, "end": 2144.55, "text": "以解他的关堵之位。"}, {"start": 2144.55, "end": 2146.55, "text": "完了军令之后,"}, {"start": 2146.55, "end": 2153.78, "text": "方才明白,"}, {"start": 2153.78, "end": 2156.78, "text": "那曹操不防严密,"}, {"start": 2156.78, "end": 2157.78, "text": "没有一丝懈怠,"}, {"start": 2157.78, "end": 2159.78, "text": "全是做给我们看的。"}, {"start": 2159.78, "end": 2160.78, "text": "那曹操是,"}, {"start": 2160.78, "end": 2166.18, "text": "那曹孟德此刻最害怕的,"}, {"start": 2166.18, "end": 2169.18, "text": "就是我们对他的攻袭。"}, {"start": 2169.18, "end": 2170.18, "text": "徐庸,"}, {"start": 2170.18, "end": 2172.18, "text": "你有何打算?"}, {"start": 2172.18, "end": 2173.18, "text": "主公,"}, {"start": 2173.18, "end": 2176.18, "text": "你应该抓住这个绝好的战机,"}, {"start": 2176.18, "end": 2177.18, "text": "四十万大军,"}, {"start": 2177.18, "end": 2179.18, "text": "清朝而出,"}, {"start": 2179.18, "end": 2180.18, "text": "兵分两路,"}, {"start": 2180.18, "end": 2181.18, "text": "一路,"}, {"start": 2181.18, "end": 2182.18, "text": "以十万人马,"}, {"start": 2182.18, "end": 2184.18, "text": "仰攻他在关渡的千里大营,"}, {"start": 2184.18, "end": 2185.18, "text": "另一路,"}, {"start": 2185.18, "end": 2187.18, "text": "击三十万精锐,"}, {"start": 2187.18, "end": 2189.18, "text": "连夜奔袭他的老巢徐昌。"}, {"start": 2189.18, "end": 2190.18, "text": "主公,"}, {"start": 2190.18, "end": 2192.18, "text": "我们的这两路人马,"}, {"start": 2192.18, "end": 2194.18, "text": "无论哪一路能够成功,"}, {"start": 2194.18, "end": 2197.18, "text": "那曹贼必败亡,"}, {"start": 2197.18, "end": 2200.18, "text": "而我需要几乎可以断言,"}, {"start": 2200.18, "end": 2202.18, "text": "我们的这两路人马,"}, {"start": 2202.18, "end": 2204.18, "text": "都会成功。"}, {"start": 2206.18, "end": 2210.79, "text": "这,"}, {"start": 2210.79, "end": 2212.79, "text": "必是曹贼的奸计,"}, {"start": 2212.79, "end": 2214.79, "text": "岂能瞒得过主公啊。"}, {"start": 2214.79, "end": 2216.79, "text": "国徒,"}, {"start": 2216.79, "end": 2218.79, "text": "你怎么能说这是奸计呢?"}, {"start": 2218.79, "end": 2219.79, "text": "那曹操分明是,"}, {"start": 2219.79, "end": 2221.79, "text": "形同雷卵了。"}, {"start": 2221.79, "end": 2222.79, "text": "曹操,"}, {"start": 2222.79, "end": 2224.79, "text": "故意在你的眼皮下,"}, {"start": 2224.79, "end": 2225.79, "text": "放出一个信使,"}, {"start": 2225.79, "end": 2227.79, "text": "好让你截得军令,"}, {"start": 2227.79, "end": 2228.79, "text": "诱骗我军,"}, {"start": 2228.79, "end": 2230.79, "text": "去夜袭曹营。"}, {"start": 2230.79, "end": 2231.79, "text": "而曹操,"}, {"start": 2231.79, "end": 2234.79, "text": "早在那里张网设伏,"}, {"start": 2234.79, "end": 2236.79, "text": "等着我们去送死呢。"}, {"start": 2237.79, "end": 2238.79, "text": "主公,"}, {"start": 2238.79, "end": 2241.79, "text": "那曹贼分明是粮曹已尽,"}, {"start": 2241.79, "end": 2243.79, "text": "兵器缺乏,"}, {"start": 2243.79, "end": 2245.79, "text": "这可是我们剿灭他,"}, {"start": 2245.79, "end": 2246.79, "text": "最好的战机了。"}, {"start": 2246.79, "end": 2247.79, "text": "主公,"}, {"start": 2247.79, "end": 2249.79, "text": "如果是让那曹操得到补充,"}, {"start": 2249.79, "end": 2251.79, "text": "无疑是做失良机,"}, {"start": 2251.79, "end": 2252.79, "text": "甚或是,"}, {"start": 2252.79, "end": 2253.79, "text": "主公,"}, {"start": 2253.79, "end": 2254.79, "text": "这道军令,"}, {"start": 2254.79, "end": 2256.79, "text": "万万不可相信。"}, {"start": 2256.79, "end": 2258.79, "text": "主公难道忘了,"}, {"start": 2258.79, "end": 2259.79, "text": "就在几日前,"}, {"start": 2259.79, "end": 2261.79, "text": "曹操还拿天子作为诱饵,"}, {"start": 2261.79, "end": 2262.79, "text": "乍眼启合,"}, {"start": 2262.79, "end": 2264.79, "text": "连堂堂天子,"}, {"start": 2264.79, "end": 2267.79, "text": "都能被曹操用来做诱饵,"}, {"start": 2267.79, "end": 2269.79, "text": "何况一道军令。"}, {"start": 2269.79, "end": 2270.79, "text": "是啊,"}, {"start": 2271.79, "end": 2277.16, "text": "我又险些中了曹贼的奸计,"}, {"start": 2277.16, "end": 2278.16, "text": "需要,"}, {"start": 2279.16, "end": 2282.76, "text": "今后再有线册,"}, {"start": 2282.76, "end": 2284.76, "text": "定要三思。"}, {"start": 2284.76, "end": 2286.76, "text": "曹操这道军令,"}, {"start": 2286.76, "end": 2299.64, "text": "是否是诡计,"}, {"start": 2299.64, "end": 2305.84, "text": "但令在下着实没有想到,"}, {"start": 2305.84, "end": 2308.84, "text": "那曹操给人诡计多端的印象,"}, {"start": 2309.84, "end": 2311.84, "text": "居然比他本人的诡计,"}, {"start": 2311.84, "end": 2313.84, "text": "还要可怕。"}, {"start": 2313.84, "end": 2315.84, "text": "此话何意?"}, {"start": 2315.84, "end": 2317.84, "text": "因为在你郭徒眼里,"}, {"start": 2317.84, "end": 2322.27, "text": "那曹营处处都是陷阱,"}, {"start": 2322.27, "end": 2325.27, "text": "那曹操事事都诡计多端。"}, {"start": 2325.27, "end": 2327.27, "text": "由此可见,"}, {"start": 2327.27, "end": 2329.27, "text": "世人已经被那个曹操,"}, {"start": 2329.27, "end": 2331.27, "text": "给吓怕了。"}, {"start": 2331.27, "end": 2333.27, "text": "其实那个曹操,"}, {"start": 2333.27, "end": 2334.27, "text": "那么强大,"}, {"start": 2334.27, "end": 2335.27, "text": "可正是在,"}, {"start": 2335.27, "end": 2336.27, "text": "你们这些人心目中,"}, {"start": 2336.27, "end": 2341.18, "text": "对他的恐惧,"}, {"start": 2341.18, "end": 2344.18, "text": "助长了那个曹操的强大呀。"}, {"start": 2344.18, "end": 2346.18, "text": "徐幽,"}, {"start": 2346.18, "end": 2348.18, "text": "你放肆了。"}, {"start": 2348.18, "end": 2349.18, "text": "主公,"}, {"start": 2349.18, "end": 2350.18, "text": "主公,"}, {"start": 2350.18, "end": 2351.18, "text": "恕罪。"}, {"start": 2351.18, "end": 2359.01, "text": "主公,"}, {"start": 2359.01, "end": 2362.01, "text": "在下偶尔放肆一下,"}, {"start": 2362.01, "end": 2364.01, "text": "要远比那曹孟德,"}, {"start": 2364.01, "end": 2365.01, "text": "放肆一生,"}, {"start": 2365.01, "end": 2369.5, "text": "要强啊。"}, {"start": 2369.5, "end": 2370.5, "text": "主公,"}, {"start": 2370.5, "end": 2372.5, "text": "天封已在狱中附件。"}, {"start": 2372.5, "end": 2378.63, "text": "他死了,"}, {"start": 2378.63, "end": 2379.63, "text": "死了。"}, {"start": 2379.63, "end": 2385.02, "text": "天封,"}, {"start": 2385.02, "end": 2389.94, "text": "可有一言?"}, {"start": 2389.94, "end": 2391.94, "text": "天别家临死前,"}, {"start": 2391.94, "end": 2393.94, "text": "为主公留下一封书信。"}, {"start": 2393.94, "end": 2395.94, "text": "我心乱如麻,"}, {"start": 2395.94, "end": 2408.18, "text": "还是你念吧。"}, {"start": 2408.18, "end": 2410.18, "text": "主公啊,"}, {"start": 2410.18, "end": 2417.62, "text": "当在下的死讯,"}, {"start": 2417.62, "end": 2419.62, "text": "到主公的面前,"}, {"start": 2419.62, "end": 2421.62, "text": "主公一定会后悔的。"}, {"start": 2421.62, "end": 2422.62, "text": "因为在下,"}, {"start": 2422.62, "end": 2424.62, "text": "虽然是才傲上,"}, {"start": 2424.62, "end": 2426.62, "text": "但在下罪不至死。"}, {"start": 2426.62, "end": 2428.62, "text": "主令在下,"}, {"start": 2428.62, "end": 2430.62, "text": "一定有小人尽缠。"}, {"start": 2430.62, "end": 2431.62, "text": "这个小人,"}, {"start": 2431.62, "end": 2438.42, "text": "就是貌似忠诚的许幽。"}, {"start": 2438.42, "end": 2440.42, "text": "许幽跟曹操是少年密友,"}, {"start": 2440.42, "end": 2442.42, "text": "同窗发小。"}, {"start": 2442.42, "end": 2445.42, "text": "他们藕断丝连红雁传书。"}, {"start": 2445.42, "end": 2448.42, "text": "如果主公胜了曹操,"}, {"start": 2448.42, "end": 2451.42, "text": "许幽会结成尽忠主公。"}, {"start": 2451.42, "end": 2453.42, "text": "如果主公败于曹操,"}, {"start": 2453.42, "end": 2457.42, "text": "许幽会背主投敌。"}, {"start": 2457.42, "end": 2458.42, "text": "这,"}, {"start": 2458.42, "end": 2467.69, "text": "想不到。"}, {"start": 2467.69, "end": 2473.76, "text": "这个天封在临死之前,"}, {"start": 2473.76, "end": 2475.76, "text": "还要在我的心窝子上,"}, {"start": 2475.76, "end": 2478.76, "text": "捅上一刀啊。"}, {"start": 2478.76, "end": 2480.76, "text": "许幽,"}, {"start": 2480.76, "end": 2482.76, "text": "你是否与那曹操"}, {"start": 2482.76, "end": 2484.76, "text": "是发小?"}, {"start": 2484.76, "end": 2485.76, "text": "是,"}, {"start": 2485.76, "end": 2487.76, "text": "禀主公。"}, {"start": 2487.76, "end": 2489.76, "text": "许幽的老家和那曹操的老家"}, {"start": 2489.76, "end": 2491.76, "text": "相距不过二年。"}, {"start": 2491.76, "end": 2492.76, "text": "少时,"}, {"start": 2492.76, "end": 2495.76, "text": "我也曾与那曹操同窗共渡。"}, {"start": 2495.76, "end": 2497.76, "text": "但是,"}, {"start": 2497.76, "end": 2499.76, "text": "自从我临死前,"}, {"start": 2499.76, "end": 2501.76, "text": "自从我许幽决意"}, {"start": 2501.76, "end": 2502.76, "text": "跟随主公以来,"}, {"start": 2502.76, "end": 2504.76, "text": "我就与那曹贼"}, {"start": 2504.76, "end": 2505.76, "text": "生不两立,"}, {"start": 2505.76, "end": 2507.76, "text": "死不相容。"}, {"start": 2507.76, "end": 2512.42, "text": "你有没有和曹操互通红雁,"}, {"start": 2512.42, "end": 2514.42, "text": "藕断丝连?"}, {"start": 2514.42, "end": 2515.42, "text": "没有没有没有,"}, {"start": 2515.42, "end": 2516.42, "text": "主公,"}, {"start": 2516.42, "end": 2517.42, "text": "万万没有。"}, {"start": 2517.42, "end": 2519.42, "text": "这一定是那天封对我的诬陷啊。"}, {"start": 2519.42, "end": 2520.42, "text": "主公,"}, {"start": 2520.42, "end": 2522.42, "text": "这常言道,"}, {"start": 2522.42, "end": 2525.42, "text": "人之将死,其言也哀。"}, {"start": 2525.42, "end": 2527.42, "text": "那这天封在临死之前"}, {"start": 2527.42, "end": 2529.42, "text": "对我的诬陷,"}, {"start": 2529.42, "end": 2536.77, "text": "一定是革命。"}, {"start": 2536.77, "end": 2537.77, "text": "许幽,"}, {"start": 2537.77, "end": 2540.77, "text": "你律尽禅言害死巅峰。"}, {"start": 2540.77, "end": 2545.27, "text": "你这个头现在是寄存在你这儿。"}, {"start": 2545.27, "end": 2547.27, "text": "等我灭了曹贼,"}, {"start": 2547.27, "end": 2549.27, "text": "我再明察言办。"}, {"start": 2549.27, "end": 2570.5, "text": "庸主,"}, {"start": 2570.5, "end": 2584.55, "text": "天封之后。"}, {"start": 2584.55, "end": 2613.14, "text": "主公,"}, {"start": 2613.14, "end": 2614.14, "text": "外面有一位来客,"}, {"start": 2614.14, "end": 2616.14, "text": "自称是主公咎由许幽,"}, {"start": 2616.14, "end": 2617.14, "text": "请求拜见主公。"}, {"start": 2617.14, "end": 2619.38, "text": "许幽?"}]