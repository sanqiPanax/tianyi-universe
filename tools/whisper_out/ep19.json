[{"start": 3.15, "end": 6.75, "text": "徐州城不愧为中原第一雄官"}, {"start": 7.15, "end": 12.2, "text": "想当年楚霸王项羽就是在此地"}, {"start": 12.2, "end": 14.4, "text": "用三万铁技杀的高祖弟"}, {"start": 14.4, "end": 17.0, "text": "五十万兵马士片甲不留啊"}, {"start": 18.4, "end": 21.8, "text": "徐州让我浑浅梦绕"}, {"start": 22.0, "end": 25.2, "text": "今日终于美梦成真了"}, {"start": 26.2, "end": 27.4, "text": "一看便知"}, {"start": 27.6, "end": 31.0, "text": "如此雄官区区吕布怎配具有"}, {"start": 31.2, "end": 33.8, "text": "雄官应当归属名主"}, {"start": 34.0, "end": 36.0, "text": "今日已成正果"}, {"start": 37.2, "end": 38.8, "text": "主公得徐州以后"}, {"start": 38.8, "end": 40.6, "text": "进可攻退可守"}, {"start": 41.2, "end": 42.6, "text": "鼎立中原之日"}, {"start": 43.2, "end": 45.0, "text": "为期不远矣"}, {"start": 45.0, "end": 46.2, "text": "说到吕布"}, {"start": 46.2, "end": 47.8, "text": "我想起一个人"}, {"start": 48.4, "end": 50.4, "text": "在下如果没有猜错的话"}, {"start": 51.2, "end": 53.2, "text": "主公八成想起貂蝉来了"}, {"start": 53.6, "end": 54.6, "text": "他怎么样"}, {"start": 55.8, "end": 57.2, "text": "吕布死了以后"}, {"start": 57.6, "end": 59.0, "text": "貂蝉是不吃不喝"}, {"start": 59.0, "end": 60.4, "text": "更不梳妆打扮"}, {"start": 60.6, "end": 61.8, "text": "整天呆坐着"}, {"start": 62.0, "end": 63.0, "text": "试着问他"}, {"start": 63.4, "end": 64.8, "text": "他只有一个请求"}, {"start": 65.0, "end": 65.8, "text": "什么"}, {"start": 66.4, "end": 68.0, "text": "要为吕布收尸"}, {"start": 69.0, "end": 69.6, "text": "主公"}, {"start": 70.2, "end": 71.6, "text": "恕在下直言"}, {"start": 72.4, "end": 73.8, "text": "不要招惹调查"}, {"start": 74.0, "end": 75.6, "text": "此女太过妖艳"}, {"start": 76.0, "end": 77.2, "text": "乱人心性"}, {"start": 77.6, "end": 78.6, "text": "主公休忘了"}, {"start": 78.8, "end": 80.8, "text": "董卓和吕布的下场"}, {"start": 86.38, "end": 87.18, "text": "荀玉啊"}, {"start": 87.98, "end": 89.38, "text": "多谢你的忠告"}, {"start": 90.38, "end": 92.38, "text": "但我既非董卓"}, {"start": 92.58, "end": 93.78, "text": "更非吕布"}, {"start": 106.47, "end": 107.27, "text": "小姐"}, {"start": 108.27, "end": 109.47, "text": "小姐请看"}, {"start": 109.67, "end": 112.27, "text": "这些都是曹将军送你的服饰"}, {"start": 112.47, "end": 114.47, "text": "渐渐都是珍奇之物"}, {"start": 114.67, "end": 116.87, "text": "就连长安宫里的嫔妃们"}, {"start": 117.07, "end": 118.47, "text": "可都得不到"}, {"start": 118.67, "end": 119.47, "text": "小姐"}, {"start": 119.67, "end": 121.47, "text": "快快梳妆打扮起来吧"}, {"start": 121.67, "end": 127.85, "text": "曹将军说了"}, {"start": 128.05, "end": 130.45, "text": "只要小姐把这些衣服穿起来"}, {"start": 130.65, "end": 132.65, "text": "事后曹将军一次酒宴"}, {"start": 132.85, "end": 135.45, "text": "曹将军什么条件都答应你"}, {"start": 135.45, "end": 142.91, "text": "我夫君收尸"}, {"start": 143.91, "end": 145.51, "text": "曹将军准了"}, {"start": 145.51, "end": 147.31, "text": "我要南暮棺材一口"}, {"start": 147.51, "end": 150.88, "text": "六尺一石一方"}, {"start": 151.08, "end": 154.62, "text": "以王宫治理后葬"}, {"start": 154.82, "end": 158.28, "text": "背上还要切命"}, {"start": 165.04, "end": 166.64, "text": "分威将军"}, {"start": 166.84, "end": 168.64, "text": "屡凤仙之目"}, {"start": 168.84, "end": 170.84, "text": "曹将军准了"}, {"start": 171.04, "end": 174.91, "text": "我还有一个请求"}, {"start": 175.11, "end": 178.68, "text": "我死后"}, {"start": 180.28, "end": 181.88, "text": "要和我的夫君"}, {"start": 183.56, "end": 184.76, "text": "站在一起"}, {"start": 187.73, "end": 188.33, "text": "准"}, {"start": 188.53, "end": 262.38, "text": "多亏各位将军"}, {"start": 262.58, "end": 263.78, "text": "费用必杀"}, {"start": 264.18, "end": 266.18, "text": "方能拿下徐州"}, {"start": 266.78, "end": 268.18, "text": "我与各位将军"}, {"start": 268.18, "end": 269.58, "text": "同饮此杯"}, {"start": 269.78, "end": 271.18, "text": "一醉方休"}, {"start": 272.18, "end": 274.18, "text": "恭送将军"}, {"start": 274.98, "end": 275.58, "text": "干"}, {"start": 275.58, "end": 276.58, "text": "干"}, {"start": 302.25, "end": 303.25, "text": "徐先生"}, {"start": 304.65, "end": 305.85, "text": "来来来 倒酒"}, {"start": 306.45, "end": 307.25, "text": "先生"}, {"start": 307.65, "end": 310.25, "text": "今天咱们俩说什么都得喝"}, {"start": 311.45, "end": 312.25, "text": "将军"}, {"start": 312.45, "end": 313.65, "text": "我真的喝不完"}, {"start": 313.65, "end": 314.45, "text": "你喝吧"}, {"start": 315.25, "end": 316.05, "text": "别呀"}, {"start": 316.45, "end": 319.94, "text": "先生"}, {"start": 320.34, "end": 321.14, "text": "等等"}, {"start": 321.54, "end": 325.66, "text": "你太什么气呢"}, {"start": 327.06, "end": 327.86, "text": "没事"}, {"start": 328.46, "end": 329.46, "text": "我真的没事"}, {"start": 329.86, "end": 330.66, "text": "你喝吧"}, {"start": 330.66, "end": 331.46, "text": "不不不"}, {"start": 332.26, "end": 335.75, "text": "等等"}, {"start": 335.75, "end": 336.95, "text": "你肯定有事"}, {"start": 337.75, "end": 338.55, "text": "告诉我"}, {"start": 338.95, "end": 340.35, "text": "这大喜的日子"}, {"start": 340.75, "end": 342.35, "text": "你瞅什么呀"}, {"start": 344.93, "end": 345.93, "text": "真的没事"}, {"start": 345.93, "end": 346.73, "text": "不不不"}, {"start": 348.13, "end": 349.13, "text": "你肯定有事"}, {"start": 349.73, "end": 353.11, "text": "你要是不告诉我"}, {"start": 353.31, "end": 354.71, "text": "我就不让你走"}, {"start": 354.71, "end": 360.63, "text": "好好好"}, {"start": 360.83, "end": 361.63, "text": "徐将军"}, {"start": 361.63, "end": 362.63, "text": "你知道吗"}, {"start": 363.03, "end": 364.83, "text": "主公喜欢女人呢"}, {"start": 365.03, "end": 366.03, "text": "你很提神"}, {"start": 366.03, "end": 367.23, "text": "谁不喜欢女人"}, {"start": 367.23, "end": 368.83, "text": "我徐主也喜欢女人"}, {"start": 369.43, "end": 370.63, "text": "你喜欢的女人"}, {"start": 370.63, "end": 372.23, "text": "和主公喜欢的女人"}, {"start": 372.23, "end": 373.63, "text": "根本就不一样"}, {"start": 374.03, "end": 376.43, "text": "主公喜欢的是一分少父"}, {"start": 376.43, "end": 378.43, "text": "尤其是别人家的媳妇"}, {"start": 378.83, "end": 380.63, "text": "你还记得张秀的事吗"}, {"start": 381.03, "end": 382.23, "text": "我当然记得了"}, {"start": 383.23, "end": 384.83, "text": "主公那天喝醉了"}, {"start": 385.23, "end": 386.83, "text": "把湘江张秀的小伯母"}, {"start": 386.83, "end": 388.03, "text": "招来示警"}, {"start": 388.63, "end": 390.03, "text": "张秀不堪欺辱"}, {"start": 390.03, "end": 391.83, "text": "竟然乘以攻杀主后"}, {"start": 392.03, "end": 393.83, "text": "要不是叠为后家"}, {"start": 393.83, "end": 397.46, "text": "公早死了"}, {"start": 397.86, "end": 401.0, "text": "徐将军"}, {"start": 401.6, "end": 403.2, "text": "就是为此丧命"}, {"start": 405.17, "end": 406.37, "text": "今晚主公"}, {"start": 407.57, "end": 409.17, "text": "要比那天夜里"}, {"start": 410.37, "end": 411.37, "text": "更加危"}, {"start": 411.37, "end": 414.8, "text": "怎么着"}, {"start": 416.4, "end": 417.0, "text": "你快说"}, {"start": 417.2, "end": 421.03, "text": "主公已经发话"}, {"start": 421.03, "end": 422.63, "text": "他今夜要去白门楼"}, {"start": 423.23, "end": 424.43, "text": "你知道白门楼里"}, {"start": 424.43, "end": 425.43, "text": "住的是谁吗"}, {"start": 426.03, "end": 426.63, "text": "谁"}, {"start": 427.03, "end": 427.83, "text": "刁蝉"}, {"start": 429.8, "end": 431.8, "text": "这个妖女怎么还没死"}, {"start": 432.2, "end": 433.4, "text": "非但没死"}, {"start": 434.4, "end": 436.4, "text": "还打扮得如花似玉"}, {"start": 436.8, "end": 438.6, "text": "正准备接待主公啊"}, {"start": 441.14, "end": 441.94, "text": "徐卓"}, {"start": 442.74, "end": 443.74, "text": "你可别忘了"}, {"start": 445.42, "end": 446.82, "text": "东卓和吕布"}, {"start": 446.82, "end": 448.82, "text": "就是因为刁蝉而死的"}, {"start": 449.42, "end": 451.22, "text": "此女太过妖艳"}, {"start": 451.42, "end": 458.5, "text": "心非啊"}, {"start": 460.4, "end": 462.2, "text": "她一旦颤上主公"}, {"start": 462.6, "end": 463.6, "text": "那可真是"}, {"start": 463.8, "end": 465.2, "text": "祸水横流"}, {"start": 465.8, "end": 468.2, "text": "肯定会殃及三军哪"}, {"start": 468.6, "end": 471.0, "text": "我现在就去除了祸水"}, {"start": 473.0, "end": 473.6, "text": "等等"}, {"start": 477.2, "end": 478.6, "text": "你就不怕主公"}, {"start": 479.6, "end": 480.6, "text": "降罪吗"}, {"start": 482.0, "end": 485.03, "text": "我徐卓跟随主公"}, {"start": 485.03, "end": 486.03, "text": "厮杀杜宁"}, {"start": 486.43, "end": 487.83, "text": "九死一生"}, {"start": 487.83, "end": 490.86, "text": "何惧之有"}, {"start": 491.06, "end": 568.47, "text": "如此长袖善舞"}, {"start": 568.67, "end": 571.27, "text": "不知醉倒了多少英雄豪杰"}, {"start": 571.67, "end": 575.07, "text": "我这一唱"}, {"start": 575.67, "end": 576.87, "text": "不是为了将军"}, {"start": 577.67, "end": 579.07, "text": "是为了我夫君"}, {"start": 579.67, "end": 582.64, "text": "难道在你心中"}, {"start": 582.64, "end": 585.04, "text": "我曹操还比不上一个吕布吗"}, {"start": 586.44, "end": 587.24, "text": "是"}, {"start": 588.44, "end": 589.44, "text": "在我心中"}, {"start": 590.44, "end": 592.24, "text": "将军是不如的"}, {"start": 592.44, "end": 593.44, "text": "为什么呢"}, {"start": 594.84, "end": 596.04, "text": "我夫君真诚"}, {"start": 597.44, "end": 598.64, "text": "将军老了"}, {"start": 599.84, "end": 601.24, "text": "我夫君善良"}, {"start": 602.64, "end": 603.84, "text": "将军谦写"}, {"start": 604.44, "end": 607.73, "text": "我夫君多情"}, {"start": 608.13, "end": 612.99, "text": "将军无意"}, {"start": 614.59, "end": 616.39, "text": "所以即便你是杀了他"}, {"start": 617.39, "end": 618.59, "text": "在我心里"}, {"start": 619.39, "end": 621.19, "text": "你永远不如他"}, {"start": 624.7, "end": 625.5, "text": "将军"}, {"start": 632.81, "end": 634.41, "text": "知道这是什么吗"}, {"start": 634.41, "end": 635.61, "text": "七星刀"}, {"start": 646.13, "end": 647.73, "text": "那你知道它的来历吗"}, {"start": 648.13, "end": 651.33, "text": "这你算十分对人了"}, {"start": 651.53, "end": 652.53, "text": "大概在"}, {"start": 657.41, "end": 658.61, "text": "八百多年前吧"}, {"start": 659.01, "end": 661.01, "text": "有一颗流星落在了月底"}, {"start": 661.41, "end": 663.41, "text": "烧红了五十多里山川"}, {"start": 665.01, "end": 666.01, "text": "当天夜里"}, {"start": 666.81, "end": 668.21, "text": "干江莫爷夫妇"}, {"start": 668.41, "end": 669.81, "text": "就取回了流星"}, {"start": 669.81, "end": 671.21, "text": "铸成了两把宝剑"}, {"start": 671.41, "end": 672.41, "text": "一把叫干江"}, {"start": 672.41, "end": 673.61, "text": "一把叫莫爷"}, {"start": 673.81, "end": 676.01, "text": "也就是吴王剑和岳王剑"}, {"start": 676.01, "end": 678.41, "text": "铸完这两把宝剑剩下的云铁"}, {"start": 678.41, "end": 680.61, "text": "只能够断造一把的刀"}, {"start": 681.61, "end": 683.21, "text": "就是这把七星刀"}, {"start": 683.61, "end": 685.41, "text": "吴王剑和岳王剑"}, {"start": 685.61, "end": 693.15, "text": "都已经是名满天下了"}, {"start": 693.55, "end": 694.55, "text": "七星刀"}, {"start": 695.35, "end": 699.41, "text": "默默无闻"}, {"start": 700.01, "end": 701.81, "text": "一直不为人所知"}, {"start": 702.81, "end": 703.81, "text": "一直到"}, {"start": 704.81, "end": 705.81, "text": "我草草"}, {"start": 706.21, "end": 707.21, "text": "指此刀"}, {"start": 707.61, "end": 709.21, "text": "刺杀董卓的手"}, {"start": 709.41, "end": 710.41, "text": "可惜啊"}, {"start": 710.81, "end": 714.1, "text": "董贼也不敢"}, {"start": 714.1, "end": 715.1, "text": "可惜啊"}, {"start": 715.3, "end": 716.9, "text": "董贼命不当局"}, {"start": 718.71, "end": 719.51, "text": "怎么"}, {"start": 720.11, "end": 721.11, "text": "今天"}, {"start": 721.11, "end": 722.51, "text": "你想用它来"}, {"start": 722.71, "end": 723.51, "text": "杀我"}, {"start": 728.97, "end": 730.17, "text": "我是要把它"}, {"start": 731.77, "end": 732.97, "text": "还给上天"}, {"start": 736.65, "end": 738.25, "text": "如今我就是天"}, {"start": 740.47, "end": 762.1, "text": "拿来"}, {"start": 762.1, "end": 763.9, "text": "他没想杀我"}, {"start": 764.1, "end": 766.7, "text": "他只是想自杀你这个屁股"}, {"start": 766.9, "end": 767.9, "text": "他死得好"}, {"start": 775.1, "end": 778.23, "text": "是寻衣叫你来的吧"}, {"start": 778.43, "end": 780.43, "text": "自己到监军那领三十军棍"}, {"start": 780.83, "end": 784.61, "text": "诺"}, {"start": 784.81, "end": 786.21, "text": "罢了免了吧"}, {"start": 786.81, "end": 787.41, "text": "不"}, {"start": 787.81, "end": 788.61, "text": "不免"}, {"start": 788.81, "end": 789.41, "text": "抹去"}, {"start": 823.5, "end": 824.7, "text": "大伙听战"}, {"start": 826.3, "end": 827.1, "text": "此役"}, {"start": 827.9, "end": 830.3, "text": "我们一起收取徐州六郡"}, {"start": 830.7, "end": 831.7, "text": "为震天下"}, {"start": 831.9, "end": 832.9, "text": "实力大增"}, {"start": 833.7, "end": 836.3, "text": "这也是咱们自起兵以来"}, {"start": 837.1, "end": 838.9, "text": "取得的最大的一场胜利"}, {"start": 839.7, "end": 840.7, "text": "为此"}, {"start": 841.1, "end": 842.5, "text": "我足足高兴了"}, {"start": 843.3, "end": 844.3, "text": "半个时辰"}, {"start": 846.1, "end": 847.7, "text": "可是半个时辰之后"}, {"start": 848.3, "end": 850.5, "text": "我的心情又倍绝沉重"}, {"start": 850.7, "end": 852.1, "text": "你们知道为什么吗"}, {"start": 855.1, "end": 856.9, "text": "因为济州袁绍"}, {"start": 857.5, "end": 859.9, "text": "毫发公孙瓒的一战"}, {"start": 860.7, "end": 862.5, "text": "正在激烈地进行"}, {"start": 863.7, "end": 865.1, "text": "这几个月以来"}, {"start": 866.1, "end": 867.9, "text": "袁绍步步紧逼"}, {"start": 868.1, "end": 870.5, "text": "公孙瓒是损兵折将"}, {"start": 870.7, "end": 872.9, "text": "照此下去用不了多长时间"}, {"start": 873.1, "end": 874.9, "text": "幽州就是袁绍的了"}, {"start": 875.7, "end": 876.9, "text": "如此一来"}, {"start": 877.3, "end": 878.5, "text": "这大汉天下"}, {"start": 878.9, "end": 880.7, "text": "袁绍一个人就独享了"}, {"start": 880.7, "end": 882.1, "text": "清幽并济四个州"}, {"start": 882.1, "end": 884.1, "text": "成为天下最大的诸侯"}, {"start": 884.3, "end": 885.9, "text": "你们知道这意味着什么"}, {"start": 887.7, "end": 889.7, "text": "意味着主公与袁绍之间"}, {"start": 890.1, "end": 892.1, "text": "定有一场生死决战"}, {"start": 892.7, "end": 895.3, "text": "此战决定天下归宿"}, {"start": 895.5, "end": 896.3, "text": "没错"}, {"start": 897.3, "end": 898.7, "text": "那你们知道此刻"}, {"start": 899.9, "end": 901.1, "text": "我最盼望什么"}, {"start": 901.9, "end": 903.1, "text": "主公盼望的是"}, {"start": 903.3, "end": 904.9, "text": "现在袁绍与公孙瓒"}, {"start": 905.1, "end": 906.5, "text": "最好不分胜败"}, {"start": 906.9, "end": 908.3, "text": "拖得越久越好"}, {"start": 908.5, "end": 910.7, "text": "以便让袁绍兵力受损"}, {"start": 910.9, "end": 912.9, "text": "为主公赢得时间"}, {"start": 913.1, "end": 914.3, "text": "为最后的决战"}, {"start": 914.5, "end": 916.5, "text": "做充分准备"}, {"start": 918.7, "end": 919.5, "text": "对"}, {"start": 924.0, "end": 924.8, "text": "听命"}, {"start": 926.2, "end": 928.0, "text": "后天班师回许昌"}, {"start": 928.4, "end": 930.4, "text": "整军备战"}, {"start": 930.6, "end": 931.4, "text": "遵命"}, {"start": 941.9, "end": 942.9, "text": "为何发愁啊"}, {"start": 944.1, "end": 947.99, "text": "曹操后天就要班师了"}, {"start": 948.19, "end": 949.19, "text": "我在想"}, {"start": 950.9, "end": 952.5, "text": "我们该何去何从啊"}, {"start": 953.1, "end": 955.1, "text": "现在徐州是他的掌中务"}, {"start": 958.43, "end": 959.83, "text": "曹操不是答应了"}, {"start": 960.23, "end": 961.63, "text": "让你做徐中务吗"}, {"start": 964.43, "end": 965.63, "text": "他还答应吕布"}, {"start": 965.83, "end": 967.23, "text": "做三军大元帅呢"}, {"start": 969.58, "end": 970.38, "text": "曹操"}, {"start": 970.98, "end": 972.18, "text": "不还我们徐州"}, {"start": 972.78, "end": 975.78, "text": "让我们屯住小佩也成啊"}, {"start": 977.81, "end": 980.21, "text": "你为朝廷立下过汉马功劳"}, {"start": 981.21, "end": 983.61, "text": "就为曹操受了这么多的委屈"}, {"start": 984.01, "end": 985.61, "text": "难道他连一座小城"}, {"start": 985.81, "end": 986.81, "text": "都不舍得吗"}, {"start": 989.22, "end": 991.22, "text": "他若能准我住小佩"}, {"start": 992.42, "end": 993.82, "text": "那我当然高兴"}, {"start": 994.42, "end": 996.62, "text": "我根本就不想随他去许昌"}, {"start": 997.02, "end": 997.82, "text": "现在"}, {"start": 999.22, "end": 1001.02, "text": "离这个人越远越好"}, {"start": 1003.56, "end": 1004.16, "text": "一德"}, {"start": 1005.36, "end": 1006.36, "text": "你意如何"}, {"start": 1009.12, "end": 1010.72, "text": "我才不操那份闲心呢"}, {"start": 1011.12, "end": 1011.92, "text": "大哥的意思"}, {"start": 1012.12, "end": 1013.12, "text": "那就是我的意思"}, {"start": 1014.32, "end": 1016.12, "text": "三弟倒是省心"}, {"start": 1016.72, "end": 1017.52, "text": "那当然了"}, {"start": 1017.72, "end": 1018.92, "text": "这老大个天下"}, {"start": 1019.12, "end": 1020.52, "text": "岂能没咱容身的地方"}, {"start": 1021.32, "end": 1022.72, "text": "你们瞅个甚呢"}, {"start": 1026.79, "end": 1028.39, "text": "班师在即"}, {"start": 1031.35, "end": 1032.55, "text": "其余的大事"}, {"start": 1032.55, "end": 1034.55, "text": "我都已经有所安排了"}, {"start": 1036.62, "end": 1037.82, "text": "可是有个人"}, {"start": 1038.62, "end": 1040.22, "text": "该如何处置呢"}, {"start": 1041.22, "end": 1042.22, "text": "站前"}, {"start": 1043.62, "end": 1045.42, "text": "你们仨一个叫我杀"}, {"start": 1046.82, "end": 1048.02, "text": "一个叫我用"}, {"start": 1048.82, "end": 1050.82, "text": "一个叫我用后再杀"}, {"start": 1052.42, "end": 1055.02, "text": "现在班师在即啊"}, {"start": 1056.82, "end": 1058.42, "text": "我们该拿他怎么办呢"}, {"start": 1059.02, "end": 1060.02, "text": "吕布已亡"}, {"start": 1060.82, "end": 1062.62, "text": "徐州已归属主宫"}, {"start": 1063.42, "end": 1064.62, "text": "刘备无处依靠"}, {"start": 1064.82, "end": 1066.42, "text": "他只好投奔主宫"}, {"start": 1066.82, "end": 1068.02, "text": "现在杀他"}, {"start": 1068.82, "end": 1070.02, "text": "已经没有必要"}, {"start": 1070.62, "end": 1071.22, "text": "相反"}, {"start": 1072.02, "end": 1073.02, "text": "用之更好"}, {"start": 1073.82, "end": 1075.82, "text": "无尽其力人尽其才"}, {"start": 1076.22, "end": 1077.42, "text": "主宫也享受"}, {"start": 1077.82, "end": 1079.82, "text": "人间爱闲之美称"}, {"start": 1080.82, "end": 1081.82, "text": "敢问主宫"}, {"start": 1082.02, "end": 1083.42, "text": "是否答应过刘备"}, {"start": 1083.62, "end": 1085.02, "text": "令其坐徐州墓"}, {"start": 1086.82, "end": 1087.62, "text": "好像是有"}, {"start": 1088.02, "end": 1088.82, "text": "记不清了"}, {"start": 1091.75, "end": 1092.95, "text": "请主宫明言吧"}, {"start": 1093.35, "end": 1094.75, "text": "有还是没有"}, {"start": 1096.78, "end": 1097.58, "text": "有"}, {"start": 1098.38, "end": 1100.38, "text": "那么主宫不可实言"}, {"start": 1100.78, "end": 1101.78, "text": "在下建议"}, {"start": 1101.98, "end": 1103.58, "text": "赐刘备为徐州墓"}, {"start": 1103.78, "end": 1105.38, "text": "但只受其名分"}, {"start": 1105.58, "end": 1106.78, "text": "而不给其实权"}, {"start": 1107.38, "end": 1109.58, "text": "令派可靠将领助守徐州"}, {"start": 1109.78, "end": 1111.98, "text": "总揽军政民政"}, {"start": 1113.18, "end": 1114.18, "text": "刘备呢"}, {"start": 1115.58, "end": 1117.38, "text": "令其助守小佩即可"}, {"start": 1121.69, "end": 1122.89, "text": "在下附议"}, {"start": 1126.53, "end": 1128.13, "text": "在下也附议"}, {"start": 1133.84, "end": 1134.64, "text": "好吧"}, {"start": 1136.24, "end": 1137.04, "text": "就这么办"}, {"start": 1140.8, "end": 1141.6, "text": "禀主宫"}, {"start": 1141.8, "end": 1143.8, "text": "有几位士绅父老求见主宫"}, {"start": 1143.8, "end": 1144.4, "text": "何事"}, {"start": 1145.0, "end": 1146.8, "text": "他们听说主宫要回徐昌了"}, {"start": 1147.0, "end": 1147.6, "text": "大吉"}, {"start": 1147.8, "end": 1149.4, "text": "代表徐州五十万百姓"}, {"start": 1149.4, "end": 1151.0, "text": "向主宫敬献万民书"}, {"start": 1154.54, "end": 1155.34, "text": "这"}, {"start": 1155.94, "end": 1157.14, "text": "真想不到"}, {"start": 1158.54, "end": 1161.34, "text": "咱们刚到徐州每两天"}, {"start": 1161.54, "end": 1164.14, "text": "徐州的百姓就如此爱待咱们"}, {"start": 1164.74, "end": 1166.14, "text": "铭心可依啊"}, {"start": 1167.74, "end": 1168.54, "text": "快请进来"}, {"start": 1168.74, "end": 1169.14, "text": "诺"}, {"start": 1182.28, "end": 1183.88, "text": "小民 奴役族等"}, {"start": 1184.08, "end": 1185.88, "text": "拜见曹大将军"}, {"start": 1185.88, "end": 1187.88, "text": "拜见曹大将军"}, {"start": 1187.88, "end": 1188.48, "text": "请起"}, {"start": 1193.75, "end": 1195.35, "text": "我等听说大将军"}, {"start": 1195.35, "end": 1196.75, "text": "就要返回徐昌"}, {"start": 1197.15, "end": 1199.35, "text": "特代表徐州六郡的百姓"}, {"start": 1199.95, "end": 1202.75, "text": "向大将军来敬成万民书"}, {"start": 1203.15, "end": 1204.55, "text": "恳请大将军"}, {"start": 1205.35, "end": 1207.15, "text": "留下刘公玄德"}, {"start": 1208.55, "end": 1211.75, "text": "让他重新担任徐州墓"}, {"start": 1212.75, "end": 1213.35, "text": "谁"}, {"start": 1214.15, "end": 1215.55, "text": "刘公玄德"}, {"start": 1217.35, "end": 1218.35, "text": "即是刘备"}, {"start": 1218.95, "end": 1221.77, "text": "为什么呢"}, {"start": 1222.77, "end": 1223.77, "text": "禀大将军"}, {"start": 1224.37, "end": 1226.57, "text": "刘备爱民啊"}, {"start": 1227.37, "end": 1228.57, "text": "陶签死后"}, {"start": 1228.77, "end": 1230.97, "text": "刘备曾经担任过"}, {"start": 1230.97, "end": 1232.57, "text": "九个月的徐州墓"}, {"start": 1233.57, "end": 1234.57, "text": "那九个月"}, {"start": 1234.97, "end": 1237.77, "text": "是我徐州最太平的时光啊"}, {"start": 1238.97, "end": 1242.17, "text": "刘备与各乡镇定立约法"}, {"start": 1242.37, "end": 1244.97, "text": "霸斥贪官 减轻赋税"}, {"start": 1244.97, "end": 1247.57, "text": "还建了三座遍民桥"}, {"start": 1247.77, "end": 1249.57, "text": "五百余丈河堤"}, {"start": 1249.77, "end": 1251.97, "text": "饮水灌溉农田"}, {"start": 1252.37, "end": 1254.37, "text": "才有了五谷丰登"}, {"start": 1254.37, "end": 1256.37, "text": "人丁兴旺啊"}, {"start": 1256.97, "end": 1257.97, "text": "大将军啊"}, {"start": 1258.37, "end": 1259.77, "text": "我徐州百姓"}, {"start": 1260.17, "end": 1262.57, "text": "直到现在还有口饭吃"}, {"start": 1263.17, "end": 1265.17, "text": "仍然托付于"}, {"start": 1265.37, "end": 1267.57, "text": "刘备当初的德政"}, {"start": 1268.57, "end": 1269.57, "text": "我等"}, {"start": 1269.97, "end": 1271.57, "text": "已多年未见"}, {"start": 1271.97, "end": 1273.97, "text": "如此鲜明的"}, {"start": 1273.97, "end": 1276.37, "text": "鲜明的主公了"}, {"start": 1276.97, "end": 1278.97, "text": "臣请大将军"}, {"start": 1279.17, "end": 1281.17, "text": "留下刘备吧"}, {"start": 1281.37, "end": 1283.37, "text": "臣请大将军"}, {"start": 1283.57, "end": 1285.57, "text": "留下刘备吧"}, {"start": 1290.75, "end": 1292.75, "text": "刘备如此鲜明"}, {"start": 1293.35, "end": 1296.15, "text": "堪当朝廷栋梁之才"}, {"start": 1297.55, "end": 1298.55, "text": "不过"}, {"start": 1299.35, "end": 1300.95, "text": "让如此大才"}, {"start": 1301.35, "end": 1303.75, "text": "担任区区一州的刺史"}, {"start": 1304.15, "end": 1305.75, "text": "不是太委屈他了吗"}, {"start": 1307.75, "end": 1309.15, "text": "这样你们看"}, {"start": 1309.15, "end": 1315.65, "text": "我把你们这个万民书"}, {"start": 1316.05, "end": 1317.25, "text": "上呈朝廷"}, {"start": 1317.65, "end": 1320.05, "text": "把列位的心意表奏天子"}, {"start": 1320.25, "end": 1321.45, "text": "让天子"}, {"start": 1321.65, "end": 1324.05, "text": "亲自赤封刘备"}, {"start": 1324.25, "end": 1325.05, "text": "可好"}, {"start": 1325.25, "end": 1327.65, "text": "谢 谢大将军"}, {"start": 1327.85, "end": 1330.05, "text": "谢 谢大将军"}, {"start": 1330.85, "end": 1342.13, "text": "还不能让这个刘备留守徐州"}, {"start": 1342.33, "end": 1344.13, "text": "连小胚都不能让他住"}, {"start": 1344.33, "end": 1347.87, "text": "主公你刚才同意"}, {"start": 1348.07, "end": 1350.87, "text": "让刘备在徐州过去"}, {"start": 1350.87, "end": 1352.67, "text": "在徐州挂个虚名"}, {"start": 1352.87, "end": 1354.07, "text": "有名无实啊"}, {"start": 1354.07, "end": 1355.27, "text": "你没有听到刚才那个"}, {"start": 1355.27, "end": 1356.47, "text": "示身的话吗"}, {"start": 1356.87, "end": 1359.47, "text": "刘备在徐州已经深得明心了"}, {"start": 1359.47, "end": 1360.87, "text": "如果让他挂个虚相"}, {"start": 1360.87, "end": 1361.67, "text": "挂着挂着"}, {"start": 1361.67, "end": 1363.07, "text": "他就会变成实的"}, {"start": 1363.07, "end": 1364.67, "text": "而咱们留在徐州的人"}, {"start": 1364.67, "end": 1368.13, "text": "就会变成虚的"}, {"start": 1368.33, "end": 1371.74, "text": "这个不得不防"}, {"start": 1372.14, "end": 1373.14, "text": "刘备"}, {"start": 1374.14, "end": 1377.86, "text": "不能留下"}, {"start": 1377.86, "end": 1388.57, "text": "要把他带回徐城"}, {"start": 1388.57, "end": 1392.77, "text": "曹公"}, {"start": 1395.86, "end": 1397.46, "text": "天子下诏了"}, {"start": 1397.86, "end": 1400.06, "text": "他听说你是皇室后裔"}, {"start": 1400.06, "end": 1402.66, "text": "又在徐州剿贼中立下大功"}, {"start": 1402.86, "end": 1404.26, "text": "隆心大悦啊"}, {"start": 1407.0, "end": 1408.2, "text": "臣刘备"}, {"start": 1408.4, "end": 1410.4, "text": "遥祝五皇万安"}, {"start": 1413.0, "end": 1413.8, "text": "贤弟"}, {"start": 1414.0, "end": 1416.6, "text": "你想不想一赌天颜哪"}, {"start": 1417.0, "end": 1418.6, "text": "在下朝思暮想"}, {"start": 1418.8, "end": 1419.6, "text": "那好"}, {"start": 1420.2, "end": 1421.0, "text": "上车吧"}, {"start": 1421.0, "end": 1422.2, "text": "随我去西昌"}, {"start": 1423.6, "end": 1424.2, "text": "这就走"}, {"start": 1424.2, "end": 1425.0, "text": "这就走"}, {"start": 1427.38, "end": 1429.38, "text": "曹公不是明天才班是吗"}, {"start": 1429.38, "end": 1430.98, "text": "那是三军将士"}, {"start": 1430.98, "end": 1432.58, "text": "你我要先行一步"}, {"start": 1432.98, "end": 1434.78, "text": "再说旅途寂寞"}, {"start": 1434.98, "end": 1436.98, "text": "我也想和贤弟做个班"}, {"start": 1438.58, "end": 1440.58, "text": "在下有几位兄弟"}, {"start": 1440.58, "end": 1441.58, "text": "你放心吧"}, {"start": 1441.58, "end": 1442.78, "text": "我都安排好了"}, {"start": 1442.78, "end": 1443.58, "text": "明日"}, {"start": 1443.78, "end": 1446.78, "text": "曹仁会陪着关章照三位将军"}, {"start": 1446.78, "end": 1447.98, "text": "办事回京"}, {"start": 1451.14, "end": 1452.34, "text": "咱们贤弟"}, {"start": 1452.74, "end": 1454.14, "text": "不想见天子吗"}, {"start": 1455.14, "end": 1455.74, "text": "好"}, {"start": 1456.54, "end": 1457.94, "text": "在下遵命"}, {"start": 1459.34, "end": 1460.34, "text": "这就对了"}, {"start": 1460.34, "end": 1491.91, "text": "大将军曹操"}, {"start": 1492.31, "end": 1506.26, "text": "奉旨觐见"}, {"start": 1508.06, "end": 1510.26, "text": "天子赐我入朝不败"}, {"start": 1510.26, "end": 1511.46, "text": "暂败不明"}, {"start": 1512.26, "end": 1513.26, "text": "在下明白"}, {"start": 1513.46, "end": 1540.24, "text": "臣曹操"}, {"start": 1540.64, "end": 1541.84, "text": "拜见天子"}, {"start": 1542.84, "end": 1544.04, "text": "爱卿平身"}, {"start": 1546.71, "end": 1549.31, "text": "臣奉旨觐军徐州"}, {"start": 1549.71, "end": 1551.51, "text": "擒杀贼将吕布"}, {"start": 1551.51, "end": 1552.71, "text": "收复徐州"}, {"start": 1553.11, "end": 1554.71, "text": "六郡十九城"}, {"start": 1554.91, "end": 1556.11, "text": "府堤十万"}, {"start": 1556.31, "end": 1557.51, "text": "斩首两万"}, {"start": 1557.51, "end": 1560.11, "text": "令获战马兵器无数"}, {"start": 1562.24, "end": 1564.04, "text": "爱卿立此书勋"}, {"start": 1564.04, "end": 1565.84, "text": "朕极为高兴"}, {"start": 1566.84, "end": 1568.24, "text": "臣所做的一切"}, {"start": 1568.44, "end": 1569.84, "text": "上乘天威"}, {"start": 1569.84, "end": 1570.84, "text": "下位黎明"}, {"start": 1570.84, "end": 1572.04, "text": "忠心汉事"}, {"start": 1572.04, "end": 1573.64, "text": "臣不敢鞠躬"}, {"start": 1573.84, "end": 1576.04, "text": "爱卿一举攻陷了寿纯"}, {"start": 1576.44, "end": 1578.24, "text": "大败逆贼袁述"}, {"start": 1578.44, "end": 1579.24, "text": "此次"}, {"start": 1579.24, "end": 1580.64, "text": "爱卿又人不卸甲"}, {"start": 1580.64, "end": 1581.44, "text": "马不卸鞍"}, {"start": 1581.44, "end": 1583.44, "text": "为朝廷收取了徐州"}, {"start": 1584.04, "end": 1585.84, "text": "爱卿已是名震四海"}, {"start": 1585.84, "end": 1587.44, "text": "攻垂天下呀"}, {"start": 1588.84, "end": 1589.64, "text": "听旨"}, {"start": 1589.84, "end": 1592.44, "text": "朕拜爱卿为朝廷丞相"}, {"start": 1592.44, "end": 1593.84, "text": "总领朝政"}, {"start": 1593.84, "end": 1595.84, "text": "加赠封地九千锦"}, {"start": 1596.04, "end": 1597.84, "text": "民三万户"}, {"start": 1598.84, "end": 1600.44, "text": "臣曹操"}, {"start": 1600.64, "end": 1602.24, "text": "叩谢天恩"}, {"start": 1608.89, "end": 1610.69, "text": "请曹丞相入座"}, {"start": 1611.69, "end": 1612.49, "text": "请"}, {"start": 1613.29, "end": 1614.09, "text": "陛下请"}, {"start": 1635.84, "end": 1636.44, "text": "陛下"}, {"start": 1637.04, "end": 1637.84, "text": "你看这个人"}, {"start": 1640.58, "end": 1641.38, "text": "他叫刘备"}, {"start": 1641.78, "end": 1642.58, "text": "自玄德"}, {"start": 1645.78, "end": 1647.78, "text": "刘爱卿请上殿来"}, {"start": 1658.1, "end": 1661.1, "text": "臣刘备叩见陛下"}, {"start": 1663.88, "end": 1666.08, "text": "爱卿祖上何方"}, {"start": 1666.68, "end": 1669.08, "text": "臣乃中山晋王之后"}, {"start": 1669.48, "end": 1671.48, "text": "孝瑾皇帝之玄孙"}, {"start": 1671.88, "end": 1673.48, "text": "祖刘雄之孙"}, {"start": 1673.88, "end": 1675.48, "text": "父刘弘之子"}, {"start": 1677.08, "end": 1678.48, "text": "你是朕的皇亲"}, {"start": 1678.88, "end": 1680.28, "text": "快拿皇族世谱来"}, {"start": 1680.28, "end": 1681.08, "text": "朕要验看"}, {"start": 1693.17, "end": 1694.17, "text": "念语朕听"}, {"start": 1696.94, "end": 1699.14, "text": "孝瑾皇帝生子十四"}, {"start": 1699.34, "end": 1701.74, "text": "第七子便是中山晋王刘胜"}, {"start": 1701.74, "end": 1703.74, "text": "刘胜生鹿城侯刘贞"}, {"start": 1703.94, "end": 1705.74, "text": "刘贞生佩侯刘昂"}, {"start": 1705.94, "end": 1707.74, "text": "刘昂生张侯刘禄"}, {"start": 1707.94, "end": 1709.74, "text": "刘禄生夷侯刘炼"}, {"start": 1709.94, "end": 1711.74, "text": "刘炼生杨侯刘英"}, {"start": 1711.94, "end": 1714.14, "text": "刘英生风铃侯刘不宜"}, {"start": 1714.34, "end": 1716.34, "text": "刘不宜生季川侯刘惠"}, {"start": 1716.54, "end": 1718.34, "text": "刘惠生东郡令刘雄"}, {"start": 1718.54, "end": 1719.94, "text": "刘雄生刘弘"}, {"start": 1720.14, "end": 1721.94, "text": "刘弘不适生刘备"}, {"start": 1722.34, "end": 1722.94, "text": "禀陛下"}, {"start": 1723.14, "end": 1725.34, "text": "这刘备乃是孝瑾皇帝的"}, {"start": 1725.34, "end": 1727.34, "text": "第十八代玄孙也"}, {"start": 1731.03, "end": 1732.23, "text": "一族谱"}, {"start": 1732.63, "end": 1734.23, "text": "你是朕的皇叔啊"}, {"start": 1736.23, "end": 1738.03, "text": "陛下天恩浩荡"}, {"start": 1738.23, "end": 1740.03, "text": "刘备感激其名"}, {"start": 1743.58, "end": 1744.78, "text": "连年兵祸"}, {"start": 1744.98, "end": 1746.38, "text": "使得国家蒙难"}, {"start": 1746.58, "end": 1749.18, "text": "朕也饱受乱贼欺凌"}, {"start": 1752.78, "end": 1754.38, "text": "幸得曹丞相"}, {"start": 1755.78, "end": 1758.38, "text": "忠君报国 除贼安民"}, {"start": 1758.58, "end": 1759.98, "text": "迁都于许昌"}, {"start": 1760.18, "end": 1762.78, "text": "朕才略享偏安之福"}, {"start": 1763.78, "end": 1765.38, "text": "今日见了刘皇叔"}, {"start": 1765.58, "end": 1767.38, "text": "朕更是欢喜不尽啊"}, {"start": 1767.78, "end": 1768.98, "text": "刘备听旨"}, {"start": 1769.58, "end": 1771.78, "text": "朕授你为左将军"}, {"start": 1771.98, "end": 1773.38, "text": "怡承廷侯"}, {"start": 1774.18, "end": 1776.38, "text": "臣叩谢天恩"}, {"start": 1777.18, "end": 1778.58, "text": "爱卿闲暇时"}, {"start": 1778.58, "end": 1780.58, "text": "请多多进宫来看望朕"}, {"start": 1780.58, "end": 1782.38, "text": "朕想跟你述足"}, {"start": 1783.78, "end": 1786.18, "text": "臣遵旨"}, {"start": 1787.58, "end": 1789.18, "text": "恭喜刘皇叔"}, {"start": 1814.78, "end": 1817.78, "text": "恭喜刘皇叔败将封侯啊"}, {"start": 1829.8, "end": 1831.8, "text": "丞相虽然未及人臣"}, {"start": 1832.0, "end": 1833.6, "text": "但还仍然是臣"}, {"start": 1834.0, "end": 1834.8, "text": "而他刘备"}, {"start": 1835.0, "end": 1836.8, "text": "转眼间变成了皇叔"}, {"start": 1837.0, "end": 1838.4, "text": "可笑至至啊"}, {"start": 1839.8, "end": 1840.8, "text": "那有什么"}, {"start": 1841.6, "end": 1842.6, "text": "我要是愿意"}, {"start": 1842.6, "end": 1843.8, "text": "做他皇爷爷都成"}, {"start": 1844.0, "end": 1845.0, "text": "那我不贪那个"}, {"start": 1845.4, "end": 1847.4, "text": "这陛下刚见刘备"}, {"start": 1847.6, "end": 1849.0, "text": "就给他败将封侯"}, {"start": 1850.0, "end": 1850.8, "text": "很明显"}, {"start": 1851.4, "end": 1853.4, "text": "陛下是想培植势力"}, {"start": 1853.6, "end": 1854.6, "text": "用于外援"}, {"start": 1855.2, "end": 1855.8, "text": "丞相"}, {"start": 1856.4, "end": 1857.8, "text": "不得不防啊"}, {"start": 1859.4, "end": 1861.2, "text": "此意结我也想到了"}, {"start": 1862.8, "end": 1863.8, "text": "当然要防"}, {"start": 1864.6, "end": 1865.6, "text": "不过凡事"}, {"start": 1865.8, "end": 1866.8, "text": "皆有利弊"}, {"start": 1867.4, "end": 1869.6, "text": "刘备现在既然贵为皇叔"}, {"start": 1870.2, "end": 1872.0, "text": "以后我再用天子诏令"}, {"start": 1872.0, "end": 1873.0, "text": "制约他"}, {"start": 1873.6, "end": 1875.2, "text": "他就更得遵从了"}, {"start": 1876.4, "end": 1877.2, "text": "吉是"}, {"start": 1877.6, "end": 1879.2, "text": "刘皇叔受封后"}, {"start": 1879.4, "end": 1881.0, "text": "有没有得意忘形啊"}, {"start": 1882.6, "end": 1883.6, "text": "恰恰相反"}, {"start": 1884.4, "end": 1885.4, "text": "他受封之后"}, {"start": 1886.0, "end": 1887.4, "text": "反而更加谦卑了"}, {"start": 1888.4, "end": 1890.2, "text": "他把自己关在客宅里"}, {"start": 1890.4, "end": 1892.2, "text": "整天是大门不出啊"}, {"start": 1893.0, "end": 1894.8, "text": "即便是出门拜客"}, {"start": 1895.2, "end": 1897.2, "text": "大老远就打工作衣"}, {"start": 1897.4, "end": 1898.6, "text": "如履薄冰"}, {"start": 1902.67, "end": 1903.67, "text": "聪明人"}, {"start": 1905.07, "end": 1905.87, "text": "丞相"}, {"start": 1906.87, "end": 1908.27, "text": "在下有言"}, {"start": 1908.87, "end": 1910.07, "text": "压抑很久了"}, {"start": 1910.67, "end": 1911.67, "text": "你只管说"}, {"start": 1912.87, "end": 1913.67, "text": "丞相"}, {"start": 1914.27, "end": 1916.07, "text": "无论在朝在野"}, {"start": 1917.07, "end": 1918.07, "text": "都已经是"}, {"start": 1918.47, "end": 1919.47, "text": "功德浩荡"}, {"start": 1919.67, "end": 1920.67, "text": "恩威齐天了"}, {"start": 1921.27, "end": 1921.87, "text": "因此"}, {"start": 1922.27, "end": 1923.07, "text": "丞相"}, {"start": 1923.47, "end": 1926.07, "text": "不应该仅仅屈尊于丞相之位啊"}, {"start": 1927.07, "end": 1927.87, "text": "承玥"}, {"start": 1928.47, "end": 1929.67, "text": "你是在劝劲吗"}, {"start": 1930.87, "end": 1931.47, "text": "正是"}, {"start": 1936.23, "end": 1937.03, "text": "多谢了"}, {"start": 1939.84, "end": 1941.64, "text": "我现在虽然功名日胜"}, {"start": 1941.84, "end": 1943.44, "text": "但是自望尚浅"}, {"start": 1943.64, "end": 1946.24, "text": "兵马属地也不如袁绍多"}, {"start": 1946.64, "end": 1947.44, "text": "再说了"}, {"start": 1948.04, "end": 1949.44, "text": "现在朝廷内外"}, {"start": 1950.04, "end": 1953.44, "text": "忠于天子一心伏汉的大臣不少啊"}, {"start": 1953.84, "end": 1954.84, "text": "别人不说"}, {"start": 1956.97, "end": 1957.77, "text": "徇玉"}, {"start": 1958.57, "end": 1960.17, "text": "头一个他就不能答应"}, {"start": 1960.77, "end": 1962.17, "text": "所以我还是别"}, {"start": 1962.77, "end": 1963.97, "text": "惹火烧身了"}, {"start": 1964.17, "end": 1964.97, "text": "那丞相"}, {"start": 1965.17, "end": 1966.57, "text": "你应该早做谋划"}, {"start": 1966.97, "end": 1968.57, "text": "查清谁是帝的"}, {"start": 1968.97, "end": 1970.97, "text": "谁忠诚于丞相啊"}, {"start": 1976.36, "end": 1977.36, "text": "这倒可以"}, {"start": 1980.6, "end": 1981.2, "text": "这样"}, {"start": 1983.78, "end": 1985.38, "text": "过两天我要去"}, {"start": 1985.78, "end": 1987.18, "text": "许田行猎"}, {"start": 1988.18, "end": 1989.58, "text": "劳你进宫奏报天子"}, {"start": 1989.58, "end": 1991.18, "text": "就说我请他一块去"}, {"start": 1992.38, "end": 1992.98, "text": "还有"}, {"start": 1993.58, "end": 1995.38, "text": "朝廷内外的文武大臣"}, {"start": 1995.78, "end": 1996.38, "text": "都去"}, {"start": 1997.38, "end": 1997.98, "text": "遵命"}, {"start": 2008.97, "end": 2010.77, "text": "祖上如此辉煌"}, {"start": 2012.37, "end": 2013.77, "text": "可惜传到朕这儿"}, {"start": 2014.37, "end": 2015.77, "text": "却是奸贼当道"}, {"start": 2015.77, "end": 2016.97, "text": "国家沦丧"}, {"start": 2037.43, "end": 2039.03, "text": "刚刚召见刘备"}, {"start": 2039.63, "end": 2041.83, "text": "为何就给他拜将封侯啊"}, {"start": 2042.23, "end": 2051.42, "text": "国事都不由朕做出"}, {"start": 2052.42, "end": 2053.62, "text": "刘备既是个英雄"}, {"start": 2053.82, "end": 2055.22, "text": "又是皇族后裔"}, {"start": 2057.28, "end": 2059.48, "text": "将来子人可用作后援呢"}, {"start": 2059.88, "end": 2061.08, "text": "臣明白了"}, {"start": 2063.08, "end": 2065.68, "text": "可刘备兵马不多"}, {"start": 2066.28, "end": 2068.28, "text": "又无甚属地啊"}, {"start": 2071.02, "end": 2071.82, "text": "这个嘛"}, {"start": 2072.82, "end": 2074.62, "text": "朕将来会慢慢地封赏他"}, {"start": 2080.58, "end": 2081.58, "text": "禀陛下"}, {"start": 2081.98, "end": 2083.78, "text": "参军承玉求见"}, {"start": 2089.57, "end": 2090.37, "text": "叫进来"}, {"start": 2090.77, "end": 2091.37, "text": "诺"}, {"start": 2100.95, "end": 2102.15, "text": "臣承玉"}, {"start": 2102.55, "end": 2104.15, "text": "拜见陛下"}, {"start": 2104.75, "end": 2105.55, "text": "平身"}, {"start": 2106.15, "end": 2107.15, "text": "谢陛下"}, {"start": 2108.15, "end": 2110.15, "text": "爱卿有何事啊"}, {"start": 2111.15, "end": 2112.15, "text": "禀陛下"}, {"start": 2112.75, "end": 2113.55, "text": "后天"}, {"start": 2113.55, "end": 2116.35, "text": "丞相请陛下许田行猎"}, {"start": 2117.75, "end": 2118.55, "text": "爱卿啊"}, {"start": 2118.95, "end": 2120.55, "text": "这嫁鹰牵狗的事"}, {"start": 2120.55, "end": 2122.35, "text": "恐怕不是天子正道啊"}, {"start": 2122.55, "end": 2123.35, "text": "再者"}, {"start": 2123.35, "end": 2124.95, "text": "朕的身体也不舒服"}, {"start": 2124.95, "end": 2125.55, "text": "朕"}, {"start": 2125.55, "end": 2126.15, "text": "陛下"}, {"start": 2127.35, "end": 2128.35, "text": "自古以来"}, {"start": 2128.55, "end": 2130.15, "text": "圣君都好打猎"}, {"start": 2130.55, "end": 2133.15, "text": "春波夏中秋收冬藏"}, {"start": 2133.15, "end": 2135.35, "text": "似是狩猎扬为于天下"}, {"start": 2135.35, "end": 2136.35, "text": "曹丞相"}, {"start": 2136.55, "end": 2138.35, "text": "不但请陛下出猎"}, {"start": 2138.55, "end": 2140.55, "text": "还令朝廷大臣"}, {"start": 2140.55, "end": 2142.35, "text": "三军将士随驾"}, {"start": 2142.95, "end": 2143.75, "text": "他们都盼望着"}, {"start": 2143.75, "end": 2145.55, "text": "跟随陛下行猎啊"}, {"start": 2148.35, "end": 2149.55, "text": "至于陛下所说的"}, {"start": 2149.55, "end": 2151.35, "text": "龙体欠安嘛"}, {"start": 2152.35, "end": 2153.15, "text": "臣"}, {"start": 2153.15, "end": 2155.35, "text": "敢请陛下三思"}, {"start": 2161.1, "end": 2162.9, "text": "听爱卿说话的这会儿"}, {"start": 2163.1, "end": 2164.7, "text": "朕的身体舒服多了"}, {"start": 2165.5, "end": 2166.7, "text": "朕告丞相"}, {"start": 2167.1, "end": 2167.7, "text": "朕"}, {"start": 2168.5, "end": 2169.1, "text": "朕"}, {"start": 2169.7, "end": 2170.3, "text": "去"}, {"start": 2170.9, "end": 2171.7, "text": "领旨"}, {"start": 2208.65, "end": 2210.25, "text": "臣妻陛下死射一箭"}, {"start": 2248.15, "end": 2249.35, "text": "丞相神射"}, {"start": 2249.55, "end": 2250.55, "text": "真是了不起啊"}, {"start": 2252.49, "end": 2253.29, "text": "这恐怕不是"}, {"start": 2253.29, "end": 2254.89, "text": "刘皇叔的心里话吧"}, {"start": 2255.29, "end": 2256.89, "text": "你可是见过吕布的"}, {"start": 2257.09, "end": 2258.29, "text": "原门社稷的"}, {"start": 2258.49, "end": 2259.49, "text": "他才堪称"}, {"start": 2259.69, "end": 2261.09, "text": "神射儿子"}, {"start": 2262.86, "end": 2264.66, "text": "吕布虽然擅射"}, {"start": 2265.06, "end": 2266.66, "text": "却被丞相斩首了"}, {"start": 2267.46, "end": 2269.66, "text": "丞相箭术虽步入吕布"}, {"start": 2270.06, "end": 2272.26, "text": "却能一箭定江山啊"}, {"start": 2272.86, "end": 2273.86, "text": "如此看来"}, {"start": 2274.46, "end": 2277.46, "text": "吕布射技再高也是俗射"}, {"start": 2277.86, "end": 2278.86, "text": "而丞相"}, {"start": 2279.06, "end": 2280.86, "text": "随指射翻一头鹿"}, {"start": 2281.66, "end": 2283.06, "text": "堪当是神射"}, {"start": 2284.26, "end": 2285.66, "text": "这倒是句实话"}, {"start": 2286.06, "end": 2286.86, "text": "忠听"}, {"start": 2287.86, "end": 2290.46, "text": "臣奉还陛下的宝雕功"}, {"start": 2291.66, "end": 2292.66, "text": "安心留着用吧"}, {"start": 2295.73, "end": 2297.33, "text": "谢陛下赐功"}, {"start": 2297.53, "end": 2298.73, "text": "万岁"}, {"start": 2311.79, "end": 2312.19, "text": "徐初"}, {"start": 2312.19, "end": 2312.59, "text": "在"}, {"start": 2313.19, "end": 2313.79, "text": "送你了"}, {"start": 2314.39, "end": 2314.79, "text": "丞相"}, {"start": 2315.59, "end": 2316.99, "text": "这弓转圆面子没鸟用"}, {"start": 2316.99, "end": 2317.59, "text": "要它干吗"}, {"start": 2317.79, "end": 2318.79, "text": "那就把它扔了吧"}, {"start": 2320.19, "end": 2320.99, "text": "不 我要"}, {"start": 2321.19, "end": 2321.59, "text": "在"}, {"start": 2321.79, "end": 2323.59, "text": "刚才的事你都看到了吧"}, {"start": 2323.99, "end": 2325.79, "text": "将士们向我高呼万岁的时候"}, {"start": 2325.99, "end": 2326.99, "text": "有多少人不高兴"}, {"start": 2328.39, "end": 2330.59, "text": "国舅董成气得满脸痛哄"}, {"start": 2330.79, "end": 2332.19, "text": "关于以身手摸箭"}, {"start": 2332.59, "end": 2334.19, "text": "不少大臣也是感怒不忍"}, {"start": 2334.19, "end": 2335.19, "text": "还有寻玉"}, {"start": 2336.19, "end": 2337.39, "text": "他也长虚短叹"}, {"start": 2337.79, "end": 2338.19, "text": "是"}, {"start": 2338.59, "end": 2339.99, "text": "我对他那么信任"}, {"start": 2340.39, "end": 2341.19, "text": "那么尽忠"}, {"start": 2341.99, "end": 2343.39, "text": "他却心向天子"}, {"start": 2344.19, "end": 2344.59, "text": "是"}, {"start": 2345.59, "end": 2346.59, "text": "由此可见"}, {"start": 2347.39, "end": 2350.19, "text": "朝廷上下忠于陛下的人不在少数"}, {"start": 2350.79, "end": 2351.79, "text": "更何况现在"}, {"start": 2351.99, "end": 2353.99, "text": "诸侯割据 萧雄争霸"}, {"start": 2354.19, "end": 2356.19, "text": "成帝的事就不要再说了"}, {"start": 2356.39, "end": 2356.79, "text": "诺"}, {"start": 2357.19, "end": 2365.3, "text": "徐天哪为"}, {"start": 2366.5, "end": 2367.9, "text": "曹操实在太可恨"}, {"start": 2368.9, "end": 2370.5, "text": "竟然敢压皇帝一头"}, {"start": 2371.7, "end": 2373.3, "text": "抢夺天子之礼"}, {"start": 2373.9, "end": 2375.3, "text": "曹操帝王之志"}, {"start": 2375.5, "end": 2376.5, "text": "见畏之心"}, {"start": 2376.9, "end": 2378.5, "text": "早就有目共睹了"}, {"start": 2379.7, "end": 2380.5, "text": "我本来想"}, {"start": 2381.1, "end": 2382.1, "text": "杀了曹贼"}, {"start": 2382.3, "end": 2383.1, "text": "为国除害"}, {"start": 2383.1, "end": 2385.44, "text": "可大哥你为什么"}, {"start": 2386.64, "end": 2387.44, "text": "不许我动手"}, {"start": 2387.44, "end": 2392.19, "text": "当时曹操身边假势伶俐"}, {"start": 2392.39, "end": 2393.39, "text": "猛将如云"}, {"start": 2394.19, "end": 2395.19, "text": "如果你动手"}, {"start": 2396.19, "end": 2397.99, "text": "我担心不但伤不了他"}, {"start": 2398.79, "end": 2400.19, "text": "反而会害了天子"}, {"start": 2401.59, "end": 2403.59, "text": "现在不除曹贼"}, {"start": 2404.59, "end": 2405.39, "text": "日后"}, {"start": 2405.99, "end": 2408.57, "text": "就是"}, {"start": 2409.37, "end": 2410.57, "text": "这杀又杀不得"}, {"start": 2410.77, "end": 2411.97, "text": "忍又忍不得"}, {"start": 2412.37, "end": 2414.17, "text": "那咱们还窝在这里干吗"}, {"start": 2414.77, "end": 2415.37, "text": "大哥"}, {"start": 2415.97, "end": 2417.77, "text": "咱不如离开徐章"}, {"start": 2417.97, "end": 2418.97, "text": "到外头 快"}, {"start": 2419.37, "end": 2420.17, "text": "快回去吧"}, {"start": 2423.13, "end": 2425.33, "text": "现在徐章各处都把守纪言"}, {"start": 2426.73, "end": 2427.93, "text": "我们即使想走"}, {"start": 2428.33, "end": 2429.53, "text": "也要寻找机会"}, {"start": 2431.86, "end": 2433.46, "text": "我们现在既忍离下"}, {"start": 2434.26, "end": 2435.66, "text": "万事都要忍耐"}, {"start": 2437.98, "end": 2440.18, "text": "你老是忍耐忍耐"}, {"start": 2440.58, "end": 2441.98, "text": "这忍到何时是个头啊"}, {"start": 2446.19, "end": 2446.79, "text": "主公"}, {"start": 2447.39, "end": 2448.79, "text": "皇宫里来了个内臣"}, {"start": 2448.99, "end": 2451.19, "text": "说是传天子口谕"}, {"start": 2459.76, "end": 2461.76, "text": "臣刘备听旨"}, {"start": 2462.96, "end": 2463.76, "text": "禀留皇叔"}, {"start": 2463.96, "end": 2464.76, "text": "圣上口谕"}, {"start": 2464.76, "end": 2466.36, "text": "陛下在许田行猎时"}, {"start": 2466.36, "end": 2467.36, "text": "身染寒露"}, {"start": 2467.36, "end": 2468.36, "text": "臥病不起"}, {"start": 2468.76, "end": 2471.36, "text": "召各位皇亲国戚入宫请安"}, {"start": 2472.56, "end": 2474.16, "text": "请奏报陛下"}, {"start": 2474.16, "end": 2475.56, "text": "臣立刻就去"}]