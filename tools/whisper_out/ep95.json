[{"start": 43.79, "end": 49.31, "text": "这有块碑,拿火把来。"}, {"start": 79.22, "end": 96.07, "text": "真是合金祠堂。"}, {"start": 96.07, "end": 98.07, "text": "世人早把合金忘了。"}, {"start": 99.07, "end": 102.07, "text": "合家祠堂,也已经破败成这样。"}, {"start": 105.73, "end": 109.73, "text": "父亲,这天下大乱导致三国顶利。"}, {"start": 110.73, "end": 113.73, "text": "这局面说到根上,还是从合金开始的。"}, {"start": 114.73, "end": 117.73, "text": "他想剿除施长世,却引来董卓进京。"}, {"start": 118.73, "end": 119.73, "text": "这才天下大乱。"}, {"start": 130.14, "end": 131.14, "text": "杀了施长世。"}, {"start": 139.94, "end": 140.94, "text": "父亲说得是。"}, {"start": 141.94, "end": 145.94, "text": "对了,这靖叔还是合金的后人呢。"}, {"start": 145.94, "end": 166.87, "text": "记着,过两日,派人来修整祠堂。"}, {"start": 167.87, "end": 169.87, "text": "替靖叔尽点孝心吧。"}, {"start": 170.87, "end": 171.87, "text": "遵命。"}, {"start": 171.87, "end": 172.87, "text": "请服药吧。"}, {"start": 179.12, "end": 194.59, "text": "陛下,司马仪奉旨见驾。"}, {"start": 195.59, "end": 200.56, "text": "宣。"}, {"start": 200.56, "end": 201.56, "text": "诺。"}, {"start": 201.56, "end": 207.72, "text": "司马仪觐见。"}, {"start": 207.72, "end": 220.89, "text": "臣司马仪叩见陛下。"}, {"start": 221.89, "end": 223.89, "text": "吾皇万岁万万岁。"}, {"start": 224.89, "end": 231.95, "text": "爱卿啊,快快起身。"}, {"start": 231.95, "end": 232.95, "text": "谢陛下。"}, {"start": 232.95, "end": 245.06, "text": "爱卿,你在雍梁魏国尽忠,吃了不少苦。"}, {"start": 245.06, "end": 250.4, "text": "瞧,这白头发也添了不少啊。"}, {"start": 251.4, "end": 253.4, "text": "臣与蜀军交战多年,"}, {"start": 254.4, "end": 256.4, "text": "耗费了朝廷不少粮饷,"}, {"start": 257.4, "end": 258.4, "text": "也未能肃胜。"}, {"start": 259.4, "end": 260.4, "text": "臣有负圣恩。"}, {"start": 262.4, "end": 263.4, "text": "话不能这么说。"}, {"start": 264.4, "end": 266.4, "text": "粮饷虽然用了些许,"}, {"start": 266.4, "end": 268.4, "text": "但是你守住了国门,"}, {"start": 268.4, "end": 270.4, "text": "打败了蜀军,"}, {"start": 270.4, "end": 272.4, "text": "还把诸葛亮生生拖死了。"}, {"start": 272.4, "end": 274.4, "text": "换作第二个人,"}, {"start": 274.4, "end": 275.4, "text": "谁能有这本事?"}, {"start": 276.4, "end": 278.4, "text": "这全是陛下恩威,"}, {"start": 278.4, "end": 279.4, "text": "臣不敢居功。"}, {"start": 280.4, "end": 281.4, "text": "爱卿,"}, {"start": 281.4, "end": 283.4, "text": "诸葛亮死后,"}, {"start": 284.4, "end": 287.94, "text": "蜀兵还敢再来翻吗?"}, {"start": 288.94, "end": 289.94, "text": "臣相信,"}, {"start": 289.94, "end": 291.94, "text": "只要有蜀,"}, {"start": 291.94, "end": 292.94, "text": "有无,"}, {"start": 292.94, "end": 294.94, "text": "天下断不会太平。"}, {"start": 294.94, "end": 295.94, "text": "说得是啊。"}, {"start": 296.94, "end": 297.94, "text": "爱卿,"}, {"start": 298.94, "end": 299.94, "text": "你年事已高,"}, {"start": 300.94, "end": 302.94, "text": "朕不忍心再让你长兵了。"}, {"start": 303.94, "end": 305.94, "text": "朕拜你为太尉,"}, {"start": 305.94, "end": 306.94, "text": "好生休息吧。"}, {"start": 307.94, "end": 308.94, "text": "谢陛下。"}, {"start": 308.94, "end": 310.94, "text": "是老爷回来了吗?"}, {"start": 310.94, "end": 311.94, "text": "为老爷缝制衣袄,"}, {"start": 311.94, "end": 318.74, "text": "必打算着托人送往郡中。"}, {"start": 340.67, "end": 388.14, "text": "咱不再去郡中了。"}, {"start": 389.14, "end": 391.64, "text": "老爷说的当真。"}, {"start": 395.23, "end": 396.23, "text": "那我先走了。"}, {"start": 396.23, "end": 417.26, "text": "在郡中。"}, {"start": 417.26, "end": 418.26, "text": "咱不再去郡中了。"}, {"start": 422.82, "end": 423.82, "text": "老爷说的当真。"}, {"start": 424.82, "end": 425.82, "text": "千真万确。"}, {"start": 425.82, "end": 431.01, "text": "我就在这儿坐会儿。"}, {"start": 434.15, "end": 435.15, "text": "我给老爷气察觉。"}, {"start": 435.15, "end": 442.17, "text": "不,"}, {"start": 442.17, "end": 443.17, "text": "我就这样看着你。"}, {"start": 444.17, "end": 445.17, "text": "三年多了,"}, {"start": 446.17, "end": 448.17, "text": "一直想坐在你身边。"}, {"start": 449.17, "end": 450.17, "text": "就这样看你。"}, {"start": 450.17, "end": 461.82, "text": "见过奴婢。"}, {"start": 464.58, "end": 465.58, "text": "庸良苦寒,"}, {"start": 466.58, "end": 468.58, "text": "郡中一个女人也没有。"}, {"start": 470.58, "end": 472.58, "text": "寒夜就特别长。"}, {"start": 473.58, "end": 475.58, "text": "我有什么值得老爷观念的?"}, {"start": 475.58, "end": 479.02, "text": "我只是个奴婢。"}, {"start": 479.02, "end": 481.02, "text": "在我心中不是。"}, {"start": 481.02, "end": 484.71, "text": "那是什么?"}, {"start": 495.95, "end": 496.95, "text": "老爷,"}, {"start": 497.95, "end": 498.95, "text": "老爷你说什么呢?"}, {"start": 499.95, "end": 500.95, "text": "荆叔啊,"}, {"start": 501.95, "end": 502.95, "text": "我不过挂了。"}, {"start": 503.95, "end": 506.95, "text": "八月更午是个好日子。"}, {"start": 507.95, "end": 508.95, "text": "你我成亲的日子,"}, {"start": 509.95, "end": 510.95, "text": "就选在这天吧。"}, {"start": 538.38, "end": 539.38, "text": "曹爽,"}, {"start": 539.38, "end": 540.38, "text": "叩见吾皇。"}, {"start": 540.38, "end": 552.82, "text": "朕命不久已。"}, {"start": 553.82, "end": 556.42, "text": "陛下,"}, {"start": 556.42, "end": 557.42, "text": "陛下。"}, {"start": 557.42, "end": 569.54, "text": "虽然已经死了,"}, {"start": 569.54, "end": 573.1, "text": "你还活,"}, {"start": 573.1, "end": 576.6, "text": "总有些放心不下的。"}, {"start": 577.6, "end": 579.6, "text": "陛下既有此忧虑,"}, {"start": 580.6, "end": 582.6, "text": "那何不将司马家宗满门处死。"}, {"start": 583.6, "end": 584.6, "text": "以绝后患。"}, {"start": 585.6, "end": 587.6, "text": "司马已长兵多年,"}, {"start": 588.6, "end": 590.6, "text": "门生古历便于朝野。"}, {"start": 591.6, "end": 593.6, "text": "朕不可轻易懂他。"}, {"start": 593.6, "end": 594.6, "text": "有加上,"}, {"start": 597.2, "end": 599.2, "text": "他处处谨慎小心,"}, {"start": 600.2, "end": 601.2, "text": "甚至闭门不出。"}, {"start": 602.2, "end": 606.22, "text": "朕有何理由杀他呀?"}, {"start": 606.22, "end": 607.22, "text": "天在杀人,"}, {"start": 608.22, "end": 609.22, "text": "不需要理由。"}, {"start": 609.22, "end": 610.22, "text": "杀功臣,"}, {"start": 620.11, "end": 622.11, "text": "激起动乱哪。"}, {"start": 622.11, "end": 623.11, "text": "陛下,"}, {"start": 624.11, "end": 625.11, "text": "只有司马已不死,"}, {"start": 626.11, "end": 627.11, "text": "朝廷就有大患。"}, {"start": 628.11, "end": 630.11, "text": "陛下千万不要被司马已给蒙骗了。"}, {"start": 631.11, "end": 634.11, "text": "你令臣工上分奏章,"}, {"start": 634.11, "end": 638.52, "text": "以司马已德高勋助为由,"}, {"start": 639.52, "end": 641.52, "text": "请朕授予他社政大权。"}, {"start": 644.86, "end": 646.86, "text": "朕要看他反应如何。"}, {"start": 648.86, "end": 649.86, "text": "如果他接受了,"}, {"start": 650.86, "end": 652.86, "text": "就说明他大智未泯。"}, {"start": 653.86, "end": 655.86, "text": "朕就令你除了他,"}, {"start": 656.86, "end": 657.86, "text": "领旨。"}, {"start": 657.86, "end": 658.86, "text": "起身吧,"}, {"start": 659.86, "end": 690.82, "text": "朕不行了。"}, {"start": 690.82, "end": 697.49, "text": "白臣尚书,"}, {"start": 697.49, "end": 699.49, "text": "请朕放刘备,"}, {"start": 704.17, "end": 707.61, "text": "托孤于诸葛亮,"}, {"start": 707.61, "end": 709.61, "text": "将太子交付于你。"}, {"start": 711.61, "end": 713.61, "text": "由你和曹双执政,"}, {"start": 714.61, "end": 715.61, "text": "辅佐太子。"}, {"start": 716.61, "end": 718.61, "text": "陛下洪福气贴,"}, {"start": 719.61, "end": 721.61, "text": "万万不会弃臣而去。"}, {"start": 721.61, "end": 722.61, "text": "是白药物。"}, {"start": 723.61, "end": 724.61, "text": "爱卿,"}, {"start": 724.61, "end": 730.61, "text": "你就答应了朕吧。"}, {"start": 735.19, "end": 736.19, "text": "何能啊?"}, {"start": 736.19, "end": 737.19, "text": "白臣,"}, {"start": 737.19, "end": 738.19, "text": "大将军夏侯霸,"}, {"start": 738.19, "end": 741.02, "text": "共同执掌。"}, {"start": 743.36, "end": 759.86, "text": "臣只想苟延残喘于府下,"}, {"start": 760.86, "end": 763.86, "text": "为朝廷奔向祈福。"}, {"start": 763.86, "end": 765.86, "text": "曹双恨你,"}, {"start": 766.86, "end": 771.97, "text": "你为何拒见曹双啊?"}, {"start": 772.97, "end": 773.97, "text": "大司马恨臣,"}, {"start": 774.97, "end": 777.97, "text": "是因为曹镇败给了诸葛亮,"}, {"start": 778.97, "end": 780.97, "text": "此事臣也悔恨终生啊。"}, {"start": 780.97, "end": 781.97, "text": "臣对不起曹双啊,"}, {"start": 782.97, "end": 784.97, "text": "不能以异己之私,"}, {"start": 784.97, "end": 786.97, "text": "废了朝廷大政啊。"}, {"start": 788.97, "end": 791.41, "text": "爱卿啊,"}, {"start": 792.41, "end": 794.41, "text": "你有没有想过,"}, {"start": 795.41, "end": 797.41, "text": "如果曹双射臣。"}, {"start": 797.41, "end": 799.41, "text": "曹双非但不容臣,"}, {"start": 799.41, "end": 801.41, "text": "还会杀了臣,"}, {"start": 801.41, "end": 802.41, "text": "灭臣九族。"}, {"start": 802.41, "end": 815.87, "text": "只有陛下能救救臣了。"}, {"start": 816.87, "end": 817.87, "text": "不可能,"}, {"start": 817.87, "end": 825.79, "text": "陛下免去臣所有的官职,"}, {"start": 826.79, "end": 827.79, "text": "同时罢免,"}, {"start": 828.79, "end": 845.98, "text": "郭怀孙李等五十二位庸良将军的军权,"}, {"start": 846.98, "end": 848.98, "text": "把臣的两个儿子,"}, {"start": 849.98, "end": 850.98, "text": "司马施,"}, {"start": 850.98, "end": 852.98, "text": "司马昭降为庶民,"}, {"start": 852.98, "end": 853.98, "text": "就放心了,"}, {"start": 853.98, "end": 854.98, "text": "老儿子。"}, {"start": 854.98, "end": 855.98, "text": "爱卿啊,"}, {"start": 855.98, "end": 856.98, "text": "你这何必?"}, {"start": 856.98, "end": 857.98, "text": "陛下,"}, {"start": 857.98, "end": 863.27, "text": "臣说的都是心里话,"}, {"start": 867.98, "end": 870.94, "text": "我只是想想啊,"}, {"start": 876.42, "end": 878.79, "text": "你这臣,"}, {"start": 878.79, "end": 881.07, "text": "陛下,"}, {"start": 881.07, "end": 883.07, "text": "臣说的都是心里话,"}, {"start": 884.07, "end": 886.07, "text": "恳请陛下降恩哪。"}, {"start": 887.07, "end": 897.1, "text": "逮朕旨。"}, {"start": 897.1, "end": 924.34, "text": "都听到了。"}, {"start": 925.34, "end": 926.34, "text": "现在怎么说?"}, {"start": 928.9, "end": 929.9, "text": "臣,"}, {"start": 930.9, "end": 931.9, "text": "愿遵奉陛下之意。"}, {"start": 939.82, "end": 940.82, "text": "罢了罢了,"}, {"start": 944.7, "end": 945.7, "text": "让司马衣,"}, {"start": 946.7, "end": 948.7, "text": "终老天年罢。"}, {"start": 952.51, "end": 953.51, "text": "遵旨。"}, {"start": 954.51, "end": 956.51, "text": "我有一件事情告诉你,"}, {"start": 957.51, "end": 959.51, "text": "早在先帝的时候,"}, {"start": 959.51, "end": 964.14, "text": "就有一双眼镜,"}, {"start": 964.14, "end": 967.14, "text": "安插在司马衣的周围。"}, {"start": 969.14, "end": 970.14, "text": "十多年来,"}, {"start": 971.14, "end": 973.14, "text": "这双眼镜,"}, {"start": 973.14, "end": 976.14, "text": "一直替朝廷盯着司马衣。"}, {"start": 977.14, "end": 979.14, "text": "等朕离开的时候,"}, {"start": 979.14, "end": 983.31, "text": "朕会把这双眼镜,"}, {"start": 985.31, "end": 987.31, "text": "留给你用。"}, {"start": 997.94, "end": 998.94, "text": "曹瑞鸿,"}, {"start": 999.94, "end": 1001.94, "text": "相年三十六岁。"}, {"start": 1002.94, "end": 1004.94, "text": "天子驾到。"}, {"start": 1007.7, "end": 1009.7, "text": "幼子曹芳继位。"}, {"start": 1009.7, "end": 1070.73, "text": "老爷,"}, {"start": 1070.73, "end": 1073.36, "text": "你歇会儿吧。"}, {"start": 1115.93, "end": 1116.93, "text": "我好像有喜了。"}, {"start": 1130.8, "end": 1133.14, "text": "都快入土了,"}, {"start": 1133.14, "end": 1134.14, "text": "居然还能添丁。"}, {"start": 1137.93, "end": 1138.93, "text": "上苍如此宽厚,"}, {"start": 1139.93, "end": 1140.93, "text": "感恩不尽哪。"}, {"start": 1183.5, "end": 1184.5, "text": "已经两个时辰了,"}, {"start": 1184.5, "end": 1185.5, "text": "孩子还没生出来呢。"}, {"start": 1186.5, "end": 1238.41, "text": "那父亲如何?"}, {"start": 1238.41, "end": 1244.98, "text": "下证就去办。"}, {"start": 1244.98, "end": 1245.98, "text": "殿下,"}, {"start": 1245.98, "end": 1247.98, "text": "司马衣的夫人难产而死。"}, {"start": 1247.98, "end": 1248.98, "text": "情痛之中,"}, {"start": 1248.98, "end": 1251.98, "text": "司马衣竟然中风了。"}, {"start": 1251.98, "end": 1252.98, "text": "是真的吗?"}, {"start": 1252.98, "end": 1253.98, "text": "是真的。"}, {"start": 1253.98, "end": 1254.98, "text": "老臣听说呀,"}, {"start": 1254.98, "end": 1256.98, "text": "司马衣的府中"}, {"start": 1256.98, "end": 1257.98, "text": "正在准备后事呢。"}, {"start": 1258.98, "end": 1259.98, "text": "这事光听说不成。"}, {"start": 1260.98, "end": 1262.98, "text": "你得亲自去她府上看看清楚。"}, {"start": 1263.98, "end": 1264.98, "text": "一举一动,"}, {"start": 1265.98, "end": 1266.98, "text": "都要立刻报。"}, {"start": 1267.98, "end": 1268.98, "text": "遵命。"}, {"start": 1268.98, "end": 1286.55, "text": "大人来了。"}, {"start": 1287.55, "end": 1289.55, "text": "在下受殿下之命,"}, {"start": 1289.55, "end": 1290.55, "text": "探望司马衣。"}, {"start": 1290.55, "end": 1291.55, "text": "请。"}, {"start": 1291.55, "end": 1292.55, "text": "禀殿下,"}, {"start": 1292.55, "end": 1328.18, "text": "司马衣人事不行,"}, {"start": 1329.18, "end": 1331.18, "text": "言言已息,"}, {"start": 1331.18, "end": 1334.18, "text": "家中正在打造棺材。"}, {"start": 1334.18, "end": 1335.18, "text": "你估计"}, {"start": 1336.18, "end": 1337.18, "text": "她还有几日可活呀?"}, {"start": 1338.18, "end": 1339.18, "text": "看情形,"}, {"start": 1339.18, "end": 1341.18, "text": "也就是今明两日了。"}, {"start": 1342.18, "end": 1344.18, "text": "明日就是清明节呀。"}, {"start": 1345.18, "end": 1347.62, "text": "司马衣呀,"}, {"start": 1349.62, "end": 1351.62, "text": "倒是挑了个好日子。"}, {"start": 1351.62, "end": 1352.62, "text": "是。"}, {"start": 1353.62, "end": 1357.06, "text": "传至百官。"}, {"start": 1358.06, "end": 1359.06, "text": "明日我陪圣上"}, {"start": 1360.06, "end": 1361.06, "text": "同聚拜夜高平陵,"}, {"start": 1361.06, "end": 1362.06, "text": "祭祀先祖。"}, {"start": 1363.06, "end": 1365.06, "text": "拙八百旦以上文武官员"}, {"start": 1365.06, "end": 1367.06, "text": "一起随驾出城,"}, {"start": 1367.06, "end": 1368.06, "text": "明聚拜祭。"}, {"start": 1369.06, "end": 1371.59, "text": "遵命。"}, {"start": 1371.59, "end": 1391.02, "text": "旁边出了什么事?"}, {"start": 1391.02, "end": 1392.02, "text": "为何这么热闹?"}, {"start": 1392.02, "end": 1393.02, "text": "今日清明,"}, {"start": 1393.02, "end": 1394.02, "text": "我进城的时候,"}, {"start": 1394.02, "end": 1395.02, "text": "看见曹爽陪天子"}, {"start": 1395.02, "end": 1396.02, "text": "前去拜夜高平陵。"}, {"start": 1397.02, "end": 1398.02, "text": "还有谁去了?"}, {"start": 1398.02, "end": 1399.02, "text": "听说,"}, {"start": 1399.02, "end": 1400.02, "text": "朝中八百旦以上官员"}, {"start": 1400.02, "end": 1401.02, "text": "全部随驾。"}, {"start": 1401.02, "end": 1403.43, "text": "曹氏秦贵也都去了?"}, {"start": 1404.43, "end": 1405.43, "text": "当然。"}, {"start": 1405.43, "end": 1408.93, "text": "走。"}, {"start": 1408.93, "end": 1422.25, "text": "你,"}, {"start": 1422.25, "end": 1425.14, "text": "你不是便威了吗?"}, {"start": 1426.14, "end": 1428.14, "text": "我都并威十几年了。"}, {"start": 1429.14, "end": 1430.14, "text": "大都督,"}, {"start": 1430.14, "end": 1431.14, "text": "曹爽陪同天子"}, {"start": 1431.14, "end": 1432.14, "text": "前往高平陵,"}, {"start": 1433.14, "end": 1434.14, "text": "朝中八百旦以上官员"}, {"start": 1434.14, "end": 1435.14, "text": "全部随驾,"}, {"start": 1435.14, "end": 1437.14, "text": "曹氏秦贵也全去了。"}, {"start": 1438.14, "end": 1439.14, "text": "众将听令。"}, {"start": 1439.14, "end": 1440.14, "text": "在。"}, {"start": 1441.14, "end": 1443.74, "text": "郭怀去南门,"}, {"start": 1443.74, "end": 1444.74, "text": "孙李去东门,"}, {"start": 1444.74, "end": 1446.74, "text": "召集各营兵马,"}, {"start": 1446.74, "end": 1448.74, "text": "齐聚于洛阳侨判待命。"}, {"start": 1448.74, "end": 1449.74, "text": "遵命。"}, {"start": 1449.74, "end": 1453.5, "text": "司马师留在府中,"}, {"start": 1454.5, "end": 1456.5, "text": "司马昭率五千精锐,"}, {"start": 1456.5, "end": 1458.5, "text": "随我进入皇宫。"}, {"start": 1458.5, "end": 1459.5, "text": "遵命。"}, {"start": 1459.5, "end": 1510.78, "text": "臣司马仪拜见太后。"}, {"start": 1510.78, "end": 1511.78, "text": "他并威了吗?"}, {"start": 1511.78, "end": 1527.7, "text": "臣并在心里,"}, {"start": 1527.7, "end": 1537.34, "text": "今日大病出狱,"}, {"start": 1537.34, "end": 1553.4, "text": "曹爽被先帝脱骨之恩,"}, {"start": 1554.4, "end": 1555.4, "text": "奸邪乱国,"}, {"start": 1555.4, "end": 1557.4, "text": "欺凌幼主,"}, {"start": 1557.4, "end": 1558.4, "text": "独霸朝政,"}, {"start": 1558.4, "end": 1560.4, "text": "其罪当主。"}, {"start": 1560.4, "end": 1563.81, "text": "臣受先帝厚恩,"}, {"start": 1563.81, "end": 1565.81, "text": "不得不率忠义之士"}, {"start": 1565.81, "end": 1567.81, "text": "起而逃贼。"}, {"start": 1567.81, "end": 1569.81, "text": "现在城中武库"}, {"start": 1569.81, "end": 1571.81, "text": "和御林军营"}, {"start": 1571.81, "end": 1573.81, "text": "都已被臣掌控。"}, {"start": 1573.81, "end": 1575.81, "text": "臣手里面有道表彰,"}, {"start": 1575.81, "end": 1582.03, "text": "金县曹爽"}, {"start": 1582.03, "end": 1584.03, "text": "被主篡政,"}, {"start": 1584.03, "end": 1586.03, "text": "祸乱刚厂之罪。"}, {"start": 1586.03, "end": 1588.03, "text": "请太后降旨,"}, {"start": 1588.03, "end": 1590.03, "text": "令臣扫除国贼。"}, {"start": 1590.03, "end": 1592.03, "text": "事已至此,"}, {"start": 1592.03, "end": 1605.01, "text": "你就应了司马大人吧。"}, {"start": 1605.01, "end": 1607.01, "text": "司马仪啊,"}, {"start": 1607.01, "end": 1620.43, "text": "可以诛杀曹爽,"}, {"start": 1620.43, "end": 1628.35, "text": "但万万不可伤了陛下呀。"}, {"start": 1628.35, "end": 1631.63, "text": "太后圣明,"}, {"start": 1631.63, "end": 1637.5, "text": "臣接旨。"}, {"start": 1637.5, "end": 1639.5, "text": "奉太后旨意,"}, {"start": 1639.5, "end": 1663.58, "text": "御兵逃贼!"}, {"start": 1663.58, "end": 1686.29, "text": "陛下,太后"}, {"start": 1686.29, "end": 1688.29, "text": "御旨到。"}, {"start": 1688.29, "end": 1690.29, "text": "什么御旨啊?"}, {"start": 1690.29, "end": 1692.29, "text": "拿过来,"}, {"start": 1692.29, "end": 1694.29, "text": "我呈给皇上。"}, {"start": 1694.29, "end": 1696.29, "text": "太后口谕,"}, {"start": 1696.29, "end": 1723.06, "text": "此旨要当众宣读,"}, {"start": 1723.06, "end": 1725.06, "text": "先帝脱孤于"}, {"start": 1725.06, "end": 1727.06, "text": "大司马曹爽,"}, {"start": 1727.06, "end": 1729.06, "text": "令其辅佐少帝。"}, {"start": 1729.06, "end": 1731.06, "text": "曹爽本应恪守"}, {"start": 1731.06, "end": 1733.06, "text": "尽忠王室,"}, {"start": 1733.06, "end": 1735.06, "text": "但其权欲勋心,"}, {"start": 1735.06, "end": 1737.06, "text": "结党专政于内,"}, {"start": 1737.06, "end": 1739.06, "text": "任用亲私于外,"}, {"start": 1739.06, "end": 1741.06, "text": "荼毒社稷,"}, {"start": 1741.06, "end": 1743.06, "text": "祸乱朝纲,"}, {"start": 1743.06, "end": 1745.06, "text": "使天下只知有大司马,"}, {"start": 1745.06, "end": 1747.06, "text": "不知有天子,"}, {"start": 1747.06, "end": 1749.06, "text": "人神共愤,"}, {"start": 1749.06, "end": 1751.06, "text": "天地不容。"}, {"start": 1751.06, "end": 1753.06, "text": "今,特召太后司马仪,"}, {"start": 1753.06, "end": 1755.06, "text": "令其接掌朝政,"}, {"start": 1755.06, "end": 1757.06, "text": "急拿曹爽兼党,"}, {"start": 1757.06, "end": 1759.06, "text": "严肃朝纲,"}, {"start": 1759.06, "end": 1761.06, "text": "还政于天子,"}, {"start": 1761.06, "end": 1763.06, "text": "众臣当弃暗投明,"}, {"start": 1763.06, "end": 1765.06, "text": "随司马仪拨乱反正,"}, {"start": 1765.06, "end": 1767.06, "text": "有随曹爽抗执者,"}, {"start": 1767.06, "end": 1769.06, "text": "严惩不怠。"}, {"start": 1769.06, "end": 1777.49, "text": "司马仪,"}, {"start": 1777.49, "end": 1779.49, "text": "你,"}, {"start": 1779.49, "end": 1781.49, "text": "你敢诈兵谋我?"}, {"start": 1781.49, "end": 1783.49, "text": "曹爽,"}, {"start": 1783.49, "end": 1785.49, "text": "司马仪已令部将接管了御林军,"}, {"start": 1785.49, "end": 1787.49, "text": "现在全洛阳"}, {"start": 1787.49, "end": 1789.49, "text": "都在他的手里,"}, {"start": 1789.49, "end": 1791.49, "text": "以你这点兵力,"}, {"start": 1791.49, "end": 1793.49, "text": "如要顽抗,"}, {"start": 1793.49, "end": 1795.49, "text": "以卵击石啊。"}, {"start": 1795.49, "end": 1797.49, "text": "哼,圣驾在此,"}, {"start": 1797.49, "end": 1799.49, "text": "尔等须随我护驾,"}, {"start": 1799.49, "end": 1801.49, "text": "诛杀司马老贼。"}, {"start": 1801.49, "end": 1803.49, "text": "众位大臣,"}, {"start": 1803.49, "end": 1805.49, "text": "你们的亲眷,"}, {"start": 1805.49, "end": 1807.49, "text": "已经让大将军司马昭,"}, {"start": 1807.49, "end": 1809.49, "text": "接到御林军营去了。"}, {"start": 1809.49, "end": 1811.49, "text": "你们忍心,"}, {"start": 1811.49, "end": 1813.49, "text": "玉石俱焚吗?"}, {"start": 1813.49, "end": 1815.49, "text": "陛下,"}, {"start": 1815.49, "end": 1817.49, "text": "司马仪军多,"}, {"start": 1817.49, "end": 1819.49, "text": "请陛下顾全大军,"}, {"start": 1819.49, "end": 1821.49, "text": "如何不能抗拒?"}, {"start": 1821.49, "end": 1823.49, "text": "顾曹爽,"}, {"start": 1823.49, "end": 1825.49, "text": "绝不会罪及陛下!"}, {"start": 1825.49, "end": 1827.49, "text": "陛下,"}, {"start": 1827.49, "end": 1833.74, "text": "请指大司马曹爽,"}, {"start": 1833.74, "end": 1835.74, "text": "令他危险吧!"}, {"start": 1835.74, "end": 1837.74, "text": "我问你,"}, {"start": 1837.74, "end": 1842.02, "text": "你说这,"}, {"start": 1842.02, "end": 1845.68, "text": "人的脚,"}, {"start": 1845.68, "end": 1857.02, "text": "为什么比脸和手都要白呢?"}, {"start": 1857.02, "end": 1859.02, "text": "在下不知,"}, {"start": 1859.02, "end": 1861.02, "text": "因为他老藏着,"}, {"start": 1861.02, "end": 1863.02, "text": "没想到曹氏先祖三朝主政,"}, {"start": 1863.02, "end": 1900.86, "text": "今日竟沦落到如此地步,"}, {"start": 1900.86, "end": 1904.43, "text": "司马仪,"}, {"start": 1904.43, "end": 1906.43, "text": "我自带军臣建立的江山。"}, {"start": 1906.43, "end": 1908.43, "text": "我挥剑只有一次,"}, {"start": 1908.43, "end": 1912.77, "text": "我剑磨了十几年啊,"}, {"start": 1912.77, "end": 1924.4, "text": "这都是你先祖"}, {"start": 1924.4, "end": 1926.4, "text": "草草教我的本领。"}, {"start": 1926.4, "end": 1979.25, "text": "可是把他"}, {"start": 1979.25, "end": 1981.25, "text": "赠送给你的人,"}, {"start": 1981.25, "end": 1983.25, "text": "却不是我,"}, {"start": 1983.25, "end": 1985.25, "text": "是你的舅主,"}, {"start": 1985.25, "end": 1987.25, "text": "世祖文皇帝,"}, {"start": 1987.25, "end": 1989.25, "text": "曹匹。"}, {"start": 1989.25, "end": 1991.25, "text": "那么现在,"}, {"start": 1991.25, "end": 1993.25, "text": "你可以"}, {"start": 1993.25, "end": 1995.25, "text": "把一切都说出来了吧?"}, {"start": 1995.25, "end": 1999.74, "text": "十八年前,"}, {"start": 1999.74, "end": 2001.74, "text": "文皇帝"}, {"start": 2001.74, "end": 2003.74, "text": "把禁书"}, {"start": 2003.74, "end": 2005.74, "text": "送到你的身边,"}, {"start": 2005.74, "end": 2007.74, "text": "令他"}, {"start": 2007.74, "end": 2009.74, "text": "倾听你"}, {"start": 2009.74, "end": 2011.74, "text": "说的每一句话,"}, {"start": 2011.74, "end": 2013.74, "text": "观察你"}, {"start": 2013.74, "end": 2015.74, "text": "做的每一件事。"}, {"start": 2015.74, "end": 2019.31, "text": "我原以为"}, {"start": 2019.31, "end": 2021.31, "text": "你是"}, {"start": 2021.31, "end": 2023.31, "text": "不破他的,"}, {"start": 2023.31, "end": 2025.31, "text": "可是当你"}, {"start": 2025.31, "end": 2027.31, "text": "诈病转草爽后,"}, {"start": 2027.31, "end": 2029.31, "text": "我才醒悟过来。"}, {"start": 2029.31, "end": 2031.31, "text": "你原来"}, {"start": 2031.31, "end": 2033.31, "text": "早就把禁书"}, {"start": 2033.31, "end": 2035.31, "text": "看破了。"}, {"start": 2035.31, "end": 2037.31, "text": "早就看破了他,"}, {"start": 2037.31, "end": 2041.94, "text": "可我仍然"}, {"start": 2041.94, "end": 2043.94, "text": "这也是我"}, {"start": 2043.94, "end": 2047.76, "text": "万万没想到的事,"}, {"start": 2047.76, "end": 2049.76, "text": "你居然"}, {"start": 2049.76, "end": 2051.76, "text": "还有爱。"}, {"start": 2051.76, "end": 2053.76, "text": "世祖皇帝"}, {"start": 2053.76, "end": 2055.76, "text": "和曹氏秦贵们"}, {"start": 2055.76, "end": 2085.25, "text": "才自以为"}, {"start": 2085.25, "end": 2087.25, "text": "掌握了"}, {"start": 2087.25, "end": 2090.78, "text": "我的一举一动,"}, {"start": 2090.78, "end": 2092.78, "text": "才会"}, {"start": 2092.78, "end": 2094.78, "text": "对我放心。"}, {"start": 2094.78, "end": 2096.78, "text": "要不然,"}, {"start": 2096.78, "end": 2098.78, "text": "我死马医遭死了。"}, {"start": 2098.78, "end": 2122.93, "text": "我问你一句话,"}, {"start": 2122.93, "end": 2124.93, "text": "望你能"}, {"start": 2124.93, "end": 2126.93, "text": "实情回答。"}, {"start": 2126.93, "end": 2128.93, "text": "墓中这个女人"}, {"start": 2128.93, "end": 2130.93, "text": "是你"}, {"start": 2130.93, "end": 2132.93, "text": "杀死的?"}, {"start": 2132.93, "end": 2142.58, "text": "不。"}, {"start": 2142.58, "end": 2144.58, "text": "在这个世上,"}, {"start": 2144.58, "end": 2146.58, "text": "你所爱的东西"}, {"start": 2146.58, "end": 2148.58, "text": "那就是"}, {"start": 2148.58, "end": 2150.58, "text": "功名大业。"}, {"start": 2150.58, "end": 2154.4, "text": "禁书"}, {"start": 2154.4, "end": 2156.4, "text": "只是你的"}, {"start": 2156.4, "end": 2158.4, "text": "可用之物。"}, {"start": 2158.4, "end": 2160.4, "text": "当它没用时,"}, {"start": 2160.4, "end": 2162.4, "text": "你自然要"}, {"start": 2162.4, "end": 2164.4, "text": "除掉它。"}, {"start": 2164.4, "end": 2179.17, "text": "放血的药"}, {"start": 2179.17, "end": 2189.55, "text": "当成止血的药,"}, {"start": 2189.55, "end": 2193.7, "text": "没生下来。"}, {"start": 2193.7, "end": 2195.7, "text": "你不是说"}, {"start": 2195.7, "end": 2197.7, "text": "你爱它吗?"}, {"start": 2197.7, "end": 2199.7, "text": "难道你就没有一点感情吗?"}, {"start": 2203.18, "end": 2211.39, "text": "我在这个..."}, {"start": 2211.39, "end": 2277.58, "text": "当有禅,"}, {"start": 2277.58, "end": 2279.58, "text": "禅方"}, {"start": 2279.58, "end": 2281.58, "text": "愤意悲鸣,"}, {"start": 2281.58, "end": 2283.58, "text": "欲饮轻怒,"}, {"start": 2283.58, "end": 2288.08, "text": "不知堂郎知在后,"}, {"start": 2288.08, "end": 2290.08, "text": "取其静。"}, {"start": 2290.08, "end": 2295.12, "text": "父亲,"}, {"start": 2295.12, "end": 2302.85, "text": "吾国太傅诸葛克"}, {"start": 2302.85, "end": 2304.85, "text": "率军攻徐昌。"}, {"start": 2304.85, "end": 2306.85, "text": "谁?"}, {"start": 2306.85, "end": 2308.85, "text": "诸葛克,"}, {"start": 2308.85, "end": 2310.85, "text": "也就是诸葛锦之子,"}, {"start": 2310.85, "end": 2317.33, "text": "诸葛亮之侄。"}, {"start": 2317.33, "end": 2321.76, "text": "什么?"}, {"start": 2321.76, "end": 2323.76, "text": "引兵犯境,攻打徐昌。"}, {"start": 2325.76, "end": 2327.76, "text": "兄长已经提兵十万,"}, {"start": 2327.76, "end": 2329.76, "text": "南下抵敌了。"}, {"start": 2329.76, "end": 2331.76, "text": "你说什么?"}, {"start": 2331.76, "end": 2333.76, "text": "谁抵敌了?"}, {"start": 2335.76, "end": 2337.76, "text": "兄长司马师,"}, {"start": 2337.76, "end": 2339.76, "text": "调兵十万南下。"}, {"start": 2346.37, "end": 2348.37, "text": "你哥哥提兵走了,"}, {"start": 2355.3, "end": 2357.3, "text": "你就得待在京城。"}, {"start": 2357.3, "end": 2360.93, "text": "咱们什么时候"}, {"start": 2360.93, "end": 2362.93, "text": "都得留个后手。"}, {"start": 2364.93, "end": 2366.93, "text": "是,"}, {"start": 2366.93, "end": 2368.93, "text": "儿明白。"}, {"start": 2370.93, "end": 2382.05, "text": "爷儿。"}, {"start": 2382.05, "end": 2391.7, "text": "爷爷,"}, {"start": 2391.7, "end": 2393.7, "text": "院中有鱼树,"}, {"start": 2393.7, "end": 2395.7, "text": "旗上有禅,"}, {"start": 2395.7, "end": 2397.7, "text": "禅方愤意悲鸣,"}, {"start": 2397.7, "end": 2399.7, "text": "欲饮轻怒,"}, {"start": 2399.7, "end": 2401.7, "text": "不知堂郎知在后,"}, {"start": 2401.7, "end": 2403.7, "text": "去其境,"}, {"start": 2403.7, "end": 2405.7, "text": "院中有鱼树,"}, {"start": 2405.7, "end": 2409.1, "text": "旗上有禅。"}, {"start": 2409.1, "end": 2411.1, "text": "七十二岁的司马遗病子,"}, {"start": 2431.02, "end": 2433.02, "text": "司马家族已经主宰"}, {"start": 2433.02, "end": 2435.02, "text": "魏国朝政。"}, {"start": 2435.02, "end": 2437.02, "text": "十二年后,"}, {"start": 2437.02, "end": 2442.06, "text": "司马招灭蜀,"}, {"start": 2442.06, "end": 2444.06, "text": "柳山降,"}, {"start": 2444.06, "end": 2446.06, "text": "又两年,"}, {"start": 2446.06, "end": 2449.79, "text": "司马炎篡位称帝,"}, {"start": 2449.79, "end": 2451.79, "text": "建立晋朝。"}, {"start": 2451.79, "end": 2453.79, "text": "公元二八零,"}, {"start": 2453.79, "end": 2458.8, "text": "司马炎荡平吾国,"}, {"start": 2458.8, "end": 2460.8, "text": "三国再次一统,"}, {"start": 2462.8, "end": 2464.8, "text": "天下终归司马时。"}]