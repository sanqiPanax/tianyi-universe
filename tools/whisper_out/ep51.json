[{"start": 0.0, "end": 2.0, "text": "在下的意思是"}, {"start": 2.0, "end": 4.0, "text": "如果我们去咬荆州"}, {"start": 4.0, "end": 6.0, "text": "就要先想好了"}, {"start": 6.0, "end": 8.0, "text": "要得回来怎么办"}, {"start": 8.0, "end": 10.0, "text": "要不回来又怎么办"}, {"start": 12.0, "end": 18.45, "text": "嗯,说得对"}, {"start": 20.45, "end": 22.45, "text": "冷静下来一想"}, {"start": 22.45, "end": 24.45, "text": "还是要不回来的可能性大"}, {"start": 24.45, "end": 26.45, "text": "荆州这块肉"}, {"start": 26.45, "end": 28.45, "text": "他们不但已经倒嘴"}, {"start": 28.45, "end": 30.45, "text": "都吞到肚子里了"}, {"start": 30.45, "end": 32.45, "text": "怎肯轻易吐之"}, {"start": 32.45, "end": 36.34, "text": "主公啊"}, {"start": 36.34, "end": 38.34, "text": "请恕在下直言"}, {"start": 38.34, "end": 42.42, "text": "就眼下的形势来看"}, {"start": 42.42, "end": 44.42, "text": "刘备连得四军"}, {"start": 44.42, "end": 46.42, "text": "军力大涨"}, {"start": 46.42, "end": 48.42, "text": "兵锋正进"}, {"start": 48.42, "end": 50.42, "text": "这一消一涨之间"}, {"start": 50.42, "end": 52.42, "text": "双方的力量"}, {"start": 52.42, "end": 54.42, "text": "大致持平"}, {"start": 54.42, "end": 58.05, "text": "我料想"}, {"start": 58.05, "end": 60.05, "text": "诸葛亮算定"}, {"start": 60.05, "end": 62.05, "text": "我们不会与他开战"}, {"start": 62.05, "end": 64.05, "text": "因此"}, {"start": 64.05, "end": 66.05, "text": "他定会赖着荆州不还"}, {"start": 66.05, "end": 69.84, "text": "孔明奸诈"}, {"start": 69.84, "end": 71.84, "text": "刘备虚伪"}, {"start": 71.84, "end": 73.84, "text": "主公啊"}, {"start": 73.84, "end": 75.84, "text": "在这个乱世当中"}, {"start": 75.84, "end": 77.84, "text": "没有奸诈与虚伪"}, {"start": 77.84, "end": 79.84, "text": "只有强弱与高下"}, {"start": 79.84, "end": 81.84, "text": "正所谓"}, {"start": 81.84, "end": 83.84, "text": "成者英雄"}, {"start": 83.84, "end": 85.84, "text": "败者贼呀"}, {"start": 85.84, "end": 91.81, "text": "这个道理我也明白"}, {"start": 91.81, "end": 93.81, "text": "只是一时契机而已"}, {"start": 95.81, "end": 97.81, "text": "子敬"}, {"start": 97.81, "end": 99.81, "text": "我议定"}, {"start": 99.81, "end": 103.15, "text": "荆州非要不可"}, {"start": 103.15, "end": 105.15, "text": "要不回来"}, {"start": 105.15, "end": 107.15, "text": "也得要"}, {"start": 107.15, "end": 109.15, "text": "说白了"}, {"start": 109.15, "end": 111.15, "text": "就是明知要不回来"}, {"start": 111.15, "end": 113.15, "text": "却偏偏还要去要"}, {"start": 113.15, "end": 115.15, "text": "一者"}, {"start": 115.15, "end": 117.15, "text": "去要"}, {"start": 117.15, "end": 119.15, "text": "证明我们一直坚持荆州是我们的"}, {"start": 119.15, "end": 121.15, "text": "而刘备只是"}, {"start": 121.15, "end": 123.15, "text": "作客于荆州"}, {"start": 123.15, "end": 125.15, "text": "二者"}, {"start": 125.15, "end": 127.15, "text": "若不去要"}, {"start": 127.15, "end": 129.15, "text": "他们更会小觑于我们"}, {"start": 129.15, "end": 131.15, "text": "三者"}, {"start": 131.15, "end": 133.15, "text": "我们要"}, {"start": 133.15, "end": 135.15, "text": "则他们不给"}, {"start": 135.15, "end": 137.15, "text": "则使他们理亏"}, {"start": 137.15, "end": 139.15, "text": "待时机成熟时"}, {"start": 139.15, "end": 141.15, "text": "我们再用兵去荆州"}, {"start": 141.15, "end": 143.15, "text": "那是取"}, {"start": 143.15, "end": 145.15, "text": "自己之物"}, {"start": 145.15, "end": 147.15, "text": "义者兵政理政"}, {"start": 149.15, "end": 151.15, "text": "好"}, {"start": 151.15, "end": 153.15, "text": "主公说得正是啊"}, {"start": 153.15, "end": 155.15, "text": "我这就以"}, {"start": 155.15, "end": 157.15, "text": "为刘齐"}, {"start": 157.15, "end": 159.15, "text": "调丧为名"}, {"start": 159.15, "end": 164.7, "text": "前往荆州"}, {"start": 164.7, "end": 166.7, "text": "主公 子敬"}, {"start": 166.7, "end": 168.7, "text": "蒋亲"}, {"start": 168.7, "end": 170.7, "text": "你不是应该在芭林统军吗"}, {"start": 170.7, "end": 172.7, "text": "怎么跑到这里来了"}, {"start": 172.7, "end": 174.7, "text": "末将前来领取军械粮饷"}, {"start": 174.7, "end": 176.7, "text": "今日寄回芭林"}, {"start": 176.7, "end": 178.7, "text": "临行前特来拜见主公"}, {"start": 178.7, "end": 180.7, "text": "前方军情如何"}, {"start": 180.7, "end": 182.7, "text": "主公 很奇怪"}, {"start": 182.7, "end": 184.7, "text": "末将来此途中"}, {"start": 184.7, "end": 186.7, "text": "与我军少探相遇"}, {"start": 186.7, "end": 188.7, "text": "他们禀报说"}, {"start": 188.7, "end": 190.7, "text": "好像在提防大敌来犯之意"}, {"start": 190.7, "end": 196.29, "text": "朱国良果然在备战"}, {"start": 196.29, "end": 200.05, "text": "公瑾病情如何"}, {"start": 200.05, "end": 202.05, "text": "大都督他"}, {"start": 202.05, "end": 204.05, "text": "时好时坏"}, {"start": 204.05, "end": 206.05, "text": "你出来的时候"}, {"start": 206.05, "end": 208.05, "text": "公瑾身在何处"}, {"start": 208.05, "end": 210.05, "text": "大都督"}, {"start": 210.05, "end": 212.05, "text": "又报兵视察前线去了"}, {"start": 212.05, "end": 214.05, "text": "看来是公瑾"}, {"start": 214.05, "end": 216.05, "text": "让你来补充军械的吧"}, {"start": 216.05, "end": 218.05, "text": "是"}, {"start": 218.05, "end": 222.42, "text": "你辛苦了"}, {"start": 222.42, "end": 224.42, "text": "急回芭林去吧"}, {"start": 224.42, "end": 236.43, "text": "告退"}, {"start": 236.43, "end": 238.43, "text": "子敬 公瑾得知刘岐已死"}, {"start": 238.43, "end": 240.43, "text": "立刻补充军械准备动兵"}, {"start": 240.43, "end": 242.43, "text": "他是意在荆州"}, {"start": 242.43, "end": 244.43, "text": "你立刻就走"}, {"start": 244.43, "end": 246.43, "text": "先去芭林看望周瑜的病情"}, {"start": 246.43, "end": 248.43, "text": "务必要阻拦他和刘备交兵"}, {"start": 248.43, "end": 250.43, "text": "然后再渡江调丧"}, {"start": 250.43, "end": 252.43, "text": "索要荆州"}, {"start": 252.43, "end": 254.43, "text": "遵命"}, {"start": 254.43, "end": 303.06, "text": "大都督"}, {"start": 303.06, "end": 307.2, "text": "你的伤病又犯了吧"}, {"start": 307.2, "end": 309.2, "text": "不但没犯"}, {"start": 309.2, "end": 311.2, "text": "而且一日好过一日"}, {"start": 311.2, "end": 313.2, "text": "已经半个月了"}, {"start": 313.2, "end": 315.2, "text": "你一直握着这部残菌不放"}, {"start": 315.2, "end": 317.2, "text": "反复的毒"}, {"start": 317.2, "end": 319.2, "text": "不知道这是何人所助"}, {"start": 319.2, "end": 321.2, "text": "对你"}, {"start": 321.2, "end": 328.48, "text": "有这么重要吗"}, {"start": 328.48, "end": 330.48, "text": "此书哪一位高人所助"}, {"start": 330.48, "end": 332.48, "text": "毒来令我茅塞大开"}, {"start": 332.48, "end": 335.76, "text": "现在我已经能看破其心"}, {"start": 335.76, "end": 337.76, "text": "其智"}, {"start": 337.76, "end": 342.93, "text": "谁"}, {"start": 342.93, "end": 344.93, "text": "诸葛亮"}, {"start": 344.93, "end": 346.93, "text": "他是我的天敌"}, {"start": 346.93, "end": 348.93, "text": "如欲战胜敌人"}, {"start": 348.93, "end": 350.93, "text": "必先以敌为师"}, {"start": 350.93, "end": 352.93, "text": "动起他的所有心思"}, {"start": 352.93, "end": 354.93, "text": "否则就会被敌所灭"}, {"start": 354.93, "end": 359.68, "text": "荆州之役后"}, {"start": 359.68, "end": 361.68, "text": "我痛定死痛"}, {"start": 361.68, "end": 363.68, "text": "反复琢磨诸葛亮的用兵之道"}, {"start": 363.68, "end": 365.68, "text": "现在"}, {"start": 365.68, "end": 367.68, "text": "我已完全能看出此人长短"}, {"start": 367.68, "end": 369.68, "text": "我已完全能料出诸葛亮所有心思"}, {"start": 369.68, "end": 371.68, "text": "我必杀诸葛亮"}, {"start": 371.68, "end": 373.68, "text": "大都督英明"}, {"start": 373.68, "end": 386.43, "text": "大都督"}, {"start": 386.43, "end": 388.43, "text": "鲁素先生坐船抵押了"}, {"start": 388.43, "end": 392.19, "text": "我又得跟他大吵一架了"}, {"start": 392.19, "end": 394.19, "text": "大都督"}, {"start": 394.19, "end": 396.19, "text": "你可以撑并不见啊"}, {"start": 396.19, "end": 398.19, "text": "岂敢"}, {"start": 398.19, "end": 400.19, "text": "不但得见"}, {"start": 400.19, "end": 402.19, "text": "还得出营"}, {"start": 402.19, "end": 405.98, "text": "听着"}, {"start": 405.98, "end": 407.98, "text": "你们谁敢对鲁素不敬"}, {"start": 407.98, "end": 409.98, "text": "我绝不轻饶"}, {"start": 409.98, "end": 418.96, "text": "遵命"}, {"start": 418.96, "end": 420.96, "text": "躬进你那"}, {"start": 420.96, "end": 422.96, "text": "紫禁此行是向刘备讨完荆州吧"}, {"start": 422.96, "end": 424.96, "text": "是啊"}, {"start": 424.96, "end": 426.96, "text": "刘齐升天了"}, {"start": 426.96, "end": 428.96, "text": "我们和刘备早就有约在先"}, {"start": 428.96, "end": 430.96, "text": "刘齐不在"}, {"start": 430.96, "end": 434.72, "text": "他就应该还我们荆州啊"}, {"start": 434.72, "end": 436.72, "text": "那不过是诸葛亮的一句托词"}, {"start": 436.72, "end": 438.72, "text": "紫禁你觉得"}, {"start": 438.72, "end": 440.72, "text": "狗嘴里要得回肉包子吗"}, {"start": 442.72, "end": 444.72, "text": "不愧是公瑾啊"}, {"start": 444.72, "end": 446.72, "text": "一眼就看出要害"}, {"start": 446.72, "end": 448.72, "text": "不过主公的决断是"}, {"start": 448.72, "end": 450.72, "text": "要不回"}, {"start": 450.72, "end": 452.72, "text": "我们也要要"}, {"start": 452.72, "end": 454.72, "text": "好 有气魄"}, {"start": 456.72, "end": 458.72, "text": "公瑾啊"}, {"start": 458.72, "end": 460.72, "text": "你到这芭林振钱来了"}, {"start": 460.72, "end": 462.72, "text": "使军"}, {"start": 462.72, "end": 464.72, "text": "不闻军鼓"}, {"start": 464.72, "end": 466.72, "text": "浑身的不自在"}, {"start": 466.72, "end": 468.72, "text": "果真如此吗"}, {"start": 468.72, "end": 470.72, "text": "你可是刚刚让"}, {"start": 470.72, "end": 472.72, "text": "蒋亲领了两万人的"}, {"start": 472.72, "end": 474.72, "text": "粮饷军械啊"}, {"start": 474.72, "end": 476.72, "text": "主公担忧我向荆州用兵"}, {"start": 476.72, "end": 480.26, "text": "对吗"}, {"start": 480.26, "end": 482.26, "text": "公瑾啊"}, {"start": 482.26, "end": 484.26, "text": "此次荆州不管要都回"}, {"start": 484.26, "end": 486.26, "text": "要不回"}, {"start": 486.26, "end": 494.46, "text": "我们都不能和刘备交战"}, {"start": 494.46, "end": 496.46, "text": "公瑾啊"}, {"start": 496.46, "end": 498.46, "text": "你知道"}, {"start": 498.46, "end": 500.46, "text": "刘备刚刚取下长沙四军"}, {"start": 500.46, "end": 502.46, "text": "军威大震"}, {"start": 502.46, "end": 504.46, "text": "而我们在河北损兵折将"}, {"start": 504.46, "end": 506.46, "text": "上疆太史寺"}, {"start": 506.46, "end": 508.46, "text": "也阵亡了"}, {"start": 508.46, "end": 510.46, "text": "这一宵一掌之间"}, {"start": 510.46, "end": 512.46, "text": "孙刘两家"}, {"start": 512.46, "end": 514.46, "text": "几乎是士军力敌"}, {"start": 514.46, "end": 518.06, "text": "再加上诸葛亮"}, {"start": 518.06, "end": 520.06, "text": "早就把大部分精锐部队"}, {"start": 520.06, "end": 522.06, "text": "收缩在荆州"}, {"start": 522.06, "end": 524.06, "text": "这说明"}, {"start": 524.06, "end": 526.06, "text": "他对我们早就有了防备"}, {"start": 526.06, "end": 528.06, "text": "你说得对"}, {"start": 528.06, "end": 532.94, "text": "不过你知道此时此刻"}, {"start": 532.94, "end": 536.58, "text": "诸葛亮是怎么想的"}, {"start": 536.58, "end": 540.43, "text": "都督明是"}, {"start": 540.43, "end": 542.43, "text": "诸葛亮早就看破了你的心思"}, {"start": 542.43, "end": 546.77, "text": "他算定我们不敢跟他开战"}, {"start": 546.77, "end": 548.77, "text": "诸葛亮认为"}, {"start": 548.77, "end": 550.77, "text": "只要曹操在"}, {"start": 550.77, "end": 552.77, "text": "东吴就不会让孙刘联盟解体"}, {"start": 552.77, "end": 554.77, "text": "主公和你"}, {"start": 554.77, "end": 556.77, "text": "不会为了一个荆州"}, {"start": 556.77, "end": 558.77, "text": "跟刘备翻脸"}, {"start": 558.77, "end": 560.77, "text": "所以你前去荆州必定空跑一趟"}, {"start": 560.77, "end": 562.77, "text": "诸葛亮也一定会赖着荆州不悔"}, {"start": 562.77, "end": 566.88, "text": "不错"}, {"start": 566.88, "end": 568.88, "text": "这的确是诸葛亮的心思"}, {"start": 568.88, "end": 570.88, "text": "被你一语道破"}, {"start": 570.88, "end": 572.88, "text": "在下佩服"}, {"start": 572.88, "end": 577.6, "text": "但是"}, {"start": 577.6, "end": 580.98, "text": "请你赐我一句实话"}, {"start": 580.98, "end": 584.48, "text": "你真的要"}, {"start": 584.48, "end": 586.48, "text": "聚兵攻打荆州吗"}, {"start": 586.48, "end": 596.48, "text": "太像了"}, {"start": 596.48, "end": 601.3, "text": "咒死也像"}, {"start": 601.3, "end": 603.3, "text": "我早就令吕蒙干宁讲清"}, {"start": 603.3, "end": 605.3, "text": "在此立兵莫马"}, {"start": 605.3, "end": 607.3, "text": "三个多月"}, {"start": 607.3, "end": 609.3, "text": "将士们斗志高昂"}, {"start": 609.3, "end": 611.3, "text": "恨不得即刻"}, {"start": 611.3, "end": 615.54, "text": "一雪荆州之耻"}, {"start": 615.54, "end": 619.39, "text": "不瞒你说"}, {"start": 619.39, "end": 621.39, "text": "我已经下令向芭林"}, {"start": 621.39, "end": 623.39, "text": "两翼进军"}, {"start": 623.39, "end": 625.39, "text": "步军三万水军五万分道行进"}, {"start": 625.39, "end": 627.39, "text": "三天之后"}, {"start": 627.39, "end": 629.39, "text": "就可抵荆州城下"}, {"start": 629.39, "end": 635.46, "text": "你无权这么做"}, {"start": 635.46, "end": 637.46, "text": "别忘了我是大都督"}, {"start": 637.46, "end": 639.46, "text": "可战和大计不是由你来决定"}, {"start": 639.46, "end": 641.46, "text": "这必须听主公的决断"}, {"start": 641.46, "end": 643.46, "text": "别忘了"}, {"start": 643.46, "end": 645.46, "text": "我这个大都督屡屡势全傲尚"}, {"start": 645.46, "end": 649.06, "text": "我师父偏偏就不听主公"}, {"start": 649.06, "end": 660.18, "text": "你"}, {"start": 662.18, "end": 665.87, "text": "紫禁啊"}, {"start": 665.87, "end": 667.87, "text": "我不会跟刘备开战的"}, {"start": 667.87, "end": 671.34, "text": "因为战机未到"}, {"start": 671.34, "end": 685.02, "text": "既然不战"}, {"start": 685.02, "end": 687.02, "text": "你为何还要向荆州用兵啊"}, {"start": 687.02, "end": 689.02, "text": "既然要不到荆州"}, {"start": 689.02, "end": 695.12, "text": "你为何还要取药啊"}, {"start": 695.12, "end": 704.1, "text": "何非"}, {"start": 704.1, "end": 706.1, "text": "你是在用"}, {"start": 706.1, "end": 708.1, "text": "移兵之计啊"}, {"start": 708.1, "end": 713.87, "text": "正是"}, {"start": 713.87, "end": 715.87, "text": "诸葛亮以为我们不敢跟他翻脸"}, {"start": 715.87, "end": 717.87, "text": "我偏要"}, {"start": 717.87, "end": 719.87, "text": "大举兵马"}, {"start": 719.87, "end": 721.87, "text": "做出宁为玉碎不为瓦全的样子"}, {"start": 721.87, "end": 723.87, "text": "对待诸葛亮这样的人"}, {"start": 723.87, "end": 725.87, "text": "三寸肉舌有何用"}, {"start": 725.87, "end": 729.98, "text": "他这个善变之徒"}, {"start": 729.98, "end": 731.98, "text": "恰恰最不相信的就是"}, {"start": 731.98, "end": 733.98, "text": "三寸肉舌必须兵戈相接"}, {"start": 733.98, "end": 739.7, "text": "紫禁你可以告诉他"}, {"start": 739.7, "end": 741.7, "text": "如果不还荆州"}, {"start": 741.7, "end": 743.7, "text": "我终于将不惜一战"}, {"start": 743.7, "end": 749.38, "text": "我这么做是为了你啊"}, {"start": 749.38, "end": 753.04, "text": "我高举战刀在后"}, {"start": 753.04, "end": 755.04, "text": "你才好一正言辞地"}, {"start": 755.04, "end": 757.04, "text": "向他们索要劲"}, {"start": 757.04, "end": 768.16, "text": "原来如此"}, {"start": 768.16, "end": 770.16, "text": "在下多谢相助了"}, {"start": 770.16, "end": 775.55, "text": "此外"}, {"start": 775.55, "end": 777.55, "text": "将士们练兵多日"}, {"start": 777.55, "end": 779.55, "text": "也应该出计一下了"}, {"start": 779.55, "end": 783.25, "text": "乔山镇"}, {"start": 783.25, "end": 785.25, "text": "看看荆州方面如何应付"}, {"start": 785.25, "end": 789.52, "text": "早晚回来"}, {"start": 789.52, "end": 806.72, "text": "此行即使要不到荆州"}, {"start": 806.72, "end": 810.7, "text": "也要让他们明白"}, {"start": 810.7, "end": 812.7, "text": "今日这一仗是他们欠下的"}, {"start": 812.7, "end": 816.34, "text": "拖得越久"}, {"start": 816.34, "end": 820.77, "text": "缓得越多"}, {"start": 820.77, "end": 822.77, "text": "公瑾啊你快回去吧"}, {"start": 822.77, "end": 824.77, "text": "我就不进军营了"}, {"start": 824.77, "end": 831.18, "text": "那你要干嘛"}, {"start": 831.18, "end": 833.18, "text": "公瑾啊你看"}, {"start": 833.18, "end": 835.18, "text": "明月当头好风无限"}, {"start": 835.18, "end": 837.18, "text": "我这就渡过江区"}, {"start": 837.18, "end": 839.18, "text": "明天"}, {"start": 839.18, "end": 841.18, "text": "就可以进入荆州城了"}, {"start": 841.18, "end": 844.69, "text": "刚到就走了"}, {"start": 844.69, "end": 846.69, "text": "这样还辛苦"}, {"start": 846.69, "end": 921.74, "text": "还是歇疑了"}, {"start": 921.74, "end": 923.74, "text": "你星夜赶来奔丧"}, {"start": 923.74, "end": 925.74, "text": "星夜"}, {"start": 925.74, "end": 931.01, "text": "多谢了"}, {"start": 931.01, "end": 933.01, "text": "皇叔休息"}, {"start": 933.01, "end": 935.01, "text": "因为接下来"}, {"start": 935.01, "end": 937.01, "text": "我倒想看看"}, {"start": 937.01, "end": 939.01, "text": "皇叔的仁义之心了"}, {"start": 941.01, "end": 943.01, "text": "有件事情容在下"}, {"start": 943.01, "end": 945.01, "text": "向皇叔请教"}, {"start": 945.01, "end": 947.01, "text": "请教"}, {"start": 947.01, "end": 949.01, "text": "前者皇叔有言"}, {"start": 949.01, "end": 951.01, "text": "公子不在"}, {"start": 951.01, "end": 953.01, "text": "急还荆州"}, {"start": 953.01, "end": 955.01, "text": "现在公子已经去世了"}, {"start": 955.01, "end": 957.01, "text": "皇叔可以兑现诺言了"}, {"start": 957.01, "end": 960.99, "text": "何时"}, {"start": 960.99, "end": 965.33, "text": "可以教歌呀"}, {"start": 965.33, "end": 967.33, "text": "这件事情"}, {"start": 967.33, "end": 969.33, "text": "能否"}, {"start": 969.33, "end": 971.33, "text": "暂缓两日"}, {"start": 971.33, "end": 973.33, "text": "容以后再议"}, {"start": 973.33, "end": 976.99, "text": "以后"}, {"start": 976.99, "end": 982.99, "text": "这以后又是何时"}, {"start": 982.99, "end": 984.99, "text": "紫荆啊"}, {"start": 984.99, "end": 986.99, "text": "你好不通情理"}, {"start": 986.99, "end": 990.94, "text": "大丧之日怎提这旧事"}, {"start": 990.94, "end": 992.94, "text": "正是"}, {"start": 992.94, "end": 994.94, "text": "大丧之日人无虚"}, {"start": 994.94, "end": 996.94, "text": "再说"}, {"start": 996.94, "end": 998.94, "text": "当着公子留起的灵位"}, {"start": 998.94, "end": 1000.94, "text": "提此旧事"}, {"start": 1000.94, "end": 1002.94, "text": "亦发显得真切"}, {"start": 1002.94, "end": 1008.18, "text": "普天之下"}, {"start": 1008.18, "end": 1010.18, "text": "莫非王土"}, {"start": 1010.18, "end": 1012.18, "text": "率土之兵莫非王臣"}, {"start": 1012.18, "end": 1014.18, "text": "荆州是谁的"}, {"start": 1014.18, "end": 1017.62, "text": "是你主吾侯的还是草草的"}, {"start": 1017.62, "end": 1019.62, "text": "他都不是"}, {"start": 1019.62, "end": 1021.62, "text": "他是朝廷"}, {"start": 1021.62, "end": 1023.62, "text": "当年高皇帝"}, {"start": 1023.62, "end": 1025.62, "text": "斩舌取义"}, {"start": 1025.62, "end": 1027.62, "text": "费了多少艰辛才开创了大汉"}, {"start": 1027.62, "end": 1029.62, "text": "不幸"}, {"start": 1029.62, "end": 1031.62, "text": "奸雄并起各举一方"}, {"start": 1031.62, "end": 1033.62, "text": "荆州才落入草草手中"}, {"start": 1033.62, "end": 1035.62, "text": "但无论任何人"}, {"start": 1035.62, "end": 1037.62, "text": "用任何方式站着"}, {"start": 1037.62, "end": 1039.62, "text": "他都该姓刘"}, {"start": 1039.62, "end": 1043.76, "text": "因为天子姓刘"}, {"start": 1043.76, "end": 1045.76, "text": "我主乃孝敬皇帝玄孙"}, {"start": 1045.76, "end": 1047.76, "text": "中山晋王之后"}, {"start": 1047.76, "end": 1049.76, "text": "经皇上之书"}, {"start": 1049.76, "end": 1051.76, "text": "我主占着荆襄"}, {"start": 1051.76, "end": 1053.76, "text": "成的是大汉祖爷"}, {"start": 1053.76, "end": 1055.76, "text": "儒主"}, {"start": 1055.76, "end": 1057.76, "text": "乃前堂小吏之子"}, {"start": 1057.76, "end": 1059.76, "text": "已经占据江东"}, {"start": 1059.76, "end": 1061.76, "text": "赏赐贪心不足"}, {"start": 1061.76, "end": 1063.76, "text": "而欲并吞汉土"}, {"start": 1063.76, "end": 1065.76, "text": "不给我主力追之敌"}, {"start": 1065.76, "end": 1067.76, "text": "这适合道理"}, {"start": 1067.76, "end": 1073.89, "text": "孔明不必诡辩"}, {"start": 1073.89, "end": 1077.3, "text": "我只当皇叔是仁义之君"}, {"start": 1077.3, "end": 1079.3, "text": "所以今天"}, {"start": 1079.3, "end": 1081.3, "text": "才请他兑现诺言"}, {"start": 1081.3, "end": 1086.69, "text": "当初我和皇叔相约时"}, {"start": 1086.69, "end": 1088.69, "text": "足下也是在场的呀"}, {"start": 1088.69, "end": 1092.19, "text": "难道今日皇叔"}, {"start": 1092.19, "end": 1094.19, "text": "要做不信不义之人吗"}, {"start": 1094.19, "end": 1096.19, "text": "子敬"}, {"start": 1096.19, "end": 1098.19, "text": "你也是世之高人"}, {"start": 1098.19, "end": 1100.19, "text": "当年我主"}, {"start": 1100.19, "end": 1102.19, "text": "三让徐州之事"}, {"start": 1102.19, "end": 1104.19, "text": "你应该听说过吗"}, {"start": 1104.19, "end": 1106.19, "text": "我主一向是仁义之君"}, {"start": 1106.19, "end": 1108.19, "text": "过去 今日 将来"}, {"start": 1108.19, "end": 1110.19, "text": "都是"}, {"start": 1110.19, "end": 1113.86, "text": "他一向把仁义看得比生命还重"}, {"start": 1113.86, "end": 1115.86, "text": "我主"}, {"start": 1115.86, "end": 1117.86, "text": "自占荆州后"}, {"start": 1117.86, "end": 1119.86, "text": "忍着东吴一帮人的购骂"}, {"start": 1119.86, "end": 1121.86, "text": "他心里好受"}, {"start": 1121.86, "end": 1123.86, "text": "他不好受"}, {"start": 1123.86, "end": 1125.86, "text": "但不好受也得受着"}, {"start": 1125.86, "end": 1127.86, "text": "为何"}, {"start": 1127.86, "end": 1129.86, "text": "因为他心里"}, {"start": 1129.86, "end": 1131.86, "text": "有比性意和生命更重要的事情"}, {"start": 1131.86, "end": 1137.98, "text": "忠心汉室"}, {"start": 1137.98, "end": 1148.43, "text": "也许你会笑皇叔"}, {"start": 1148.43, "end": 1150.43, "text": "都什么世道了"}, {"start": 1150.43, "end": 1152.43, "text": "还大言不休地"}, {"start": 1152.43, "end": 1154.43, "text": "谈汉室容衰"}, {"start": 1154.43, "end": 1156.43, "text": "可是"}, {"start": 1156.43, "end": 1158.43, "text": "皇叔乃帝室之咒"}, {"start": 1158.43, "end": 1160.43, "text": "就算天下人都忘了大汉"}, {"start": 1160.43, "end": 1162.43, "text": "他也不能忘"}, {"start": 1162.43, "end": 1164.43, "text": "如今"}, {"start": 1164.43, "end": 1166.43, "text": "天子被曹操挟制"}, {"start": 1166.43, "end": 1168.43, "text": "无苦苟言"}, {"start": 1168.43, "end": 1170.43, "text": "皇叔的心每天都在为此受着煎熬"}, {"start": 1170.43, "end": 1177.52, "text": "皇叔休恼"}, {"start": 1177.52, "end": 1179.52, "text": "在下素知"}, {"start": 1179.52, "end": 1181.52, "text": "皇叔乃忠义之君"}, {"start": 1181.52, "end": 1186.08, "text": "紫荆啊"}, {"start": 1186.08, "end": 1188.08, "text": "我是汉臣"}, {"start": 1188.08, "end": 1190.08, "text": "你也是汉臣"}, {"start": 1190.08, "end": 1192.08, "text": "你我祖上几代人都使着汉路"}, {"start": 1192.08, "end": 1194.08, "text": "就算不是汉臣"}, {"start": 1194.08, "end": 1196.08, "text": "也是汉民"}, {"start": 1196.08, "end": 1198.08, "text": "但周瑜忘本了"}, {"start": 1198.08, "end": 1200.08, "text": "不明白势力"}, {"start": 1200.08, "end": 1202.08, "text": "足下一直是个明理之人"}, {"start": 1202.08, "end": 1204.08, "text": "是想"}, {"start": 1204.08, "end": 1206.08, "text": "皇叔若没有一块立足之地"}, {"start": 1206.08, "end": 1208.08, "text": "又怎能忠心汉室"}, {"start": 1208.08, "end": 1210.08, "text": "怎能救天子于水火"}, {"start": 1210.08, "end": 1212.08, "text": "更何况"}, {"start": 1212.08, "end": 1215.87, "text": "怎么抵抗曹贼"}, {"start": 1215.87, "end": 1217.87, "text": "说得好"}, {"start": 1217.87, "end": 1219.87, "text": "据我所知"}, {"start": 1219.87, "end": 1224.24, "text": "曹操最无信意"}, {"start": 1224.24, "end": 1226.24, "text": "我族下心忧天下"}, {"start": 1226.24, "end": 1228.24, "text": "那就更应该以信意为本"}, {"start": 1230.24, "end": 1232.24, "text": "再说"}, {"start": 1232.24, "end": 1234.24, "text": "如果皇叔想服汉"}, {"start": 1234.24, "end": 1236.24, "text": "只凭一己之力"}, {"start": 1236.24, "end": 1238.24, "text": "恐怕不行吧"}, {"start": 1238.24, "end": 1240.24, "text": "师本"}, {"start": 1240.24, "end": 1242.24, "text": "如果没有我主吴侯之力"}, {"start": 1242.24, "end": 1244.24, "text": "你们能有今日之胜吗"}, {"start": 1246.24, "end": 1250.35, "text": "此话不错"}, {"start": 1250.35, "end": 1252.35, "text": "紫荆是忠厚之人"}, {"start": 1252.35, "end": 1254.35, "text": "我与吴侯能够联手抗曹"}, {"start": 1254.35, "end": 1256.35, "text": "有一半"}, {"start": 1256.35, "end": 1258.35, "text": "是靠族下的援建着实"}, {"start": 1260.35, "end": 1264.85, "text": "皇叔高看在下了"}, {"start": 1264.85, "end": 1268.19, "text": "说实话"}, {"start": 1268.19, "end": 1270.19, "text": "原来"}, {"start": 1270.19, "end": 1272.19, "text": "我一直千方百计地"}, {"start": 1272.19, "end": 1274.19, "text": "维持孙柳两家"}, {"start": 1274.19, "end": 1276.19, "text": "联合的局面"}, {"start": 1276.19, "end": 1278.19, "text": "为了达到这个目的"}, {"start": 1278.19, "end": 1280.19, "text": "我也曾劝解过我家主公"}, {"start": 1280.19, "end": 1282.19, "text": "对你们做了些让步"}, {"start": 1284.19, "end": 1286.19, "text": "但是凡事总应该有个度吧"}, {"start": 1286.19, "end": 1288.19, "text": "恕我放肆"}, {"start": 1288.19, "end": 1290.19, "text": "如果皇叔食言自肥"}, {"start": 1290.19, "end": 1292.19, "text": "非占着荆州不还"}, {"start": 1294.19, "end": 1296.19, "text": "那么"}, {"start": 1296.19, "end": 1298.19, "text": "即便我主吴侯能忍"}, {"start": 1298.19, "end": 1300.19, "text": "恐怕"}, {"start": 1300.19, "end": 1302.19, "text": "有的人却是不能忍的"}, {"start": 1302.19, "end": 1304.19, "text": "何人"}, {"start": 1304.19, "end": 1306.19, "text": "东吴长兵大都督"}, {"start": 1306.19, "end": 1308.19, "text": "周瑜周公瑾"}, {"start": 1312.19, "end": 1314.19, "text": "周瑜想动兵吗"}, {"start": 1314.19, "end": 1316.19, "text": "伤势未愈"}, {"start": 1316.19, "end": 1322.29, "text": "脾气还这么糟"}, {"start": 1322.29, "end": 1324.29, "text": "足下知道周郎的脾气就好"}, {"start": 1324.29, "end": 1326.29, "text": "不错"}, {"start": 1326.29, "end": 1328.29, "text": "荆州之役"}, {"start": 1328.29, "end": 1330.29, "text": "他气得吐了血"}, {"start": 1330.29, "end": 1332.29, "text": "但是"}, {"start": 1332.29, "end": 1334.29, "text": "一旦有个机会"}, {"start": 1334.29, "end": 1336.29, "text": "让他可以血恨"}, {"start": 1336.29, "end": 1340.18, "text": "或者说"}, {"start": 1340.18, "end": 1342.18, "text": "血齿罢"}, {"start": 1342.18, "end": 1344.18, "text": "我想即便是我家主公"}, {"start": 1344.18, "end": 1348.38, "text": "也会拦他不住的"}, {"start": 1348.38, "end": 1350.38, "text": "前天他竟然命令"}, {"start": 1350.38, "end": 1352.38, "text": "三万步军五万水军"}, {"start": 1352.38, "end": 1354.38, "text": "东进"}, {"start": 1354.38, "end": 1356.38, "text": "对此"}, {"start": 1356.38, "end": 1358.38, "text": "你们的少记"}, {"start": 1358.38, "end": 1364.16, "text": "应该早就有所探报了吧"}, {"start": 1364.16, "end": 1366.16, "text": "所幸的是"}, {"start": 1366.16, "end": 1368.16, "text": "我家主公当机离断"}, {"start": 1368.16, "end": 1370.16, "text": "夺了公瑾的兵权"}, {"start": 1370.16, "end": 1372.16, "text": "又令步军和水军"}, {"start": 1372.16, "end": 1374.16, "text": "原地驻扎待命"}, {"start": 1376.16, "end": 1378.16, "text": "六皇叔"}, {"start": 1378.16, "end": 1380.16, "text": "人心不可欺"}, {"start": 1380.16, "end": 1382.16, "text": "如果逼急了"}, {"start": 1382.16, "end": 1384.16, "text": "江东的将士们"}, {"start": 1384.16, "end": 1386.16, "text": "是不惜玉石俱焚的"}, {"start": 1386.16, "end": 1397.82, "text": "好"}, {"start": 1397.82, "end": 1399.82, "text": "子敬这番话"}, {"start": 1399.82, "end": 1401.82, "text": "很是诚恳"}, {"start": 1401.82, "end": 1405.1, "text": "义足下的意思"}, {"start": 1405.1, "end": 1407.1, "text": "眼下荆州这件事"}, {"start": 1407.1, "end": 1409.1, "text": "该如何办"}, {"start": 1409.1, "end": 1411.1, "text": "这句话"}, {"start": 1411.1, "end": 1414.61, "text": "好像应该由我来问"}, {"start": 1414.61, "end": 1416.61, "text": "那么"}, {"start": 1416.61, "end": 1418.61, "text": "依皇叔的意思"}, {"start": 1418.61, "end": 1420.61, "text": "眼下荆州这件事"}, {"start": 1420.61, "end": 1422.61, "text": "应该怎么办"}, {"start": 1422.61, "end": 1424.61, "text": "子敬"}, {"start": 1424.61, "end": 1427.92, "text": "这样可好"}, {"start": 1427.92, "end": 1431.2, "text": "荆州是你们的"}, {"start": 1431.2, "end": 1433.2, "text": "我们占借为立足之地"}, {"start": 1433.2, "end": 1435.2, "text": "今日"}, {"start": 1435.2, "end": 1437.2, "text": "主公亲笔立下文书给你"}, {"start": 1437.2, "end": 1439.2, "text": "待我们夺取其他州郡时"}, {"start": 1439.2, "end": 1441.2, "text": "再将荆州"}, {"start": 1441.2, "end": 1444.58, "text": "交付东"}, {"start": 1444.58, "end": 1446.58, "text": "夺取何地"}, {"start": 1446.58, "end": 1448.58, "text": "西川流章暗若无道"}, {"start": 1448.58, "end": 1450.58, "text": "我主打算西取西川"}, {"start": 1450.58, "end": 1452.58, "text": "夺西川后"}, {"start": 1452.58, "end": 1463.92, "text": "便将荆州奉还"}, {"start": 1463.92, "end": 1467.84, "text": "也罢"}, {"start": 1467.84, "end": 1469.84, "text": "有了这封文书"}, {"start": 1469.84, "end": 1471.84, "text": "我也好向我家主公交代了"}, {"start": 1471.84, "end": 1473.84, "text": "只是我家主公准与不准"}, {"start": 1473.84, "end": 1477.41, "text": "我却不知"}, {"start": 1477.41, "end": 1479.41, "text": "请皇叔和孔明"}, {"start": 1479.41, "end": 1481.41, "text": "双双在文书上签字画押吧"}, {"start": 1481.41, "end": 1491.63, "text": "孔明啊"}, {"start": 1491.63, "end": 1493.63, "text": "多谢相送"}, {"start": 1493.63, "end": 1495.63, "text": "请回吧"}, {"start": 1495.63, "end": 1497.63, "text": "子敬"}, {"start": 1497.63, "end": 1499.63, "text": "依你我的书籍"}, {"start": 1499.63, "end": 1501.63, "text": "有些话"}, {"start": 1501.63, "end": 1503.63, "text": "不好对自家主公说"}, {"start": 1503.63, "end": 1505.63, "text": "但你我彼此相知"}, {"start": 1505.63, "end": 1507.63, "text": "任何事都能直言是吗"}, {"start": 1507.63, "end": 1509.63, "text": "正是"}, {"start": 1509.63, "end": 1513.78, "text": "只要曹操还在是"}, {"start": 1513.78, "end": 1515.78, "text": "孙刘联盟断不可分离"}, {"start": 1515.78, "end": 1517.78, "text": "你我两家一旦交兵"}, {"start": 1517.78, "end": 1519.78, "text": "曹操必得天下"}, {"start": 1519.78, "end": 1527.12, "text": "不错"}, {"start": 1527.12, "end": 1529.12, "text": "子敬回见吴侯时"}, {"start": 1529.12, "end": 1531.12, "text": "勿请替我主公善意"}, {"start": 1531.12, "end": 1533.12, "text": "占借荆州为我立足之本"}, {"start": 1533.12, "end": 1535.12, "text": "切不可以刀剑相逼"}, {"start": 1535.12, "end": 1538.53, "text": "如果"}, {"start": 1538.53, "end": 1540.53, "text": "我家主公不准呢"}, {"start": 1540.53, "end": 1547.52, "text": "那便是夺我立足"}, {"start": 1547.52, "end": 1549.52, "text": "容身之地"}, {"start": 1549.52, "end": 1551.52, "text": "无立足容身之地之人"}, {"start": 1551.52, "end": 1553.52, "text": "迫不得已"}, {"start": 1553.52, "end": 1555.52, "text": "只能与东吴交兵"}, {"start": 1555.52, "end": 1557.52, "text": "以夺立足容身之处"}, {"start": 1557.52, "end": 1559.52, "text": "那时节"}, {"start": 1559.52, "end": 1561.52, "text": "江东八十一县"}, {"start": 1561.52, "end": 1563.52, "text": "都不得安宁"}, {"start": 1563.52, "end": 1569.3, "text": "孔明"}, {"start": 1569.3, "end": 1571.3, "text": "我也有一言"}, {"start": 1571.3, "end": 1573.3, "text": "请你切记"}, {"start": 1573.3, "end": 1577.12, "text": "请讲"}, {"start": 1577.12, "end": 1579.12, "text": "你们一旦取下西川"}, {"start": 1579.12, "end": 1581.12, "text": "请务必归还荆州"}, {"start": 1581.12, "end": 1583.12, "text": "否则"}, {"start": 1583.12, "end": 1585.12, "text": "我家主公必然用兵"}, {"start": 1585.12, "end": 1587.12, "text": "到那时"}, {"start": 1587.12, "end": 1589.12, "text": "非但儿等主臣"}, {"start": 1589.12, "end": 1591.12, "text": "再无立足容身之地"}, {"start": 1591.12, "end": 1593.12, "text": "而且"}, {"start": 1593.12, "end": 1595.12, "text": "恐怕是"}, {"start": 1595.12, "end": 1597.12, "text": "生无宁日"}, {"start": 1597.12, "end": 1599.12, "text": "死无葬身之所"}, {"start": 1599.12, "end": 1611.94, "text": "在下谨记"}, {"start": 1611.94, "end": 1626.96, "text": "告辞了"}, {"start": 1626.96, "end": 1628.96, "text": "子敬你好糊涂"}, {"start": 1628.96, "end": 1630.96, "text": "孔明说取西川便还荆州"}, {"start": 1630.96, "end": 1634.56, "text": "怎知他何时取西川"}, {"start": 1634.56, "end": 1636.56, "text": "如果他们十年不取"}, {"start": 1636.56, "end": 1638.56, "text": "荆州岂非是十年不还"}, {"start": 1638.56, "end": 1640.56, "text": "这等文书"}, {"start": 1640.56, "end": 1642.56, "text": "有何用"}, {"start": 1642.56, "end": 1647.31, "text": "这文书有用啊"}, {"start": 1647.31, "end": 1649.31, "text": "公秦"}, {"start": 1649.31, "end": 1651.31, "text": "你想想看"}, {"start": 1651.31, "end": 1653.31, "text": "以前刘备口口声声说荆州"}, {"start": 1653.31, "end": 1655.31, "text": "是朝廷的"}, {"start": 1655.31, "end": 1657.31, "text": "是刘齐的"}, {"start": 1657.31, "end": 1659.31, "text": "现在他终于承认"}, {"start": 1659.31, "end": 1661.31, "text": "荆州是我们的"}, {"start": 1661.31, "end": 1663.31, "text": "是我们介于他们的"}, {"start": 1663.31, "end": 1665.31, "text": "这是我能够办到"}, {"start": 1665.31, "end": 1670.58, "text": "最大的限度"}, {"start": 1670.58, "end": 1673.92, "text": "此行你已是不易"}, {"start": 1673.92, "end": 1675.92, "text": "休息几日再回柴仓吧"}, {"start": 1675.92, "end": 1677.92, "text": "我们有多少日子没喝酒了"}, {"start": 1677.92, "end": 1679.92, "text": "相见不易"}, {"start": 1679.92, "end": 1681.92, "text": "今日你我痛饮一场"}, {"start": 1681.92, "end": 1685.55, "text": "如何 好啊"}, {"start": 1685.55, "end": 1687.55, "text": "曹操虽是是贼"}, {"start": 1687.55, "end": 1689.55, "text": "但有一眼甚为精彩"}, {"start": 1689.55, "end": 1691.55, "text": "何眼"}, {"start": 1691.55, "end": 1693.55, "text": "对酒当歌"}, {"start": 1693.55, "end": 1696.86, "text": "人生几何"}, {"start": 1698.86, "end": 1700.86, "text": "今晚你我同叹而卧"}, {"start": 1700.86, "end": 1702.86, "text": "抵租而眠"}, {"start": 1702.86, "end": 1704.86, "text": "畅谈谈一个通宵"}, {"start": 1704.86, "end": 1708.69, "text": "好"}, {"start": 1708.69, "end": 1719.71, "text": "来"}, {"start": 1719.71, "end": 1721.71, "text": "你记得吗"}, {"start": 1721.71, "end": 1723.71, "text": "当年我刚刚带兵"}, {"start": 1723.71, "end": 1725.71, "text": "便遭逢大败"}, {"start": 1725.71, "end": 1729.44, "text": "好不容易死里逃生"}, {"start": 1729.44, "end": 1731.44, "text": "到了贵府上"}, {"start": 1731.44, "end": 1733.44, "text": "那时我跟弟兄们"}, {"start": 1733.44, "end": 1737.46, "text": "三天没吃的"}, {"start": 1737.46, "end": 1742.21, "text": "想向你借二斗米"}, {"start": 1742.21, "end": 1744.21, "text": "那时候你是大富户啊"}, {"start": 1744.21, "end": 1746.21, "text": "家中有粮两屯"}, {"start": 1748.21, "end": 1751.94, "text": "你只是其中一屯说"}, {"start": 1751.94, "end": 1753.94, "text": "拿去吧"}, {"start": 1753.94, "end": 1755.94, "text": "啊"}, {"start": 1755.94, "end": 1757.94, "text": "天哪"}, {"start": 1757.94, "end": 1759.94, "text": "那一屯粮是三千弹"}, {"start": 1759.94, "end": 1761.94, "text": "能救多少条人命"}, {"start": 1761.94, "end": 1768.61, "text": "在当时"}, {"start": 1768.61, "end": 1772.91, "text": "有粮就有兵"}, {"start": 1772.91, "end": 1780.51, "text": "我就用那屯粮"}, {"start": 1780.51, "end": 1784.21, "text": "招了三千兵丁"}, {"start": 1791.07, "end": 1793.07, "text": "那一日你来到我府中"}, {"start": 1795.07, "end": 1800.08, "text": "我一眼就看出来了"}, {"start": 1800.08, "end": 1802.08, "text": "是将相之才"}, {"start": 1802.08, "end": 1812.94, "text": "我也自信能够"}, {"start": 1812.94, "end": 1814.94, "text": "安邦治国平天下"}, {"start": 1814.94, "end": 1831.86, "text": "但想不到"}, {"start": 1831.86, "end": 1833.86, "text": "想不到碰上个诸葛亮"}, {"start": 1833.86, "end": 1843.15, "text": "我天敌啊"}, {"start": 1843.15, "end": 1847.01, "text": "光景你这心里头"}, {"start": 1847.01, "end": 1849.01, "text": "是不是恨透了"}, {"start": 1849.01, "end": 1852.61, "text": "诸葛亮啊"}, {"start": 1852.61, "end": 1858.1, "text": "这么跟你说吧"}, {"start": 1858.1, "end": 1864.19, "text": "在这天底下"}, {"start": 1864.19, "end": 1871.82, "text": "我最恨的人不是曹操"}, {"start": 1871.82, "end": 1873.82, "text": "而是诸葛亮"}, {"start": 1873.82, "end": 1974.7, "text": "最敬的人不是曹操"}, {"start": 1974.7, "end": 1998.78, "text": "也是啦"}, {"start": 1998.78, "end": 2000.78, "text": "当初军营张挂下藩"}, {"start": 2000.78, "end": 2006.88, "text": "据说刘备死了干夫人"}, {"start": 2006.88, "end": 2026.67, "text": "知道了下去吧"}, {"start": 2026.67, "end": 2028.67, "text": "诺"}, {"start": 2028.67, "end": 2033.65, "text": "可让刘备束手就擒"}, {"start": 2033.65, "end": 2037.15, "text": "荆州反掌可得"}, {"start": 2037.15, "end": 2041.01, "text": "请快快释下"}, {"start": 2041.01, "end": 2043.01, "text": "刘备死了发妻"}, {"start": 2043.01, "end": 2045.01, "text": "必将续娶一妹"}, {"start": 2045.01, "end": 2047.01, "text": "年当吉吉"}, {"start": 2047.01, "end": 2049.01, "text": "我们可上场主攻"}, {"start": 2049.01, "end": 2051.01, "text": "找刘备入赘东吴"}, {"start": 2051.01, "end": 2053.01, "text": "只要他进了荆康我们就扣下他"}, {"start": 2053.01, "end": 2056.77, "text": "逼诸葛亮由荆州来换"}, {"start": 2056.77, "end": 2058.77, "text": "你怕刘备不肯"}, {"start": 2062.69, "end": 2064.69, "text": "我告诉你"}, {"start": 2064.69, "end": 2066.69, "text": "他恨不得跟东吴成亲家呢"}, {"start": 2066.69, "end": 2068.69, "text": "问题不在刘备"}, {"start": 2068.69, "end": 2070.69, "text": "那在谁"}, {"start": 2070.69, "end": 2075.82, "text": "太夫人"}, {"start": 2075.82, "end": 2077.82, "text": "小姐和刘备相差三十岁"}, {"start": 2077.82, "end": 2083.95, "text": "太夫人岂能够允许"}, {"start": 2083.95, "end": 2085.95, "text": "这件事根本就不必让太夫人知道"}, {"start": 2085.95, "end": 2087.95, "text": "因为我们原本就"}, {"start": 2087.95, "end": 2092.51, "text": "没想让小妹嫁给刘备"}, {"start": 2092.51, "end": 2094.51, "text": "想以此为由"}, {"start": 2094.51, "end": 2106.82, "text": "招刘备入瓮"}, {"start": 2106.82, "end": 2123.28, "text": "那你如何跟主公说呢"}, {"start": 2123.28, "end": 2125.28, "text": "如果孙柳两家"}, {"start": 2125.28, "end": 2127.28, "text": "真能结为秦晋之后"}, {"start": 2127.28, "end": 2129.28, "text": "同心抗曹的话"}, {"start": 2129.28, "end": 2131.28, "text": "那当然再好不过了"}, {"start": 2131.28, "end": 2133.28, "text": "可刘备他毕竟是个"}, {"start": 2133.28, "end": 2135.28, "text": "年近半百的人了"}, {"start": 2135.28, "end": 2137.28, "text": "我又只有这么一个妹妹"}, {"start": 2137.28, "end": 2139.28, "text": "母亲又视他为掌上明珠"}, {"start": 2139.28, "end": 2141.28, "text": "你这叫我母亲"}, {"start": 2141.28, "end": 2143.28, "text": "如何舍得呀"}, {"start": 2143.28, "end": 2145.28, "text": "如果如实相比"}, {"start": 2145.28, "end": 2147.28, "text": "太夫人自然是"}, {"start": 2147.28, "end": 2149.28, "text": "不会答应"}, {"start": 2149.28, "end": 2151.28, "text": "公瑾的意思是"}, {"start": 2151.28, "end": 2153.28, "text": "不必禀报太夫人"}, {"start": 2153.28, "end": 2155.28, "text": "只是以此为由"}, {"start": 2155.28, "end": 2157.28, "text": "转刘备入瓮"}, {"start": 2157.28, "end": 2160.72, "text": "借此讨要荆州"}, {"start": 2160.72, "end": 2164.54, "text": "紫荆你意如何"}, {"start": 2164.54, "end": 2166.54, "text": "或可一试"}, {"start": 2166.54, "end": 2168.54, "text": "不会激起刀兵吗"}, {"start": 2168.54, "end": 2170.54, "text": "刘备一旦入瓮"}, {"start": 2170.54, "end": 2172.54, "text": "便为人质"}, {"start": 2172.54, "end": 2174.54, "text": "有刘备在"}, {"start": 2174.54, "end": 2176.54, "text": "官张诸葛亮投鼠忌器"}, {"start": 2176.54, "end": 2200.75, "text": "岂敢动刀兵啊"}, {"start": 2200.75, "end": 2204.1, "text": "主公"}, {"start": 2204.1, "end": 2206.1, "text": "探报数了他们的火灶"}, {"start": 2206.1, "end": 2208.1, "text": "总共四千多个"}, {"start": 2208.1, "end": 2210.1, "text": "以此推算"}, {"start": 2210.1, "end": 2212.1, "text": "周瑜已经拥兵八万了"}, {"start": 2212.1, "end": 2214.1, "text": "八万"}, {"start": 2214.1, "end": 2221.22, "text": "那么再加上江东各处的兵马"}, {"start": 2221.22, "end": 2223.22, "text": "吴侯有军"}, {"start": 2223.22, "end": 2225.22, "text": "应当不少于十二万"}, {"start": 2225.22, "end": 2227.22, "text": "主公"}, {"start": 2227.22, "end": 2237.06, "text": "东务有史前来"}, {"start": 2237.06, "end": 2239.06, "text": "正在福岸等候觐见主公"}, {"start": 2239.06, "end": 2243.84, "text": "拜察后刻"}, {"start": 2243.84, "end": 2245.84, "text": "遵命"}, {"start": 2245.84, "end": 2252.51, "text": "我看此人还是"}, {"start": 2252.51, "end": 2254.51, "text": "为了荆州之事而来"}, {"start": 2254.51, "end": 2256.51, "text": "难道"}, {"start": 2256.51, "end": 2258.51, "text": "吴侯不准我们借荆州"}, {"start": 2258.51, "end": 2260.51, "text": "难说"}, {"start": 2260.51, "end": 2263.79, "text": "这样吧主公"}, {"start": 2263.79, "end": 2265.79, "text": "无论此人说什么"}, {"start": 2265.79, "end": 2267.79, "text": "你先答应下来"}, {"start": 2267.79, "end": 2269.79, "text": "不要与他发生争执"}, {"start": 2269.79, "end": 2271.79, "text": "然后送此人到管一中休息"}, {"start": 2271.79, "end": 2279.71, "text": "我自有安排"}, {"start": 2279.71, "end": 2281.71, "text": "吕先生"}, {"start": 2281.71, "end": 2283.71, "text": "吴侯对借荆州一事"}, {"start": 2283.71, "end": 2285.71, "text": "有何指教"}, {"start": 2285.71, "end": 2287.71, "text": "禀皇叔"}, {"start": 2287.71, "end": 2289.71, "text": "我主已经准了"}, {"start": 2289.71, "end": 2291.71, "text": "请皇叔"}, {"start": 2291.71, "end": 2293.71, "text": "取西川之后"}, {"start": 2293.71, "end": 2295.71, "text": "务必归还荆州"}, {"start": 2295.71, "end": 2297.71, "text": "再不可食言备曰了"}, {"start": 2297.71, "end": 2303.39, "text": "多谢吴侯"}, {"start": 2303.39, "end": 2307.86, "text": "在下此行"}, {"start": 2307.86, "end": 2309.86, "text": "是为另一桩事而来"}, {"start": 2309.86, "end": 2311.86, "text": "请示下"}, {"start": 2311.86, "end": 2315.71, "text": "听说皇叔失偶"}, {"start": 2315.71, "end": 2317.71, "text": "现在有一门好亲"}, {"start": 2317.71, "end": 2319.71, "text": "在下顾不避嫌"}, {"start": 2319.71, "end": 2321.71, "text": "特来作为"}, {"start": 2321.71, "end": 2325.06, "text": "未知尊义若何"}, {"start": 2325.06, "end": 2327.06, "text": "我四海漂泊"}, {"start": 2327.06, "end": 2329.06, "text": "居无定所"}, {"start": 2329.06, "end": 2331.06, "text": "与其受累而丧"}, {"start": 2331.06, "end": 2333.06, "text": "大不幸也"}, {"start": 2333.06, "end": 2335.06, "text": "怎忍心在意亲"}, {"start": 2335.06, "end": 2337.06, "text": "拖累别人"}, {"start": 2337.06, "end": 2339.06, "text": "人若无妻"}, {"start": 2339.06, "end": 2341.06, "text": "如乌无良"}, {"start": 2341.06, "end": 2343.06, "text": "皇叔当世英雄"}, {"start": 2343.06, "end": 2345.06, "text": "岂可"}, {"start": 2345.06, "end": 2347.06, "text": "忠道而废人伦"}, {"start": 2347.06, "end": 2349.06, "text": "吴主有一妹"}, {"start": 2349.06, "end": 2351.06, "text": "美人嫌"}, {"start": 2351.06, "end": 2353.06, "text": "堪奉疾咒"}, {"start": 2353.06, "end": 2355.06, "text": "若两家"}, {"start": 2355.06, "end": 2357.06, "text": "共结秦晋之后"}, {"start": 2357.06, "end": 2359.06, "text": "则"}, {"start": 2359.06, "end": 2361.06, "text": "曹贼不敢"}, {"start": 2361.06, "end": 2363.06, "text": "正视南方也"}, {"start": 2363.06, "end": 2372.32, "text": "这叫我实感意外"}, {"start": 2372.32, "end": 2376.56, "text": "我已经"}, {"start": 2376.56, "end": 2378.56, "text": "年近半百了"}, {"start": 2378.56, "end": 2380.56, "text": "缤发一百"}, {"start": 2380.56, "end": 2382.56, "text": "而吴"}, {"start": 2382.56, "end": 2384.56, "text": "吴侯之妹正当妙龄"}, {"start": 2384.56, "end": 2386.56, "text": "我怎么配得上人家呢"}, {"start": 2386.56, "end": 2388.56, "text": "吴主之妹"}, {"start": 2388.56, "end": 2390.56, "text": "身虽是女子"}, {"start": 2390.56, "end": 2392.56, "text": "至上男儿"}, {"start": 2392.56, "end": 2394.56, "text": "她说过"}, {"start": 2394.56, "end": 2396.56, "text": "若非天下英雄"}, {"start": 2396.56, "end": 2398.56, "text": "吴无事之"}, {"start": 2398.56, "end": 2400.56, "text": "今皇叔"}, {"start": 2400.56, "end": 2402.56, "text": "名扬四海"}, {"start": 2402.56, "end": 2404.56, "text": "正所谓淑女配君子"}, {"start": 2404.56, "end": 2406.56, "text": "岂以"}, {"start": 2406.56, "end": 2408.56, "text": "年耻上下"}, {"start": 2408.56, "end": 2410.56, "text": "相贤乎啊"}, {"start": 2410.56, "end": 2416.21, "text": "吕先生"}, {"start": 2416.21, "end": 2418.21, "text": "请问"}, {"start": 2418.21, "end": 2420.21, "text": "此事可是吴侯之意"}, {"start": 2420.21, "end": 2422.21, "text": "正是"}, {"start": 2422.21, "end": 2426.35, "text": "吴主这样做"}, {"start": 2426.35, "end": 2428.35, "text": "也是为了表达和皇叔"}, {"start": 2428.35, "end": 2430.35, "text": "联手抗曹的决心"}, {"start": 2430.35, "end": 2432.35, "text": "这件事情"}, {"start": 2432.35, "end": 2434.35, "text": "家国两立"}, {"start": 2434.35, "end": 2436.35, "text": "请皇叔"}, {"start": 2436.35, "end": 2438.35, "text": "三思"}, {"start": 2438.35, "end": 2440.35, "text": "好好好"}, {"start": 2440.35, "end": 2442.35, "text": "多谢"}, {"start": 2442.35, "end": 2444.35, "text": "吴侯厚爱"}, {"start": 2444.35, "end": 2446.35, "text": "这样吧先生"}, {"start": 2446.35, "end": 2448.35, "text": "可否先到驿馆休息"}, {"start": 2448.35, "end": 2450.35, "text": "明日即可答复先生"}, {"start": 2450.35, "end": 2453.76, "text": "可好"}, {"start": 2453.76, "end": 2455.76, "text": "孙齐"}, {"start": 2455.76, "end": 2457.76, "text": "好生事后先生"}]