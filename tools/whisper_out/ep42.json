[{"start": 7.54, "end": 13.38, "text": "我要的兵马战船都准备好了吗?"}, {"start": 13.38, "end": 15.38, "text": "早就备好多日了,只等军师调用。"}, {"start": 15.38, "end": 163.81, "text": "好。"}, {"start": 163.81, "end": 165.81, "text": "子龙听令。"}, {"start": 165.81, "end": 171.22, "text": "你引三千军,渡江后直奔乌龄小道,在卢尾密处埋伏着。"}, {"start": 171.22, "end": 175.22, "text": "四经以后,曹操必从那里兵败。"}, {"start": 175.22, "end": 179.22, "text": "待见曹操拜兵至,你点燃卢尾旧式杀出。"}, {"start": 179.22, "end": 183.22, "text": "曹军即使不能全军覆没,也能杀他一半。"}, {"start": 183.22, "end": 185.22, "text": "遵命。"}, {"start": 185.22, "end": 189.22, "text": "你率五千军,渡江后前往夷陵葫芦口来。"}, {"start": 189.22, "end": 193.22, "text": "曹军被子龙杀过一场之后,必不敢往南面走。"}, {"start": 193.22, "end": 197.22, "text": "会往北夷陵奔头,你旧式杀出。"}, {"start": 197.22, "end": 201.22, "text": "就算情不得曹操,这份功劳也是不小啊。"}, {"start": 201.22, "end": 203.22, "text": "得嘞!"}, {"start": 203.22, "end": 205.22, "text": "尼方,尼竹,刘丰听令。"}, {"start": 205.22, "end": 210.66, "text": "你三人各率快船百支,不必攻杀曹军。"}, {"start": 210.66, "end": 214.66, "text": "我估计你们定能满载而归。"}, {"start": 214.66, "end": 216.66, "text": "遵命。"}, {"start": 216.66, "end": 218.66, "text": "公子,刘齐在。"}, {"start": 218.66, "end": 220.66, "text": "据武昌遗忘之地,最为要紧。"}, {"start": 220.66, "end": 224.66, "text": "请公子率本部兵马前往武昌城。"}, {"start": 224.66, "end": 230.64, "text": "但看曹操拜兵,便鼓声大作,出城击杀。"}, {"start": 230.64, "end": 232.64, "text": "遵命。"}, {"start": 232.64, "end": 236.64, "text": "主公啊,你我前往梵芦口来。"}, {"start": 236.64, "end": 238.64, "text": "看周瑜今夜建功。"}, {"start": 238.64, "end": 246.66, "text": "好极,好极。"}, {"start": 246.66, "end": 248.66, "text": "军师,那我呢?"}, {"start": 248.66, "end": 250.66, "text": "哦,关将军啊。"}, {"start": 250.66, "end": 252.66, "text": "你哪儿都不用去了?"}, {"start": 252.66, "end": 254.66, "text": "在家歇着。"}, {"start": 254.66, "end": 263.04, "text": "关某征战多年,身经百战。"}, {"start": 263.04, "end": 265.04, "text": "每逢战事从未落后。"}, {"start": 265.04, "end": 267.04, "text": "这些年,我从来都没有落后。"}, {"start": 267.04, "end": 269.04, "text": "我从来都没有落后。"}, {"start": 269.04, "end": 272.67, "text": "我从来没有落后。"}, {"start": 272.67, "end": 274.67, "text": "我从来没有落后。"}, {"start": 274.67, "end": 276.67, "text": "我从来没有落后。"}, {"start": 276.67, "end": 280.11, "text": "战事从未落后。"}, {"start": 280.11, "end": 282.11, "text": "今日之战,百年不遇。"}, {"start": 282.11, "end": 284.11, "text": "军师为何视我为巫物?"}, {"start": 286.11, "end": 288.11, "text": "云长啊,我"}, {"start": 288.11, "end": 292.11, "text": "我本想派给云长一锦腰的爱口。"}, {"start": 292.11, "end": 296.11, "text": "但有些放心不下,故而不敢用。"}, {"start": 296.11, "end": 298.11, "text": "为何放心不下?"}, {"start": 298.11, "end": 300.11, "text": "请军师明言。"}, {"start": 300.11, "end": 306.11, "text": "曹操兵败之后,必然会走华戎道。"}, {"start": 306.11, "end": 310.11, "text": "我如果派你去,怕你心软,把曹操放了。"}, {"start": 310.11, "end": 312.11, "text": "因此不敢派你。"}, {"start": 312.11, "end": 314.11, "text": "我为何要放他?"}, {"start": 314.11, "end": 318.11, "text": "曹操当年对你恩深似海。"}, {"start": 318.11, "end": 320.11, "text": "难道你就不想报答他吗?"}, {"start": 320.11, "end": 322.11, "text": "军师,你多心了。"}, {"start": 322.11, "end": 326.11, "text": "关某斩颜良诸文丑,解百马之违。"}, {"start": 326.11, "end": 328.11, "text": "早已报答过他了。"}, {"start": 328.11, "end": 330.11, "text": "我们是恩断义绝。"}, {"start": 330.11, "end": 334.11, "text": "如能撞到,岂敢放他?"}, {"start": 334.11, "end": 336.11, "text": "如果私下放了又如何?"}, {"start": 336.11, "end": 339.39, "text": "军法从事。"}, {"start": 339.39, "end": 341.39, "text": "好!"}, {"start": 341.39, "end": 343.39, "text": "那请官将军立军令状。"}, {"start": 343.39, "end": 347.39, "text": "好,我愿立军令状。"}, {"start": 347.39, "end": 353.39, "text": "如果官某思纵曹操,愿受军法处置。"}, {"start": 353.39, "end": 359.39, "text": "但如果曹操未从华戎道而来,又该如何?"}, {"start": 359.39, "end": 361.39, "text": "问得好。"}, {"start": 361.39, "end": 365.39, "text": "这样吧,我也立下军令状。"}, {"start": 365.39, "end": 370.39, "text": "如果曹操不从华戎道上来,就罚我军法从事。"}, {"start": 370.39, "end": 375.39, "text": "好,这天大的功劳,官某算是拿定了。"}, {"start": 375.39, "end": 377.39, "text": "官平、周桑!"}, {"start": 377.39, "end": 378.39, "text": "在!"}, {"start": 378.39, "end": 379.39, "text": "随我出征!"}, {"start": 379.39, "end": 380.39, "text": "遵命!"}, {"start": 380.39, "end": 390.66, "text": "关于最终意气,我担心……"}, {"start": 390.66, "end": 396.66, "text": "主公,我夜观天象,此意曹操命。"}, {"start": 396.66, "end": 398.66, "text": "曹操命不该举。"}, {"start": 398.66, "end": 411.67, "text": "既然如此,这份人情就让给官女,也是一件传世美谈。"}, {"start": 411.67, "end": 414.67, "text": "先生真乃神算子,古今罕见。"}, {"start": 414.67, "end": 415.67, "text": "罕见。"}, {"start": 415.67, "end": 425.17, "text": "此意,恍惚我们江东的安危!"}, {"start": 425.17, "end": 428.17, "text": "所有将士,要翻营杀敌!"}, {"start": 428.17, "end": 431.17, "text": "各部将领,要身先士卒!"}, {"start": 431.17, "end": 436.14, "text": "剿灭曹操!"}, {"start": 436.14, "end": 438.14, "text": "黄将军,都准备妥当了吗?"}, {"start": 438.14, "end": 442.14, "text": "只等大都督下令,便要拔毛起航!"}, {"start": 442.14, "end": 446.14, "text": "好,我用两贼的头颅,为将军撞行!"}, {"start": 446.14, "end": 447.14, "text": "好!"}, {"start": 447.14, "end": 449.39, "text": "押上来!"}, {"start": 449.39, "end": 451.39, "text": "走!"}, {"start": 451.39, "end": 452.39, "text": "走!"}, {"start": 454.39, "end": 455.39, "text": "快走!"}, {"start": 455.39, "end": 460.97, "text": "大都督饶命啊!"}, {"start": 460.97, "end": 461.97, "text": "饶命啊,大都督!"}, {"start": 461.97, "end": 462.97, "text": "计骑!"}, {"start": 465.97, "end": 469.59, "text": "出发!"}, {"start": 469.59, "end": 519.86, "text": "不该约定的归乡信号,天出火焰。"}, {"start": 519.86, "end": 526.16, "text": "不必败,孙全活不了几日了。"}, {"start": 526.16, "end": 559.22, "text": "这船体过于轻浮,不像是满载粮草和兵器的船啊!"}, {"start": 559.22, "end": 561.22, "text": "用箭射住,不准靠近!"}, {"start": 561.22, "end": 562.22, "text": "放箭!"}, {"start": 562.22, "end": 1154.24, "text": "给我点火!"}, {"start": 1154.24, "end": 1158.24, "text": "出的沙声中,判断出三江口的战况。"}, {"start": 1158.24, "end": 1161.96, "text": "遵命。"}, {"start": 1161.96, "end": 1171.78, "text": "沙声之中,吴军的谷号浓密,曹军的呼喊杂乱。"}, {"start": 1171.78, "end": 1175.78, "text": "其中,还夹杂着战马重剑的长厮,"}, {"start": 1175.78, "end": 1181.73, "text": "和将士临死前的痛号,学生判断。"}, {"start": 1181.73, "end": 1185.73, "text": "周瑜的大军已经攻破曹营,曹军正在溃败。"}, {"start": 1185.73, "end": 1188.73, "text": "三江口,大局已定。"}, {"start": 1188.73, "end": 1194.49, "text": "不错,曹操终于败了。"}, {"start": 1194.49, "end": 1201.21, "text": "可是先生,好像并不欢喜。"}, {"start": 1201.21, "end": 1206.63, "text": "何以见得?"}, {"start": 1206.63, "end": 1214.63, "text": "恕学生直言,先生恐怕是在为一个人而担忧。"}, {"start": 1214.63, "end": 1216.63, "text": "我担忧什么?"}, {"start": 1216.63, "end": 1218.63, "text": "先生是在为曹操而待命。"}, {"start": 1218.63, "end": 1220.63, "text": "我为什么要为曹操待命?"}, {"start": 1220.63, "end": 1228.73, "text": "先生所虑的,不是曹操会不会死,"}, {"start": 1228.73, "end": 1231.73, "text": "而是曹操能不能活。"}, {"start": 1231.73, "end": 1236.97, "text": "如果曹操死在关将军之手,"}, {"start": 1236.97, "end": 1241.97, "text": "那么此后,我们便和曹氏后裔结下了不共待天之仇,"}, {"start": 1241.97, "end": 1244.97, "text": "成为他们的头号大敌。"}, {"start": 1244.97, "end": 1252.13, "text": "尤长,你让我刮目相看。"}, {"start": 1252.13, "end": 1283.99, "text": "小的,小的实在扛不动了。"}, {"start": 1283.99, "end": 1286.99, "text": "你当了多久的掌机兵了?来!"}, {"start": 1286.99, "end": 1290.99, "text": "回丞相,小的,小的跟你十年了。"}, {"start": 1290.99, "end": 1295.99, "text": "那你应该知道,头可断,人可亡,帅气不能丢。"}, {"start": 1295.99, "end": 1299.99, "text": "小的,小的知道。"}, {"start": 1299.99, "end": 1306.99, "text": "胜败乃兵家常事,失败并不可怕,可怕的是心疾而败了。"}, {"start": 1306.99, "end": 1314.69, "text": "这是何处?"}, {"start": 1314.69, "end": 1318.69, "text": "丞相,乌林之西,一渡之北啊。"}, {"start": 1321.69, "end": 1324.69, "text": "丞相为何发笑啊?"}, {"start": 1324.69, "end": 1329.69, "text": "我笑,我笑周虞无谋,诸葛愚蠢。"}, {"start": 1329.69, "end": 1330.69, "text": "为何?"}, {"start": 1330.69, "end": 1339.19, "text": "你们看,此处山势险峻,乃兵家生死之地。"}, {"start": 1339.19, "end": 1343.19, "text": "如果能在此处预先埋伏一支伏兵的话,"}, {"start": 1343.19, "end": 1346.19, "text": "我等插尺难逃。"}, {"start": 1346.19, "end": 1348.19, "text": "这回虽然他们侥幸取胜了,"}, {"start": 1348.19, "end": 1351.19, "text": "不过是一介匹夫殊胜儿。"}, {"start": 1351.19, "end": 1353.19, "text": "吴祖历,吴祖历!"}, {"start": 1353.19, "end": 1358.88, "text": "照左方军师下令,再次等候多时。"}, {"start": 1358.88, "end": 1361.99, "text": "丞相,快!"}, {"start": 1361.99, "end": 1375.78, "text": "派出了六路兵,却独一缺,西北一缺。"}, {"start": 1375.78, "end": 1379.78, "text": "吴军攻破曹营后,本可以将曹操射杀。"}, {"start": 1379.78, "end": 1384.78, "text": "然而,却让曹操于重围之中脱身遁去。"}, {"start": 1385.78, "end": 1387.78, "text": "我猜想,"}, {"start": 1387.78, "end": 1393.78, "text": "为何周瑜要把曹操的大功劳交给主公?"}, {"start": 1393.78, "end": 1394.78, "text": "为什么?"}, {"start": 1394.78, "end": 1402.02, "text": "周瑜是故意把曹操驱赶到我军前,"}, {"start": 1402.02, "end": 1405.02, "text": "让曹操死于我军之手。"}, {"start": 1405.02, "end": 1409.02, "text": "让曹氏把这笔仇恨寄给主公。"}, {"start": 1409.02, "end": 1413.88, "text": "江东不仅可以获得胜利,"}, {"start": 1413.88, "end": 1420.88, "text": "更可以在今后旁观我主和曹氏之间的拼杀他坐收余翁之力。"}, {"start": 1420.88, "end": 1435.98, "text": "先生,我说错了吗?"}, {"start": 1435.98, "end": 1438.98, "text": "不,你说对了。"}, {"start": 1438.98, "end": 1446.33, "text": "尤长,想不到你未见周瑜,竟能看破周瑜心计。"}, {"start": 1446.33, "end": 1449.33, "text": "这营中怕是找不出第二个人了。"}, {"start": 1449.33, "end": 1451.33, "text": "谢先生夸奖。"}, {"start": 1451.33, "end": 1455.33, "text": "但你并没有到处我们真正可游之处,却过于喜悦。"}, {"start": 1455.33, "end": 1458.33, "text": "还请先生教我。"}, {"start": 1458.33, "end": 1464.61, "text": "曹操大败之后元气大伤,数年之内不敢动了。"}, {"start": 1464.61, "end": 1468.61, "text": "而东吴大胜之后,实力大增。"}, {"start": 1468.61, "end": 1473.61, "text": "他还会与我们亲密为盟,还会像以前那样对我们吗?"}, {"start": 1473.61, "end": 1476.61, "text": "卧榻之策岂容杭人。"}, {"start": 1476.61, "end": 1480.61, "text": "周瑜定想趁此机会夺取荆州九郡,"}, {"start": 1480.61, "end": 1483.61, "text": "之后吸取古川,成天下霸业。"}, {"start": 1484.61, "end": 1488.61, "text": "尤长啊,敌与友是相互变化的。"}, {"start": 1488.61, "end": 1491.61, "text": "今日之敌很可能成为明日之友,"}, {"start": 1491.61, "end": 1495.61, "text": "今日之友也可能成为明日之敌。"}, {"start": 1495.61, "end": 1499.61, "text": "就是我在东吴帮周瑜抗曹时,"}, {"start": 1499.61, "end": 1503.61, "text": "周瑜还几次三番想要杀我,为东吴消除后患。"}, {"start": 1503.61, "end": 1508.61, "text": "若非鲁素阻止,我恐怕早就死在宫井之手了。"}, {"start": 1508.61, "end": 1510.61, "text": "是吗?"}, {"start": 1510.61, "end": 1512.61, "text": "我还要告诉你的是,"}, {"start": 1512.61, "end": 1515.61, "text": "鲁素之所以阻止周瑜害我,"}, {"start": 1515.61, "end": 1518.61, "text": "其意也并非出于心善,并非为了救我,"}, {"start": 1518.61, "end": 1527.54, "text": "而是为了救孙刘联盟,救他江东。"}, {"start": 1527.54, "end": 1534.35, "text": "学生提狐贯地,大梦方觉。"}, {"start": 1534.35, "end": 1540.35, "text": "我们现在最要紧的并非此意的胜败,并非曹操的生死,"}, {"start": 1540.35, "end": 1545.35, "text": "而是如何取下荆州,如何对付即将变脸的东吴。"}, {"start": 1545.35, "end": 1570.26, "text": "王!王!"}, {"start": 1570.26, "end": 1571.26, "text": "卖灵!卖灵!"}, {"start": 1571.26, "end": 1578.59, "text": "站住他们!站住!"}, {"start": 1578.59, "end": 1584.82, "text": "王一文,让他走吧。"}, {"start": 1584.82, "end": 1590.14, "text": "要都跑了,那谁来保护成县了?"}, {"start": 1590.14, "end": 1594.14, "text": "吓破了胆的军士,再多也无用。"}, {"start": 1594.14, "end": 1624.32, "text": "金公之鸟,任其自去,该走的都走了。"}, {"start": 1624.32, "end": 1629.55, "text": "还有二十七个人。"}, {"start": 1629.55, "end": 1639.25, "text": "苍天后代啊,还给我留了二十七个人。"}, {"start": 1639.25, "end": 1645.04, "text": "想当年,我行刺董卓未遂,"}, {"start": 1645.04, "end": 1651.04, "text": "披马逃出京城,东作西藏,何其狼狈。"}, {"start": 1651.04, "end": 1654.04, "text": "可是短短几年工夫,"}, {"start": 1654.04, "end": 1660.04, "text": "我就擒起了一面王旗,招募了蒙氏百万。"}, {"start": 1660.04, "end": 1669.04, "text": "到今日,竟然还有二十七个中心根根的将士。"}, {"start": 1669.04, "end": 1675.0, "text": "还有什么可仇的?"}, {"start": 1675.0, "end": 1690.98, "text": "苍天不负我,我也绝不会辜负这片苍天的。"}, {"start": 1690.98, "end": 1701.38, "text": "丞相,启行吧。"}, {"start": 1711.86, "end": 1716.2, "text": "丞相,刚才大孝引来了赵子龙,"}, {"start": 1716.2, "end": 1719.2, "text": "现在又为何发笑啊?"}, {"start": 1719.2, "end": 1727.27, "text": "我还是孝周于无母,诸葛短治。"}, {"start": 1727.27, "end": 1736.76, "text": "你们看此间地势,宛如一只葫芦口。"}, {"start": 1737.76, "end": 1743.76, "text": "如果是我用兵,必定会在此处埋下一支伏兵。"}, {"start": 1743.76, "end": 1751.07, "text": "不需多,五百天气足矣,我等必死无疑。"}, {"start": 1751.07, "end": 1805.0, "text": "由此看来,周于,诸葛亮,匹夫而已,皆不足成。"}, {"start": 1805.0, "end": 1809.0, "text": "丞相投赐大孝,引来了赵云。"}, {"start": 1809.0, "end": 1815.38, "text": "二次大孝,引来了张飞,几乎使我们丧命啊。"}, {"start": 1815.38, "end": 1820.38, "text": "在下赶紧,丞相,不要再笑了。"}, {"start": 1820.38, "end": 1824.38, "text": "我明白了,我一切都明白了。"}, {"start": 1824.38, "end": 1826.38, "text": "丞相明白什么了?"}, {"start": 1826.38, "end": 1831.38, "text": "你们想想,咱们身后一直有周于的数据。"}, {"start": 1831.38, "end": 1838.38, "text": "为什么他们一直屡屡破镜,却一直没有乱剑齐发?"}, {"start": 1839.38, "end": 1846.38, "text": "还有,为什么他们一直是古生大作,却不拼力为杀我们?"}, {"start": 1846.38, "end": 1847.38, "text": "为什么?"}, {"start": 1847.38, "end": 1848.38, "text": "为什么呢?"}, {"start": 1848.38, "end": 1855.38, "text": "因为周于想把我赶到刘备的地盘去,借刘备至少杀我。"}, {"start": 1855.38, "end": 1860.38, "text": "这样刘备就成了我们北军的大敌。"}, {"start": 1860.38, "end": 1866.38, "text": "而东吴就可以躲开我们复仇的利剑,鱼翁得利。"}, {"start": 1866.38, "end": 1872.38, "text": "可是赵云和张飞也是指节而不及啊。"}, {"start": 1872.38, "end": 1876.72, "text": "他们只顾掠夺兵器和马匹啊。"}, {"start": 1876.72, "end": 1880.72, "text": "那是因为诸葛亮也识破了周于。"}, {"start": 1880.72, "end": 1886.72, "text": "他也想把我赶到东吴的地盘上去,借东吴的手来杀我。"}, {"start": 1886.72, "end": 1893.72, "text": "孙刘联盟,是则各怀鬼胎啊。"}, {"start": 1893.72, "end": 1895.72, "text": "丞相所言极是啊。"}, {"start": 1895.72, "end": 1903.72, "text": "由此可见,孙刘联盟长不了,我曹操也死不了。"}, {"start": 1903.72, "end": 1909.72, "text": "周围虽然遍布杀鸡,在我曹操最安全。"}, {"start": 1909.72, "end": 1916.72, "text": "我可以断言,诸位一定可以毫发无损地跟我回到南军大营。"}, {"start": 1916.72, "end": 1923.93, "text": "这也算是对你们忠诚的回报吧。"}, {"start": 1923.93, "end": 1925.93, "text": "丞相英明啊。"}, {"start": 1925.93, "end": 1930.93, "text": "丞相,逃兵遭到了律师。"}, {"start": 1931.93, "end": 1938.41, "text": "丞相英明啊。"}, {"start": 1938.41, "end": 1943.41, "text": "丞相,逃兵遭到了律师,领土的监杀都死了。"}, {"start": 1943.41, "end": 1950.41, "text": "看见了吗?看见了吗?去我去者就是自寻绝路。"}, {"start": 1950.41, "end": 1955.41, "text": "丞相,下命令吧,我们该怎么办?不要慌。"}, {"start": 1955.41, "end": 1958.52, "text": "承玉。"}, {"start": 1958.52, "end": 1959.52, "text": "在。"}, {"start": 1959.52, "end": 1960.52, "text": "你说。"}, {"start": 1960.52, "end": 1967.52, "text": "丞相,这里是三岔口啊,此去南军有两条道。"}, {"start": 1967.52, "end": 1973.52, "text": "左边是大道,道路平坦,却远五十里。"}, {"start": 1973.52, "end": 1980.52, "text": "右边是华融道,道路崎嶇,却近五十里。"}, {"start": 1980.52, "end": 1988.52, "text": "丞相,华融道上也有风烟飘起啊,大道上反而很平静。"}, {"start": 1988.52, "end": 1993.5, "text": "走华融道。"}, {"start": 1993.5, "end": 1995.5, "text": "华融道上有伏兵啊。"}, {"start": 1995.5, "end": 1998.5, "text": "虚者识之,识者虚之。"}, {"start": 1998.5, "end": 2002.5, "text": "虚虚实实,用兵之道。"}, {"start": 2002.5, "end": 2007.5, "text": "华融道上的风烟不是伏兵,是故作夷兵。"}, {"start": 2007.5, "end": 2011.5, "text": "楚歌亮的雕虫小技岂能瞒得过我。"}, {"start": 2011.5, "end": 2012.5, "text": "走。"}, {"start": 2013.5, "end": 2046.42, "text": "丞相,为何不走了?"}, {"start": 2046.42, "end": 2049.42, "text": "丞相这批火焰狙极有灵性。"}, {"start": 2049.42, "end": 2063.22, "text": "遇到猛兽大虫,或是狄青,就会地名报警。"}, {"start": 2063.22, "end": 2064.22, "text": "他来了。"}, {"start": 2064.22, "end": 2065.22, "text": "谁?"}, {"start": 2065.22, "end": 2074.22, "text": "你们想想,连日来孙柳的猛将军已出现,唯有一人没有出现,这人是谁?"}, {"start": 2075.22, "end": 2076.22, "text": "关羽?"}, {"start": 2076.22, "end": 2114.5, "text": "变过丞相。"}, {"start": 2114.5, "end": 2116.5, "text": "将军,别来无恙。"}, {"start": 2116.5, "end": 2119.78, "text": "在下尚好。"}, {"start": 2119.78, "end": 2126.78, "text": "丞相,关羽奉军师将令,在此专候。"}, {"start": 2126.78, "end": 2135.45, "text": "军长,隔着树里,我都能感觉到你长刀上的含义。"}, {"start": 2135.45, "end": 2141.45, "text": "自许昌一别,我常在梦中见到将军。"}, {"start": 2141.45, "end": 2147.45, "text": "总是盼望着何年何月能与你八九言欢。"}, {"start": 2147.45, "end": 2154.45, "text": "没想到,相逢却是在这穷途末路之中。"}, {"start": 2154.45, "end": 2159.05, "text": "丞相,下马吧。"}, {"start": 2159.05, "end": 2162.05, "text": "虽然是个小兵,但不会让你受苦。"}, {"start": 2162.05, "end": 2167.05, "text": "军长,你忘了我们以前的交情了吗?"}, {"start": 2167.05, "end": 2171.05, "text": "丞相,我永远不会忘记以前的恩典。"}, {"start": 2171.05, "end": 2176.05, "text": "只是,展颜良和朱文丑已经报答过丞相。"}, {"start": 2176.05, "end": 2181.05, "text": "今天我们相遇,我怎么敢与他相争?"}, {"start": 2181.05, "end": 2185.05, "text": "那么你也忘了过五官斩六将的事吗?"}, {"start": 2185.05, "end": 2188.05, "text": "你杀了我那么多的将军。"}, {"start": 2188.05, "end": 2192.05, "text": "我让你过将,不要为难你。"}, {"start": 2192.05, "end": 2195.05, "text": "让你兄弟三人团圆。"}, {"start": 2195.05, "end": 2216.46, "text": "军长,我们有高山流水之情,"}, {"start": 2216.46, "end": 2219.46, "text": "但我们必须在战场上成为敌人。"}, {"start": 2219.46, "end": 2222.46, "text": "人生的痛苦不过死。"}, {"start": 2222.46, "end": 2228.78, "text": "我已经被打败,我已经是孤家寡人。"}, {"start": 2228.78, "end": 2231.78, "text": "我已经被打败,我已经是孤家寡人。"}, {"start": 2231.78, "end": 2234.78, "text": "我已经被打败,我已经是孤家寡人。"}, {"start": 2234.78, "end": 2237.78, "text": "不过,你必须听我一声。"}, {"start": 2237.78, "end": 2258.86, "text": "我曹操,生当豪杰。"}, {"start": 2258.86, "end": 2263.86, "text": "死亦鬼凶,断不堪忍受。"}, {"start": 2263.86, "end": 2266.86, "text": "除求之辱。"}, {"start": 2266.86, "end": 2269.86, "text": "如果,云长,"}, {"start": 2269.86, "end": 2272.86, "text": "在昔日的交情份上,"}, {"start": 2272.86, "end": 2275.86, "text": "请指使剑斩我头颅。"}, {"start": 2276.86, "end": 2278.86, "text": "丞相!"}, {"start": 2279.86, "end": 2282.86, "text": "能死在将军这样的大英雄手下,"}, {"start": 2282.86, "end": 2284.86, "text": "此生无憾!"}, {"start": 2284.86, "end": 2286.86, "text": "丞相!"}, {"start": 2286.86, "end": 2289.86, "text": "丞相执意要死,我们绝不独生!"}, {"start": 2291.86, "end": 2292.86, "text": "说什么?"}, {"start": 2292.86, "end": 2298.29, "text": "云长是盖世英雄,"}, {"start": 2298.29, "end": 2300.29, "text": "尔等如此孤寂,"}, {"start": 2300.29, "end": 2302.29, "text": "岂不是让将军为难吗?"}, {"start": 2302.29, "end": 2307.29, "text": "丞相执意要死,我们绝不独生!"}, {"start": 2314.58, "end": 2320.3, "text": "云长,我知道你心里不想杀我,"}, {"start": 2320.3, "end": 2323.3, "text": "但是,军命不可。"}, {"start": 2323.3, "end": 2329.16, "text": "你杀我,我不怪你。"}, {"start": 2329.16, "end": 2333.16, "text": "九泉直下,寒宵相望。"}, {"start": 2333.16, "end": 2337.16, "text": "等着,与你把酒言缓。"}, {"start": 2337.16, "end": 2370.71, "text": "请用剑吧。"}, {"start": 2370.71, "end": 2373.71, "text": "父亲,你遛过军令状的。"}, {"start": 2373.71, "end": 2374.71, "text": "散开!"}, {"start": 2374.71, "end": 2378.66, "text": "快散开!"}, {"start": 2378.66, "end": 2385.82, "text": "全军散开!"}, {"start": 2385.82, "end": 2388.9, "text": "走!"}, {"start": 2388.9, "end": 2390.9, "text": "走!快上马!"}, {"start": 2462.74, "end": 2464.74, "text": "两军交战,"}, {"start": 2464.74, "end": 2466.74, "text": "各为其主。"}, {"start": 2466.74, "end": 2468.74, "text": "我走了,你怎么办?"}, {"start": 2468.74, "end": 2470.74, "text": "刘备和孔明,"}, {"start": 2470.74, "end": 2472.74, "text": "不会饶过你。"}, {"start": 2472.74, "end": 2474.74, "text": "就算他们饶过你,"}, {"start": 2474.74, "end": 2477.74, "text": "江东的周瑜和孙全,"}, {"start": 2477.74, "end": 2495.01, "text": "也不会依你。"}, {"start": 2495.01, "end": 2497.64, "text": "你费心了。"}, {"start": 2497.64, "end": 2498.64, "text": "我不能走!"}, {"start": 2498.64, "end": 2499.64, "text": "哄他走!"}, {"start": 2499.64, "end": 2503.4, "text": "诺!"}, {"start": 2503.4, "end": 2504.4, "text": "我不能走啊!"}, {"start": 2504.4, "end": 2506.4, "text": "云长!"}, {"start": 2506.4, "end": 2542.86, "text": "我们如何向军师交代啊?"}, {"start": 2542.86, "end": 2543.86, "text": "不可!"}, {"start": 2543.86, "end": 2545.86, "text": "父亲!"}, {"start": 2545.86, "end": 2551.86, "text": "面禁军师。"}, {"start": 2551.86, "end": 2552.86, "text": "将军!"}, {"start": 2552.86, "end": 2554.86, "text": "父亲!"}, {"start": 2554.86, "end": 2572.16, "text": "该回营,"}, {"start": 2572.16, "end": 2576.27, "text": "直面军师。"}, {"start": 2576.27, "end": 2578.27, "text": "下我这颗头,"}, {"start": 2578.27, "end": 2580.27, "text": "以正军法,以正军威。"}]