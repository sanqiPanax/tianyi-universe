[{"start": 1.33, "end": 2.61, "text": "朝廷已下旨"}, {"start": 3.53, "end": 5.93, "text": "周瑜 程普分别被斥封为"}, {"start": 6.21, "end": 7.93, "text": "南郡和江夏太守"}, {"start": 8.37, "end": 10.77, "text": "他们二位准备即日走马上任"}, {"start": 11.17, "end": 13.61, "text": "还请你们让出这两个郡来"}, {"start": 18.95, "end": 22.55, "text": "周瑜真的想做南郡太守"}, {"start": 22.95, "end": 23.87, "text": "不仅周瑜"}, {"start": 24.23, "end": 27.07, "text": "还有程普做江夏太守"}, {"start": 28.71, "end": 29.35, "text": "紫禁啊"}, {"start": 30.47, "end": 32.35, "text": "朝廷任命我主为荆州牧"}, {"start": 33.15, "end": 34.83, "text": "让周瑜做南郡太守"}, {"start": 35.63, "end": 37.19, "text": "这岂不成了我主的署部"}, {"start": 38.31, "end": 39.51, "text": "还有程普老将军"}, {"start": 39.95, "end": 42.07, "text": "也愿意一同势力于我主帐下吗"}, {"start": 43.19, "end": 45.63, "text": "愿意 他们都非常愿意"}, {"start": 46.23, "end": 48.07, "text": "只要你们让出这两个郡来"}, {"start": 48.51, "end": 51.15, "text": "他们都非常愿意做刘皇叔"}, {"start": 51.15, "end": 52.75, "text": "兼刘京州的部属"}, {"start": 53.35, "end": 56.31, "text": "而且是不必生死 耿耿效忠"}, {"start": 56.95, "end": 58.03, "text": "紫禁且听我言"}, {"start": 59.91, "end": 63.27, "text": "你看 咱们吃饭都用两支筷子"}, {"start": 63.83, "end": 65.07, "text": "若是拿走了一支"}, {"start": 65.67, "end": 67.83, "text": "另一支如何进饭呢"}, {"start": 68.75, "end": 70.15, "text": "孔嬴此话何意啊"}, {"start": 70.99, "end": 73.83, "text": "我们现在是在说南郡和江夏"}, {"start": 74.19, "end": 75.19, "text": "完全同理啊"}, {"start": 76.15, "end": 78.83, "text": "南郡是荆州首镇 唇齿相依"}, {"start": 79.51, "end": 81.15, "text": "无南郡 荆州不薄"}, {"start": 82.15, "end": 83.23, "text": "你拿走了南郡"}, {"start": 83.55, "end": 85.51, "text": "就等于两支筷子拿走了一支"}, {"start": 86.03, "end": 87.75, "text": "这岂不是端了我们的饭碗吗"}, {"start": 88.31, "end": 90.63, "text": "至于江夏 那更在我们的后院"}, {"start": 91.19, "end": 93.43, "text": "你想想 好端端一个家"}, {"start": 93.63, "end": 96.03, "text": "你偏要在人家后院养马驻兵"}, {"start": 96.31, "end": 98.23, "text": "这天下岂有这样的道理"}, {"start": 102.09, "end": 103.45, "text": "妙语 妙语"}, {"start": 104.21, "end": 106.17, "text": "不愧为诸葛孔嬴啊"}, {"start": 107.73, "end": 110.01, "text": "这么说 这两个郡"}, {"start": 110.73, "end": 112.37, "text": "你们是不打算撒手了"}, {"start": 113.93, "end": 118.09, "text": "恕罪 恕罪 此事万难从命"}, {"start": 120.17, "end": 123.96, "text": "不必客气 说句实话"}, {"start": 124.8, "end": 127.6, "text": "我此次前来也并没有打算"}, {"start": 127.76, "end": 129.8, "text": "真的能够把这两个郡要回去"}, {"start": 132.8, "end": 134.76, "text": "那多谢 多谢了"}, {"start": 136.12, "end": 137.72, "text": "刘皇叔也不必客气"}, {"start": 139.12, "end": 141.04, "text": "既然我们已经结成了亲家"}, {"start": 141.72, "end": 144.8, "text": "那我们再迁让你们一回也是应该的"}, {"start": 146.86, "end": 149.14, "text": "不过 皇叔"}, {"start": 150.3, "end": 153.42, "text": "接下来我们倒真要谈点正事吧"}, {"start": 156.79, "end": 159.59, "text": "莫非刚才谈的不是正事"}, {"start": 160.99, "end": 162.27, "text": "和下面的事相比"}, {"start": 163.15, "end": 165.27, "text": "刚才只不过是做了个铺垫"}, {"start": 166.95, "end": 168.35, "text": "现在也该铺完了吧"}, {"start": 169.31, "end": 171.51, "text": "紫荆 请讲正事吧"}, {"start": 173.39, "end": 175.87, "text": "两年前我家主公和皇叔有约"}, {"start": 176.87, "end": 179.99, "text": "这荆州之地是我们暂时借给你们的"}, {"start": 180.99, "end": 183.23, "text": "一旦皇叔有了其他妻身之地"}, {"start": 183.59, "end": 185.51, "text": "就应该立刻归还给我们"}, {"start": 187.42, "end": 190.58, "text": "现在朝廷已经斥封皇叔为荆州牧了"}, {"start": 191.46, "end": 192.86, "text": "我家主公的意思是"}, {"start": 193.46, "end": 196.42, "text": "还请皇叔尽快地去取其他地盘来"}, {"start": 196.86, "end": 198.3, "text": "否则这时间一长"}, {"start": 198.98, "end": 201.14, "text": "只怕是天下人真的要以为"}, {"start": 201.58, "end": 203.66, "text": "这荆州之地是皇叔的"}, {"start": 204.1, "end": 204.82, "text": "别忘了"}, {"start": 206.06, "end": 208.22, "text": "皇叔和孔明都是在借据上"}, {"start": 208.82, "end": 209.7, "text": "把我们押的"}, {"start": 212.88, "end": 213.52, "text": "紫荆啊"}, {"start": 215.24, "end": 217.24, "text": "我也想早些取得地盘"}, {"start": 217.96, "end": 219.72, "text": "还荆州也无好"}, {"start": 220.64, "end": 221.52, "text": "可现在"}, {"start": 222.0, "end": 225.0, "text": "曹操确实是兵强马壮"}, {"start": 225.4, "end": 227.24, "text": "以我眼下的实力去北伐"}, {"start": 228.4, "end": 230.04, "text": "那不是以卵击石吗"}, {"start": 231.48, "end": 233.88, "text": "我们并没有逼着皇叔以卵击石"}, {"start": 234.4, "end": 236.32, "text": "你看 这天下大着呢"}, {"start": 238.48, "end": 239.8, "text": "那紫荆的意思是"}, {"start": 242.53, "end": 243.29, "text": "孔明有言"}, {"start": 244.01, "end": 245.65, "text": "待你们取下西川之后"}, {"start": 246.05, "end": 246.89, "text": "寄还荆州"}, {"start": 247.45, "end": 249.89, "text": "那你们为何现在还不去取呢"}, {"start": 251.05, "end": 252.93, "text": "西川流章轰窥无能"}, {"start": 253.41, "end": 255.25, "text": "取西川并不难哪"}, {"start": 255.41, "end": 256.17, "text": "紫荆啊"}, {"start": 259.16, "end": 260.28, "text": "流章是无能"}, {"start": 260.64, "end": 264.12, "text": "也且不如曹操强寒"}, {"start": 264.44, "end": 268.1, "text": "可是我不能啊"}, {"start": 270.22, "end": 272.22, "text": "敢问为何呀"}, {"start": 273.5, "end": 275.42, "text": "不为何就是不"}, {"start": 275.98, "end": 284.67, "text": "皇叔怎么了"}, {"start": 285.87, "end": 289.35, "text": "莫非在下刚才言有所失"}, {"start": 289.39, "end": 305.38, "text": "你说到了我主公伤心之处"}, {"start": 306.38, "end": 308.46, "text": "那在下倒要请教了"}, {"start": 309.86, "end": 312.78, "text": "西川之主流章虽然昏窥无能"}, {"start": 313.18, "end": 315.1, "text": "却和我主一样都姓刘"}, {"start": 315.74, "end": 318.1, "text": "又都是汉室后裔天子骨肉"}, {"start": 318.42, "end": 320.1, "text": "若是兴兵去抢他的地盘"}, {"start": 320.3, "end": 321.62, "text": "如同骨肉相残"}, {"start": 321.78, "end": 323.7, "text": "我主公如何能下得了手"}, {"start": 324.02, "end": 325.1, "text": "可是不取"}, {"start": 325.82, "end": 328.98, "text": "我们便无容身之地"}, {"start": 329.42, "end": 332.18, "text": "因此就还不了荆州"}, {"start": 332.5, "end": 334.98, "text": "因此就还不了荆州"}, {"start": 335.14, "end": 336.5, "text": "对不起你家吴侯"}, {"start": 337.06, "end": 339.34, "text": "这一头是兄弟一头是亲家"}, {"start": 340.3, "end": 341.82, "text": "我主两边为难"}, {"start": 342.14, "end": 344.78, "text": "因此才泪出痛肠啊"}, {"start": 346.66, "end": 347.54, "text": "紫荆啊"}, {"start": 348.74, "end": 350.06, "text": "凡你回见吴侯"}, {"start": 350.74, "end": 352.22, "text": "勿惜一言之劳"}, {"start": 352.66, "end": 355.18, "text": "将此烦恼情结肯告吴侯"}, {"start": 355.42, "end": 358.1, "text": "请吴侯再宽容我主几时"}, {"start": 358.34, "end": 364.4, "text": "你看看你看看"}, {"start": 364.56, "end": 367.44, "text": "这南郡江夏不还于我们也就罢了"}, {"start": 368.32, "end": 371.48, "text": "连这荆州之地也不想还于我们"}, {"start": 372.28, "end": 374.64, "text": "非要让我们一让再让不可"}, {"start": 377.73, "end": 379.41, "text": "请你们门心自问"}, {"start": 380.77, "end": 382.85, "text": "这对得起我家主公吗"}, {"start": 383.25, "end": 386.09, "text": "我家主公又如何能够答应啊"}, {"start": 387.33, "end": 389.57, "text": "吴侯已亲妹聘驾皇叔"}, {"start": 389.81, "end": 390.77, "text": "安能不答应"}, {"start": 390.93, "end": 392.57, "text": "就算吴侯能够答应"}, {"start": 392.89, "end": 394.77, "text": "大都督也是绝不会答应的"}, {"start": 394.85, "end": 396.45, "text": "那么周公仅是何意"}, {"start": 397.17, "end": 398.45, "text": "大都督的意思是"}, {"start": 398.73, "end": 400.13, "text": "请你们立刻起兵"}, {"start": 400.17, "end": 401.29, "text": "去取西川"}, {"start": 403.22, "end": 403.86, "text": "也罢"}, {"start": 405.22, "end": 406.5, "text": "我们遵命便是"}, {"start": 408.74, "end": 411.14, "text": "请回禀吴侯肩报周瑜"}, {"start": 412.3, "end": 413.5, "text": "五年之内"}, {"start": 414.14, "end": 415.74, "text": "我们必取西川"}, {"start": 416.26, "end": 416.74, "text": "不"}, {"start": 417.38, "end": 418.26, "text": "不是五年"}, {"start": 418.86, "end": 420.18, "text": "是立刻起去"}, {"start": 420.7, "end": 421.3, "text": "紫荆"}, {"start": 421.66, "end": 423.14, "text": "你也是知兵之人"}, {"start": 423.5, "end": 424.82, "text": "西川千里之外"}, {"start": 424.9, "end": 426.82, "text": "取西川乃劳师远征"}, {"start": 427.1, "end": 429.14, "text": "眼下我们兵马不足"}, {"start": 429.34, "end": 430.34, "text": "粮草未备"}, {"start": 430.54, "end": 431.82, "text": "如何立刻动兵"}, {"start": 432.06, "end": 432.66, "text": "准备"}, {"start": 432.7, "end": 434.18, "text": "也得准备个三五年吧"}, {"start": 436.39, "end": 437.67, "text": "你们兵马未备"}, {"start": 437.71, "end": 438.71, "text": "粮草不足"}, {"start": 439.55, "end": 441.31, "text": "我们可是兵强马壮"}, {"start": 441.35, "end": 442.39, "text": "粮草充备"}, {"start": 443.39, "end": 444.75, "text": "你们不去取西川"}, {"start": 445.15, "end": 446.79, "text": "我们可以替你们去取"}, {"start": 447.35, "end": 448.95, "text": "待我们取下西川之后"}, {"start": 449.03, "end": 450.19, "text": "用西川之地"}, {"start": 450.43, "end": 452.31, "text": "换回我们的荆襄九军"}, {"start": 453.59, "end": 454.15, "text": "这下"}, {"start": 465.05, "end": 465.77, "text": "好"}, {"start": 468.46, "end": 469.66, "text": "那就祝公仅"}, {"start": 470.86, "end": 472.42, "text": "马到成功"}, {"start": 487.1, "end": 488.02, "text": "那周瑜"}, {"start": 488.22, "end": 489.58, "text": "若攻取西川"}, {"start": 490.82, "end": 491.66, "text": "那刘璋"}, {"start": 491.7, "end": 493.9, "text": "断断不是江东精兵的对手"}, {"start": 495.3, "end": 496.34, "text": "主公无忧"}, {"start": 497.3, "end": 498.42, "text": "我料周瑜"}, {"start": 498.46, "end": 499.98, "text": "不会攻取西川的"}, {"start": 500.7, "end": 502.3, "text": "他只是以此为辞"}, {"start": 502.94, "end": 504.94, "text": "要逼我们归还荆州"}, {"start": 512.25, "end": 513.45, "text": "龙中队时"}, {"start": 513.57, "end": 514.49, "text": "曾提到"}, {"start": 515.25, "end": 516.21, "text": "西川"}, {"start": 516.85, "end": 518.53, "text": "是我们必取之地"}, {"start": 519.69, "end": 520.53, "text": "周瑜"}, {"start": 520.69, "end": 522.09, "text": "若要抢先攻战"}, {"start": 522.73, "end": 523.97, "text": "与我们也不利"}, {"start": 524.73, "end": 525.61, "text": "攻取西川"}, {"start": 525.61, "end": 527.21, "text": "咱必要大动干戈"}, {"start": 527.61, "end": 530.01, "text": "兵马前两所好甚甚惧"}, {"start": 530.93, "end": 532.25, "text": "以我们现在之力"}, {"start": 532.29, "end": 533.61, "text": "尚无法攻取"}, {"start": 534.85, "end": 536.29, "text": "如果周瑜要取"}, {"start": 536.93, "end": 539.09, "text": "江东便会元气大伤"}, {"start": 540.37, "end": 541.69, "text": "我们做官成败"}, {"start": 541.73, "end": 543.29, "text": "相机行事便是"}, {"start": 544.13, "end": 544.93, "text": "此外"}, {"start": 545.25, "end": 546.73, "text": "我仍相信取西川"}, {"start": 546.77, "end": 548.69, "text": "只是鲁素一句动荷之词"}, {"start": 549.89, "end": 551.45, "text": "孙权生性谨慎"}, {"start": 551.73, "end": 553.09, "text": "绝不会同意周瑜"}, {"start": 553.13, "end": 554.41, "text": "耗尽江东之力"}, {"start": 554.45, "end": 555.57, "text": "而取西川的"}, {"start": 558.9, "end": 559.9, "text": "但愿如此吧"}, {"start": 568.49, "end": 570.17, "text": "周国亮果然说是"}, {"start": 570.37, "end": 571.45, "text": "兵马未备"}, {"start": 571.49, "end": 572.53, "text": "粮草不足"}, {"start": 573.73, "end": 574.97, "text": "他还推托说"}, {"start": 575.45, "end": 577.61, "text": "五年以后再取西川"}, {"start": 578.45, "end": 579.13, "text": "我按照咱们"}, {"start": 579.17, "end": 581.05, "text": "事先准备的话回答了他们"}, {"start": 581.49, "end": 583.29, "text": "他们果然是无话可说"}, {"start": 595.76, "end": 596.48, "text": "刘备这思"}, {"start": 596.52, "end": 598.16, "text": "比我料想得更虚伪"}, {"start": 600.6, "end": 601.92, "text": "他竟然说什么"}, {"start": 603.0, "end": 604.56, "text": "与刘璋同为皇亲"}, {"start": 604.6, "end": 605.68, "text": "不忍下手"}, {"start": 612.44, "end": 613.28, "text": "龚瑾"}, {"start": 614.92, "end": 617.44, "text": "兴兵取西川是一桩大举"}, {"start": 618.32, "end": 619.8, "text": "主公会答应吗"}, {"start": 620.48, "end": 622.04, "text": "你估计主公会答应吗"}, {"start": 623.56, "end": 624.36, "text": "我想"}, {"start": 624.76, "end": 627.64, "text": "主公必定会是三思而后行"}, {"start": 627.68, "end": 628.88, "text": "那我就告诉你吧"}, {"start": 630.79, "end": 632.15, "text": "主公已经同意了"}, {"start": 633.85, "end": 634.53, "text": "当真"}, {"start": 642.87, "end": 644.79, "text": "就在你与刘备相会的时候"}, {"start": 645.23, "end": 647.63, "text": "成普 黄丐 韩当等四位老将"}, {"start": 648.71, "end": 649.91, "text": "领着徐胜 丁凤"}, {"start": 649.95, "end": 651.51, "text": "吕蒙等八位青年将军"}, {"start": 651.55, "end": 652.59, "text": "一起向主公请命"}, {"start": 652.63, "end": 653.87, "text": "要求攻取荆州"}, {"start": 653.91, "end": 660.66, "text": "主公当场同意了我的方律"}, {"start": 663.44, "end": 666.95, "text": "江东主将倾巢而出"}, {"start": 666.99, "end": 669.11, "text": "这几乎是在兵间了"}, {"start": 673.1, "end": 673.82, "text": "大都多"}, {"start": 678.14, "end": 679.1, "text": "既然如此"}, {"start": 679.46, "end": 680.5, "text": "我当奉命"}, {"start": 681.38, "end": 682.38, "text": "从今日起"}, {"start": 682.62, "end": 684.46, "text": "我会全力以赴支持你"}, {"start": 685.38, "end": 686.38, "text": "反你所命"}, {"start": 686.66, "end": 687.62, "text": "无有不从"}, {"start": 689.1, "end": 689.9, "text": "好"}, {"start": 693.51, "end": 694.87, "text": "江东差人送来书信呢"}, {"start": 694.91, "end": 696.39, "text": "是 已呈上主公了"}, {"start": 711.87, "end": 712.47, "text": "主公"}, {"start": 718.96, "end": 719.68, "text": "看看吧"}, {"start": 724.67, "end": 725.99, "text": "孙权已经下令"}, {"start": 726.19, "end": 727.51, "text": "拜成普为主将"}, {"start": 727.99, "end": 730.27, "text": "率军三万攻取西川"}, {"start": 730.75, "end": 732.31, "text": "甚至连起兵日期"}, {"start": 732.35, "end": 734.23, "text": "进军路线都通知我们了"}, {"start": 735.79, "end": 737.27, "text": "周瑜果然不凡"}, {"start": 738.51, "end": 740.15, "text": "此事都让他给办成了"}, {"start": 740.19, "end": 741.63, "text": "前军主将吕蒙"}, {"start": 741.67, "end": 743.07, "text": "率军一万西进"}, {"start": 743.51, "end": 745.31, "text": "成普率大军随后"}, {"start": 745.35, "end": 747.11, "text": "半年之内攻去西川"}, {"start": 747.43, "end": 749.07, "text": "然后以属中之地"}, {"start": 749.11, "end": 750.51, "text": "换取荆州九军"}, {"start": 751.15, "end": 751.91, "text": "孔明"}, {"start": 752.99, "end": 754.15, "text": "西川刘章"}, {"start": 754.19, "end": 755.75, "text": "绝不是江东兵马的敌手"}, {"start": 755.79, "end": 757.63, "text": "西川必失啊"}, {"start": 759.51, "end": 760.91, "text": "情况可能会更糟"}, {"start": 761.15, "end": 762.79, "text": "如果东吴取下西川"}, {"start": 762.83, "end": 764.79, "text": "那便拥有了天下两大种"}, {"start": 764.83, "end": 767.07, "text": "东面是江东八十一线"}, {"start": 767.11, "end": 768.99, "text": "西面是西川五十一郡"}, {"start": 769.03, "end": 770.79, "text": "而我们荆州对他们来说"}, {"start": 770.83, "end": 771.95, "text": "犹如耿鼓在喉"}, {"start": 771.99, "end": 773.07, "text": "早晚除之"}, {"start": 773.11, "end": 780.82, "text": "孔玉有远见哪"}, {"start": 781.58, "end": 783.7, "text": "此人已看到五年之后"}, {"start": 783.74, "end": 785.58, "text": "甚至十年之后"}, {"start": 786.34, "end": 788.3, "text": "他已经不急于取荆州"}, {"start": 789.58, "end": 792.42, "text": "而是想得到有力的战略地位"}, {"start": 793.58, "end": 796.34, "text": "他已经不在乎一城一地"}, {"start": 796.42, "end": 798.14, "text": "而是想取天下"}, {"start": 798.54, "end": 799.98, "text": "治德天下"}, {"start": 800.02, "end": 803.64, "text": "何犹荆州呢"}, {"start": 803.68, "end": 804.8, "text": "我们当初"}, {"start": 804.84, "end": 807.0, "text": "真不该同意他们去西川"}, {"start": 808.12, "end": 809.72, "text": "现在如何是好"}, {"start": 810.48, "end": 824.9, "text": "请容我三思"}, {"start": 824.94, "end": 825.74, "text": "主公"}, {"start": 826.62, "end": 827.38, "text": "主公"}, {"start": 828.06, "end": 828.7, "text": "你看"}, {"start": 829.14, "end": 830.78, "text": "周瑜还是那个周瑜"}, {"start": 830.82, "end": 832.26, "text": "他不会去西川的"}, {"start": 832.3, "end": 835.1, "text": "这只是他的假图灭国之计"}, {"start": 835.14, "end": 836.02, "text": "你看"}, {"start": 836.06, "end": 837.78, "text": "这信上写得清清楚楚"}, {"start": 838.34, "end": 840.22, "text": "江东西征大军"}, {"start": 840.22, "end": 843.02, "text": "须从荆乡境内借盗而过"}, {"start": 843.06, "end": 848.6, "text": "难道他们是要攻打荆州吗"}, {"start": 851.14, "end": 852.18, "text": "果然啊"}, {"start": 853.46, "end": 855.26, "text": "真是阴险狡诈"}, {"start": 855.3, "end": 858.02, "text": "借取西川之名借盗荆州"}, {"start": 858.06, "end": 859.62, "text": "我们又不能说不进"}, {"start": 859.66, "end": 861.22, "text": "可一旦借盗于他"}, {"start": 861.26, "end": 862.58, "text": "那就等于是开门一道"}, {"start": 862.62, "end": 864.18, "text": "开称赢敌呀"}, {"start": 864.22, "end": 865.74, "text": "我们只能这样了"}, {"start": 865.78, "end": 867.58, "text": "多派少级查探"}, {"start": 867.62, "end": 870.14, "text": "如果东吴氏派成德谋攻打西川"}, {"start": 870.18, "end": 871.26, "text": "我们就供他粮草"}, {"start": 871.3, "end": 872.58, "text": "助他袭击"}, {"start": 872.62, "end": 874.5, "text": "若统兵上将不是成德谋"}, {"start": 874.54, "end": 875.98, "text": "而是周公瑾"}, {"start": 876.02, "end": 878.3, "text": "就证明他们的目的不是西川"}, {"start": 878.34, "end": 879.86, "text": "而是荆州"}, {"start": 879.9, "end": 881.38, "text": "我们就要迎战"}, {"start": 881.42, "end": 883.74, "text": "而且是一场决战"}, {"start": 883.78, "end": 892.04, "text": "此征兮"}, {"start": 892.76, "end": 894.6, "text": "有精兵三万人"}, {"start": 894.64, "end": 896.96, "text": "而且都是能征贯战的近族"}, {"start": 898.0, "end": 900.08, "text": "我们虽然好成十万兵马"}, {"start": 900.12, "end": 901.72, "text": "其实只有五万"}, {"start": 902.64, "end": 904.56, "text": "且都是新兵"}, {"start": 904.6, "end": 907.04, "text": "恐怕不是他的对手吧"}, {"start": 907.08, "end": 908.88, "text": "仅凭三万人马"}, {"start": 908.92, "end": 910.6, "text": "断断取不下西川"}, {"start": 910.64, "end": 912.08, "text": "也取不下荆州"}, {"start": 912.92, "end": 914.6, "text": "如果我猜得不错"}, {"start": 914.64, "end": 916.92, "text": "周瑜不该只带这些人"}, {"start": 916.96, "end": 918.96, "text": "起码要五万"}, {"start": 919.0, "end": 921.31, "text": "五万"}, {"start": 921.35, "end": 923.79, "text": "那我们更加无法预知匹敌了"}, {"start": 923.83, "end": 925.55, "text": "主公莫急"}, {"start": 925.59, "end": 928.99, "text": "主公知道我们有多少人马"}, {"start": 929.03, "end": 930.79, "text": "不是五万人马吗"}, {"start": 931.95, "end": 934.55, "text": "那只是荆乡各郡的人马"}, {"start": 934.59, "end": 937.11, "text": "实际上我们有八万"}, {"start": 937.15, "end": 939.92, "text": "怎么这么多"}, {"start": 939.96, "end": 940.84, "text": "这其中"}, {"start": 940.88, "end": 943.08, "text": "有攻取南部四郡所搭的兵马"}, {"start": 943.12, "end": 944.68, "text": "还有荆州刘表的旧部"}, {"start": 944.72, "end": 946.08, "text": "和新增的士族"}, {"start": 946.76, "end": 948.0, "text": "我不想让曹操和孙全"}, {"start": 948.04, "end": 949.36, "text": "知道我们的底细"}, {"start": 949.4, "end": 951.64, "text": "所以一直瞒着所有人"}, {"start": 951.68, "end": 953.44, "text": "包括主公"}, {"start": 953.48, "end": 955.16, "text": "请主公恕罪"}, {"start": 955.2, "end": 958.06, "text": "公平无罪"}, {"start": 958.1, "end": 960.5, "text": "善战先要善藏兵"}, {"start": 960.54, "end": 963.89, "text": "这样才能出其不意嘛"}, {"start": 963.93, "end": 964.93, "text": "只是"}, {"start": 966.57, "end": 969.33, "text": "周瑜也是当世名将"}, {"start": 969.37, "end": 970.29, "text": "与之交手"}, {"start": 971.77, "end": 973.01, "text": "你有几分把握"}, {"start": 973.89, "end": 975.61, "text": "周瑜长途跋涉"}, {"start": 975.65, "end": 976.93, "text": "我们以义代劳"}, {"start": 976.97, "end": 978.93, "text": "战警天时地利"}, {"start": 978.97, "end": 979.89, "text": "这一仗"}, {"start": 979.93, "end": 988.22, "text": "我军的胜算有九成"}, {"start": 988.26, "end": 989.94, "text": "眼下"}, {"start": 989.98, "end": 992.38, "text": "我们主要的敌人还是草草"}, {"start": 993.9, "end": 995.78, "text": "要真的与周瑜打起来"}, {"start": 997.18, "end": 1001.8, "text": "那孙刘联盟就彻底破裂了"}, {"start": 1001.84, "end": 1004.0, "text": "凡事都有利弊"}, {"start": 1004.04, "end": 1005.44, "text": "战端一开"}, {"start": 1005.48, "end": 1006.76, "text": "江东和我的力量"}, {"start": 1006.8, "end": 1008.56, "text": "都会遭到削弱"}, {"start": 1008.6, "end": 1009.88, "text": "但是另一方面"}, {"start": 1009.92, "end": 1012.08, "text": "只要这场仗我们打赢了"}, {"start": 1012.12, "end": 1013.56, "text": "周瑜等于我们围敌的势力"}, {"start": 1013.56, "end": 1015.52, "text": "就会被彻底打垮"}, {"start": 1015.56, "end": 1016.8, "text": "孙权也因此削除了"}, {"start": 1016.84, "end": 1018.12, "text": "掣肘的力量"}, {"start": 1018.16, "end": 1020.36, "text": "就不能加强我们的联盟"}, {"start": 1020.4, "end": 1021.48, "text": "荆州"}, {"start": 1021.52, "end": 1023.8, "text": "也会得到很长一段时间的安宁"}, {"start": 1023.84, "end": 1034.34, "text": "若他真来反"}, {"start": 1034.38, "end": 1038.67, "text": "只有拼死一战了"}, {"start": 1038.71, "end": 1040.19, "text": "请主公亲自回韩"}, {"start": 1040.23, "end": 1041.55, "text": "告诉孙权"}, {"start": 1041.59, "end": 1042.83, "text": "我们同意他们"}, {"start": 1042.87, "end": 1044.15, "text": "借荆乡"}, {"start": 1044.19, "end": 1071.62, "text": "取西川"}, {"start": 1071.66, "end": 1074.59, "text": "车架已经备好了"}, {"start": 1074.63, "end": 1077.42, "text": "车架"}, {"start": 1077.46, "end": 1080.1, "text": "我身为将军"}, {"start": 1080.14, "end": 1081.34, "text": "你看见过躺在车里"}, {"start": 1081.38, "end": 1085.96, "text": "率军出征的将军吗"}, {"start": 1086.0, "end": 1088.33, "text": "千万来"}, {"start": 1088.33, "end": 1094.28, "text": "去"}, {"start": 1094.32, "end": 1096.0, "text": "去签大都督做计"}, {"start": 1096.04, "end": 1209.8, "text": "大都督请看"}, {"start": 1209.84, "end": 1211.92, "text": "前方便是荆州了"}, {"start": 1211.96, "end": 1214.28, "text": "他们可有防备"}, {"start": 1214.32, "end": 1215.8, "text": "他们来人传话说"}, {"start": 1215.84, "end": 1217.64, "text": "已经遵命备好茶饭"}, {"start": 1217.68, "end": 1219.96, "text": "供我们过路取用"}, {"start": 1220.0, "end": 1224.66, "text": "传我将令"}, {"start": 1224.7, "end": 1225.7, "text": "拿下荆州"}, {"start": 1225.74, "end": 1397.99, "text": "现在刘备大军"}, {"start": 1398.03, "end": 1409.38, "text": "已经将我军四面围住"}, {"start": 1409.42, "end": 1415.62, "text": "大都督"}, {"start": 1415.66, "end": 1417.26, "text": "刘备他们并没有攻上来"}, {"start": 1417.3, "end": 1431.43, "text": "粮好饿死我们呢"}, {"start": 1431.47, "end": 1438.67, "text": "粮食还能撑多久"}, {"start": 1438.71, "end": 1441.87, "text": "我们两道被截断了"}, {"start": 1441.91, "end": 1442.87, "text": "均中存粮"}, {"start": 1442.91, "end": 1473.04, "text": "黄州鱼"}, {"start": 1473.08, "end": 1474.84, "text": "刘备君送来信函"}, {"start": 1474.88, "end": 1481.3, "text": "是劝降书吗"}, {"start": 1481.34, "end": 1483.14, "text": "来使说是诸葛亮"}, {"start": 1483.18, "end": 1484.46, "text": "写给大都督的信"}, {"start": 1484.5, "end": 1498.34, "text": "金吾兄如物"}, {"start": 1498.38, "end": 1499.82, "text": "西者凶来函"}, {"start": 1499.86, "end": 1501.86, "text": "告以假盗伐蜀"}, {"start": 1501.9, "end": 1503.3, "text": "以蜀易经之事"}, {"start": 1503.34, "end": 1504.9, "text": "亮不胜感激"}, {"start": 1504.94, "end": 1506.1, "text": "以备好粮草"}, {"start": 1506.14, "end": 1507.5, "text": "随时候调"}, {"start": 1507.54, "end": 1508.1, "text": "不料"}, {"start": 1508.14, "end": 1510.94, "text": "金足下竟引大军攻我荆州"}, {"start": 1510.98, "end": 1512.42, "text": "如此背心弃意"}, {"start": 1512.46, "end": 1514.22, "text": "令亮不知所意"}, {"start": 1514.26, "end": 1515.5, "text": "自黄金乱起"}, {"start": 1515.54, "end": 1516.94, "text": "汉氏轻畏"}, {"start": 1516.98, "end": 1519.14, "text": "曹操内挟天子义自重"}, {"start": 1519.18, "end": 1521.02, "text": "外灵诸侯义自威"}, {"start": 1521.06, "end": 1523.1, "text": "江东义身受其害"}, {"start": 1523.14, "end": 1524.7, "text": "权赖孙刘携手"}, {"start": 1524.74, "end": 1526.38, "text": "放有赤壁大劫"}, {"start": 1526.42, "end": 1529.42, "text": "使义兆生灵免遭涂炭"}, {"start": 1529.46, "end": 1530.74, "text": "曹操雄居中原"}, {"start": 1530.78, "end": 1532.3, "text": "为天下之祸"}, {"start": 1532.34, "end": 1534.46, "text": "孙刘两家唯有同舟共济"}, {"start": 1534.5, "end": 1536.42, "text": "方能御子强敌于北"}, {"start": 1536.46, "end": 1538.06, "text": "和则两立"}, {"start": 1538.1, "end": 1539.82, "text": "分则两败"}, {"start": 1539.86, "end": 1540.86, "text": "今日之战"}, {"start": 1540.9, "end": 1542.18, "text": "我主实为自保"}, {"start": 1542.22, "end": 1543.86, "text": "情非所愿"}, {"start": 1543.9, "end": 1544.94, "text": "为事友好"}, {"start": 1544.94, "end": 1545.82, "text": "以令三军"}, {"start": 1545.86, "end": 1547.38, "text": "敞开东南一去"}, {"start": 1547.42, "end": 1549.78, "text": "攻紧自可引所不东归"}, {"start": 1549.82, "end": 1551.62, "text": "我军绝不袭扰"}, {"start": 1551.66, "end": 1553.98, "text": "此战所获之贵军人马资重"}, {"start": 1554.02, "end": 1555.74, "text": "义一并奉还"}, {"start": 1555.78, "end": 1558.1, "text": "望兄能就此捐弃前嫌"}, {"start": 1558.14, "end": 1559.58, "text": "永修蒙好"}, {"start": 1559.62, "end": 1561.22, "text": "勿再同事操割"}, {"start": 1561.26, "end": 1563.82, "text": "使曹贼逞夺作篡逆之志"}, {"start": 1563.86, "end": 1566.38, "text": "百姓断汉氏复兴之孽"}, {"start": 1566.42, "end": 1567.62, "text": "万望"}, {"start": 1567.66, "end": 1569.82, "text": "敌量百寇百上"}, {"start": 1573.96, "end": 1576.2, "text": "葛亮这是在假慈悲"}, {"start": 1576.24, "end": 1578.72, "text": "我们绝对不能领他这个情"}, {"start": 1578.72, "end": 1580.56, "text": "我军还有三万多人马"}, {"start": 1581.72, "end": 1583.12, "text": "下令吧"}, {"start": 1583.16, "end": 1585.52, "text": "我正就率军和他们决一死战"}, {"start": 1602.71, "end": 1605.31, "text": "东吴留下这些士兵吧"}, {"start": 1605.35, "end": 1606.39, "text": "大都督"}, {"start": 1606.43, "end": 1612.93, "text": "东南小道"}, {"start": 1641.38, "end": 1642.26, "text": "吕将军"}, {"start": 1642.3, "end": 1643.54, "text": "大都督让停下来"}, {"start": 1643.58, "end": 1651.83, "text": "停"}, {"start": 1651.87, "end": 1652.67, "text": "大都督"}, {"start": 1652.71, "end": 1653.83, "text": "有何吩咐"}, {"start": 1654.47, "end": 1656.07, "text": "扶我下来"}, {"start": 1656.79, "end": 1687.06, "text": "我想望一眼荆州"}, {"start": 1687.1, "end": 1688.06, "text": "都督"}, {"start": 1688.86, "end": 1689.66, "text": "大都督"}, {"start": 1689.7, "end": 1719.76, "text": "是最后一次失败"}, {"start": 1719.8, "end": 1755.69, "text": "我见不到东吴"}, {"start": 1769.26, "end": 1770.34, "text": "大都督"}, {"start": 1770.42, "end": 1861.38, "text": "吴副将军临走时"}, {"start": 1864.39, "end": 1866.75, "text": "我辅佐主公"}, {"start": 1866.79, "end": 1868.55, "text": "保住江东"}, {"start": 1869.59, "end": 1873.28, "text": "不想才十年光景"}, {"start": 1873.32, "end": 1876.76, "text": "我就不能再为主公效力了"}, {"start": 1877.64, "end": 1880.16, "text": "公瑾"}, {"start": 1880.2, "end": 1882.44, "text": "千万别这样说"}, {"start": 1882.48, "end": 1884.0, "text": "你会好起来的"}, {"start": 1894.52, "end": 1904.74, "text": "这次"}, {"start": 1904.78, "end": 1906.3, "text": "周瑜我"}, {"start": 1906.34, "end": 1907.86, "text": "多有无凡"}, {"start": 1907.9, "end": 1914.64, "text": "不会记恨我吧"}, {"start": 1914.68, "end": 1916.52, "text": "公瑾切莫说这样的话"}, {"start": 1916.56, "end": 1919.54, "text": "不知助我"}, {"start": 1919.54, "end": 1931.24, "text": "不得已而为之"}, {"start": 1931.28, "end": 1937.77, "text": "江东的老家"}, {"start": 1937.81, "end": 1943.75, "text": "都曾追随过老国将军再一走"}, {"start": 1943.79, "end": 1945.55, "text": "留下寡母佑敌"}, {"start": 1949.69, "end": 1959.19, "text": "也有一个权威"}, {"start": 1959.23, "end": 1963.12, "text": "为了稳住局面"}, {"start": 1963.16, "end": 1967.38, "text": "我只好霸道行事"}, {"start": 1967.42, "end": 1987.9, "text": "你震慑主之人"}, {"start": 1987.94, "end": 2001.3, "text": "知道这是犯气的事"}, {"start": 2001.34, "end": 2004.5, "text": "都是因为我知道"}, {"start": 2004.54, "end": 2010.5, "text": "主公你是个有牙粮的人"}, {"start": 2010.54, "end": 2016.42, "text": "公瑾"}, {"start": 2016.46, "end": 2025.24, "text": "我全都明白"}, {"start": 2025.28, "end": 2028.08, "text": "江东"}, {"start": 2028.12, "end": 2032.47, "text": "虽然已经根基牢固"}, {"start": 2032.47, "end": 2034.79, "text": "毕竟是偏狭之地"}, {"start": 2035.91, "end": 2037.79, "text": "刘备"}, {"start": 2037.83, "end": 2039.15, "text": "曹操"}, {"start": 2042.1, "end": 2046.58, "text": "是几百年才出一个的小熊"}, {"start": 2046.62, "end": 2048.22, "text": "半虎而生"}, {"start": 2048.26, "end": 2058.46, "text": "千万不能有丝毫的血"}, {"start": 2058.5, "end": 2062.27, "text": "公瑾之言"}, {"start": 2062.31, "end": 2076.85, "text": "我一定牢记于心"}, {"start": 2076.89, "end": 2100.16, "text": "公瑾"}, {"start": 2100.2, "end": 2101.32, "text": "你若有策"}, {"start": 2101.36, "end": 2116.63, "text": "也能继人大"}, {"start": 2116.67, "end": 2124.9, "text": "圣与我为江东主事"}, {"start": 2124.94, "end": 2160.11, "text": "公瑾放心"}, {"start": 2161.39, "end": 2163.39, "text": "我一定请紫禁长兵"}, {"start": 2163.43, "end": 2183.26, "text": "稷儿"}, {"start": 2183.3, "end": 2187.0, "text": "可惜"}, {"start": 2187.04, "end": 2189.4, "text": "可惜什么"}, {"start": 2189.44, "end": 2190.72, "text": "公瑾"}, {"start": 2190.76, "end": 2192.2, "text": "还有什么要交代的"}, {"start": 2208.59, "end": 2210.27, "text": "圣鱼"}, {"start": 2214.66, "end": 2217.02, "text": "何圣梁"}, {"start": 2228.77, "end": 2229.73, "text": "公瑾"}, {"start": 2248.74, "end": 2250.7, "text": "何圣梁"}, {"start": 2251.94, "end": 2254.02, "text": "稷圣鱼"}, {"start": 2254.06, "end": 2274.42, "text": "何圣"}, {"start": 2274.46, "end": 2276.26, "text": "名将周瑜"}, {"start": 2276.3, "end": 2279.3, "text": "壮志为仇身先死"}, {"start": 2279.3, "end": 2282.02, "text": "年仅三十六岁"}, {"start": 2303.47, "end": 2304.07, "text": "什么事啊"}, {"start": 2304.11, "end": 2305.15, "text": "这么慌慌张张的"}, {"start": 2305.19, "end": 2306.15, "text": "主公他"}, {"start": 2306.19, "end": 2317.71, "text": "主公"}, {"start": 2317.75, "end": 2320.62, "text": "紫禁"}, {"start": 2320.66, "end": 2343.42, "text": "公瑾走了"}, {"start": 2343.46, "end": 2345.26, "text": "我也希望"}, {"start": 2345.3, "end": 2346.9, "text": "公瑾是诈死"}, {"start": 2346.94, "end": 2352.93, "text": "真没想到"}, {"start": 2352.97, "end": 2354.73, "text": "一代名将"}, {"start": 2354.77, "end": 2362.79, "text": "就这么走"}, {"start": 2362.83, "end": 2366.78, "text": "天哪"}, {"start": 2366.82, "end": 2371.5, "text": "上苍无道"}, {"start": 2371.54, "end": 2378.04, "text": "未尽其才呀"}, {"start": 2378.08, "end": 2382.47, "text": "公瑾定然是"}, {"start": 2382.51, "end": 2388.81, "text": "无心甘啊"}, {"start": 2388.85, "end": 2389.77, "text": "你说的是"}, {"start": 2394.54, "end": 2396.02, "text": "是自己"}, {"start": 2396.06, "end": 2411.28, "text": "毙死了自己"}, {"start": 2411.32, "end": 2413.0, "text": "临终前"}, {"start": 2413.04, "end": 2414.32, "text": "公瑾"}, {"start": 2414.36, "end": 2421.18, "text": "向我保取了大都督一职"}, {"start": 2421.22, "end": 2423.42, "text": "我来"}, {"start": 2423.46, "end": 2425.02, "text": "是想听听你的看法"}, {"start": 2425.06, "end": 2440.88, "text": "不知公瑾"}, {"start": 2440.92, "end": 2444.04, "text": "聚见何人啊"}, {"start": 2444.08, "end": 2445.0, "text": "你"}]