[{"start": 5.49, "end": 12.49, "text": "恕在下直言,主公不是为了就讨这杯茶水吧。"}, {"start": 12.49, "end": 26.0, "text": "我是来问你蜀中该往何处去。"}, {"start": 26.0, "end": 37.94, "text": "在下恳请主公早登大典,成绩寒作。"}, {"start": 37.94, "end": 74.46, "text": "愿我请起大海得浅波,更兼入蜀未久。"}, {"start": 74.46, "end": 78.46, "text": "还没来得及向蜀中父老施恩呢。"}, {"start": 78.46, "end": 85.99, "text": "我急于自立,那岂不是为蜀甘林先求雨露。"}, {"start": 85.99, "end": 94.17, "text": "在下觉得恰恰相反,正是因为主公入蜀不久,"}, {"start": 94.17, "end": 102.17, "text": "对臣民百姓恩惠不多,才更应该早日登基呀。"}, {"start": 103.17, "end": 104.17, "text": "此话怎讲?"}, {"start": 104.17, "end": 113.12, "text": "只有天子才能有更多的恩惠给予百姓。"}, {"start": 113.12, "end": 120.12, "text": "主公若是称王,蜀中才俊不过作个将军主部。"}, {"start": 120.12, "end": 128.12, "text": "只有主公成绩了大统,他们才得以封侯尽绝呀。"}, {"start": 128.12, "end": 136.7, "text": "王是一口井,而天子则是一口深井啊。"}, {"start": 136.7, "end": 143.7, "text": "臣民百姓谁不愿意围着深井,得到源源不断的恩惠。"}, {"start": 143.7, "end": 161.72, "text": "你这话让我茅塞顿开。"}, {"start": 161.72, "end": 171.3, "text": "既然你都这么说了,我就放心了。"}, {"start": 171.3, "end": 177.77, "text": "虽有些勉为其难,但也责无旁贷。"}, {"start": 177.77, "end": 189.07, "text": "礼言听令,我拜你为蜀郡太守,"}, {"start": 189.07, "end": 193.07, "text": "相助孔明,共掌川蜀政要。"}, {"start": 193.07, "end": 196.07, "text": "在下谢恩。"}, {"start": 196.07, "end": 212.27, "text": "建安,二十六年四月明午。"}, {"start": 212.27, "end": 219.27, "text": "皇帝被诏告于皇天后土。"}, {"start": 219.27, "end": 224.27, "text": "汉有天下,隶属无疆。"}, {"start": 224.27, "end": 228.27, "text": "逆贼曹匹,串汉弑君。"}, {"start": 228.27, "end": 234.27, "text": "窃拒神器,被身为皇室后裔。"}, {"start": 234.27, "end": 241.27, "text": "既告皇宗列祖,天命不可不从。"}, {"start": 241.27, "end": 245.27, "text": "皇业不可崩带。"}, {"start": 245.27, "end": 249.27, "text": "四海不可无主。"}, {"start": 249.27, "end": 254.27, "text": "被应天意,顺民心。"}, {"start": 254.27, "end": 258.27, "text": "守皇帝喜寿。"}, {"start": 258.27, "end": 264.27, "text": "虎临四海,为神享坐于汉家。"}, {"start": 264.27, "end": 267.27, "text": "四海宾服。"}, {"start": 267.27, "end": 277.92, "text": "建安,二十六年四月。"}, {"start": 277.92, "end": 280.92, "text": "刘备开元即位。"}, {"start": 280.92, "end": 283.92, "text": "正式建立蜀国。"}, {"start": 283.92, "end": 287.92, "text": "吾皇万岁万岁万万岁。"}, {"start": 287.92, "end": 292.92, "text": "今阵,发布天子第一诏。"}, {"start": 292.92, "end": 298.52, "text": "择日,攻伐东吾。"}, {"start": 298.52, "end": 324.08, "text": "你是来金剑的吧?"}, {"start": 324.08, "end": 325.08, "text": "是。"}, {"start": 325.08, "end": 327.58, "text": "说吧。"}, {"start": 327.58, "end": 333.08, "text": "陛下恕我直言。"}, {"start": 333.08, "end": 337.08, "text": "眼下国贼乃是曹匹,不是孙全。"}, {"start": 337.08, "end": 341.08, "text": "倘若陛下一定要舍位伐吾。"}, {"start": 341.08, "end": 345.08, "text": "这大战已开,曹匹必将是成奸取裂。"}, {"start": 345.08, "end": 350.08, "text": "孙全杀害云长,偷取荆州。"}, {"start": 350.08, "end": 356.08, "text": "是我死地,我与他誓不良。"}, {"start": 356.08, "end": 365.42, "text": "陛下,汉贼之仇,公也,兄弟之仇。"}, {"start": 365.42, "end": 370.42, "text": "司也,陛下现在既然已登皇位,"}, {"start": 370.42, "end": 372.42, "text": "就应该以天下为重啊。"}, {"start": 372.42, "end": 386.32, "text": "我跟你说句心里话,"}, {"start": 386.32, "end": 391.78, "text": "虽然我成绩了地位,"}, {"start": 391.78, "end": 397.96, "text": "但若不能为帝报仇雪恨,"}, {"start": 397.96, "end": 401.96, "text": "纵有万圣之尊,又有何用呢?"}, {"start": 401.96, "end": 407.96, "text": "我心意已决,赵命也已经下了。"}, {"start": 407.96, "end": 414.96, "text": "此事不但三军节制,数日后也会传扬海内。"}, {"start": 414.96, "end": 419.96, "text": "你难道想让我自食其言吗?"}, {"start": 419.96, "end": 425.33, "text": "为帝者,当然不能自食其言,"}, {"start": 425.33, "end": 427.33, "text": "但可以暂缓。"}, {"start": 427.33, "end": 429.33, "text": "臣赞同子龙将军的意见,"}, {"start": 429.33, "end": 433.33, "text": "盼陛下暂缓队无发兵。"}, {"start": 433.33, "end": 444.56, "text": "陛下,臣有四意,请陛下三思。"}, {"start": 444.56, "end": 448.56, "text": "一者,蜀汉大地仍是草位,而非东吴。"}, {"start": 448.56, "end": 453.56, "text": "二者,如果我们占据荆州,那么尽可攻退可守。"}, {"start": 453.56, "end": 456.56, "text": "而眼下,荆州已落了孙全之手,"}, {"start": 456.56, "end": 460.56, "text": "江东反而占据天下之父,中原根据。"}, {"start": 460.56, "end": 464.56, "text": "三者,从川蜀起兵伐吴,条条两千里,"}, {"start": 464.56, "end": 467.56, "text": "其间更有山川县阁,江湖水路,"}, {"start": 467.56, "end": 470.56, "text": "粮草军械运输极为不便。"}, {"start": 470.56, "end": 473.56, "text": "四者,蜀吴一旦交兵,"}, {"start": 473.56, "end": 477.56, "text": "草皮定会遣大军在樊城一带整戈带带。"}, {"start": 477.56, "end": 481.56, "text": "蜀盛,草皮则顺势南下取江东,"}, {"start": 481.56, "end": 484.56, "text": "吴盛,草皮则顺势西进取汉中。"}, {"start": 484.56, "end": 488.56, "text": "陛下,蜀城一带整戈带带。"}, {"start": 488.56, "end": 491.56, "text": "陛下,蜀吴一旦交兵,"}, {"start": 491.56, "end": 494.56, "text": "最大的获利者是草皮。"}, {"start": 494.56, "end": 508.54, "text": "臣之手是丞相,"}, {"start": 508.54, "end": 512.54, "text": "武将之手属子龙,"}, {"start": 512.54, "end": 518.46, "text": "既然文武之手都这么劝阻,"}, {"start": 518.46, "end": 522.96, "text": "那就暂缓发务吧。"}, {"start": 522.96, "end": 529.5, "text": "陛下圣明。"}, {"start": 529.5, "end": 532.5, "text": "暂缓并非放弃发务,"}, {"start": 532.5, "end": 535.5, "text": "而是为了囤积粮草军械,"}, {"start": 535.5, "end": 538.5, "text": "大造车船,带击发务。"}, {"start": 538.5, "end": 561.94, "text": "主公。"}, {"start": 561.94, "end": 565.94, "text": "四岳,什么事啊?"}, {"start": 565.94, "end": 569.94, "text": "探马来报,刘备在成都成地。"}, {"start": 569.94, "end": 572.94, "text": "刘备成地后的第一诏就是,"}, {"start": 572.94, "end": 574.94, "text": "兴兵发务。"}, {"start": 574.94, "end": 592.86, "text": "传命,明日晨时,"}, {"start": 592.86, "end": 595.86, "text": "中文武,大殿一事。"}, {"start": 595.86, "end": 624.07, "text": "诺,传属军报。"}, {"start": 624.07, "end": 627.07, "text": "怎么?刘备出川了?"}, {"start": 627.07, "end": 629.07, "text": "不,探索说,"}, {"start": 629.07, "end": 632.07, "text": "丞相孔明已经阻止刘备发务。"}, {"start": 635.07, "end": 638.07, "text": "还是你家兄弟有远见。"}, {"start": 638.07, "end": 642.64, "text": "依我看呢,用不了多久,"}, {"start": 642.64, "end": 645.64, "text": "五鼠联合,还得恢复。"}, {"start": 645.64, "end": 658.72, "text": "先生,这是怎么了?"}, {"start": 658.72, "end": 664.54, "text": "这几日,上将军的脾气越发火爆了。"}, {"start": 664.54, "end": 667.54, "text": "这些兄弟们稍有过时,"}, {"start": 667.54, "end": 669.54, "text": "上将军就罚他们,"}, {"start": 669.54, "end": 671.54, "text": "为二哥关羽守灵十日。"}, {"start": 671.54, "end": 673.54, "text": "上将军在哪?"}, {"start": 673.54, "end": 680.85, "text": "在帐中。"}, {"start": 680.85, "end": 682.85, "text": "几位都一个月了。"}, {"start": 682.85, "end": 686.85, "text": "我在这里,天天盼着发务。"}, {"start": 686.85, "end": 690.85, "text": "哥哥为何还不下,倒在赵令啊?"}, {"start": 690.85, "end": 693.85, "text": "陛下的意思是要暂缓。"}, {"start": 693.85, "end": 707.89, "text": "暂缓?暂缓呀?"}, {"start": 707.89, "end": 711.68, "text": "多有文武众臣觐见,"}, {"start": 711.68, "end": 714.68, "text": "说国之巨贼是曹魏,"}, {"start": 714.68, "end": 716.68, "text": "而非东吾。"}, {"start": 716.68, "end": 719.68, "text": "建议陛下要先灭魏,"}, {"start": 719.68, "end": 722.68, "text": "之后再发吾。"}, {"start": 722.68, "end": 726.44, "text": "这是什么话?"}, {"start": 726.44, "end": 730.44, "text": "将我三兄弟一结桃源,"}, {"start": 730.44, "end": 733.78, "text": "试图生死。"}, {"start": 733.78, "end": 739.7, "text": "如今,二哥半道被害,"}, {"start": 739.7, "end": 748.81, "text": "岂能不报仇雪恨?"}, {"start": 748.81, "end": 750.81, "text": "你给我说实话,"}, {"start": 750.81, "end": 755.09, "text": "到底是谁反对发吾啊?"}, {"start": 755.09, "end": 757.09, "text": "说!"}, {"start": 757.09, "end": 759.09, "text": "是丞相不同意啊!"}, {"start": 759.09, "end": 775.26, "text": "去面见哥哥!"}, {"start": 775.26, "end": 805.15, "text": "陛下,有何吩咐?"}, {"start": 805.15, "end": 807.15, "text": "宫道里有脚步声。"}, {"start": 807.15, "end": 813.78, "text": "只有风声,没有脚步声啊?"}, {"start": 813.78, "end": 815.78, "text": "有。"}, {"start": 815.78, "end": 820.92, "text": "你听,是我三弟。"}, {"start": 820.92, "end": 823.92, "text": "是三弟的脚步声。"}, {"start": 823.92, "end": 827.92, "text": "他脚步沉重,异于常人。"}, {"start": 827.92, "end": 829.92, "text": "义德!"}, {"start": 829.92, "end": 831.92, "text": "三弟啊!是你吗?"}, {"start": 831.92, "end": 842.69, "text": "大哥!"}, {"start": 842.69, "end": 853.34, "text": "你不是在郎中长兵吗?"}, {"start": 853.34, "end": 856.34, "text": "到长都做什么?"}, {"start": 856.34, "end": 858.34, "text": "大哥!"}, {"start": 858.34, "end": 862.34, "text": "我在郎中是度日如年的!"}, {"start": 862.34, "end": 865.34, "text": "早也盼,晚也盼,"}, {"start": 865.34, "end": 867.34, "text": "天天盼着做新凤啊!"}, {"start": 867.34, "end": 871.85, "text": "眼睛都快忘川了!"}, {"start": 871.85, "end": 875.13, "text": "可就是等不到"}, {"start": 875.13, "end": 877.13, "text": "这发吾的诏律,"}, {"start": 877.13, "end": 880.94, "text": "等到你,"}, {"start": 880.94, "end": 882.94, "text": "做了皇帝,"}, {"start": 882.94, "end": 883.94, "text": "就忘了"}, {"start": 883.94, "end": 885.94, "text": "桃园之师了吗?"}, {"start": 885.94, "end": 897.04, "text": "云长之仇,我如何忘?"}, {"start": 897.04, "end": 909.47, "text": "长海在,"}, {"start": 909.47, "end": 911.47, "text": "还与我,"}, {"start": 911.47, "end": 913.47, "text": "师同心,"}, {"start": 913.47, "end": 917.97, "text": "义同堂。"}, {"start": 917.97, "end": 923.19, "text": "二哥!"}, {"start": 923.19, "end": 924.19, "text": "二哥!"}, {"start": 924.19, "end": 930.9, "text": "二哥呀!"}, {"start": 930.9, "end": 932.9, "text": "关将军殡天后,"}, {"start": 932.9, "end": 935.9, "text": "陛下让人画了这幅像,"}, {"start": 935.9, "end": 937.9, "text": "奴才夜夜都能听到,"}, {"start": 937.9, "end": 941.9, "text": "陛下对这画像说话。"}, {"start": 941.9, "end": 943.9, "text": "既然如此,"}, {"start": 943.9, "end": 946.9, "text": "那大哥为何不下令发吾啊?"}, {"start": 946.9, "end": 951.55, "text": "兄弟休怪,"}, {"start": 951.55, "end": 954.55, "text": "云长遇难的消息一传来,"}, {"start": 954.55, "end": 957.55, "text": "我就打算兴兵发吾。"}, {"start": 957.55, "end": 959.55, "text": "可那时,"}, {"start": 959.55, "end": 962.55, "text": "我军刚遭到靖州之败,"}, {"start": 962.55, "end": 964.55, "text": "大家都劝我,"}, {"start": 964.55, "end": 969.54, "text": "都劝我修整三军,"}, {"start": 970.54, "end": 972.54, "text": "我只好言认,"}, {"start": 972.54, "end": 977.82, "text": "继位后,"}, {"start": 977.82, "end": 982.49, "text": "我已经下诏发吾了,"}, {"start": 982.49, "end": 988.96, "text": "可是,"}, {"start": 988.96, "end": 992.17, "text": "打那贼,"}, {"start": 992.17, "end": 994.17, "text": "又降了曹尉,"}, {"start": 994.17, "end": 997.17, "text": "上庸粮草尽失,"}, {"start": 997.17, "end": 999.17, "text": "没了粮草,"}, {"start": 999.17, "end": 1001.42, "text": "不能占华。"}, {"start": 1001.42, "end": 1008.5, "text": "不是你推迟发吾的理由!"}, {"start": 1008.5, "end": 1017.19, "text": "那你的理由是什么?"}, {"start": 1017.19, "end": 1018.19, "text": "你是担心,"}, {"start": 1018.19, "end": 1020.19, "text": "孔明他们反对发吾!"}, {"start": 1020.19, "end": 1026.16, "text": "我一直,"}, {"start": 1026.16, "end": 1028.16, "text": "以为你是粗人,"}, {"start": 1028.16, "end": 1034.79, "text": "没想到你,"}, {"start": 1034.79, "end": 1036.79, "text": "心细如发。"}, {"start": 1036.79, "end": 1040.22, "text": "三弟啊,"}, {"start": 1040.22, "end": 1042.22, "text": "清国出兵,"}, {"start": 1042.22, "end": 1044.22, "text": "非同小可呀,"}, {"start": 1044.22, "end": 1047.76, "text": "丞相,"}, {"start": 1047.76, "end": 1049.76, "text": "一再劝阻,"}, {"start": 1049.76, "end": 1052.14, "text": "永不三思。"}, {"start": 1052.14, "end": 1057.05, "text": "你是皇帝,"}, {"start": 1057.05, "end": 1058.05, "text": "他是臣子!"}, {"start": 1058.05, "end": 1060.05, "text": "是你听他的,"}, {"start": 1060.05, "end": 1062.05, "text": "还是他听你的?"}, {"start": 1062.05, "end": 1064.05, "text": "他不想和东吴打仗,"}, {"start": 1064.05, "end": 1066.05, "text": "还不是因为,"}, {"start": 1066.05, "end": 1068.05, "text": "他那个鸟哥哥朱国锦,"}, {"start": 1068.05, "end": 1069.05, "text": "在孙泉手下当官呢?"}, {"start": 1069.05, "end": 1070.05, "text": "不要胡说,"}, {"start": 1070.05, "end": 1076.05, "text": "丞相跟我东征西北,"}, {"start": 1076.05, "end": 1078.05, "text": "西讨十多年,"}, {"start": 1078.05, "end": 1080.05, "text": "若无他的辅佐,"}, {"start": 1080.05, "end": 1083.05, "text": "你我断不会有今日。"}, {"start": 1083.05, "end": 1088.15, "text": "没有朱葛亮,"}, {"start": 1088.15, "end": 1090.15, "text": "哥哥就不能成就大业吗?"}, {"start": 1090.15, "end": 1093.15, "text": "哥哥就不能御驾亲征了吗?"}, {"start": 1093.15, "end": 1096.15, "text": "哥哥就不能躲到天下了吗?"}, {"start": 1098.15, "end": 1100.15, "text": "叫我说啊,"}, {"start": 1100.15, "end": 1101.15, "text": "他朱葛亮,"}, {"start": 1101.15, "end": 1103.15, "text": "要是没哥哥的赏罢,"}, {"start": 1103.15, "end": 1105.15, "text": "才不会有今日呢?"}, {"start": 1105.15, "end": 1106.15, "text": "一德,"}, {"start": 1106.15, "end": 1108.15, "text": "哥哥只是知道,"}, {"start": 1108.15, "end": 1110.15, "text": "朱葛亮辅佐了你,"}, {"start": 1110.15, "end": 1112.15, "text": "何不说,"}, {"start": 1112.15, "end": 1114.15, "text": "是你遭救了他?"}, {"start": 1114.15, "end": 1116.15, "text": "这话可不像你说的,"}, {"start": 1116.15, "end": 1119.46, "text": "告诉我,"}, {"start": 1119.46, "end": 1121.46, "text": "谁跟你说的?"}, {"start": 1121.46, "end": 1130.76, "text": "我们私下议论过。"}, {"start": 1130.76, "end": 1156.22, "text": "你歇息几日,"}, {"start": 1156.22, "end": 1158.22, "text": "还是回到郎中去长军,"}, {"start": 1158.22, "end": 1159.22, "text": "不可乱,"}, {"start": 1167.18, "end": 1184.33, "text": "你总要给我一些时间运筹。"}, {"start": 1184.33, "end": 1191.12, "text": "慢点,"}, {"start": 1191.12, "end": 1232.9, "text": "还有一事,"}, {"start": 1232.9, "end": 1237.18, "text": "云长玉与他的脾气,"}, {"start": 1237.18, "end": 1239.18, "text": "不关系,"}, {"start": 1239.18, "end": 1243.42, "text": "你的火爆脾气,"}, {"start": 1243.42, "end": 1245.42, "text": "也该收敛些。"}, {"start": 1247.42, "end": 1300.62, "text": "不可再理言,"}, {"start": 1300.62, "end": 1302.62, "text": "拜见陛下。"}, {"start": 1303.62, "end": 1304.62, "text": "郑芳啊,"}, {"start": 1304.62, "end": 1308.15, "text": "来坐吧。"}, {"start": 1308.15, "end": 1310.15, "text": "谢陛下。"}, {"start": 1310.15, "end": 1322.13, "text": "郑芳啊,"}, {"start": 1322.13, "end": 1324.13, "text": "眨眼间,"}, {"start": 1324.13, "end": 1327.13, "text": "我已年过六训了。"}, {"start": 1327.13, "end": 1332.74, "text": "朕不知道,"}, {"start": 1332.74, "end": 1333.74, "text": "还能不能看到,"}, {"start": 1333.74, "end": 1335.74, "text": "光复大汗的那一天,"}, {"start": 1335.74, "end": 1339.43, "text": "也不知道,"}, {"start": 1340.43, "end": 1342.43, "text": "云长的血恨,"}, {"start": 1342.43, "end": 1344.43, "text": "何时能报?"}, {"start": 1345.43, "end": 1346.43, "text": "陛下,"}, {"start": 1346.43, "end": 1348.43, "text": "不必太过伤感。"}, {"start": 1349.43, "end": 1351.43, "text": "臣倒是觉得,"}, {"start": 1351.43, "end": 1353.43, "text": "陛下春秋正盛,"}, {"start": 1353.43, "end": 1355.43, "text": "雄心万丈。"}, {"start": 1356.43, "end": 1358.43, "text": "麾下粮将上千,"}, {"start": 1358.43, "end": 1360.43, "text": "水陆三军近百万。"}, {"start": 1361.43, "end": 1363.43, "text": "是看当今天下,"}, {"start": 1363.43, "end": 1367.43, "text": "还有谁敢与陛下抗衡呢?"}, {"start": 1367.43, "end": 1372.05, "text": "东吴孙权,"}, {"start": 1372.05, "end": 1374.05, "text": "许昌曹匹,"}, {"start": 1374.05, "end": 1376.05, "text": "揭我大敌。"}, {"start": 1377.05, "end": 1379.05, "text": "不瞒你说,"}, {"start": 1379.05, "end": 1382.05, "text": "丞相与子龙,"}, {"start": 1382.05, "end": 1384.05, "text": "一直在劝阻我方。"}, {"start": 1384.05, "end": 1388.81, "text": "朕知道他们在忧虑什么。"}, {"start": 1388.81, "end": 1389.81, "text": "他们心忧,"}, {"start": 1389.81, "end": 1391.81, "text": "千里佣兵,"}, {"start": 1391.81, "end": 1392.81, "text": "山川阻隔,"}, {"start": 1392.81, "end": 1394.81, "text": "粮饷军血,"}, {"start": 1394.81, "end": 1395.81, "text": "难以共挤。"}, {"start": 1395.81, "end": 1404.24, "text": "与曹魏相比,"}, {"start": 1404.24, "end": 1405.24, "text": "更弱些。"}, {"start": 1405.24, "end": 1410.76, "text": "成大业,"}, {"start": 1410.76, "end": 1411.76, "text": "必先灭。"}, {"start": 1412.76, "end": 1416.64, "text": "我三军将士,"}, {"start": 1416.64, "end": 1419.64, "text": "刚刚经历了汉中大战,"}, {"start": 1419.64, "end": 1420.64, "text": "军威正盛,"}, {"start": 1420.64, "end": 1422.64, "text": "而孙权不将,"}, {"start": 1422.64, "end": 1423.64, "text": "多亦老弱。"}, {"start": 1423.64, "end": 1425.64, "text": "其步骑战甲,"}, {"start": 1425.64, "end": 1427.64, "text": "更非我军敌守。"}, {"start": 1427.64, "end": 1428.64, "text": "此时,"}, {"start": 1428.64, "end": 1431.64, "text": "我若以雷霆之军南下继旨,"}, {"start": 1431.64, "end": 1434.64, "text": "完全可以在曹魏出兵前,"}, {"start": 1434.64, "end": 1435.64, "text": "击败东吴。"}, {"start": 1435.64, "end": 1441.32, "text": "曹匹心里根基未稳,"}, {"start": 1441.32, "end": 1444.32, "text": "又没有经历过大的战争。"}, {"start": 1444.32, "end": 1446.92, "text": "我法吾,"}, {"start": 1446.92, "end": 1449.92, "text": "他最多只是虚张声势,"}, {"start": 1449.92, "end": 1450.92, "text": "坐观长白,"}, {"start": 1450.92, "end": 1451.92, "text": "不敢轻动。"}, {"start": 1451.92, "end": 1452.92, "text": "而且,"}, {"start": 1452.92, "end": 1455.92, "text": "我越是用兵神速,"}, {"start": 1455.92, "end": 1467.08, "text": "他就越是不敢轻易冒险。"}, {"start": 1467.08, "end": 1469.08, "text": "我这样的想法,"}, {"start": 1469.08, "end": 1470.08, "text": "对与不对。"}, {"start": 1470.08, "end": 1477.4, "text": "陛下东观全局,"}, {"start": 1477.4, "end": 1479.4, "text": "深谋远立,"}, {"start": 1479.4, "end": 1482.4, "text": "臣钦佩满分。"}, {"start": 1482.4, "end": 1493.94, "text": "此来想去,"}, {"start": 1493.94, "end": 1495.94, "text": "最关键的,"}, {"start": 1495.94, "end": 1497.94, "text": "还是粮饷军血。"}, {"start": 1497.94, "end": 1501.74, "text": "上次,"}, {"start": 1501.74, "end": 1504.74, "text": "我让你与黄泉他们商量此事,"}, {"start": 1504.74, "end": 1506.74, "text": "你们有何见解?"}, {"start": 1506.74, "end": 1508.74, "text": "臣与太傅许敬,"}, {"start": 1508.74, "end": 1510.74, "text": "右将军黄泉,"}, {"start": 1510.74, "end": 1513.74, "text": "商量了三天两夜。"}, {"start": 1513.74, "end": 1516.74, "text": "得出的结论是,"}, {"start": 1516.74, "end": 1518.74, "text": "如果各郡县,"}, {"start": 1518.74, "end": 1521.74, "text": "都能够实施四六征税,"}, {"start": 1521.74, "end": 1523.74, "text": "三丁抽一,"}, {"start": 1523.74, "end": 1524.74, "text": "那么,"}, {"start": 1524.74, "end": 1525.74, "text": "在今秋之后,"}, {"start": 1525.74, "end": 1527.74, "text": "可以新添粮草,"}, {"start": 1527.74, "end": 1530.74, "text": "一百五十万单。"}, {"start": 1530.74, "end": 1532.74, "text": "新添兵荣,"}, {"start": 1532.74, "end": 1535.74, "text": "二十五万上下。"}, {"start": 1535.74, "end": 1536.74, "text": "是吗?"}, {"start": 1536.74, "end": 1538.74, "text": "千真万确。"}, {"start": 1538.74, "end": 1553.38, "text": "有你们这些话,"}, {"start": 1553.38, "end": 1556.38, "text": "我没有后顾之忧了。"}, {"start": 1556.38, "end": 1561.07, "text": "我完全放心了。"}, {"start": 1561.07, "end": 1563.07, "text": "但是,"}, {"start": 1563.07, "end": 1565.07, "text": "陛下,"}, {"start": 1565.07, "end": 1569.07, "text": "丞相好像一直不赞成"}, {"start": 1569.07, "end": 1571.07, "text": "四六征税,"}, {"start": 1571.07, "end": 1573.07, "text": "三丁抽一。"}, {"start": 1573.07, "end": 1576.07, "text": "因为这样一来,"}, {"start": 1576.07, "end": 1578.07, "text": "书中的百姓,"}, {"start": 1578.07, "end": 1580.07, "text": "负担过重了。"}, {"start": 1580.07, "end": 1591.67, "text": "非常时期,"}, {"start": 1591.67, "end": 1594.67, "text": "当用非常手段。"}, {"start": 1594.67, "end": 1595.67, "text": "朕,"}, {"start": 1595.67, "end": 1596.67, "text": "即刻,"}, {"start": 1596.67, "end": 1598.67, "text": "授你一道手诏,"}, {"start": 1598.67, "end": 1600.67, "text": "授权于你,"}, {"start": 1600.67, "end": 1602.67, "text": "令你与黄泉,"}, {"start": 1602.67, "end": 1604.67, "text": "年内加征军粮,"}, {"start": 1604.67, "end": 1606.67, "text": "一百五十万单,"}, {"start": 1606.67, "end": 1607.67, "text": "兵用,"}, {"start": 1607.67, "end": 1609.67, "text": "二十五万。"}, {"start": 1609.67, "end": 1610.67, "text": "臣,"}, {"start": 1610.67, "end": 1611.67, "text": "尊举,"}, {"start": 1611.67, "end": 1613.67, "text": "如有误,"}, {"start": 1613.67, "end": 1615.67, "text": "干当军法。"}, {"start": 1615.67, "end": 1619.58, "text": "中方,"}, {"start": 1619.58, "end": 1623.24, "text": "我好像,"}, {"start": 1623.24, "end": 1625.24, "text": "好久没有这么高兴过了。"}, {"start": 1625.24, "end": 1630.34, "text": "我们喝一种,"}, {"start": 1630.34, "end": 1632.34, "text": "谢陛下。"}, {"start": 1632.34, "end": 1644.42, "text": "你向陛下表示,"}, {"start": 1644.42, "end": 1646.42, "text": "赞同秋火乏污了?"}, {"start": 1646.42, "end": 1648.8, "text": "是啊。"}, {"start": 1648.8, "end": 1649.8, "text": "可是,"}, {"start": 1649.8, "end": 1650.8, "text": "可是你跟孩儿说过,"}, {"start": 1650.8, "end": 1652.8, "text": "你心里并不赞同啊。"}, {"start": 1652.8, "end": 1656.8, "text": "陛下的乏污决心已定。"}, {"start": 1656.8, "end": 1657.8, "text": "凤儿啊,"}, {"start": 1657.8, "end": 1659.8, "text": "你不要忘记咱们的身份。"}, {"start": 1659.8, "end": 1661.8, "text": "咱们是降臣。"}, {"start": 1661.8, "end": 1663.8, "text": "而孔明和子龙他们,"}, {"start": 1663.8, "end": 1666.8, "text": "跟随陛下多年。"}, {"start": 1666.8, "end": 1668.8, "text": "遇见什么事情,"}, {"start": 1668.8, "end": 1670.8, "text": "都可以率性地直言。"}, {"start": 1670.8, "end": 1672.8, "text": "咱们不信。"}, {"start": 1672.8, "end": 1676.8, "text": "咱们要顺着陛下的心意行事。"}, {"start": 1676.8, "end": 1678.8, "text": "尤其是在陛下,"}, {"start": 1678.8, "end": 1682.8, "text": "和孔明之间有分歧的时候。"}, {"start": 1682.8, "end": 1684.8, "text": "更要一心一意地,"}, {"start": 1684.8, "end": 1687.8, "text": "站在陛下这边。"}, {"start": 1687.8, "end": 1689.8, "text": "属中兵马前梁,"}, {"start": 1689.8, "end": 1690.8, "text": "倾国而出,"}, {"start": 1690.8, "end": 1693.8, "text": "投入千里东征。"}, {"start": 1693.8, "end": 1695.8, "text": "万一不胜,"}, {"start": 1695.8, "end": 1696.8, "text": "何以善后啊?"}, {"start": 1696.8, "end": 1700.24, "text": "你这是什么话?"}, {"start": 1700.24, "end": 1702.24, "text": "孩儿是怕魏无联手,"}, {"start": 1702.24, "end": 1704.24, "text": "我朝难以以一敌二。"}, {"start": 1704.24, "end": 1707.24, "text": "为什么要以一敌二呢?"}, {"start": 1707.24, "end": 1710.24, "text": "陛下可以在曹魏介入之前,"}, {"start": 1710.24, "end": 1713.24, "text": "一举击败东吴孙权。"}, {"start": 1713.24, "end": 1714.24, "text": "这样,"}, {"start": 1714.24, "end": 1718.24, "text": "曹魏就不敢轻举妄动了。"}, {"start": 1718.24, "end": 1720.24, "text": "太冒险了。"}, {"start": 1720.24, "end": 1723.19, "text": "冯儿啊,"}, {"start": 1723.19, "end": 1726.76, "text": "你记住,"}, {"start": 1726.76, "end": 1729.76, "text": "今后这种瞻前顾后的话,"}, {"start": 1729.76, "end": 1731.76, "text": "绝不可再说。"}, {"start": 1731.76, "end": 1732.76, "text": "我..."}, {"start": 1732.76, "end": 1743.43, "text": "丞相,"}, {"start": 1743.43, "end": 1745.43, "text": "丞相,"}, {"start": 1745.43, "end": 1752.22, "text": "丞相,"}, {"start": 1752.22, "end": 1755.22, "text": "陛下批复了李延、黄泉他们的奏章,"}, {"start": 1755.22, "end": 1757.22, "text": "同意四柳开水,"}, {"start": 1757.22, "end": 1759.22, "text": "三丁争议。"}, {"start": 1759.22, "end": 1761.22, "text": "此事,"}, {"start": 1761.22, "end": 1763.22, "text": "我已经知道了。"}, {"start": 1763.22, "end": 1764.22, "text": "丞相,"}, {"start": 1764.22, "end": 1766.22, "text": "为何不劝劝呢?"}, {"start": 1766.22, "end": 1769.22, "text": "我已经劝了两次了。"}, {"start": 1769.22, "end": 1770.22, "text": "但,"}, {"start": 1770.22, "end": 1773.22, "text": "家政说服兵丁的诏令一下,"}, {"start": 1773.22, "end": 1777.22, "text": "证明陛下乏无决心已定,"}, {"start": 1777.22, "end": 1779.22, "text": "我已经劝不动他了。"}, {"start": 1779.22, "end": 1783.66, "text": "凡事可一而再,"}, {"start": 1783.66, "end": 1785.66, "text": "不可再而三。"}, {"start": 1785.66, "end": 1791.31, "text": "那我们该怎么办?"}, {"start": 1791.31, "end": 1794.31, "text": "全力支持陛下,"}, {"start": 1794.31, "end": 1797.31, "text": "舍此别无选择。"}, {"start": 1797.31, "end": 1803.62, "text": "丞相,"}, {"start": 1803.62, "end": 1805.62, "text": "在下还有句话,"}, {"start": 1805.62, "end": 1807.62, "text": "不知当讲不当讲。"}, {"start": 1807.62, "end": 1810.58, "text": "你不当讲?"}, {"start": 1810.58, "end": 1818.42, "text": "马苏,"}, {"start": 1818.42, "end": 1820.42, "text": "你是要告诉我,"}, {"start": 1820.42, "end": 1822.42, "text": "主公已经绕过我,"}, {"start": 1822.42, "end": 1825.42, "text": "直接命属中就臣办事了。"}, {"start": 1825.42, "end": 1834.71, "text": "尚将军,"}, {"start": 1834.71, "end": 1835.71, "text": "都两坛子了,"}, {"start": 1835.71, "end": 1837.71, "text": "不能再喝了,"}, {"start": 1837.71, "end": 1843.45, "text": "小的求你了。"}, {"start": 1843.45, "end": 1845.45, "text": "你想让我,"}, {"start": 1845.45, "end": 1847.45, "text": "打烂你的狗头啊?"}, {"start": 1847.45, "end": 1849.45, "text": "快去拿酒来!"}, {"start": 1849.45, "end": 1850.45, "text": "遵命。"}, {"start": 1850.45, "end": 1877.57, "text": "尚将军!"}, {"start": 1877.57, "end": 1883.03, "text": "是范将长胆啊?"}, {"start": 1883.03, "end": 1886.03, "text": "我让你们五日之内,"}, {"start": 1886.03, "end": 1888.03, "text": "制办好三万套,"}, {"start": 1888.03, "end": 1890.03, "text": "白旗白甲。"}, {"start": 1890.03, "end": 1893.03, "text": "今日是第几日了?"}, {"start": 1894.03, "end": 1898.11, "text": "第五日了。"}, {"start": 1900.11, "end": 1903.49, "text": "齐备了。"}, {"start": 1903.49, "end": 1904.49, "text": "尚将军恕罪,"}, {"start": 1904.49, "end": 1906.49, "text": "齐县太监五日之内,"}, {"start": 1906.49, "end": 1909.49, "text": "实在是造不出三万套旗甲呀。"}, {"start": 1909.49, "end": 1912.28, "text": "什么?"}, {"start": 1912.28, "end": 1916.86, "text": "诏令,"}, {"start": 1916.86, "end": 1920.34, "text": "转眼计下。"}, {"start": 1920.34, "end": 1921.34, "text": "恨不得,"}, {"start": 1921.34, "end": 1923.34, "text": "明天就打过我将军,"}, {"start": 1923.34, "end": 1927.67, "text": "竟敢误我军令!"}, {"start": 1927.67, "end": 1929.67, "text": "尚将军,"}, {"start": 1929.67, "end": 1931.67, "text": "制造旗甲的物品,"}, {"start": 1931.67, "end": 1932.67, "text": "筹塑不足,"}, {"start": 1932.67, "end": 1933.67, "text": "末将,"}, {"start": 1933.67, "end": 1935.67, "text": "实在是制不出来呀。"}, {"start": 1935.67, "end": 1936.67, "text": "放屁!"}, {"start": 1936.67, "end": 1938.67, "text": "来人哪,"}, {"start": 1938.67, "end": 1940.95, "text": "拖下去,"}, {"start": 1940.95, "end": 1941.95, "text": "筹罚我,"}, {"start": 1941.95, "end": 1942.95, "text": "两百鞭子!"}, {"start": 1942.95, "end": 1943.95, "text": "诺!"}, {"start": 1943.95, "end": 1944.95, "text": "尚将军!"}, {"start": 1944.95, "end": 1945.95, "text": "尚将军!"}, {"start": 1945.95, "end": 1946.95, "text": "尚将军!"}, {"start": 1946.95, "end": 1947.95, "text": "尚将军!"}, {"start": 1947.95, "end": 1948.95, "text": "尚将军!"}, {"start": 1948.95, "end": 2001.54, "text": "尚将军,"}, {"start": 2001.54, "end": 2003.54, "text": "已经鞭过一百了,"}, {"start": 2003.54, "end": 2005.54, "text": "反正二将已经气力不支了,"}, {"start": 2005.54, "end": 2009.9, "text": "恳求尚将军饶过他们吧。"}, {"start": 2009.9, "end": 2013.57, "text": "来几鞭子,"}, {"start": 2013.57, "end": 2015.57, "text": "就不支了?"}, {"start": 2015.57, "end": 2017.57, "text": "那如何能带兵搭战啊?"}, {"start": 2017.57, "end": 2021.26, "text": "两百鞭子,"}, {"start": 2021.26, "end": 2023.26, "text": "一鞭都不能少!"}, {"start": 2023.26, "end": 2025.64, "text": "遵命。"}, {"start": 2025.64, "end": 2063.38, "text": "你们,"}, {"start": 2063.38, "end": 2065.98, "text": "知罪了吗?"}, {"start": 2065.98, "end": 2066.98, "text": "末将,"}, {"start": 2066.98, "end": 2067.98, "text": "末将,"}, {"start": 2067.98, "end": 2068.98, "text": "知罪了,"}, {"start": 2068.98, "end": 2070.98, "text": "知罪了。"}, {"start": 2070.98, "end": 2075.21, "text": "哼,"}, {"start": 2075.21, "end": 2077.21, "text": "我再给你们三日,"}, {"start": 2077.21, "end": 2079.21, "text": "三日之内,"}, {"start": 2080.21, "end": 2082.21, "text": "务必把三万套,"}, {"start": 2082.21, "end": 2083.21, "text": "白旗白甲,"}, {"start": 2083.21, "end": 2085.21, "text": "制办齐全。"}, {"start": 2085.21, "end": 2086.21, "text": "遵命。"}, {"start": 2086.21, "end": 2088.21, "text": "遵命。"}, {"start": 2092.21, "end": 2094.21, "text": "这就对了吗?"}, {"start": 2094.21, "end": 2095.21, "text": "起来吧!"}, {"start": 2095.21, "end": 2097.21, "text": "随我喝酒去!"}, {"start": 2097.21, "end": 2098.21, "text": "将军,"}, {"start": 2098.21, "end": 2100.21, "text": "恕罪,"}, {"start": 2100.21, "end": 2102.21, "text": "末将,"}, {"start": 2102.21, "end": 2104.21, "text": "实在不能动他。"}, {"start": 2106.21, "end": 2108.21, "text": "别怕,"}, {"start": 2108.21, "end": 2111.97, "text": "那就回营去吧!"}, {"start": 2111.97, "end": 2136.39, "text": "记着!"}, {"start": 2136.39, "end": 2140.38, "text": "你肉都打烂了,"}, {"start": 2140.38, "end": 2142.38, "text": "不能翻身啊。"}, {"start": 2142.38, "end": 2144.38, "text": "尚将军性情如此暴虐,"}, {"start": 2144.38, "end": 2145.38, "text": "照我看,"}, {"start": 2145.38, "end": 2146.38, "text": "别说打仗,"}, {"start": 2146.38, "end": 2148.38, "text": "你我早晚死在他的手里啊。"}, {"start": 2148.38, "end": 2150.38, "text": "还要说早晚吗?"}, {"start": 2150.38, "end": 2151.38, "text": "三日之内,"}, {"start": 2151.38, "end": 2153.38, "text": "我们定被他斩首。"}, {"start": 2153.38, "end": 2154.38, "text": "为何?"}, {"start": 2154.38, "end": 2155.38, "text": "你想,"}, {"start": 2155.38, "end": 2157.38, "text": "三日之内,"}, {"start": 2157.38, "end": 2160.38, "text": "我们造得出三万套白旗白甲吗?"}, {"start": 2160.38, "end": 2162.38, "text": "如果不能,"}, {"start": 2162.38, "end": 2164.38, "text": "你我,"}, {"start": 2164.38, "end": 2166.38, "text": "只有死路一条了。"}, {"start": 2167.38, "end": 2168.38, "text": "张兄,"}, {"start": 2168.38, "end": 2169.38, "text": "可有良策?"}, {"start": 2169.38, "end": 2244.33, "text": "陛下,"}, {"start": 2244.33, "end": 2247.7, "text": "陛下,"}, {"start": 2247.7, "end": 2249.7, "text": "郎中部将吴班,"}, {"start": 2249.7, "end": 2250.7, "text": "夜闯皇宫,"}, {"start": 2250.7, "end": 2251.7, "text": "请求见驾。"}, {"start": 2264.12, "end": 2265.12, "text": "陛下,"}, {"start": 2265.12, "end": 2273.42, "text": "说。"}, {"start": 2273.42, "end": 2275.98, "text": "范将,"}, {"start": 2275.98, "end": 2276.98, "text": "范将长大,"}, {"start": 2276.98, "end": 2279.98, "text": "昨天深夜杀害了尚将军,"}, {"start": 2279.98, "end": 2280.98, "text": "必持尚将军首级,"}, {"start": 2280.98, "end": 2282.98, "text": "头本动物四全了,"}, {"start": 2282.98, "end": 2284.98, "text": "末将非去追杀,"}, {"start": 2284.98, "end": 2286.98, "text": "没能追杀。"}, {"start": 2291.09, "end": 2298.65, "text": "弟!"}, {"start": 2298.65, "end": 2299.65, "text": "兄!"}, {"start": 2300.65, "end": 2301.65, "text": "陛下!"}, {"start": 2301.65, "end": 2302.65, "text": "陛下!"}, {"start": 2302.65, "end": 2303.65, "text": "陛下!"}, {"start": 2303.65, "end": 2305.65, "text": "张妃深恨吴侯,"}, {"start": 2305.65, "end": 2307.65, "text": "日夜盼刘备发兵征吴。"}, {"start": 2307.65, "end": 2308.65, "text": "她还扬言说,"}, {"start": 2308.65, "end": 2309.65, "text": "捉到殿下后,"}, {"start": 2309.65, "end": 2311.65, "text": "是要剥皮食肉。"}, {"start": 2311.65, "end": 2312.65, "text": "我等不堪其辱,"}, {"start": 2312.65, "end": 2313.65, "text": "冒死斩了张妃,"}, {"start": 2313.65, "end": 2315.65, "text": "前来头本动物,"}, {"start": 2315.65, "end": 2317.65, "text": "愿为吴侯效力。"}, {"start": 2317.65, "end": 2323.3, "text": "我倒要看看,"}, {"start": 2323.3, "end": 2324.3, "text": "这个食我肉的人,"}, {"start": 2324.3, "end": 2326.3, "text": "长成什么模样。"}, {"start": 2326.3, "end": 2342.63, "text": "果然是猛张妃啊。"}, {"start": 2342.63, "end": 2343.63, "text": "可惜,"}, {"start": 2343.63, "end": 2347.17, "text": "你云长大厨未报,"}, {"start": 2347.17, "end": 2348.17, "text": "现在连你的头"}, {"start": 2348.17, "end": 2350.17, "text": "也送到我的麾下来了。"}, {"start": 2351.17, "end": 2352.17, "text": "范江张达,"}, {"start": 2352.17, "end": 2354.17, "text": "功劳不小啊。"}, {"start": 2354.17, "end": 2355.17, "text": "谢殿下!"}, {"start": 2355.17, "end": 2356.17, "text": "谢殿下!"}, {"start": 2356.17, "end": 2357.17, "text": "可是,"}, {"start": 2357.17, "end": 2359.17, "text": "你们二人杀了张妃,"}, {"start": 2359.17, "end": 2360.17, "text": "为什么不投曹匹,"}, {"start": 2360.17, "end": 2362.17, "text": "偏偏要投我?"}, {"start": 2362.17, "end": 2364.17, "text": "末将久目殿下威名,"}, {"start": 2364.17, "end": 2366.17, "text": "因此冒死相投。"}, {"start": 2366.17, "end": 2372.81, "text": "你们两个祸水!"}, {"start": 2373.81, "end": 2374.81, "text": "一个云长"}, {"start": 2374.81, "end": 2375.81, "text": "已经让刘备恨透了我,"}, {"start": 2375.81, "end": 2376.81, "text": "现在又来了个张妃,"}, {"start": 2376.81, "end": 2378.81, "text": "更是火上浇油!"}, {"start": 2378.81, "end": 2379.81, "text": "来人!"}, {"start": 2379.81, "end": 2380.81, "text": "将这两个人打入囚牢,"}, {"start": 2380.81, "end": 2381.81, "text": "严加看管!"}, {"start": 2381.81, "end": 2382.81, "text": "皇后饶命!"}, {"start": 2382.81, "end": 2383.81, "text": "皇后饶命!"}, {"start": 2383.81, "end": 2384.81, "text": "皇后饶命!"}, {"start": 2384.81, "end": 2385.81, "text": "皇后饶命!"}, {"start": 2385.81, "end": 2387.81, "text": "多派些细作,"}, {"start": 2387.81, "end": 2395.73, "text": "好生打探,"}, {"start": 2395.73, "end": 2397.73, "text": "成都至边境。"}, {"start": 2397.73, "end": 2398.73, "text": "驾驾到!"}, {"start": 2398.73, "end": 2399.73, "text": "陛下!"}, {"start": 2400.73, "end": 2416.48, "text": "让开!"}, {"start": 2416.48, "end": 2434.23, "text": "朕没有你的辅助,"}, {"start": 2434.23, "end": 2441.64, "text": "就不能自立了吗?"}]