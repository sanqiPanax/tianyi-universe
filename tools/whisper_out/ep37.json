[{"start": 26.8, "end": 27.76, "text": "刘将军"}, {"start": 27.76, "end": 28.56, "text": "军师"}, {"start": 29.24, "end": 31.08, "text": "如今曹操生势滔天"}, {"start": 31.48, "end": 33.8, "text": "早晚必会向江夏用兵"}, {"start": 34.68, "end": 35.88, "text": "他现在没来"}, {"start": 36.2, "end": 38.56, "text": "只是水失不济 战船不足"}, {"start": 38.92, "end": 40.52, "text": "待他一切准备完毕"}, {"start": 40.64, "end": 43.36, "text": "江夏断然不是齐天"}, {"start": 44.08, "end": 46.08, "text": "依军师意思 如何是好"}, {"start": 48.06, "end": 49.5, "text": "不如投靠江东"}, {"start": 49.98, "end": 52.02, "text": "与孙权联手抗曹"}, {"start": 54.22, "end": 55.94, "text": "江东文武昌盛"}, {"start": 56.22, "end": 57.82, "text": "英雄人物极多"}, {"start": 58.26, "end": 59.5, "text": "岂能容我等"}, {"start": 61.98, "end": 63.02, "text": "我看未必"}, {"start": 64.5, "end": 66.42, "text": "曹操现在已是隔江而忘了"}, {"start": 66.94, "end": 68.74, "text": "金戈铁马生生在耳"}, {"start": 69.7, "end": 72.46, "text": "此时此刻江东少主孙权"}, {"start": 72.9, "end": 75.42, "text": "恐怕比主公更加坐卧不明"}, {"start": 76.7, "end": 77.98, "text": "主公已经战败"}, {"start": 78.54, "end": 81.22, "text": "再战只是败上加败而已"}, {"start": 81.58, "end": 82.94, "text": "而孙权则不然"}, {"start": 83.3, "end": 84.66, "text": "他除了胜败之外"}, {"start": 84.66, "end": 86.1, "text": "更有生死之嫌"}, {"start": 86.9, "end": 87.66, "text": "明摆着"}, {"start": 87.94, "end": 89.5, "text": "曹操必会跨江而过"}, {"start": 89.5, "end": 90.5, "text": "夺他机应"}, {"start": 90.7, "end": 92.5, "text": "只有孙柳联手抗曹"}, {"start": 92.78, "end": 94.22, "text": "方能有胜机"}, {"start": 100.69, "end": 101.49, "text": "禀将军"}, {"start": 101.57, "end": 102.89, "text": "江东有使者前来"}, {"start": 103.09, "end": 104.73, "text": "为先主公刘表调丧"}, {"start": 104.89, "end": 105.97, "text": "江东使者"}, {"start": 106.61, "end": 107.77, "text": "为我父亲调丧"}, {"start": 109.33, "end": 110.37, "text": "奇怪"}, {"start": 111.05, "end": 111.69, "text": "怎么"}, {"start": 112.17, "end": 113.17, "text": "军师记得吗"}, {"start": 113.61, "end": 114.49, "text": "十年前"}, {"start": 114.61, "end": 116.01, "text": "孙权的父亲孙涧"}, {"start": 116.13, "end": 118.01, "text": "被我荆州部下乱箭射死"}, {"start": 118.45, "end": 120.81, "text": "江东与我荆州有杀夫之仇啊"}, {"start": 121.29, "end": 123.57, "text": "十年来我两家只有刀兵相见"}, {"start": 123.77, "end": 125.37, "text": "从没有胡同过喜丧啊"}, {"start": 127.35, "end": 128.15, "text": "明白了"}, {"start": 129.47, "end": 130.23, "text": "主公啊"}, {"start": 130.75, "end": 133.27, "text": "江东使者是冲着你来的"}, {"start": 135.68, "end": 136.64, "text": "何意见得"}, {"start": 137.28, "end": 138.08, "text": "明摆着"}, {"start": 139.0, "end": 140.72, "text": "江东使者以调丧为名"}, {"start": 140.84, "end": 141.96, "text": "前来向主公"}, {"start": 142.08, "end": 143.4, "text": "打探曹操军情"}, {"start": 143.96, "end": 144.72, "text": "我们不是刚刚"}, {"start": 144.72, "end": 146.0, "text": "与曹操激战过吗"}, {"start": 146.8, "end": 147.36, "text": "不错"}, {"start": 150.33, "end": 151.65, "text": "时机已到"}, {"start": 152.37, "end": 153.57, "text": "大势可期"}, {"start": 154.69, "end": 156.21, "text": "我愿借一夜小舟"}, {"start": 156.37, "end": 157.69, "text": "随此人过江"}, {"start": 158.01, "end": 159.57, "text": "拼过三寸不烂之舌"}, {"start": 159.65, "end": 161.65, "text": "说服孙权与我们联手抗曹"}, {"start": 162.21, "end": 163.45, "text": "在万里长江间"}, {"start": 163.57, "end": 165.93, "text": "激起一场空前绝后的南北大战"}, {"start": 166.85, "end": 167.89, "text": "如孙权胜"}, {"start": 168.33, "end": 169.97, "text": "主公可乘势取荆州"}, {"start": 170.13, "end": 171.01, "text": "如曹操胜"}, {"start": 171.21, "end": 172.69, "text": "主公可乘势取江东"}, {"start": 172.81, "end": 174.13, "text": "成千秋霸业"}, {"start": 181.28, "end": 182.64, "text": "到这个时候了"}, {"start": 183.68, "end": 187.24, "text": "你还想着霸业"}, {"start": 187.28, "end": 188.2, "text": "恕我直言"}, {"start": 189.24, "end": 190.68, "text": "所有的千秋霸业"}, {"start": 191.08, "end": 193.16, "text": "都是在山穷水静时开始的"}, {"start": 193.88, "end": 195.56, "text": "我们已度过最危险关头"}, {"start": 196.04, "end": 196.96, "text": "此时此刻"}, {"start": 197.28, "end": 198.96, "text": "除了向上这颗头颅"}, {"start": 199.2, "end": 201.2, "text": "已经没什么能让我们再失去的了"}, {"start": 202.0, "end": 203.44, "text": "只能天天向好"}, {"start": 203.68, "end": 204.88, "text": "争争日上"}, {"start": 208.46, "end": 209.1, "text": "佩服"}, {"start": 210.86, "end": 212.06, "text": "江东来是何人"}, {"start": 212.5, "end": 213.26, "text": "他说"}, {"start": 214.3, "end": 215.7, "text": "他是将军府参军"}, {"start": 216.06, "end": 216.9, "text": "名叫鲁肃"}, {"start": 217.58, "end": 218.26, "text": "鲁肃"}, {"start": 218.46, "end": 220.7, "text": "吴子敬"}, {"start": 222.34, "end": 224.1, "text": "孙权竟派此人来探引"}, {"start": 225.8, "end": 227.16, "text": "恐明你识得此人"}, {"start": 227.48, "end": 227.96, "text": "不"}, {"start": 228.44, "end": 229.52, "text": "但此人大名"}, {"start": 230.16, "end": 232.04, "text": "我早已听兄长朱阁锦说过"}, {"start": 233.88, "end": 234.64, "text": "主公啊"}, {"start": 235.28, "end": 236.44, "text": "在江东文武中"}, {"start": 236.8, "end": 238.52, "text": "武将之首非周瑜莫属"}, {"start": 238.72, "end": 239.52, "text": "文臣之首"}, {"start": 239.76, "end": 240.96, "text": "当属老臣张昭"}, {"start": 241.32, "end": 242.72, "text": "除此之外的第三人"}, {"start": 243.12, "end": 244.0, "text": "便是鲁肃了"}, {"start": 245.0, "end": 246.04, "text": "据我兄长说"}, {"start": 246.68, "end": 248.52, "text": "今后能够领袖群贤的"}, {"start": 249.56, "end": 251.28, "text": "只怕还是这个鲁子敬"}, {"start": 251.48, "end": 255.95, "text": "鲁子敬是才华"}, {"start": 256.39, "end": 258.55, "text": "竟在你兄朱阁锦之上吗"}, {"start": 260.94, "end": 263.14, "text": "我兄长在江东群贤中"}, {"start": 263.66, "end": 265.26, "text": "只能排在二十名以外"}, {"start": 267.37, "end": 268.29, "text": "我且这么说吧"}, {"start": 269.41, "end": 270.93, "text": "周瑜是何等的巨傲啊"}, {"start": 271.73, "end": 273.49, "text": "天下没几个人能让他瞧得上"}, {"start": 274.37, "end": 276.29, "text": "但周瑜这辈子只推荐过一个人"}, {"start": 277.21, "end": 278.05, "text": "那便是鲁肃"}, {"start": 279.81, "end": 281.05, "text": "孙策去世第三天"}, {"start": 281.57, "end": 283.29, "text": "鲁肃才被周瑜推荐给孙权"}, {"start": 283.53, "end": 284.57, "text": "那小的从那以后"}, {"start": 284.81, "end": 285.77, "text": "整整一个月"}, {"start": 286.29, "end": 288.29, "text": "孙权与鲁肃十则同席"}, {"start": 288.29, "end": 289.33, "text": "请则同事"}, {"start": 289.33, "end": 290.13, "text": "朝夕不离"}, {"start": 290.69, "end": 291.89, "text": "相待如恩师"}, {"start": 294.01, "end": 294.89, "text": "在那些日子里"}, {"start": 295.41, "end": 296.53, "text": "他们谈论些什么"}, {"start": 296.89, "end": 297.69, "text": "无人知道"}, {"start": 298.65, "end": 299.81, "text": "只晓得从此以后"}, {"start": 300.21, "end": 301.89, "text": "刚刚继位的少主孙权"}, {"start": 302.57, "end": 303.69, "text": "变得焕然一新"}, {"start": 304.37, "end": 305.41, "text": "言谈举止中"}, {"start": 305.73, "end": 307.37, "text": "已有了三分帝王之气"}, {"start": 308.41, "end": 309.89, "text": "江东派这等人物为使"}, {"start": 311.09, "end": 312.09, "text": "非同小可"}, {"start": 317.29, "end": 318.33, "text": "快随我出营鲁肃"}, {"start": 318.65, "end": 344.48, "text": "偶闻刘皇叔大名"}, {"start": 344.8, "end": 346.36, "text": "今日幸得相会"}, {"start": 347.32, "end": 348.68, "text": "子敬远道而来"}, {"start": 348.84, "end": 349.84, "text": "我们有失远迎"}, {"start": 350.04, "end": 350.68, "text": "请恕罪"}, {"start": 350.96, "end": 351.92, "text": "岂敢岂敢"}, {"start": 353.77, "end": 354.09, "text": "请"}, {"start": 366.9, "end": 367.46, "text": "刘公子"}, {"start": 368.74, "end": 371.26, "text": "我家主公得知刘景升先师"}, {"start": 371.58, "end": 372.42, "text": "痛不能眠"}, {"start": 373.22, "end": 374.86, "text": "特派我专程前来"}, {"start": 375.18, "end": 376.18, "text": "治丧吊宴"}, {"start": 376.86, "end": 378.82, "text": "些许公务不成精"}, {"start": 384.42, "end": 386.54, "text": "贵主公与我荆州有杀父之仇"}, {"start": 387.5, "end": 388.38, "text": "我父亲去世"}, {"start": 389.18, "end": 390.74, "text": "贵主公应该欢喜才是"}, {"start": 390.86, "end": 392.38, "text": "怎么可能痛不能眠呢"}, {"start": 393.74, "end": 394.18, "text": "再说"}, {"start": 395.86, "end": 397.86, "text": "又为何亲自请阁下前来吊丧"}, {"start": 400.63, "end": 401.19, "text": "因为"}, {"start": 402.23, "end": 403.75, "text": "刘景升如果不死"}, {"start": 404.59, "end": 406.15, "text": "曹操不敢犯荆州"}, {"start": 407.15, "end": 407.95, "text": "景升一死"}, {"start": 408.47, "end": 410.11, "text": "非但荆州沦陷吧"}, {"start": 410.67, "end": 412.95, "text": "我江东也是危在旦夕"}, {"start": 415.42, "end": 415.94, "text": "所以"}, {"start": 416.54, "end": 419.14, "text": "我家主公当然要为刘景升之死"}, {"start": 419.3, "end": 420.14, "text": "痛不能眠了"}, {"start": 424.88, "end": 426.6, "text": "至于派我来吊丧吗"}, {"start": 427.64, "end": 428.44, "text": "那是因为"}, {"start": 429.04, "end": 430.48, "text": "我要借吊丧之名"}, {"start": 431.24, "end": 433.08, "text": "探一探曹军的虚实"}, {"start": 434.08, "end": 435.08, "text": "顺便看一看"}, {"start": 435.96, "end": 438.52, "text": "你们还有没有能力抗击曹军"}, {"start": 440.08, "end": 440.64, "text": "了不起"}, {"start": 441.52, "end": 443.04, "text": "一开口便是大实话"}, {"start": 445.59, "end": 446.87, "text": "这位就是诸葛亮吧"}, {"start": 449.38, "end": 450.02, "text": "顾明兄"}, {"start": 450.46, "end": 451.7, "text": "在下久仰了"}, {"start": 455.92, "end": 458.24, "text": "风闻已足智多谋能言善辩"}, {"start": 458.72, "end": 460.12, "text": "单凭一条肉舌头"}, {"start": 460.44, "end": 461.36, "text": "也能够杀人"}, {"start": 461.96, "end": 463.44, "text": "不耐在下嘴拙"}, {"start": 463.68, "end": 466.4, "text": "在你面前只好是句句实话"}, {"start": 467.04, "end": 468.64, "text": "好在千言万语"}, {"start": 469.08, "end": 470.88, "text": "也不如实话管用啊"}, {"start": 473.73, "end": 474.85, "text": "敬佩敬佩"}, {"start": 475.09, "end": 476.33, "text": "岂敢岂敢"}, {"start": 482.5, "end": 485.06, "text": "那就恕我句句实话实说了"}, {"start": 489.09, "end": 489.69, "text": "六皇叔"}, {"start": 490.93, "end": 493.85, "text": "请问曹操现在有多少兵马"}, {"start": 494.85, "end": 496.69, "text": "其战里究竟如何呀"}, {"start": 500.78, "end": 501.9, "text": "惭愧惭愧"}, {"start": 502.58, "end": 503.62, "text": "我兵为将管"}, {"start": 503.98, "end": 504.98, "text": "闻曹军而来"}, {"start": 505.14, "end": 506.02, "text": "掉头便走"}, {"start": 506.54, "end": 508.02, "text": "竟也不清楚曹操"}, {"start": 508.38, "end": 509.66, "text": "到底有多少兵马"}, {"start": 511.74, "end": 513.66, "text": "六皇叔是在欺瞒老师"}, {"start": 516.26, "end": 516.82, "text": "子敬啊"}, {"start": 518.14, "end": 518.94, "text": "都是我的错"}, {"start": 519.66, "end": 521.5, "text": "是我让主公推托不严的"}, {"start": 522.26, "end": 523.58, "text": "那我就要问你了"}, {"start": 526.45, "end": 527.01, "text": "空明"}, {"start": 527.65, "end": 531.33, "text": "曹操到底有多少兵马"}, {"start": 531.89, "end": 533.57, "text": "其战里究竟如何"}, {"start": 534.01, "end": 535.21, "text": "去荆州之前"}, {"start": 536.9, "end": 538.42, "text": "曹操就有步军二十万"}, {"start": 538.62, "end": 540.66, "text": "马军六万 水军十八万"}, {"start": 540.98, "end": 541.78, "text": "去荆州后"}, {"start": 541.98, "end": 543.34, "text": "约增长三十万"}, {"start": 543.58, "end": 544.98, "text": "共计七十余万"}, {"start": 545.66, "end": 546.82, "text": "至于战力嘛"}, {"start": 547.22, "end": 548.62, "text": "挟大胜之师"}, {"start": 548.86, "end": 550.06, "text": "风头正劲"}, {"start": 551.74, "end": 552.26, "text": "敢问"}, {"start": 552.78, "end": 553.98, "text": "曹操下一步"}, {"start": 554.3, "end": 555.42, "text": "愈与何谓"}, {"start": 555.98, "end": 556.9, "text": "愈与何谓"}, {"start": 558.82, "end": 559.94, "text": "跨疆而过"}, {"start": 560.22, "end": 561.38, "text": "攻取江东"}, {"start": 561.66, "end": 562.9, "text": "一统天下"}, {"start": 566.86, "end": 568.02, "text": "那你们接下来"}, {"start": 569.42, "end": 571.18, "text": "又打算何去何从呢"}, {"start": 577.5, "end": 578.54, "text": "苍吾太守"}, {"start": 578.86, "end": 580.14, "text": "与我家主公有救"}, {"start": 580.94, "end": 582.1, "text": "万不得已之时"}, {"start": 582.82, "end": 584.22, "text": "我们可投靠苍吾"}, {"start": 587.82, "end": 589.26, "text": "苍吾乘小兵弱"}, {"start": 589.74, "end": 590.78, "text": "断不可休守"}, {"start": 592.5, "end": 594.38, "text": "我江东六郡之地"}, {"start": 594.62, "end": 596.62, "text": "天险民风 兵精良品"}, {"start": 597.62, "end": 599.78, "text": "我主公又极其爱贤"}, {"start": 600.74, "end": 602.34, "text": "你们为何不投江东"}, {"start": 606.33, "end": 607.69, "text": "联合抗草呢"}, {"start": 610.34, "end": 610.86, "text": "紫禁"}, {"start": 611.98, "end": 613.02, "text": "你方才说什么"}, {"start": 614.9, "end": 615.62, "text": "孔明啊"}, {"start": 616.26, "end": 617.18, "text": "当下之计"}, {"start": 617.78, "end": 619.34, "text": "除了孙刘联手之外"}, {"start": 619.74, "end": 620.58, "text": "你我两家"}, {"start": 620.98, "end": 622.3, "text": "还有别的活路吗"}, {"start": 634.26, "end": 635.34, "text": "紫禁所言"}, {"start": 635.82, "end": 637.74, "text": "真如大汉将干你了"}, {"start": 641.62, "end": 643.06, "text": "你们谁愿意过江东"}, {"start": 644.38, "end": 646.14, "text": "与我去见我家主公"}, {"start": 649.78, "end": 650.38, "text": "我"}, {"start": 652.76, "end": 653.8, "text": "我随你过江"}, {"start": 658.62, "end": 659.18, "text": "甚好"}, {"start": 661.98, "end": 662.98, "text": "丞相有令"}, {"start": 663.34, "end": 665.94, "text": "召各部文武上堂听证"}, {"start": 681.13, "end": 684.7, "text": "刘备已逃往江夏"}, {"start": 685.86, "end": 687.7, "text": "与刘齐合军一处"}, {"start": 688.18, "end": 689.34, "text": "坚守不成"}, {"start": 691.18, "end": 693.46, "text": "些许残敌不足为虑"}, {"start": 694.14, "end": 694.82, "text": "合律者"}, {"start": 696.02, "end": 697.94, "text": "是刘备与孙权联手"}, {"start": 698.74, "end": 700.86, "text": "共同抵抗朝廷大军"}, {"start": 704.69, "end": 707.01, "text": "本相思考再三"}, {"start": 708.89, "end": 709.61, "text": "决定"}, {"start": 710.53, "end": 711.85, "text": "休整三个月"}, {"start": 712.17, "end": 715.04, "text": "待春暖花开"}, {"start": 716.16, "end": 717.2, "text": "河西化冻"}, {"start": 718.16, "end": 719.56, "text": "及挥施百万"}, {"start": 720.28, "end": 722.28, "text": "一举跨越长江天嵌"}, {"start": 722.72, "end": 723.88, "text": "拒间孙刘"}, {"start": 724.88, "end": 725.56, "text": "遵命"}, {"start": 725.8, "end": 726.52, "text": "遵命"}, {"start": 727.76, "end": 728.44, "text": "此役"}, {"start": 729.8, "end": 731.52, "text": "当是我一统天下的"}, {"start": 732.0, "end": 732.88, "text": "最后一战"}, {"start": 734.64, "end": 736.88, "text": "也是成就千秋霸业"}, {"start": 737.84, "end": 739.48, "text": "万载流明的一战"}, {"start": 740.04, "end": 740.64, "text": "而且"}, {"start": 742.28, "end": 744.16, "text": "也是盛券在握的一战"}, {"start": 745.2, "end": 746.28, "text": "此役过后"}, {"start": 748.27, "end": 750.51, "text": "我就要谢甲归田了"}, {"start": 751.31, "end": 751.91, "text": "列位"}, {"start": 752.99, "end": 755.55, "text": "也可以四绝封侯"}, {"start": 756.23, "end": 758.59, "text": "带上千两黄金"}, {"start": 759.23, "end": 760.35, "text": "万亩良田"}, {"start": 761.03, "end": 764.07, "text": "搂着三五个娇妻美妾"}, {"start": 764.63, "end": 766.11, "text": "饱享清福"}, {"start": 767.83, "end": 769.27, "text": "谢天下"}, {"start": 769.63, "end": 770.35, "text": "但是"}, {"start": 771.11, "end": 772.75, "text": "不管是金山银山"}, {"start": 772.75, "end": 774.19, "text": "还是娇妻美妾"}, {"start": 774.47, "end": 776.83, "text": "眼下还都只是画饼"}, {"start": 777.83, "end": 780.03, "text": "哪怕他已经端到你面前了"}, {"start": 780.95, "end": 782.87, "text": "在入嘴前的一刻"}, {"start": 783.23, "end": 784.59, "text": "仍有可能失去"}, {"start": 786.35, "end": 787.59, "text": "列位还记得"}, {"start": 787.99, "end": 789.03, "text": "江京渡吗"}, {"start": 790.55, "end": 793.47, "text": "刘备已经是我们的掌中物"}, {"start": 793.95, "end": 795.11, "text": "盘中餐了"}, {"start": 795.51, "end": 796.99, "text": "可是在最后一刻"}, {"start": 797.39, "end": 798.63, "text": "煮熟的鸭子"}, {"start": 799.59, "end": 800.31, "text": "飞走了"}, {"start": 801.11, "end": 802.39, "text": "因此此役"}, {"start": 803.07, "end": 804.43, "text": "诸位一定要"}, {"start": 805.19, "end": 806.51, "text": "立兵莫马"}, {"start": 808.63, "end": 809.43, "text": "一定要"}, {"start": 810.43, "end": 812.79, "text": "将孙刘全奸"}, {"start": 813.59, "end": 814.59, "text": "万不可让"}, {"start": 814.79, "end": 816.99, "text": "江京渡之事重演"}, {"start": 821.58, "end": 822.22, "text": "蔡某"}, {"start": 824.73, "end": 825.69, "text": "末将在"}, {"start": 826.25, "end": 827.21, "text": "我给你"}, {"start": 828.17, "end": 829.33, "text": "三个月时间"}, {"start": 830.41, "end": 833.13, "text": "在东庭湖操练四十万水军"}, {"start": 833.61, "end": 835.65, "text": "打造八千艘战船"}, {"start": 836.85, "end": 837.89, "text": "五月十日"}, {"start": 839.93, "end": 841.93, "text": "率全部的水军战船"}, {"start": 842.41, "end": 843.97, "text": "出伯阳湖开赴"}, {"start": 844.21, "end": 845.41, "text": "赤壁将判"}, {"start": 846.89, "end": 847.49, "text": "遵命"}, {"start": 848.09, "end": 848.81, "text": "承玉"}, {"start": 849.97, "end": 850.49, "text": "在"}, {"start": 852.21, "end": 853.17, "text": "笔墨伺候"}, {"start": 854.29, "end": 855.65, "text": "我要给孙全"}, {"start": 855.97, "end": 857.17, "text": "下一道诏书"}, {"start": 868.47, "end": 870.27, "text": "孤诚皇命"}, {"start": 871.63, "end": 873.55, "text": "奉天罚罪"}, {"start": 874.99, "end": 876.55, "text": "今其所下"}, {"start": 877.51, "end": 879.15, "text": "刘从肃首"}, {"start": 880.15, "end": 881.55, "text": "今乡九郡"}, {"start": 882.27, "end": 884.11, "text": "望丰来归"}, {"start": 886.38, "end": 887.18, "text": "今统"}, {"start": 887.62, "end": 889.06, "text": "雄兵百万"}, {"start": 889.82, "end": 891.22, "text": "战将千元"}, {"start": 891.66, "end": 892.7, "text": "欲与卒下"}, {"start": 892.86, "end": 894.3, "text": "会列于江东"}, {"start": 895.66, "end": 897.02, "text": "共秦刘备"}, {"start": 897.5, "end": 898.94, "text": "拥结盟航"}, {"start": 900.06, "end": 900.98, "text": "盼卒下"}, {"start": 901.5, "end": 902.9, "text": "顺天几手"}, {"start": 908.31, "end": 909.19, "text": "将此诏"}, {"start": 909.67, "end": 911.11, "text": "抄写三千份"}, {"start": 911.75, "end": 914.03, "text": "至于竹筒沿江飘下"}, {"start": 914.27, "end": 917.44, "text": "要让"}, {"start": 918.28, "end": 919.52, "text": "万里长江"}, {"start": 920.52, "end": 921.6, "text": "都飘满了"}, {"start": 922.56, "end": 924.2, "text": "我给孙全的战表"}, {"start": 925.52, "end": 926.24, "text": "我要让"}, {"start": 926.92, "end": 928.32, "text": "沿江的子民"}, {"start": 928.96, "end": 930.36, "text": "心惊胆战"}, {"start": 931.72, "end": 934.0, "text": "我要让江东的文武"}, {"start": 934.88, "end": 937.12, "text": "魂飞魄散"}, {"start": 952.91, "end": 954.23, "text": "虽然我积极主张"}, {"start": 954.23, "end": 956.07, "text": "孙柳两家联手抗草"}, {"start": 957.07, "end": 957.63, "text": "但是"}, {"start": 958.31, "end": 959.47, "text": "江东的群臣"}, {"start": 959.63, "end": 961.47, "text": "并非都像我这般思想"}, {"start": 963.61, "end": 964.09, "text": "所以"}, {"start": 964.61, "end": 966.37, "text": "请你见到我家主公之时"}, {"start": 966.81, "end": 968.73, "text": "特别是在大庭广众之下"}, {"start": 969.13, "end": 969.89, "text": "切不可以"}, {"start": 970.05, "end": 971.81, "text": "曹操兵多将我罢"}, {"start": 977.34, "end": 978.22, "text": "理解 理解"}, {"start": 979.46, "end": 980.9, "text": "实至上有长短"}, {"start": 981.62, "end": 983.34, "text": "何况江东群贤苦"}, {"start": 984.06, "end": 984.74, "text": "再说了"}, {"start": 985.22, "end": 986.98, "text": "家家都有本难念的经"}, {"start": 994.14, "end": 994.9, "text": "是何声音"}, {"start": 996.34, "end": 996.7, "text": "报"}, {"start": 997.3, "end": 997.74, "text": "秦省"}, {"start": 998.06, "end": 999.1, "text": "这是曹操的战书"}, {"start": 999.5, "end": 1013.28, "text": "皇命奉天罚罪"}, {"start": 1013.84, "end": 1014.96, "text": "京启所向"}, {"start": 1015.24, "end": 1016.36, "text": "刘从肃守"}, {"start": 1017.08, "end": 1019.44, "text": "京乡九军望风来归"}, {"start": 1020.2, "end": 1021.8, "text": "金统雄兵百万"}, {"start": 1022.04, "end": 1023.08, "text": "上将千元"}, {"start": 1023.48, "end": 1025.88, "text": "欲与卒下会练于江东"}, {"start": 1026.56, "end": 1027.64, "text": "共秦刘备"}, {"start": 1028.04, "end": 1029.2, "text": "永劫盟好"}, {"start": 1029.92, "end": 1032.28, "text": "盼卒下顺天击手"}, {"start": 1033.6, "end": 1034.8, "text": "以免自误"}, {"start": 1035.04, "end": 1044.6, "text": "好文章"}, {"start": 1045.64, "end": 1046.84, "text": "气吞山河"}, {"start": 1047.28, "end": 1048.44, "text": "雄势鼓劲"}, {"start": 1051.28, "end": 1053.4, "text": "这些战书顺江而下"}, {"start": 1055.0, "end": 1056.56, "text": "江东的官民士族"}, {"start": 1057.08, "end": 1058.76, "text": "谁都可以取而官"}, {"start": 1058.96, "end": 1066.09, "text": "江东的军心民心"}, {"start": 1067.37, "end": 1069.29, "text": "都要为之大乱呢"}, {"start": 1069.93, "end": 1076.22, "text": "现在我主的案头"}, {"start": 1076.42, "end": 1077.38, "text": "还不是堆积了"}, {"start": 1077.38, "end": 1079.22, "text": "多少这样的竹筒子啊"}, {"start": 1079.9, "end": 1084.47, "text": "紫禁啊"}, {"start": 1085.79, "end": 1086.75, "text": "你现在该知道"}, {"start": 1086.75, "end": 1088.27, "text": "曹操何等厉害了吧"}, {"start": 1089.35, "end": 1089.91, "text": "他呀"}, {"start": 1090.63, "end": 1091.55, "text": "未功成"}, {"start": 1092.83, "end": 1094.03, "text": "先功兴"}, {"start": 1094.75, "end": 1105.47, "text": "先生 请登岸"}, {"start": 1117.28, "end": 1120.08, "text": "主公请孔明先生客馆歇息"}, {"start": 1120.08, "end": 1121.16, "text": "明日相见"}, {"start": 1125.81, "end": 1126.37, "text": "请"}, {"start": 1128.9, "end": 1131.54, "text": "主公请先生立刻相见"}, {"start": 1172.88, "end": 1173.44, "text": "师叔"}, {"start": 1173.96, "end": 1174.76, "text": "你继续说"}, {"start": 1178.43, "end": 1179.23, "text": "主公啊"}, {"start": 1179.59, "end": 1180.63, "text": "有些话"}, {"start": 1180.95, "end": 1182.83, "text": "也只有老臣敢言"}, {"start": 1183.63, "end": 1186.43, "text": "旁人害怕得罪主公"}, {"start": 1188.44, "end": 1189.28, "text": "但说无妨"}, {"start": 1193.38, "end": 1196.42, "text": "曹操拥百万之中"}, {"start": 1196.74, "end": 1198.5, "text": "挟天子之名"}, {"start": 1199.7, "end": 1200.98, "text": "经其遮日"}, {"start": 1201.34, "end": 1202.98, "text": "兵甲漫天"}, {"start": 1203.54, "end": 1206.14, "text": "其将大多来自北方"}, {"start": 1206.14, "end": 1207.34, "text": "或者西域"}, {"start": 1207.78, "end": 1209.46, "text": "汉勇无比"}, {"start": 1210.1, "end": 1213.14, "text": "其族大多久经沙场"}, {"start": 1213.46, "end": 1214.94, "text": "兵丰正境"}, {"start": 1216.38, "end": 1217.94, "text": "其文臣谋士"}, {"start": 1218.22, "end": 1220.1, "text": "大多凶有韬略"}, {"start": 1220.42, "end": 1222.02, "text": "足智多谋"}, {"start": 1222.62, "end": 1225.1, "text": "而我江东兵马"}, {"start": 1226.54, "end": 1228.62, "text": "步骑水师"}, {"start": 1228.62, "end": 1231.42, "text": "加在一块步俗十万"}, {"start": 1232.5, "end": 1234.34, "text": "自先主公创业"}, {"start": 1234.34, "end": 1235.9, "text": "五十二年下来"}, {"start": 1236.5, "end": 1238.62, "text": "江东将士所经历过的"}, {"start": 1238.62, "end": 1240.46, "text": "最大一场战争"}, {"start": 1240.46, "end": 1243.3, "text": "只是与荆襄刘表交战"}, {"start": 1243.3, "end": 1245.5, "text": "且不分胜负"}, {"start": 1246.18, "end": 1248.46, "text": "而刘表的部将们"}, {"start": 1248.7, "end": 1249.66, "text": "此次"}, {"start": 1250.42, "end": 1252.58, "text": "根本不敢与曹军交战"}, {"start": 1252.58, "end": 1255.66, "text": "就已经开成现象了"}, {"start": 1256.42, "end": 1258.02, "text": "综上所述"}, {"start": 1258.66, "end": 1260.58, "text": "我江东军旅"}, {"start": 1260.58, "end": 1263.74, "text": "非曹军之敌呀"}, {"start": 1268.02, "end": 1269.02, "text": "师叔"}, {"start": 1269.02, "end": 1269.82, "text": "主公"}, {"start": 1270.62, "end": 1271.46, "text": "我们"}, {"start": 1271.94, "end": 1273.86, "text": "有一道长江天线"}, {"start": 1274.7, "end": 1275.62, "text": "是也"}, {"start": 1276.58, "end": 1277.26, "text": "但"}, {"start": 1277.86, "end": 1279.98, "text": "曹操有百万凶师"}, {"start": 1279.98, "end": 1282.26, "text": "足以头边断流"}, {"start": 1283.1, "end": 1284.18, "text": "再者"}, {"start": 1284.18, "end": 1288.02, "text": "我们刚刚从上将于夫口中得知"}, {"start": 1288.86, "end": 1293.14, "text": "曹操正在洞庭湖训练水军"}, {"start": 1293.66, "end": 1295.46, "text": "日夜不停"}, {"start": 1295.46, "end": 1298.34, "text": "打造上千条战船"}, {"start": 1299.14, "end": 1300.38, "text": "从他们"}, {"start": 1300.38, "end": 1303.14, "text": "发运下来的龙骨判断"}, {"start": 1303.7, "end": 1305.46, "text": "那些战船"}, {"start": 1305.46, "end": 1307.34, "text": "长二十丈"}, {"start": 1307.34, "end": 1308.9, "text": "阔数丈"}, {"start": 1310.02, "end": 1312.7, "text": "比我江东战船"}, {"start": 1312.7, "end": 1317.35, "text": "要宽大许多"}, {"start": 1317.35, "end": 1318.15, "text": "那"}, {"start": 1318.71, "end": 1320.19, "text": "师叔的意思是"}, {"start": 1328.1, "end": 1328.9, "text": "战"}, {"start": 1329.78, "end": 1335.24, "text": "江东生灵投探"}, {"start": 1335.24, "end": 1336.4, "text": "祥"}, {"start": 1337.12, "end": 1340.16, "text": "方可保静安民"}, {"start": 1340.16, "end": 1344.48, "text": "请主公率江东六郡官员百姓"}, {"start": 1344.48, "end": 1346.24, "text": "归顺朝廷"}, {"start": 1346.24, "end": 1348.28, "text": "曹操必授主公"}, {"start": 1348.28, "end": 1350.36, "text": "提领江东之位"}, {"start": 1350.36, "end": 1351.68, "text": "让主公"}, {"start": 1351.68, "end": 1358.98, "text": "永镇东吴"}, {"start": 1358.98, "end": 1360.3, "text": "只需"}, {"start": 1360.3, "end": 1364.78, "text": "按年向徐昌缴纳税付即可"}, {"start": 1365.02, "end": 1367.34, "text": "因为曹操所要的是"}, {"start": 1367.34, "end": 1368.86, "text": "一统天下"}, {"start": 1368.86, "end": 1371.18, "text": "成万载功名"}, {"start": 1371.18, "end": 1373.14, "text": "他最不想看到的是"}, {"start": 1373.14, "end": 1375.14, "text": "到处诸侯割据"}, {"start": 1375.14, "end": 1379.14, "text": "群雄争霸山河破碎"}, {"start": 1380.46, "end": 1382.78, "text": "他也不想看到"}, {"start": 1382.78, "end": 1385.74, "text": "南北大军疏死交兵"}, {"start": 1385.74, "end": 1386.7, "text": "致使"}, {"start": 1386.7, "end": 1388.58, "text": "尸堆如山"}, {"start": 1388.58, "end": 1395.05, "text": "血漫长江"}, {"start": 1395.05, "end": 1396.33, "text": "子不所言"}, {"start": 1396.33, "end": 1397.25, "text": "是也"}, {"start": 1398.21, "end": 1400.33, "text": "必战倾乡"}, {"start": 1400.33, "end": 1402.29, "text": "何天意"}, {"start": 1402.29, "end": 1403.77, "text": "顺民心"}, {"start": 1413.22, "end": 1416.1, "text": "师叔和各位先生"}, {"start": 1416.1, "end": 1417.82, "text": "先请回"}, {"start": 1417.82, "end": 1420.26, "text": "此事"}, {"start": 1420.26, "end": 1424.08, "text": "容我三思"}, {"start": 1424.08, "end": 1455.81, "text": "他们都劝我降"}, {"start": 1455.81, "end": 1458.61, "text": "可你平平里一句话也没有"}, {"start": 1458.61, "end": 1461.13, "text": "主公啊"}, {"start": 1461.13, "end": 1463.17, "text": "张昭他们主降"}, {"start": 1463.17, "end": 1466.48, "text": "有他们的道理"}, {"start": 1466.48, "end": 1468.32, "text": "从他们的角度看"}, {"start": 1468.72, "end": 1471.28, "text": "自然是该想的"}, {"start": 1471.28, "end": 1473.6, "text": "因为他们归乡以后"}, {"start": 1473.6, "end": 1476.2, "text": "仍然可以治理州政"}, {"start": 1476.2, "end": 1477.44, "text": "管理农丧"}, {"start": 1477.44, "end": 1479.12, "text": "太平如旧"}, {"start": 1479.12, "end": 1482.44, "text": "仍然不失为朝廷的命官"}, {"start": 1482.44, "end": 1486.08, "text": "甚至"}, {"start": 1486.08, "end": 1490.29, "text": "甚至连在下也是可以想的"}, {"start": 1490.29, "end": 1491.81, "text": "在下想了以后"}, {"start": 1491.81, "end": 1493.93, "text": "可以器官不做"}, {"start": 1493.93, "end": 1496.93, "text": "在家摆弄些诗文笔墨"}, {"start": 1496.93, "end": 1499.01, "text": "开门授图"}, {"start": 1499.01, "end": 1502.13, "text": "混合温饱不成问题"}, {"start": 1502.17, "end": 1502.93, "text": "可是"}, {"start": 1502.93, "end": 1508.67, "text": "江东文物人人可想"}, {"start": 1508.67, "end": 1510.63, "text": "唯独主公你"}, {"start": 1510.63, "end": 1523.7, "text": "是万万想不得呀"}, {"start": 1523.7, "end": 1525.7, "text": "为何我"}, {"start": 1525.7, "end": 1528.3, "text": "就万万想不得"}, {"start": 1528.3, "end": 1530.82, "text": "不久前"}, {"start": 1530.82, "end": 1533.1, "text": "曹操在许昌"}, {"start": 1533.1, "end": 1537.7, "text": "编制了一个黄金的笼子"}, {"start": 1537.7, "end": 1542.52, "text": "灿烂无比啊"}, {"start": 1542.52, "end": 1545.88, "text": "这个笼子叫做朝廷"}, {"start": 1545.88, "end": 1549.26, "text": "笼中关了一只鸟"}, {"start": 1549.26, "end": 1551.34, "text": "这个鸟的名字"}, {"start": 1551.34, "end": 1553.78, "text": "叫天子"}, {"start": 1553.78, "end": 1555.5, "text": "不久后"}, {"start": 1555.5, "end": 1557.06, "text": "曹操又把一只鸟"}, {"start": 1557.06, "end": 1559.34, "text": "关了进去"}, {"start": 1559.34, "end": 1562.54, "text": "它的名字叫刘从"}, {"start": 1562.54, "end": 1564.58, "text": "如果主公回乡"}, {"start": 1564.58, "end": 1566.06, "text": "主公也会被曹操"}, {"start": 1566.06, "end": 1571.95, "text": "关进这只黄金的笼子"}, {"start": 1571.95, "end": 1586.2, "text": "一只笼子关进去三只鸟"}, {"start": 1586.2, "end": 1591.3, "text": "你这番话"}, {"start": 1591.3, "end": 1594.14, "text": "要把我的信都刺穿了"}, {"start": 1594.14, "end": 1612.11, "text": "完全可能"}, {"start": 1613.11, "end": 1616.07, "text": "孔明先生"}, {"start": 1616.11, "end": 1618.79, "text": "紫禁兄"}, {"start": 1618.79, "end": 1619.99, "text": "孔明今天"}, {"start": 1619.99, "end": 1621.43, "text": "真乃是"}, {"start": 1621.43, "end": 1622.75, "text": "红光满面"}, {"start": 1622.75, "end": 1624.35, "text": "神采一役"}, {"start": 1624.35, "end": 1627.79, "text": "好不精神哪"}, {"start": 1627.79, "end": 1629.43, "text": "江东天灵地秀"}, {"start": 1629.43, "end": 1630.91, "text": "群贤碧极"}, {"start": 1630.91, "end": 1632.55, "text": "我若再不光彩点"}, {"start": 1632.55, "end": 1639.62, "text": "有何颜面见贵主公啊"}, {"start": 1639.62, "end": 1641.5, "text": "孔明啊"}, {"start": 1641.5, "end": 1642.9, "text": "切记"}, {"start": 1642.9, "end": 1644.26, "text": "在我主公面前"}, {"start": 1644.26, "end": 1645.42, "text": "千万不要说"}, {"start": 1645.42, "end": 1647.78, "text": "曹军兵夺将广啊"}, {"start": 1650.34, "end": 1651.34, "text": "理解"}, {"start": 1652.1, "end": 1652.86, "text": "理解"}, {"start": 1655.4, "end": 1655.88, "text": "请"}, {"start": 1656.32, "end": 1656.8, "text": "请"}, {"start": 1678.23, "end": 1680.39, "text": "这是江东常事"}, {"start": 1680.39, "end": 1681.75, "text": "张昭张子布"}, {"start": 1685.22, "end": 1688.06, "text": "在下江东威谋之事"}, {"start": 1688.06, "end": 1689.3, "text": "张昭事业"}, {"start": 1690.22, "end": 1692.26, "text": "久闻先生"}, {"start": 1692.26, "end": 1693.7, "text": "高卧龙中"}, {"start": 1694.78, "end": 1696.7, "text": "号称卧龙"}, {"start": 1696.7, "end": 1699.58, "text": "此笔管众乐意"}, {"start": 1702.34, "end": 1703.94, "text": "莫非"}, {"start": 1703.94, "end": 1707.14, "text": "真的有此笔吗"}, {"start": 1707.14, "end": 1709.78, "text": "这只是在下生平小可之笔"}, {"start": 1709.78, "end": 1711.3, "text": "先生不必在意"}, {"start": 1714.18, "end": 1716.46, "text": "听说刘史君"}, {"start": 1716.46, "end": 1718.62, "text": "三顾茅庐"}, {"start": 1718.62, "end": 1721.46, "text": "才请的先生出山"}, {"start": 1721.46, "end": 1723.82, "text": "之后刘史君"}, {"start": 1723.82, "end": 1726.1, "text": "如鱼得水"}, {"start": 1726.14, "end": 1729.34, "text": "准备席卷京乡"}, {"start": 1729.34, "end": 1731.1, "text": "独呈霸业"}, {"start": 1732.86, "end": 1734.06, "text": "如今"}, {"start": 1734.06, "end": 1736.26, "text": "京乡久郡"}, {"start": 1736.26, "end": 1738.5, "text": "已落于曹操之手"}, {"start": 1739.7, "end": 1742.1, "text": "敢问此时此刻"}, {"start": 1742.1, "end": 1743.98, "text": "鱼在水中"}, {"start": 1743.98, "end": 1746.7, "text": "还是鱼在汤锅"}, {"start": 1748.42, "end": 1750.42, "text": "我主公若想取京乡"}, {"start": 1750.42, "end": 1751.66, "text": "那是易如反掌"}, {"start": 1752.54, "end": 1754.7, "text": "刘表曾再三相让"}, {"start": 1754.7, "end": 1757.22, "text": "我主公不忍取同宗激业"}, {"start": 1757.22, "end": 1760.18, "text": "这才让曹贼窃得京乡"}, {"start": 1760.18, "end": 1763.38, "text": "如今我主屯兵江下"}, {"start": 1763.38, "end": 1765.38, "text": "如龙入海 凤腾空"}, {"start": 1765.38, "end": 1766.94, "text": "别有良徒"}, {"start": 1766.94, "end": 1769.34, "text": "子布先生勿虑"}, {"start": 1773.82, "end": 1780.5, "text": "先生自笔管众乐意"}, {"start": 1780.5, "end": 1784.54, "text": "管众者相助齐桓公"}, {"start": 1784.54, "end": 1788.54, "text": "独霸诸侯一筐天意下"}, {"start": 1788.54, "end": 1791.46, "text": "乐意者扶持若嫣"}, {"start": 1791.46, "end": 1794.14, "text": "一鼓作气连下齐"}, {"start": 1794.14, "end": 1795.7, "text": "七十二成"}, {"start": 1796.66, "end": 1801.3, "text": "此二人堪称星国济世之才艺"}, {"start": 1802.42, "end": 1803.82, "text": "而先生呢"}, {"start": 1805.62, "end": 1809.66, "text": "枯坐草庐 笑傲丰业"}, {"start": 1809.66, "end": 1812.38, "text": "除报锡银炭之外"}, {"start": 1812.38, "end": 1814.58, "text": "别无所常"}, {"start": 1814.58, "end": 1817.86, "text": "刘使君未得先生钱"}, {"start": 1817.9, "end": 1822.46, "text": "尚能割据城池 自保有余"}, {"start": 1822.46, "end": 1824.66, "text": "得先生之后"}, {"start": 1824.66, "end": 1830.42, "text": "则抛兵弃甲 望风而窜"}, {"start": 1830.42, "end": 1833.98, "text": "尚不能报天子 以安庶民"}, {"start": 1833.98, "end": 1838.94, "text": "下不能叫贼君 而守疆土"}, {"start": 1838.94, "end": 1840.86, "text": "半年不到"}, {"start": 1840.86, "end": 1847.02, "text": "弃新野 失凡城 败当阳 走下口"}, {"start": 1847.02, "end": 1851.14, "text": "放黄南北 陆路东西"}, {"start": 1851.14, "end": 1855.66, "text": "竟无一寸立身之地"}, {"start": 1858.58, "end": 1862.42, "text": "在下直言相告"}, {"start": 1862.42, "end": 1866.3, "text": "先生雅量 叛物见怪"}, {"start": 1867.62, "end": 1872.5, "text": "蓬飞万里 雁雀不识其志"}, {"start": 1872.5, "end": 1875.06, "text": "我本以为雁雀应在林间"}, {"start": 1875.06, "end": 1878.14, "text": "没想到今日都聚于郎下"}, {"start": 1879.38, "end": 1882.3, "text": "我主刘玄德却曾败于汝南"}, {"start": 1882.3, "end": 1883.9, "text": "托付于刘表"}, {"start": 1883.9, "end": 1887.34, "text": "事实兵不足万 将至关张"}, {"start": 1887.34, "end": 1889.78, "text": "然而当曹操率五十万大军"}, {"start": 1889.78, "end": 1890.66, "text": "杀乃时"}, {"start": 1890.66, "end": 1893.82, "text": "我主于伯旺火攻 白河用水"}, {"start": 1893.82, "end": 1895.78, "text": "致使曹人 李典 夏侯"}, {"start": 1895.78, "end": 1898.22, "text": "蹲十万兵马 骗甲无归"}, {"start": 1899.62, "end": 1902.74, "text": "即使管众越异用兵"}, {"start": 1902.74, "end": 1904.86, "text": "也未必过此"}, {"start": 1904.9, "end": 1908.34, "text": "当阳路上 后有追兵 前有大疆"}, {"start": 1908.34, "end": 1911.26, "text": "二十万百姓俘老邪幼追随我主公"}, {"start": 1911.26, "end": 1913.62, "text": "日行至十里"}, {"start": 1913.62, "end": 1916.3, "text": "我主公宁守刀剑也不弃百姓"}, {"start": 1916.3, "end": 1918.98, "text": "如此仁义之君百世以来"}, {"start": 1918.98, "end": 1922.54, "text": "足下可曾听说过吗"}, {"start": 1922.54, "end": 1926.38, "text": "然而却有夸夸齐谈之辈"}, {"start": 1926.38, "end": 1929.54, "text": "闭目涩听 视而不见"}, {"start": 1929.54, "end": 1931.54, "text": "如论孤鸣钓狱"}, {"start": 1931.54, "end": 1933.82, "text": "他们无人能及"}, {"start": 1933.82, "end": 1935.9, "text": "如论临敌用兵"}, {"start": 1935.9, "end": 1938.18, "text": "他们却百无一能"}, {"start": 1938.18, "end": 1949.6, "text": "只能一笑天下"}, {"start": 1949.6, "end": 1952.44, "text": "曹操拥兵百万 上将千元"}, {"start": 1952.44, "end": 1955.52, "text": "龙香虎施 玉京吞江下"}, {"start": 1955.52, "end": 1958.2, "text": "敢问足下有何良策"}, {"start": 1958.2, "end": 1960.52, "text": "曹操收袁绍已聚之兵"}, {"start": 1960.52, "end": 1962.56, "text": "节流表乌合之重"}, {"start": 1962.56, "end": 1965.0, "text": "哪怕他号称百万千万"}, {"start": 1965.0, "end": 1966.56, "text": "我也不惧"}, {"start": 1966.56, "end": 1968.68, "text": "足下君败于当阳"}, {"start": 1968.68, "end": 1970.32, "text": "既穷于下口"}, {"start": 1970.36, "end": 1972.4, "text": "黄黄求救于江东"}, {"start": 1972.4, "end": 1974.8, "text": "竟敢说无惧"}, {"start": 1974.8, "end": 1977.56, "text": "真是狂言其事"}, {"start": 1977.56, "end": 1979.8, "text": "我主公仅有兵勇数千"}, {"start": 1979.8, "end": 1982.48, "text": "岂能敌曹操百万之重"}, {"start": 1982.48, "end": 1983.68, "text": "现退守江下"}, {"start": 1983.68, "end": 1985.32, "text": "仍与曹贼势不两立"}, {"start": 1985.32, "end": 1987.6, "text": "待机杀敌"}, {"start": 1987.6, "end": 1989.92, "text": "而江东兵经良族"}, {"start": 1989.92, "end": 1991.6, "text": "雄居长江天欠"}, {"start": 1991.6, "end": 1993.28, "text": "却有一般风雅之势"}, {"start": 1993.28, "end": 1997.4, "text": "苦口婆心劝其主归降曹贼"}, {"start": 1997.4, "end": 1999.08, "text": "如此看来"}, {"start": 1999.08, "end": 2001.92, "text": "我主公真是天底下"}, {"start": 2001.92, "end": 2007.22, "text": "最不惧曹操之人了"}, {"start": 2007.22, "end": 2008.74, "text": "孔明"}, {"start": 2008.74, "end": 2011.42, "text": "想效仿苏秦张仪"}, {"start": 2011.42, "end": 2014.42, "text": "用三寸肉舌扫平东吴吗"}, {"start": 2015.98, "end": 2018.06, "text": "万万不敢"}, {"start": 2018.06, "end": 2020.1, "text": "足下只知苏秦张仪"}, {"start": 2020.1, "end": 2021.78, "text": "乃能言善辩之事"}, {"start": 2021.78, "end": 2025.42, "text": "却不知他们亦真好解"}, {"start": 2025.42, "end": 2027.62, "text": "苏秦配六国相应"}, {"start": 2027.62, "end": 2029.18, "text": "张仪两次相亲"}, {"start": 2029.18, "end": 2031.18, "text": "皆有安邦定国之功"}, {"start": 2031.18, "end": 2032.58, "text": "绝非势强凌弱"}, {"start": 2032.58, "end": 2034.22, "text": "必死贪生之徒"}, {"start": 2034.22, "end": 2035.78, "text": "而时下有人"}, {"start": 2035.78, "end": 2038.54, "text": "亦听说曹操雍君百万"}, {"start": 2038.54, "end": 2040.86, "text": "且不问虚假真实"}, {"start": 2040.86, "end": 2044.42, "text": "即刻欲叩首启祥"}, {"start": 2044.42, "end": 2045.82, "text": "这等人"}, {"start": 2045.82, "end": 2050.44, "text": "还敢效苏秦张仪吗"}, {"start": 2050.44, "end": 2053.6, "text": "孔明以为曹操何需人言"}, {"start": 2053.6, "end": 2054.96, "text": "汉贼"}, {"start": 2054.96, "end": 2056.2, "text": "天下皆知"}, {"start": 2056.2, "end": 2057.56, "text": "又何必问"}, {"start": 2057.56, "end": 2059.36, "text": "此言差矣"}, {"start": 2059.36, "end": 2061.16, "text": "汉传世四百年"}, {"start": 2061.16, "end": 2062.56, "text": "天命已尽"}, {"start": 2062.56, "end": 2064.32, "text": "如今三分天下"}, {"start": 2064.32, "end": 2065.8, "text": "曹操已得其二"}, {"start": 2065.8, "end": 2068.76, "text": "剩下其一已暗怀归心"}, {"start": 2068.76, "end": 2070.84, "text": "刘始君不识天命"}, {"start": 2070.84, "end": 2072.36, "text": "逆流而行"}, {"start": 2072.36, "end": 2074.32, "text": "安能不败啊"}, {"start": 2074.32, "end": 2076.04, "text": "足下此话"}, {"start": 2076.04, "end": 2077.28, "text": "真是无君无父"}, {"start": 2077.28, "end": 2079.8, "text": "不忠不孝之言"}, {"start": 2079.8, "end": 2081.08, "text": "人生于天地间"}, {"start": 2081.08, "end": 2082.92, "text": "当以忠义为本"}, {"start": 2082.92, "end": 2084.08, "text": "我等既为汉臣"}, {"start": 2084.08, "end": 2086.32, "text": "就当与贼势不两立"}, {"start": 2086.32, "end": 2088.2, "text": "大汉已传世四百年"}, {"start": 2088.2, "end": 2090.52, "text": "为何不能再传世四百年"}, {"start": 2090.52, "end": 2091.68, "text": "如果不能"}, {"start": 2091.68, "end": 2092.84, "text": "就是因为有了足下"}, {"start": 2092.84, "end": 2094.68, "text": "这样无君无父之人"}, {"start": 2094.68, "end": 2101.94, "text": "坏了大汉天下也"}, {"start": 2106.86, "end": 2109.3, "text": "孔明真是当世奇才呀"}, {"start": 2109.3, "end": 2110.38, "text": "各位先生"}, {"start": 2110.38, "end": 2111.86, "text": "如果口舌相难"}, {"start": 2111.86, "end": 2114.34, "text": "就不是待客的道理了"}, {"start": 2114.34, "end": 2116.78, "text": "敢问老将军名讳"}, {"start": 2116.78, "end": 2119.02, "text": "此乃江东上将"}, {"start": 2119.02, "end": 2120.82, "text": "黄盖皇公父"}, {"start": 2122.1, "end": 2123.98, "text": "黄盖将军所言"}, {"start": 2123.98, "end": 2126.02, "text": "堪称这条长廊上"}, {"start": 2126.02, "end": 2127.82, "text": "最明白的话"}, {"start": 2129.14, "end": 2130.7, "text": "主公有请"}, {"start": 2130.7, "end": 2131.34, "text": "请"}, {"start": 2131.34, "end": 2137.76, "text": "请"}, {"start": 2137.76, "end": 2140.6, "text": "千万不可言曹军兵多将寡"}, {"start": 2140.6, "end": 2146.47, "text": "理解 理解"}, {"start": 2146.47, "end": 2148.87, "text": "孔明远来令我大感欣慰"}, {"start": 2148.87, "end": 2151.11, "text": "昨夜喜不能寐啊"}, {"start": 2151.11, "end": 2152.31, "text": "我主刘玄德"}, {"start": 2152.31, "end": 2154.03, "text": "托在下拜见孙将军"}, {"start": 2154.03, "end": 2156.35, "text": "暂约孙将军少年英主"}, {"start": 2156.35, "end": 2157.79, "text": "南天一柱"}, {"start": 2158.63, "end": 2161.35, "text": "先生 请入座用茶"}, {"start": 2161.35, "end": 2167.78, "text": "谢座"}, {"start": 2167.78, "end": 2170.74, "text": "卢子敬多次赞扬先生的雄才大略"}, {"start": 2170.74, "end": 2172.5, "text": "今日幸得一见"}, {"start": 2172.5, "end": 2173.7, "text": "我年轻稚嫩"}, {"start": 2173.7, "end": 2176.7, "text": "还盼先生多多教诲于我"}, {"start": 2176.7, "end": 2178.26, "text": "不敢当"}, {"start": 2178.26, "end": 2180.78, "text": "在下自踏入江东地面起"}, {"start": 2180.78, "end": 2184.1, "text": "每时每刻都在饱受教义"}, {"start": 2186.82, "end": 2189.62, "text": "刘史军在心也不忘等地"}, {"start": 2189.62, "end": 2192.26, "text": "屡屡曹操击战"}, {"start": 2192.26, "end": 2195.02, "text": "不知曹兵兵马有多少"}, {"start": 2195.02, "end": 2199.31, "text": "战力究竟如何"}, {"start": 2199.31, "end": 2202.11, "text": "既然是明公亲口垂寻"}, {"start": 2202.11, "end": 2203.79, "text": "在下不敢相瞒"}, {"start": 2203.79, "end": 2206.39, "text": "只能直言禀告"}, {"start": 2206.39, "end": 2207.59, "text": "明公"}, {"start": 2207.59, "end": 2209.59, "text": "曹操的水军 步军 马军"}, {"start": 2209.59, "end": 2216.32, "text": "总计约一百余万"}, {"start": 2216.32, "end": 2218.4, "text": "百万之众"}, {"start": 2218.4, "end": 2222.44, "text": "这其中会不会有诈"}, {"start": 2222.44, "end": 2223.56, "text": "无诈"}, {"start": 2223.56, "end": 2227.08, "text": "容在下一笔笔算给明公听"}, {"start": 2227.08, "end": 2228.6, "text": "中原大战之前"}, {"start": 2228.6, "end": 2230.88, "text": "曹操就有青州军二十二万"}, {"start": 2230.88, "end": 2233.6, "text": "灭袁绍后得其军五六十万"}, {"start": 2233.6, "end": 2235.68, "text": "即使算他才去十几万老弱"}, {"start": 2235.68, "end": 2238.44, "text": "也当得四十五万精兵"}, {"start": 2238.44, "end": 2241.56, "text": "之后半年他再继 并 忧"}, {"start": 2241.56, "end": 2243.76, "text": "各州新练兵勇三十八万"}, {"start": 2243.76, "end": 2246.4, "text": "精州归降后曹操一旦被发"}, {"start": 2246.4, "end": 2249.28, "text": "即得京乡水陆三军三十三万"}, {"start": 2249.28, "end": 2251.64, "text": "综上所计曹操兵马"}, {"start": 2251.64, "end": 2253.96, "text": "不下于一百四十万"}, {"start": 2253.96, "end": 2255.4, "text": "我说百万"}, {"start": 2255.4, "end": 2257.96, "text": "是怕惊吓了江东诸贤"}, {"start": 2257.96, "end": 2259.36, "text": "但明公垂寻"}, {"start": 2259.4, "end": 2262.44, "text": "在下只能直言相告"}, {"start": 2268.95, "end": 2272.23, "text": "曹军战将究竟如何"}, {"start": 2272.23, "end": 2274.43, "text": "曹操在战表中吹嘘"}, {"start": 2274.43, "end": 2275.99, "text": "上将千元"}, {"start": 2275.99, "end": 2277.43, "text": "那是说谎"}, {"start": 2277.43, "end": 2278.99, "text": "但能争善战之将"}, {"start": 2278.99, "end": 2280.79, "text": "大约有三百位左右"}, {"start": 2280.79, "end": 2283.11, "text": "其中当今一流统兵上将"}, {"start": 2283.11, "end": 2284.59, "text": "约三十位左右"}, {"start": 2284.59, "end": 2287.23, "text": "我略举几位"}, {"start": 2287.23, "end": 2289.15, "text": "曹人曹洪兄弟"}, {"start": 2289.15, "end": 2290.43, "text": "夏侯兄弟"}, {"start": 2290.43, "end": 2291.15, "text": "徐楚"}, {"start": 2291.15, "end": 2291.87, "text": "徐晃"}, {"start": 2291.87, "end": 2292.51, "text": "张辽"}, {"start": 2292.51, "end": 2293.11, "text": "岳敬"}, {"start": 2293.11, "end": 2293.71, "text": "李典"}, {"start": 2293.71, "end": 2294.59, "text": "张禾"}, {"start": 2294.59, "end": 2296.35, "text": "都堪称当世名将"}, {"start": 2297.27, "end": 2299.55, "text": "曹操取京乡之后"}, {"start": 2301.11, "end": 2302.39, "text": "别有远之梦"}, {"start": 2303.71, "end": 2305.31, "text": "曹操沿江下战"}, {"start": 2305.31, "end": 2306.63, "text": "打造战船"}, {"start": 2306.63, "end": 2308.07, "text": "训练水师"}, {"start": 2308.07, "end": 2310.43, "text": "战表铺天盖地而来"}, {"start": 2310.43, "end": 2312.03, "text": "他不屠江东"}, {"start": 2312.03, "end": 2315.01, "text": "又当如何"}, {"start": 2315.01, "end": 2317.89, "text": "那我当战当禾还是当降"}, {"start": 2317.89, "end": 2330.73, "text": "请先生为我一决"}, {"start": 2330.73, "end": 2332.17, "text": "在下有一言"}, {"start": 2332.17, "end": 2336.75, "text": "恐明公不肯听从"}, {"start": 2336.75, "end": 2341.23, "text": "愿闻高论"}, {"start": 2341.23, "end": 2342.71, "text": "十年前"}, {"start": 2342.71, "end": 2343.71, "text": "董卓篡逆"}, {"start": 2343.71, "end": 2344.95, "text": "致使天下大乱"}, {"start": 2344.95, "end": 2346.51, "text": "群雄并起"}, {"start": 2346.51, "end": 2348.47, "text": "孙将军父兄与我家主公"}, {"start": 2348.47, "end": 2350.71, "text": "都是在反董秦王时崛起的"}, {"start": 2351.63, "end": 2353.79, "text": "如今十分天下"}, {"start": 2353.79, "end": 2355.59, "text": "曹操独占七八"}, {"start": 2355.59, "end": 2357.23, "text": "剩下仅二三"}, {"start": 2357.23, "end": 2359.35, "text": "留给其他英雄人物的用武之地"}, {"start": 2359.35, "end": 2360.59, "text": "已然不多"}, {"start": 2360.59, "end": 2361.19, "text": "因此"}, {"start": 2361.19, "end": 2362.91, "text": "我主公不得不退居江下"}, {"start": 2362.91, "end": 2364.15, "text": "以待十变"}, {"start": 2365.07, "end": 2367.15, "text": "请明公自己判断一下"}, {"start": 2367.15, "end": 2368.75, "text": "如果能率江东兵马"}, {"start": 2368.75, "end": 2370.31, "text": "敌曹操举国之重"}, {"start": 2370.31, "end": 2371.63, "text": "那就与之战"}, {"start": 2371.63, "end": 2372.83, "text": "如果不能"}, {"start": 2372.83, "end": 2373.87, "text": "就应当"}, {"start": 2373.87, "end": 2375.19, "text": "暗家束手"}, {"start": 2375.19, "end": 2385.48, "text": "向北而败"}, {"start": 2385.48, "end": 2387.28, "text": "北败"}, {"start": 2387.28, "end": 2389.0, "text": "是和"}, {"start": 2389.0, "end": 2390.64, "text": "还是降"}, {"start": 2392.32, "end": 2393.88, "text": "和就是降"}, {"start": 2393.88, "end": 2395.64, "text": "只不过说起来"}, {"start": 2395.64, "end": 2399.34, "text": "比降好听些罢了"}, {"start": 2399.34, "end": 2401.02, "text": "你主刘备"}, {"start": 2401.02, "end": 2402.78, "text": "为何不降"}, {"start": 2402.78, "end": 2404.78, "text": "我主公与明公不同"}, {"start": 2404.78, "end": 2407.06, "text": "他是汉帝之后末世英雄"}, {"start": 2407.06, "end": 2409.3, "text": "哪怕天崩地裂 乾坤毁灭"}, {"start": 2409.3, "end": 2411.34, "text": "我主公必然逊天而死"}, {"start": 2411.34, "end": 2412.7, "text": "断断不暇"}]