[{"start": 18.9, "end": 21.7, "text": "都带二百铁机,从后代杀出重围。"}, {"start": 21.7, "end": 25.7, "text": "至此心,交予卫王,请求卫王速发援兵。"}, {"start": 25.7, "end": 30.5, "text": "告诉卫王,援兵一日不到,定军山全军覆没!"}, {"start": 30.5, "end": 31.5, "text": "遵命!"}, {"start": 41.24, "end": 44.84, "text": "卫王,夏侯将军求援,定军山万急啊!"}, {"start": 44.84, "end": 47.7, "text": "拿来。"}, {"start": 47.7, "end": 50.5, "text": "敌军不下三万,把山寨围的水线不通。"}, {"start": 50.5, "end": 55.9, "text": "我军死伤过半,夏侯将军身中一箭两枪,仍然死战。"}, {"start": 55.9, "end": 60.3, "text": "如果援军再不来,定军山全军覆没啊!"}, {"start": 60.3, "end": 62.3, "text": "卫王,快发兵救援吧!"}, {"start": 62.3, "end": 70.2, "text": "卫王,快发兵救援吧!"}, {"start": 70.2, "end": 76.46, "text": "夏侯元英勇,不愧为五弟。"}, {"start": 76.46, "end": 81.46, "text": "侄儿,你先歇息片刻。"}, {"start": 81.46, "end": 85.06, "text": "待会儿我会派五百铁机,护送你回山寨。"}, {"start": 85.06, "end": 87.06, "text": "你告诉夏侯元,"}, {"start": 87.06, "end": 93.26, "text": "我马上就会让徐晃,徐楚,带三万大军前去香园。"}, {"start": 93.26, "end": 95.46, "text": "让他再私守一天,"}, {"start": 95.46, "end": 99.86, "text": "只带援军到,离殷外合,拒监皇中。"}, {"start": 99.86, "end": 102.46, "text": "谢卫王!"}, {"start": 102.46, "end": 104.46, "text": "都退了吧。"}, {"start": 104.46, "end": 117.67, "text": "遵命!"}, {"start": 117.67, "end": 120.27, "text": "功课第一关算齐。"}, {"start": 120.27, "end": 123.87, "text": "我们这是第几场败仗了?"}, {"start": 123.87, "end": 126.47, "text": "第四场。"}, {"start": 126.47, "end": 128.67, "text": "我打了一辈子仗,"}, {"start": 128.67, "end": 132.78, "text": "还从来没有连败过四阵。"}, {"start": 132.78, "end": 134.98, "text": "卫王真想援救定军山。"}, {"start": 134.98, "end": 136.58, "text": "为何不?"}, {"start": 136.58, "end": 138.78, "text": "你以为我说说而已吗?"}, {"start": 138.78, "end": 142.18, "text": "卫王应该前日就发兵。"}, {"start": 142.18, "end": 145.58, "text": "何必等到战局恶化成今日?"}, {"start": 145.58, "end": 148.78, "text": "此刻发兵,需急行军一日半。"}, {"start": 148.78, "end": 151.38, "text": "等援军到时,"}, {"start": 151.38, "end": 154.98, "text": "定军山八成已经失了。"}, {"start": 154.98, "end": 161.54, "text": "而我援军确实兵疲马乏。"}, {"start": 161.54, "end": 170.21, "text": "按不过你,这正是我心中的苦恼啊。"}, {"start": 170.21, "end": 173.41, "text": "我刚才给信使说要发兵,"}, {"start": 173.41, "end": 175.81, "text": "也只是说给他听听。"}, {"start": 175.81, "end": 178.81, "text": "定军山,敌视贤军,"}, {"start": 178.81, "end": 182.61, "text": "四周山岭皆被皇中占据。"}, {"start": 182.61, "end": 185.61, "text": "我已无法再救。"}, {"start": 185.61, "end": 188.01, "text": "派多少人去,"}, {"start": 188.01, "end": 190.01, "text": "都是送死。"}, {"start": 190.01, "end": 193.01, "text": "卫王的意思是,"}, {"start": 193.01, "end": 195.81, "text": "定军山已成败士,"}, {"start": 195.81, "end": 198.41, "text": "就让他败得更有价值。"}, {"start": 198.41, "end": 200.01, "text": "让定军山的士兵"}, {"start": 200.01, "end": 201.81, "text": "抱有一丝希望,"}, {"start": 201.81, "end": 203.21, "text": "战至最后一刻,"}, {"start": 203.21, "end": 208.16, "text": "好拼杀掉刘备更多兵马。"}, {"start": 208.16, "end": 209.76, "text": "没错,"}, {"start": 209.76, "end": 212.56, "text": "刘备得定军山之后,"}, {"start": 212.56, "end": 214.76, "text": "娇气更盛,"}, {"start": 214.76, "end": 216.36, "text": "必小试于我,"}, {"start": 216.36, "end": 226.66, "text": "这更有利于我日后与他决战。"}, {"start": 226.66, "end": 229.66, "text": "夏侯院是我军上将,"}, {"start": 229.66, "end": 232.66, "text": "屡见其功,"}, {"start": 232.66, "end": 236.06, "text": "还是卫王的宗亲血脉,"}, {"start": 236.06, "end": 237.66, "text": "他一旦阵亡,"}, {"start": 237.66, "end": 239.46, "text": "三军阵动。"}, {"start": 239.46, "end": 242.06, "text": "你难过了?"}, {"start": 242.06, "end": 243.66, "text": "心痛如脚。"}, {"start": 243.66, "end": 246.26, "text": "我也心痛,"}, {"start": 246.26, "end": 249.55, "text": "但又能如何?"}, {"start": 249.55, "end": 252.15, "text": "我只能让痛到最后的,"}, {"start": 252.15, "end": 254.92, "text": "不是我,"}, {"start": 254.92, "end": 264.03, "text": "是刘备。"}, {"start": 264.03, "end": 266.03, "text": "我早已不好阵势,"}, {"start": 266.03, "end": 269.43, "text": "只等曹操率军来援救定军山,"}, {"start": 269.43, "end": 271.83, "text": "为何他迟迟不救?"}, {"start": 271.83, "end": 275.63, "text": "难道要坐视夏侯院全筋覆膜?"}, {"start": 275.63, "end": 277.23, "text": "曹操用兵,"}, {"start": 277.23, "end": 279.23, "text": "经常出人意料。"}, {"start": 279.23, "end": 283.51, "text": "主公,"}, {"start": 283.51, "end": 285.51, "text": "定军山被攻下来了,"}, {"start": 285.51, "end": 287.11, "text": "曹军非死即降,"}, {"start": 287.11, "end": 289.71, "text": "我亲手斩了夏侯院的。"}, {"start": 292.31, "end": 294.51, "text": "恭喜黄老将军。"}, {"start": 294.51, "end": 295.51, "text": "恭喜黄老将军。"}, {"start": 295.51, "end": 297.31, "text": "竟有如此之神勇,"}, {"start": 297.31, "end": 299.31, "text": "在下是敬佩万分的。"}, {"start": 299.31, "end": 301.31, "text": "恭喜黄老将军。"}, {"start": 301.31, "end": 303.51, "text": "韩生。"}, {"start": 303.51, "end": 304.31, "text": "主公。"}, {"start": 304.31, "end": 305.31, "text": "你老当益壮,"}, {"start": 305.31, "end": 307.31, "text": "不让连坡。"}, {"start": 307.31, "end": 309.91, "text": "我即加封你为征东将军,"}, {"start": 309.91, "end": 311.11, "text": "上奏天子,"}, {"start": 311.11, "end": 312.31, "text": "为你赐决。"}, {"start": 312.31, "end": 314.31, "text": "谢主公。"}, {"start": 314.31, "end": 316.11, "text": "众将听令。"}, {"start": 316.11, "end": 318.11, "text": "在。"}, {"start": 318.11, "end": 320.11, "text": "曹军失了定军山,"}, {"start": 320.11, "end": 321.91, "text": "可谓大势已去。"}, {"start": 321.91, "end": 323.71, "text": "三军齐发汉中,"}, {"start": 323.71, "end": 325.51, "text": "与曹操决战。"}, {"start": 325.51, "end": 326.51, "text": "遵命。"}, {"start": 326.51, "end": 339.91, "text": "定军山失了。"}, {"start": 339.91, "end": 342.11, "text": "是。"}, {"start": 342.11, "end": 345.91, "text": "我军两万多将士全部阵亡。"}, {"start": 345.91, "end": 346.71, "text": "夏侯。"}, {"start": 346.71, "end": 350.26, "text": "不用说了。"}, {"start": 350.26, "end": 355.54, "text": "我知道什么结果。"}, {"start": 355.54, "end": 357.14, "text": "苗材是我兄弟。"}, {"start": 357.14, "end": 363.82, "text": "他绝不会做俘虏。"}, {"start": 363.82, "end": 364.82, "text": "请为王下令。"}, {"start": 364.82, "end": 366.62, "text": "我等愿与贼军决一死战,"}, {"start": 366.62, "end": 368.02, "text": "为夏侯将军报仇。"}, {"start": 368.02, "end": 369.02, "text": "请为王下令。"}, {"start": 369.02, "end": 370.62, "text": "是为夏侯将军报仇。"}, {"start": 370.62, "end": 371.62, "text": "请为王下令吧。"}, {"start": 371.62, "end": 373.02, "text": "请为王下令吧。"}, {"start": 373.02, "end": 386.01, "text": "为差人送来战表。"}, {"start": 386.01, "end": 387.61, "text": "梦得如物。"}, {"start": 387.61, "end": 389.61, "text": "今日我借军一言,"}, {"start": 389.61, "end": 391.81, "text": "请族下沐浴敬守,"}, {"start": 391.81, "end": 393.61, "text": "与我会列汉中。"}, {"start": 396.01, "end": 399.41, "text": "刘备皮肤如此猖狂,"}, {"start": 399.41, "end": 401.21, "text": "欺我太子。"}, {"start": 401.21, "end": 403.21, "text": "魏王息怒。"}, {"start": 403.21, "end": 414.79, "text": "刘备正是诱我军会战。"}, {"start": 414.79, "end": 417.59, "text": "刘备现在兵至何处了?"}, {"start": 417.59, "end": 418.79, "text": "先锋赵运皇中,"}, {"start": 418.79, "end": 420.39, "text": "已渡过魏河之边。"}, {"start": 420.39, "end": 421.79, "text": "刘备率三十万军,"}, {"start": 421.79, "end": 424.54, "text": "紧随其后。"}, {"start": 424.54, "end": 426.14, "text": "徐皇现在哪里?"}, {"start": 426.14, "end": 427.94, "text": "徐将军已搭好副脚,"}, {"start": 427.94, "end": 430.34, "text": "依印军渡过魏河。"}, {"start": 431.54, "end": 433.74, "text": "在西岸接应扎寨,"}, {"start": 433.74, "end": 436.14, "text": "徐将军御效韩信,"}, {"start": 436.14, "end": 438.54, "text": "至死地而后生。"}, {"start": 438.54, "end": 441.74, "text": "徐皇宝都兵书却不求甚解。"}, {"start": 441.74, "end": 443.14, "text": "也不想一想,"}, {"start": 443.14, "end": 445.14, "text": "当年韩信背水为战,"}, {"start": 445.14, "end": 446.74, "text": "是因为对手无谋。"}, {"start": 446.74, "end": 448.54, "text": "他现在面对的是刘备,"}, {"start": 448.54, "end": 452.07, "text": "诸葛亮。"}, {"start": 452.07, "end": 454.07, "text": "曹长现在哪里?"}, {"start": 454.07, "end": 455.87, "text": "三公子奉魏王命,"}, {"start": 455.87, "end": 458.07, "text": "零五万精气日夜兼程而来,"}, {"start": 458.07, "end": 462.34, "text": "现已邪骨等好。"}, {"start": 462.34, "end": 463.94, "text": "虎儿到了,"}, {"start": 463.94, "end": 467.98, "text": "我无后顾之忧了。"}, {"start": 467.98, "end": 469.38, "text": "你们且退,"}, {"start": 469.38, "end": 470.78, "text": "待我三思。"}, {"start": 470.78, "end": 471.98, "text": "遵命。"}, {"start": 480.94, "end": 482.34, "text": "你也退下。"}, {"start": 482.34, "end": 519.3, "text": "请魏王用膳。"}, {"start": 519.3, "end": 520.5, "text": "当之将军请示,"}, {"start": 520.5, "end": 522.5, "text": "今夜的口令是什么?"}, {"start": 522.5, "end": 523.7, "text": "鸡肋。"}, {"start": 523.7, "end": 528.54, "text": "诺,鸡肋。"}, {"start": 528.54, "end": 529.94, "text": "听好了,"}, {"start": 529.94, "end": 532.14, "text": "今夜口令为鸡肋,"}, {"start": 532.14, "end": 534.34, "text": "各少记务必严查巡视,"}, {"start": 534.34, "end": 535.74, "text": "防敌夜袭。"}, {"start": 535.74, "end": 541.38, "text": "诺。"}, {"start": 541.38, "end": 542.58, "text": "马上收拾行装,"}, {"start": 542.58, "end": 543.98, "text": "准备回城。"}, {"start": 543.98, "end": 545.78, "text": "遵命。"}, {"start": 545.78, "end": 546.98, "text": "杨先生。"}, {"start": 546.98, "end": 548.18, "text": "好。"}, {"start": 548.18, "end": 549.98, "text": "魏王正准备与敌决战,"}, {"start": 549.98, "end": 551.98, "text": "你怎么能让两官们收拾行装呢?"}, {"start": 551.98, "end": 552.78, "text": "好。"}, {"start": 552.78, "end": 553.98, "text": "我听魏王号令,"}, {"start": 553.98, "end": 555.78, "text": "已知他的心意了。"}, {"start": 555.78, "end": 557.18, "text": "所谓鸡肋者,"}, {"start": 557.18, "end": 558.38, "text": "实之无畏,"}, {"start": 558.38, "end": 559.78, "text": "弃之可惜。"}, {"start": 559.78, "end": 560.78, "text": "以此夺之,"}, {"start": 560.78, "end": 562.38, "text": "魏王必定退兵。"}, {"start": 562.38, "end": 563.58, "text": "两官早些准备,"}, {"start": 563.58, "end": 565.98, "text": "以免得临时慌张啊。"}, {"start": 565.98, "end": 568.58, "text": "快点,"}, {"start": 568.58, "end": 569.78, "text": "收拾一下,收拾一下。"}, {"start": 569.78, "end": 570.58, "text": "准备啊,"}, {"start": 570.58, "end": 575.39, "text": "都走快点。"}, {"start": 575.39, "end": 577.39, "text": "魏王。"}, {"start": 577.39, "end": 578.59, "text": "怎么回事?"}, {"start": 578.59, "end": 580.99, "text": "他们为什么在搭点心呢?"}, {"start": 581.59, "end": 582.59, "text": "回魏王,"}, {"start": 582.59, "end": 583.79, "text": "主部杨修说,"}, {"start": 583.79, "end": 585.59, "text": "魏王不日就会下令班师啊。"}, {"start": 585.59, "end": 586.99, "text": "他为何这么说?"}, {"start": 586.99, "end": 589.59, "text": "杨修听到今夜口令为鸡肋,"}, {"start": 589.59, "end": 590.39, "text": "便说,"}, {"start": 590.39, "end": 591.19, "text": "鸡肋者,"}, {"start": 591.19, "end": 591.79, "text": "实之无畏,"}, {"start": 591.79, "end": 593.19, "text": "弃之可惜。"}, {"start": 593.19, "end": 593.99, "text": "以此夺之,"}, {"start": 593.99, "end": 595.39, "text": "魏王定会下令班师。"}, {"start": 595.39, "end": 597.39, "text": "杨修匹夫,"}, {"start": 597.39, "end": 599.39, "text": "妄自猜测乱我军心。"}, {"start": 599.39, "end": 600.19, "text": "来人哪。"}, {"start": 600.19, "end": 600.59, "text": "在。"}, {"start": 600.59, "end": 601.39, "text": "立刻把他拿下,"}, {"start": 601.39, "end": 602.39, "text": "斩首之重。"}, {"start": 602.39, "end": 605.06, "text": "遵命。"}, {"start": 605.06, "end": 606.46, "text": "传命。"}, {"start": 606.46, "end": 607.86, "text": "装将齐聚大战,"}, {"start": 607.86, "end": 608.86, "text": "听令。"}, {"start": 608.86, "end": 611.65, "text": "诺。"}, {"start": 611.65, "end": 613.25, "text": "恭喜啊,将军。"}, {"start": 613.65, "end": 615.25, "text": "为何?"}, {"start": 615.25, "end": 618.25, "text": "因为你脑袋还在脖子上。"}, {"start": 618.25, "end": 619.65, "text": "沈为将军,"}, {"start": 619.65, "end": 620.65, "text": "不听魏王的,"}, {"start": 620.65, "end": 624.44, "text": "反而听杨修的。"}, {"start": 624.44, "end": 629.72, "text": "刘的脑袋何用?"}, {"start": 629.72, "end": 631.72, "text": "刘备连胜武阵,"}, {"start": 631.72, "end": 633.12, "text": "已称交兵,"}, {"start": 633.12, "end": 634.92, "text": "交兵必败。"}, {"start": 634.92, "end": 636.52, "text": "此意,"}, {"start": 636.52, "end": 638.72, "text": "是我与刘备的最后战役。"}, {"start": 638.72, "end": 639.92, "text": "胜了,"}, {"start": 639.92, "end": 642.12, "text": "刘备死无葬身之地。"}, {"start": 642.12, "end": 643.12, "text": "败了,"}, {"start": 643.12, "end": 645.52, "text": "我就是第二个元上。"}, {"start": 645.52, "end": 646.52, "text": "明日,"}, {"start": 646.52, "end": 647.92, "text": "武精造范,"}, {"start": 647.92, "end": 649.52, "text": "天亮启程,"}, {"start": 649.52, "end": 651.92, "text": "全军开往五界山布阵,"}, {"start": 651.92, "end": 653.52, "text": "迎战刘备。"}, {"start": 653.52, "end": 654.52, "text": "遵命。"}, {"start": 654.52, "end": 716.07, "text": "来者何人?"}, {"start": 717.07, "end": 719.07, "text": "汉皇后裔,"}, {"start": 719.07, "end": 722.07, "text": "刘备自玄德。"}, {"start": 722.67, "end": 724.87, "text": "孟德兄好健忘啊。"}, {"start": 726.67, "end": 729.07, "text": "原来是玄德先帝啊。"}, {"start": 729.87, "end": 732.87, "text": "这世上还有比你更健忘的人吗?"}, {"start": 733.67, "end": 736.07, "text": "当年讨伐董卓的时候,"}, {"start": 736.07, "end": 738.87, "text": "是谁把你扶进了十八路诸侯?"}, {"start": 738.87, "end": 741.67, "text": "你被吕布追杀得无路可逃的时候,"}, {"start": 741.67, "end": 744.27, "text": "又是谁将你收留?"}, {"start": 744.87, "end": 746.27, "text": "常言道,"}, {"start": 746.27, "end": 748.07, "text": "知恩必报,"}, {"start": 748.07, "end": 749.67, "text": "你却恩将仇报,"}, {"start": 749.67, "end": 751.07, "text": "背反朝廷,"}, {"start": 751.07, "end": 755.11, "text": "祸乱天下。"}, {"start": 755.11, "end": 757.62, "text": "曹操,"}, {"start": 757.62, "end": 759.82, "text": "你建位称王,"}, {"start": 759.82, "end": 761.62, "text": "篡汉自立,"}, {"start": 761.62, "end": 763.42, "text": "求君事后,"}, {"start": 763.42, "end": 765.02, "text": "屠戮忠良。"}, {"start": 765.02, "end": 767.22, "text": "每一个大汉子民,"}, {"start": 767.42, "end": 769.22, "text": "都恨不得食乳肉,"}, {"start": 769.22, "end": 770.82, "text": "勤乳皮。"}, {"start": 770.82, "end": 772.42, "text": "我今日,"}, {"start": 772.42, "end": 774.42, "text": "奉天子写诏,"}, {"start": 774.42, "end": 776.42, "text": "杀你报国。"}, {"start": 777.42, "end": 778.82, "text": "又一个,"}, {"start": 778.82, "end": 781.82, "text": "食肉勤皮的就没点新词吗?"}, {"start": 787.62, "end": 790.62, "text": "我身后有四十万大军,"}, {"start": 790.62, "end": 793.02, "text": "你若不降,"}, {"start": 793.02, "end": 800.76, "text": "今天就是你的忌日。"}, {"start": 800.76, "end": 803.16, "text": "曹孟德,"}, {"start": 803.16, "end": 806.27, "text": "今日之战,"}, {"start": 806.27, "end": 807.87, "text": "我朝思暮想,"}, {"start": 807.87, "end": 810.67, "text": "我汉了十八年,"}, {"start": 810.67, "end": 813.47, "text": "明年今天,"}, {"start": 813.47, "end": 816.87, "text": "我会到你的坟前祭拜。"}, {"start": 816.87, "end": 819.07, "text": "你真敢与我交战?"}, {"start": 819.07, "end": 947.87, "text": "你以为我在虚张声势吗?"}, {"start": 947.87, "end": 952.09, "text": "天黑之前,"}, {"start": 952.09, "end": 955.09, "text": "还有哪些敌将没有出现?"}, {"start": 955.09, "end": 956.89, "text": "禀魏王,"}, {"start": 956.89, "end": 960.49, "text": "马超和魏延还没有出现在战场上。"}, {"start": 960.49, "end": 961.49, "text": "报!"}, {"start": 961.49, "end": 962.09, "text": "禀魏王,"}, {"start": 962.09, "end": 963.89, "text": "马超引兵外渔从左翼杀至魏河,"}, {"start": 963.89, "end": 969.38, "text": "现已夺下我军福侨!"}, {"start": 969.38, "end": 971.98, "text": "我来就来,"}, {"start": 971.98, "end": 973.38, "text": "传令徐晃,"}, {"start": 973.38, "end": 975.38, "text": "请他率两营铁骑,"}, {"start": 975.38, "end": 976.78, "text": "迎战马超。"}, {"start": 976.78, "end": 978.78, "text": "遵命!"}, {"start": 978.78, "end": 981.38, "text": "报!"}, {"start": 981.38, "end": 981.98, "text": "魏王,"}, {"start": 981.98, "end": 983.18, "text": "魏延率数千战骑,"}, {"start": 983.18, "end": 984.98, "text": "已经攻下了我军粮草大营!"}, {"start": 984.98, "end": 986.78, "text": "慌什么?"}, {"start": 986.78, "end": 988.38, "text": "那是座空营,"}, {"start": 988.38, "end": 996.8, "text": "我儿曹章早就在那等着他了。"}, {"start": 996.8, "end": 1017.57, "text": "想什么呢你在?"}, {"start": 1017.57, "end": 1019.37, "text": "大将没有出现。"}, {"start": 1019.37, "end": 1024.66, "text": "谁?"}, {"start": 1024.66, "end": 1028.46, "text": "他不是应该在刘备和诸葛亮身边吗?"}, {"start": 1028.46, "end": 1030.26, "text": "确实如此,"}, {"start": 1030.26, "end": 1031.66, "text": "可是在下担心。"}, {"start": 1031.66, "end": 1033.46, "text": "担心什么?"}, {"start": 1033.46, "end": 1036.46, "text": "在下担心的是,"}, {"start": 1036.46, "end": 1039.86, "text": "魏王把所有的将军都派上了战场,"}, {"start": 1039.86, "end": 1043.66, "text": "诸葛亮为何留下赵云不用呢?"}, {"start": 1043.66, "end": 1045.26, "text": "话言之,"}, {"start": 1045.26, "end": 1047.66, "text": "如果赵云不出现的话,"}, {"start": 1047.66, "end": 1051.06, "text": "会不会在我们最薄弱的地方,"}, {"start": 1051.06, "end": 1052.46, "text": "突然出现呢?"}, {"start": 1052.46, "end": 1053.86, "text": "最薄弱的地方?"}, {"start": 1053.86, "end": 1059.3, "text": "率领战机,"}, {"start": 1059.3, "end": 1060.5, "text": "向我军带人上来了!"}, {"start": 1060.5, "end": 1061.5, "text": "请魏王快快上马!"}, {"start": 1061.5, "end": 1063.7, "text": "赵云冲我来啦!"}, {"start": 1063.7, "end": 1064.9, "text": "魏王快走吧!"}, {"start": 1064.9, "end": 1065.5, "text": "快上马,魏王!"}, {"start": 1065.5, "end": 1066.7, "text": "快走吧,魏王!"}, {"start": 1066.7, "end": 1076.14, "text": "我冲反了,"}, {"start": 1076.14, "end": 1077.94, "text": "头痛欲裂!"}, {"start": 1077.94, "end": 1081.14, "text": "魏王!"}, {"start": 1081.14, "end": 1110.73, "text": "叫司马一来!"}, {"start": 1110.73, "end": 1111.53, "text": "遵命!"}, {"start": 1111.53, "end": 1112.53, "text": "主公有令,"}, {"start": 1112.53, "end": 1114.33, "text": "叫司马一同同!"}, {"start": 1114.33, "end": 1137.34, "text": "我军损失二十五万至三十万,"}, {"start": 1137.34, "end": 1139.54, "text": "资中粮草尽失,"}, {"start": 1139.54, "end": 1141.74, "text": "刘备攻取汉中各城市,"}, {"start": 1141.74, "end": 1143.34, "text": "在魏王昏迷时,"}, {"start": 1143.74, "end": 1146.42, "text": "军情万起,"}, {"start": 1146.42, "end": 1151.02, "text": "臣便与承玉、曹璋、徐皇等商量后,"}, {"start": 1151.02, "end": 1153.22, "text": "替魏王下令撤军,"}, {"start": 1153.22, "end": 1156.82, "text": "现正在回徐昌的路上,"}, {"start": 1156.82, "end": 1158.22, "text": "臣越权行事,"}, {"start": 1158.22, "end": 1159.82, "text": "请魏王治罪!"}, {"start": 1159.82, "end": 1162.02, "text": "你们做得对!"}, {"start": 1162.02, "end": 1163.82, "text": "现在谁在断后?"}, {"start": 1163.82, "end": 1166.42, "text": "三公子曹璋亲率三万军马,"}, {"start": 1166.42, "end": 1168.82, "text": "服于邪谷一带,"}, {"start": 1168.82, "end": 1171.02, "text": "他此意极为应用,"}, {"start": 1171.02, "end": 1173.62, "text": "不下于赵云,"}, {"start": 1173.62, "end": 1175.62, "text": "刘备必不敢追杀。"}, {"start": 1175.62, "end": 1178.42, "text": "当初真应该听你的,"}, {"start": 1178.42, "end": 1180.22, "text": "杨洞与汉中,"}, {"start": 1180.22, "end": 1182.42, "text": "避免跟刘备作战,"}, {"start": 1182.42, "end": 1193.65, "text": "辉石南下直取荆州,"}, {"start": 1193.65, "end": 1195.25, "text": "你说刘备,"}, {"start": 1195.25, "end": 1197.25, "text": "下一步会有什么企图?"}, {"start": 1197.25, "end": 1199.65, "text": "刘备攻取汉中以后,"}, {"start": 1199.65, "end": 1202.45, "text": "必效仿高祖刘邦,"}, {"start": 1202.45, "end": 1203.45, "text": "辉石中原,"}, {"start": 1203.45, "end": 1205.65, "text": "居高临下,"}, {"start": 1205.65, "end": 1207.85, "text": "先攻取徐昌、洛阳,"}, {"start": 1207.85, "end": 1213.99, "text": "进而进取天下。"}, {"start": 1213.99, "end": 1215.99, "text": "你说,"}, {"start": 1215.99, "end": 1223.36, "text": "我会成为第二个袁绍吗?"}, {"start": 1223.36, "end": 1224.56, "text": "误会。"}, {"start": 1224.56, "end": 1225.56, "text": "说实话。"}, {"start": 1225.56, "end": 1226.76, "text": "臣说的是实话。"}, {"start": 1226.76, "end": 1227.56, "text": "为何?"}, {"start": 1227.56, "end": 1230.36, "text": "此意刘备虽大胜,"}, {"start": 1230.36, "end": 1231.76, "text": "但他粮草共浅,"}, {"start": 1231.76, "end": 1234.63, "text": "托制千里,"}, {"start": 1234.63, "end": 1236.03, "text": "数粮运至汉中,"}, {"start": 1236.03, "end": 1237.63, "text": "非一月不至。"}, {"start": 1237.63, "end": 1239.23, "text": "还有,"}, {"start": 1239.23, "end": 1241.03, "text": "刘备此意伤亡不少,"}, {"start": 1241.03, "end": 1243.63, "text": "急需修正。"}, {"start": 1243.63, "end": 1245.83, "text": "臣估计三个月乃至半年内"}, {"start": 1245.83, "end": 1247.23, "text": "不会有大战。"}, {"start": 1247.23, "end": 1248.83, "text": "再者,"}, {"start": 1248.83, "end": 1251.03, "text": "魏王此意随败,"}, {"start": 1251.03, "end": 1254.23, "text": "但中原各州仍有三十万旧决,"}, {"start": 1254.23, "end": 1255.43, "text": "加之曹人,"}, {"start": 1255.43, "end": 1256.83, "text": "樊城、襄阳两地,"}, {"start": 1256.83, "end": 1258.43, "text": "仍住有十万精锐,"}, {"start": 1258.43, "end": 1260.23, "text": "丝毫未动。"}, {"start": 1260.23, "end": 1262.03, "text": "那你有何良策?"}, {"start": 1262.03, "end": 1263.43, "text": "魏王安心修养,"}, {"start": 1263.43, "end": 1264.63, "text": "日后再议吧。"}, {"start": 1264.63, "end": 1265.83, "text": "现在就说,"}, {"start": 1265.83, "end": 1269.07, "text": "快。"}, {"start": 1269.07, "end": 1270.47, "text": "臣愚钝,"}, {"start": 1270.47, "end": 1272.87, "text": "并无什么良策。"}, {"start": 1272.87, "end": 1274.27, "text": "魏王非让臣说,"}, {"start": 1274.27, "end": 1276.47, "text": "臣还是先前那句话,"}, {"start": 1276.47, "end": 1277.67, "text": "致输孙权,"}, {"start": 1277.67, "end": 1281.29, "text": "约他攻取荆州。"}, {"start": 1281.29, "end": 1282.29, "text": "可是上次,"}, {"start": 1282.29, "end": 1284.29, "text": "我借了他几十万粮草,"}, {"start": 1284.29, "end": 1285.69, "text": "他却言而无信,"}, {"start": 1285.69, "end": 1287.49, "text": "并没有举逼。"}, {"start": 1287.49, "end": 1290.49, "text": "上次魏王刘备胜负未分,"}, {"start": 1290.49, "end": 1292.09, "text": "孙权想坐观成效,"}, {"start": 1292.09, "end": 1294.29, "text": "坐收余力。"}, {"start": 1294.29, "end": 1295.89, "text": "这次不同了,"}, {"start": 1295.89, "end": 1298.29, "text": "魏王大败而刘备大胜,"}, {"start": 1298.29, "end": 1301.46, "text": "对孙权而言,"}, {"start": 1301.46, "end": 1305.4, "text": "最可怕的敌人现在不是魏王,"}, {"start": 1305.4, "end": 1329.65, "text": "而是刘备。"}, {"start": 1329.65, "end": 1332.05, "text": "各位将军辛苦了,"}, {"start": 1332.05, "end": 1333.25, "text": "我敬各位一尊。"}, {"start": 1333.25, "end": 1342.02, "text": "头贼,"}, {"start": 1342.02, "end": 1344.62, "text": "这回是兵败如山倒啊。"}, {"start": 1344.62, "end": 1347.82, "text": "四十万大军是不堪一击,"}, {"start": 1347.82, "end": 1351.42, "text": "就连他的帅旗都被我们给夺下来了,"}, {"start": 1351.42, "end": 1354.62, "text": "我是一直追杀到邪谷啊,"}, {"start": 1354.62, "end": 1357.62, "text": "又不是曹操那个狗儿子曹章,"}, {"start": 1357.62, "end": 1360.62, "text": "拼死挡我,"}, {"start": 1360.62, "end": 1363.82, "text": "曹操的狗头早就被我摘下来了。"}, {"start": 1363.82, "end": 1366.42, "text": "曹军这次是锐气夺劲的,"}, {"start": 1366.42, "end": 1368.02, "text": "被扶的兵族说,"}, {"start": 1368.02, "end": 1369.22, "text": "曹操中箭,"}, {"start": 1369.22, "end": 1374.24, "text": "差点是丧命了。"}, {"start": 1374.24, "end": 1375.24, "text": "禀报主公,"}, {"start": 1375.24, "end": 1376.84, "text": "刘丰、孟达、王平三将,"}, {"start": 1376.84, "end": 1378.24, "text": "已攻取上庸诸君,"}, {"start": 1378.24, "end": 1379.24, "text": "汉中全境,"}, {"start": 1379.24, "end": 1380.44, "text": "见归主公了。"}, {"start": 1380.44, "end": 1381.84, "text": "好啊,"}, {"start": 1381.84, "end": 1383.04, "text": "兄长,"}, {"start": 1383.04, "end": 1386.44, "text": "你已经是坐拥半地天下了。"}, {"start": 1386.44, "end": 1390.44, "text": "恭喜主公,"}, {"start": 1390.44, "end": 1392.84, "text": "都是列位之功,"}, {"start": 1392.84, "end": 1394.64, "text": "只曹操未死,"}, {"start": 1394.64, "end": 1396.84, "text": "许昌未下,"}, {"start": 1396.84, "end": 1400.64, "text": "我等仍不可懈怠。"}, {"start": 1400.64, "end": 1401.44, "text": "来,"}, {"start": 1401.44, "end": 1404.24, "text": "我等共敬主公一杯。"}, {"start": 1404.24, "end": 1405.64, "text": "好,"}, {"start": 1405.64, "end": 1417.38, "text": "敬敬主公。"}, {"start": 1417.38, "end": 1420.98, "text": "主公仁义住于四海,"}, {"start": 1420.98, "end": 1422.78, "text": "又是皇室正统,"}, {"start": 1422.78, "end": 1425.38, "text": "更拂有两川之地于荆州,"}, {"start": 1425.38, "end": 1426.58, "text": "代价百万,"}, {"start": 1426.58, "end": 1429.18, "text": "上将千元,"}, {"start": 1429.18, "end": 1430.78, "text": "天下大势,"}, {"start": 1430.78, "end": 1435.0, "text": "已归于主公了。"}, {"start": 1435.0, "end": 1436.6, "text": "敢请主公敬汉中王,"}, {"start": 1436.6, "end": 1437.8, "text": "之后召天下本领,"}, {"start": 1437.8, "end": 1438.6, "text": "共讨操贼,"}, {"start": 1438.6, "end": 1440.8, "text": "一统天下。"}, {"start": 1440.8, "end": 1443.0, "text": "说得好。"}, {"start": 1443.0, "end": 1445.61, "text": "孝侄,"}, {"start": 1445.61, "end": 1447.01, "text": "此言差矣,"}, {"start": 1447.01, "end": 1450.21, "text": "天子仍困于许昌,"}, {"start": 1450.21, "end": 1452.81, "text": "刘备如不思救驾,"}, {"start": 1452.81, "end": 1454.81, "text": "反而自立,"}, {"start": 1454.81, "end": 1458.41, "text": "岂不跟曹操一样了吗?"}, {"start": 1458.41, "end": 1460.21, "text": "建居尊位的事,"}, {"start": 1460.21, "end": 1462.21, "text": "我不能做。"}, {"start": 1462.21, "end": 1465.21, "text": "此事万万不要再提了。"}, {"start": 1465.21, "end": 1466.61, "text": "请主公及王位,"}, {"start": 1466.61, "end": 1467.61, "text": "如再推却,"}, {"start": 1467.61, "end": 1469.21, "text": "我等不答应。"}, {"start": 1469.21, "end": 1478.65, "text": "请主公及王位。"}, {"start": 1478.65, "end": 1480.65, "text": "主公庭生,"}, {"start": 1480.65, "end": 1483.05, "text": "以义为本,"}, {"start": 1483.05, "end": 1484.85, "text": "无天子召,"}, {"start": 1484.85, "end": 1488.53, "text": "主公绝不肯自立为王。"}, {"start": 1488.53, "end": 1490.13, "text": "依我之见,"}, {"start": 1490.13, "end": 1493.13, "text": "众文武的心意不可为。"}, {"start": 1493.13, "end": 1496.13, "text": "请主公敬畏汉中王。"}, {"start": 1496.13, "end": 1503.26, "text": "各位尊我为王,"}, {"start": 1503.26, "end": 1509.3, "text": "令被感激不已。"}, {"start": 1509.3, "end": 1512.3, "text": "没有天子明诏,"}, {"start": 1512.3, "end": 1514.5, "text": "我这可是僭越。"}, {"start": 1514.5, "end": 1515.7, "text": "主公,"}, {"start": 1515.7, "end": 1518.1, "text": "高祖早有一言,"}, {"start": 1518.1, "end": 1519.9, "text": "非刘氏称王者,"}, {"start": 1519.9, "end": 1521.5, "text": "天下共诛之,"}, {"start": 1521.5, "end": 1522.9, "text": "曹操是异性贼,"}, {"start": 1522.9, "end": 1524.5, "text": "尚且做了位王。"}, {"start": 1524.5, "end": 1526.7, "text": "主公乃汉氏正宗,"}, {"start": 1526.7, "end": 1528.1, "text": "做个汉中王,"}, {"start": 1528.1, "end": 1529.9, "text": "又有何不可?"}, {"start": 1529.9, "end": 1531.9, "text": "说得好,"}, {"start": 1531.9, "end": 1534.3, "text": "哥哥就别说是做王了,"}, {"start": 1534.3, "end": 1535.9, "text": "就是哥哥做了皇帝,"}, {"start": 1535.9, "end": 1541.31, "text": "又有何不可?"}, {"start": 1541.31, "end": 1543.71, "text": "主公应遗从权便,"}, {"start": 1543.71, "end": 1545.71, "text": "先敬畏汉中王,"}, {"start": 1545.71, "end": 1547.51, "text": "然后裱奏天子,"}, {"start": 1547.51, "end": 1551.98, "text": "也未迟矣。"}, {"start": 1551.98, "end": 1556.65, "text": "那就以军师所言吧。"}, {"start": 1559.25, "end": 1564.45, "text": "臣法正参见汉中王。"}, {"start": 1564.45, "end": 1598.38, "text": "参见汉中王。"}, {"start": 1598.38, "end": 1599.78, "text": "好久没有听到先生"}, {"start": 1599.78, "end": 1601.38, "text": "弹奏这支琴曲了。"}, {"start": 1601.38, "end": 1605.46, "text": "是啊,"}, {"start": 1605.46, "end": 1608.06, "text": "手都生了。"}, {"start": 1608.06, "end": 1609.86, "text": "先生,"}, {"start": 1609.86, "end": 1612.46, "text": "好像有心事。"}, {"start": 1612.46, "end": 1614.66, "text": "刘长啊,"}, {"start": 1614.66, "end": 1616.66, "text": "昨天,"}, {"start": 1616.66, "end": 1619.46, "text": "已经有人拥主公为弟了。"}, {"start": 1619.46, "end": 1620.86, "text": "我感觉到,"}, {"start": 1620.86, "end": 1622.66, "text": "不仅众将有此心。"}, {"start": 1622.66, "end": 1629.53, "text": "不许胡说。"}, {"start": 1629.53, "end": 1632.13, "text": "在下失言。"}, {"start": 1632.13, "end": 1633.53, "text": "学生想说的是,"}, {"start": 1633.53, "end": 1634.73, "text": "如此大盛,"}, {"start": 1634.73, "end": 1637.13, "text": "已经让好些文武忘无所以。"}, {"start": 1637.13, "end": 1640.06, "text": "是啊,"}, {"start": 1640.06, "end": 1641.06, "text": "以前我们经历了"}, {"start": 1641.06, "end": 1642.86, "text": "那么多的失败,"}, {"start": 1642.86, "end": 1645.26, "text": "我都不曾感到恐惧。"}, {"start": 1645.26, "end": 1647.46, "text": "而今天的大盛,"}, {"start": 1647.46, "end": 1648.46, "text": "却让我感到"}, {"start": 1648.46, "end": 1650.26, "text": "前所未有的忧虑。"}, {"start": 1650.26, "end": 1652.66, "text": "先生之所虑,"}, {"start": 1652.66, "end": 1655.66, "text": "正是学生之所想啊。"}, {"start": 1655.66, "end": 1658.86, "text": "你听听那狂欢之声,"}, {"start": 1658.86, "end": 1661.66, "text": "悠悠青史告诉我们,"}, {"start": 1661.66, "end": 1663.26, "text": "危险,"}, {"start": 1663.26, "end": 1666.06, "text": "总在狂欢时逼近。"}, {"start": 1666.06, "end": 1668.86, "text": "而让我忧虑的却是,"}, {"start": 1668.86, "end": 1679.67, "text": "我不知道这危险是从何而来。"}, {"start": 1679.67, "end": 1681.47, "text": "主公已攻起汉中,"}, {"start": 1681.47, "end": 1683.27, "text": "还尽位为"}, {"start": 1683.27, "end": 1685.47, "text": "汉中王。"}, {"start": 1685.47, "end": 1688.47, "text": "好啊,"}, {"start": 1688.47, "end": 1689.67, "text": "下一步,"}, {"start": 1689.67, "end": 1691.07, "text": "主公必亲率"}, {"start": 1691.07, "end": 1692.67, "text": "百万大军,"}, {"start": 1692.67, "end": 1693.87, "text": "挥师东上,"}, {"start": 1693.87, "end": 1696.27, "text": "一举拿下洛阳许昌。"}, {"start": 1696.27, "end": 1699.07, "text": "草草大势已去,"}, {"start": 1699.07, "end": 1701.27, "text": "不出一年,"}, {"start": 1701.27, "end": 1706.18, "text": "天下必然大定。"}, {"start": 1706.18, "end": 1706.78, "text": "父亲,"}, {"start": 1706.78, "end": 1708.38, "text": "我们该如何行动?"}, {"start": 1708.38, "end": 1709.78, "text": "先挥师北上,"}, {"start": 1709.78, "end": 1711.38, "text": "攻取藩城,"}, {"start": 1711.38, "end": 1713.58, "text": "然后等我"}, {"start": 1713.58, "end": 1715.38, "text": "和主公南北相击,"}, {"start": 1715.38, "end": 1718.83, "text": "挥师在许昌城下。"}, {"start": 1718.83, "end": 1720.83, "text": "君侯,"}, {"start": 1720.83, "end": 1723.23, "text": "藩城本是一座尖城,"}, {"start": 1723.23, "end": 1724.83, "text": "那里更有大将曹仁"}, {"start": 1724.83, "end": 1727.43, "text": "率十万重兵驻防,"}, {"start": 1727.43, "end": 1728.83, "text": "那里形势险要,"}, {"start": 1728.83, "end": 1731.03, "text": "易守难攻,"}, {"start": 1731.03, "end": 1732.23, "text": "而曹仁"}, {"start": 1732.23, "end": 1733.43, "text": "志勇皆备,"}, {"start": 1733.43, "end": 1735.83, "text": "惯于打硬仗恶仗。"}, {"start": 1735.83, "end": 1737.23, "text": "五年前,"}, {"start": 1737.23, "end": 1739.43, "text": "他在极其不利的情况下,"}, {"start": 1739.43, "end": 1747.29, "text": "差点射死周瑜。"}, {"start": 1747.29, "end": 1750.78, "text": "此话什么意思?"}, {"start": 1750.78, "end": 1752.38, "text": "军师入川前"}, {"start": 1752.38, "end": 1753.78, "text": "再三嘱咐我们,"}, {"start": 1753.78, "end": 1755.78, "text": "坚守京中,"}, {"start": 1755.78, "end": 1757.38, "text": "不可轻动。"}, {"start": 1757.38, "end": 1758.58, "text": "再说,"}, {"start": 1758.58, "end": 1760.58, "text": "主公并没有令我们"}, {"start": 1760.58, "end": 1762.18, "text": "攻取藩城。"}, {"start": 1762.18, "end": 1764.38, "text": "你就只听诸葛亮的话,"}, {"start": 1764.38, "end": 1765.78, "text": "主公随吴明命"}, {"start": 1765.78, "end": 1767.78, "text": "命我攻取藩城,"}, {"start": 1767.78, "end": 1770.38, "text": "他让我以京中为戒,"}, {"start": 1770.38, "end": 1772.18, "text": "伺机而动。"}, {"start": 1772.18, "end": 1773.38, "text": "藩城"}, {"start": 1773.38, "end": 1775.78, "text": "是曹操中原重镇,"}, {"start": 1775.78, "end": 1777.98, "text": "一直阻挡我们北上,"}, {"start": 1777.98, "end": 1780.58, "text": "岂能不拔指。"}, {"start": 1780.58, "end": 1782.38, "text": "再说,"}, {"start": 1782.38, "end": 1784.18, "text": "毕德和子龙在汉中"}, {"start": 1784.18, "end": 1785.98, "text": "已经立了大功。"}, {"start": 1785.98, "end": 1786.98, "text": "诸位将军,"}, {"start": 1786.98, "end": 1787.98, "text": "难道你们"}, {"start": 1787.98, "end": 1789.58, "text": "就甘心坐在京中"}, {"start": 1789.58, "end": 1791.58, "text": "看着别人杀敌立功吗?"}, {"start": 1791.58, "end": 1792.58, "text": "攻取藩城,"}, {"start": 1792.58, "end": 1794.38, "text": "与主公会师许长成家。"}, {"start": 1794.38, "end": 1795.58, "text": "莫将愿当先报!"}, {"start": 1795.58, "end": 1796.58, "text": "莫将愿当先报!"}, {"start": 1796.58, "end": 1797.58, "text": "莫将愿当先报!"}, {"start": 1797.58, "end": 1798.58, "text": "攻取藩城!"}, {"start": 1798.58, "end": 1799.58, "text": "副使人,"}, {"start": 1799.58, "end": 1801.58, "text": "民方听令。"}, {"start": 1801.58, "end": 1802.58, "text": "莫将在!"}, {"start": 1802.58, "end": 1803.58, "text": "命你二人"}, {"start": 1803.58, "end": 1805.58, "text": "同两万精兵为先锋"}, {"start": 1805.58, "end": 1806.58, "text": "明日出发,"}, {"start": 1806.58, "end": 1808.58, "text": "先去襄阳,"}, {"start": 1808.58, "end": 1810.58, "text": "等我大军一到,"}, {"start": 1810.58, "end": 1812.58, "text": "再去藩城。"}, {"start": 1812.58, "end": 1813.58, "text": "遵命!"}, {"start": 1813.58, "end": 1821.69, "text": "大吏请话!"}, {"start": 1821.69, "end": 1822.69, "text": "将军,"}, {"start": 1822.69, "end": 1823.69, "text": "副使人民方半夜饮酒"}, {"start": 1823.69, "end": 1824.69, "text": "不是引起冰胀大火,"}, {"start": 1824.69, "end": 1826.69, "text": "现已燃了半个军营了。"}, {"start": 1826.69, "end": 1828.69, "text": "他们二人明日就要出征,"}, {"start": 1828.69, "end": 1830.69, "text": "今天还在饮酒?"}, {"start": 1830.69, "end": 1831.69, "text": "快快调集兵马,"}, {"start": 1831.69, "end": 1832.69, "text": "前去救火。"}, {"start": 1832.69, "end": 1833.69, "text": "少将军已经带了五千人,"}, {"start": 1833.69, "end": 1834.69, "text": "前去救火。"}, {"start": 1834.69, "end": 1835.69, "text": "升帐!"}, {"start": 1835.69, "end": 1837.69, "text": "拿下副使人民方!"}, {"start": 1837.69, "end": 1838.69, "text": "诺!"}, {"start": 1838.69, "end": 1856.22, "text": "是从你二人帐里燃起的?"}, {"start": 1856.22, "end": 1858.22, "text": "都是莫将疏忽。"}, {"start": 1860.22, "end": 1861.22, "text": "疏?"}, {"start": 1861.22, "end": 1864.59, "text": "我命你二人为先锋,"}, {"start": 1864.59, "end": 1865.59, "text": "未曾出发,"}, {"start": 1865.59, "end": 1866.59, "text": "先起大火,"}, {"start": 1866.59, "end": 1868.59, "text": "如此无事,"}, {"start": 1868.59, "end": 1870.59, "text": "要二人等何用?"}, {"start": 1870.59, "end": 1872.59, "text": "推进去!"}, {"start": 1872.59, "end": 1873.59, "text": "战!"}, {"start": 1873.59, "end": 1874.59, "text": "诺!"}, {"start": 1874.59, "end": 1875.59, "text": "将军饶命!"}, {"start": 1875.59, "end": 1876.59, "text": "将军饶命!"}, {"start": 1876.59, "end": 1877.59, "text": "将军饶命!"}, {"start": 1877.59, "end": 1878.59, "text": "将军饶命!"}, {"start": 1878.59, "end": 1879.59, "text": "我将再也不敢了!"}, {"start": 1879.59, "end": 1880.59, "text": "继皇,"}, {"start": 1880.59, "end": 1882.59, "text": "大军尚未曾出师,"}, {"start": 1882.59, "end": 1883.59, "text": "先斩先锋,"}, {"start": 1883.59, "end": 1885.59, "text": "于君不利啊。"}, {"start": 1885.59, "end": 1887.59, "text": "还请将军念其旧功,"}, {"start": 1887.59, "end": 1889.59, "text": "暂免一死,"}, {"start": 1889.59, "end": 1890.59, "text": "令其二人在阵前"}, {"start": 1890.59, "end": 1892.59, "text": "戴罪立功。"}, {"start": 1892.59, "end": 1894.59, "text": "求将军宽恕,"}, {"start": 1894.59, "end": 1896.59, "text": "穆将愿以杀敌减功啊!"}, {"start": 1896.59, "end": 1897.59, "text": "如此无事,"}, {"start": 1897.59, "end": 1898.59, "text": "怎为先锋?"}, {"start": 1898.59, "end": 1901.59, "text": "我只看在继常的面上。"}, {"start": 1901.59, "end": 1904.9, "text": "传令下去,"}, {"start": 1904.9, "end": 1912.75, "text": "每人重责四十大板,"}, {"start": 1912.75, "end": 1914.75, "text": "军将三职。"}, {"start": 1914.75, "end": 1916.75, "text": "一方守南郡,"}, {"start": 1916.75, "end": 1918.75, "text": "副使人守公安,"}, {"start": 1918.75, "end": 1920.75, "text": "再有差池,"}, {"start": 1920.75, "end": 1922.75, "text": "二罪并罚!"}, {"start": 1922.75, "end": 1924.75, "text": "谢将军不杀之人!"}, {"start": 1924.75, "end": 1926.75, "text": "谢将军不杀之人!"}, {"start": 1926.75, "end": 1928.75, "text": "谢将军不杀之人!"}, {"start": 1928.75, "end": 1929.75, "text": "继皇啊,"}, {"start": 1929.75, "end": 1935.38, "text": "南郡公安皆乃要法,"}, {"start": 1935.38, "end": 1938.88, "text": "君侯若不愿让弥方副使人"}, {"start": 1938.88, "end": 1940.88, "text": "在阵前效力,"}, {"start": 1940.88, "end": 1942.88, "text": "也不该把这两个要法之地"}, {"start": 1942.88, "end": 1944.88, "text": "交给他们去守。"}, {"start": 1944.88, "end": 1947.88, "text": "只怕再出差池啊。"}, {"start": 1947.88, "end": 1949.88, "text": "大晋既要北征,"}, {"start": 1949.88, "end": 1953.8, "text": "正是用人之计。"}, {"start": 1953.8, "end": 1955.8, "text": "此案人虽然有些粗心,"}, {"start": 1955.8, "end": 1957.8, "text": "但是作战尚且勇猛。"}, {"start": 1957.8, "end": 1961.8, "text": "对付江东那些鼠辈足矣。"}, {"start": 1961.8, "end": 1962.8, "text": "在下,"}, {"start": 1962.8, "end": 1969.83, "text": "还请君侯三思。"}, {"start": 1969.83, "end": 1970.83, "text": "不必多礼,"}, {"start": 1970.83, "end": 1972.83, "text": "此事就这么定了。"}, {"start": 1972.83, "end": 1974.83, "text": "官平调划听令!"}, {"start": 1974.83, "end": 1975.83, "text": "在!"}, {"start": 1975.83, "end": 1979.56, "text": "命你二人为先锋,"}, {"start": 1979.56, "end": 1981.56, "text": "明早出发,"}, {"start": 1981.56, "end": 1983.56, "text": "如有差池,"}, {"start": 1983.56, "end": 1984.56, "text": "定斩不赦!"}, {"start": 1984.56, "end": 1985.56, "text": "遵命!"}, {"start": 1985.56, "end": 1987.56, "text": "昨日揭报,"}, {"start": 1987.56, "end": 2004.48, "text": "关羽突然发兵北藩,"}, {"start": 2004.48, "end": 2006.48, "text": "破了襄阳,"}, {"start": 2006.48, "end": 2008.48, "text": "现为凡城甚急。"}, {"start": 2008.48, "end": 2011.48, "text": "曹人来信求援,"}, {"start": 2011.48, "end": 2013.48, "text": "凡城几乎是"}, {"start": 2014.48, "end": 2017.48, "text": "凡城乃我中原重镇,"}, {"start": 2017.48, "end": 2019.48, "text": "万不容失。"}, {"start": 2019.48, "end": 2024.33, "text": "列为将军,"}, {"start": 2024.33, "end": 2026.33, "text": "谁愿以领一支军"}, {"start": 2026.33, "end": 2027.33, "text": "出战关羽,"}, {"start": 2027.33, "end": 2029.33, "text": "借凡城之为案?"}, {"start": 2037.47, "end": 2038.47, "text": "看来,"}, {"start": 2038.47, "end": 2041.47, "text": "经过汉中大败,"}, {"start": 2041.47, "end": 2044.47, "text": "无人愿意出征了。"}, {"start": 2045.47, "end": 2046.47, "text": "好吧,"}, {"start": 2046.47, "end": 2048.47, "text": "那我就点将吧。"}, {"start": 2048.47, "end": 2050.78, "text": "羽敬,"}, {"start": 2050.78, "end": 2054.03, "text": "末将在!"}, {"start": 2054.03, "end": 2057.03, "text": "各位将军都刚从汉中归来,"}, {"start": 2057.03, "end": 2058.03, "text": "各有伤情,"}, {"start": 2058.03, "end": 2060.03, "text": "你是我的上将,"}, {"start": 2060.03, "end": 2062.03, "text": "多年未曾出战,"}, {"start": 2062.03, "end": 2064.03, "text": "此意你去如何?"}, {"start": 2064.03, "end": 2069.9, "text": "禀威王,"}, {"start": 2069.9, "end": 2071.9, "text": "自西梁之战后,"}, {"start": 2071.9, "end": 2072.9, "text": "末将奉命屯田,"}, {"start": 2072.9, "end": 2074.9, "text": "九叔阵战,"}, {"start": 2074.9, "end": 2076.9, "text": "只怕会误了"}, {"start": 2076.9, "end": 2077.9, "text": "威王的大事。"}, {"start": 2077.9, "end": 2078.9, "text": "什么话?"}, {"start": 2078.9, "end": 2080.9, "text": "当将军的只知道屯田"}, {"start": 2080.9, "end": 2082.9, "text": "还能叫将军吗?"}, {"start": 2083.9, "end": 2086.9, "text": "你从前不是也打过许多恶仗,"}, {"start": 2086.9, "end": 2088.9, "text": "见过许多功训吗?"}, {"start": 2088.9, "end": 2091.9, "text": "那都是卫王在阵前指点的,"}, {"start": 2091.9, "end": 2093.9, "text": "而这次,"}, {"start": 2093.9, "end": 2095.9, "text": "关羽成名汉将,"}, {"start": 2095.9, "end": 2096.9, "text": "威震天下,"}, {"start": 2096.9, "end": 2098.9, "text": "末将担心。"}, {"start": 2098.9, "end": 2102.31, "text": "你为什么不反过来想想呢?"}, {"start": 2102.31, "end": 2104.31, "text": "你如果斩了关羽,"}, {"start": 2104.31, "end": 2106.31, "text": "你不就威震天下了吗?"}, {"start": 2106.31, "end": 2110.17, "text": "末将遵命,"}, {"start": 2110.17, "end": 2113.17, "text": "请卫王再派一员将军为先锋,"}, {"start": 2113.17, "end": 2115.17, "text": "随我出战关羽。"}, {"start": 2116.17, "end": 2118.17, "text": "谁愿意做这个先锋官呀?"}, {"start": 2118.17, "end": 2128.78, "text": "看来汉中小败几仗,"}, {"start": 2129.78, "end": 2133.78, "text": "列卫都不愿意打仗,"}, {"start": 2133.78, "end": 2135.78, "text": "都怕了。"}, {"start": 2135.78, "end": 2136.78, "text": "是吗?"}, {"start": 2136.78, "end": 2140.93, "text": "那好吧,"}, {"start": 2140.93, "end": 2142.93, "text": "就让我这个老朽,"}, {"start": 2142.93, "end": 2145.93, "text": "去给于敬将军当这个先锋官吧。"}, {"start": 2145.93, "end": 2147.93, "text": "我此去,"}, {"start": 2147.93, "end": 2150.93, "text": "定会与关羽一命相补。"}, {"start": 2150.93, "end": 2151.93, "text": "列卫,"}, {"start": 2151.93, "end": 2153.93, "text": "就请坐毕上官吧。"}, {"start": 2154.93, "end": 2155.93, "text": "卫王,"}, {"start": 2155.93, "end": 2160.46, "text": "末将愿为先锋,"}, {"start": 2160.46, "end": 2162.46, "text": "誓秦关羽,"}, {"start": 2162.46, "end": 2163.46, "text": "欠于婚下。"}, {"start": 2164.46, "end": 2165.46, "text": "庞德,"}, {"start": 2165.46, "end": 2167.86, "text": "好。"}, {"start": 2168.86, "end": 2170.86, "text": "看来我军中,"}, {"start": 2170.86, "end": 2173.86, "text": "还有一个人没有被关羽吓破胆。"}, {"start": 2174.86, "end": 2175.86, "text": "庞德,"}, {"start": 2175.86, "end": 2177.86, "text": "我且问你,"}, {"start": 2177.86, "end": 2178.86, "text": "那关羽,"}, {"start": 2178.86, "end": 2180.86, "text": "威震天下,"}, {"start": 2180.86, "end": 2182.86, "text": "十多年未逢对手,"}, {"start": 2182.86, "end": 2184.86, "text": "莫非你不惧他?"}, {"start": 2184.86, "end": 2185.86, "text": "那关羽是人,"}, {"start": 2185.86, "end": 2187.86, "text": "我也是人,"}, {"start": 2187.86, "end": 2189.86, "text": "那关羽有刀,"}, {"start": 2189.86, "end": 2191.86, "text": "我也有刀,"}, {"start": 2191.86, "end": 2193.86, "text": "我何惧之有?"}, {"start": 2194.86, "end": 2196.86, "text": "卫王何不问问,"}, {"start": 2196.86, "end": 2199.86, "text": "那关羽惧我否?"}, {"start": 2200.86, "end": 2201.86, "text": "好!"}, {"start": 2202.86, "end": 2203.86, "text": "庞德,"}, {"start": 2204.86, "end": 2206.86, "text": "就冲你这份豪气,"}, {"start": 2207.86, "end": 2209.86, "text": "我赏你进爵两机,"}, {"start": 2209.86, "end": 2211.86, "text": "令你为先锋,"}, {"start": 2211.86, "end": 2212.86, "text": "与于晋,"}, {"start": 2212.86, "end": 2214.86, "text": "同率八万军,"}, {"start": 2214.86, "end": 2215.86, "text": "前往樊城,"}, {"start": 2215.86, "end": 2217.86, "text": "出战关羽。"}, {"start": 2217.86, "end": 2220.86, "text": "我会自提二十万人马,"}, {"start": 2220.86, "end": 2222.86, "text": "为你们的后援。"}, {"start": 2222.86, "end": 2223.86, "text": "遵命!"}, {"start": 2223.86, "end": 2228.46, "text": "受于晋,"}, {"start": 2228.46, "end": 2229.46, "text": "上将军印,"}, {"start": 2229.46, "end": 2231.46, "text": "受庞德,"}, {"start": 2231.46, "end": 2233.46, "text": "先锋副将印。"}, {"start": 2234.46, "end": 2236.46, "text": "都退了吧,"}, {"start": 2236.46, "end": 2237.46, "text": "明日,"}, {"start": 2237.46, "end": 2238.46, "text": "我会舍酒,"}, {"start": 2238.46, "end": 2240.46, "text": "为两位将军送进。"}, {"start": 2240.46, "end": 2254.9, "text": "于晋,"}, {"start": 2254.9, "end": 2256.9, "text": "你还有何事吗?"}, {"start": 2256.9, "end": 2258.9, "text": "卫王,"}, {"start": 2258.9, "end": 2259.9, "text": "这庞德,"}, {"start": 2259.9, "end": 2261.9, "text": "原是马超手下的副将,"}, {"start": 2261.9, "end": 2262.9, "text": "不得已,"}, {"start": 2262.9, "end": 2264.9, "text": "而归顺卫王,"}, {"start": 2264.9, "end": 2265.9, "text": "现在,"}, {"start": 2265.9, "end": 2266.9, "text": "其雇主在刘备那里,"}, {"start": 2266.9, "end": 2268.9, "text": "已高居五虎上将,"}, {"start": 2268.9, "end": 2269.9, "text": "其心胸庞柔,"}, {"start": 2269.9, "end": 2271.9, "text": "已在西川为郡守,"}, {"start": 2271.9, "end": 2273.9, "text": "卫王使他为先锋,"}, {"start": 2273.9, "end": 2274.9, "text": "末将担心,"}, {"start": 2274.9, "end": 2276.9, "text": "是颇有救火呀,"}, {"start": 2276.9, "end": 2278.9, "text": "请卫王三思,"}, {"start": 2278.9, "end": 2280.9, "text": "再换一将。"}, {"start": 2280.9, "end": 2282.9, "text": "酒我倒忘了,"}, {"start": 2282.9, "end": 2283.9, "text": "快,"}, {"start": 2283.9, "end": 2285.9, "text": "传庞德回来。"}, {"start": 2285.9, "end": 2286.9, "text": "遵命,"}, {"start": 2286.9, "end": 2287.9, "text": "卫王,"}, {"start": 2287.9, "end": 2304.82, "text": "脚下庞德的先锋印寿,"}, {"start": 2304.82, "end": 2305.82, "text": "这,"}, {"start": 2305.82, "end": 2306.82, "text": "卫王,"}, {"start": 2306.82, "end": 2308.82, "text": "为何如此?"}, {"start": 2308.82, "end": 2309.82, "text": "庞德,"}, {"start": 2309.82, "end": 2314.8, "text": "不是我信不过你,"}, {"start": 2314.8, "end": 2316.8, "text": "你的雇主马超,"}, {"start": 2316.8, "end": 2318.8, "text": "现在刘备帐下,"}, {"start": 2318.8, "end": 2319.8, "text": "你的家兄,"}, {"start": 2319.8, "end": 2321.8, "text": "也在川蜀做官,"}, {"start": 2321.8, "end": 2323.8, "text": "我若用你,"}, {"start": 2323.8, "end": 2324.8, "text": "众将,"}, {"start": 2324.8, "end": 2326.8, "text": "也有非议,"}, {"start": 2326.8, "end": 2329.8, "text": "恐怕会动摇军心,"}, {"start": 2329.8, "end": 2333.8, "text": "所以你还是回归本职吧,"}, {"start": 2333.8, "end": 2334.8, "text": "卫王,"}, {"start": 2334.8, "end": 2337.8, "text": "当年我受伤背棋,"}, {"start": 2337.8, "end": 2339.8, "text": "卫王不但不杀我,"}, {"start": 2339.8, "end": 2341.8, "text": "还厚待于我,"}, {"start": 2341.8, "end": 2344.8, "text": "我深感龙恩厚德,"}, {"start": 2344.8, "end": 2346.8, "text": "此生就是肝脑涂地,"}, {"start": 2346.8, "end": 2348.8, "text": "也难报答,"}, {"start": 2348.8, "end": 2350.8, "text": "今天,"}, {"start": 2350.8, "end": 2353.8, "text": "我做先锋是为了杀敌报恩,"}, {"start": 2354.8, "end": 2356.8, "text": "请卫王明察,"}, {"start": 2356.8, "end": 2358.8, "text": "就凭你这几句话,"}, {"start": 2358.8, "end": 2362.36, "text": "我还是不敢,"}, {"start": 2362.36, "end": 2364.36, "text": "把一支军队交给你,"}, {"start": 2364.36, "end": 2365.36, "text": "将在外,"}, {"start": 2365.36, "end": 2368.67, "text": "军命有所不受,"}, {"start": 2368.67, "end": 2370.67, "text": "一旦你到了军前,"}, {"start": 2370.67, "end": 2372.67, "text": "手握兵符,"}, {"start": 2372.67, "end": 2374.67, "text": "谁又能管得了你,"}, {"start": 2374.67, "end": 2379.37, "text": "卫王若是拿我的军印,"}, {"start": 2379.37, "end": 2382.37, "text": "我今天就寇死在这里,"}, {"start": 2382.37, "end": 2383.37, "text": "庞德,"}, {"start": 2383.37, "end": 2418.78, "text": "如果你带兵去偷雇主,"}, {"start": 2418.78, "end": 2421.78, "text": "说明你对雇主忠义,"}, {"start": 2421.78, "end": 2424.78, "text": "如果你带兵去占关羽,"}, {"start": 2424.78, "end": 2426.78, "text": "说明你对我忠义,"}, {"start": 2426.78, "end": 2428.78, "text": "无论怎么做,"}, {"start": 2428.78, "end": 2430.78, "text": "你都是个忠义的人,"}, {"start": 2430.78, "end": 2439.41, "text": "刚才的事,"}, {"start": 2439.41, "end": 2441.41, "text": "是故错了,"}, {"start": 2441.41, "end": 2443.41, "text": "故向你赔罪,"}, {"start": 2443.41, "end": 2444.41, "text": "来啊,"}, {"start": 2444.41, "end": 2455.14, "text": "结果先锋印手,"}]