[{"start": 15.54, "end": 16.7, "text": "陈鲁迅"}, {"start": 17.7, "end": 18.9, "text": "拜见主公"}, {"start": 25.3, "end": 26.14, "text": "鲁迅啊"}, {"start": 27.3, "end": 29.82, "text": "吕盟积劳成疾"}, {"start": 30.42, "end": 31.78, "text": "英年早逝"}, {"start": 32.66, "end": 36.38, "text": "我东吴又失意良助啊"}, {"start": 37.94, "end": 39.9, "text": "在下也深感悲痛"}, {"start": 40.98, "end": 42.22, "text": "可事已至此"}, {"start": 43.14, "end": 44.9, "text": "只能顺天命"}, {"start": 46.38, "end": 47.3, "text": "你说"}, {"start": 48.86, "end": 51.1, "text": "谁可继任吕盟之职"}, {"start": 51.62, "end": 54.22, "text": "来担任东吴的大都督啊"}, {"start": 59.22, "end": 60.66, "text": "大都督之职"}, {"start": 62.22, "end": 64.94, "text": "乃东吴战时最高统兵将领"}, {"start": 65.86, "end": 67.42, "text": "如今相对平静"}, {"start": 68.74, "end": 71.5, "text": "主公可暂不设大都督之职"}, {"start": 72.5, "end": 74.14, "text": "专意整顿三军"}, {"start": 74.62, "end": 76.42, "text": "积攒粮草军性"}, {"start": 77.98, "end": 79.18, "text": "待战情爆发"}, {"start": 80.66, "end": 81.66, "text": "再深入学历"}, {"start": 84.54, "end": 85.22, "text": "好"}, {"start": 87.38, "end": 88.34, "text": "就依你吧"}, {"start": 88.58, "end": 89.82, "text": "末将含有意情"}, {"start": 91.3, "end": 91.9, "text": "说"}, {"start": 92.54, "end": 94.82, "text": "既然主公不设大都督之职"}, {"start": 95.82, "end": 97.38, "text": "末将的副都督之职"}, {"start": 97.38, "end": 98.78, "text": "也应一并裁撤"}, {"start": 99.38, "end": 99.98, "text": "为何"}, {"start": 100.7, "end": 102.62, "text": "末将本是一文士"}, {"start": 103.18, "end": 104.66, "text": "并无统兵之才"}, {"start": 105.62, "end": 106.82, "text": "请主公恩准"}, {"start": 108.82, "end": 110.46, "text": "让末将回归故里"}, {"start": 170.59, "end": 172.07, "text": "在位十多年了"}, {"start": 175.33, "end": 179.41, "text": "一直受他们这些大都督的制约"}, {"start": 182.11, "end": 182.99, "text": "现在"}, {"start": 184.92, "end": 187.28, "text": "才能真正当一回主公"}, {"start": 215.47, "end": 216.15, "text": "二弟"}, {"start": 221.73, "end": 228.3, "text": "你怎么来了"}, {"start": 228.3, "end": 229.1, "text": "云长"}, {"start": 230.02, "end": 231.42, "text": "你不在荆州带兵"}, {"start": 231.7, "end": 232.86, "text": "跑到这里来干什么"}, {"start": 235.06, "end": 236.58, "text": "我是来向兄长你"}, {"start": 241.47, "end": 242.39, "text": "你要去哪里"}, {"start": 244.35, "end": 245.39, "text": "九泉之下"}, {"start": 248.04, "end": 248.6, "text": "记着"}, {"start": 259.75, "end": 260.63, "text": "你去哪儿啊"}, {"start": 272.22, "end": 272.82, "text": "云长"}, {"start": 273.38, "end": 274.22, "text": "你去哪里"}, {"start": 275.46, "end": 276.3, "text": "站下"}, {"start": 277.7, "end": 278.38, "text": "云长"}, {"start": 292.79, "end": 293.51, "text": "外面何人"}, {"start": 297.62, "end": 298.38, "text": "是孔明吗"}, {"start": 304.43, "end": 328.12, "text": "是我害怕见到主公"}, {"start": 329.04, "end": 330.48, "text": "因此先见到我"}, {"start": 333.9, "end": 334.5, "text": "快进来"}, {"start": 335.46, "end": 336.1, "text": "主公"}, {"start": 337.5, "end": 338.98, "text": "无论你听见什么"}, {"start": 340.06, "end": 341.7, "text": "你都不要太激动"}, {"start": 343.38, "end": 344.34, "text": "你快让他进来"}, {"start": 350.89, "end": 352.05, "text": "冠将军在樊城"}, {"start": 352.21, "end": 353.65, "text": "正在与曹军激战"}, {"start": 354.73, "end": 355.29, "text": "那日"}, {"start": 355.73, "end": 356.73, "text": "那东吴旅盟"}, {"start": 357.05, "end": 358.49, "text": "突然袭击了荆州"}, {"start": 358.81, "end": 360.49, "text": "冠将军抚卫受敌"}, {"start": 360.97, "end": 362.81, "text": "被曹军突破了营寨"}, {"start": 363.73, "end": 365.73, "text": "冠将军负伤退到了麦城"}, {"start": 366.49, "end": 368.05, "text": "难知遭到旅盟围攻"}, {"start": 368.29, "end": 368.57, "text": "他"}, {"start": 370.91, "end": 371.51, "text": "他怎么了"}, {"start": 371.87, "end": 375.33, "text": "阵亡了"}, {"start": 382.94, "end": 384.3, "text": "云长怎么能阵亡呢"}, {"start": 389.81, "end": 390.73, "text": "我二弟他"}, {"start": 391.33, "end": 392.05, "text": "主公"}, {"start": 392.77, "end": 395.77, "text": "冠将军确实殡天了"}, {"start": 396.65, "end": 398.69, "text": "头颅被吴将斩下"}, {"start": 399.49, "end": 400.57, "text": "官兵周葬"}, {"start": 401.29, "end": 403.77, "text": "一并斩死"}, {"start": 410.62, "end": 411.78, "text": "不可能"}, {"start": 412.26, "end": 415.52, "text": "我二弟天下无敌"}, {"start": 416.04, "end": 417.4, "text": "只有他杀敌的份"}, {"start": 417.72, "end": 419.24, "text": "怎么可能被敌人杀呢"}, {"start": 419.92, "end": 420.8, "text": "让他退下"}, {"start": 467.13, "end": 467.77, "text": "卫王"}, {"start": 468.05, "end": 476.65, "text": "什么事"}, {"start": 479.21, "end": 480.33, "text": "孙全派人"}, {"start": 481.45, "end": 483.29, "text": "给卫王送寿礼来了"}, {"start": 484.01, "end": 484.89, "text": "一颗卫王"}, {"start": 485.45, "end": 486.97, "text": "六五大寿啊"}, {"start": 488.45, "end": 490.69, "text": "孙全给我送寿礼"}, {"start": 493.47, "end": 495.59, "text": "他做梦都想让我早点死"}, {"start": 495.95, "end": 497.27, "text": "会给我送寿礼"}, {"start": 498.95, "end": 499.79, "text": "什么呀"}, {"start": 511.44, "end": 512.04, "text": "什么"}, {"start": 518.07, "end": 518.91, "text": "关于人头"}, {"start": 533.53, "end": 534.65, "text": "还有一些"}, {"start": 535.53, "end": 536.05, "text": "念"}, {"start": 544.81, "end": 547.45, "text": "孙全拜成卫王陛下"}, {"start": 548.73, "end": 551.89, "text": "吾领陛下之命夹击刘军"}, {"start": 553.33, "end": 554.53, "text": "荆州之役"}, {"start": 555.09, "end": 556.89, "text": "实为卫王之公也"}, {"start": 557.65, "end": 559.81, "text": "新逢陛下六五大寿"}, {"start": 560.77, "end": 562.37, "text": "敬上狄囚"}, {"start": 562.73, "end": 566.98, "text": "冠也授稷以为贺青"}, {"start": 570.57, "end": 571.61, "text": "孙全"}, {"start": 571.93, "end": 575.45, "text": "许了荆州"}, {"start": 576.61, "end": 578.05, "text": "杀了关羽"}, {"start": 579.37, "end": 581.01, "text": "占了大便宜不说"}, {"start": 581.01, "end": 583.33, "text": "还想把祸水引到我这儿来"}, {"start": 587.54, "end": 589.06, "text": "直到刘关章"}, {"start": 590.02, "end": 592.54, "text": "桃园劫义 誓同生死"}, {"start": 592.82, "end": 597.97, "text": "便托死是受我命取的荆州"}, {"start": 598.37, "end": 604.66, "text": "想让刘备迁怒于我"}, {"start": 605.02, "end": 607.6, "text": "不发吾"}, {"start": 608.68, "end": 609.56, "text": "而攻卫"}, {"start": 611.08, "end": 611.68, "text": "卫王"}, {"start": 611.68, "end": 614.99, "text": "我该如何应对呀"}, {"start": 621.26, "end": 622.42, "text": "上奏天子"}, {"start": 624.57, "end": 626.49, "text": "追风关羽为晋王"}, {"start": 626.49, "end": 627.77, "text": "将其首级"}, {"start": 628.49, "end": 630.41, "text": "配以香木神曲"}, {"start": 631.69, "end": 634.73, "text": "套葬于洛阳南门外"}, {"start": 634.73, "end": 638.51, "text": "臣下即刻去办"}, {"start": 638.99, "end": 640.55, "text": "下葬的时候"}, {"start": 641.87, "end": 643.63, "text": "卓文武百官"}, {"start": 644.39, "end": 645.63, "text": "一起出殡"}, {"start": 645.95, "end": 646.83, "text": "遵命"}, {"start": 647.07, "end": 676.26, "text": "都说这人要上了岁数"}, {"start": 676.58, "end": 678.22, "text": "就喜欢念旧"}, {"start": 678.54, "end": 682.98, "text": "我这两天"}, {"start": 685.67, "end": 687.67, "text": "老想起从前的事"}, {"start": 687.71, "end": 689.67, "text": "老想起从前的事"}, {"start": 689.91, "end": 693.74, "text": "想起你温酒斩华雄"}, {"start": 693.98, "end": 698.04, "text": "斩阎梁朱文丑"}, {"start": 700.13, "end": 701.85, "text": "挂印分金"}, {"start": 702.01, "end": 705.44, "text": "武关斩六将"}, {"start": 706.2, "end": 708.6, "text": "真是一把快刀啊"}, {"start": 709.92, "end": 713.2, "text": "可是你为何死在蜀辈手里"}, {"start": 717.85, "end": 720.45, "text": "因为你缺一个好主子"}, {"start": 720.77, "end": 726.0, "text": "你要是跟了我"}, {"start": 727.0, "end": 728.84, "text": "岂能身手易主"}, {"start": 731.36, "end": 732.28, "text": "刘备"}, {"start": 732.68, "end": 734.2, "text": "家人家义"}, {"start": 736.45, "end": 738.85, "text": "我才是天下雄主"}, {"start": 739.01, "end": 745.78, "text": "你呀 你什么都不缺"}, {"start": 747.18, "end": 749.46, "text": "就缺一个好主子"}, {"start": 751.7, "end": 753.46, "text": "不过话又说回来了"}, {"start": 755.3, "end": 757.66, "text": "你要是当初真跟了我"}, {"start": 758.46, "end": 760.46, "text": "没有去寻你的雇主"}, {"start": 760.66, "end": 763.88, "text": "我又该瞧不上你了"}, {"start": 765.83, "end": 766.79, "text": "没什么呢"}, {"start": 766.95, "end": 770.43, "text": "你我也喜欢忠义之人"}, {"start": 770.43, "end": 777.21, "text": "但最好是对我忠"}, {"start": 777.21, "end": 778.21, "text": "罢了"}, {"start": 780.48, "end": 781.68, "text": "罢了"}, {"start": 781.96, "end": 784.9, "text": "是在会吧"}, {"start": 787.53, "end": 791.5, "text": "云长 你歇着"}, {"start": 806.05, "end": 807.53, "text": "陆续凋零"}, {"start": 810.14, "end": 823.46, "text": "好似风中落雨"}, {"start": 823.46, "end": 823.86, "text": "父王"}, {"start": 823.86, "end": 824.34, "text": "卫王"}, {"start": 824.34, "end": 825.06, "text": "父王"}, {"start": 825.38, "end": 825.66, "text": "父王"}, {"start": 825.66, "end": 826.26, "text": "卫王"}, {"start": 828.46, "end": 829.18, "text": "卫王"}, {"start": 829.18, "end": 830.3, "text": "我头好痛"}, {"start": 830.46, "end": 832.5, "text": "又如针扎剑脚"}, {"start": 834.34, "end": 834.82, "text": "快 快"}, {"start": 834.82, "end": 836.18, "text": "快扶卫王上车"}, {"start": 860.46, "end": 862.06, "text": "到底是上了年岁"}, {"start": 862.46, "end": 863.86, "text": "多年劳苦不息"}, {"start": 863.98, "end": 865.58, "text": "昨日又染了风寒"}, {"start": 865.62, "end": 866.9, "text": "把他旧疾又引发了"}, {"start": 866.9, "end": 868.26, "text": "赶紧设法医治啊"}, {"start": 868.46, "end": 869.62, "text": "世子恕罪"}, {"start": 870.22, "end": 871.3, "text": "卫王的头疯"}, {"start": 871.3, "end": 872.78, "text": "乃是多年故疾"}, {"start": 873.5, "end": 874.82, "text": "我才书学浅"}, {"start": 874.82, "end": 876.26, "text": "多年未能治愈"}, {"start": 876.7, "end": 877.54, "text": "这次"}, {"start": 877.54, "end": 879.66, "text": "卫王的病逝又来得这么急"}, {"start": 879.66, "end": 880.26, "text": "我"}, {"start": 881.62, "end": 883.14, "text": "卫王一人担着社稷"}, {"start": 883.14, "end": 884.42, "text": "万万不能倒下"}, {"start": 885.1, "end": 885.98, "text": "快想办法"}, {"start": 887.1, "end": 888.06, "text": "有一人"}, {"start": 888.06, "end": 889.14, "text": "或可请他一事"}, {"start": 889.14, "end": 889.82, "text": "谁"}, {"start": 890.26, "end": 891.7, "text": "此人名叫华佗"}, {"start": 891.7, "end": 893.5, "text": "他的医道超凡入圣"}, {"start": 893.5, "end": 894.78, "text": "胜我十倍啊"}, {"start": 894.78, "end": 895.54, "text": "我知道了"}, {"start": 895.54, "end": 896.62, "text": "传说中的神医"}, {"start": 896.62, "end": 897.74, "text": "此人现在何处"}, {"start": 898.22, "end": 899.78, "text": "听说到了敏俊"}, {"start": 899.78, "end": 900.78, "text": "据此有二百余力"}, {"start": 900.78, "end": 901.5, "text": "快"}, {"start": 901.82, "end": 902.98, "text": "派人飞抵前方敏俊"}, {"start": 902.98, "end": 904.02, "text": "把华佗请来"}, {"start": 904.02, "end": 904.74, "text": "遵命"}, {"start": 940.72, "end": 942.88, "text": "这位就是神医华佗"}, {"start": 942.88, "end": 978.59, "text": "罔头疾"}, {"start": 979.35, "end": 982.75, "text": "皆因风寒恶意所致"}, {"start": 982.75, "end": 987.44, "text": "其病根在脑中"}, {"start": 987.44, "end": 988.68, "text": "起码"}, {"start": 988.68, "end": 995.02, "text": "患病有二十五年了"}, {"start": 995.02, "end": 996.7, "text": "某有一法"}, {"start": 996.7, "end": 998.02, "text": "只恐"}, {"start": 998.02, "end": 1000.1, "text": "卫王不肯啊"}, {"start": 1000.1, "end": 1000.94, "text": "你"}, {"start": 1000.94, "end": 1001.74, "text": "千叔"}, {"start": 1001.74, "end": 1003.54, "text": "先饮麻肺汤"}, {"start": 1004.3, "end": 1005.26, "text": "然后"}, {"start": 1005.26, "end": 1008.5, "text": "用利刃砍开卫王头颅"}, {"start": 1008.5, "end": 1010.3, "text": "取出风险"}, {"start": 1010.3, "end": 1012.14, "text": "方可除去病根"}, {"start": 1015.62, "end": 1018.7, "text": "拿斧头劈开我的头颅"}, {"start": 1019.7, "end": 1021.58, "text": "你是想杀了我吗"}, {"start": 1025.34, "end": 1028.42, "text": "卫王的病根在头中"}, {"start": 1028.42, "end": 1030.06, "text": "只饮汤药"}, {"start": 1030.06, "end": 1032.06, "text": "已无济于事"}, {"start": 1032.06, "end": 1034.1, "text": "只能开颅救治"}, {"start": 1035.02, "end": 1035.98, "text": "昔日"}, {"start": 1035.98, "end": 1038.54, "text": "关于左臂中毒箭"}, {"start": 1038.54, "end": 1039.74, "text": "是在下"}, {"start": 1039.74, "end": 1042.5, "text": "用利刃割开其臂肉"}, {"start": 1042.5, "end": 1043.94, "text": "刮骨治髓"}, {"start": 1043.94, "end": 1045.46, "text": "方才治愈的"}, {"start": 1045.46, "end": 1047.1, "text": "臂肉可以切除"}, {"start": 1047.1, "end": 1050.43, "text": "头颅怎能加以刀斧"}, {"start": 1050.43, "end": 1052.63, "text": "你定是"}, {"start": 1052.63, "end": 1055.47, "text": "与关羽有交"}, {"start": 1055.47, "end": 1058.79, "text": "想趁治病之际杀我"}, {"start": 1058.79, "end": 1059.71, "text": "来啊"}, {"start": 1059.71, "end": 1060.27, "text": "是"}, {"start": 1060.27, "end": 1060.91, "text": "拿下"}, {"start": 1060.91, "end": 1061.31, "text": "诺"}, {"start": 1061.31, "end": 1062.43, "text": "大王"}, {"start": 1062.43, "end": 1063.99, "text": "我只会救人"}, {"start": 1063.99, "end": 1067.41, "text": "不会害人啊"}, {"start": 1067.41, "end": 1068.21, "text": "遵命"}, {"start": 1068.21, "end": 1100.2, "text": "谋谴人上表"}, {"start": 1101.2, "end": 1103.0, "text": "都说什么了"}, {"start": 1103.0, "end": 1104.96, "text": "劝卫王"}, {"start": 1104.96, "end": 1106.64, "text": "加尊九五"}, {"start": 1106.64, "end": 1108.28, "text": "谨避卫"}, {"start": 1108.28, "end": 1110.76, "text": "孙权"}, {"start": 1110.76, "end": 1112.6, "text": "是越来越"}, {"start": 1112.6, "end": 1117.55, "text": "吴侯在信上说"}, {"start": 1117.55, "end": 1120.51, "text": "他早就知道天命归于卫王"}, {"start": 1120.51, "end": 1121.95, "text": "势不可阻"}, {"start": 1121.95, "end": 1124.07, "text": "俘望卫王早证大魏"}, {"start": 1124.07, "end": 1125.43, "text": "剿灭刘备"}, {"start": 1125.43, "end": 1127.43, "text": "扫平西川"}, {"start": 1127.43, "end": 1128.79, "text": "到那时"}, {"start": 1128.79, "end": 1131.83, "text": "他就携东吴文武士民"}, {"start": 1131.99, "end": 1134.03, "text": "纳土归乡"}, {"start": 1134.03, "end": 1137.69, "text": "到那时"}, {"start": 1137.69, "end": 1138.85, "text": "那时"}, {"start": 1138.85, "end": 1143.87, "text": "是那时啊"}, {"start": 1143.87, "end": 1145.07, "text": "五年"}, {"start": 1145.07, "end": 1151.24, "text": "十年"}, {"start": 1151.24, "end": 1153.32, "text": "我还能活得到"}, {"start": 1153.32, "end": 1157.54, "text": "那时吗"}, {"start": 1157.54, "end": 1159.74, "text": "聪明"}, {"start": 1159.74, "end": 1164.14, "text": "真聪明"}, {"start": 1164.14, "end": 1168.3, "text": "一个行将要死的人"}, {"start": 1168.3, "end": 1171.22, "text": "还当什么皇帝"}, {"start": 1171.22, "end": 1172.66, "text": "卫王"}, {"start": 1172.66, "end": 1174.9, "text": "臣和百官都以为"}, {"start": 1174.9, "end": 1176.7, "text": "卫王"}, {"start": 1176.7, "end": 1178.42, "text": "功改古今"}, {"start": 1178.42, "end": 1180.22, "text": "得备天地"}, {"start": 1180.22, "end": 1181.94, "text": "虽无皇帝之名"}, {"start": 1181.94, "end": 1184.06, "text": "早居皇帝之时"}, {"start": 1184.06, "end": 1186.62, "text": "应该顺天即位"}, {"start": 1186.62, "end": 1191.42, "text": "垂名青史啊"}, {"start": 1191.42, "end": 1199.1, "text": "来啊"}, {"start": 1199.1, "end": 1201.22, "text": "卫王请看"}, {"start": 1201.22, "end": 1203.22, "text": "这是新制的皇冠"}, {"start": 1203.22, "end": 1264.27, "text": "和百官的劝禁表"}, {"start": 1264.27, "end": 1266.27, "text": "都在外面恭候呢"}, {"start": 1266.27, "end": 1281.69, "text": "让他们都退了吧"}, {"start": 1285.38, "end": 1292.61, "text": "我从来都没有想过当皇帝"}, {"start": 1292.61, "end": 1294.33, "text": "汉氏衰微无救"}, {"start": 1294.33, "end": 1296.45, "text": "徒有虚名而已"}, {"start": 1296.45, "end": 1298.49, "text": "卫王功德微微"}, {"start": 1298.49, "end": 1300.57, "text": "生灵养望"}, {"start": 1300.57, "end": 1301.81, "text": "连孙全"}, {"start": 1301.81, "end": 1303.17, "text": "都上表劝禁了"}, {"start": 1303.17, "end": 1312.96, "text": "你以为他是真心的吗"}, {"start": 1312.96, "end": 1314.76, "text": "他用力我"}, {"start": 1314.76, "end": 1317.32, "text": "是想把我搁在"}, {"start": 1317.32, "end": 1322.1, "text": "火上烤啊"}, {"start": 1322.1, "end": 1323.9, "text": "我"}, {"start": 1323.9, "end": 1327.42, "text": "虽有些功德"}, {"start": 1327.42, "end": 1329.46, "text": "但明智王侯"}, {"start": 1329.46, "end": 1335.12, "text": "明觉已及"}, {"start": 1335.12, "end": 1394.64, "text": "苏"}, {"start": 1394.64, "end": 1398.48, "text": "请开府门"}, {"start": 1398.48, "end": 1399.48, "text": "殿下"}, {"start": 1399.48, "end": 1400.72, "text": "请开府门"}, {"start": 1400.72, "end": 1422.81, "text": "吕楚"}, {"start": 1422.81, "end": 1424.41, "text": "殿下"}, {"start": 1424.41, "end": 1425.73, "text": "何事啊"}, {"start": 1425.73, "end": 1431.49, "text": "卫王令殿下即刻入宫"}, {"start": 1431.49, "end": 1433.25, "text": "徐将军"}, {"start": 1433.25, "end": 1438.58, "text": "为何带了这么多假事啊"}, {"start": 1438.58, "end": 1442.84, "text": "这都是为殿下安全着想"}, {"start": 1442.84, "end": 1460.55, "text": "请"}, {"start": 1460.55, "end": 1468.24, "text": "儿臣拜见父王"}, {"start": 1468.24, "end": 1470.08, "text": "在"}, {"start": 1470.12, "end": 1471.04, "text": "把这个"}, {"start": 1471.04, "end": 1474.65, "text": "人不易的东西拖下去"}, {"start": 1474.65, "end": 1480.86, "text": "斩了"}, {"start": 1480.86, "end": 1481.9, "text": "父王"}, {"start": 1481.9, "end": 1483.3, "text": "父王为何要杀儿啊"}, {"start": 1483.3, "end": 1493.5, "text": "你弟弟曹冲是怎么死的"}, {"start": 1493.5, "end": 1496.56, "text": "哪里有什么毒树"}, {"start": 1496.56, "end": 1500.79, "text": "他是被人放毒蛇咬死的"}, {"start": 1500.79, "end": 1503.35, "text": "原来是这样"}, {"start": 1503.35, "end": 1504.11, "text": "父王"}, {"start": 1504.11, "end": 1504.75, "text": "谁"}, {"start": 1504.75, "end": 1506.03, "text": "谁如此狠毒啊"}, {"start": 1506.03, "end": 1509.3, "text": "毒蛇就是你放的"}, {"start": 1509.3, "end": 1514.15, "text": "父王你冤枉我"}, {"start": 1514.15, "end": 1515.39, "text": "父王你冤枉我啊"}, {"start": 1515.39, "end": 1515.71, "text": "我"}, {"start": 1515.71, "end": 1516.83, "text": "冤枉你"}, {"start": 1516.83, "end": 1522.21, "text": "出殡前四天"}, {"start": 1522.21, "end": 1524.85, "text": "我给你们每家罚了五只猫"}, {"start": 1524.85, "end": 1529.95, "text": "罚春期的猫"}, {"start": 1529.95, "end": 1531.99, "text": "可是那些猫"}, {"start": 1531.99, "end": 1534.95, "text": "整夜地叫个不休为什么"}, {"start": 1534.95, "end": 1536.51, "text": "因为他们"}, {"start": 1536.51, "end": 1539.11, "text": "无数可补"}, {"start": 1539.11, "end": 1540.27, "text": "还有"}, {"start": 1540.27, "end": 1546.5, "text": "让你们给冲儿守灵"}, {"start": 1546.5, "end": 1549.34, "text": "死惊天的时候"}, {"start": 1549.34, "end": 1551.66, "text": "曹指和曹章"}, {"start": 1551.66, "end": 1553.1, "text": "都熬不住睡过去了"}, {"start": 1553.1, "end": 1555.34, "text": "唯有你"}, {"start": 1555.34, "end": 1557.66, "text": "心神不灵"}, {"start": 1557.66, "end": 1560.62, "text": "这也不免为何"}, {"start": 1560.62, "end": 1562.74, "text": "你心中有鬼"}, {"start": 1562.74, "end": 1572.06, "text": "你要死了"}, {"start": 1572.06, "end": 1595.39, "text": "就想听一句实话"}, {"start": 1595.39, "end": 1598.35, "text": "儿说过的话"}, {"start": 1598.35, "end": 1601.98, "text": "句句属实"}, {"start": 1601.98, "end": 1604.63, "text": "冲弟"}, {"start": 1604.63, "end": 1614.09, "text": "不是我害的"}, {"start": 1614.09, "end": 1621.15, "text": "你就杀吧"}, {"start": 1621.15, "end": 1628.18, "text": "徐初"}, {"start": 1628.18, "end": 1629.5, "text": "你先去吧"}, {"start": 1629.5, "end": 1666.87, "text": "你不杀我了"}, {"start": 1666.87, "end": 1669.7, "text": "不杀你"}, {"start": 1669.7, "end": 1679.17, "text": "我还要把团给你"}, {"start": 1679.17, "end": 1682.25, "text": "有你这样的主子"}, {"start": 1682.25, "end": 1685.25, "text": "再有司马尼尼尔的谋士"}, {"start": 1685.25, "end": 1688.01, "text": "我们曹氏的大业"}, {"start": 1688.01, "end": 1689.81, "text": "才能延续下去"}, {"start": 1689.81, "end": 1710.44, "text": "让他对手"}, {"start": 1710.44, "end": 1716.24, "text": "永远"}, {"start": 1716.24, "end": 1729.78, "text": "永远牢记"}, {"start": 1729.78, "end": 1743.26, "text": "永远牢记"}, {"start": 1743.26, "end": 1746.9, "text": "你在家是长兄"}, {"start": 1746.9, "end": 1748.78, "text": "在朝是君王"}, {"start": 1748.78, "end": 1756.31, "text": "一定要善待兄弟姐妹"}, {"start": 1756.31, "end": 1758.27, "text": "儿臣"}, {"start": 1758.27, "end": 1762.14, "text": "对天理事"}, {"start": 1762.14, "end": 1763.66, "text": "永远牢记"}, {"start": 1763.66, "end": 1787.14, "text": "父王的祝福"}, {"start": 1787.14, "end": 1788.7, "text": "卫王有旨"}, {"start": 1788.7, "end": 1826.94, "text": "都进来"}, {"start": 1826.94, "end": 1831.37, "text": "纵横天下三十余年"}, {"start": 1831.37, "end": 1835.86, "text": "群雄劫灭"}, {"start": 1835.86, "end": 1839.38, "text": "只有江东孙权"}, {"start": 1839.38, "end": 1844.49, "text": "西蜀刘备未曾角逐"}, {"start": 1844.49, "end": 1846.13, "text": "今姑"}, {"start": 1846.13, "end": 1848.92, "text": "并未"}, {"start": 1848.92, "end": 1853.28, "text": "不能再与亲等共事"}, {"start": 1853.28, "end": 1859.1, "text": "她将家世相托"}, {"start": 1859.1, "end": 1860.98, "text": "姑"}, {"start": 1860.98, "end": 1864.54, "text": "长子曹王"}, {"start": 1864.54, "end": 1866.54, "text": "早年"}, {"start": 1866.54, "end": 1870.73, "text": "不幸莫于晚成"}, {"start": 1870.73, "end": 1874.77, "text": "桓夫人所生曹冲"}, {"start": 1874.77, "end": 1877.81, "text": "聪明过人"}, {"start": 1877.81, "end": 1879.13, "text": "不幸"}, {"start": 1879.13, "end": 1885.26, "text": "姚王"}, {"start": 1885.26, "end": 1889.94, "text": "便是所生四子"}, {"start": 1889.94, "end": 1891.46, "text": "毕"}, {"start": 1891.46, "end": 1892.7, "text": "张"}, {"start": 1892.7, "end": 1893.82, "text": "直"}, {"start": 1893.82, "end": 1896.94, "text": "雄"}, {"start": 1896.94, "end": 1898.78, "text": "姑虽"}, {"start": 1898.78, "end": 1902.3, "text": "甚爱曹植"}, {"start": 1902.3, "end": 1905.85, "text": "但她"}, {"start": 1905.85, "end": 1907.61, "text": "虚华俗礼"}, {"start": 1907.65, "end": 1908.85, "text": "十九放纵"}, {"start": 1908.85, "end": 1909.81, "text": "因此"}, {"start": 1909.81, "end": 1911.85, "text": "不能立"}, {"start": 1911.85, "end": 1914.25, "text": "曹张"}, {"start": 1914.25, "end": 1918.1, "text": "雄儿无谋"}, {"start": 1918.1, "end": 1920.5, "text": "曹雄"}, {"start": 1920.5, "end": 1921.86, "text": "多病"}, {"start": 1921.86, "end": 1924.92, "text": "难保"}, {"start": 1924.92, "end": 1928.08, "text": "唯曹匹"}, {"start": 1928.08, "end": 1929.6, "text": "敦厚"}, {"start": 1929.6, "end": 1931.28, "text": "恭敬"}, {"start": 1931.28, "end": 1934.84, "text": "可继我大业"}, {"start": 1934.84, "end": 1938.13, "text": "亲等"}, {"start": 1938.13, "end": 1942.38, "text": "义父左之"}, {"start": 1942.38, "end": 1943.06, "text": "谨孙"}, {"start": 1969.52, "end": 1970.76, "text": "此生"}, {"start": 1970.76, "end": 1972.96, "text": "杀人甚多"}, {"start": 1972.96, "end": 1975.2, "text": "死后"}, {"start": 1975.2, "end": 1977.64, "text": "你们要"}, {"start": 1977.64, "end": 1981.48, "text": "在得章府五城外"}, {"start": 1981.48, "end": 1983.08, "text": "修"}, {"start": 1983.08, "end": 1985.92, "text": "遗种七十二处"}, {"start": 1985.92, "end": 1988.28, "text": "断不可让世人"}, {"start": 1988.28, "end": 1990.64, "text": "知道故的葬处"}, {"start": 1990.64, "end": 1992.36, "text": "还有"}, {"start": 1992.36, "end": 1994.48, "text": "故这一双门"}, {"start": 1994.48, "end": 1996.6, "text": "愿走则走"}, {"start": 1996.6, "end": 1998.72, "text": "愿改嫁者"}, {"start": 1998.72, "end": 2000.24, "text": "准其改嫁"}, {"start": 2000.24, "end": 2020.01, "text": "死不可怕"}, {"start": 2020.01, "end": 2023.53, "text": "此时凉爽的夏夜"}, {"start": 2023.53, "end": 2024.73, "text": "可供人"}, {"start": 2024.73, "end": 2027.58, "text": "不忧地"}, {"start": 2027.58, "end": 2032.89, "text": "安眠"}, {"start": 2032.89, "end": 2037.25, "text": "世人"}, {"start": 2037.25, "end": 2041.16, "text": "昨日看错我曹操"}, {"start": 2041.16, "end": 2043.6, "text": "今日"}, {"start": 2043.6, "end": 2047.57, "text": "又看错了"}, {"start": 2047.57, "end": 2049.77, "text": "也许明日"}, {"start": 2049.77, "end": 2052.61, "text": "还会看错"}, {"start": 2052.61, "end": 2054.73, "text": "可是我"}, {"start": 2054.73, "end": 2057.21, "text": "仍然是我"}, {"start": 2057.21, "end": 2059.85, "text": "我从来不怕别人"}, {"start": 2059.85, "end": 2061.17, "text": "看错我"}, {"start": 2177.49, "end": 2179.45, "text": "年争运"}, {"start": 2179.49, "end": 2182.65, "text": "曹操带着他未尽的梦想"}, {"start": 2182.65, "end": 2184.57, "text": "走了"}, {"start": 2184.57, "end": 2187.89, "text": "相年六十六岁"}, {"start": 2187.89, "end": 2190.89, "text": "曹操是一位卓越的政治家"}, {"start": 2190.89, "end": 2191.93, "text": "军事家"}, {"start": 2191.93, "end": 2193.49, "text": "文学家"}, {"start": 2193.49, "end": 2197.17, "text": "也是一位非凡的谋略家"}, {"start": 2197.17, "end": 2198.81, "text": "由于他的努力"}, {"start": 2198.81, "end": 2201.37, "text": "为三国之后再次统一"}, {"start": 2201.37, "end": 2206.73, "text": "打下了基础"}, {"start": 2206.73, "end": 2209.73, "text": "父王"}, {"start": 2209.73, "end": 2213.49, "text": "父王"}, {"start": 2213.49, "end": 2219.28, "text": "父王"}, {"start": 2219.28, "end": 2220.6, "text": "主公"}, {"start": 2220.6, "end": 2221.6, "text": "天子驾到"}, {"start": 2221.6, "end": 2250.63, "text": "主公不必接驾"}, {"start": 2250.63, "end": 2252.07, "text": "天子驾到"}, {"start": 2252.07, "end": 2254.71, "text": "臣等都该去接驾呀"}, {"start": 2254.71, "end": 2256.23, "text": "你们可以去"}, {"start": 2256.23, "end": 2260.94, "text": "主公不必去"}, {"start": 2260.94, "end": 2264.06, "text": "昔日天子册封魏王时"}, {"start": 2264.06, "end": 2266.54, "text": "曾下诏免于十二流"}, {"start": 2266.54, "end": 2268.9, "text": "使用天子车扶软椅"}, {"start": 2268.9, "end": 2270.06, "text": "出井入壁"}, {"start": 2270.06, "end": 2272.14, "text": "剑履上殿"}, {"start": 2272.14, "end": 2274.06, "text": "按照此诏"}, {"start": 2274.06, "end": 2279.22, "text": "魏王以天子理智相等"}, {"start": 2279.22, "end": 2341.94, "text": "因此主公不必接驾"}, {"start": 2341.94, "end": 2345.81, "text": "爱卿啊"}, {"start": 2345.81, "end": 2348.45, "text": "魏王毕生功勋卓著"}, {"start": 2348.45, "end": 2350.61, "text": "此一去"}, {"start": 2350.61, "end": 2353.45, "text": "朕痛断肝肠"}, {"start": 2353.45, "end": 2355.69, "text": "陛下有误了"}, {"start": 2355.69, "end": 2361.76, "text": "去的是先王"}, {"start": 2361.76, "end": 2364.32, "text": "先王临终一命"}, {"start": 2364.36, "end": 2368.48, "text": "令世子曹匹继位魏王"}, {"start": 2368.48, "end": 2371.02, "text": "朕"}, {"start": 2371.02, "end": 2372.3, "text": "朕没有下旨啊"}, {"start": 2372.3, "end": 2373.9, "text": "陛下明白"}, {"start": 2373.9, "end": 2375.3, "text": "先王一命"}, {"start": 2375.3, "end": 2378.14, "text": "就是朝廷旨意"}, {"start": 2378.14, "end": 2381.58, "text": "莫非陛下有疑问吗"}, {"start": 2381.58, "end": 2383.54, "text": "没有"}, {"start": 2383.54, "end": 2385.9, "text": "没有"}, {"start": 2385.9, "end": 2388.1, "text": "朕"}, {"start": 2388.1, "end": 2390.94, "text": "朕也觉得极为应当"}, {"start": 2390.94, "end": 2393.1, "text": "先王御驾而去"}, {"start": 2393.1, "end": 2394.66, "text": "陛下应当向先王"}, {"start": 2394.66, "end": 2395.94, "text": "兴叩拜之礼"}, {"start": 2395.98, "end": 2403.93, "text": "才合天下子民之望"}, {"start": 2403.93, "end": 2408.61, "text": "朕是皇帝"}, {"start": 2408.61, "end": 2411.37, "text": "皇帝专程来"}, {"start": 2411.37, "end": 2413.13, "text": "平调大臣"}, {"start": 2413.13, "end": 2414.53, "text": "以示疏礼"}, {"start": 2414.53, "end": 2416.53, "text": "朕怎么还能下跪"}, {"start": 2416.53, "end": 2418.89, "text": "没有先王护佑"}, {"start": 2418.89, "end": 2421.29, "text": "朝廷早已崩溃"}, {"start": 2421.29, "end": 2424.49, "text": "陛下也早不知亡于何方"}, {"start": 2424.49, "end": 2427.97, "text": "陛下素来尊先王如亚父"}, {"start": 2427.97, "end": 2429.73, "text": "如今亚父病天"}, {"start": 2429.73, "end": 2432.13, "text": "后辈难道不该行叩拜之礼"}]