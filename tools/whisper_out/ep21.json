[{"start": 0.24, "end": 2.24, "text": "啊"}, {"start": 4.88, "end": 21.12, "text": "后面沉土大起"}, {"start": 21.12, "end": 22.98, "text": "估计是曹 recepts 追兵到啦"}, {"start": 26.56, "end": 30.7, "text": "云长子龙在 rapid 准备迎战"}, {"start": 30.8, "end": 32.12, "text": "外三地"}, {"start": 32.12, "end": 32.92, "text": "哎"}, {"start": 32.92, "end": 34.6, "text": "你自我去对会会他"}, {"start": 34.98, "end": 35.48, "text": "好"}, {"start": 35.48, "end": 36.06, "text": "umbrell"}, {"start": 36.06, "end": 37.0, "text": "租"}, {"start": 37.0, "end": 39.12, "text": "教Studio"}, {"start": 39.44, "end": 74.47, "text": "Ci extraordinarily"}, {"start": 74.47, "end": 74.89, "text": "Iransecret"}, {"start": 75.13, "end": 79.96, "text": "林�itte"}, {"start": 80.02, "end": 80.5, "text": "爷不怕他"}, {"start": 81.26, "end": 82.84, "text": "丞相命我们招回决 tricks"}, {"start": 83.12, "end": 84.54, "text": "并没有让我们死杀"}, {"start": 85.22, "end": 87.22, "text": "如果刘备不肯奉命怎么办"}, {"start": 87.22, "end": 89.22, "text": "那也不可厮杀"}, {"start": 89.22, "end": 91.22, "text": "我们只有五百人吧"}, {"start": 91.22, "end": 93.22, "text": "可他们有五万"}, {"start": 93.22, "end": 95.22, "text": "你就说怎么办吧"}, {"start": 95.22, "end": 99.65, "text": "请将军在这领兵"}, {"start": 99.65, "end": 101.65, "text": "我过去给刘备传命"}, {"start": 101.65, "end": 103.65, "text": "没我的命令"}, {"start": 103.65, "end": 105.65, "text": "万万不可过来"}, {"start": 105.65, "end": 144.54, "text": "好 文远将军何故到此"}, {"start": 144.54, "end": 146.54, "text": "奉丞相命"}, {"start": 146.54, "end": 148.54, "text": "请刘皇叔回朝"}, {"start": 148.54, "end": 150.54, "text": "朝廷另有任用"}, {"start": 150.54, "end": 152.54, "text": "将在外"}, {"start": 152.54, "end": 154.54, "text": "军命有所不受"}, {"start": 154.54, "end": 156.54, "text": "何况现在"}, {"start": 156.54, "end": 158.54, "text": "元树兵马已动"}, {"start": 158.54, "end": 160.54, "text": "军情如火"}, {"start": 160.54, "end": 162.54, "text": "我应速速赶往徐州阻击他们"}, {"start": 162.54, "end": 164.54, "text": "万万不可失了容忌"}, {"start": 166.54, "end": 168.54, "text": "这么说"}, {"start": 168.54, "end": 170.54, "text": "刘皇叔不肯回朝了"}, {"start": 170.54, "end": 172.54, "text": "不回"}, {"start": 172.54, "end": 174.54, "text": "请将军"}, {"start": 174.54, "end": 176.54, "text": "代我向丞相禀报"}, {"start": 176.54, "end": 178.54, "text": "就说"}, {"start": 178.54, "end": 180.54, "text": "就说刘备"}, {"start": 180.54, "end": 182.54, "text": "丞相"}, {"start": 182.54, "end": 197.79, "text": "更不会辜负了朝廷"}, {"start": 197.79, "end": 199.79, "text": "张将军"}, {"start": 199.79, "end": 201.79, "text": "我以为敌军来袭"}, {"start": 201.79, "end": 203.79, "text": "所以预先不好地认识"}, {"start": 203.79, "end": 205.79, "text": "原来是张将军到来"}, {"start": 205.79, "end": 238.22, "text": "虚惊了一场"}, {"start": 238.22, "end": 240.22, "text": "要不是你拦着"}, {"start": 240.22, "end": 242.22, "text": "我早就和他们厮杀起来"}, {"start": 242.22, "end": 244.22, "text": "什么也不说 见丞相再说"}, {"start": 244.22, "end": 246.22, "text": "张辽徐楚到"}, {"start": 246.22, "end": 258.37, "text": "丞相"}, {"start": 258.37, "end": 260.37, "text": "刘备拒绝回朝廷"}, {"start": 260.37, "end": 262.37, "text": "他说"}, {"start": 262.37, "end": 264.37, "text": "丞相在外军命有所不受"}, {"start": 264.37, "end": 266.37, "text": "他说他急着赶往徐州"}, {"start": 266.37, "end": 268.37, "text": "去截杀袁树"}, {"start": 268.37, "end": 270.37, "text": "托词"}, {"start": 270.37, "end": 272.37, "text": "刘备还说什么"}, {"start": 272.37, "end": 274.37, "text": "刘备还说"}, {"start": 274.37, "end": 276.37, "text": "容忌不可失"}, {"start": 276.37, "end": 278.37, "text": "他说"}, {"start": 278.37, "end": 280.37, "text": "他绝对不会辜负丞相"}, {"start": 280.37, "end": 282.37, "text": "更不会辜负朝廷"}, {"start": 282.37, "end": 284.37, "text": "刘备那四海百家阵势"}, {"start": 284.37, "end": 287.74, "text": "我将本想厮杀"}, {"start": 287.74, "end": 289.74, "text": "张辽不让"}, {"start": 289.74, "end": 296.93, "text": "张辽做得对"}, {"start": 296.93, "end": 301.68, "text": "诺"}, {"start": 301.68, "end": 321.12, "text": "丞相"}, {"start": 321.12, "end": 323.12, "text": "刘备抗命不归"}, {"start": 323.12, "end": 325.12, "text": "其心思已经昭然可知"}, {"start": 325.12, "end": 327.12, "text": "拖持将来"}, {"start": 327.12, "end": 329.12, "text": "会更加麻烦"}, {"start": 329.12, "end": 331.12, "text": "不如立刻派大军狡杀"}, {"start": 331.12, "end": 343.23, "text": "丞相"}, {"start": 343.23, "end": 345.23, "text": "我越来越觉得用刘备"}, {"start": 345.23, "end": 347.23, "text": "是用对了"}, {"start": 347.23, "end": 350.48, "text": "第一"}, {"start": 350.48, "end": 352.48, "text": "刘备此次出征"}, {"start": 352.48, "end": 354.48, "text": "必能截杀袁树"}, {"start": 354.48, "end": 356.48, "text": "替我除一大害"}, {"start": 356.48, "end": 358.48, "text": "第二"}, {"start": 358.48, "end": 360.48, "text": "我料他不敢反"}, {"start": 360.48, "end": 362.48, "text": "因为我有"}, {"start": 362.48, "end": 364.48, "text": "朱金 陆昭"}, {"start": 364.48, "end": 366.48, "text": "二将随征"}, {"start": 366.48, "end": 368.48, "text": "那五万人马"}, {"start": 368.48, "end": 370.48, "text": "为他们掌控不归刘备"}, {"start": 370.48, "end": 372.48, "text": "第三"}, {"start": 372.48, "end": 376.56, "text": "我历来用人都是"}, {"start": 376.56, "end": 378.56, "text": "一人不用"}, {"start": 378.56, "end": 382.51, "text": "用人不已"}, {"start": 382.51, "end": 384.51, "text": "既然用了"}, {"start": 384.51, "end": 389.94, "text": "岂能后悔我刘备敢反"}, {"start": 389.94, "end": 391.94, "text": "正好"}, {"start": 391.94, "end": 393.94, "text": "给我一个取他手机的机会"}, {"start": 393.94, "end": 407.58, "text": "承玉"}, {"start": 407.58, "end": 411.25, "text": "先生"}, {"start": 411.25, "end": 416.99, "text": "你怎么老是叹息"}, {"start": 416.99, "end": 418.99, "text": "刘备抗命不归"}, {"start": 418.99, "end": 420.99, "text": "我劝主公派大军征讲"}, {"start": 420.99, "end": 422.99, "text": "主公非但不听"}, {"start": 422.99, "end": 424.99, "text": "还哈哈大笑"}, {"start": 424.99, "end": 426.99, "text": "说什么他越想越觉得"}, {"start": 426.99, "end": 428.99, "text": "用刘备用对了"}, {"start": 428.99, "end": 430.99, "text": "你听这话 荒唐不荒唐"}, {"start": 430.99, "end": 440.64, "text": "我看主公不荒唐"}, {"start": 440.64, "end": 444.5, "text": "是你荒唐"}, {"start": 444.5, "end": 446.5, "text": "你想想"}, {"start": 446.5, "end": 448.5, "text": "你已经领兵跑了"}, {"start": 448.5, "end": 450.5, "text": "你再派大军去征讲"}, {"start": 450.5, "end": 452.5, "text": "那不是一误再误"}, {"start": 452.5, "end": 454.5, "text": "我们当前的大敌"}, {"start": 454.5, "end": 456.5, "text": "是袁绍不能节外生枝"}, {"start": 456.5, "end": 458.5, "text": "再数强敌"}, {"start": 460.5, "end": 462.5, "text": "既然沐浴成舟"}, {"start": 462.5, "end": 464.5, "text": "那就让刘备这支舟"}, {"start": 464.5, "end": 469.31, "text": "让他"}, {"start": 469.31, "end": 471.31, "text": "这样我们就可以集中力量"}, {"start": 471.31, "end": 476.32, "text": "先生所言极是"}, {"start": 476.32, "end": 478.32, "text": "可主公也是"}, {"start": 478.32, "end": 480.32, "text": "明明错了"}, {"start": 480.32, "end": 482.32, "text": "却不认错"}, {"start": 484.32, "end": 487.98, "text": "我告诉你吧"}, {"start": 487.98, "end": 489.98, "text": "其实主公心里"}, {"start": 489.98, "end": 491.98, "text": "早就知道错了"}, {"start": 491.98, "end": 493.98, "text": "日后他也会改错"}, {"start": 493.98, "end": 495.98, "text": "但他永远不会认错"}, {"start": 495.98, "end": 497.98, "text": "何为认错"}, {"start": 497.98, "end": 501.23, "text": "那就是知错改错"}, {"start": 501.23, "end": 503.23, "text": "不认错"}, {"start": 505.23, "end": 507.23, "text": "万万不肯认错"}, {"start": 507.23, "end": 528.53, "text": "主公"}, {"start": 528.53, "end": 530.53, "text": "主公 末将已查明"}, {"start": 530.53, "end": 532.53, "text": "袁术就藏于这座庙中"}, {"start": 532.53, "end": 534.53, "text": "残兵不过百人"}, {"start": 534.53, "end": 536.53, "text": "大哥 给我一路相当工夫"}, {"start": 536.53, "end": 538.53, "text": "我把这手刀起来"}, {"start": 538.53, "end": 545.46, "text": "那袁术也算是一方诸侯"}, {"start": 545.46, "end": 547.46, "text": "如果亲回许昌"}, {"start": 547.46, "end": 549.46, "text": "太过折辱他了"}, {"start": 549.46, "end": 552.74, "text": "这样吧 我写一封手书"}, {"start": 552.74, "end": 554.74, "text": "只能送进庙中"}, {"start": 554.74, "end": 556.74, "text": "面呈袁术"}, {"start": 556.74, "end": 558.74, "text": "让他自己斟酌吧"}, {"start": 558.74, "end": 560.74, "text": "遵命"}, {"start": 560.74, "end": 562.74, "text": "大哥 你就是心善"}, {"start": 562.74, "end": 564.74, "text": "忘了袁术大师"}, {"start": 564.74, "end": 596.21, "text": "断了咱们家粮饷啊"}, {"start": 596.21, "end": 598.21, "text": "渴死朕了"}, {"start": 598.21, "end": 600.21, "text": "还不赶快去找蜜水"}, {"start": 602.21, "end": 604.21, "text": "主公 现在都是血水"}, {"start": 604.21, "end": 606.21, "text": "没有蜜水啊"}, {"start": 608.21, "end": 610.21, "text": "去找啊"}, {"start": 610.21, "end": 625.84, "text": "皇上 皇上 外面来了位将军"}, {"start": 625.84, "end": 627.84, "text": "左将军刘备"}, {"start": 627.84, "end": 644.59, "text": "右书呈原公路将军"}, {"start": 644.59, "end": 646.59, "text": "公路将军如物"}, {"start": 646.59, "end": 648.59, "text": "刘备奉命生秦将军"}, {"start": 648.59, "end": 650.59, "text": "劫亡许昌"}, {"start": 650.59, "end": 652.59, "text": "别有不忍"}, {"start": 652.59, "end": 654.59, "text": "今日 唯叛军自绝"}, {"start": 654.59, "end": 656.59, "text": "不辱威名 刘备败上"}, {"start": 656.59, "end": 676.74, "text": "刘备还是个忠厚人哪"}, {"start": 676.74, "end": 709.94, "text": "鼎主公"}, {"start": 709.94, "end": 741.66, "text": "袁术自裁了"}, {"start": 741.66, "end": 743.66, "text": "有多少英雄豪杰"}, {"start": 743.66, "end": 745.66, "text": "都被这块石头"}, {"start": 745.66, "end": 757.1, "text": "罪将朱金"}, {"start": 757.1, "end": 759.1, "text": "叩报丞相"}, {"start": 759.1, "end": 761.1, "text": "刘备令罪驾"}, {"start": 761.1, "end": 763.1, "text": "把这川国玉玺带回来"}, {"start": 763.1, "end": 765.1, "text": "献给主公"}, {"start": 765.1, "end": 767.1, "text": "却扣下了五万兵马"}, {"start": 767.1, "end": 769.1, "text": "虚中以防袁绍大军来及"}, {"start": 769.1, "end": 771.1, "text": "虚中原本就是我的"}, {"start": 771.1, "end": 774.64, "text": "我的"}, {"start": 774.64, "end": 776.64, "text": "我自有车中将军把守"}, {"start": 776.64, "end": 782.0, "text": "干刘备何事"}, {"start": 782.0, "end": 784.0, "text": "五万兵马如何就是了"}, {"start": 784.0, "end": 786.0, "text": "那天"}, {"start": 786.0, "end": 788.0, "text": "张飞设酒宴"}, {"start": 788.0, "end": 790.0, "text": "把罪将的都给灌醉了"}, {"start": 790.0, "end": 792.0, "text": "等我醒来时"}, {"start": 792.0, "end": 794.0, "text": "一被绑在了车上"}, {"start": 794.0, "end": 796.0, "text": "刘备令我把这玉玺"}, {"start": 796.0, "end": 798.0, "text": "献给丞相"}, {"start": 798.0, "end": 800.0, "text": "我要他何用"}, {"start": 800.0, "end": 804.42, "text": "报"}, {"start": 804.42, "end": 805.42, "text": "推出去斩了"}, {"start": 805.42, "end": 807.42, "text": "丞相 饶命啊"}, {"start": 807.42, "end": 809.42, "text": "丞相 丞相"}, {"start": 809.42, "end": 811.42, "text": "丞相 丞相"}, {"start": 811.42, "end": 816.21, "text": "饶命啊丞相"}, {"start": 816.21, "end": 820.06, "text": "草人 末将在"}, {"start": 820.06, "end": 822.06, "text": "即刻给车中增兵三万"}, {"start": 824.06, "end": 826.06, "text": "让他严防虚中"}, {"start": 826.06, "end": 828.06, "text": "告诉他"}, {"start": 828.06, "end": 830.06, "text": "刘备胆敢来攻城"}, {"start": 830.06, "end": 832.06, "text": "即刻尽杀堤州来见"}, {"start": 832.06, "end": 835.6, "text": "报"}, {"start": 835.6, "end": 837.6, "text": "禀丞相 请拜兵回报"}, {"start": 837.6, "end": 839.6, "text": "堤州已经被刘备占据"}, {"start": 839.6, "end": 841.6, "text": "守将车中也被关羽斩杀"}, {"start": 841.6, "end": 843.6, "text": "堤州各郡"}, {"start": 843.6, "end": 845.6, "text": "都已见入刘备手中"}, {"start": 856.43, "end": 858.43, "text": "不可能"}, {"start": 858.43, "end": 860.43, "text": "绝对不可能"}, {"start": 860.43, "end": 862.43, "text": "车中"}, {"start": 862.43, "end": 864.43, "text": "有八万精兵"}, {"start": 864.43, "end": 866.43, "text": "驻防堤州 八万哪"}, {"start": 866.43, "end": 868.43, "text": "你就算是八万个馒头"}, {"start": 868.43, "end": 870.43, "text": "刘备也得啃杀半个月"}, {"start": 870.43, "end": 872.43, "text": "怎么可能说丢就丢"}, {"start": 872.43, "end": 877.06, "text": "丞相"}, {"start": 877.06, "end": 879.06, "text": "完全有可能"}, {"start": 879.06, "end": 881.06, "text": "你说什么"}, {"start": 881.06, "end": 883.06, "text": "丞相"}, {"start": 883.06, "end": 885.06, "text": "刘备奉命出师"}, {"start": 885.06, "end": 887.06, "text": "他手中有一枚您搬给的兵符"}, {"start": 887.06, "end": 889.06, "text": "他很可能用此兵符"}, {"start": 889.06, "end": 891.06, "text": "遍开堤州城门"}, {"start": 891.06, "end": 893.06, "text": "车中将近建此兵符以后"}, {"start": 893.06, "end": 895.06, "text": "还以为刘备"}, {"start": 895.06, "end": 928.29, "text": "是丞相派来的"}, {"start": 928.29, "end": 930.29, "text": "丞相"}, {"start": 930.29, "end": 932.29, "text": "快叫太医"}, {"start": 932.29, "end": 969.39, "text": "我病了几日了"}, {"start": 969.39, "end": 972.99, "text": "三日"}, {"start": 972.99, "end": 977.01, "text": "那病养得也差不多了吧"}, {"start": 979.01, "end": 981.01, "text": "我给你的几部兵书"}, {"start": 983.01, "end": 985.01, "text": "你可曾认真研修"}, {"start": 987.01, "end": 989.01, "text": "孩儿正在研修"}, {"start": 989.01, "end": 991.01, "text": "不可怠慢兵法之道"}, {"start": 991.01, "end": 994.7, "text": "变化无常"}, {"start": 994.7, "end": 998.24, "text": "既要熟读兵书"}, {"start": 998.24, "end": 1000.24, "text": "又不能"}, {"start": 1000.24, "end": 1002.24, "text": "被兵法所负"}, {"start": 1004.24, "end": 1006.24, "text": "过两日我要听你心得"}, {"start": 1006.24, "end": 1012.85, "text": "侄儿"}, {"start": 1012.85, "end": 1014.85, "text": "孩儿在"}, {"start": 1014.85, "end": 1016.85, "text": "今日"}, {"start": 1016.85, "end": 1018.85, "text": "可做了些好诗文吗"}, {"start": 1018.85, "end": 1020.85, "text": "儿与纪康孔戎等兵客"}, {"start": 1020.85, "end": 1022.85, "text": "都有诗文唱和"}, {"start": 1022.85, "end": 1032.11, "text": "好"}, {"start": 1032.11, "end": 1034.11, "text": "就今日下午"}, {"start": 1034.11, "end": 1036.11, "text": "拿来念我听听"}, {"start": 1038.11, "end": 1040.11, "text": "好诗文"}, {"start": 1040.11, "end": 1042.11, "text": "胜过灵丹妙药"}, {"start": 1042.11, "end": 1047.66, "text": "孩儿遵命"}, {"start": 1047.66, "end": 1049.66, "text": "纪平"}, {"start": 1049.66, "end": 1051.66, "text": "你具实说"}, {"start": 1051.66, "end": 1053.66, "text": "我这病况如何"}, {"start": 1053.66, "end": 1057.46, "text": "丞相"}, {"start": 1057.46, "end": 1059.46, "text": "你患的头痛病"}, {"start": 1059.46, "end": 1061.46, "text": "十日已久了"}, {"start": 1061.46, "end": 1063.46, "text": "平时无大碍"}, {"start": 1063.46, "end": 1065.46, "text": "可是一旦动怒"}, {"start": 1065.46, "end": 1067.46, "text": "便会突发"}, {"start": 1067.46, "end": 1071.22, "text": "还望丞相安心静养"}, {"start": 1071.22, "end": 1073.22, "text": "不是已经养了三日了吗"}, {"start": 1073.22, "end": 1075.22, "text": "差不多了吧"}, {"start": 1075.22, "end": 1077.22, "text": "丞相"}, {"start": 1077.22, "end": 1079.22, "text": "还需静养"}, {"start": 1079.22, "end": 1101.89, "text": "三十日"}, {"start": 1101.89, "end": 1103.89, "text": "丞相"}, {"start": 1103.89, "end": 1105.89, "text": "若得知我得了徐州"}, {"start": 1105.89, "end": 1109.68, "text": "定然会龙心大悦"}, {"start": 1109.68, "end": 1111.68, "text": "不但徐州城"}, {"start": 1111.68, "end": 1113.68, "text": "重回到我们的手里"}, {"start": 1113.68, "end": 1115.68, "text": "还增添了九万多兵马"}, {"start": 1115.68, "end": 1117.68, "text": "子龙正在抓紧训练"}, {"start": 1117.68, "end": 1119.68, "text": "军容不俗"}, {"start": 1119.68, "end": 1121.68, "text": "群情振奋"}, {"start": 1121.68, "end": 1123.68, "text": "好"}, {"start": 1123.68, "end": 1125.68, "text": "子龙不但有汉将之誉"}, {"start": 1125.68, "end": 1127.68, "text": "更有大将之才"}, {"start": 1127.68, "end": 1129.68, "text": "告诉他让他加紧操练"}, {"start": 1129.68, "end": 1131.68, "text": "不出二十日"}, {"start": 1131.68, "end": 1135.79, "text": "丞相必定来反"}, {"start": 1135.79, "end": 1137.79, "text": "芈芳"}, {"start": 1137.79, "end": 1141.94, "text": "主公"}, {"start": 1141.94, "end": 1145.47, "text": "劳你去冀州觐见袁绍"}, {"start": 1145.47, "end": 1147.47, "text": "将此信交给他"}, {"start": 1147.47, "end": 1149.47, "text": "一者传达天子写诏旨意"}, {"start": 1149.47, "end": 1151.47, "text": "请他快快发兵"}, {"start": 1151.47, "end": 1153.47, "text": "秦王剿贼"}, {"start": 1153.47, "end": 1155.47, "text": "二者"}, {"start": 1155.47, "end": 1157.47, "text": "告诉他"}, {"start": 1157.47, "end": 1159.47, "text": "无论他何日起兵"}, {"start": 1159.47, "end": 1161.47, "text": "刘备都愿意听起号令"}, {"start": 1161.47, "end": 1163.47, "text": "敢当麾下先锋"}, {"start": 1163.47, "end": 1167.65, "text": "诺"}, {"start": 1167.65, "end": 1169.65, "text": "主公现已雄据四州之地"}, {"start": 1169.65, "end": 1171.65, "text": "粮草军饷大为富足"}, {"start": 1171.65, "end": 1173.65, "text": "兵甲百万战将千元"}, {"start": 1173.65, "end": 1175.65, "text": "即使刘备不传天子诏书"}, {"start": 1175.65, "end": 1177.65, "text": "主公也应当举兵讨伐曹操"}, {"start": 1177.65, "end": 1179.65, "text": "以求一统天下"}, {"start": 1179.65, "end": 1181.65, "text": "在下再强调一句"}, {"start": 1181.65, "end": 1183.65, "text": "主公举兵灭曹"}, {"start": 1183.65, "end": 1185.65, "text": "并不是为了招不保息的天子"}, {"start": 1185.65, "end": 1187.65, "text": "更不是为了扶旱"}, {"start": 1187.65, "end": 1191.12, "text": "而是为了主公自己的君王大业"}, {"start": 1191.12, "end": 1193.12, "text": "主公"}, {"start": 1193.12, "end": 1195.12, "text": "主公刚刚战霸公孙瓒"}, {"start": 1195.12, "end": 1197.12, "text": "三军尚未得到修正"}, {"start": 1197.12, "end": 1199.12, "text": "人困马法"}, {"start": 1199.12, "end": 1201.12, "text": "加上近年来连年征战"}, {"start": 1201.12, "end": 1203.12, "text": "使得所属各州焦土一片"}, {"start": 1203.12, "end": 1205.12, "text": "地无庄家民不聊生"}, {"start": 1205.12, "end": 1207.12, "text": "国徒所言"}, {"start": 1207.12, "end": 1209.12, "text": "粮草军饷大为富足"}, {"start": 1209.12, "end": 1211.12, "text": "那是纸上画饼"}, {"start": 1211.12, "end": 1213.12, "text": "是脖侧上的说服"}, {"start": 1213.12, "end": 1215.12, "text": "如果要真把这些收入仓利"}, {"start": 1215.12, "end": 1217.12, "text": "用于军旅"}, {"start": 1217.12, "end": 1219.12, "text": "那每个三五年的时间"}, {"start": 1219.12, "end": 1221.12, "text": "是万万不可的"}, {"start": 1221.12, "end": 1223.12, "text": "臣建议"}, {"start": 1223.12, "end": 1225.12, "text": "主公修兵养民"}, {"start": 1225.12, "end": 1227.12, "text": "军力民力充沛后"}, {"start": 1227.12, "end": 1231.97, "text": "再行举兵发草"}, {"start": 1231.97, "end": 1233.97, "text": "禀主公"}, {"start": 1233.97, "end": 1235.97, "text": "田丰所言这乃殊生之计"}, {"start": 1235.97, "end": 1237.97, "text": "眼下主公兵方正胜"}, {"start": 1237.97, "end": 1239.97, "text": "三军斗者昂扬"}, {"start": 1239.97, "end": 1241.97, "text": "凭主公之神武"}, {"start": 1241.97, "end": 1243.97, "text": "将士之昂扬"}, {"start": 1243.97, "end": 1245.97, "text": "许昌指日可下"}, {"start": 1245.97, "end": 1247.97, "text": "灭草易如反者"}, {"start": 1247.97, "end": 1249.97, "text": "请主公即刻发兵"}, {"start": 1249.97, "end": 1251.97, "text": "不可犹豫"}, {"start": 1251.97, "end": 1253.97, "text": "更不可谦言时日"}, {"start": 1253.97, "end": 1255.97, "text": "主公"}, {"start": 1255.97, "end": 1257.97, "text": "但能成就霸业者"}, {"start": 1257.97, "end": 1259.97, "text": "并不是依靠着"}, {"start": 1259.97, "end": 1261.97, "text": "他们的兵甲多寡"}, {"start": 1261.97, "end": 1263.97, "text": "也不是依靠着攻城拔寨"}, {"start": 1263.97, "end": 1265.97, "text": "而是依靠着国力民力"}, {"start": 1265.97, "end": 1267.97, "text": "依靠着土地能找多少庄稼"}, {"start": 1267.97, "end": 1269.97, "text": "他们身后有多少子民"}, {"start": 1269.97, "end": 1271.97, "text": "归根到底"}, {"start": 1271.97, "end": 1273.97, "text": "大仗拼的就是国力民力"}, {"start": 1273.97, "end": 1275.97, "text": "主公"}, {"start": 1275.97, "end": 1277.97, "text": "坐拥禁"}, {"start": 1277.97, "end": 1279.97, "text": "清幽并四大州"}, {"start": 1279.97, "end": 1281.97, "text": "而草草"}, {"start": 1281.97, "end": 1283.97, "text": "只有衍州四郡"}, {"start": 1283.97, "end": 1285.97, "text": "可怀南一步"}, {"start": 1285.97, "end": 1287.97, "text": "总体实力不及主公一半"}, {"start": 1287.97, "end": 1289.97, "text": "主公"}, {"start": 1289.97, "end": 1291.97, "text": "只需整军养民"}, {"start": 1291.97, "end": 1293.97, "text": "富强自己静观天下"}, {"start": 1293.97, "end": 1295.97, "text": "三年后再取草草"}, {"start": 1295.97, "end": 1297.97, "text": "那可真是如泰山压顶"}, {"start": 1297.97, "end": 1299.97, "text": "势不可挡啊"}, {"start": 1299.97, "end": 1308.46, "text": "主公"}, {"start": 1308.46, "end": 1310.46, "text": "许昌"}, {"start": 1310.46, "end": 1314.61, "text": "你来得正好"}, {"start": 1314.61, "end": 1316.61, "text": "国徒主张我"}, {"start": 1316.61, "end": 1318.61, "text": "举兵发草"}, {"start": 1318.61, "end": 1320.61, "text": "天锋"}, {"start": 1320.61, "end": 1322.61, "text": "主张我休养生息"}, {"start": 1322.61, "end": 1326.34, "text": "你意如何呀"}, {"start": 1328.34, "end": 1330.34, "text": "回主公"}, {"start": 1330.34, "end": 1332.34, "text": "刚才国徒天锋二位大人"}, {"start": 1332.34, "end": 1334.34, "text": "他们的争论"}, {"start": 1334.34, "end": 1336.34, "text": "在下听明白了"}, {"start": 1336.34, "end": 1340.32, "text": "在下以为"}, {"start": 1340.32, "end": 1342.32, "text": "无论是战事何"}, {"start": 1342.32, "end": 1344.32, "text": "我们都不能仅仅"}, {"start": 1344.32, "end": 1346.32, "text": "只看自家的情况"}, {"start": 1346.32, "end": 1348.32, "text": "还要看一看敌人的情况"}, {"start": 1348.32, "end": 1350.32, "text": "不仅要知道敌人最怕什么"}, {"start": 1350.32, "end": 1352.32, "text": "也要知道敌人"}, {"start": 1352.32, "end": 1354.32, "text": "敌人最想什么"}, {"start": 1354.32, "end": 1356.32, "text": "正可谓兵家云"}, {"start": 1356.32, "end": 1358.32, "text": "知彼知己"}, {"start": 1358.32, "end": 1360.32, "text": "方能百战不带"}, {"start": 1360.32, "end": 1365.62, "text": "在下以为"}, {"start": 1365.62, "end": 1367.62, "text": "那草草现在"}, {"start": 1367.62, "end": 1369.62, "text": "最想太平"}, {"start": 1369.62, "end": 1371.62, "text": "且最怕交战"}, {"start": 1371.62, "end": 1373.62, "text": "因为我家主公熊聚"}, {"start": 1373.62, "end": 1375.62, "text": "寄青幽病四周"}, {"start": 1375.62, "end": 1377.62, "text": "可谓地大物薄"}, {"start": 1377.62, "end": 1379.62, "text": "兵强马壮"}, {"start": 1379.62, "end": 1381.62, "text": "在当今天下诸侯中"}, {"start": 1381.62, "end": 1383.62, "text": "独战疯癫"}, {"start": 1383.62, "end": 1386.9, "text": "曹操呢"}, {"start": 1386.9, "end": 1388.9, "text": "虽力不及主公"}, {"start": 1388.9, "end": 1390.9, "text": "可他却处在"}, {"start": 1390.9, "end": 1392.9, "text": "一个上升的时期"}, {"start": 1392.9, "end": 1394.9, "text": "所谓上升时期嘛"}, {"start": 1394.9, "end": 1396.9, "text": "就更需要维持"}, {"start": 1396.9, "end": 1398.9, "text": "相对的稳定"}, {"start": 1398.9, "end": 1400.9, "text": "以求得发展"}, {"start": 1400.9, "end": 1402.9, "text": "主公"}, {"start": 1402.9, "end": 1404.9, "text": "如果我们也修养生息"}, {"start": 1404.9, "end": 1406.9, "text": "表面看似"}, {"start": 1406.9, "end": 1408.9, "text": "对我们有利"}, {"start": 1408.9, "end": 1410.9, "text": "实则是对那草草"}, {"start": 1410.9, "end": 1412.9, "text": "更加有利"}, {"start": 1412.9, "end": 1414.9, "text": "那草草比主公"}, {"start": 1414.9, "end": 1416.9, "text": "更需要时间来发展壮大呀"}, {"start": 1418.9, "end": 1420.9, "text": "主公啊"}, {"start": 1420.9, "end": 1422.9, "text": "此时此刻"}, {"start": 1422.9, "end": 1424.9, "text": "正是敌我双方实力"}, {"start": 1424.9, "end": 1426.9, "text": "相差最大的时候"}, {"start": 1426.9, "end": 1428.9, "text": "实属天赐良机"}, {"start": 1428.9, "end": 1430.9, "text": "千载难逢啊"}, {"start": 1432.9, "end": 1434.9, "text": "如果主公千言日久"}, {"start": 1436.9, "end": 1438.9, "text": "我们就只有做官"}, {"start": 1438.9, "end": 1440.9, "text": "那草草一日壮大起来"}, {"start": 1442.9, "end": 1446.9, "text": "最后与主公并立于势"}, {"start": 1446.9, "end": 1448.9, "text": "主公"}, {"start": 1448.9, "end": 1450.9, "text": "要真到那时"}, {"start": 1450.9, "end": 1465.15, "text": "这胜负"}, {"start": 1465.15, "end": 1467.15, "text": "我心已定"}, {"start": 1467.15, "end": 1469.15, "text": "立即发兵"}, {"start": 1469.15, "end": 1471.15, "text": "免草"}, {"start": 1471.15, "end": 1473.15, "text": "我们奉公主命令"}, {"start": 1473.15, "end": 1476.69, "text": "听令"}, {"start": 1476.69, "end": 1478.69, "text": "则徐幽国徒为军师"}, {"start": 1478.69, "end": 1480.69, "text": "严良门丑为大将"}, {"start": 1480.69, "end": 1482.69, "text": "其马军数万"}, {"start": 1482.69, "end": 1484.69, "text": "步军数万"}, {"start": 1484.69, "end": 1485.69, "text": "进军"}, {"start": 1485.69, "end": 1486.69, "text": "离揚"}, {"start": 1486.69, "end": 1492.53, "text": "遵命"}, {"start": 1492.53, "end": 1493.53, "text": "淳林啊"}, {"start": 1493.53, "end": 1494.53, "text": "在"}, {"start": 1494.53, "end": 1498.7, "text": "你是我们这里"}, {"start": 1498.7, "end": 1500.7, "text": "最有才华的才子了"}, {"start": 1502.7, "end": 1503.7, "text": "找你"}, {"start": 1503.7, "end": 1505.7, "text": "替我拟写一道"}, {"start": 1505.7, "end": 1507.7, "text": "讨贼稀文"}, {"start": 1507.7, "end": 1509.7, "text": "不告天下"}, {"start": 1509.7, "end": 1512.98, "text": "在下遵命"}, {"start": 1512.98, "end": 1516.22, "text": "好"}, {"start": 1516.22, "end": 1518.22, "text": "民主图威已治变"}, {"start": 1518.22, "end": 1520.22, "text": "忠臣遇难"}, {"start": 1520.22, "end": 1522.22, "text": "已立权"}, {"start": 1522.22, "end": 1524.22, "text": "自以有非常之人"}, {"start": 1524.22, "end": 1526.22, "text": "然后有非常之事"}, {"start": 1526.22, "end": 1528.22, "text": "有非常之事"}, {"start": 1528.22, "end": 1530.22, "text": "然后建非常之公"}, {"start": 1530.22, "end": 1532.22, "text": "司空曹操"}, {"start": 1532.22, "end": 1534.22, "text": "其祖父曹腾"}, {"start": 1534.22, "end": 1536.22, "text": "兮为功为奸患"}, {"start": 1536.22, "end": 1538.22, "text": "韬铁放纵"}, {"start": 1538.22, "end": 1540.22, "text": "伤化虐民"}, {"start": 1540.22, "end": 1542.22, "text": "其父曹松"}, {"start": 1542.22, "end": 1543.22, "text": "贪如柴"}, {"start": 1543.22, "end": 1544.22, "text": "刁如蛇"}, {"start": 1544.22, "end": 1545.22, "text": "毒如蝎"}, {"start": 1545.22, "end": 1546.22, "text": "狠如狼"}, {"start": 1546.22, "end": 1547.22, "text": "曹氏一门"}, {"start": 1547.22, "end": 1548.22, "text": "从祖到孙"}, {"start": 1548.22, "end": 1551.22, "text": "尽为坠烟遗丑"}, {"start": 1551.22, "end": 1553.22, "text": "斧臭勾当"}, {"start": 1553.22, "end": 1556.22, "text": "大将军袁绍奉汉威灵"}, {"start": 1556.22, "end": 1557.22, "text": "折冲咒语"}, {"start": 1557.22, "end": 1559.22, "text": "长几百万"}, {"start": 1559.22, "end": 1560.22, "text": "建计千群"}, {"start": 1560.22, "end": 1563.22, "text": "并周约太行"}, {"start": 1564.22, "end": 1566.22, "text": "好文章"}, {"start": 1566.22, "end": 1569.22, "text": "试入奔马七贯长虹啊"}, {"start": 1569.22, "end": 1572.22, "text": "真是难得一见的好文章"}, {"start": 1572.22, "end": 1575.92, "text": "你们俩也看看"}, {"start": 1575.92, "end": 1577.92, "text": "这个陈林堪称天下奇才"}, {"start": 1577.92, "end": 1580.92, "text": "雄士古今的大手"}, {"start": 1580.92, "end": 1581.92, "text": "就这一篇细文"}, {"start": 1581.92, "end": 1583.92, "text": "抵得上十万大军呢"}, {"start": 1583.92, "end": 1589.44, "text": "曹芝"}, {"start": 1589.44, "end": 1590.44, "text": "曹芝"}, {"start": 1590.44, "end": 1592.94, "text": "你为何就写不出"}, {"start": 1592.94, "end": 1594.94, "text": "这等文章来"}, {"start": 1595.94, "end": 1596.94, "text": "你府上的那些人"}, {"start": 1596.94, "end": 1597.94, "text": "不也是号称"}, {"start": 1597.94, "end": 1599.94, "text": "宝学之士吗"}, {"start": 1599.94, "end": 1602.94, "text": "我看都是酒囊饭袋"}, {"start": 1602.94, "end": 1603.94, "text": "还有你"}, {"start": 1603.94, "end": 1605.94, "text": "好高误远"}, {"start": 1605.94, "end": 1607.94, "text": "没有真才识学"}, {"start": 1607.94, "end": 1611.51, "text": "父亲责备的是"}, {"start": 1611.51, "end": 1613.51, "text": "孩儿惭愧"}, {"start": 1613.51, "end": 1614.51, "text": "传命各级文武"}, {"start": 1614.51, "end": 1615.51, "text": "大唐一正"}, {"start": 1616.51, "end": 1617.51, "text": "父亲父亲"}, {"start": 1617.51, "end": 1619.51, "text": "那你的病还没好呢"}, {"start": 1619.51, "end": 1620.51, "text": "陈林的这篇细文"}, {"start": 1620.51, "end": 1622.51, "text": "就是灵丹妙药啊"}, {"start": 1622.51, "end": 1624.51, "text": "给我惊出一身冷汗"}, {"start": 1624.51, "end": 1626.51, "text": "头疯早好了"}, {"start": 1628.51, "end": 1629.51, "text": "袁绍地广民风"}, {"start": 1629.51, "end": 1633.3, "text": "代价百万"}, {"start": 1633.3, "end": 1634.3, "text": "文臣武将"}, {"start": 1634.3, "end": 1635.3, "text": "更是数不胜数"}, {"start": 1635.3, "end": 1637.3, "text": "如许忧郭徒"}, {"start": 1637.3, "end": 1639.3, "text": "田峰庞季等人"}, {"start": 1639.3, "end": 1641.3, "text": "都是志谋超群"}, {"start": 1641.3, "end": 1645.3, "text": "严良文丑张合"}, {"start": 1645.3, "end": 1647.3, "text": "淳于穹也都是当世名将"}, {"start": 1647.3, "end": 1650.3, "text": "丞相不可以与袁绍交战"}, {"start": 1650.3, "end": 1652.3, "text": "只可以与袁绍议和"}, {"start": 1652.3, "end": 1658.9, "text": "丞相"}, {"start": 1658.9, "end": 1660.9, "text": "先生所言"}, {"start": 1660.9, "end": 1662.9, "text": "真乃俯如之见"}, {"start": 1662.9, "end": 1663.9, "text": "依我看"}, {"start": 1663.9, "end": 1665.9, "text": "袁绍有时败"}, {"start": 1665.9, "end": 1668.9, "text": "丞相有时胜"}, {"start": 1668.9, "end": 1670.9, "text": "愿闻其详"}, {"start": 1671.9, "end": 1674.9, "text": "袁绍喜欢凡夫礼仪"}, {"start": 1674.9, "end": 1676.9, "text": "丞相喜欢自然天成"}, {"start": 1676.9, "end": 1678.9, "text": "此为道胜"}, {"start": 1678.9, "end": 1680.9, "text": "袁绍以逆动"}, {"start": 1680.9, "end": 1682.9, "text": "丞相爱顺势"}, {"start": 1682.9, "end": 1683.9, "text": "此为义胜"}, {"start": 1684.9, "end": 1686.9, "text": "袁绍以宽济"}, {"start": 1686.9, "end": 1688.9, "text": "丞相以猛咎"}, {"start": 1688.9, "end": 1689.9, "text": "此为智胜"}, {"start": 1690.9, "end": 1692.9, "text": "袁绍外宽内济"}, {"start": 1692.9, "end": 1693.9, "text": "任人为亲"}, {"start": 1693.9, "end": 1695.9, "text": "丞相外解内明"}, {"start": 1695.9, "end": 1697.9, "text": "任人为才"}, {"start": 1697.9, "end": 1698.9, "text": "此为杜胜"}, {"start": 1700.9, "end": 1702.9, "text": "袁绍多谋少决"}, {"start": 1702.9, "end": 1704.9, "text": "丞相多谋善断"}, {"start": 1704.9, "end": 1706.9, "text": "此为谋胜"}, {"start": 1707.9, "end": 1710.9, "text": "袁绍嗜好虚敏"}, {"start": 1710.9, "end": 1712.9, "text": "丞相以诚待势"}, {"start": 1712.9, "end": 1714.9, "text": "此为得胜"}, {"start": 1715.9, "end": 1717.9, "text": "袁绍忽近忽远"}, {"start": 1717.9, "end": 1719.9, "text": "丞相远近捷场"}, {"start": 1719.9, "end": 1721.9, "text": "此为人胜"}, {"start": 1722.9, "end": 1724.9, "text": "袁绍听信禅言"}, {"start": 1724.9, "end": 1726.9, "text": "丞相动若观火"}, {"start": 1726.9, "end": 1728.9, "text": "此为名胜"}, {"start": 1728.9, "end": 1730.9, "text": "袁绍是非混淆"}, {"start": 1730.9, "end": 1732.9, "text": "丞相法度严谨"}, {"start": 1732.9, "end": 1734.9, "text": "此为闻胜"}, {"start": 1734.9, "end": 1736.9, "text": "袁绍浩大喜功"}, {"start": 1736.9, "end": 1737.9, "text": "不知兵法"}, {"start": 1737.9, "end": 1739.9, "text": "丞相以少克重"}, {"start": 1739.9, "end": 1741.9, "text": "用兵如神"}, {"start": 1741.9, "end": 1742.9, "text": "此为武胜"}, {"start": 1743.9, "end": 1745.9, "text": "袁绍有此失败"}, {"start": 1745.9, "end": 1748.9, "text": "丞相有此失胜"}, {"start": 1748.9, "end": 1750.9, "text": "虽然战端未开"}, {"start": 1750.9, "end": 1753.9, "text": "臣以为胜负已定"}, {"start": 1753.9, "end": 1770.3, "text": "战和之争"}, {"start": 1771.3, "end": 1773.3, "text": "就到此为止"}, {"start": 1774.3, "end": 1775.3, "text": "你等回营"}, {"start": 1775.3, "end": 1777.3, "text": "速速整军"}, {"start": 1777.3, "end": 1778.3, "text": "五日之后"}, {"start": 1779.3, "end": 1782.3, "text": "我要亲自率二十万大军"}, {"start": 1783.3, "end": 1784.3, "text": "迎战"}, {"start": 1785.3, "end": 1786.3, "text": "袁绍"}, {"start": 1786.3, "end": 1791.89, "text": "大喜啊"}, {"start": 1791.89, "end": 1794.89, "text": "刘备已收复徐州"}, {"start": 1794.89, "end": 1796.89, "text": "得兵九万"}, {"start": 1796.89, "end": 1798.89, "text": "并且把陛下的诏书"}, {"start": 1798.89, "end": 1800.89, "text": "传给了袁绍"}, {"start": 1800.89, "end": 1803.89, "text": "袁绍发出了讨贼息文"}, {"start": 1803.89, "end": 1805.89, "text": "诏告天下"}, {"start": 1805.89, "end": 1807.89, "text": "拒三十万大军"}, {"start": 1807.89, "end": 1809.89, "text": "征讨曹贼"}, {"start": 1809.89, "end": 1810.89, "text": "太好了"}, {"start": 1810.89, "end": 1815.1, "text": "袁绍和刘备的义军"}, {"start": 1815.1, "end": 1816.1, "text": "何时进入徐城"}, {"start": 1816.1, "end": 1817.1, "text": "这"}, {"start": 1817.1, "end": 1819.1, "text": "这是早晚的事"}, {"start": 1820.1, "end": 1821.1, "text": "不过"}, {"start": 1822.1, "end": 1825.1, "text": "陛下不可太心急"}, {"start": 1825.1, "end": 1829.02, "text": "臣有一计"}, {"start": 1829.02, "end": 1832.02, "text": "与袁柳大军理应外合"}, {"start": 1832.02, "end": 1834.02, "text": "一举定天下"}, {"start": 1834.02, "end": 1836.02, "text": "爱卿有何妙计"}, {"start": 1836.02, "end": 1839.71, "text": "我有一密友"}, {"start": 1839.71, "end": 1841.71, "text": "名叫吉平"}, {"start": 1841.71, "end": 1843.71, "text": "现在他这宫廷太医"}, {"start": 1843.71, "end": 1845.71, "text": "正为曹操治病"}, {"start": 1845.71, "end": 1847.71, "text": "此人誓守国恩"}, {"start": 1847.71, "end": 1851.71, "text": "深怀保国大志"}, {"start": 1851.71, "end": 1852.71, "text": "不国贼"}, {"start": 1852.71, "end": 1872.74, "text": "何须援留那些兵马"}, {"start": 1872.74, "end": 1875.74, "text": "只要在下一举手"}, {"start": 1875.74, "end": 1878.74, "text": "便可取曹操的性命"}, {"start": 1878.74, "end": 1879.74, "text": "曹操身边"}, {"start": 1879.74, "end": 1881.74, "text": "假誓如云"}, {"start": 1881.74, "end": 1884.74, "text": "外人根本无法接近"}, {"start": 1884.74, "end": 1885.74, "text": "兄台"}, {"start": 1885.74, "end": 1888.74, "text": "为何如此自信呢"}, {"start": 1888.74, "end": 1890.74, "text": "我哪里是什么外人"}, {"start": 1890.74, "end": 1891.74, "text": "这几日"}, {"start": 1891.74, "end": 1892.74, "text": "我几乎成了"}, {"start": 1892.74, "end": 1894.74, "text": "曹操的贴身侍卫"}, {"start": 1894.74, "end": 1896.74, "text": "每次他犯头疯"}, {"start": 1896.74, "end": 1898.74, "text": "都要换我去相府"}, {"start": 1898.74, "end": 1899.74, "text": "为其治疗"}, {"start": 1899.74, "end": 1900.74, "text": "让我在药罐里"}, {"start": 1900.74, "end": 1910.46, "text": "便会医命无辜"}, {"start": 1910.46, "end": 1911.46, "text": "即使你成功地"}, {"start": 1911.46, "end": 1920.3, "text": "毒死了曹操"}, {"start": 1920.3, "end": 1922.3, "text": "自己不是也会被杀吗"}, {"start": 1922.3, "end": 1924.3, "text": "为国捐躯"}, {"start": 1924.3, "end": 1935.17, "text": "死得其所"}, {"start": 1935.17, "end": 1936.17, "text": "世世代代"}, {"start": 1936.17, "end": 1940.95, "text": "饱受国恩"}, {"start": 1940.95, "end": 1942.95, "text": "请陛下有难"}, {"start": 1943.95, "end": 1946.95, "text": "为臣者何惜此命"}, {"start": 1946.95, "end": 1956.9, "text": "陛下得姬平兄相助"}, {"start": 1956.9, "end": 1959.9, "text": "朕乃天将福音"}, {"start": 1959.9, "end": 1962.9, "text": "社稷大幸啊"}, {"start": 1962.9, "end": 1964.9, "text": "只要曹操一死"}, {"start": 1964.9, "end": 1966.9, "text": "徐长城便是全都无首"}, {"start": 1966.9, "end": 1968.9, "text": "所有的文臣武将们"}, {"start": 1968.9, "end": 1971.9, "text": "只能拥戴陛下"}, {"start": 1971.9, "end": 1973.9, "text": "那时"}, {"start": 1973.9, "end": 1975.9, "text": "陛下定将其"}, {"start": 1975.9, "end": 1978.9, "text": "陛下定将姬平兄的灵位"}, {"start": 1978.9, "end": 1980.9, "text": "供于宫臣阁中"}, {"start": 1980.9, "end": 1983.9, "text": "与高祖帝为伴"}, {"start": 1983.9, "end": 1987.9, "text": "享受万世共奉"}, {"start": 1987.9, "end": 1988.9, "text": "妹子"}, {"start": 1988.9, "end": 1991.9, "text": "哥来了"}, {"start": 1991.9, "end": 1993.9, "text": "快快快"}, {"start": 1993.9, "end": 1997.81, "text": "来吧"}, {"start": 1997.81, "end": 2003.81, "text": "疼死你了"}, {"start": 2003.81, "end": 2019.76, "text": "你作孽呀"}, {"start": 2019.76, "end": 2020.76, "text": "给我拿下"}, {"start": 2020.76, "end": 2021.76, "text": "启禀主公"}, {"start": 2021.76, "end": 2025.17, "text": "不然庆彤与郑云英"}, {"start": 2025.17, "end": 2027.17, "text": "在那柴房行禽兽之中"}, {"start": 2027.17, "end": 2029.17, "text": "被奴才当场拿获"}, {"start": 2029.17, "end": 2031.17, "text": "请主公发落"}, {"start": 2031.17, "end": 2035.09, "text": "伤风败俗"}, {"start": 2035.09, "end": 2037.09, "text": "玷污我家风"}, {"start": 2037.09, "end": 2038.09, "text": "这等禽兽"}, {"start": 2038.09, "end": 2040.09, "text": "留它何用"}, {"start": 2040.09, "end": 2041.09, "text": "所加了"}, {"start": 2041.09, "end": 2044.09, "text": "天明除子"}, {"start": 2044.09, "end": 2045.09, "text": "带走"}, {"start": 2045.09, "end": 2046.09, "text": "老爷饶命啊"}, {"start": 2046.09, "end": 2047.09, "text": "走走走"}, {"start": 2047.09, "end": 2050.91, "text": "老爷饶命啊"}, {"start": 2050.91, "end": 2051.91, "text": "老爷饶命啊"}, {"start": 2051.91, "end": 2052.91, "text": "将的头皮发作了"}, {"start": 2052.91, "end": 2084.73, "text": "成性的头皮犯了"}, {"start": 2084.73, "end": 2086.73, "text": "快 快去请太医姬平"}, {"start": 2086.73, "end": 2087.73, "text": "快"}, {"start": 2087.73, "end": 2088.73, "text": "你 你去请姬平"}, {"start": 2088.73, "end": 2089.73, "text": "快 快去"}, {"start": 2089.73, "end": 2090.73, "text": "快"}, {"start": 2090.73, "end": 2091.73, "text": "快 去"}, {"start": 2091.73, "end": 2092.73, "text": "快跑"}, {"start": 2092.73, "end": 2098.53, "text": "跑 快去"}, {"start": 2098.53, "end": 2100.53, "text": "姬平"}, {"start": 2100.53, "end": 2103.53, "text": "药熬好了吗"}, {"start": 2103.53, "end": 2133.62, "text": "就好 就好"}, {"start": 2133.62, "end": 2134.62, "text": "丞相"}, {"start": 2134.62, "end": 2136.62, "text": "汤药好了"}, {"start": 2136.62, "end": 2137.62, "text": "你请用药"}, {"start": 2137.62, "end": 2150.06, "text": "太烫了"}, {"start": 2150.06, "end": 2165.72, "text": "搁那儿凉会儿"}, {"start": 2165.72, "end": 2166.72, "text": "姬平你"}, {"start": 2166.72, "end": 2169.72, "text": "做太医多久了"}, {"start": 2169.72, "end": 2171.72, "text": "臣是出平二年"}, {"start": 2171.72, "end": 2172.72, "text": "进宫从医的"}, {"start": 2172.72, "end": 2173.72, "text": "算起来"}, {"start": 2173.72, "end": 2176.72, "text": "有十三个年头了"}, {"start": 2176.72, "end": 2180.29, "text": "出平二年"}, {"start": 2180.29, "end": 2182.29, "text": "那年我也干了一件"}, {"start": 2182.29, "end": 2185.29, "text": "惊天动地的事"}, {"start": 2185.29, "end": 2191.77, "text": "你知道什么事吗"}, {"start": 2191.77, "end": 2194.77, "text": "那年的三月八日"}, {"start": 2194.77, "end": 2196.77, "text": "那天"}, {"start": 2196.77, "end": 2198.77, "text": "董卓也像我一样"}, {"start": 2198.77, "end": 2200.77, "text": "躺在榻上"}, {"start": 2200.77, "end": 2202.77, "text": "我呢"}, {"start": 2202.77, "end": 2204.77, "text": "怀揣七星刀"}, {"start": 2204.77, "end": 2207.77, "text": "慢慢地向它逼近"}, {"start": 2207.77, "end": 2210.77, "text": "想要为国出凶"}, {"start": 2210.77, "end": 2212.77, "text": "青史留名"}, {"start": 2212.77, "end": 2214.77, "text": "没想到董卓"}, {"start": 2214.77, "end": 2217.77, "text": "从镜子里发现了"}, {"start": 2217.77, "end": 2220.77, "text": "害得我险些丧命"}, {"start": 2220.77, "end": 2225.02, "text": "我更没有想到的是"}, {"start": 2225.02, "end": 2227.02, "text": "今日"}, {"start": 2227.02, "end": 2230.02, "text": "我也被人看成董卓了"}, {"start": 2230.02, "end": 2238.66, "text": "汤药凉了"}, {"start": 2238.66, "end": 2240.66, "text": "药率会大减"}, {"start": 2240.66, "end": 2242.66, "text": "请丞相用药"}, {"start": 2242.66, "end": 2247.13, "text": "上古有礼"}, {"start": 2247.13, "end": 2252.02, "text": "君患疾饮药"}, {"start": 2252.02, "end": 2254.02, "text": "臣先尝之"}, {"start": 2254.02, "end": 2257.02, "text": "父患疾饮药"}, {"start": 2257.02, "end": 2260.02, "text": "子先尝之"}, {"start": 2260.02, "end": 2264.02, "text": "你待我如君如父"}, {"start": 2264.02, "end": 2267.02, "text": "就请你先尝尝此药吧"}, {"start": 2267.02, "end": 2268.02, "text": "这"}, {"start": 2268.02, "end": 2271.02, "text": "丞相"}, {"start": 2271.02, "end": 2274.42, "text": "拿下"}, {"start": 2274.42, "end": 2284.1, "text": "说"}, {"start": 2284.1, "end": 2286.1, "text": "谁令你下毒的"}, {"start": 2286.1, "end": 2288.1, "text": "谁是你的同党"}, {"start": 2288.1, "end": 2290.1, "text": "是我要杀贼"}, {"start": 2290.1, "end": 2292.1, "text": "何需别人指使"}, {"start": 2292.1, "end": 2294.1, "text": "你个小小的太医"}, {"start": 2294.1, "end": 2296.1, "text": "谁敢下毒害我"}, {"start": 2296.1, "end": 2298.1, "text": "说出你的同党我不杀你"}, {"start": 2298.1, "end": 2300.1, "text": "草贼"}, {"start": 2300.1, "end": 2303.1, "text": "天下人人得以助之"}, {"start": 2303.1, "end": 2305.1, "text": "岂止极平"}, {"start": 2305.1, "end": 2306.1, "text": "拖下去"}, {"start": 2306.1, "end": 2308.1, "text": "严刑拷问"}, {"start": 2308.1, "end": 2310.1, "text": "务必问出主使人是谁"}, {"start": 2310.1, "end": 2311.1, "text": "诺"}, {"start": 2311.1, "end": 2312.1, "text": "国贼"}, {"start": 2312.1, "end": 2313.1, "text": "国贼"}, {"start": 2313.1, "end": 2315.1, "text": "人人得以助之"}, {"start": 2315.1, "end": 2318.72, "text": "谁呀"}, {"start": 2318.72, "end": 2327.27, "text": "丞相有请"}, {"start": 2327.27, "end": 2328.27, "text": "扯地将军"}, {"start": 2328.27, "end": 2329.27, "text": "董成赴宴"}, {"start": 2329.27, "end": 2331.27, "text": "请回禀丞相"}, {"start": 2331.27, "end": 2334.27, "text": "我家主公臥病在床"}, {"start": 2334.27, "end": 2336.27, "text": "丞相事先就吩咐了"}, {"start": 2336.27, "end": 2337.27, "text": "说"}, {"start": 2337.27, "end": 2339.27, "text": "如果董成生病"}, {"start": 2339.27, "end": 2342.27, "text": "也一定请他报病前来"}, {"start": 2342.27, "end": 2343.27, "text": "这"}, {"start": 2343.27, "end": 2344.27, "text": "快去"}, {"start": 2344.27, "end": 2345.27, "text": "去啊"}, {"start": 2345.27, "end": 2348.65, "text": "请将军稍候"}, {"start": 2348.65, "end": 2349.65, "text": "我去禀报主公"}, {"start": 2349.65, "end": 2355.9, "text": "两个月前"}, {"start": 2355.9, "end": 2358.9, "text": "我还在此青梅竹酒"}, {"start": 2358.9, "end": 2361.9, "text": "以刘备笑论天下英雄"}, {"start": 2361.9, "end": 2364.9, "text": "如今情形不再"}, {"start": 2364.9, "end": 2368.28, "text": "秋风落叶"}, {"start": 2368.28, "end": 2370.28, "text": "树木凋零啊"}, {"start": 2370.28, "end": 2373.94, "text": "连那刘备"}, {"start": 2373.94, "end": 2374.94, "text": "也反了"}, {"start": 2374.94, "end": 2376.94, "text": "不过我看无妨"}, {"start": 2378.8, "end": 2380.8, "text": "秋风落叶"}, {"start": 2380.8, "end": 2384.78, "text": "也可一赏"}, {"start": 2384.78, "end": 2389.38, "text": "枯木寒窗"}, {"start": 2389.38, "end": 2391.38, "text": "也可助兴"}, {"start": 2391.38, "end": 2393.38, "text": "你们说是不是啊"}, {"start": 2393.38, "end": 2398.1, "text": "丞相所言甚是"}, {"start": 2398.1, "end": 2399.1, "text": "既如此"}, {"start": 2399.1, "end": 2401.1, "text": "蛮饮此杯"}, {"start": 2401.1, "end": 2404.41, "text": "下官报病"}, {"start": 2404.41, "end": 2406.41, "text": "不能再饮"}, {"start": 2406.41, "end": 2408.41, "text": "请丞相见谅"}, {"start": 2408.41, "end": 2410.41, "text": "病了"}, {"start": 2410.41, "end": 2414.1, "text": "正好我这有一副"}, {"start": 2414.1, "end": 2416.1, "text": "灵丹妙药"}, {"start": 2416.1, "end": 2417.1, "text": "来人哪"}, {"start": 2417.1, "end": 2418.1, "text": "在"}, {"start": 2418.1, "end": 2419.1, "text": "带上来"}, {"start": 2419.1, "end": 2420.1, "text": "诺"}]