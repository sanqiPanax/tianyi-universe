[{"start": 15.95, "end": 16.75, "text": "站住。"}, {"start": 23.3, "end": 24.7, "text": "丞相病了?"}, {"start": 24.9, "end": 25.7, "text": "是啊。"}, {"start": 26.3, "end": 28.5, "text": "丞相得知张八将军伤重而亡,"}, {"start": 28.7, "end": 29.9, "text": "悲痛欲绝。"}, {"start": 30.3, "end": 32.3, "text": "昨天去陈仓的路上又淋了雨,"}, {"start": 32.5, "end": 33.7, "text": "回来就病倒了。"}, {"start": 43.72, "end": 45.12, "text": "这可如何是好啊?"}, {"start": 45.32, "end": 48.8, "text": "曹军上任之后,"}, {"start": 49.0, "end": 50.0, "text": "攻势日盛,"}, {"start": 50.6, "end": 53.6, "text": "三军都等着丞相调兵遣将呢。"}, {"start": 59.92, "end": 60.92, "text": "丞相醒了,"}, {"start": 61.52, "end": 62.52, "text": "请立位觐见。"}, {"start": 62.72, "end": 105.13, "text": "国兵中惊天气,"}, {"start": 105.93, "end": 107.13, "text": "三军,"}, {"start": 107.93, "end": 111.33, "text": "就由你和王平来执掌。"}, {"start": 112.13, "end": 112.93, "text": "遵命。"}, {"start": 113.93, "end": 116.64, "text": "还有啊,"}, {"start": 116.84, "end": 120.04, "text": "让各部回营收拾形状,"}, {"start": 120.64, "end": 123.04, "text": "做好归师的准备。"}, {"start": 124.52, "end": 126.12, "text": "三日之后,"}, {"start": 126.32, "end": 127.92, "text": "黎明启程,"}, {"start": 128.32, "end": 130.72, "text": "陆续撤回汗中。"}, {"start": 131.52, "end": 132.52, "text": "敢问丞相,"}, {"start": 133.32, "end": 134.72, "text": "这次撤兵是诱敌,"}, {"start": 135.32, "end": 136.52, "text": "还是真撤?"}, {"start": 140.34, "end": 142.54, "text": "当然是真撤了,"}, {"start": 142.54, "end": 150.1, "text": "丞相的身体实在支撑不了。"}, {"start": 150.3, "end": 151.3, "text": "二者,"}, {"start": 151.5, "end": 153.1, "text": "雨季将至,"}, {"start": 154.1, "end": 156.3, "text": "那时道路泥濘,"}, {"start": 156.9, "end": 159.1, "text": "粮草难以转运,"}, {"start": 159.3, "end": 164.41, "text": "与其撑到那时无功而返,"}, {"start": 165.21, "end": 167.41, "text": "不如现在就撤。"}, {"start": 167.61, "end": 168.21, "text": "那,"}, {"start": 169.61, "end": 171.61, "text": "攻陷的城池如何处置?"}, {"start": 175.62, "end": 177.02, "text": "需要了,"}, {"start": 177.82, "end": 179.42, "text": "都放弃吧。"}, {"start": 179.62, "end": 181.22, "text": "陈仓也要放弃吗?"}, {"start": 182.22, "end": 184.02, "text": "大军撤后,"}, {"start": 184.22, "end": 185.82, "text": "无需两刀。"}, {"start": 186.02, "end": 187.22, "text": "可是丞相,"}, {"start": 188.02, "end": 189.42, "text": "陈仓城下我军"}, {"start": 189.42, "end": 191.22, "text": "阵亡了上万的将士人。"}, {"start": 192.02, "end": 195.02, "text": "我知道陈仓来之不易,"}, {"start": 195.62, "end": 197.82, "text": "可是大军都撤了,"}, {"start": 198.02, "end": 201.22, "text": "陈仓一座古城如何守得住啊?"}, {"start": 201.62, "end": 210.87, "text": "王平啊。"}, {"start": 212.27, "end": 213.07, "text": "末将在。"}, {"start": 213.47, "end": 215.07, "text": "大军撤后,"}, {"start": 215.47, "end": 219.27, "text": "你率两万人马在陈仓道口设斧,"}, {"start": 220.07, "end": 222.07, "text": "三日之后再撤,"}, {"start": 222.27, "end": 224.47, "text": "尽防曹真来袭。"}, {"start": 225.07, "end": 225.67, "text": "遵命。"}, {"start": 226.67, "end": 227.27, "text": "丞相。"}, {"start": 228.67, "end": 230.07, "text": "退了吧。"}, {"start": 255.62, "end": 256.22, "text": "副帅,"}, {"start": 256.82, "end": 257.62, "text": "昨天半夜起,"}, {"start": 258.02, "end": 259.82, "text": "南边各城议纷纷腾起烈焰,"}, {"start": 260.42, "end": 261.02, "text": "天亮后,"}, {"start": 261.22, "end": 262.82, "text": "儿亲自领军前去打探,"}, {"start": 263.22, "end": 265.02, "text": "发现蜀军正苍黄而退,"}, {"start": 265.42, "end": 267.42, "text": "连旗山大道返回汉中。"}, {"start": 268.22, "end": 269.42, "text": "主国两位何退军?"}, {"start": 269.82, "end": 270.82, "text": "孩儿出事也不急,"}, {"start": 271.42, "end": 273.62, "text": "因此我率清纪追杀十余里,"}, {"start": 274.22, "end": 275.62, "text": "拿下了几个洛丹的蜀兵。"}, {"start": 276.62, "end": 277.42, "text": "拷问后得知,"}, {"start": 279.42, "end": 281.62, "text": "原来朱可亮病危了。"}, {"start": 283.22, "end": 283.82, "text": "病危了?"}, {"start": 286.86, "end": 287.66, "text": "病危了?"}, {"start": 292.02, "end": 292.82, "text": "中达,"}, {"start": 295.18, "end": 298.18, "text": "你说朱可亮是真病还是假病?"}, {"start": 300.22, "end": 303.42, "text": "这个蜀军他是真退呢?"}, {"start": 304.82, "end": 305.82, "text": "还是假退呢?"}, {"start": 308.02, "end": 308.62, "text": "副帅,"}, {"start": 309.42, "end": 310.02, "text": "儿认为,"}, {"start": 310.82, "end": 312.42, "text": "朱可亮真病假病并不要紧,"}, {"start": 313.22, "end": 314.22, "text": "关键在于,"}, {"start": 314.82, "end": 316.22, "text": "蜀军是真退兵,"}, {"start": 316.82, "end": 318.02, "text": "还是诱敌之计?"}, {"start": 322.18, "end": 326.18, "text": "少将军以为朱可亮是真退军还是诱敌呢?"}, {"start": 326.58, "end": 327.78, "text": "朱可亮用兵谨慎,"}, {"start": 328.38, "end": 328.98, "text": "他若真退,"}, {"start": 329.78, "end": 331.58, "text": "必然会在陈仓道口受下伏兵,"}, {"start": 332.18, "end": 333.18, "text": "等大军回到蜀境,"}, {"start": 333.78, "end": 334.78, "text": "伏兵才会撤去。"}, {"start": 335.38, "end": 336.38, "text": "我军不需追杀,"}, {"start": 336.98, "end": 338.18, "text": "只需前往陈仓道口,"}, {"start": 338.78, "end": 340.38, "text": "点烟一下蜀军留下的火灶,"}, {"start": 340.78, "end": 341.58, "text": "便知七乡。"}, {"start": 342.78, "end": 343.78, "text": "如何知七乡?"}, {"start": 345.18, "end": 345.98, "text": "军中造犯,"}, {"start": 346.38, "end": 347.38, "text": "差这十人一造,"}, {"start": 348.38, "end": 350.18, "text": "如果蜀军留下的火灶过千,"}, {"start": 350.58, "end": 352.18, "text": "则证明有万军在此埋伏,"}, {"start": 352.78, "end": 353.78, "text": "如果没有火灶,"}, {"start": 354.18, "end": 355.18, "text": "或是火灶不多,"}, {"start": 356.18, "end": 357.78, "text": "则证明蜀军没有剩下埋伏,"}, {"start": 358.78, "end": 360.98, "text": "我军则可放心地收复陈仓了。"}, {"start": 362.18, "end": 363.78, "text": "少将军深通兵略,"}, {"start": 364.78, "end": 366.58, "text": "所说极缺机敏,"}, {"start": 367.38, "end": 368.98, "text": "老夫敬佩不已。"}, {"start": 371.3, "end": 372.3, "text": "各位将军,"}, {"start": 373.3, "end": 376.1, "text": "本都上任时曾夸下海口,"}, {"start": 376.1, "end": 378.7, "text": "说半月之内必能退敌,"}, {"start": 380.3, "end": 381.7, "text": "本都失言了,"}, {"start": 382.1, "end": 384.91, "text": "本都失言了,"}, {"start": 386.11, "end": 389.11, "text": "本都上任已经十八日了,"}, {"start": 389.71, "end": 392.88, "text": "晚了整整三日,"}, {"start": 393.88, "end": 395.28, "text": "整整三日。"}, {"start": 395.88, "end": 397.48, "text": "大都督兵为所至,"}, {"start": 397.68, "end": 399.48, "text": "诸葛亮落荒而逃啊。"}, {"start": 400.68, "end": 402.88, "text": "大都督用心如神啊。"}, {"start": 403.08, "end": 403.68, "text": "听令,"}, {"start": 404.08, "end": 407.52, "text": "曹爽率前军,"}, {"start": 407.92, "end": 408.92, "text": "郭怀殿后,"}, {"start": 409.12, "end": 410.12, "text": "郭怀殿后,"}, {"start": 410.92, "end": 412.52, "text": "本都自提中军,"}, {"start": 412.92, "end": 413.92, "text": "疑似禁兵,"}, {"start": 414.12, "end": 415.52, "text": "收复龙溪各城邑。"}, {"start": 415.72, "end": 416.52, "text": "遵命,遵命。"}, {"start": 420.03, "end": 420.43, "text": "父亲,"}, {"start": 421.63, "end": 423.83, "text": "这是禁书托御良官带来的,"}, {"start": 424.43, "end": 425.23, "text": "他少话说,"}, {"start": 425.23, "end": 426.03, "text": "秋雨将至,"}, {"start": 426.03, "end": 426.83, "text": "拥粮苦寒,"}, {"start": 427.63, "end": 428.63, "text": "让天剑绵衣,"}, {"start": 429.23, "end": 430.63, "text": "千万别染上风湿了。"}, {"start": 431.63, "end": 432.03, "text": "您看,"}, {"start": 432.23, "end": 448.52, "text": "可贴心人哪,"}, {"start": 448.92, "end": 450.32, "text": "好生温暖,"}, {"start": 450.52, "end": 454.18, "text": "好生温暖,"}, {"start": 457.9, "end": 459.3, "text": "曹爽归营了吗?"}, {"start": 460.3, "end": 460.9, "text": "还没有。"}, {"start": 461.3, "end": 462.1, "text": "你要记住,"}, {"start": 462.7, "end": 463.9, "text": "曹爽之才"}, {"start": 464.1, "end": 465.7, "text": "远在其父之上,"}, {"start": 466.5, "end": 468.5, "text": "日后你要好生再有。"}, {"start": 478.16, "end": 478.56, "text": "父亲,"}, {"start": 480.16, "end": 481.36, "text": "曹爽斩获不懈化,"}, {"start": 481.76, "end": 482.76, "text": "他们的马虎下面"}, {"start": 482.76, "end": 483.96, "text": "全挂在水军头目。"}, {"start": 484.36, "end": 492.8, "text": "如此看量真的退军了?"}, {"start": 520.5, "end": 521.1, "text": "李将军,"}, {"start": 521.5, "end": 527.87, "text": "昂明啊,"}, {"start": 529.47, "end": 530.27, "text": "吃亏了吧?"}, {"start": 530.67, "end": 531.27, "text": "别提了,"}, {"start": 532.47, "end": 533.47, "text": "我在陈仓道"}, {"start": 533.47, "end": 534.87, "text": "埋伏了足足有五天,"}, {"start": 535.47, "end": 536.87, "text": "可是一个备兵都没有来,"}, {"start": 537.67, "end": 539.27, "text": "正当我准备撤退的时候,"}, {"start": 539.67, "end": 541.47, "text": "卫军从东边冲杀而至,"}, {"start": 541.67, "end": 543.27, "text": "我就赶紧挥石迎战,"}, {"start": 544.67, "end": 545.47, "text": "可没想到,"}, {"start": 546.27, "end": 548.47, "text": "从西边又杀出几万卫军,"}, {"start": 548.67, "end": 550.67, "text": "这一下子我被两面夹击,"}, {"start": 551.47, "end": 552.47, "text": "腹背受敌。"}, {"start": 556.41, "end": 557.01, "text": "这卫军,"}, {"start": 558.21, "end": 560.01, "text": "卫军领军的将领是郭怀吗?"}, {"start": 561.01, "end": 561.41, "text": "不是,"}, {"start": 562.01, "end": 563.21, "text": "是曹真的儿子,"}, {"start": 563.41, "end": 564.01, "text": "曹爽。"}, {"start": 564.41, "end": 565.01, "text": "曹爽?"}, {"start": 565.61, "end": 566.81, "text": "他不是个顽固子弟吗?"}, {"start": 567.41, "end": 568.61, "text": "也能领兵打仗?"}, {"start": 570.41, "end": 571.81, "text": "这曹爽可叼着呢,"}, {"start": 572.61, "end": 574.81, "text": "要不是我的弓弩手拼命放箭,"}, {"start": 575.21, "end": 577.61, "text": "恐怕他就断了我的退路了。"}, {"start": 578.81, "end": 580.21, "text": "这曹爽还真够精明的,"}, {"start": 580.61, "end": 582.61, "text": "居然能绕过丞相的伏兵,"}, {"start": 582.81, "end": 583.61, "text": "再回头杀来。"}, {"start": 584.01, "end": 584.61, "text": "是啊,"}, {"start": 588.24, "end": 589.24, "text": "丞相病好了?"}, {"start": 591.64, "end": 593.24, "text": "不是丞相的病好了,"}, {"start": 594.84, "end": 596.04, "text": "我早就看出来了,"}, {"start": 597.44, "end": 599.24, "text": "丞相根本就没病。"}, {"start": 613.21, "end": 614.21, "text": "拜见丞相。"}, {"start": 617.78, "end": 618.78, "text": "拜见丞相。"}, {"start": 622.88, "end": 623.88, "text": "过来说话吧。"}, {"start": 628.96, "end": 629.96, "text": "启禀丞相,"}, {"start": 631.36, "end": 634.16, "text": "末将折损了五千军士。"}, {"start": 634.56, "end": 638.04, "text": "卫军到何处了?"}, {"start": 638.44, "end": 640.84, "text": "他们的前军已经进入陈仓城,"}, {"start": 641.64, "end": 642.04, "text": "五都,"}, {"start": 642.44, "end": 644.04, "text": "殷平和下官等城,"}, {"start": 644.44, "end": 646.44, "text": "也都相继落入他们之手。"}, {"start": 651.02, "end": 651.42, "text": "丞相,"}, {"start": 653.53, "end": 655.13, "text": "其他城市并不可惜,"}, {"start": 656.33, "end": 657.73, "text": "唯独陈仓市不得,"}, {"start": 658.93, "end": 660.93, "text": "他扼住了我军的良道。"}, {"start": 662.33, "end": 663.13, "text": "再说,"}, {"start": 663.93, "end": 666.13, "text": "丞相也并非是真的想退兵,"}, {"start": 667.13, "end": 670.33, "text": "如果连陈仓这种地方都拿来诱敌深入的话,"}, {"start": 671.13, "end": 672.93, "text": "那代价实在是太大了。"}, {"start": 673.93, "end": 674.53, "text": "卫爷,"}, {"start": 676.76, "end": 678.76, "text": "你不就是舍不得陈仓吗?"}, {"start": 680.56, "end": 681.16, "text": "也罢,"}, {"start": 681.76, "end": 683.16, "text": "就算我向你借的,"}, {"start": 684.16, "end": 685.16, "text": "过不了多久,"}, {"start": 686.16, "end": 687.96, "text": "本相还给你便是了。"}, {"start": 693.74, "end": 694.74, "text": "末将于师,"}, {"start": 695.54, "end": 696.94, "text": "望丞相恕罪。"}, {"start": 698.74, "end": 699.34, "text": "坐吧,"}, {"start": 704.66, "end": 705.86, "text": "我之所以下令,"}, {"start": 706.26, "end": 709.26, "text": "将所有粮草改囤于祁山大营,"}, {"start": 709.66, "end": 711.46, "text": "就是因为那里地势高。"}, {"start": 712.26, "end": 713.46, "text": "但我没想的是,"}, {"start": 714.46, "end": 717.46, "text": "今年的雨季比往年迟了七八日,"}, {"start": 718.46, "end": 719.46, "text": "现在看来,"}, {"start": 719.86, "end": 721.86, "text": "雨来得晚,必来得大。"}, {"start": 722.66, "end": 724.26, "text": "陈仓地势低蛙,"}, {"start": 724.66, "end": 725.46, "text": "大雨之后,"}, {"start": 725.66, "end": 727.06, "text": "必会积水数池,"}, {"start": 727.66, "end": 729.86, "text": "为军粮草资重陷入水中,"}, {"start": 730.26, "end": 732.86, "text": "他们战斗力最强的西粮萧季,"}, {"start": 733.06, "end": 738.2, "text": "更会大大出言啊,"}, {"start": 742.7, "end": 745.3, "text": "战机要看天意,"}, {"start": 746.1, "end": 747.5, "text": "天意所致,"}, {"start": 748.1, "end": 749.9, "text": "你想不胜都难。"}, {"start": 762.1, "end": 762.9, "text": "明大都督,"}, {"start": 763.3, "end": 764.3, "text": "要塞陈仓,"}, {"start": 764.7, "end": 766.1, "text": "重回到我军手中。"}, {"start": 766.3, "end": 766.9, "text": "好,"}, {"start": 768.3, "end": 768.9, "text": "郭怀,"}, {"start": 769.7, "end": 770.1, "text": "在。"}, {"start": 771.5, "end": 773.9, "text": "你即刻替本都督写一道奏表,"}, {"start": 774.1, "end": 775.3, "text": "上奏朝廷,"}, {"start": 775.7, "end": 778.3, "text": "我军分拥杀敌,日行百里,"}, {"start": 778.7, "end": 781.3, "text": "一举摧毁诸葛亮三十万大军。"}, {"start": 782.7, "end": 784.5, "text": "胜利夺去了陈仓,"}, {"start": 785.1, "end": 786.3, "text": "当十多城池。"}, {"start": 786.7, "end": 787.7, "text": "在下这就去写。"}, {"start": 788.1, "end": 789.3, "text": "别急啊,郭怀,"}, {"start": 789.7, "end": 790.3, "text": "还有啊,"}, {"start": 793.3, "end": 794.5, "text": "少将军曹爽,"}, {"start": 794.7, "end": 795.7, "text": "亲率铁骑,"}, {"start": 796.3, "end": 797.9, "text": "斩杀蜀军三万有余,"}, {"start": 798.3, "end": 800.3, "text": "并率先杀入陈仓城中,"}, {"start": 800.7, "end": 802.5, "text": "请朝廷加功行赏。"}, {"start": 807.3, "end": 807.9, "text": "中达,"}, {"start": 808.7, "end": 810.1, "text": "我看这道奏章,"}, {"start": 811.1, "end": 812.9, "text": "还是由你来拟写吧。"}, {"start": 813.7, "end": 814.3, "text": "拟写,"}, {"start": 814.7, "end": 815.7, "text": "更有说服力。"}, {"start": 816.3, "end": 817.3, "text": "尊大督督命,"}, {"start": 817.7, "end": 818.9, "text": "在下写就是了。"}, {"start": 820.3, "end": 821.3, "text": "那就多谢了。"}, {"start": 821.9, "end": 833.42, "text": "陈仓真是个屯兵的好地方啊,"}, {"start": 833.82, "end": 838.07, "text": "郝昭在这儿做了半年将军,"}, {"start": 840.43, "end": 841.83, "text": "把这城墙住得,"}, {"start": 842.23, "end": 844.03, "text": "比洛阳城墙还厚。"}, {"start": 844.43, "end": 848.77, "text": "他真是个智勇双全之才啊,"}, {"start": 848.97, "end": 851.73, "text": "这太早了。"}, {"start": 865.16, "end": 865.76, "text": "父亲,"}, {"start": 866.76, "end": 868.36, "text": "你真要替曹真写表章,"}, {"start": 868.76, "end": 870.36, "text": "向朝廷邀功请赏吗?"}, {"start": 871.56, "end": 872.36, "text": "为何呢?"}, {"start": 873.16, "end": 874.16, "text": "我已经答应了。"}, {"start": 876.46, "end": 877.66, "text": "你知道表章一上去,"}, {"start": 878.06, "end": 879.26, "text": "是自取其辱,"}, {"start": 879.66, "end": 880.86, "text": "百官必然大化。"}, {"start": 883.46, "end": 884.06, "text": "为何?"}, {"start": 884.66, "end": 885.46, "text": "父亲兵败,"}, {"start": 885.66, "end": 886.86, "text": "被曹真取而代之,"}, {"start": 887.26, "end": 888.26, "text": "而曹真一上任,"}, {"start": 888.26, "end": 889.46, "text": "立刻转败为圣。"}, {"start": 890.06, "end": 890.86, "text": "这样一来,"}, {"start": 891.26, "end": 892.06, "text": "陛下会怎么想,"}, {"start": 892.66, "end": 893.86, "text": "百官又怎么想?"}, {"start": 895.06, "end": 896.86, "text": "他们一定会想,"}, {"start": 898.06, "end": 899.06, "text": "你,"}, {"start": 901.18, "end": 902.18, "text": "你这个人,"}, {"start": 903.18, "end": 908.02, "text": "不像是英雇郎氏之徒啊,"}, {"start": 908.02, "end": 909.02, "text": "怀若骨,"}, {"start": 909.62, "end": 911.42, "text": "多么宽宏大量,"}, {"start": 912.62, "end": 915.42, "text": "他和曹真已经尽是前嫌,"}, {"start": 916.22, "end": 918.02, "text": "现正同心同德,"}, {"start": 918.42, "end": 920.02, "text": "为国复难哪。"}, {"start": 920.62, "end": 921.22, "text": "父亲,"}, {"start": 922.22, "end": 923.22, "text": "儿不是说笑,"}, {"start": 923.22, "end": 924.42, "text": "儿是说真的。"}, {"start": 924.62, "end": 932.72, "text": "家一定会这样想,"}, {"start": 933.72, "end": 934.52, "text": "特别是,"}, {"start": 935.12, "end": 936.72, "text": "等我的表章到后,"}, {"start": 937.52, "end": 940.32, "text": "紧跟着曹真的败报就到,"}, {"start": 941.12, "end": 942.92, "text": "陛下更会惊讶,"}, {"start": 945.11, "end": 946.91, "text": "这刚刚司马仪,"}, {"start": 947.51, "end": 949.51, "text": "还在为他邀功请赏,"}, {"start": 949.71, "end": 952.67, "text": "怎么又败了?"}, {"start": 952.67, "end": 956.42, "text": "您是赖你,"}, {"start": 956.62, "end": 958.62, "text": "父亲是说曹真会兵败,"}, {"start": 960.02, "end": 961.82, "text": "儿没看出曹真的败相啊,"}, {"start": 966.17, "end": 966.57, "text": "父亲,"}, {"start": 969.62, "end": 971.02, "text": "还是那句老话,"}, {"start": 971.22, "end": 974.09, "text": "你服所欲,"}, {"start": 975.09, "end": 976.89, "text": "服息或所服。"}, {"start": 977.89, "end": 978.49, "text": "父亲,"}, {"start": 978.69, "end": 979.09, "text": "你,"}, {"start": 979.09, "end": 980.69, "text": "你就别跟儿卖关子了,"}, {"start": 980.69, "end": 981.69, "text": "你快教我吧。"}, {"start": 983.29, "end": 983.89, "text": "不教,"}, {"start": 984.09, "end": 985.09, "text": "自个儿琢磨吧,"}, {"start": 986.29, "end": 988.49, "text": "本都人马陆续而来,"}, {"start": 989.09, "end": 990.89, "text": "兵马越来越多,"}, {"start": 991.29, "end": 994.09, "text": "陈仓成小恐怕驻扎不下,"}, {"start": 994.49, "end": 995.69, "text": "本都义,"}, {"start": 995.89, "end": 998.29, "text": "应将几十万人马撒开来,"}, {"start": 998.29, "end": 999.69, "text": "分到各城驻守。"}, {"start": 1000.89, "end": 1001.89, "text": "仲达,"}, {"start": 1002.69, "end": 1004.09, "text": "你看如何啊?"}, {"start": 1004.69, "end": 1007.29, "text": "大都督安排甚为妥当。"}, {"start": 1007.69, "end": 1008.49, "text": "那好,"}, {"start": 1008.69, "end": 1014.66, "text": "陈仓乃燕侯要地,"}, {"start": 1015.26, "end": 1017.06, "text": "本都督亲自驻守。"}, {"start": 1017.26, "end": 1017.86, "text": "仲达,"}, {"start": 1018.26, "end": 1020.26, "text": "你引一军驻守阴平。"}, {"start": 1020.66, "end": 1021.26, "text": "遵命。"}, {"start": 1022.26, "end": 1023.06, "text": "郭怀。"}, {"start": 1023.66, "end": 1024.26, "text": "在。"}, {"start": 1024.66, "end": 1026.46, "text": "你率本部驻守五都。"}, {"start": 1027.26, "end": 1027.86, "text": "遵命。"}, {"start": 1028.66, "end": 1029.26, "text": "孙离。"}, {"start": 1029.46, "end": 1030.06, "text": "在。"}, {"start": 1030.46, "end": 1033.66, "text": "你率两军驻守东边黑石城。"}, {"start": 1034.66, "end": 1035.26, "text": "遵命。"}, {"start": 1036.46, "end": 1037.26, "text": "仲达,"}, {"start": 1038.06, "end": 1039.66, "text": "表章可曾写好啊?"}, {"start": 1039.86, "end": 1041.46, "text": "请大都督过目。"}, {"start": 1048.06, "end": 1048.86, "text": "仲达,"}, {"start": 1064.64, "end": 1066.24, "text": "多谢多谢。"}, {"start": 1066.44, "end": 1067.84, "text": "多谢多谢。"}, {"start": 1084.82, "end": 1085.42, "text": "父亲,"}, {"start": 1087.22, "end": 1088.82, "text": "父亲让儿打探军情,"}, {"start": 1089.42, "end": 1090.62, "text": "儿都打探清楚了。"}, {"start": 1094.54, "end": 1095.54, "text": "龙溪各城,"}, {"start": 1095.94, "end": 1097.34, "text": "凡是被蜀军放弃的,"}, {"start": 1097.54, "end": 1098.74, "text": "都已经大火焚毁了。"}, {"start": 1099.74, "end": 1101.14, "text": "只剩下了残园断壁。"}, {"start": 1102.54, "end": 1103.74, "text": "大军退去,"}, {"start": 1103.74, "end": 1105.34, "text": "自然片瓦无存,"}, {"start": 1105.54, "end": 1108.02, "text": "我早料到了。"}, {"start": 1113.5, "end": 1115.1, "text": "只是这诸葛亮,"}, {"start": 1115.7, "end": 1117.3, "text": "为什么单单"}, {"start": 1117.5, "end": 1120.9, "text": "留下了陈仓这座最大的城池呢?"}, {"start": 1121.9, "end": 1123.3, "text": "陈仓是燕侯要道,"}, {"start": 1123.5, "end": 1124.9, "text": "兵犯庸良的必经之地。"}, {"start": 1126.1, "end": 1127.3, "text": "诸葛亮之所以留下它,"}, {"start": 1127.7, "end": 1129.5, "text": "是为了以后再去陈仓。"}, {"start": 1130.7, "end": 1131.5, "text": "就这些?"}, {"start": 1132.5, "end": 1133.1, "text": "就这些,"}, {"start": 1137.12, "end": 1138.12, "text": "莫非还有别的?"}, {"start": 1138.92, "end": 1140.12, "text": "你再想想,"}, {"start": 1140.52, "end": 1147.95, "text": "儿想不起来。"}, {"start": 1148.15, "end": 1154.29, "text": "这么简单的事情,"}, {"start": 1154.69, "end": 1156.69, "text": "到今日你还看不出个玄机,"}, {"start": 1156.89, "end": 1158.09, "text": "真是迂腐一颗,"}, {"start": 1158.89, "end": 1159.69, "text": "无可救药。"}, {"start": 1160.09, "end": 1170.79, "text": "曹真多疑,"}, {"start": 1170.99, "end": 1174.98, "text": "数曹爽多疑。"}, {"start": 1177.52, "end": 1177.92, "text": "父亲,"}, {"start": 1178.12, "end": 1178.92, "text": "喝杯热茶吧。"}, {"start": 1185.43, "end": 1186.03, "text": "我喝。"}, {"start": 1192.74, "end": 1193.14, "text": "父亲,"}, {"start": 1193.54, "end": 1195.54, "text": "其实儿早就参透玄机了。"}, {"start": 1197.14, "end": 1197.74, "text": "当真?"}, {"start": 1198.94, "end": 1199.94, "text": "千真万确。"}, {"start": 1200.14, "end": 1206.93, "text": "说我听听。"}, {"start": 1207.13, "end": 1210.79, "text": "诸葛亮之所以留下陈仓,"}, {"start": 1210.99, "end": 1212.39, "text": "就是为了给曹真助军。"}, {"start": 1212.79, "end": 1213.99, "text": "陈仓地势地化,"}, {"start": 1214.19, "end": 1215.39, "text": "大雨数日以后,"}, {"start": 1215.59, "end": 1216.79, "text": "必会积水应池。"}, {"start": 1217.99, "end": 1218.79, "text": "到那时,"}, {"start": 1218.99, "end": 1220.59, "text": "我军的战甲就会泡滥,"}, {"start": 1220.79, "end": 1221.79, "text": "粮草会生煤,"}, {"start": 1221.99, "end": 1223.19, "text": "资重也会损坏。"}, {"start": 1224.39, "end": 1225.39, "text": "等到天一放晴,"}, {"start": 1225.59, "end": 1226.99, "text": "蜀军再来攻时,"}, {"start": 1227.19, "end": 1228.39, "text": "我军必大败。"}, {"start": 1228.99, "end": 1230.19, "text": "而诸葛亮最有可能"}, {"start": 1230.19, "end": 1231.79, "text": "弃其他各城于不顾,"}, {"start": 1232.19, "end": 1233.39, "text": "集中优势兵力,"}, {"start": 1233.59, "end": 1234.79, "text": "专攻陈仓,"}, {"start": 1235.59, "end": 1236.59, "text": "专心操阵。"}, {"start": 1255.46, "end": 1256.26, "text": "大多多,"}, {"start": 1256.66, "end": 1258.06, "text": "陛下又为你增加了"}, {"start": 1258.06, "end": 1259.26, "text": "五千弹凤龙,"}, {"start": 1259.86, "end": 1262.26, "text": "随赠两田三千亩,"}, {"start": 1262.66, "end": 1264.46, "text": "电农一千户。"}, {"start": 1265.66, "end": 1266.86, "text": "恩宠之重,"}, {"start": 1267.06, "end": 1268.86, "text": "我朝自开源以来,"}, {"start": 1269.06, "end": 1270.26, "text": "还没有一个大臣"}, {"start": 1270.46, "end": 1271.86, "text": "敢与你相比。"}, {"start": 1272.26, "end": 1274.86, "text": "陛下真是龙颜大悦呀。"}, {"start": 1276.86, "end": 1278.06, "text": "陛下这人哪,"}, {"start": 1278.66, "end": 1280.06, "text": "虽是年轻,"}, {"start": 1280.66, "end": 1282.86, "text": "倒也上法森林啊。"}, {"start": 1283.66, "end": 1285.86, "text": "陛下也夸了司马仪几句,"}, {"start": 1287.86, "end": 1290.66, "text": "说他与大多多你啊,"}, {"start": 1291.06, "end": 1292.66, "text": "同心同德,"}, {"start": 1293.06, "end": 1296.46, "text": "对大多多也是心悦诚服。"}, {"start": 1304.06, "end": 1306.06, "text": "心悦诚服不敢说啊,"}, {"start": 1306.66, "end": 1307.46, "text": "不过,"}, {"start": 1307.86, "end": 1310.66, "text": "此人近日倒是乖巧了许多。"}, {"start": 1311.86, "end": 1312.66, "text": "来人哪。"}, {"start": 1316.3, "end": 1316.9, "text": "大多多。"}, {"start": 1317.5, "end": 1319.7, "text": "把陛下恩旨抄写百份,"}, {"start": 1320.1, "end": 1321.3, "text": "发到各营去,"}, {"start": 1321.7, "end": 1323.1, "text": "让将士们都看看,"}, {"start": 1323.3, "end": 1324.9, "text": "黄恩浩荡啊。"}, {"start": 1324.9, "end": 1325.5, "text": "诺。"}, {"start": 1338.17, "end": 1338.77, "text": "扶水。"}, {"start": 1338.97, "end": 1342.74, "text": "你这是去哪儿了,"}, {"start": 1342.74, "end": 1343.74, "text": "一身都是水。"}, {"start": 1347.44, "end": 1348.24, "text": "大多多,"}, {"start": 1348.44, "end": 1349.64, "text": "下官告退。"}, {"start": 1351.04, "end": 1352.24, "text": "好生伺候着。"}, {"start": 1352.44, "end": 1353.04, "text": "诺。"}, {"start": 1354.44, "end": 1356.04, "text": "孩儿刚去潜移巡视一番,"}, {"start": 1356.84, "end": 1358.04, "text": "你瞧瞧这件铠甲。"}, {"start": 1360.11, "end": 1361.11, "text": "铠甲怎么了?"}, {"start": 1362.11, "end": 1362.91, "text": "别日大雨,"}, {"start": 1363.11, "end": 1364.11, "text": "城里到处卖水,"}, {"start": 1364.11, "end": 1364.91, "text": "排不出去,"}, {"start": 1365.31, "end": 1366.51, "text": "营帐里也都进了水,"}, {"start": 1367.11, "end": 1368.31, "text": "把铠甲都窝烂了。"}, {"start": 1373.65, "end": 1374.25, "text": "父亲,"}, {"start": 1374.85, "end": 1375.65, "text": "看情形,"}, {"start": 1376.05, "end": 1377.45, "text": "这阴雨还会持续,"}, {"start": 1377.85, "end": 1378.65, "text": "再过半月,"}, {"start": 1379.05, "end": 1380.65, "text": "所有的铠甲都会烂成碎片,"}, {"start": 1381.05, "end": 1382.25, "text": "刀毛也会生锈,"}, {"start": 1382.45, "end": 1383.45, "text": "如果蜀军来袭,"}, {"start": 1383.85, "end": 1385.05, "text": "那可就危险了。"}, {"start": 1387.27, "end": 1389.07, "text": "依你我该怎么办啊?"}, {"start": 1389.87, "end": 1392.07, "text": "儿以为应该立刻放弃神仓,"}, {"start": 1392.27, "end": 1393.47, "text": "率全军退回雍梁,"}, {"start": 1400.12, "end": 1403.12, "text": "神仓乃蜀军北藩之咽喉药地,"}, {"start": 1403.52, "end": 1404.32, "text": "如若放弃,"}, {"start": 1404.32, "end": 1405.52, "text": "再夺回就不易了。"}, {"start": 1406.12, "end": 1407.52, "text": "你马上发书朝廷,"}, {"start": 1407.92, "end": 1408.92, "text": "请陛下下旨,"}, {"start": 1409.92, "end": 1410.72, "text": "从洛阳,"}, {"start": 1410.72, "end": 1411.12, "text": "长安,"}, {"start": 1411.12, "end": 1412.12, "text": "许昌等地,"}, {"start": 1412.32, "end": 1413.52, "text": "转运兵器铠甲来,"}, {"start": 1414.12, "end": 1415.12, "text": "天一放晴,"}, {"start": 1415.12, "end": 1416.32, "text": "一切都好罢了。"}, {"start": 1416.72, "end": 1417.52, "text": "但孩儿担心,"}, {"start": 1417.52, "end": 1418.72, "text": "等不及铠甲兵器运到,"}, {"start": 1419.12, "end": 1420.72, "text": "蜀军就会回师公杀过来。"}, {"start": 1422.12, "end": 1422.72, "text": "还有,"}, {"start": 1423.12, "end": 1424.32, "text": "屯梁也开始没变了。"}, {"start": 1425.52, "end": 1427.12, "text": "军师们吃着发霉的饭食,"}, {"start": 1427.32, "end": 1428.32, "text": "月升四起,"}, {"start": 1429.32, "end": 1429.92, "text": "现在,"}, {"start": 1430.52, "end": 1431.52, "text": "我越来越怀疑,"}, {"start": 1432.12, "end": 1433.72, "text": "诸葛梁是故意留下尘仓,"}, {"start": 1434.32, "end": 1435.32, "text": "好借上天之力,"}, {"start": 1435.32, "end": 1436.12, "text": "削弱了,"}, {"start": 1436.72, "end": 1437.32, "text": "然后,"}, {"start": 1437.52, "end": 1443.96, "text": "你要是这么说,"}, {"start": 1443.96, "end": 1448.5, "text": "我还真有些担心哪,"}, {"start": 1451.74, "end": 1453.94, "text": "不过陛下刚刚办下恩旨,"}, {"start": 1454.74, "end": 1456.14, "text": "重重赏赐于我,"}, {"start": 1456.94, "end": 1458.94, "text": "我怎么能就放掉尘仓呢?"}, {"start": 1463.61, "end": 1464.61, "text": "再等几日吧,"}, {"start": 1465.21, "end": 1466.01, "text": "你传令下去,"}, {"start": 1466.41, "end": 1467.81, "text": "叫各军好升守备,"}, {"start": 1468.41, "end": 1469.41, "text": "城内外要战,"}, {"start": 1469.81, "end": 1471.21, "text": "都要天兵驻防,"}, {"start": 1471.61, "end": 1472.01, "text": "去吧。"}, {"start": 1472.81, "end": 1473.21, "text": "诺。"}, {"start": 1473.61, "end": 1483.34, "text": "拜见丞相。"}, {"start": 1490.28, "end": 1491.88, "text": "各部都准备好了吗?"}, {"start": 1493.28, "end": 1493.88, "text": "禀丞相,"}, {"start": 1495.48, "end": 1496.88, "text": "全部都准备妥当。"}, {"start": 1499.98, "end": 1500.98, "text": "众位将军,"}, {"start": 1503.02, "end": 1503.62, "text": "前番,"}, {"start": 1504.42, "end": 1507.02, "text": "我军与魏军在祁山相识,"}, {"start": 1508.02, "end": 1510.82, "text": "我算准今年秋雨会多于往年,"}, {"start": 1511.62, "end": 1513.22, "text": "所以撑并退兵,"}, {"start": 1513.62, "end": 1515.62, "text": "率全军撤回了汗中,"}, {"start": 1516.62, "end": 1517.22, "text": "此外,"}, {"start": 1517.82, "end": 1519.62, "text": "还把龙溪各处的诚意,"}, {"start": 1520.62, "end": 1521.82, "text": "包括陈仓,"}, {"start": 1522.02, "end": 1523.22, "text": "留给了魏军,"}, {"start": 1524.42, "end": 1527.62, "text": "让他们在雨水中淋泡了近两个月。"}, {"start": 1528.62, "end": 1529.22, "text": "据报,"}, {"start": 1530.22, "end": 1532.62, "text": "特别是陈仓城内曹真所布,"}, {"start": 1533.22, "end": 1535.02, "text": "战甲凹成了碎片,"}, {"start": 1535.02, "end": 1536.62, "text": "粮草都已生霉,"}, {"start": 1537.22, "end": 1539.22, "text": "将士不满军心动腹,"}, {"start": 1541.48, "end": 1544.68, "text": "曹真已成为瓮中之鳖,"}, {"start": 1545.28, "end": 1546.68, "text": "无路可逃了。"}, {"start": 1547.88, "end": 1548.28, "text": "丞相,"}, {"start": 1549.08, "end": 1550.08, "text": "快下战令吧,"}, {"start": 1551.08, "end": 1552.68, "text": "兄弟们早都等不及了。"}, {"start": 1554.55, "end": 1556.35, "text": "魏炎王平听令。"}, {"start": 1557.95, "end": 1568.1, "text": "我们都陷进泥里了,"}, {"start": 1568.1, "end": 1569.5, "text": "是不是等雨停了再进军?"}, {"start": 1569.5, "end": 1570.1, "text": "诸位,"}, {"start": 1570.3, "end": 1575.18, "text": "必须赶到陈仓城下,等待雨停。"}, {"start": 1575.58, "end": 1577.58, "text": "传令下去,加快进军速度,"}, {"start": 1577.98, "end": 1579.18, "text": "凡有为抗争。"}, {"start": 1579.58, "end": 1579.98, "text": "战!"}, {"start": 1580.38, "end": 1580.78, "text": "诺!"}, {"start": 1581.38, "end": 1582.38, "text": "全速前进!"}, {"start": 1582.98, "end": 1603.31, "text": "副帅好生安乐。"}, {"start": 1605.42, "end": 1607.02, "text": "我的爽儿回来了,"}, {"start": 1607.82, "end": 1609.22, "text": "天气是寒,"}, {"start": 1609.62, "end": 1610.22, "text": "爽儿,"}, {"start": 1610.62, "end": 1612.22, "text": "快来饮杯热酒,"}, {"start": 1612.62, "end": 1614.62, "text": "快给我爽儿倒杯热酒。"}, {"start": 1614.82, "end": 1616.22, "text": "蜀军正在冒雨进兵。"}, {"start": 1617.62, "end": 1618.42, "text": "什么?"}, {"start": 1619.22, "end": 1620.02, "text": "上级探报,"}, {"start": 1620.42, "end": 1622.62, "text": "城西十里处已发现大巫蜀军,"}, {"start": 1630.46, "end": 1631.26, "text": "渊渊不断,"}, {"start": 1631.46, "end": 1632.26, "text": "望不到尽头。"}, {"start": 1633.06, "end": 1633.86, "text": "从信号上看,"}, {"start": 1634.06, "end": 1635.86, "text": "是属上将军魏炎王平。"}, {"start": 1636.86, "end": 1637.66, "text": "这两个人到了,"}, {"start": 1638.66, "end": 1639.66, "text": "足以证明朱克亮。"}, {"start": 1640.06, "end": 1646.75, "text": "对对对,"}, {"start": 1647.15, "end": 1647.75, "text": "快快退下,"}, {"start": 1647.95, "end": 1648.75, "text": "快快传令,"}, {"start": 1649.15, "end": 1651.15, "text": "所有将士上升决堤,"}, {"start": 1651.55, "end": 1652.75, "text": "朱克亮来了!"}, {"start": 1653.15, "end": 1653.55, "text": "遵命!"}, {"start": 1654.75, "end": 1671.87, "text": "朱克亮把蜀军逐一给,"}, {"start": 1671.87, "end": 1677.6, "text": "快派人出城,"}, {"start": 1677.8, "end": 1678.6, "text": "令各营守驾,"}, {"start": 1678.8, "end": 1680.0, "text": "派军快来救陈仓。"}, {"start": 1680.6, "end": 1681.8, "text": "儿已经派人前去了,"}, {"start": 1682.2, "end": 1688.34, "text": "军就要攻城。"}, {"start": 1688.34, "end": 1701.45, "text": "完了,"}, {"start": 1701.45, "end": 1701.85, "text": "副帅,"}, {"start": 1703.05, "end": 1704.65, "text": "这已经完全被鱼人消失掉了,"}, {"start": 1705.05, "end": 1705.65, "text": "这样的箭,"}, {"start": 1705.85, "end": 1706.85, "text": "射不死蜀军的。"}, {"start": 1709.65, "end": 1729.3, "text": "军队来了没有?"}, {"start": 1745.66, "end": 1746.06, "text": "大都督,"}, {"start": 1746.06, "end": 1746.46, "text": "不好了,"}, {"start": 1746.86, "end": 1747.46, "text": "破城了,"}, {"start": 1747.66, "end": 1749.06, "text": "蜀军朝官属杀过来了。"}, {"start": 1749.26, "end": 1749.66, "text": "爹爹,"}, {"start": 1749.86, "end": 1750.26, "text": "爹爹,"}, {"start": 1750.66, "end": 1751.26, "text": "快让让,"}, {"start": 1751.26, "end": 1751.66, "text": "爹爹,"}, {"start": 1751.86, "end": 1752.26, "text": "爹爹,"}, {"start": 1752.46, "end": 1752.86, "text": "爹爹,"}, {"start": 1753.06, "end": 1753.46, "text": "爹爹,"}, {"start": 1753.86, "end": 1758.74, "text": "蜀帅,"}, {"start": 1759.14, "end": 1759.74, "text": "快出来!"}, {"start": 1760.94, "end": 1761.74, "text": "蜀军已经破城,"}, {"start": 1761.94, "end": 1762.94, "text": "东关西关都湿了,"}, {"start": 1763.14, "end": 1763.94, "text": "只有南门可出。"}, {"start": 1764.34, "end": 1765.94, "text": "这些服饰是我军哨胎用的。"}, {"start": 1766.34, "end": 1766.54, "text": "父亲,"}, {"start": 1766.54, "end": 1767.34, "text": "你赶紧换上一件,"}, {"start": 1767.74, "end": 1768.94, "text": "而保你趁乱杀出城郡,"}, {"start": 1769.14, "end": 1769.54, "text": "快!"}, {"start": 1769.94, "end": 1771.14, "text": "杀了王了。"}, {"start": 1771.14, "end": 1771.74, "text": "大都督,"}, {"start": 1772.14, "end": 1782.26, "text": "千万不要回头,"}, {"start": 1782.46, "end": 1783.46, "text": "当心被敌军认出来,"}, {"start": 1783.46, "end": 1784.06, "text": "快快造马。"}, {"start": 1784.86, "end": 1785.26, "text": "驾!"}, {"start": 1785.46, "end": 1817.62, "text": "不许急走,"}, {"start": 1818.02, "end": 1850.94, "text": "不行。"}, {"start": 1851.74, "end": 1852.74, "text": "蓝生在这,"}, {"start": 1852.94, "end": 1910.55, "text": "以为是贼兵啊,"}, {"start": 1910.95, "end": 1912.35, "text": "原来是大都督啊,"}, {"start": 1916.86, "end": 1918.46, "text": "我早就赶来救驾了。"}, {"start": 1919.26, "end": 1943.95, "text": "父亲!"}, {"start": 1947.56, "end": 1948.36, "text": "父亲!"}, {"start": 1948.96, "end": 1949.56, "text": "父亲!"}, {"start": 1949.76, "end": 1950.76, "text": "死马医,"}, {"start": 1951.16, "end": 1951.76, "text": "你!"}, {"start": 1952.16, "end": 1952.76, "text": "父亲!"}, {"start": 1956.22, "end": 1957.22, "text": "父亲!"}, {"start": 1957.62, "end": 1958.42, "text": "父亲!"}, {"start": 1962.1, "end": 1962.7, "text": "父亲!"}, {"start": 1963.5, "end": 1967.43, "text": "大都督,"}, {"start": 1967.83, "end": 1981.4, "text": "让将士们安心修整,"}, {"start": 1981.6, "end": 1982.8, "text": "就说我说的,"}, {"start": 1985.4, "end": 1987.2, "text": "杜葛亮断然不敢冒犯,"}, {"start": 1988.2, "end": 1989.6, "text": "把酒肉都拿出来,"}, {"start": 1990.2, "end": 1992.0, "text": "让将士们饱餐一顿。"}, {"start": 1993.2, "end": 1993.8, "text": "遵命。"}, {"start": 1994.2, "end": 1995.2, "text": "末将在。"}, {"start": 2003.28, "end": 2005.48, "text": "我曾替你写过一道表彰,"}, {"start": 2006.28, "end": 2008.48, "text": "现在你也得写一道表彰,"}, {"start": 2008.68, "end": 2010.68, "text": "替我写一道表彰吧。"}, {"start": 2011.48, "end": 2012.68, "text": "请大都督事下,"}, {"start": 2013.08, "end": 2015.08, "text": "这道表彰应该如何写?"}, {"start": 2026.74, "end": 2027.94, "text": "你上奏朝廷,"}, {"start": 2028.54, "end": 2031.34, "text": "大都督曹真不听司马医劝阻,"}, {"start": 2031.74, "end": 2032.94, "text": "贸然犯禁,"}, {"start": 2033.34, "end": 2034.74, "text": "致使我军兵败,"}, {"start": 2035.14, "end": 2036.54, "text": "丢弃陈仓等城。"}, {"start": 2038.06, "end": 2039.26, "text": "大都督曹真,"}, {"start": 2040.06, "end": 2041.86, "text": "抛弃陛下所赐的"}, {"start": 2042.66, "end": 2043.86, "text": "朝廷服饰,"}, {"start": 2044.86, "end": 2046.06, "text": "改穿蜀军,"}, {"start": 2046.46, "end": 2047.66, "text": "小卒战服,"}, {"start": 2048.06, "end": 2050.26, "text": "弃三军而独自逃命,"}, {"start": 2050.66, "end": 2052.86, "text": "信得司马医拼死相救,"}, {"start": 2053.26, "end": 2054.46, "text": "侥幸生还。"}, {"start": 2055.86, "end": 2057.46, "text": "眼下三军无主,"}, {"start": 2058.06, "end": 2059.26, "text": "军心动乱。"}, {"start": 2059.66, "end": 2070.64, "text": "大都督所言,"}, {"start": 2071.04, "end": 2072.24, "text": "句句都属实情,"}, {"start": 2074.42, "end": 2075.22, "text": "这道表彰,"}, {"start": 2075.62, "end": 2077.02, "text": "我要请所有的将军,"}, {"start": 2077.62, "end": 2078.62, "text": "联名场所。"}, {"start": 2082.45, "end": 2083.65, "text": "听旨,"}, {"start": 2088.15, "end": 2089.55, "text": "奉天承运,"}, {"start": 2089.95, "end": 2091.35, "text": "皇帝诏曰,"}, {"start": 2091.95, "end": 2092.75, "text": "司马医,"}, {"start": 2092.95, "end": 2094.35, "text": "忠勇报国,"}, {"start": 2094.75, "end": 2095.95, "text": "功盖天地。"}, {"start": 2096.95, "end": 2099.35, "text": "朕因三军将士所请,"}, {"start": 2099.55, "end": 2100.75, "text": "加授其为"}, {"start": 2100.95, "end": 2102.55, "text": "朝廷大司马,"}, {"start": 2102.75, "end": 2104.35, "text": "车记大将军,"}, {"start": 2104.75, "end": 2107.35, "text": "兼领平西大都督,"}, {"start": 2107.75, "end": 2109.35, "text": "统领三军。"}, {"start": 2109.95, "end": 2111.35, "text": "朕并赐"}, {"start": 2111.75, "end": 2112.75, "text": "天子间,"}, {"start": 2112.95, "end": 2114.15, "text": "锦袍玉带,"}, {"start": 2114.35, "end": 2116.15, "text": "以壮君威。"}, {"start": 2120.43, "end": 2122.23, "text": "臣领旨谢恩。"}, {"start": 2122.83, "end": 2123.63, "text": "曹真,"}, {"start": 2124.43, "end": 2125.83, "text": "丧失辱国,"}, {"start": 2126.43, "end": 2128.43, "text": "凡事罪无可赦,"}, {"start": 2129.03, "end": 2130.03, "text": "但念其"}, {"start": 2130.23, "end": 2131.63, "text": "伤众而死,"}, {"start": 2132.03, "end": 2133.83, "text": "朕不再加罪,"}, {"start": 2134.23, "end": 2135.83, "text": "捉其子曹爽,"}, {"start": 2136.23, "end": 2137.63, "text": "顾曹真灵旧,"}, {"start": 2137.83, "end": 2139.23, "text": "返回长安,"}, {"start": 2139.63, "end": 2141.23, "text": "归葬祖坟。"}, {"start": 2141.63, "end": 2143.23, "text": "钦此。"}, {"start": 2183.38, "end": 2184.18, "text": "仲大,"}, {"start": 2184.78, "end": 2185.78, "text": "别来无恙啊,"}, {"start": 2185.98, "end": 2191.95, "text": "我相助,"}, {"start": 2193.15, "end": 2195.75, "text": "属下能重登大都督之位吗?"}, {"start": 2196.15, "end": 2217.94, "text": "南洋已更复,"}, {"start": 2218.34, "end": 2221.14, "text": "尚不知天数下不明大事,"}, {"start": 2222.54, "end": 2224.34, "text": "本该偏安一遇,"}, {"start": 2225.34, "end": 2226.74, "text": "报敬安民。"}, {"start": 2227.34, "end": 2229.54, "text": "为何屡屡逆天行事,"}, {"start": 2229.74, "end": 2230.74, "text": "强行用兵?"}, {"start": 2230.94, "end": 2236.48, "text": "阿斗愚蠢,"}, {"start": 2238.08, "end": 2239.88, "text": "莫非如比他更愚蠢?"}, {"start": 2240.28, "end": 2253.87, "text": "我受先帝托孤之咒,"}, {"start": 2255.07, "end": 2259.07, "text": "岂能不清心竭力讨伐逆贼?"}, {"start": 2259.47, "end": 2265.76, "text": "如父祖皆为汉臣,"}, {"start": 2265.96, "end": 2267.56, "text": "久食汉度,"}, {"start": 2268.16, "end": 2269.16, "text": "不思报孝,"}, {"start": 2269.36, "end": 2270.76, "text": "反诛篡矣,"}, {"start": 2271.16, "end": 2272.76, "text": "必遭天劫。"}, {"start": 2276.94, "end": 2279.34, "text": "我只消与善与悔,"}, {"start": 2279.94, "end": 2282.94, "text": "尔等定当灰飞焉灭。"}, {"start": 2286.54, "end": 2288.74, "text": "屁股好大口气啊,"}, {"start": 2292.24, "end": 2292.84, "text": "听我意,"}, {"start": 2292.84, "end": 2298.14, "text": "你我如今都是五十岁的人了,"}, {"start": 2298.94, "end": 2300.14, "text": "天命不永,"}, {"start": 2300.14, "end": 2301.34, "text": "余日无多。"}, {"start": 2302.94, "end": 2305.34, "text": "你我与其争斗至死,"}, {"start": 2305.94, "end": 2308.14, "text": "不如各自引兵班师,"}, {"start": 2308.94, "end": 2310.34, "text": "安享天年。"}, {"start": 2313.17, "end": 2315.77, "text": "原来你知道非我之敌啊,"}, {"start": 2316.37, "end": 2317.57, "text": "既然这样,"}, {"start": 2318.57, "end": 2320.37, "text": "你且归降于我,"}, {"start": 2320.77, "end": 2322.97, "text": "我赏你一辆四轮车,"}, {"start": 2322.97, "end": 2325.77, "text": "你我同归成都见主上了。"}, {"start": 2326.57, "end": 2328.57, "text": "匹夫只会摇唇鼓舌,"}, {"start": 2328.57, "end": 2329.77, "text": "骚手弄技,"}, {"start": 2330.77, "end": 2332.37, "text": "舌死别无他能,"}, {"start": 2333.37, "end": 2334.37, "text": "匹夫听着,"}, {"start": 2335.77, "end": 2338.57, "text": "我魏国疆土强于数三倍,"}, {"start": 2339.57, "end": 2341.17, "text": "你逆天罚魏,"}, {"start": 2342.17, "end": 2343.77, "text": "匹夫汉树儿,"}, {"start": 2344.57, "end": 2345.97, "text": "永远不能成功。"}, {"start": 2345.97, "end": 2352.86, "text": "属下非要一战了?"}, {"start": 2352.86, "end": 2358.22, "text": "斗将、斗阵法,"}, {"start": 2358.22, "end": 2360.93, "text": "我都不拘你。"}, {"start": 2361.13, "end": 2366.56, "text": "你且不阵吧,"}, {"start": 2367.36, "end": 2369.56, "text": "在你阵法完备之前,"}, {"start": 2369.96, "end": 2371.76, "text": "我绝不趁虚进攻。"}, {"start": 2371.76, "end": 2408.65, "text": "属下认得此任?"}, {"start": 2408.65, "end": 2412.77, "text": "别说是我,"}, {"start": 2413.77, "end": 2417.37, "text": "就是我麾下一篇将也可布置,"}, {"start": 2418.37, "end": 2421.97, "text": "此乃魂源一气阵也。"}, {"start": 2421.97, "end": 2427.31, "text": "你也不阵我看,"}, {"start": 2427.31, "end": 2431.61, "text": "在你阵法形成前,"}, {"start": 2431.61, "end": 2433.81, "text": "我也绝不趁虚进攻。"}]