[{"start": 3.98, "end": 23.36, "text": "此乃奇门八卦阵也。"}, {"start": 23.36, "end": 25.36, "text": "我九岁便识它了。"}, {"start": 25.36, "end": 27.36, "text": "既然识得,"}, {"start": 27.36, "end": 29.36, "text": "那你可破得了此阵呢?"}, {"start": 29.36, "end": 31.36, "text": "能识就能破吗?"}, {"start": 33.36, "end": 35.36, "text": "好,"}, {"start": 35.36, "end": 37.36, "text": "你只需率精前来攻阵。"}, {"start": 37.36, "end": 39.36, "text": "若破了此阵,"}, {"start": 39.36, "end": 41.36, "text": "我就退回汉中,"}, {"start": 41.36, "end": 43.36, "text": "永不复出。"}, {"start": 43.36, "end": 60.59, "text": "当真?"}, {"start": 60.59, "end": 62.59, "text": "苍天在上,"}, {"start": 62.59, "end": 64.59, "text": "三君在侧,"}, {"start": 64.59, "end": 68.86, "text": "君子已把难追。"}, {"start": 68.86, "end": 93.39, "text": "带领张虎、岳平三将,"}, {"start": 93.39, "end": 95.39, "text": "听令!"}, {"start": 95.39, "end": 101.39, "text": "在!"}, {"start": 101.39, "end": 103.39, "text": "诸葛亮所摆阵,"}, {"start": 103.39, "end": 105.39, "text": "名叫八卦阵,"}, {"start": 105.39, "end": 107.39, "text": "设井祠、杜商等八个兵门。"}, {"start": 107.39, "end": 109.39, "text": "你们别看此阵"}, {"start": 109.39, "end": 111.39, "text": "威风凛凛,"}, {"start": 111.39, "end": 114.86, "text": "其实华尔无始,"}, {"start": 114.86, "end": 119.14, "text": "毫无足迹。"}, {"start": 119.14, "end": 121.14, "text": "你们先从正东的"}, {"start": 121.14, "end": 123.14, "text": "升门杀入,"}, {"start": 123.14, "end": 125.14, "text": "继而转向西南方向的"}, {"start": 125.14, "end": 127.14, "text": "再从那里出来,"}, {"start": 127.14, "end": 129.14, "text": "之后迅速地"}, {"start": 129.14, "end": 131.14, "text": "杀回到北门,"}, {"start": 131.14, "end": 133.14, "text": "从开门杀入。"}, {"start": 133.14, "end": 135.14, "text": "如此,此阵即破了。"}, {"start": 135.14, "end": 179.6, "text": "八卦阵变成了"}, {"start": 179.6, "end": 181.6, "text": "两一太极阵,"}, {"start": 181.6, "end": 221.07, "text": "同两一的。"}, {"start": 221.07, "end": 223.07, "text": "诸葛亮把所有阵门全关闭了,"}, {"start": 223.07, "end": 311.02, "text": "带领他们根本冲不出来啊。"}, {"start": 311.02, "end": 313.02, "text": "大丞相有礼,赠送"}, {"start": 313.02, "end": 315.02, "text": "司马、仲达、墨珠三头,"}, {"start": 315.02, "end": 336.0, "text": "一共靠军。"}, {"start": 336.0, "end": 341.71, "text": "走!"}, {"start": 341.71, "end": 343.71, "text": "从升门杀入,修门杀出,"}, {"start": 343.71, "end": 345.71, "text": "不料一旦入阵,"}, {"start": 345.71, "end": 347.71, "text": "什么门都没有了。"}, {"start": 347.71, "end": 349.71, "text": "诸葛亮令我代话,"}, {"start": 349.71, "end": 351.71, "text": "让大都督回家去说,"}, {"start": 351.71, "end": 353.71, "text": "说在"}, {"start": 353.71, "end": 355.71, "text": "再读兵法,重新战策,"}, {"start": 355.71, "end": 357.71, "text": "三年以后"}, {"start": 357.71, "end": 359.71, "text": "再来决一辞熊。"}, {"start": 359.71, "end": 361.71, "text": "下去。"}, {"start": 361.71, "end": 375.3, "text": "诺。全军冲杀蜀军战营,"}, {"start": 375.3, "end": 377.3, "text": "直奔诸葛亮四轮车。"}, {"start": 377.3, "end": 379.3, "text": "父亲且慢,"}, {"start": 379.3, "end": 381.3, "text": "诸葛亮分明是想激怒父亲,"}, {"start": 381.3, "end": 387.1, "text": "用我军冲杀啊。"}, {"start": 387.1, "end": 389.1, "text": "即使如此,我也不惧他。"}, {"start": 389.1, "end": 391.1, "text": "郭怀传令。"}, {"start": 391.1, "end": 393.1, "text": "在。"}, {"start": 393.1, "end": 395.1, "text": "跟着我的大刀,冲杀蜀军战营,"}, {"start": 395.1, "end": 397.1, "text": "还捉诸葛亮。"}, {"start": 397.1, "end": 412.19, "text": "追! 冲啊!"}, {"start": 412.19, "end": 414.19, "text": "卫军战败了,司马宜的大刀"}, {"start": 414.19, "end": 417.89, "text": "已经往东南方向逃散。"}, {"start": 417.89, "end": 419.89, "text": "丞相,给我两万战机,"}, {"start": 419.89, "end": 421.89, "text": "我追杀司马宜,你带着大军"}, {"start": 421.89, "end": 423.89, "text": "乘胜追击。"}, {"start": 423.89, "end": 425.89, "text": "罢了。"}, {"start": 425.89, "end": 427.89, "text": "为何?"}, {"start": 427.89, "end": 429.89, "text": "他已经走远。"}, {"start": 429.89, "end": 431.89, "text": "二者,我军粮草已尽,"}, {"start": 431.89, "end": 433.89, "text": "不宜长途追杀。"}, {"start": 433.89, "end": 435.89, "text": "什么?"}, {"start": 435.89, "end": 437.89, "text": "粮草已尽?"}, {"start": 437.89, "end": 439.89, "text": "怎么,从没有听丞相"}, {"start": 439.89, "end": 441.89, "text": "你说起过?"}, {"start": 441.89, "end": 443.89, "text": "我是怕军心动乱,"}, {"start": 443.89, "end": 445.89, "text": "所以隐瞒不说。"}, {"start": 445.89, "end": 447.89, "text": "十日前,"}, {"start": 447.89, "end": 449.89, "text": "史无中的粮草就该到了。"}, {"start": 449.89, "end": 451.89, "text": "不料发生何事,"}, {"start": 451.89, "end": 453.89, "text": "至今"}, {"start": 453.89, "end": 455.89, "text": "迟迟不来啊。"}, {"start": 455.89, "end": 489.5, "text": "还会是情景。"}, {"start": 489.5, "end": 494.35, "text": "还好,"}, {"start": 494.35, "end": 496.35, "text": "史无中没有率军追杀。"}, {"start": 496.35, "end": 498.35, "text": "诸葛亮用兵最好设伏,"}, {"start": 498.35, "end": 500.35, "text": "因此他也怕"}, {"start": 500.35, "end": 502.35, "text": "我埋下伏兵。"}, {"start": 502.35, "end": 505.82, "text": "传令,"}, {"start": 505.82, "end": 507.82, "text": "三军后退五十里,"}, {"start": 507.82, "end": 509.82, "text": "进入城池要战。"}, {"start": 509.82, "end": 511.82, "text": "我军令,任何人"}, {"start": 511.82, "end": 513.82, "text": "不准出战。"}, {"start": 513.82, "end": 539.76, "text": "遵命。"}, {"start": 539.76, "end": 541.76, "text": "上将将违!"}, {"start": 541.76, "end": 543.76, "text": "我问你,为什么"}, {"start": 543.76, "end": 545.76, "text": "我迟迟不来?"}, {"start": 545.76, "end": 547.76, "text": "为什么一误我军战机?"}, {"start": 547.76, "end": 549.76, "text": "关你何事?"}, {"start": 549.76, "end": 551.76, "text": "带我见丞相说话。"}, {"start": 551.76, "end": 553.76, "text": "见丞相?"}, {"start": 553.76, "end": 555.76, "text": "你有脸见丞相。"}, {"start": 555.76, "end": 557.76, "text": "你见什么见丞相?"}, {"start": 557.76, "end": 564.53, "text": "你见什么丞相?"}, {"start": 564.53, "end": 566.53, "text": "你不拆!"}, {"start": 566.53, "end": 568.53, "text": "你负责运送"}, {"start": 568.53, "end": 570.53, "text": "二十万弹军粮,"}, {"start": 570.53, "end": 572.53, "text": "应该本月初八就到。"}, {"start": 572.53, "end": 574.53, "text": "为何违宪"}, {"start": 574.53, "end": 576.53, "text": "整整十五日?"}, {"start": 576.53, "end": 578.53, "text": "沿途道路曲折,"}, {"start": 578.53, "end": 580.53, "text": "多处塌方了。"}, {"start": 580.53, "end": 582.53, "text": "小官历尽"}, {"start": 582.53, "end": 584.53, "text": "千难万险,"}, {"start": 584.53, "end": 586.53, "text": "紧赶慢赶,"}, {"start": 586.53, "end": 589.84, "text": "好不容易才赶到的。"}, {"start": 589.84, "end": 591.84, "text": "一山两道,本相"}, {"start": 591.84, "end": 593.84, "text": "走过多少回。"}, {"start": 593.84, "end": 595.84, "text": "再慢也不会延迟"}, {"start": 595.84, "end": 597.84, "text": "十五日那么久!"}, {"start": 597.84, "end": 599.84, "text": "分明是你好久误事,"}, {"start": 599.84, "end": 601.84, "text": "就其都扑到我这儿来了!"}, {"start": 601.84, "end": 603.84, "text": "丞相,"}, {"start": 603.84, "end": 605.84, "text": "下官是礼颜内侄,"}, {"start": 605.84, "end": 607.84, "text": "请你看在李大人面子上,"}, {"start": 607.84, "end": 609.84, "text": "饶下官一回吧。"}, {"start": 609.84, "end": 614.37, "text": "安御,"}, {"start": 614.37, "end": 616.37, "text": "违宪三日就当"}, {"start": 616.37, "end": 618.37, "text": "除战,"}, {"start": 618.37, "end": 624.21, "text": "念在你初次运粮,"}, {"start": 624.21, "end": 626.21, "text": "我不杀你,"}, {"start": 626.21, "end": 628.21, "text": "从轻发落。"}, {"start": 628.21, "end": 630.21, "text": "谢丞相!"}, {"start": 630.21, "end": 632.21, "text": "拖下去,"}, {"start": 632.21, "end": 636.35, "text": "终章八十!"}, {"start": 636.35, "end": 638.35, "text": "诺!"}, {"start": 638.35, "end": 640.35, "text": "丞相!"}, {"start": 640.35, "end": 642.35, "text": "是不得丞相!"}, {"start": 642.35, "end": 644.35, "text": "丞相三思!三思啊!"}, {"start": 644.35, "end": 648.34, "text": "丞相!丞相!"}, {"start": 648.34, "end": 650.34, "text": "丞相,君粮是我军三军之重,"}, {"start": 650.34, "end": 652.34, "text": "高安误了良期不说,"}, {"start": 652.34, "end": 654.34, "text": "更断送了我军大好战机,"}, {"start": 654.34, "end": 656.34, "text": "怎么能轻饶了他?"}, {"start": 656.34, "end": 658.34, "text": "高安是礼颜的心腹,"}, {"start": 660.34, "end": 662.34, "text": "若杀了此人,"}, {"start": 662.34, "end": 664.34, "text": "礼颜定会猜忌我,"}, {"start": 664.34, "end": 668.06, "text": "更重要的是,"}, {"start": 668.06, "end": 671.6, "text": "以后"}, {"start": 671.6, "end": 673.6, "text": "就没人再敢运粮了。"}, {"start": 673.6, "end": 687.82, "text": "诸葛亮,"}, {"start": 687.82, "end": 689.82, "text": "我证你身中犯戒,"}, {"start": 689.82, "end": 691.82, "text": "我证你"}, {"start": 691.82, "end": 693.82, "text": "跌落悬崖。"}, {"start": 693.82, "end": 695.82, "text": "我证你"}, {"start": 695.82, "end": 697.82, "text": "斧刀加劲,"}, {"start": 697.82, "end": 701.14, "text": "我证你"}, {"start": 701.14, "end": 703.14, "text": "死无葬之地。"}, {"start": 703.14, "end": 705.14, "text": "驾,前进尾巴!"}, {"start": 705.14, "end": 725.76, "text": "末将率军外出太营,"}, {"start": 725.76, "end": 727.76, "text": "在蒙山小道抓获这个蜀利。"}, {"start": 727.76, "end": 734.05, "text": "你是谁,"}, {"start": 734.05, "end": 737.33, "text": "为何受过军仗?"}, {"start": 737.33, "end": 739.33, "text": "书军良官,"}, {"start": 739.33, "end": 741.29, "text": "当官 名叫苟安"}, {"start": 741.93, "end": 743.81, "text": "因为运粮误了旗线"}, {"start": 744.21, "end": 745.05, "text": "被祝国亮"}, {"start": 745.73, "end": 746.77, "text": "打烂了屁股"}, {"start": 747.49, "end": 748.41, "text": "误了多少日"}, {"start": 750.7, "end": 751.54, "text": "十五日"}, {"start": 753.82, "end": 755.06, "text": "怪不得祝国亮"}, {"start": 755.14, "end": 756.62, "text": "那天没有乘胜进军"}, {"start": 757.02, "end": 758.26, "text": "原来是军粮没了"}, {"start": 759.54, "end": 761.02, "text": "你误粮误得好啊"}, {"start": 763.78, "end": 765.42, "text": "本都再赏你八十军账"}, {"start": 765.78, "end": 766.7, "text": "饶命啊 大多多"}, {"start": 766.9, "end": 768.46, "text": "饶命"}, {"start": 770.66, "end": 771.22, "text": "听着"}, {"start": 772.3, "end": 773.62, "text": "你愿活还是愿死"}, {"start": 773.7, "end": 774.3, "text": "愿活"}, {"start": 774.34, "end": 774.9, "text": "小的"}, {"start": 775.5, "end": 776.26, "text": "愿活"}, {"start": 779.42, "end": 781.06, "text": "蜀汉有个大臣叫李延"}, {"start": 781.06, "end": 781.82, "text": "你认得他吗"}, {"start": 781.94, "end": 782.46, "text": "大多多"}, {"start": 782.9, "end": 783.9, "text": "那是我叔父"}, {"start": 815.52, "end": 816.36, "text": "你去长安"}, {"start": 817.44, "end": 819.12, "text": "做大魏朝廷的"}, {"start": 820.6, "end": 821.44, "text": "尚书如何"}, {"start": 821.68, "end": 822.76, "text": "请大多多下令"}, {"start": 823.64, "end": 824.12, "text": "小的"}, {"start": 824.72, "end": 825.36, "text": "愿你消命"}, {"start": 836.34, "end": 836.82, "text": "父亲"}, {"start": 838.26, "end": 839.46, "text": "苟安从旗山大营回来了"}, {"start": 839.46, "end": 840.14, "text": "请求入鉴"}, {"start": 841.06, "end": 841.82, "text": "让他进来吧"}, {"start": 841.82, "end": 842.18, "text": "诺"}, {"start": 853.66, "end": 854.46, "text": "这儿苟安"}, {"start": 854.98, "end": 856.02, "text": "拜见叔父"}, {"start": 857.26, "end": 858.86, "text": "你怎么变成这个样子了"}, {"start": 860.06, "end": 861.3, "text": "侄儿押运粮草"}, {"start": 861.9, "end": 862.46, "text": "不过就"}, {"start": 862.86, "end": 864.22, "text": "就吃了几日"}, {"start": 865.1, "end": 865.58, "text": "祝国亮"}, {"start": 866.54, "end": 868.26, "text": "打了侄儿足足八十军账"}, {"start": 869.78, "end": 871.7, "text": "差点把我腿打断"}, {"start": 873.5, "end": 875.38, "text": "谁让你一无其限呢"}, {"start": 878.06, "end": 878.98, "text": "回家养息去吧"}, {"start": 879.7, "end": 880.18, "text": "叔父"}, {"start": 881.02, "end": 882.02, "text": "侄儿归返途中"}, {"start": 882.34, "end": 883.82, "text": "捷得一封密信"}, {"start": 884.74, "end": 885.1, "text": "你"}, {"start": 885.42, "end": 905.03, "text": "是司马依"}, {"start": 905.47, "end": 906.47, "text": "写给魏帝"}, {"start": 906.99, "end": 908.23, "text": "曹芮的亲笔信"}, {"start": 908.23, "end": 908.63, "text": "父亲"}, {"start": 909.39, "end": 909.99, "text": "出什么事了"}, {"start": 910.79, "end": 911.75, "text": "你自己看看吧"}, {"start": 914.09, "end": 914.81, "text": "诸葛亮"}, {"start": 915.61, "end": 917.37, "text": "接受了司马依的重金"}, {"start": 917.89, "end": 919.61, "text": "两人相立密约"}, {"start": 920.73, "end": 922.01, "text": "相互撤军"}, {"start": 922.41, "end": 923.65, "text": "以未水为戒"}, {"start": 923.97, "end": 925.09, "text": "永不互犯"}, {"start": 928.27, "end": 929.43, "text": "这么重要的东西"}, {"start": 929.63, "end": 930.63, "text": "你是怎么得到的"}, {"start": 933.29, "end": 933.65, "text": "侄儿"}, {"start": 933.85, "end": 934.65, "text": "归国路上"}, {"start": 934.85, "end": 936.57, "text": "经过暖关酒店"}, {"start": 937.13, "end": 938.17, "text": "看见两个魏国官员"}, {"start": 938.17, "end": 938.93, "text": "正在饮酒"}, {"start": 939.53, "end": 940.61, "text": "侄儿变灵不暇"}, {"start": 940.61, "end": 941.29, "text": "杀了二人"}, {"start": 941.61, "end": 942.69, "text": "从一人身上"}, {"start": 942.69, "end": 943.69, "text": "搜到这封密信"}, {"start": 947.44, "end": 949.28, "text": "我会在圣上面前"}, {"start": 949.28, "end": 950.32, "text": "为你请功的"}, {"start": 952.4, "end": 953.32, "text": "密信的事"}, {"start": 953.76, "end": 955.72, "text": "你万万不可泄露啊"}, {"start": 955.72, "end": 956.36, "text": "侄儿明白"}, {"start": 957.64, "end": 958.68, "text": "你先回去吧"}, {"start": 958.68, "end": 958.92, "text": "诺"}, {"start": 963.66, "end": 965.5, "text": "丰儿 马上备马"}, {"start": 965.5, "end": 966.38, "text": "我去成都"}, {"start": 966.38, "end": 966.7, "text": "父亲"}, {"start": 967.7, "end": 968.46, "text": "这是不是"}, {"start": 968.46, "end": 970.5, "text": "司马依设的离间计呀"}, {"start": 970.5, "end": 971.58, "text": "你记不记得"}, {"start": 971.58, "end": 972.46, "text": "几年前"}, {"start": 972.46, "end": 973.18, "text": "丞相也用过"}, {"start": 973.18, "end": 974.18, "text": "类似的计谋"}, {"start": 974.18, "end": 974.86, "text": "致使司马依"}, {"start": 974.86, "end": 975.9, "text": "被朝廷所废"}, {"start": 976.46, "end": 979.18, "text": "宁可信其有"}, {"start": 979.78, "end": 981.3, "text": "不可信其无啊"}, {"start": 982.54, "end": 985.02, "text": "我是先帝脱孤的重臣"}, {"start": 985.82, "end": 986.98, "text": "社稷有威"}, {"start": 987.46, "end": 988.42, "text": "我不能不管他"}, {"start": 988.42, "end": 989.66, "text": "父亲 父亲"}, {"start": 990.66, "end": 992.18, "text": "你一旦蹭到了朱葛亮"}, {"start": 992.18, "end": 993.7, "text": "朝廷必然大乱"}, {"start": 993.7, "end": 995.06, "text": "蜀汉就完了"}, {"start": 997.25, "end": 999.21, "text": "丰儿 你急什么呢"}, {"start": 999.21, "end": 1002.47, "text": "朱葛亮"}, {"start": 1002.99, "end": 1004.95, "text": "要是真的被罢撤了"}, {"start": 1007.2, "end": 1009.04, "text": "不是还有我吗"}, {"start": 1010.36, "end": 1011.4, "text": "我就不相信"}, {"start": 1012.6, "end": 1014.0, "text": "我比朱葛亮差"}, {"start": 1014.64, "end": 1017.72, "text": "父亲 父亲 父亲"}, {"start": 1023.24, "end": 1023.76, "text": "这"}, {"start": 1031.47, "end": 1032.11, "text": "陛下"}, {"start": 1032.87, "end": 1034.63, "text": "司马依已经上奏"}, {"start": 1034.63, "end": 1035.59, "text": "魏帝曹芮"}, {"start": 1036.07, "end": 1037.23, "text": "说他与朱葛亮"}, {"start": 1037.23, "end": 1038.43, "text": "私定密约"}, {"start": 1038.43, "end": 1039.95, "text": "两人各自退军"}, {"start": 1039.95, "end": 1041.03, "text": "化疆而至"}, {"start": 1041.03, "end": 1042.03, "text": "永不相犯"}, {"start": 1043.27, "end": 1043.95, "text": "这时"}, {"start": 1044.75, "end": 1046.11, "text": "竟然把陛下你"}, {"start": 1046.79, "end": 1048.63, "text": "和蜀中的文武大臣"}, {"start": 1048.63, "end": 1050.15, "text": "全部蒙在鼓里"}, {"start": 1050.99, "end": 1052.03, "text": "朱葛亮"}, {"start": 1052.03, "end": 1053.75, "text": "他究竟想干什么"}, {"start": 1056.03, "end": 1057.11, "text": "爱卿多虑了"}, {"start": 1058.11, "end": 1060.03, "text": "丞相在北伐前"}, {"start": 1060.03, "end": 1061.99, "text": "朕就劝他不要动兵"}, {"start": 1061.99, "end": 1064.31, "text": "既然咱蜀灭不了魏"}, {"start": 1064.31, "end": 1065.83, "text": "魏国也灭不了蜀"}, {"start": 1065.83, "end": 1067.79, "text": "何不两国修好相安无事"}, {"start": 1068.79, "end": 1071.43, "text": "现在丞相与司马依"}, {"start": 1071.43, "end": 1072.39, "text": "言和修好"}, {"start": 1073.11, "end": 1074.75, "text": "让他主动退兵"}, {"start": 1074.75, "end": 1075.59, "text": "这不也正符合"}, {"start": 1075.59, "end": 1076.51, "text": "朕的本意吗"}, {"start": 1077.51, "end": 1079.07, "text": "陛下呀"}, {"start": 1079.07, "end": 1081.15, "text": "要害不在这里"}, {"start": 1081.15, "end": 1083.51, "text": "要害在于如此大事"}, {"start": 1083.51, "end": 1084.15, "text": "朱葛亮"}, {"start": 1084.19, "end": 1086.75, "text": "他为何不向陛下请旨"}, {"start": 1087.43, "end": 1088.87, "text": "为何要私下里"}, {"start": 1088.87, "end": 1091.03, "text": "与司马依签订密约"}, {"start": 1091.03, "end": 1092.23, "text": "其密约背后"}, {"start": 1092.23, "end": 1094.19, "text": "还有无其他交易"}, {"start": 1094.19, "end": 1095.75, "text": "恕臣直言"}, {"start": 1095.75, "end": 1097.91, "text": "恕汉究竟谁是国君"}, {"start": 1098.59, "end": 1100.15, "text": "是陛下你"}, {"start": 1100.15, "end": 1101.19, "text": "还是朱葛亮"}, {"start": 1109.26, "end": 1110.3, "text": "这么大的事"}, {"start": 1111.1, "end": 1112.58, "text": "丞相不应该背着朕"}, {"start": 1114.46, "end": 1115.14, "text": "陛下呀"}, {"start": 1115.78, "end": 1116.66, "text": "这么多年来"}, {"start": 1117.42, "end": 1119.86, "text": "朱葛亮借北伐之名"}, {"start": 1119.86, "end": 1121.02, "text": "一直掌控着"}, {"start": 1121.02, "end": 1122.58, "text": "蜀汉的全部精锐"}, {"start": 1124.5, "end": 1125.34, "text": "可怕了"}, {"start": 1127.1, "end": 1128.1, "text": "你是说"}, {"start": 1128.1, "end": 1129.54, "text": "丞相会行篡逆之事"}, {"start": 1129.54, "end": 1130.5, "text": "不管朱葛亮"}, {"start": 1130.5, "end": 1132.46, "text": "是否会行使篡逆"}, {"start": 1132.46, "end": 1134.7, "text": "关键是他行使篡逆的话"}, {"start": 1134.7, "end": 1136.22, "text": "陛下能否阻止他"}, {"start": 1136.22, "end": 1137.22, "text": "战胜他"}, {"start": 1137.22, "end": 1138.46, "text": "如果不能"}, {"start": 1138.46, "end": 1140.18, "text": "那么陛下这个君王"}, {"start": 1140.18, "end": 1142.02, "text": "就只有虚名了"}, {"start": 1142.02, "end": 1143.42, "text": "朱葛亮这个强臣"}, {"start": 1143.42, "end": 1145.3, "text": "却是实际上的国君呢"}, {"start": 1146.3, "end": 1147.02, "text": "陛下"}, {"start": 1147.86, "end": 1148.82, "text": "自古以来"}, {"start": 1149.38, "end": 1151.5, "text": "凡是君若臣强的"}, {"start": 1151.5, "end": 1153.42, "text": "齐君没有不死的"}, {"start": 1153.42, "end": 1155.42, "text": "齐国没有不亡的"}, {"start": 1155.42, "end": 1156.42, "text": "对对对"}, {"start": 1156.42, "end": 1157.18, "text": "陛下"}, {"start": 1158.22, "end": 1160.02, "text": "还记得汉先帝吗"}, {"start": 1160.7, "end": 1162.3, "text": "他是怎么死的"}, {"start": 1164.5, "end": 1165.58, "text": "不会的不会的"}, {"start": 1166.58, "end": 1168.86, "text": "先帝在白帝城脱孤的时候"}, {"start": 1168.86, "end": 1170.66, "text": "曾经跟朱葛亮说过"}, {"start": 1170.66, "end": 1171.94, "text": "如果我不成气"}, {"start": 1171.94, "end": 1173.9, "text": "他可以自立为蜀汉之主"}, {"start": 1173.9, "end": 1175.46, "text": "那朱葛亮当时是拒绝了的"}, {"start": 1175.82, "end": 1178.82, "text": "如果他要夺朕的江山的话"}, {"start": 1180.14, "end": 1181.86, "text": "何须等到现在呢"}, {"start": 1181.86, "end": 1184.3, "text": "比一时此一时啊"}, {"start": 1184.74, "end": 1186.9, "text": "那时候朝中有许多"}, {"start": 1186.9, "end": 1189.66, "text": "忠于先帝的文武大臣"}, {"start": 1189.66, "end": 1193.34, "text": "如赵云 孙乾 关兴 张包等"}, {"start": 1193.34, "end": 1195.38, "text": "他们对于先帝的感情"}, {"start": 1195.38, "end": 1197.62, "text": "远远甚于朱葛亮"}, {"start": 1198.34, "end": 1200.34, "text": "朱葛亮神识度势"}, {"start": 1200.34, "end": 1202.34, "text": "当然不敢冒犯"}, {"start": 1202.34, "end": 1204.14, "text": "现在不同了"}, {"start": 1204.14, "end": 1207.62, "text": "前朝的文武大臣都已经过世了"}, {"start": 1207.62, "end": 1211.46, "text": "朱葛亮已经没有了后顾之忧了"}, {"start": 1215.66, "end": 1219.06, "text": "那你说朕该怎么办啊"}, {"start": 1219.06, "end": 1220.82, "text": "陛下立刻下一道指令"}, {"start": 1220.82, "end": 1222.86, "text": "找朱葛亮回京议事"}, {"start": 1222.86, "end": 1226.3, "text": "至此 臣执此信与他当面对峙"}, {"start": 1226.3, "end": 1228.78, "text": "那 他要是不来怎么办"}, {"start": 1228.78, "end": 1234.94, "text": "更说明朱葛亮心存不忘"}, {"start": 1234.98, "end": 1236.74, "text": "心存不归了"}, {"start": 1245.11, "end": 1246.99, "text": "陛下守诏"}, {"start": 1246.99, "end": 1250.71, "text": "说东吴陆迅轻率十五万军"}, {"start": 1250.71, "end": 1252.75, "text": "轻入蜀地"}, {"start": 1252.75, "end": 1256.11, "text": "连破川南八九座关岸"}, {"start": 1256.11, "end": 1259.19, "text": "使吾中将领不能敌"}, {"start": 1259.19, "end": 1263.9, "text": "陛下召我回成都相救"}, {"start": 1263.9, "end": 1266.02, "text": "如果东吴起兵返境的话"}, {"start": 1266.02, "end": 1268.26, "text": "我们早就该有消息了"}, {"start": 1268.26, "end": 1269.66, "text": "不错"}, {"start": 1269.66, "end": 1271.94, "text": "东吴返境是假"}, {"start": 1271.94, "end": 1274.94, "text": "陛下让我回朝才是真呢"}, {"start": 1274.94, "end": 1277.18, "text": "那丞相打算怎么办"}, {"start": 1277.18, "end": 1281.09, "text": "我必须回成都见驾"}, {"start": 1281.09, "end": 1282.41, "text": "丞相"}, {"start": 1282.41, "end": 1284.13, "text": "我军刚刚得到补充"}, {"start": 1284.13, "end": 1285.49, "text": "兵精粮足"}, {"start": 1285.49, "end": 1287.81, "text": "而且牢牢掌握着战场的主动"}, {"start": 1287.81, "end": 1288.93, "text": "而司马仪呢"}, {"start": 1288.93, "end": 1289.81, "text": "又战败了"}, {"start": 1289.81, "end": 1291.21, "text": "兵退了两百里"}, {"start": 1291.21, "end": 1293.17, "text": "可是如果这时候你要是走了"}, {"start": 1293.17, "end": 1295.61, "text": "我们岂不是功亏一篑吗"}, {"start": 1296.57, "end": 1299.45, "text": "说得不错呀"}, {"start": 1299.45, "end": 1301.09, "text": "我猜想"}, {"start": 1301.09, "end": 1304.57, "text": "八成是司马仪做的鬼"}, {"start": 1304.57, "end": 1308.41, "text": "几年前他吃了我一道反奸计"}, {"start": 1308.41, "end": 1310.37, "text": "今日以我之道"}, {"start": 1310.37, "end": 1313.17, "text": "反报于我"}, {"start": 1313.17, "end": 1314.13, "text": "将在外"}, {"start": 1314.13, "end": 1315.77, "text": "军命有所不受"}, {"start": 1315.77, "end": 1319.53, "text": "末将请丞相不要回去"}, {"start": 1319.53, "end": 1321.61, "text": "不行"}, {"start": 1321.61, "end": 1324.77, "text": "我在蜀中地位不同将帅"}, {"start": 1324.77, "end": 1329.35, "text": "我必须回成都见驾"}, {"start": 1329.35, "end": 1330.55, "text": "便是不忠"}, {"start": 1330.55, "end": 1331.91, "text": "便是抗旨"}, {"start": 1331.91, "end": 1334.71, "text": "定会遭人猜忌"}, {"start": 1334.71, "end": 1336.27, "text": "而司马仪"}, {"start": 1336.27, "end": 1339.43, "text": "他所谋的就是让我朝中内乱"}, {"start": 1339.43, "end": 1341.47, "text": "逼我退军"}, {"start": 1341.47, "end": 1343.39, "text": "这样吧"}, {"start": 1343.39, "end": 1345.95, "text": "我让魏延 王平统军"}, {"start": 1345.95, "end": 1347.47, "text": "各部坚守原地"}, {"start": 1347.47, "end": 1348.75, "text": "不必退军"}, {"start": 1348.75, "end": 1349.99, "text": "只有你"}, {"start": 1349.99, "end": 1352.31, "text": "随我回成都见驾"}, {"start": 1352.31, "end": 1354.59, "text": "那末将带多少人马"}, {"start": 1354.59, "end": 1357.63, "text": "带什么人马呀"}, {"start": 1357.63, "end": 1360.27, "text": "怕我有不测呀"}, {"start": 1360.31, "end": 1373.11, "text": "无师计足矣"}, {"start": 1373.11, "end": 1373.87, "text": "吕将军"}, {"start": 1373.87, "end": 1375.47, "text": "丞相已到十里河"}, {"start": 1375.47, "end": 1376.99, "text": "随行多少兵马"}, {"start": 1376.99, "end": 1377.83, "text": "一辆车驾"}, {"start": 1377.83, "end": 1378.79, "text": "从计数十"}, {"start": 1378.79, "end": 1380.43, "text": "随行将军只有将为一人"}, {"start": 1380.43, "end": 1381.67, "text": "远出呢"}, {"start": 1381.67, "end": 1383.39, "text": "后面有没有大队人马"}, {"start": 1383.39, "end": 1384.95, "text": "在下八五十里内全部探过"}, {"start": 1384.95, "end": 1385.47, "text": "没有"}, {"start": 1385.47, "end": 1386.47, "text": "再探"}, {"start": 1386.47, "end": 1387.47, "text": "百里所在"}, {"start": 1387.47, "end": 1388.71, "text": "全部都要探到"}, {"start": 1388.71, "end": 1389.43, "text": "诺"}, {"start": 1389.43, "end": 1396.42, "text": "驾"}, {"start": 1396.42, "end": 1397.14, "text": "列位"}, {"start": 1397.14, "end": 1398.82, "text": "请在此静候"}, {"start": 1398.82, "end": 1400.54, "text": "我亲自去趟十里桥"}, {"start": 1400.54, "end": 1427.42, "text": "迎接丞相"}, {"start": 1427.42, "end": 1428.58, "text": "下官李峰"}, {"start": 1428.58, "end": 1431.69, "text": "拜见丞相"}, {"start": 1431.69, "end": 1433.65, "text": "李峰啊"}, {"start": 1433.65, "end": 1436.25, "text": "你为何独自来此"}, {"start": 1436.25, "end": 1437.57, "text": "丞相"}, {"start": 1437.57, "end": 1439.37, "text": "你没有收到我的信吗"}, {"start": 1439.37, "end": 1440.73, "text": "收到了"}, {"start": 1440.73, "end": 1444.17, "text": "那你为何不带大军护驾"}, {"start": 1444.17, "end": 1447.29, "text": "大军进出旗山不容易"}, {"start": 1447.29, "end": 1449.09, "text": "我让他们原地驻守"}, {"start": 1449.09, "end": 1451.69, "text": "等我回去继续北伐"}, {"start": 1451.69, "end": 1453.53, "text": "丞相可知道"}, {"start": 1453.53, "end": 1457.27, "text": "城里暗藏多大危险吗"}, {"start": 1457.27, "end": 1458.71, "text": "知道"}, {"start": 1458.71, "end": 1460.99, "text": "谁让我是丞相呢"}, {"start": 1460.99, "end": 1463.23, "text": "先帝脱孤之重"}, {"start": 1463.23, "end": 1467.35, "text": "我岂能姑息自己信"}, {"start": 1467.35, "end": 1468.71, "text": "罢了"}, {"start": 1468.71, "end": 1472.1, "text": "你引我进城吧"}, {"start": 1472.1, "end": 1517.29, "text": "诺"}, {"start": 1517.29, "end": 1518.25, "text": "丞相"}, {"start": 1518.25, "end": 1519.45, "text": "陛下有旨"}, {"start": 1519.45, "end": 1535.95, "text": "请你到太宁宫相见"}, {"start": 1535.95, "end": 1536.87, "text": "我说"}, {"start": 1536.87, "end": 1538.19, "text": "这密信的事"}, {"start": 1538.19, "end": 1540.31, "text": "朕还是不追究了吧"}, {"start": 1540.31, "end": 1542.35, "text": "诸葛亮马上就要回朝了"}, {"start": 1542.35, "end": 1543.79, "text": "事已至此"}, {"start": 1543.79, "end": 1547.19, "text": "陛下千万不能再犹豫了"}, {"start": 1547.19, "end": 1548.11, "text": "可是"}, {"start": 1548.11, "end": 1549.27, "text": "朕与相父"}, {"start": 1549.27, "end": 1551.63, "text": "他有父子之情啊"}, {"start": 1552.19, "end": 1553.79, "text": "我很不下心来"}, {"start": 1553.79, "end": 1556.39, "text": "陛下如果很不下心来"}, {"start": 1556.39, "end": 1557.95, "text": "那么先帝的基业"}, {"start": 1557.95, "end": 1560.87, "text": "就要沦入他人之手了"}, {"start": 1560.87, "end": 1561.79, "text": "陛下"}, {"start": 1561.79, "end": 1563.83, "text": "你好好地想一想"}, {"start": 1563.83, "end": 1564.91, "text": "你与诸葛亮"}, {"start": 1564.91, "end": 1566.39, "text": "既有君臣之理"}, {"start": 1566.39, "end": 1568.03, "text": "更有父子之情"}, {"start": 1568.03, "end": 1569.87, "text": "可他是怎么对待你的"}, {"start": 1569.87, "end": 1571.43, "text": "他暗通司马仪"}, {"start": 1571.43, "end": 1573.19, "text": "密夺先帝江山"}, {"start": 1573.19, "end": 1573.91, "text": "昔日"}, {"start": 1573.91, "end": 1575.83, "text": "曹操挟天子令诸侯"}, {"start": 1575.83, "end": 1577.07, "text": "如今的诸葛亮"}, {"start": 1577.07, "end": 1579.55, "text": "就是属中的曹操啊"}, {"start": 1579.59, "end": 1582.55, "text": "李大人把我说成了曹操"}, {"start": 1583.79, "end": 1586.71, "text": "也有道理"}, {"start": 1586.71, "end": 1589.27, "text": "曹操是丞相"}, {"start": 1589.27, "end": 1592.03, "text": "我也是丞相"}, {"start": 1592.03, "end": 1594.15, "text": "但我与曹操"}, {"start": 1594.15, "end": 1596.03, "text": "虽可并提"}, {"start": 1596.03, "end": 1598.63, "text": "却不能并立"}, {"start": 1598.63, "end": 1602.87, "text": "诸葛亮中曹梦得奸"}, {"start": 1602.87, "end": 1607.43, "text": "中间不两立"}, {"start": 1607.43, "end": 1611.15, "text": "臣相回来了"}, {"start": 1611.15, "end": 1613.07, "text": "臣诸葛亮"}, {"start": 1613.07, "end": 1615.27, "text": "拜见陛下"}, {"start": 1615.27, "end": 1617.55, "text": "丞相请喜"}, {"start": 1617.55, "end": 1618.95, "text": "陛下"}, {"start": 1618.95, "end": 1622.03, "text": "北伐大军连战连截"}, {"start": 1622.03, "end": 1625.43, "text": "司马仪兵穷历劫"}, {"start": 1625.43, "end": 1627.99, "text": "臣正要长驱北上"}, {"start": 1627.99, "end": 1629.87, "text": "直到长安"}, {"start": 1629.87, "end": 1632.87, "text": "不知陛下为何突然下令"}, {"start": 1632.87, "end": 1635.07, "text": "让臣回茶不忘"}, {"start": 1635.07, "end": 1639.81, "text": "那个"}, {"start": 1639.81, "end": 1641.61, "text": "朕多日不见相父"}, {"start": 1641.61, "end": 1643.21, "text": "心里十分想念"}, {"start": 1643.21, "end": 1650.3, "text": "想让你回来续一旧"}, {"start": 1650.3, "end": 1652.86, "text": "陛下可知道"}, {"start": 1652.94, "end": 1656.46, "text": "三十万大军出一趟旗山"}, {"start": 1656.46, "end": 1658.1, "text": "有多艰险"}, {"start": 1658.1, "end": 1660.78, "text": "要耗费多少钱粮"}, {"start": 1660.78, "end": 1663.82, "text": "可知道前方将领攻城拔寨"}, {"start": 1663.82, "end": 1665.38, "text": "流了多少鲜血"}, {"start": 1665.38, "end": 1667.98, "text": "牺牲多少性命啊"}, {"start": 1668.9, "end": 1669.62, "text": "这"}, {"start": 1670.78, "end": 1671.9, "text": "陛下"}, {"start": 1671.9, "end": 1673.14, "text": "事已至此"}, {"start": 1673.14, "end": 1675.02, "text": "你不必多善"}, {"start": 1675.02, "end": 1676.58, "text": "你是天子"}, {"start": 1676.58, "end": 1678.58, "text": "何惧下臣"}, {"start": 1678.58, "end": 1680.46, "text": "以言此话说的"}, {"start": 1681.46, "end": 1683.42, "text": "我有何罪"}, {"start": 1683.42, "end": 1685.22, "text": "请陛下直言"}, {"start": 1693.51, "end": 1694.95, "text": "相父"}, {"start": 1694.95, "end": 1696.35, "text": "这儿有封信"}, {"start": 1696.35, "end": 1697.59, "text": "你看看吧"}, {"start": 1697.59, "end": 1710.4, "text": "司马仪请陛下"}, {"start": 1710.4, "end": 1712.32, "text": "好字"}, {"start": 1712.32, "end": 1714.28, "text": "好文章"}, {"start": 1714.28, "end": 1716.2, "text": "好计谋"}, {"start": 1716.2, "end": 1718.0, "text": "陛下"}, {"start": 1718.0, "end": 1723.98, "text": "可相信这信上写的事情吗"}, {"start": 1723.98, "end": 1725.78, "text": "朕不大信"}, {"start": 1725.78, "end": 1726.66, "text": "不过"}, {"start": 1726.66, "end": 1728.34, "text": "诸葛亮"}, {"start": 1728.34, "end": 1731.22, "text": "陛下当然不相信这是真的"}, {"start": 1731.22, "end": 1733.5, "text": "所以才召你回朝议事"}, {"start": 1733.5, "end": 1735.46, "text": "问个究竟"}, {"start": 1735.46, "end": 1736.26, "text": "但是"}, {"start": 1736.26, "end": 1738.06, "text": "此信是真是假"}, {"start": 1738.06, "end": 1741.26, "text": "应该由你来禀告皇上"}, {"start": 1741.26, "end": 1742.94, "text": "毕竟这信上说"}, {"start": 1742.94, "end": 1745.94, "text": "是你与司马仪达成的协议啊"}, {"start": 1745.94, "end": 1752.18, "text": "此信从何而来啊"}, {"start": 1754.0, "end": 1755.2, "text": "独卫苟安"}, {"start": 1755.2, "end": 1757.04, "text": "在回成都的路上"}, {"start": 1757.04, "end": 1759.68, "text": "从卫使身上搜出来的"}, {"start": 1759.68, "end": 1762.04, "text": "那个卫使呢"}, {"start": 1762.08, "end": 1764.08, "text": "那人拼命抵抗"}, {"start": 1764.08, "end": 1765.48, "text": "被苟安布下"}, {"start": 1765.48, "end": 1766.44, "text": "杀死了"}, {"start": 1766.44, "end": 1768.44, "text": "那么苟安呢"}, {"start": 1769.2, "end": 1770.8, "text": "对啊 义亲"}, {"start": 1770.8, "end": 1773.04, "text": "你刚才说苟安已经进宫了"}, {"start": 1773.04, "end": 1774.36, "text": "那他现在为何不来啊"}, {"start": 1774.36, "end": 1776.16, "text": "是啊"}, {"start": 1776.16, "end": 1778.48, "text": "臣一早就传他去了"}, {"start": 1778.48, "end": 1779.24, "text": "可"}, {"start": 1779.24, "end": 1783.05, "text": "可现在怎么还没到啊"}, {"start": 1783.05, "end": 1785.49, "text": "如我所料不错"}, {"start": 1785.49, "end": 1792.27, "text": "苟安已经逃离了成都"}, {"start": 1792.27, "end": 1794.11, "text": "江为"}, {"start": 1794.11, "end": 1796.91, "text": "把实情禀报陛下"}, {"start": 1796.95, "end": 1798.55, "text": "诺"}, {"start": 1798.55, "end": 1799.63, "text": "禀陛下"}, {"start": 1799.63, "end": 1801.63, "text": "苟安运送军粮为限十五日"}, {"start": 1801.63, "end": 1802.95, "text": "依律当斩"}, {"start": 1802.95, "end": 1804.91, "text": "但丞相念他是出犯"}, {"start": 1804.91, "end": 1806.95, "text": "又顾忌他是上书令之内侄"}, {"start": 1806.95, "end": 1809.11, "text": "所以往开一面只掌责了八十"}, {"start": 1809.11, "end": 1811.39, "text": "之后苟安便心怀仇恨"}, {"start": 1811.39, "end": 1813.75, "text": "在回去的路上又被卫军掳了去"}, {"start": 1813.75, "end": 1815.47, "text": "随其那亲兵多被杀死"}, {"start": 1815.47, "end": 1816.99, "text": "只有两人逃到了山里"}, {"start": 1816.99, "end": 1819.23, "text": "辗转数日才回到祁山大营"}, {"start": 1819.23, "end": 1821.39, "text": "而如今这两人就在宫外"}, {"start": 1821.39, "end": 1822.71, "text": "陛下若不信的话"}, {"start": 1822.71, "end": 1824.79, "text": "可以召上来作证"}, {"start": 1824.79, "end": 1826.31, "text": "所谓苟安格杀密使"}, {"start": 1826.31, "end": 1827.31, "text": "搜得密信"}, {"start": 1827.31, "end": 1829.27, "text": "纯属胡说"}, {"start": 1829.27, "end": 1831.31, "text": "陛下"}, {"start": 1831.31, "end": 1834.07, "text": "苟安已归降司马仪"}, {"start": 1834.07, "end": 1836.27, "text": "司马仪写了这封信"}, {"start": 1836.27, "end": 1839.35, "text": "让苟安来成都行离间之际"}, {"start": 1839.35, "end": 1847.57, "text": "陛下为何不查呢"}, {"start": 1847.57, "end": 1848.21, "text": "这"}, {"start": 1848.21, "end": 1850.77, "text": "这是听信的礼言的禅言"}, {"start": 1850.77, "end": 1851.33, "text": "这"}, {"start": 1851.33, "end": 1853.05, "text": "这是一时糊涂啊"}, {"start": 1856.72, "end": 1858.8, "text": "陛下"}, {"start": 1858.8, "end": 1862.32, "text": "江为指苟安说谎"}, {"start": 1862.32, "end": 1864.24, "text": "他的亲信密使回朝"}, {"start": 1864.24, "end": 1866.12, "text": "难道就是真的了吗"}, {"start": 1866.12, "end": 1867.44, "text": "礼言"}, {"start": 1867.44, "end": 1869.8, "text": "如今这两个亲兵就在宫外"}, {"start": 1869.8, "end": 1870.92, "text": "而苟安何在"}, {"start": 1870.92, "end": 1872.24, "text": "不管你怎么说"}, {"start": 1872.24, "end": 1873.56, "text": "密信在此"}, {"start": 1873.56, "end": 1874.92, "text": "白纸黑字"}, {"start": 1874.92, "end": 1875.84, "text": "陛下"}, {"start": 1875.84, "end": 1877.36, "text": "你快下旨吧"}, {"start": 1877.36, "end": 1879.04, "text": "先罢免了诸葛亮"}, {"start": 1879.04, "end": 1882.12, "text": "然后再另其祥查"}, {"start": 1882.12, "end": 1883.12, "text": "陛下"}, {"start": 1883.12, "end": 1884.2, "text": "臣有话说"}, {"start": 1884.2, "end": 1885.96, "text": "风儿"}, {"start": 1885.96, "end": 1887.6, "text": "天子面前"}, {"start": 1887.6, "end": 1891.74, "text": "哪有你说话的份"}, {"start": 1891.74, "end": 1892.78, "text": "陛下"}, {"start": 1892.78, "end": 1894.06, "text": "丞相是更古以来"}, {"start": 1894.06, "end": 1896.74, "text": "罕见的忠臣呢"}, {"start": 1896.74, "end": 1898.22, "text": "你有话快说"}, {"start": 1898.22, "end": 1900.94, "text": "那天苟安来给家父送信时"}, {"start": 1900.94, "end": 1902.9, "text": "臣就觉得此事不可靠"}, {"start": 1902.9, "end": 1903.9, "text": "苦劝家父"}, {"start": 1903.9, "end": 1905.82, "text": "不要中了司马仪的离间计"}, {"start": 1905.82, "end": 1907.74, "text": "无奈家父不听我劝"}, {"start": 1907.74, "end": 1908.78, "text": "臣只好派人"}, {"start": 1908.78, "end": 1910.42, "text": "连夜赶往旗山大营"}, {"start": 1910.42, "end": 1911.94, "text": "将此事报知丞相"}, {"start": 1911.94, "end": 1914.18, "text": "请丞相小心在意"}, {"start": 1914.18, "end": 1916.7, "text": "丞相执张熟悍三十万大军"}, {"start": 1916.7, "end": 1918.18, "text": "他如有异心"}, {"start": 1918.18, "end": 1920.02, "text": "完全可以清君策之名"}, {"start": 1920.02, "end": 1921.46, "text": "率领大军返城"}, {"start": 1921.46, "end": 1922.3, "text": "半日之间"}, {"start": 1922.3, "end": 1923.86, "text": "即可谈定成都"}, {"start": 1923.86, "end": 1926.1, "text": "但丞相没有这么做"}, {"start": 1926.1, "end": 1926.94, "text": "他此行"}, {"start": 1926.94, "end": 1930.18, "text": "只待回五十余计啊"}, {"start": 1930.18, "end": 1932.22, "text": "畜生"}, {"start": 1932.22, "end": 1934.7, "text": "你这个家贼"}, {"start": 1934.7, "end": 1935.82, "text": "李延"}, {"start": 1935.82, "end": 1936.9, "text": "你才是畜生"}, {"start": 1936.9, "end": 1941.83, "text": "是逆贼"}, {"start": 1941.83, "end": 1943.63, "text": "相父"}, {"start": 1943.63, "end": 1944.79, "text": "你的忠心"}, {"start": 1944.79, "end": 1946.51, "text": "可昭日月"}, {"start": 1946.51, "end": 1949.47, "text": "居然错怪你了"}, {"start": 1949.47, "end": 1953.22, "text": "臣并不委屈"}, {"start": 1953.22, "end": 1954.9, "text": "只是前方将士们"}, {"start": 1954.9, "end": 1958.86, "text": "用血和性命换来的成果"}, {"start": 1958.86, "end": 1960.98, "text": "应臣一走"}, {"start": 1960.98, "end": 1964.02, "text": "顿时化作乌有"}, {"start": 1964.02, "end": 1967.9, "text": "臣为此心痛啊"}, {"start": 1967.9, "end": 1969.66, "text": "这都是李延的罪过"}, {"start": 1969.66, "end": 1970.34, "text": "来人哪"}, {"start": 1970.34, "end": 1970.82, "text": "在"}, {"start": 1970.82, "end": 1971.9, "text": "将李延拿下"}, {"start": 1971.9, "end": 1972.78, "text": "一马中半"}, {"start": 1972.78, "end": 1976.12, "text": "诺"}, {"start": 1976.12, "end": 1980.02, "text": "放手"}, {"start": 1980.02, "end": 1981.78, "text": "我自己会走"}, {"start": 1981.78, "end": 1983.02, "text": "父亲"}, {"start": 1983.02, "end": 1985.38, "text": "忠孝不能两全"}, {"start": 1985.38, "end": 1997.35, "text": "孩儿不忍看你铸成大错呀"}, {"start": 1997.35, "end": 1998.71, "text": "丞相"}, {"start": 1998.71, "end": 2000.51, "text": "家父虽然有罪"}, {"start": 2000.51, "end": 2054.54, "text": "但请赐他一条活路吧"}, {"start": 2054.54, "end": 2056.58, "text": "李大人"}, {"start": 2056.58, "end": 2062.35, "text": "请"}, {"start": 2062.35, "end": 2068.02, "text": "这是送行酒啊"}, {"start": 2068.02, "end": 2070.78, "text": "不是送行酒"}, {"start": 2070.78, "end": 2073.5, "text": "是交行酒"}, {"start": 2073.5, "end": 2077.69, "text": "那是何意啊"}, {"start": 2077.69, "end": 2079.57, "text": "白帝诚实"}, {"start": 2079.57, "end": 2082.65, "text": "你我受先帝托孤重任"}, {"start": 2082.65, "end": 2086.13, "text": "先帝把梦想托付给了你和我"}, {"start": 2086.13, "end": 2087.17, "text": "但多年来"}, {"start": 2087.17, "end": 2088.73, "text": "你我各忙其事"}, {"start": 2088.73, "end": 2090.25, "text": "生分了许多"}, {"start": 2090.25, "end": 2095.94, "text": "才会酿成今日之祸"}, {"start": 2095.94, "end": 2097.46, "text": "总而言之啊"}, {"start": 2100.11, "end": 2102.07, "text": "我输了"}, {"start": 2102.07, "end": 2105.51, "text": "我唯有一死了"}, {"start": 2105.51, "end": 2107.15, "text": "郑芳"}, {"start": 2107.15, "end": 2110.71, "text": "你对我到底有何仇恨啊"}, {"start": 2110.71, "end": 2114.55, "text": "我对你其实并没有仇恨"}, {"start": 2114.55, "end": 2116.95, "text": "但是我反对你"}, {"start": 2116.95, "end": 2119.91, "text": "用举国之力北伐"}, {"start": 2119.91, "end": 2122.11, "text": "我在蜀中多年"}, {"start": 2122.11, "end": 2125.03, "text": "甚至国力有限"}, {"start": 2125.03, "end": 2129.39, "text": "可你却不停地举国法位"}, {"start": 2129.39, "end": 2132.03, "text": "弄得是冰皮民伐"}, {"start": 2132.03, "end": 2134.67, "text": "内外不宁"}, {"start": 2134.67, "end": 2137.39, "text": "长辞以往的话"}, {"start": 2137.39, "end": 2146.45, "text": "蜀汉要被你榨干了血呀"}, {"start": 2146.45, "end": 2148.65, "text": "我知道北伐以来"}, {"start": 2148.65, "end": 2152.33, "text": "蜀汉子民付出了沉重的代价"}, {"start": 2152.33, "end": 2156.18, "text": "因此我日夜不安"}, {"start": 2156.18, "end": 2158.34, "text": "蜀所事者"}, {"start": 2158.34, "end": 2160.22, "text": "一者天险"}, {"start": 2160.22, "end": 2162.38, "text": "二者汉事正统"}, {"start": 2162.38, "end": 2165.14, "text": "因此才能偏安至今"}, {"start": 2165.14, "end": 2166.94, "text": "但从古至今"}, {"start": 2166.94, "end": 2170.58, "text": "偏安者断不能久安"}, {"start": 2170.58, "end": 2172.26, "text": "先帝明白此理"}, {"start": 2172.26, "end": 2176.14, "text": "才立下了汉贼不两立的誓言"}, {"start": 2176.14, "end": 2178.18, "text": "我受先帝之托"}, {"start": 2178.18, "end": 2182.1, "text": "舍生冒死举兵北伐"}, {"start": 2182.1, "end": 2184.5, "text": "你为何就不明白此理呢"}, {"start": 2184.5, "end": 2192.75, "text": "主不伐位 位必伐蜀"}, {"start": 2192.75, "end": 2194.31, "text": "如果上天相佑"}, {"start": 2194.31, "end": 2197.99, "text": "我定能平定庸良 收复中原"}, {"start": 2197.99, "end": 2199.99, "text": "反之"}, {"start": 2199.99, "end": 2202.27, "text": "要是我们偏安一余"}, {"start": 2202.27, "end": 2205.32, "text": "不思进取"}, {"start": 2205.32, "end": 2208.0, "text": "早晚必亡啊"}, {"start": 2208.0, "end": 2210.99, "text": "不"}, {"start": 2210.99, "end": 2222.44, "text": "宁死也不同意"}, {"start": 2222.44, "end": 2224.0, "text": "平身吧"}, {"start": 2224.0, "end": 2226.92, "text": "谢陛下"}, {"start": 2226.92, "end": 2228.72, "text": "列位爱卿"}, {"start": 2228.72, "end": 2230.36, "text": "丞相正在祁山"}, {"start": 2230.36, "end": 2232.72, "text": "乘胜追及魏军"}, {"start": 2232.72, "end": 2235.08, "text": "朕得到了礼言密报"}, {"start": 2235.08, "end": 2237.28, "text": "称有东吴来犯"}, {"start": 2237.28, "end": 2238.4, "text": "因此"}, {"start": 2238.4, "end": 2240.2, "text": "朕不得不下令丞相"}, {"start": 2240.2, "end": 2242.52, "text": "率师回园"}, {"start": 2242.52, "end": 2243.88, "text": "事后方知"}, {"start": 2243.88, "end": 2245.04, "text": "所谓东吴来犯"}, {"start": 2245.04, "end": 2246.92, "text": "纯属子虚无有"}, {"start": 2246.92, "end": 2248.72, "text": "事情的起因"}, {"start": 2248.72, "end": 2250.88, "text": "皆因礼言征粮不力"}, {"start": 2250.88, "end": 2252.84, "text": "无法将后续的军粮"}, {"start": 2252.84, "end": 2254.96, "text": "运送到祁山大营"}, {"start": 2254.96, "end": 2256.0, "text": "不得已"}, {"start": 2256.0, "end": 2259.36, "text": "礼言只得谎报军情"}, {"start": 2259.36, "end": 2263.16, "text": "朕本该依律重办"}, {"start": 2263.16, "end": 2265.12, "text": "但是"}, {"start": 2265.12, "end": 2268.44, "text": "念起礼言有多年的勋劳"}, {"start": 2268.44, "end": 2271.36, "text": "家之相父未知说情"}, {"start": 2271.36, "end": 2272.28, "text": "故"}, {"start": 2272.28, "end": 2275.08, "text": "将其礼言贬为庶人"}, {"start": 2275.08, "end": 2276.68, "text": "永不复用"}, {"start": 2276.68, "end": 2283.74, "text": "陛下圣派"}, {"start": 2283.74, "end": 2284.7, "text": "相父"}, {"start": 2284.7, "end": 2285.98, "text": "礼言之职"}, {"start": 2285.98, "end": 2290.16, "text": "应着何人接替"}, {"start": 2290.16, "end": 2292.08, "text": "陛下"}, {"start": 2292.08, "end": 2294.48, "text": "臣愿以性命担保"}, {"start": 2294.48, "end": 2298.84, "text": "举一人担任尚书令"}, {"start": 2298.84, "end": 2302.73, "text": "亲举荐何人"}, {"start": 2302.73, "end": 2313.54, "text": "常石李峰"}, {"start": 2313.54, "end": 2315.46, "text": "在下半晚没有想到"}, {"start": 2315.46, "end": 2317.54, "text": "你不仅给了家父一条活路"}, {"start": 2317.54, "end": 2320.14, "text": "还生用了在下"}, {"start": 2320.14, "end": 2321.94, "text": "李峰啊"}, {"start": 2321.94, "end": 2323.86, "text": "我向朝廷举荐的"}, {"start": 2323.86, "end": 2326.22, "text": "是一个能为我们北伐大军"}, {"start": 2326.22, "end": 2328.42, "text": "筹良谋小的干财"}, {"start": 2328.42, "end": 2333.21, "text": "不是为了报答你"}, {"start": 2333.21, "end": 2334.77, "text": "丞相虚魂弱骨"}, {"start": 2334.77, "end": 2337.65, "text": "在下十分感动"}, {"start": 2337.65, "end": 2340.09, "text": "你父亲离开成都了吗"}, {"start": 2340.09, "end": 2342.61, "text": "已经返回故乡同子去了"}, {"start": 2342.61, "end": 2343.45, "text": "丞相"}, {"start": 2343.45, "end": 2345.21, "text": "说也奇怪"}, {"start": 2345.21, "end": 2346.45, "text": "家父以前"}, {"start": 2346.45, "end": 2348.17, "text": "总是心事重重的"}, {"start": 2348.17, "end": 2350.29, "text": "可自打成为庶民之后"}, {"start": 2350.29, "end": 2351.85, "text": "他反而一身轻快了"}, {"start": 2351.85, "end": 2356.73, "text": "走的时候啊"}, {"start": 2356.73, "end": 2357.61, "text": "开心得很"}, {"start": 2357.61, "end": 2363.87, "text": "我实话"}, {"start": 2363.87, "end": 2366.94, "text": "我羡慕他呀"}, {"start": 2366.94, "end": 2369.26, "text": "我也想重归南洋"}, {"start": 2369.26, "end": 2371.78, "text": "安老于山中灵下呀"}, {"start": 2371.78, "end": 2373.38, "text": "无奈"}, {"start": 2373.38, "end": 2403.26, "text": "不说了"}, {"start": 2403.26, "end": 2405.22, "text": "这不是我的府上吧"}, {"start": 2405.22, "end": 2406.42, "text": "禀丞相"}, {"start": 2406.42, "end": 2407.38, "text": "这处府宅"}, {"start": 2407.38, "end": 2408.7, "text": "是丞相北伐的时候"}, {"start": 2408.7, "end": 2409.98, "text": "陛下吩咐建造的"}, {"start": 2409.98, "end": 2411.06, "text": "陛下说了"}, {"start": 2411.06, "end": 2412.58, "text": "快过年了"}, {"start": 2412.58, "end": 2418.97, "text": "此宅赐给丞相做礼物"}, {"start": 2418.97, "end": 2422.61, "text": "这得好去多少钱两年啊"}, {"start": 2422.61, "end": 2425.45, "text": "李峰 你为何不见呢"}, {"start": 2425.45, "end": 2427.01, "text": "建造新宅的时候"}, {"start": 2427.01, "end": 2428.77, "text": "下官见过"}, {"start": 2428.77, "end": 2433.96, "text": "陛下不难"}, {"start": 2433.96, "end": 2435.76, "text": "又一年过去了"}, {"start": 2435.76, "end": 2441.09, "text": "为法大业还没有完成"}, {"start": 2441.09, "end": 2448.4, "text": "我何德何能干居子新宅呀"}, {"start": 2448.4, "end": 2450.44, "text": "李峰哪"}, {"start": 2450.44, "end": 2452.6, "text": "把这府门封上"}, {"start": 2452.6, "end": 2454.16, "text": "不攻破洛阳"}, {"start": 2454.16, "end": 2456.16, "text": "我绝不进这府门"}, {"start": 2456.16, "end": 2458.32, "text": "遵命"}, {"start": 2458.32, "end": 2459.28, "text": "江伟"}, {"start": 2459.28, "end": 2460.16, "text": "末将在"}, {"start": 2460.16, "end": 2462.04, "text": "吩咐部下做好准备"}, {"start": 2462.04, "end": 2463.96, "text": "两天后启行"}, {"start": 2463.96, "end": 2464.84, "text": "你"}, {"start": 2464.84, "end": 2468.0, "text": "随我重返祁山大营"}, {"start": 2468.0, "end": 2468.8, "text": "遵命"}]