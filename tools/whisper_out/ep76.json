[{"start": 3.73, "end": 6.73, "text": "臣司马仪叩见吴皇。"}, {"start": 7.73, "end": 8.73, "text": "平身吧。"}, {"start": 9.73, "end": 10.73, "text": "谢陛下。"}, {"start": 14.8, "end": 17.8, "text": "这么晚了,你来做甚?"}, {"start": 19.8, "end": 22.8, "text": "华新大人奉陛下旨意,"}, {"start": 23.8, "end": 25.8, "text": "一令人在城外住起寿膳高谈。"}, {"start": 26.8, "end": 27.8, "text": "这没有下旨啊?"}, {"start": 31.1, "end": 33.1, "text": "那一定是陛下记错了。"}, {"start": 34.1, "end": 37.1, "text": "华新大人不会错,是吗陛下?"}, {"start": 37.1, "end": 45.46, "text": "你接着说。"}, {"start": 46.46, "end": 50.78, "text": "寿膳谈住起后,请陛下选定黄道吉日,"}, {"start": 51.78, "end": 53.78, "text": "并招文武百官于谭下。"}, {"start": 54.78, "end": 56.78, "text": "陛下亲指天子喜寿,"}, {"start": 57.78, "end": 59.78, "text": "将帝位擅让于魏王。"}, {"start": 62.78, "end": 65.78, "text": "又是一次铜雀台之会?"}, {"start": 66.78, "end": 67.78, "text": "陛下圣明。"}, {"start": 68.78, "end": 69.78, "text": "这次无需诏书了吧?"}, {"start": 70.78, "end": 73.78, "text": "登谈擅让,祭天大礼。"}, {"start": 73.78, "end": 74.78, "text": "豈能无诏?"}, {"start": 75.78, "end": 76.78, "text": "你们!"}, {"start": 77.78, "end": 82.11, "text": "陛下勿警,如陛下恩准。"}, {"start": 86.92, "end": 92.45, "text": "臣愿意再替汉氏借一次全马之劳。"}, {"start": 93.45, "end": 95.45, "text": "恐怕往后臣就没这个福分了。"}, {"start": 96.45, "end": 99.98, "text": "你能为朕做什么?"}, {"start": 100.98, "end": 115.1, "text": "臣愿为陛下草诏。"}, {"start": 116.1, "end": 117.1, "text": "是啊。"}, {"start": 118.1, "end": 120.1, "text": "你是曹匹的心腹之臣。"}, {"start": 121.1, "end": 123.1, "text": "此诏非你不可呀。"}, {"start": 124.1, "end": 125.1, "text": "臣领旨。"}, {"start": 125.1, "end": 126.1, "text": "司马仪啊,"}, {"start": 129.25, "end": 131.25, "text": "朕为你言默吧?"}, {"start": 132.25, "end": 135.25, "text": "盼你运笔如刀,刀刀剑斜。"}, {"start": 136.25, "end": 137.25, "text": "陛下,"}, {"start": 138.25, "end": 142.88, "text": "歇着,还是臣借来吧。"}, {"start": 143.88, "end": 164.78, "text": "谢皇后。"}, {"start": 164.78, "end": 184.82, "text": "尔魏王,"}, {"start": 184.82, "end": 185.82, "text": "西者,杨,"}, {"start": 186.82, "end": 187.82, "text": "善魏于顺,"}, {"start": 188.82, "end": 189.82, "text": "顺,善魏于宇,"}, {"start": 190.82, "end": 191.82, "text": "天命无常,"}, {"start": 192.82, "end": 193.82, "text": "违规有德,"}, {"start": 193.82, "end": 194.82, "text": "汉道凌迟,"}, {"start": 195.82, "end": 196.82, "text": "大乱资昏,"}, {"start": 197.82, "end": 198.82, "text": "寻雄自逆,"}, {"start": 199.82, "end": 200.82, "text": "环雨颠覆。"}, {"start": 201.82, "end": 202.82, "text": "接来,"}, {"start": 202.82, "end": 203.82, "text": "魏王神武,"}, {"start": 204.82, "end": 205.82, "text": "整朝纲,"}, {"start": 205.82, "end": 206.82, "text": "平祸乱,"}, {"start": 206.82, "end": 207.82, "text": "旧社稷,"}, {"start": 207.82, "end": 208.82, "text": "安宗庙,"}, {"start": 208.82, "end": 209.82, "text": "金王,"}, {"start": 209.82, "end": 210.82, "text": "清城前绪,"}, {"start": 210.82, "end": 212.82, "text": "光与乃德,"}, {"start": 212.82, "end": 213.82, "text": "成文,"}, {"start": 213.82, "end": 214.82, "text": "武之大业,"}, {"start": 215.82, "end": 216.82, "text": "招,"}, {"start": 216.82, "end": 217.82, "text": "列祖之弘列,"}, {"start": 218.82, "end": 219.82, "text": "皇陵降瑞,"}, {"start": 219.82, "end": 221.82, "text": "人神告征,"}, {"start": 222.82, "end": 223.82, "text": "但为采量,"}, {"start": 223.82, "end": 224.82, "text": "施兮震命。"}, {"start": 225.82, "end": 226.82, "text": "宣约,"}, {"start": 226.82, "end": 228.82, "text": "尔杜克邪于宇顺,"}, {"start": 229.82, "end": 230.82, "text": "用,"}, {"start": 230.82, "end": 231.82, "text": "率我唐典,"}, {"start": 231.82, "end": 233.82, "text": "敬训尔魏于系,"}, {"start": 233.82, "end": 234.82, "text": "天之力树,"}, {"start": 234.82, "end": 235.82, "text": "在尔宫,"}, {"start": 236.82, "end": 237.82, "text": "君其知顺大礼,"}, {"start": 238.82, "end": 239.82, "text": "享万国,"}, {"start": 239.82, "end": 241.82, "text": "以速成天命。"}, {"start": 243.82, "end": 330.2, "text": "山阳宫!"}, {"start": 354.18, "end": 355.18, "text": "天下都是你哥哥的,"}, {"start": 356.18, "end": 357.18, "text": "他要杀我,"}, {"start": 357.18, "end": 358.18, "text": "我还能躲到哪儿去?"}, {"start": 379.3, "end": 380.3, "text": "拜见山阳宫。"}, {"start": 380.3, "end": 381.3, "text": "司曼依,"}, {"start": 382.3, "end": 383.3, "text": "你来有何事?"}, {"start": 383.3, "end": 387.28, "text": "大魏皇帝,"}, {"start": 387.28, "end": 389.28, "text": "念兄妹之情,"}, {"start": 389.28, "end": 390.28, "text": "特命下臣,"}, {"start": 392.72, "end": 393.72, "text": "前来为山阳宫"}, {"start": 393.72, "end": 394.72, "text": "并夫人见行,"}, {"start": 395.72, "end": 434.58, "text": "只要山阳宫"}, {"start": 434.58, "end": 435.58, "text": "永不回都城,"}, {"start": 436.58, "end": 437.58, "text": "保你富贵终生。"}, {"start": 438.58, "end": 441.91, "text": "这话,"}, {"start": 441.91, "end": 446.44, "text": "你司马依依相信吗?"}, {"start": 446.44, "end": 450.58, "text": "司马大人,"}, {"start": 450.58, "end": 452.58, "text": "山阳宫不胜酒力,"}, {"start": 452.58, "end": 453.58, "text": "他说的话,"}, {"start": 453.58, "end": 454.58, "text": "你可千万别见怪啊!"}, {"start": 455.58, "end": 456.58, "text": "臣不怪,"}, {"start": 456.58, "end": 462.16, "text": "只相信大魏皇帝仁慈,"}, {"start": 463.16, "end": 467.71, "text": "山阳宫请。"}, {"start": 467.71, "end": 468.71, "text": "前人填土,"}, {"start": 469.71, "end": 470.71, "text": "后人收,"}, {"start": 471.71, "end": 473.71, "text": "后人收的修欢喜,"}, {"start": 474.71, "end": 475.71, "text": "还有收人,"}, {"start": 476.71, "end": 477.71, "text": "在后头。"}, {"start": 477.71, "end": 478.71, "text": "天色不早了,"}, {"start": 478.71, "end": 479.71, "text": "江山风大,"}, {"start": 479.71, "end": 510.57, "text": "回府吧。"}, {"start": 510.57, "end": 511.57, "text": "再看一眼吧,"}, {"start": 512.57, "end": 513.57, "text": "看一眼,"}, {"start": 513.57, "end": 517.22, "text": "少一眼,"}, {"start": 517.22, "end": 518.22, "text": "毕竟他当过"}, {"start": 518.22, "end": 521.63, "text": "几十年皇帝,"}, {"start": 521.63, "end": 522.63, "text": "能亲眼看看"}, {"start": 522.63, "end": 523.63, "text": "王国之君"}, {"start": 523.63, "end": 524.63, "text": "是怎样离开。"}, {"start": 525.63, "end": 526.63, "text": "这种际遇"}, {"start": 526.63, "end": 528.63, "text": "不是人人都看得见。"}, {"start": 528.63, "end": 529.63, "text": "当的真有意思,"}, {"start": 530.63, "end": 554.61, "text": "做皇帝的时候"}, {"start": 555.61, "end": 558.89, "text": "是别人逼我做的,"}, {"start": 559.89, "end": 560.89, "text": "不做皇帝的时候"}, {"start": 561.89, "end": 564.17, "text": "又是别人逼着"}, {"start": 564.17, "end": 565.17, "text": "不让我做的。"}, {"start": 565.17, "end": 566.17, "text": "九岁那年,"}, {"start": 566.17, "end": 573.45, "text": "公主把我推上皇位,"}, {"start": 574.45, "end": 576.79, "text": "我就成了"}, {"start": 576.79, "end": 577.79, "text": "她最诚心的宛人。"}, {"start": 580.87, "end": 581.87, "text": "从那以后,"}, {"start": 582.87, "end": 587.94, "text": "我甜甜一泪熄灭,"}, {"start": 588.94, "end": 589.94, "text": "伤愧祖宗,"}, {"start": 590.94, "end": 591.94, "text": "下愧黎民,"}, {"start": 592.94, "end": 593.94, "text": "没想到"}, {"start": 593.94, "end": 594.94, "text": "下愧黎民"}, {"start": 597.67, "end": 599.67, "text": "没有一天快乐的日子。"}, {"start": 605.79, "end": 606.79, "text": "我还真要感谢令弟呀,"}, {"start": 609.68, "end": 611.68, "text": "是他让我脱离了这苦海,"}, {"start": 612.68, "end": 613.68, "text": "今天"}, {"start": 614.68, "end": 615.68, "text": "是寡人"}, {"start": 616.68, "end": 618.68, "text": "毕生最快乐的日子。"}, {"start": 622.18, "end": 623.18, "text": "曹匹他不是我弟,"}, {"start": 625.18, "end": 626.18, "text": "他是奸臣贼子,"}, {"start": 627.18, "end": 628.18, "text": "臣妾"}, {"start": 629.18, "end": 630.18, "text": "对他恨之入骨。"}, {"start": 639.75, "end": 640.75, "text": "我这一辈子呀,"}, {"start": 641.75, "end": 642.75, "text": "经历过四个家,"}, {"start": 643.75, "end": 647.06, "text": "他们一个个都是我这个"}, {"start": 647.06, "end": 649.06, "text": "傀儡皇帝的主子。"}, {"start": 649.06, "end": 664.78, "text": "算起来,"}, {"start": 665.78, "end": 668.78, "text": "令弟算是对我最好的一个。"}, {"start": 668.78, "end": 675.4, "text": "可以回到青山绿水间了,"}, {"start": 675.4, "end": 683.42, "text": "我只在师父里度度没去过。"}, {"start": 683.42, "end": 688.39, "text": "船要沉了!"}, {"start": 688.39, "end": 697.84, "text": "船要滑快滑!"}, {"start": 697.84, "end": 698.84, "text": "叔公!"}, {"start": 698.84, "end": 699.84, "text": "快滑!"}, {"start": 699.84, "end": 700.84, "text": "快换船吧!"}, {"start": 700.84, "end": 701.84, "text": "船要沉了!"}, {"start": 701.84, "end": 702.84, "text": "退下!"}, {"start": 702.84, "end": 711.3, "text": "他想要害死你啊!"}, {"start": 711.3, "end": 712.3, "text": "快!"}, {"start": 713.3, "end": 714.3, "text": "不是司马,"}, {"start": 715.3, "end": 716.3, "text": "是曹匹,"}, {"start": 716.3, "end": 718.3, "text": "曹匹他想要害死你啊!"}, {"start": 718.3, "end": 719.3, "text": "我真久,"}, {"start": 719.3, "end": 731.21, "text": "来吧,"}, {"start": 731.21, "end": 732.21, "text": "你知道吗?"}, {"start": 741.95, "end": 742.95, "text": "这个洞"}, {"start": 742.95, "end": 744.95, "text": "不是司马一所为。"}, {"start": 745.95, "end": 755.05, "text": "我把祖宗江山"}, {"start": 755.05, "end": 757.05, "text": "无首送人了,"}, {"start": 757.05, "end": 762.58, "text": "我不配藏在大汗苦土,"}, {"start": 763.58, "end": 765.58, "text": "只为沉入江河,"}, {"start": 766.58, "end": 768.58, "text": "漂入大海未滕,"}, {"start": 768.58, "end": 779.54, "text": "寡人自己待会儿。"}, {"start": 779.54, "end": 780.54, "text": "总算是英雄了,"}, {"start": 780.54, "end": 798.46, "text": "臣妾,"}, {"start": 798.46, "end": 801.42, "text": "哪儿也不去,"}, {"start": 801.42, "end": 802.42, "text": "陪着陛下,"}, {"start": 802.42, "end": 804.42, "text": "永远陪着陛下。"}, {"start": 806.98, "end": 810.16, "text": "还是"}, {"start": 810.16, "end": 811.16, "text": "帝王家"}, {"start": 811.16, "end": 812.16, "text": "帝王家"}, {"start": 812.16, "end": 821.86, "text": "这些日子,"}, {"start": 821.86, "end": 837.14, "text": "痛定思痛,"}, {"start": 859.1, "end": 866.64, "text": "心虚万劫。"}, {"start": 866.64, "end": 867.64, "text": "你说过,"}, {"start": 867.64, "end": 869.64, "text": "能行情"}, {"start": 873.81, "end": 877.66, "text": "过于孤傲,"}, {"start": 878.66, "end": 880.66, "text": "视天下英雄"}, {"start": 881.66, "end": 882.66, "text": "如草芥。"}, {"start": 882.66, "end": 883.66, "text": "如果不防,"}, {"start": 886.94, "end": 887.94, "text": "再也不怕。"}, {"start": 887.94, "end": 888.94, "text": "如果不防,"}, {"start": 889.94, "end": 895.59, "text": "早晚会祸及自身。"}, {"start": 895.59, "end": 899.48, "text": "荆州之祸"}, {"start": 899.48, "end": 903.08, "text": "被你言中了。"}, {"start": 903.08, "end": 905.08, "text": "如果云长"}, {"start": 905.08, "end": 908.08, "text": "他能够不轻视动物,"}, {"start": 909.08, "end": 914.22, "text": "能够善加提防,"}, {"start": 914.22, "end": 919.6, "text": "何至如此?"}, {"start": 919.6, "end": 924.07, "text": "何至于丢了性命?"}, {"start": 924.07, "end": 928.07, "text": "何至于失了荆州?"}, {"start": 928.07, "end": 931.12, "text": "主公,"}, {"start": 931.12, "end": 938.39, "text": "云长眼里,"}, {"start": 938.39, "end": 943.18, "text": "母群雄皆数倍而。"}, {"start": 943.18, "end": 945.18, "text": "家兄诸葛瑾,"}, {"start": 945.18, "end": 947.18, "text": "奉孙泉之命,"}, {"start": 947.18, "end": 949.18, "text": "向云长提亲,"}, {"start": 950.18, "end": 952.18, "text": "想让云长之女,"}, {"start": 952.18, "end": 953.18, "text": "嫁给孙泉世子,"}, {"start": 953.18, "end": 957.18, "text": "孙柳两家再结秦晋之好。"}, {"start": 957.18, "end": 958.18, "text": "可主公知道,"}, {"start": 958.18, "end": 960.18, "text": "云长是怎么回答的吗?"}, {"start": 960.18, "end": 967.15, "text": "燕能嫁给泉子?"}, {"start": 967.15, "end": 968.15, "text": "这,"}, {"start": 968.15, "end": 972.71, "text": "无论任何王者听之,"}, {"start": 972.71, "end": 975.71, "text": "都有如一箭传心。"}, {"start": 975.71, "end": 995.79, "text": "他们进出上庸之兵,"}, {"start": 995.79, "end": 998.79, "text": "云长何至于此?"}, {"start": 1000.79, "end": 1001.79, "text": "那刘丰"}, {"start": 1001.79, "end": 1003.79, "text": "还是我的义子,"}, {"start": 1003.79, "end": 1005.79, "text": "竟然见死不救。"}, {"start": 1006.79, "end": 1007.79, "text": "那孟大"}, {"start": 1007.79, "end": 1010.79, "text": "事后竟然投敌了。"}, {"start": 1010.79, "end": 1011.79, "text": "这二人,"}, {"start": 1011.79, "end": 1014.79, "text": "就算跑到天涯海角,"}, {"start": 1014.79, "end": 1016.79, "text": "我也要将之斩首示众。"}, {"start": 1016.79, "end": 1018.79, "text": "主公息怒,"}, {"start": 1018.79, "end": 1019.79, "text": "主公息怒我。"}, {"start": 1019.79, "end": 1027.07, "text": "只恨已无用了。"}, {"start": 1027.07, "end": 1031.41, "text": "宁州实现后,"}, {"start": 1031.41, "end": 1033.41, "text": "曹孙柳三方,"}, {"start": 1033.41, "end": 1037.41, "text": "发生了天翻地覆的巨变。"}, {"start": 1037.41, "end": 1039.41, "text": "在此之前,"}, {"start": 1039.41, "end": 1042.41, "text": "主公已拥有京州九郡,"}, {"start": 1042.41, "end": 1045.41, "text": "又夺得川蜀四十一县,"}, {"start": 1045.41, "end": 1048.41, "text": "并攻下了汉中各郡。"}, {"start": 1048.41, "end": 1051.14, "text": "可以说,"}, {"start": 1051.14, "end": 1055.14, "text": "主公已经是天下第一雄主了。"}, {"start": 1055.14, "end": 1058.8, "text": "我们定能在数年之间,"}, {"start": 1058.8, "end": 1060.8, "text": "南北两路出兵,"}, {"start": 1060.8, "end": 1061.8, "text": "一鼓作气,"}, {"start": 1061.8, "end": 1063.8, "text": "攻下徐厂,"}, {"start": 1063.8, "end": 1066.8, "text": "继而并亲济各州。"}, {"start": 1066.8, "end": 1067.8, "text": "如此,"}, {"start": 1067.8, "end": 1069.8, "text": "曹操必亡,"}, {"start": 1069.8, "end": 1072.8, "text": "主公大业必成啊。"}, {"start": 1072.8, "end": 1080.46, "text": "这就是你,"}, {"start": 1080.46, "end": 1083.46, "text": "你隆重跟我说的第三步。"}, {"start": 1083.46, "end": 1087.89, "text": "可惜,"}, {"start": 1087.89, "end": 1107.53, "text": "公元根据境势,"}, {"start": 1107.53, "end": 1110.78, "text": "曹操在大难临头之际,"}, {"start": 1110.78, "end": 1112.78, "text": "得到了川蜀之际,"}, {"start": 1112.78, "end": 1114.78, "text": "日后再想灭他。"}, {"start": 1114.78, "end": 1115.78, "text": "更困了。"}, {"start": 1115.78, "end": 1117.78, "text": "孙权却跨过了江东,"}, {"start": 1117.78, "end": 1121.5, "text": "进入中原,"}, {"start": 1121.5, "end": 1123.5, "text": "势力大增。"}, {"start": 1123.5, "end": 1129.14, "text": "天下之父,"}, {"start": 1129.14, "end": 1131.14, "text": "那里土地肥沃,"}, {"start": 1131.14, "end": 1132.14, "text": "物产丰盛,"}, {"start": 1132.14, "end": 1135.14, "text": "足可养兵五十万啊。"}, {"start": 1135.14, "end": 1136.14, "text": "更重要的是,"}, {"start": 1136.14, "end": 1139.14, "text": "京州四通八达。"}, {"start": 1139.14, "end": 1141.14, "text": "若是从京州起兵,"}, {"start": 1141.14, "end": 1143.14, "text": "无论南征还是北伐,"}, {"start": 1143.14, "end": 1145.14, "text": "车船步马,"}, {"start": 1145.14, "end": 1147.14, "text": "皆可日行百里。"}, {"start": 1147.14, "end": 1148.14, "text": "可是,"}, {"start": 1148.14, "end": 1150.14, "text": "川蜀五十一县,"}, {"start": 1150.14, "end": 1154.03, "text": "川蜀北伐,"}, {"start": 1154.03, "end": 1156.03, "text": "山川仙阁,"}, {"start": 1156.03, "end": 1159.03, "text": "遥遥两千余里啊。"}, {"start": 1159.03, "end": 1168.74, "text": "主公正在殿堂歇息,"}, {"start": 1168.74, "end": 1170.74, "text": "传命不可经扰。"}, {"start": 1171.74, "end": 1172.74, "text": "闪开!"}, {"start": 1174.74, "end": 1176.74, "text": "我们先前得的优势,"}, {"start": 1176.74, "end": 1179.74, "text": "都随京州之变而失去了。"}, {"start": 1179.74, "end": 1182.74, "text": "曹孙留三方,"}, {"start": 1182.74, "end": 1187.74, "text": "又反悔相吃不下之事啊。"}, {"start": 1187.74, "end": 1198.15, "text": "公有何事啊?"}, {"start": 1198.15, "end": 1199.15, "text": "主公,"}, {"start": 1199.15, "end": 1201.15, "text": "军师,"}, {"start": 1201.15, "end": 1207.11, "text": "曹匹,"}, {"start": 1207.11, "end": 1209.11, "text": "逼天子善让,"}, {"start": 1209.11, "end": 1210.11, "text": "开国改元,"}, {"start": 1210.11, "end": 1212.11, "text": "自立为帝。"}, {"start": 1212.11, "end": 1213.11, "text": "天子,"}, {"start": 1213.11, "end": 1215.11, "text": "北非以后,"}, {"start": 1215.11, "end": 1218.11, "text": "被念出徐都,"}, {"start": 1218.11, "end": 1220.11, "text": "途中,"}, {"start": 1220.11, "end": 1222.11, "text": "船,"}, {"start": 1222.11, "end": 1225.11, "text": "沉于长水。"}, {"start": 1225.11, "end": 1227.11, "text": "主公,"}, {"start": 1227.11, "end": 1230.11, "text": "四百年大旱哪,"}, {"start": 1230.11, "end": 1232.11, "text": "忘了。"}, {"start": 1232.11, "end": 1241.12, "text": "是难以避免之事,"}, {"start": 1241.12, "end": 1243.12, "text": "你要保重啊。"}, {"start": 1243.12, "end": 1246.12, "text": "天儿,"}, {"start": 1246.12, "end": 1251.84, "text": "我二弟刚走,"}, {"start": 1251.84, "end": 1254.84, "text": "天子竟有当,"}, {"start": 1254.84, "end": 1261.68, "text": "我刘备毕生征战,"}, {"start": 1261.68, "end": 1265.68, "text": "只为扶住汉室。"}, {"start": 1265.68, "end": 1267.68, "text": "而今,"}, {"start": 1267.68, "end": 1271.68, "text": "汉室不存啊,"}, {"start": 1271.68, "end": 1272.68, "text": "天子,"}, {"start": 1272.68, "end": 1279.45, "text": "没留世子孙,"}, {"start": 1279.45, "end": 1282.45, "text": "又有何用?"}, {"start": 1282.45, "end": 1286.69, "text": "功名大业,"}, {"start": 1286.69, "end": 1289.69, "text": "又有何用?"}, {"start": 1289.69, "end": 1297.15, "text": "主公,"}, {"start": 1297.15, "end": 1305.26, "text": "恩刘备,"}, {"start": 1305.26, "end": 1308.26, "text": "叩拜大行皇帝。"}, {"start": 1308.26, "end": 1337.58, "text": "你命苦,"}, {"start": 1337.58, "end": 1340.31, "text": "自幼,"}, {"start": 1340.31, "end": 1343.31, "text": "饱受群贼领悟,"}, {"start": 1343.31, "end": 1345.66, "text": "既而在,"}, {"start": 1345.66, "end": 1347.66, "text": "曹操挟制,"}, {"start": 1347.66, "end": 1349.66, "text": "最后,"}, {"start": 1349.66, "end": 1353.66, "text": "竟死于贼子曹批之上,"}, {"start": 1353.66, "end": 1355.66, "text": "仇未报,"}, {"start": 1355.66, "end": 1358.66, "text": "恨未雪,"}, {"start": 1358.66, "end": 1361.66, "text": "国破御远,"}, {"start": 1361.66, "end": 1364.66, "text": "乾坤伦扫。"}, {"start": 1364.66, "end": 1370.35, "text": "这都怪臣无能啊,"}, {"start": 1370.35, "end": 1373.35, "text": "臣身为皇叔,"}, {"start": 1373.35, "end": 1375.35, "text": "奉陛下写诏,"}, {"start": 1375.35, "end": 1378.35, "text": "讨贼兴汉。"}, {"start": 1378.35, "end": 1380.35, "text": "可是这么多年过去,"}, {"start": 1380.35, "end": 1384.35, "text": "却没有完成陛下的信。"}, {"start": 1384.35, "end": 1387.35, "text": "臣有父皇恩,"}, {"start": 1387.35, "end": 1391.82, "text": "罪不可赦,"}, {"start": 1391.82, "end": 1392.82, "text": "更无言,"}, {"start": 1392.82, "end": 1395.82, "text": "见刘氏先祖。"}, {"start": 1395.82, "end": 1410.11, "text": "向天立誓,"}, {"start": 1410.11, "end": 1414.58, "text": "天子随王,"}, {"start": 1414.58, "end": 1416.58, "text": "汉业尤存,"}, {"start": 1416.58, "end": 1425.61, "text": "承继汉室伪业,"}, {"start": 1425.61, "end": 1428.61, "text": "绞尽天下逆贼,"}, {"start": 1428.61, "end": 1430.61, "text": "再造大汉。"}, {"start": 1430.61, "end": 1433.86, "text": "主公节哀,"}, {"start": 1433.86, "end": 1435.86, "text": "请问主公"}, {"start": 1435.86, "end": 1438.86, "text": "准备如何承继大汉伪业?"}, {"start": 1438.86, "end": 1449.14, "text": "主公啊,"}, {"start": 1449.14, "end": 1451.14, "text": "天子已经遍天了,"}, {"start": 1451.14, "end": 1454.14, "text": "可江山却不可一日无主。"}, {"start": 1454.14, "end": 1456.14, "text": "既然曹操逆子曹批"}, {"start": 1456.14, "end": 1459.14, "text": "都已建居帝位了,"}, {"start": 1459.14, "end": 1460.14, "text": "那主公"}, {"start": 1460.14, "end": 1463.14, "text": "更应该继承大汉伪业,"}, {"start": 1463.14, "end": 1464.14, "text": "进帝位,"}, {"start": 1464.14, "end": 1466.14, "text": "号令天下。"}, {"start": 1467.14, "end": 1471.48, "text": "子龙将军说得对,"}, {"start": 1471.48, "end": 1473.48, "text": "汉贼不两立,"}, {"start": 1473.48, "end": 1474.48, "text": "王爷不偏安,"}, {"start": 1474.48, "end": 1476.48, "text": "主公只有成帝"}, {"start": 1476.48, "end": 1478.48, "text": "才能继承大汉伪业。"}, {"start": 1478.48, "end": 1481.48, "text": "臣号请主公"}, {"start": 1481.48, "end": 1483.48, "text": "建升帝位。"}, {"start": 1483.48, "end": 1484.48, "text": "放肆!"}, {"start": 1484.48, "end": 1492.05, "text": "我孝福在身,"}, {"start": 1492.05, "end": 1493.05, "text": "你们就要"}, {"start": 1493.05, "end": 1495.05, "text": "陷我不忠不义吗?"}, {"start": 1495.05, "end": 1498.45, "text": "主公,"}, {"start": 1498.45, "end": 1501.45, "text": "曹批已篡汉自立,"}, {"start": 1501.45, "end": 1503.45, "text": "主公是汉氏皇屹,"}, {"start": 1503.45, "end": 1505.45, "text": "理应继统,"}, {"start": 1505.45, "end": 1507.45, "text": "一言汉思。"}, {"start": 1507.45, "end": 1509.45, "text": "子龙啊,"}, {"start": 1509.45, "end": 1512.45, "text": "我身为汉臣,"}, {"start": 1512.45, "end": 1515.45, "text": "岂能效仿逆贼所为?"}, {"start": 1515.45, "end": 1519.39, "text": "禀主公,"}, {"start": 1519.39, "end": 1522.39, "text": "天子已被曹批所示,"}, {"start": 1522.39, "end": 1524.39, "text": "王上如不及帝位,"}, {"start": 1524.39, "end": 1527.39, "text": "何以率天师讨逆?"}, {"start": 1527.39, "end": 1528.39, "text": "再者,"}, {"start": 1528.39, "end": 1530.39, "text": "天下子民"}, {"start": 1530.39, "end": 1532.39, "text": "盼主公顺天即位,"}, {"start": 1532.39, "end": 1534.39, "text": "如大汉望甘林,"}, {"start": 1534.39, "end": 1536.39, "text": "主公如果居于礼法,"}, {"start": 1536.39, "end": 1537.39, "text": "国族不尽,"}, {"start": 1537.39, "end": 1541.39, "text": "在下恐怕有失民望也。"}, {"start": 1541.39, "end": 1557.15, "text": "你篡位称帝,"}, {"start": 1557.15, "end": 1559.15, "text": "已遭天下人辱骂。"}, {"start": 1559.15, "end": 1562.82, "text": "我虽为汉帝玄孙,"}, {"start": 1562.82, "end": 1566.82, "text": "可一无恩责不失天下,"}, {"start": 1566.82, "end": 1570.82, "text": "二无尽灭贼服汉之功。"}, {"start": 1570.82, "end": 1572.82, "text": "如果我自立称帝,"}, {"start": 1572.82, "end": 1575.82, "text": "那岂不是成了曹批第二?"}, {"start": 1575.82, "end": 1577.82, "text": "赐海人人志士,"}, {"start": 1577.82, "end": 1579.82, "text": "官吏百姓,"}, {"start": 1579.82, "end": 1581.82, "text": "该如何看待?"}, {"start": 1581.82, "end": 1582.82, "text": "主公,"}, {"start": 1582.82, "end": 1584.82, "text": "众将士跟随主公"}, {"start": 1584.82, "end": 1585.82, "text": "征战多年,"}, {"start": 1585.82, "end": 1586.82, "text": "居无定所,"}, {"start": 1586.82, "end": 1587.82, "text": "他们也期望主公"}, {"start": 1587.82, "end": 1589.82, "text": "成了皇孙正统啊。"}, {"start": 1589.82, "end": 1591.82, "text": "好你个未言!"}, {"start": 1591.82, "end": 1593.82, "text": "此话说得爽快,"}, {"start": 1593.82, "end": 1597.7, "text": "我一听便知何意。"}, {"start": 1597.7, "end": 1599.7, "text": "想让我称帝,"}, {"start": 1599.7, "end": 1601.7, "text": "无非是想让你们"}, {"start": 1601.7, "end": 1603.7, "text": "各自得到分封!"}, {"start": 1603.7, "end": 1604.7, "text": "若是这样,"}, {"start": 1604.7, "end": 1606.7, "text": "我就更加地不能称帝!"}, {"start": 1606.7, "end": 1616.77, "text": "称帝之事,"}, {"start": 1616.77, "end": 1618.77, "text": "我宁死不从。"}, {"start": 1618.77, "end": 1620.77, "text": "再言必发!"}, {"start": 1620.77, "end": 1622.77, "text": "遵命!"}, {"start": 1622.77, "end": 1630.75, "text": "主公!"}, {"start": 1630.75, "end": 1640.3, "text": "军师,"}, {"start": 1640.3, "end": 1642.3, "text": "今百官全集,"}, {"start": 1642.3, "end": 1644.3, "text": "都是忠言呢?"}, {"start": 1644.3, "end": 1645.3, "text": "为何主公"}, {"start": 1645.3, "end": 1647.3, "text": "发这么大的谎?"}, {"start": 1647.3, "end": 1649.3, "text": "主公生气了,"}, {"start": 1649.3, "end": 1652.3, "text": "看来此事有希望了。"}, {"start": 1652.3, "end": 1653.3, "text": "哦?"}, {"start": 1653.3, "end": 1654.3, "text": "禀军师,"}, {"start": 1654.3, "end": 1657.35, "text": "殿下口谕,"}, {"start": 1657.35, "end": 1658.35, "text": "我病体未愈,"}, {"start": 1658.35, "end": 1660.35, "text": "暂难离证。"}, {"start": 1660.35, "end": 1661.35, "text": "即日起,"}, {"start": 1661.35, "end": 1662.35, "text": "川汉所有证物"}, {"start": 1662.35, "end": 1663.35, "text": "截绝于诸葛亮,"}, {"start": 1663.35, "end": 1664.35, "text": "请可自立,"}, {"start": 1664.35, "end": 1666.35, "text": "不必奏报。"}, {"start": 1666.35, "end": 1667.35, "text": "回禀主公,"}, {"start": 1667.35, "end": 1669.35, "text": "诸葛亮领命。"}, {"start": 1669.35, "end": 1670.35, "text": "军师,"}, {"start": 1670.35, "end": 1674.94, "text": "这又是怎么回事?"}, {"start": 1674.94, "end": 1676.94, "text": "看来主公真是生气了。"}, {"start": 1676.94, "end": 1681.18, "text": "郑芳啊。"}, {"start": 1681.18, "end": 1696.01, "text": "军师。"}, {"start": 1696.01, "end": 1699.01, "text": "那天祭奠大行皇帝时,"}, {"start": 1699.01, "end": 1702.01, "text": "众文武都劝主公敬畏。"}, {"start": 1702.01, "end": 1705.01, "text": "你为何不开口啊?"}, {"start": 1705.01, "end": 1707.01, "text": "回军师的话,"}, {"start": 1707.01, "end": 1709.01, "text": "那天在朝中,"}, {"start": 1709.01, "end": 1712.01, "text": "有很多众臣都已经说了,"}, {"start": 1712.01, "end": 1715.01, "text": "下官就不必多言了。"}, {"start": 1715.01, "end": 1719.73, "text": "坐吧。"}, {"start": 1719.73, "end": 1720.73, "text": "谢军师。"}, {"start": 1720.73, "end": 1722.73, "text": "郑芳啊,"}, {"start": 1722.73, "end": 1724.73, "text": "你对我太恭敬了,"}, {"start": 1724.73, "end": 1726.73, "text": "恭敬得让我不得不想,"}, {"start": 1726.73, "end": 1729.73, "text": "李焉为何对我那么恭敬呢?"}, {"start": 1729.73, "end": 1733.98, "text": "下官对军师的恭敬,"}, {"start": 1733.98, "end": 1734.98, "text": "完全是出于"}, {"start": 1734.98, "end": 1738.98, "text": "对军师的仰慕之情啊。"}, {"start": 1738.98, "end": 1740.98, "text": "不必不必。"}, {"start": 1740.98, "end": 1742.98, "text": "你我共同为主公效力,"}, {"start": 1742.98, "end": 1744.98, "text": "还是随和些的好。"}, {"start": 1744.98, "end": 1746.98, "text": "这样你舒服,"}, {"start": 1746.98, "end": 1747.98, "text": "我也舒服。"}, {"start": 1747.98, "end": 1748.98, "text": "是,"}, {"start": 1748.98, "end": 1749.98, "text": "军师。"}, {"start": 1749.98, "end": 1750.98, "text": "军师,"}, {"start": 1750.98, "end": 1751.98, "text": "你怎么了?"}, {"start": 1751.98, "end": 1752.98, "text": "管不过气来。"}, {"start": 1752.98, "end": 1762.04, "text": "快来人,"}, {"start": 1762.04, "end": 1766.15, "text": "快传医官。"}, {"start": 1766.15, "end": 1768.15, "text": "高祖为人,"}, {"start": 1768.15, "end": 1771.94, "text": "龙,"}, {"start": 1771.94, "end": 1775.48, "text": "龙,"}, {"start": 1775.48, "end": 1777.48, "text": "龙准而龙言。"}, {"start": 1777.48, "end": 1779.48, "text": "龙准而龙言。"}, {"start": 1779.48, "end": 1781.48, "text": "龙准而龙言。"}, {"start": 1781.48, "end": 1783.48, "text": "龙准而龙言。"}, {"start": 1785.76, "end": 1787.76, "text": "梅,"}, {"start": 1787.76, "end": 1789.76, "text": "梅,"}, {"start": 1789.76, "end": 1791.76, "text": "梅虚然。"}, {"start": 1791.76, "end": 1793.76, "text": "梅,"}, {"start": 1793.76, "end": 1795.76, "text": "梅虚然。"}, {"start": 1795.76, "end": 1796.76, "text": "梅虚然。"}, {"start": 1796.76, "end": 1800.76, "text": "左骨有七十二黑子。"}, {"start": 1800.76, "end": 1801.76, "text": "人,"}, {"start": 1801.76, "end": 1803.76, "text": "而爱人。"}, {"start": 1803.76, "end": 1804.76, "text": "不对,"}, {"start": 1804.76, "end": 1805.76, "text": "不,"}, {"start": 1805.76, "end": 1806.76, "text": "不,"}, {"start": 1806.76, "end": 1807.76, "text": "不,"}, {"start": 1807.76, "end": 1808.76, "text": "不,"}, {"start": 1808.76, "end": 1811.07, "text": "不,"}, {"start": 1811.07, "end": 1812.07, "text": "不,"}, {"start": 1812.07, "end": 1813.07, "text": "不,"}, {"start": 1813.07, "end": 1815.07, "text": "因为了三天了,"}, {"start": 1815.07, "end": 1818.35, "text": "怎么就记得这几句?"}, {"start": 1818.35, "end": 1820.35, "text": "孩儿是在这太笨了。"}, {"start": 1820.35, "end": 1821.35, "text": "笨?"}, {"start": 1821.35, "end": 1823.35, "text": "醋�onen头胡百戏?"}, {"start": 1824.35, "end": 1826.35, "text": "那些为何你一掌会"}, {"start": 1826.35, "end": 1841.22, "text": "我来what."}, {"start": 1841.22, "end": 1850.09, "text": "打二十。"}, {"start": 1850.09, "end": 1852.09, "text": "轻兄父亲打轻点。"}, {"start": 1852.09, "end": 1854.09, "text": "昨天刚打过的,"}, {"start": 1854.09, "end": 1857.68, "text": "手还肿了呢。"}, {"start": 1857.68, "end": 1858.68, "text": "诸国。"}, {"start": 1858.68, "end": 1860.68, "text": "诸佛不过。"}, {"start": 1861.68, "end": 1862.68, "text": "世子手还 draft着,"}, {"start": 1862.68, "end": 1864.68, "text": "暂且先记下吧。"}, {"start": 1864.68, "end": 1868.66, "text": "下去吧,"}, {"start": 1869.66, "end": 1870.54, "text": "戒指背诵"}, {"start": 1871.1, "end": 1872.26, "text": "明日我再检查"}, {"start": 1872.66, "end": 1873.5, "text": "知道了 母亲"}, {"start": 1887.6, "end": 1888.88, "text": "我百年以后"}, {"start": 1890.16, "end": 1891.28, "text": "他该怎么办"}, {"start": 1891.64, "end": 1894.71, "text": "世子年幼"}, {"start": 1895.11, "end": 1896.35, "text": "长大些就好了"}, {"start": 1896.87, "end": 1898.31, "text": "但愿如你所言"}, {"start": 1898.71, "end": 1908.34, "text": "你跟了我二十几年了"}, {"start": 1908.74, "end": 1909.46, "text": "在下是"}, {"start": 1910.26, "end": 1911.1, "text": "中平三年"}, {"start": 1911.5, "end": 1912.26, "text": "追随主公"}, {"start": 1912.66, "end": 1913.26, "text": "算起来"}, {"start": 1913.78, "end": 1914.7, "text": "二十三年了"}, {"start": 1919.88, "end": 1922.04, "text": "一晃二十三年过去了"}, {"start": 1924.2, "end": 1925.92, "text": "昔日帐下的兄弟"}, {"start": 1927.8, "end": 1929.28, "text": "算来没几个了"}, {"start": 1938.23, "end": 1939.43, "text": "时不我带呀"}, {"start": 1943.82, "end": 1945.3, "text": "是孔明让你说的"}, {"start": 1945.98, "end": 1946.3, "text": "不"}, {"start": 1947.58, "end": 1948.98, "text": "是在下的心愿"}, {"start": 1952.11, "end": 1952.55, "text": "在下"}, {"start": 1952.91, "end": 1965.77, "text": "让我想一想"}, {"start": 1970.13, "end": 1970.57, "text": "主公"}, {"start": 1971.45, "end": 1973.13, "text": "军师急患病症"}, {"start": 1973.37, "end": 1974.33, "text": "卧床不起"}, {"start": 1974.97, "end": 1976.61, "text": "王府政务都积压着"}, {"start": 1977.01, "end": 1978.21, "text": "无人敢绝呀"}, {"start": 1979.25, "end": 1980.61, "text": "军师病重"}, {"start": 1982.21, "end": 1983.85, "text": "快备车 我去探望"}, {"start": 1984.81, "end": 1985.17, "text": "诺"}, {"start": 1989.47, "end": 1990.47, "text": "愿随我去吗"}, {"start": 1992.63, "end": 1993.03, "text": "不了"}, {"start": 1993.83, "end": 1995.19, "text": "我去了 你俩不必"}, {"start": 2023.39, "end": 2024.43, "text": "犯得如此重"}, {"start": 2026.58, "end": 2028.38, "text": "胸口如鸭食块"}, {"start": 2029.34, "end": 2030.66, "text": "郁闷难受啊"}, {"start": 2032.22, "end": 2033.18, "text": "迎合而起"}, {"start": 2033.46, "end": 2038.11, "text": "主公知道华兴这个人吗"}, {"start": 2040.59, "end": 2041.15, "text": "知道"}, {"start": 2042.19, "end": 2044.19, "text": "曹匹心腹重臣"}, {"start": 2045.47, "end": 2046.67, "text": "逼天子的善让"}, {"start": 2047.27, "end": 2048.35, "text": "他为首恶"}, {"start": 2049.31, "end": 2051.19, "text": "曹匹封他为相国"}, {"start": 2051.91, "end": 2053.07, "text": "当年华兴"}, {"start": 2053.39, "end": 2055.27, "text": "与管宁同席读书"}, {"start": 2055.91, "end": 2057.35, "text": "有高官过节"}, {"start": 2058.51, "end": 2060.63, "text": "管宁读书已久"}, {"start": 2061.15, "end": 2064.15, "text": "而华兴却抛下手中书卷"}, {"start": 2064.15, "end": 2065.35, "text": "出外观看"}, {"start": 2066.75, "end": 2067.95, "text": "待他回来时"}, {"start": 2068.43, "end": 2070.11, "text": "只见管宁挥刀"}, {"start": 2070.23, "end": 2071.39, "text": "割开作息"}, {"start": 2071.91, "end": 2074.31, "text": "月子飞无影"}, {"start": 2075.79, "end": 2077.95, "text": "管宁割席断翼的故事"}, {"start": 2078.79, "end": 2080.03, "text": "我也听说过"}, {"start": 2080.71, "end": 2081.59, "text": "现在"}, {"start": 2082.11, "end": 2084.43, "text": "华兴所作喧灭"}, {"start": 2085.27, "end": 2087.95, "text": "比当时看到的更华丽"}, {"start": 2087.95, "end": 2088.99, "text": "更气派"}, {"start": 2089.59, "end": 2090.71, "text": "而管宁呢"}, {"start": 2091.03, "end": 2092.79, "text": "他一直在读书"}, {"start": 2096.94, "end": 2098.94, "text": "这华兴管宁二人"}, {"start": 2099.38, "end": 2100.9, "text": "谁忧谁虑"}, {"start": 2102.42, "end": 2103.62, "text": "这还用说吗"}, {"start": 2104.62, "end": 2106.02, "text": "管宁是君子"}, {"start": 2106.9, "end": 2109.18, "text": "华兴小人意"}, {"start": 2109.74, "end": 2111.46, "text": "臣与华兴比呢"}, {"start": 2112.42, "end": 2114.54, "text": "天地玄首不可比"}, {"start": 2115.62, "end": 2118.7, "text": "可华兴请曹匹称帝"}, {"start": 2119.34, "end": 2120.62, "text": "曹匹从了"}, {"start": 2121.86, "end": 2124.7, "text": "臣劝主公敬畏"}, {"start": 2125.1, "end": 2126.74, "text": "主公不从了"}, {"start": 2131.67, "end": 2133.59, "text": "就算华兴是小人"}, {"start": 2133.91, "end": 2135.31, "text": "曹匹不是"}, {"start": 2136.79, "end": 2138.31, "text": "他建居帝位"}, {"start": 2138.83, "end": 2140.27, "text": "是明智之举"}, {"start": 2140.99, "end": 2142.71, "text": "他想和主公争天下"}, {"start": 2143.03, "end": 2145.31, "text": "就必须篡位自立"}, {"start": 2146.83, "end": 2147.59, "text": "这么做"}, {"start": 2148.15, "end": 2149.87, "text": "并不是曹匹贪婪"}, {"start": 2150.63, "end": 2152.71, "text": "而是时势所需所迫"}, {"start": 2153.39, "end": 2154.59, "text": "主公如想"}, {"start": 2154.91, "end": 2156.95, "text": "成敬大汉帝位"}, {"start": 2157.35, "end": 2158.75, "text": "就必须称帝"}, {"start": 2163.24, "end": 2167.0, "text": "我对你有一个疑问"}, {"start": 2168.0, "end": 2169.52, "text": "请主公示旨"}, {"start": 2170.92, "end": 2171.8, "text": "当初"}, {"start": 2173.0, "end": 2174.88, "text": "我敬畏汉中王时"}, {"start": 2176.24, "end": 2177.36, "text": "你内心"}, {"start": 2178.48, "end": 2180.08, "text": "都并不很赞同"}, {"start": 2181.0, "end": 2181.88, "text": "今日"}, {"start": 2182.4, "end": 2184.64, "text": "为何又要劝我称帝了呢"}, {"start": 2188.77, "end": 2190.29, "text": "原来这个问题"}, {"start": 2191.33, "end": 2193.33, "text": "在主公心里压了两年"}, {"start": 2194.37, "end": 2195.89, "text": "主公为何不早点"}, {"start": 2197.93, "end": 2200.85, "text": "当年我劝主公不要称王"}, {"start": 2201.33, "end": 2203.01, "text": "是我过于谨慎"}, {"start": 2203.57, "end": 2205.85, "text": "我怕三军将士骄狂至弃"}, {"start": 2205.85, "end": 2207.09, "text": "因此而生"}, {"start": 2207.57, "end": 2208.41, "text": "而现在"}, {"start": 2208.81, "end": 2210.29, "text": "我劝主公称帝"}, {"start": 2210.53, "end": 2212.33, "text": "是不称不行啊"}, {"start": 2212.69, "end": 2214.09, "text": "如果主公不称帝"}, {"start": 2214.29, "end": 2215.33, "text": "那么天底下"}, {"start": 2215.37, "end": 2216.97, "text": "就只有一个皇帝"}, {"start": 2217.29, "end": 2218.29, "text": "曹匹"}, {"start": 2219.09, "end": 2221.09, "text": "因为汉庭已经不存在了"}, {"start": 2221.49, "end": 2223.45, "text": "主公如果避嫌取义"}, {"start": 2223.81, "end": 2224.85, "text": "不敬帝位"}, {"start": 2225.17, "end": 2226.45, "text": "那么久而久之"}, {"start": 2226.77, "end": 2228.65, "text": "四海渴望建功立业的"}, {"start": 2228.65, "end": 2229.89, "text": "有才之事"}, {"start": 2230.33, "end": 2233.17, "text": "恐怕就要投奔曹匹了"}, {"start": 2238.82, "end": 2241.34, "text": "曹操手握雄兵"}, {"start": 2243.33, "end": 2245.37, "text": "挟天子令诸侯"}, {"start": 2246.73, "end": 2248.29, "text": "驰骋天下"}, {"start": 2248.77, "end": 2249.73, "text": "直到死"}, {"start": 2250.69, "end": 2252.73, "text": "却也不敢篡位称帝"}, {"start": 2252.89, "end": 2257.41, "text": "曹操并非不想做皇帝"}, {"start": 2258.61, "end": 2261.85, "text": "只是天不假年时机未到"}, {"start": 2262.25, "end": 2265.17, "text": "当时群雄并起四海沸腾"}, {"start": 2266.01, "end": 2268.05, "text": "他怕自己做了皇帝之后"}, {"start": 2268.05, "end": 2270.29, "text": "天下不知有几人称帝"}, {"start": 2270.29, "end": 2271.49, "text": "几人称王"}, {"start": 2271.97, "end": 2273.33, "text": "其中最恐惧的"}, {"start": 2273.65, "end": 2275.01, "text": "就是主公你了"}, {"start": 2275.89, "end": 2276.57, "text": "所以"}, {"start": 2276.97, "end": 2278.85, "text": "还不如大家都不要称帝"}, {"start": 2279.61, "end": 2280.81, "text": "因为他手中"}, {"start": 2280.93, "end": 2282.49, "text": "攥着傀儡天子"}, {"start": 2282.81, "end": 2283.93, "text": "运勇自如"}, {"start": 2284.65, "end": 2286.69, "text": "而如今汉氏已亡"}, {"start": 2286.85, "end": 2288.49, "text": "曹匹窃居帝位"}, {"start": 2288.85, "end": 2290.57, "text": "主公如想功夫汉氏"}, {"start": 2290.97, "end": 2292.25, "text": "就应该称帝"}, {"start": 2299.86, "end": 2302.02, "text": "我知道推祖再三"}, {"start": 2304.17, "end": 2305.61, "text": "实在是担心"}, {"start": 2306.13, "end": 2307.45, "text": "世人非异"}, {"start": 2307.73, "end": 2311.09, "text": "明不正则言不顺"}, {"start": 2311.25, "end": 2312.97, "text": "主公如果是名正言顺"}, {"start": 2312.97, "end": 2314.05, "text": "有何可疑"}, {"start": 2314.49, "end": 2315.33, "text": "殊不知"}, {"start": 2315.57, "end": 2316.69, "text": "天欲浮起"}, {"start": 2317.05, "end": 2318.33, "text": "反受其咎"}, {"start": 2340.02, "end": 2341.26, "text": "主公也没变"}, {"start": 2344.86, "end": 2348.1, "text": "罢了"}, {"start": 2348.54, "end": 2351.89, "text": "我还有一个顾虑"}, {"start": 2352.29, "end": 2355.33, "text": "劝我进位的"}, {"start": 2355.85, "end": 2358.61, "text": "都是随我入川的老将旧部"}, {"start": 2359.41, "end": 2361.29, "text": "蜀中归乡来的文物们"}, {"start": 2361.29, "end": 2362.05, "text": "怎么想"}, {"start": 2363.29, "end": 2364.45, "text": "主公说的是"}, {"start": 2364.93, "end": 2366.33, "text": "李炎 黄泉他们吧"}, {"start": 2366.49, "end": 2367.81, "text": "蜀中旧臣"}, {"start": 2367.97, "end": 2369.01, "text": "不可不律"}, {"start": 2369.77, "end": 2370.57, "text": "因为"}, {"start": 2371.65, "end": 2372.41, "text": "这里"}, {"start": 2372.93, "end": 2374.53, "text": "先是他们的家"}, {"start": 2375.61, "end": 2376.49, "text": "后来"}, {"start": 2377.21, "end": 2378.41, "text": "被我们占了"}, {"start": 2378.93, "end": 2380.41, "text": "成了我们的家"}, {"start": 2394.33, "end": 2395.81, "text": "在下迎后来迟"}, {"start": 2395.81, "end": 2397.37, "text": "请主公恕罪"}, {"start": 2399.21, "end": 2400.41, "text": "我只是路过"}, {"start": 2400.41, "end": 2401.33, "text": "口渴了"}, {"start": 2401.65, "end": 2403.45, "text": "顺道讨杯茶喝"}, {"start": 2403.69, "end": 2404.45, "text": "主公请"}, {"start": 2404.69, "end": 2428.58, "text": "我听说中平某年"}, {"start": 2429.22, "end": 2430.58, "text": "蜀中大旱"}, {"start": 2432.06, "end": 2433.58, "text": "这巷子里的人"}, {"start": 2433.98, "end": 2435.82, "text": "渴死了十支三四"}, {"start": 2437.69, "end": 2439.45, "text": "是你召集族人"}, {"start": 2439.69, "end": 2441.09, "text": "用了粤语时间"}, {"start": 2441.37, "end": 2442.25, "text": "在这府中"}, {"start": 2442.25, "end": 2444.21, "text": "打了一口白齿深井"}, {"start": 2444.45, "end": 2446.17, "text": "救了一巷子的百姓"}, {"start": 2447.98, "end": 2449.94, "text": "这水入口干裂"}, {"start": 2450.06, "end": 2451.14, "text": "不同寻常"}, {"start": 2452.46, "end": 2454.86, "text": "就是去滋那口井吧"}, {"start": 2456.06, "end": 2458.46, "text": "主公也知道此事了"}, {"start": 2459.3, "end": 2460.3, "text": "所以呀"}, {"start": 2461.14, "end": 2462.86, "text": "我要来讨杯茶吃"}, {"start": 2467.23, "end": 2468.83, "text": "恕在下直言"}, {"start": 2469.75, "end": 2471.83, "text": "主公不是为了"}, {"start": 2471.95, "end": 2481.02, "text": "就讨这杯茶水吧"}, {"start": 2481.22, "end": 2482.42, "text": "我是来问你"}, {"start": 2482.42, "end": 2485.19, "text": "蜀中"}, {"start": 2485.19, "end": 2487.55, "text": "该往何处去"}]