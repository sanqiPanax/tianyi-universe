[{"start": 13.52, "end": 15.52, "text": "主公 外面有一位来客"}, {"start": 15.52, "end": 17.52, "text": "自称是主公旧游许忧"}, {"start": 17.52, "end": 19.52, "text": "请求拜见主公"}, {"start": 19.52, "end": 21.52, "text": "许忧"}, {"start": 21.52, "end": 23.52, "text": "是袁绍帐下的许忧吗"}, {"start": 23.52, "end": 25.52, "text": "在下不知"}, {"start": 25.52, "end": 27.52, "text": "那人只说主公应该记得当年偷鸡宰鹅之事"}, {"start": 27.52, "end": 31.5, "text": "传邪啊主公"}, {"start": 31.5, "end": 38.05, "text": "传邪啊主公"}, {"start": 38.05, "end": 40.05, "text": "快快"}, {"start": 40.05, "end": 42.05, "text": "南洋故人许忧"}, {"start": 42.05, "end": 44.05, "text": "叩见蒙德公"}, {"start": 44.05, "end": 46.05, "text": "真的是你啊"}, {"start": 46.05, "end": 48.05, "text": "啊"}, {"start": 48.05, "end": 51.81, "text": "你怎么会到这儿来呢"}, {"start": 51.81, "end": 53.81, "text": "袁绍不能相容"}, {"start": 53.81, "end": 55.81, "text": "我如再不来投"}, {"start": 55.81, "end": 57.81, "text": "恐性命难保望"}, {"start": 59.81, "end": 61.81, "text": "这是天上掉下一座金山呀"}, {"start": 61.81, "end": 63.81, "text": "我的兄台相助"}, {"start": 63.81, "end": 65.81, "text": "大事可成"}, {"start": 65.81, "end": 67.81, "text": "收我一拜"}, {"start": 67.81, "end": 69.81, "text": "不敢不敢"}, {"start": 69.81, "end": 73.95, "text": "蒙德兄请起"}, {"start": 73.95, "end": 75.95, "text": "蒙德兄"}, {"start": 75.95, "end": 77.95, "text": "高义啊"}, {"start": 77.95, "end": 79.95, "text": "望临相迎"}, {"start": 79.95, "end": 81.95, "text": "卓时令在下"}, {"start": 81.95, "end": 83.95, "text": "受宠若敬"}, {"start": 83.95, "end": 85.95, "text": "见到你许忧"}, {"start": 85.95, "end": 87.95, "text": "我岂能不得已忘形啊"}, {"start": 87.95, "end": 89.95, "text": "走走走"}, {"start": 89.95, "end": 112.37, "text": "进去说话"}, {"start": 112.37, "end": 114.37, "text": "说说吧"}, {"start": 114.37, "end": 116.37, "text": "为何来投啊"}, {"start": 116.37, "end": 118.37, "text": "今日"}, {"start": 118.37, "end": 120.37, "text": "我曾给袁绍献一击"}, {"start": 120.37, "end": 122.37, "text": "让他集四十万大军"}, {"start": 122.37, "end": 124.37, "text": "分作两路"}, {"start": 124.37, "end": 126.37, "text": "一路十万人马"}, {"start": 126.37, "end": 128.37, "text": "仰攻你的大营"}, {"start": 128.37, "end": 130.37, "text": "另一路集三十万精兵"}, {"start": 130.37, "end": 132.37, "text": "进去徐昌"}, {"start": 132.37, "end": 134.37, "text": "我告诉袁绍"}, {"start": 134.37, "end": 136.37, "text": "无论这两路人马哪一路能够得手"}, {"start": 136.37, "end": 138.37, "text": "你曹蒙德都将大败"}, {"start": 138.37, "end": 140.37, "text": "袁绍果真如此用兵"}, {"start": 140.37, "end": 142.37, "text": "我必亡"}, {"start": 142.37, "end": 144.37, "text": "可惜啊"}, {"start": 144.37, "end": 146.37, "text": "忠言逆耳"}, {"start": 146.37, "end": 148.37, "text": "雍主非但不听"}, {"start": 148.37, "end": 150.37, "text": "反而要记下我这颗相上的头颅"}, {"start": 150.37, "end": 152.37, "text": "留作他"}, {"start": 152.37, "end": 154.37, "text": "日后问罪"}, {"start": 154.37, "end": 156.37, "text": "梁臣侍庸主真乃人生"}, {"start": 156.37, "end": 158.37, "text": "莫大的痛苦"}, {"start": 158.37, "end": 160.37, "text": "如此妙计"}, {"start": 160.37, "end": 162.37, "text": "袁绍怎么会不用呢"}, {"start": 162.37, "end": 164.37, "text": "袁绍他认为你诡计多端"}, {"start": 164.37, "end": 166.37, "text": "你连堂堂的"}, {"start": 166.37, "end": 168.37, "text": "大汗天子都能用来"}, {"start": 168.37, "end": 170.37, "text": "行骗"}, {"start": 170.37, "end": 172.37, "text": "岂不会设下伏兵"}, {"start": 172.37, "end": 174.37, "text": "诱使我们去偷袭"}, {"start": 176.37, "end": 178.37, "text": "世人都说我多疑"}, {"start": 178.37, "end": 180.37, "text": "看来还有人比我更"}, {"start": 180.37, "end": 182.37, "text": "多疑"}, {"start": 182.37, "end": 184.37, "text": "你已经"}, {"start": 184.37, "end": 186.37, "text": "把他们给吓怕了"}, {"start": 188.37, "end": 190.37, "text": "恕徐悠之言"}, {"start": 190.37, "end": 192.37, "text": "其实你曹蒙德"}, {"start": 192.37, "end": 194.37, "text": "远没有那么强大"}, {"start": 194.37, "end": 196.37, "text": "可恰恰"}, {"start": 196.37, "end": 198.37, "text": "就是那些庸人心目中"}, {"start": 198.37, "end": 200.37, "text": "对你的恐惧"}, {"start": 200.37, "end": 202.37, "text": "不仅助长而且成就了"}, {"start": 202.37, "end": 204.37, "text": "你的强大"}, {"start": 204.37, "end": 208.26, "text": "精辟深刻"}, {"start": 208.26, "end": 210.26, "text": "除了你"}, {"start": 210.26, "end": 212.26, "text": "徐悠"}, {"start": 212.26, "end": 214.26, "text": "你也听不到这么精彩的报奖"}, {"start": 214.26, "end": 216.26, "text": "越是精辟之言"}, {"start": 216.26, "end": 218.26, "text": "就越有杀身之后"}, {"start": 218.26, "end": 221.76, "text": "实在是无奈了"}, {"start": 221.76, "end": 223.76, "text": "今天"}, {"start": 223.76, "end": 227.78, "text": "我才转头与你"}, {"start": 227.78, "end": 229.78, "text": "如蒙德兄不弃"}, {"start": 229.78, "end": 231.78, "text": "从今以后"}, {"start": 231.78, "end": 233.78, "text": "徐悠愿效全马之劳"}, {"start": 233.78, "end": 235.78, "text": "兄台啊"}, {"start": 235.78, "end": 237.78, "text": "你早就该来偷我了"}, {"start": 237.78, "end": 239.78, "text": "这天底下"}, {"start": 239.78, "end": 241.78, "text": "只有我能配得上你的"}, {"start": 241.78, "end": 243.78, "text": "满腹才华"}, {"start": 243.78, "end": 249.62, "text": "容我问你一事"}, {"start": 249.62, "end": 251.62, "text": "还望你能够"}, {"start": 251.62, "end": 253.62, "text": "如实相告"}, {"start": 253.62, "end": 255.62, "text": "你我现在已经是"}, {"start": 255.62, "end": 257.62, "text": "同舟共济我们是"}, {"start": 257.62, "end": 259.62, "text": "荣如与共的兄弟"}, {"start": 259.62, "end": 263.44, "text": "我任何事情都不会瞒你"}, {"start": 263.44, "end": 267.1, "text": "好 蒙德兄"}, {"start": 267.1, "end": 269.1, "text": "你军中的粮草"}, {"start": 269.1, "end": 273.86, "text": "尚可只剩多少时"}, {"start": 273.86, "end": 275.86, "text": "兄台果然是高人哪"}, {"start": 275.86, "end": 277.86, "text": "一问就问到我的痛处"}, {"start": 277.86, "end": 279.86, "text": "我此次出征"}, {"start": 279.86, "end": 281.86, "text": "原本带了百日军粮"}, {"start": 281.86, "end": 283.86, "text": "不料耗损巨大"}, {"start": 283.86, "end": 285.86, "text": "现在"}, {"start": 285.86, "end": 287.86, "text": "还有五十日呢"}, {"start": 289.86, "end": 291.86, "text": "未必吧"}, {"start": 291.86, "end": 293.86, "text": "我跟旁人是这么说的"}, {"start": 293.86, "end": 295.86, "text": "但是实际上"}, {"start": 295.86, "end": 297.86, "text": "还有一个月的"}, {"start": 297.86, "end": 301.2, "text": "可悲啊"}, {"start": 301.2, "end": 303.2, "text": "我徐悠冒死前来"}, {"start": 303.2, "end": 305.2, "text": "成心相投"}, {"start": 305.2, "end": 307.2, "text": "原以为是起暗投明啊"}, {"start": 309.2, "end": 311.2, "text": "可蒙德兄"}, {"start": 311.2, "end": 315.86, "text": "你根本不相信我呀"}, {"start": 319.86, "end": 321.86, "text": "兵法云"}, {"start": 321.86, "end": 326.45, "text": "兵不厌诈"}, {"start": 326.45, "end": 328.45, "text": "我跟你说了你可千万不要泄露出去"}, {"start": 328.45, "end": 330.45, "text": "免得乱了我的军心哪"}, {"start": 330.45, "end": 344.74, "text": "我目前"}, {"start": 344.74, "end": 346.74, "text": "曹蒙德啊曹蒙德"}, {"start": 346.74, "end": 348.74, "text": "难怪世人都说你是奸凶"}, {"start": 350.74, "end": 352.74, "text": "看来"}, {"start": 352.74, "end": 354.74, "text": "他们都太低俗了"}, {"start": 354.74, "end": 356.74, "text": "根本就不了解"}, {"start": 358.74, "end": 360.74, "text": "你是奸凶之祖"}, {"start": 362.74, "end": 364.74, "text": "古今无双 通前绝后"}, {"start": 364.74, "end": 366.74, "text": "曹蒙德"}, {"start": 366.74, "end": 368.74, "text": "你根本没有时日之良"}, {"start": 368.74, "end": 370.74, "text": "严重了"}, {"start": 370.74, "end": 372.74, "text": "我无非"}, {"start": 372.74, "end": 374.74, "text": "就是问了你军中粮草的事情"}, {"start": 374.74, "end": 376.74, "text": "可你前前后后"}, {"start": 376.74, "end": 378.74, "text": "转世之间"}, {"start": 378.74, "end": 380.74, "text": "就跟我撒了三次谎"}, {"start": 380.74, "end": 382.74, "text": "你根本就没有时日之良吧"}, {"start": 384.74, "end": 386.74, "text": "好吧"}, {"start": 386.74, "end": 388.74, "text": "什么事都瞒不过你"}, {"start": 388.74, "end": 390.74, "text": "那我就"}, {"start": 390.74, "end": 392.74, "text": "给你透个实情"}, {"start": 392.74, "end": 396.78, "text": "我现在"}, {"start": 396.78, "end": 400.74, "text": "还剩五日的粮草"}, {"start": 400.74, "end": 402.74, "text": "我正为此"}, {"start": 402.74, "end": 404.74, "text": "焦虑万分了"}, {"start": 404.74, "end": 406.74, "text": "曹蒙德"}, {"start": 406.74, "end": 408.74, "text": "莫非你还要骗我"}, {"start": 408.74, "end": 410.74, "text": "第四次吗"}, {"start": 410.74, "end": 412.74, "text": "此话怎讲"}, {"start": 412.74, "end": 414.74, "text": "你连隔日之粮都没有了"}, {"start": 414.74, "end": 416.74, "text": "你军中已经断粮了"}, {"start": 416.74, "end": 418.74, "text": "从明天开始"}, {"start": 418.74, "end": 420.74, "text": "你和你的军士"}, {"start": 420.74, "end": 428.18, "text": "将沙马冲击"}, {"start": 428.18, "end": 431.94, "text": "我截获了你"}, {"start": 431.94, "end": 433.94, "text": "崔耀军粮的军令"}, {"start": 433.94, "end": 435.94, "text": "袁绍知道吗"}, {"start": 435.94, "end": 437.94, "text": "知道"}, {"start": 437.94, "end": 439.94, "text": "可他知道有什么用"}, {"start": 439.94, "end": 441.94, "text": "他根本就不信"}, {"start": 441.94, "end": 443.94, "text": "他认定"}, {"start": 443.94, "end": 445.94, "text": "以你曹蒙德的精明"}, {"start": 445.94, "end": 447.94, "text": "绝不会在临战之际断粮"}, {"start": 447.94, "end": 449.94, "text": "他更不能相信"}, {"start": 449.94, "end": 451.94, "text": "如果你曹蒙德断了粮"}, {"start": 451.94, "end": 453.94, "text": "居然还不退兵"}, {"start": 453.94, "end": 455.94, "text": "他必然认定"}, {"start": 455.94, "end": 467.63, "text": "我现在军中只剩"}, {"start": 467.63, "end": 471.58, "text": "半日之粮"}, {"start": 471.58, "end": 473.58, "text": "我唯一的指望就是"}, {"start": 473.58, "end": 475.58, "text": "明天日落时分"}, {"start": 475.58, "end": 477.58, "text": "军粮能如期送到"}, {"start": 477.58, "end": 479.58, "text": "如果明日"}, {"start": 479.58, "end": 481.58, "text": "运不到呢"}, {"start": 481.58, "end": 483.58, "text": "蒙德"}, {"start": 483.58, "end": 485.58, "text": "若是我许忧"}, {"start": 485.58, "end": 487.58, "text": "送给你百万袋粮草"}, {"start": 487.58, "end": 492.85, "text": "你说什么"}, {"start": 492.85, "end": 494.85, "text": "蒙德兄"}, {"start": 494.85, "end": 496.85, "text": "那袁绍所有的"}, {"start": 496.85, "end": 498.85, "text": "所有的粮草"}, {"start": 498.85, "end": 500.85, "text": "全部囤于吴朝"}, {"start": 500.85, "end": 502.85, "text": "吴朝的守军相当薄弱"}, {"start": 502.85, "end": 504.85, "text": "守将纯于铜"}, {"start": 504.85, "end": 506.85, "text": "那是个九囊饭袋"}, {"start": 506.85, "end": 508.85, "text": "不堪重用"}, {"start": 508.85, "end": 510.85, "text": "如果蒙德兄"}, {"start": 510.85, "end": 512.85, "text": "你能亲率一支铁骑"}, {"start": 512.85, "end": 514.85, "text": "连夜杀奔吴朝"}, {"start": 514.85, "end": 516.85, "text": "一把火烧了他的资重"}, {"start": 516.85, "end": 518.85, "text": "援军势必大乱"}, {"start": 518.85, "end": 520.85, "text": "你也可顺势"}, {"start": 520.85, "end": 525.95, "text": "夺取你所需要的粮草"}, {"start": 525.95, "end": 536.34, "text": "我亲自率军前去"}, {"start": 536.34, "end": 538.34, "text": "我许忧"}, {"start": 538.34, "end": 540.34, "text": "说的是谎言"}, {"start": 540.34, "end": 542.34, "text": "你就不怕"}, {"start": 542.34, "end": 544.34, "text": "袁绍早已经在吴朝"}, {"start": 544.34, "end": 546.34, "text": "设下伏兵"}, {"start": 546.34, "end": 548.34, "text": "这个我不担心"}, {"start": 548.34, "end": 550.34, "text": "我不是袁绍"}, {"start": 550.34, "end": 552.34, "text": "更非庸主"}, {"start": 552.34, "end": 554.34, "text": "真的假的我闻得出来"}, {"start": 554.34, "end": 560.02, "text": "何以见得"}, {"start": 560.02, "end": 562.02, "text": "我一直苦思不解"}, {"start": 562.02, "end": 564.02, "text": "袁绍为何兵败了"}, {"start": 564.02, "end": 566.02, "text": "还不退军"}, {"start": 566.02, "end": 568.02, "text": "而且能在短短十几日之内"}, {"start": 568.02, "end": 570.02, "text": "就能重新召回几十万残军"}, {"start": 570.02, "end": 572.02, "text": "原来他手里"}, {"start": 572.02, "end": 574.02, "text": "有吃的"}, {"start": 574.02, "end": 576.02, "text": "残军不回营就得饿死"}, {"start": 576.02, "end": 578.02, "text": "其二"}, {"start": 578.02, "end": 580.02, "text": "你许忧"}, {"start": 580.02, "end": 582.02, "text": "深夜来偷我"}, {"start": 582.02, "end": 584.02, "text": "必有大礼相送"}, {"start": 584.02, "end": 586.02, "text": "兄台不愧是"}, {"start": 586.02, "end": 588.02, "text": "天下名主啊"}, {"start": 588.02, "end": 590.02, "text": "从今往后"}, {"start": 590.02, "end": 592.02, "text": "我若能服侍名主"}, {"start": 592.02, "end": 594.02, "text": "如同再造"}, {"start": 594.02, "end": 598.13, "text": "幸甚"}, {"start": 598.13, "end": 600.13, "text": "我灭了袁绍"}, {"start": 600.13, "end": 602.13, "text": "你是投功"}, {"start": 602.13, "end": 609.76, "text": "你打算何时"}, {"start": 609.76, "end": 611.76, "text": "启程啊"}, {"start": 611.76, "end": 613.76, "text": "事不宜迟"}, {"start": 613.76, "end": 615.76, "text": "我这就出发"}, {"start": 615.76, "end": 617.76, "text": "我会率猛将士员"}, {"start": 617.76, "end": 619.76, "text": "精气五千奔袭吴朝"}, {"start": 619.76, "end": 621.76, "text": "估计会在"}, {"start": 621.76, "end": 623.76, "text": "黎明时分到达"}, {"start": 623.76, "end": 625.76, "text": "好 如此甚好"}, {"start": 625.76, "end": 627.76, "text": "蒙德兄一定切记"}, {"start": 627.76, "end": 629.76, "text": "在你奔袭途中"}, {"start": 629.76, "end": 631.76, "text": "无与袁兵不必与其纠缠"}, {"start": 631.76, "end": 633.76, "text": "只需亮出袁军的旗号即可"}, {"start": 633.76, "end": 635.76, "text": "就称是后将军"}, {"start": 635.76, "end": 637.76, "text": "蒋骑的兵马"}, {"start": 637.76, "end": 639.76, "text": "是奉袁绍之命"}, {"start": 639.76, "end": 641.76, "text": "驰援吴朝的"}, {"start": 641.76, "end": 643.76, "text": "多谢兄台指教"}, {"start": 643.76, "end": 645.76, "text": "袁军的旗甲我倒是搅和了不少"}, {"start": 645.76, "end": 649.9, "text": "今晚正好可以用上"}, {"start": 649.9, "end": 651.9, "text": "我还是吃不准"}, {"start": 651.9, "end": 653.9, "text": "如果吴朝一旦火起"}, {"start": 653.9, "end": 657.7, "text": "袁绍会当如何"}, {"start": 657.7, "end": 659.7, "text": "袁绍定会"}, {"start": 659.7, "end": 661.7, "text": "火速派兵"}, {"start": 661.7, "end": 663.7, "text": "救援吴朝"}, {"start": 663.7, "end": 665.7, "text": "袁绍这个人"}, {"start": 665.7, "end": 667.7, "text": "平时虽然昏运"}, {"start": 667.7, "end": 669.7, "text": "可一旦盛名起来"}, {"start": 669.7, "end": 671.7, "text": "往往也能做出让人意外的事来"}, {"start": 671.7, "end": 673.7, "text": "他势必"}, {"start": 673.7, "end": 675.7, "text": "置吴朝于不顾"}, {"start": 675.7, "end": 677.7, "text": "集中所有兵马"}, {"start": 677.7, "end": 679.7, "text": "直扑你的大营"}, {"start": 679.7, "end": 681.7, "text": "他一定会认为"}, {"start": 681.7, "end": 683.7, "text": "你曹蒙德率清纪"}, {"start": 683.7, "end": 685.7, "text": "奔了吴朝"}, {"start": 685.7, "end": 687.7, "text": "你的大营势必空虚"}, {"start": 687.7, "end": 689.7, "text": "没错 还是兄台更了解袁绍"}, {"start": 689.7, "end": 691.7, "text": "所以在下建议"}, {"start": 691.7, "end": 693.7, "text": "兵马"}, {"start": 693.7, "end": 695.7, "text": "在大营之外设下伏击"}, {"start": 695.7, "end": 700.8, "text": "不 这样太简单了"}, {"start": 700.8, "end": 702.8, "text": "我会把我的空营丢给他"}, {"start": 702.8, "end": 704.8, "text": "静止去取他的关渡大营"}, {"start": 706.8, "end": 708.8, "text": "要知道袁绍的大营"}, {"start": 708.8, "end": 710.8, "text": "可比我的大营"}, {"start": 710.8, "end": 899.46, "text": "大多了"}, {"start": 928.56, "end": 930.56, "text": "王朝你夜袭吴朝"}, {"start": 930.56, "end": 932.56, "text": "我百万军粮毁于一具啊"}, {"start": 932.56, "end": 934.56, "text": "傅帅"}, {"start": 934.56, "end": 936.56, "text": "这曹子一定没有足远"}, {"start": 936.56, "end": 938.56, "text": "不如吴朝吧"}, {"start": 938.56, "end": 940.56, "text": "傅帅 吴朝粮线一旦被毁"}, {"start": 940.56, "end": 942.56, "text": "营中只剩三日军粮"}, {"start": 942.56, "end": 944.56, "text": "大军不能久迟啊"}, {"start": 944.56, "end": 946.56, "text": "不如挥尸追杀"}, {"start": 946.56, "end": 948.56, "text": "与曹操决一死战"}, {"start": 948.56, "end": 950.56, "text": "对 决一死战"}, {"start": 950.56, "end": 958.16, "text": "傅帅 傅帅"}, {"start": 958.16, "end": 961.79, "text": "慌什么"}, {"start": 961.79, "end": 963.79, "text": "不就是那几屯粮草吗"}, {"start": 963.79, "end": 965.79, "text": "我四十万大军"}, {"start": 965.79, "end": 967.79, "text": "聚在"}, {"start": 967.79, "end": 969.79, "text": "曹操奈何我也"}, {"start": 969.79, "end": 971.79, "text": "请傅帅下令"}, {"start": 971.79, "end": 975.1, "text": "如何应战"}, {"start": 975.1, "end": 979.25, "text": "你们想想"}, {"start": 979.25, "end": 981.25, "text": "吴朝有八千守军"}, {"start": 981.25, "end": 983.25, "text": "轻可见化为乌有"}, {"start": 983.25, "end": 985.25, "text": "这说明曹操的所有精锐"}, {"start": 985.25, "end": 990.9, "text": "都已经去奔起吴朝了"}, {"start": 990.9, "end": 992.9, "text": "曹操的大营空虚了"}, {"start": 992.9, "end": 994.9, "text": "没错"}, {"start": 994.9, "end": 996.9, "text": "传令"}, {"start": 996.9, "end": 998.9, "text": "请吴朝不顾"}, {"start": 998.9, "end": 1000.9, "text": "赶紧调集兵马"}, {"start": 1000.9, "end": 1002.9, "text": "由我亲自带领"}, {"start": 1002.9, "end": 1004.9, "text": "前往曹操大营"}, {"start": 1004.9, "end": 1054.48, "text": "遵命"}, {"start": 1054.48, "end": 1056.48, "text": "曹操 你中了我们的埋伏了"}, {"start": 1056.48, "end": 1058.48, "text": "快快下马受死"}, {"start": 1058.48, "end": 1060.48, "text": "弟兄们 放箭"}, {"start": 1060.48, "end": 1068.66, "text": "曹军有百"}, {"start": 1068.66, "end": 1103.14, "text": "吴朝臣我军不备 恭喜我军大营"}, {"start": 1103.14, "end": 1105.14, "text": "我们回不去了"}, {"start": 1105.14, "end": 1107.14, "text": "曹操 我和你不务共代替"}, {"start": 1107.14, "end": 1113.71, "text": "傅帅"}, {"start": 1113.71, "end": 1115.71, "text": "傅帅"}, {"start": 1115.71, "end": 1117.71, "text": "傅帅"}, {"start": 1117.71, "end": 1119.71, "text": "傅帅"}, {"start": 1119.71, "end": 1121.71, "text": "傅帅"}, {"start": 1121.71, "end": 1123.71, "text": "我们跟曹操决一死战"}, {"start": 1123.71, "end": 1125.71, "text": "决一死战吧傅帅"}, {"start": 1125.71, "end": 1140.93, "text": "传令吧傅帅"}, {"start": 1140.93, "end": 1146.16, "text": "傅帅"}, {"start": 1146.16, "end": 1150.3, "text": "撤军"}, {"start": 1150.3, "end": 1174.96, "text": "诺"}, {"start": 1174.96, "end": 1176.96, "text": "又想草了"}, {"start": 1176.96, "end": 1178.96, "text": "我们的吴朝被分"}, {"start": 1178.96, "end": 1180.96, "text": "大营丢失"}, {"start": 1180.96, "end": 1182.96, "text": "全是这个贼给害的"}, {"start": 1182.96, "end": 1190.14, "text": "高揽张合"}, {"start": 1190.14, "end": 1192.14, "text": "及诸位将士"}, {"start": 1192.14, "end": 1194.14, "text": "如等且听我一言"}, {"start": 1194.14, "end": 1197.52, "text": "你家主公袁绍"}, {"start": 1197.52, "end": 1199.52, "text": "生性幽柔寡断"}, {"start": 1199.52, "end": 1201.52, "text": "刚毕自用"}, {"start": 1201.52, "end": 1203.52, "text": "贤与不分中间不明"}, {"start": 1203.52, "end": 1205.52, "text": "似"}, {"start": 1205.52, "end": 1207.52, "text": "这等庸主"}, {"start": 1207.52, "end": 1209.52, "text": "安有不败之理乎"}, {"start": 1209.52, "end": 1211.52, "text": "还有"}, {"start": 1211.52, "end": 1213.52, "text": "他那三位公子"}, {"start": 1213.52, "end": 1215.52, "text": "元潭元兮元尚"}, {"start": 1215.52, "end": 1217.52, "text": "既无胸怀大志"}, {"start": 1217.52, "end": 1219.52, "text": "且自私贪婪"}, {"start": 1219.52, "end": 1221.52, "text": "为了争夺世子大位"}, {"start": 1221.52, "end": 1223.52, "text": "却忘了刚常礼"}, {"start": 1223.52, "end": 1225.52, "text": "不讲手足之情"}, {"start": 1225.52, "end": 1227.52, "text": "你争我夺"}, {"start": 1227.52, "end": 1229.52, "text": "勾心斗脚"}, {"start": 1229.52, "end": 1231.52, "text": "早晚必樊木成仇"}, {"start": 1231.52, "end": 1233.52, "text": "定有一场血光之灾"}, {"start": 1233.52, "end": 1235.52, "text": "尔等"}, {"start": 1235.52, "end": 1239.09, "text": "如果再千言不绝的话"}, {"start": 1241.09, "end": 1243.09, "text": "大难"}, {"start": 1243.09, "end": 1245.09, "text": "必将临头了"}, {"start": 1245.09, "end": 1247.09, "text": "古人云"}, {"start": 1247.09, "end": 1251.71, "text": "良亲择木而棋"}, {"start": 1251.71, "end": 1253.71, "text": "良臣择主而侍"}, {"start": 1255.71, "end": 1257.71, "text": "听我一言"}, {"start": 1257.71, "end": 1259.71, "text": "列位将军"}, {"start": 1259.71, "end": 1261.71, "text": "尔等还不如笑话"}, {"start": 1261.71, "end": 1263.71, "text": "尔等还不如效仿我许忧"}, {"start": 1263.71, "end": 1265.71, "text": "悬崖勒马"}, {"start": 1265.71, "end": 1267.71, "text": "当机立断"}, {"start": 1267.71, "end": 1269.71, "text": "弃暗投明"}, {"start": 1275.22, "end": 1277.22, "text": "大家想叛我吗"}, {"start": 1277.22, "end": 1281.01, "text": "如叛我"}, {"start": 1281.01, "end": 1283.01, "text": "现在就赐我一枪"}, {"start": 1283.01, "end": 1285.01, "text": "拿我的首级"}, {"start": 1285.01, "end": 1287.01, "text": "献给曹操"}, {"start": 1287.01, "end": 1296.46, "text": "领功去吧"}, {"start": 1296.46, "end": 1300.13, "text": "如不叛我"}, {"start": 1300.13, "end": 1302.13, "text": "我令你们立刻上山"}, {"start": 1302.13, "end": 1304.13, "text": "敢杀许勇"}, {"start": 1304.13, "end": 1306.13, "text": "主公啊"}, {"start": 1306.13, "end": 1308.13, "text": "这山上肯定有夫君"}, {"start": 1308.13, "end": 1310.13, "text": "此时上山"}, {"start": 1310.13, "end": 1312.13, "text": "等于是送死啊"}, {"start": 1312.13, "end": 1314.13, "text": "为将者"}, {"start": 1314.13, "end": 1321.57, "text": "岂能贪生怕死"}, {"start": 1321.57, "end": 1396.66, "text": "我令你们"}, {"start": 1396.66, "end": 1414.24, "text": "禀副帅"}, {"start": 1414.24, "end": 1417.9, "text": "不到"}, {"start": 1417.9, "end": 1419.9, "text": "三年前"}, {"start": 1419.9, "end": 1445.36, "text": "我率七十万大军出征"}, {"start": 1445.36, "end": 1447.36, "text": "却不到百次"}, {"start": 1447.36, "end": 1465.52, "text": "天诛曹不诛有爱"}, {"start": 1465.52, "end": 1467.52, "text": "主公"}, {"start": 1467.52, "end": 1489.97, "text": "他用了许忧之计"}, {"start": 1489.97, "end": 1491.97, "text": "先是烧了吴朝的粮草资重"}, {"start": 1491.97, "end": 1493.97, "text": "然后又攻取了元军的关渡大营"}, {"start": 1493.97, "end": 1495.97, "text": "元军一败再败"}, {"start": 1495.97, "end": 1497.97, "text": "百里战场"}, {"start": 1497.97, "end": 1499.97, "text": "血流成河"}, {"start": 1499.97, "end": 1501.97, "text": "尸骨成堆"}, {"start": 1501.97, "end": 1503.97, "text": "七十万元军不胜百计啊"}, {"start": 1503.97, "end": 1505.97, "text": "据说"}, {"start": 1505.97, "end": 1507.97, "text": "已经逃回冀州了"}, {"start": 1507.97, "end": 1509.97, "text": "七十万大军"}, {"start": 1509.97, "end": 1511.97, "text": "所胜不足百计"}, {"start": 1511.97, "end": 1515.92, "text": "是啊"}, {"start": 1515.92, "end": 1524.61, "text": "请问原本初"}, {"start": 1524.61, "end": 1526.61, "text": "本是首屈一指的霸主"}, {"start": 1526.61, "end": 1528.61, "text": "转眼之间"}, {"start": 1528.61, "end": 1530.61, "text": "竟沦落为"}, {"start": 1530.61, "end": 1532.61, "text": "藏寇了"}, {"start": 1532.61, "end": 1534.61, "text": "曹操"}, {"start": 1534.61, "end": 1536.61, "text": "极善用兵"}, {"start": 1536.61, "end": 1538.61, "text": "恐怕冀州城"}, {"start": 1538.61, "end": 1540.61, "text": "不久会被他攻陷"}, {"start": 1540.61, "end": 1542.61, "text": "这曹操"}, {"start": 1542.61, "end": 1544.61, "text": "既是奸贼"}, {"start": 1544.61, "end": 1546.61, "text": "又是熊主"}, {"start": 1546.61, "end": 1548.61, "text": "还是兵家"}, {"start": 1548.61, "end": 1550.61, "text": "与此人"}, {"start": 1550.61, "end": 1554.56, "text": "同时不知幸与不幸"}, {"start": 1554.56, "end": 1556.56, "text": "我们兵不过三千"}, {"start": 1556.56, "end": 1558.56, "text": "又无间可守"}, {"start": 1558.56, "end": 1560.56, "text": "此地不宜久留"}, {"start": 1560.56, "end": 1562.56, "text": "是啊"}, {"start": 1562.56, "end": 1564.56, "text": "我原想"}, {"start": 1564.56, "end": 1566.56, "text": "偷奔京州"}, {"start": 1566.56, "end": 1568.56, "text": "与刘表联手"}, {"start": 1568.56, "end": 1570.56, "text": "举兵抗草"}, {"start": 1570.56, "end": 1572.56, "text": "可是现在元少七十万大军"}, {"start": 1572.56, "end": 1574.56, "text": "几乎丧尽"}, {"start": 1574.56, "end": 1576.56, "text": "就不知道刘表"}, {"start": 1576.56, "end": 1578.56, "text": "还有没有抗草的胆识了"}, {"start": 1578.56, "end": 1580.56, "text": "刘表"}, {"start": 1580.56, "end": 1582.56, "text": "用兵三十万"}, {"start": 1582.56, "end": 1584.56, "text": "尤其是他的京州水兵"}, {"start": 1584.56, "end": 1586.56, "text": "号称天下无敌"}, {"start": 1586.56, "end": 1588.56, "text": "他为什么要惧怕曹操"}, {"start": 1588.56, "end": 1590.56, "text": "兵多有何用"}, {"start": 1590.56, "end": 1592.56, "text": "元少的兵少了"}, {"start": 1592.56, "end": 1596.8, "text": "临敌胜败"}, {"start": 1596.8, "end": 1598.8, "text": "少在统帅"}, {"start": 1598.8, "end": 1600.8, "text": "刘表身为人主"}, {"start": 1600.8, "end": 1602.8, "text": "坐领京乡九军"}, {"start": 1602.8, "end": 1604.8, "text": "十多年来却动也不动"}, {"start": 1604.8, "end": 1606.8, "text": "如果他有二弟一小颗胆子"}, {"start": 1606.8, "end": 1608.8, "text": "也就不容"}, {"start": 1608.8, "end": 1610.8, "text": "曹操像今天这本放肆了"}, {"start": 1610.8, "end": 1612.8, "text": "这刘表"}, {"start": 1612.8, "end": 1614.8, "text": "既然没有胆识"}, {"start": 1614.8, "end": 1616.8, "text": "那主公准备偷和出去"}, {"start": 1616.8, "end": 1618.8, "text": "刘表虽无胆识"}, {"start": 1618.8, "end": 1620.8, "text": "但毕竟是贤良方正之主"}, {"start": 1620.8, "end": 1622.8, "text": "又是皇室宗族"}, {"start": 1622.8, "end": 1628.03, "text": "我想当下之计"}, {"start": 1628.03, "end": 1630.03, "text": "也只能赞透刘表"}, {"start": 1630.03, "end": 1632.03, "text": "戏图后续"}, {"start": 1632.03, "end": 1635.63, "text": "不过这需要有一位"}, {"start": 1635.63, "end": 1637.63, "text": "大胆善言之人"}, {"start": 1637.63, "end": 1639.63, "text": "先去探一探刘表的口风"}, {"start": 1639.63, "end": 1641.63, "text": "看看人家"}, {"start": 1641.63, "end": 1646.19, "text": "愿不愿意收容我"}, {"start": 1646.19, "end": 1648.19, "text": "主公"}, {"start": 1648.19, "end": 1650.19, "text": "在下愿意出使京州"}, {"start": 1650.19, "end": 1656.86, "text": "孙乾愿望"}, {"start": 1656.86, "end": 1658.86, "text": "再合适不过了"}, {"start": 1658.86, "end": 1678.21, "text": "遵命"}, {"start": 1678.21, "end": 1680.21, "text": "参军孙乾奉主公之命"}, {"start": 1680.21, "end": 1682.21, "text": "拜见民公"}, {"start": 1682.21, "end": 1684.21, "text": "好 请起来吧"}, {"start": 1684.21, "end": 1687.62, "text": "谢民公"}, {"start": 1687.62, "end": 1689.62, "text": "听说刘备仍然健在人间"}, {"start": 1689.62, "end": 1691.62, "text": "我深感欣慰"}, {"start": 1691.62, "end": 1693.62, "text": "如今"}, {"start": 1693.62, "end": 1695.62, "text": "在中原大地上"}, {"start": 1695.62, "end": 1697.62, "text": "能够逃出曹孟德虎口的"}, {"start": 1697.62, "end": 1699.62, "text": "虎口的英雄豪杰"}, {"start": 1699.62, "end": 1701.62, "text": "已经为数不多了"}, {"start": 1701.62, "end": 1703.62, "text": "民公说得极是"}, {"start": 1703.62, "end": 1705.62, "text": "我主不仅逃出了曹操的虎口"}, {"start": 1705.62, "end": 1707.62, "text": "而且还要"}, {"start": 1707.62, "end": 1709.62, "text": "与虎相搏"}, {"start": 1709.62, "end": 1711.62, "text": "刘备起兵多年"}, {"start": 1711.62, "end": 1713.62, "text": "屡战屡败"}, {"start": 1713.62, "end": 1715.62, "text": "恐怕"}, {"start": 1715.62, "end": 1717.62, "text": "不是曹操的对手吧"}, {"start": 1717.62, "end": 1719.62, "text": "与其说"}, {"start": 1719.62, "end": 1721.62, "text": "屡战屡败"}, {"start": 1721.62, "end": 1723.62, "text": "不如说屡败屡战"}, {"start": 1723.62, "end": 1725.62, "text": "只要我主一息尚存"}, {"start": 1725.62, "end": 1727.62, "text": "就要扫除逆贼"}, {"start": 1727.62, "end": 1729.62, "text": "匡扶汉室"}, {"start": 1729.62, "end": 1731.62, "text": "民公也是皇亲后裔"}, {"start": 1731.62, "end": 1733.62, "text": "身上也流淌着"}, {"start": 1733.62, "end": 1735.62, "text": "高祖的鲜血"}, {"start": 1735.62, "end": 1737.62, "text": "民公对我主的志向"}, {"start": 1737.62, "end": 1739.62, "text": "就不以为然吗"}, {"start": 1739.62, "end": 1741.62, "text": "可敬可佩"}, {"start": 1743.62, "end": 1745.62, "text": "刘备差你来做什么"}, {"start": 1745.62, "end": 1747.62, "text": "是要借兵"}, {"start": 1747.62, "end": 1749.62, "text": "借粮"}, {"start": 1749.62, "end": 1751.62, "text": "还是要"}, {"start": 1751.62, "end": 1753.62, "text": "借城市啊"}, {"start": 1753.62, "end": 1755.62, "text": "我主对民公一无所求"}, {"start": 1755.62, "end": 1757.62, "text": "他只想"}, {"start": 1757.62, "end": 1761.41, "text": "相助民公"}, {"start": 1761.41, "end": 1764.75, "text": "助我"}, {"start": 1764.75, "end": 1766.75, "text": "怎样助我呀"}, {"start": 1766.75, "end": 1768.75, "text": "民公汉贼不两立"}, {"start": 1768.75, "end": 1770.75, "text": "王爷不偏安哪"}, {"start": 1770.75, "end": 1772.75, "text": "曹操绝不甘心做一个丞相"}, {"start": 1772.75, "end": 1774.75, "text": "他志在篡汉自立"}, {"start": 1774.75, "end": 1776.75, "text": "袁绍兵败后"}, {"start": 1776.75, "end": 1778.75, "text": "曹操的下一个战略目标"}, {"start": 1778.75, "end": 1780.75, "text": "就是靖州"}, {"start": 1780.75, "end": 1782.75, "text": "民公大敌当前"}, {"start": 1782.75, "end": 1784.75, "text": "战祸不远啊"}, {"start": 1784.75, "end": 1786.75, "text": "并民公"}, {"start": 1786.75, "end": 1788.75, "text": "我主兵马虽不多"}, {"start": 1788.75, "end": 1790.75, "text": "但是愿意率领关羽 张飞 赵云"}, {"start": 1790.75, "end": 1792.75, "text": "三位当事勇猛豪杰"}, {"start": 1792.75, "end": 1794.75, "text": "在曹操来犯之时"}, {"start": 1794.75, "end": 1796.75, "text": "做民公的先锋"}, {"start": 1796.75, "end": 1798.75, "text": "助民公灭曹贼成大业"}, {"start": 1798.75, "end": 1800.75, "text": "安天下"}, {"start": 1800.75, "end": 1802.75, "text": "刘备和我"}, {"start": 1802.75, "end": 1804.75, "text": "同是皇室后裔"}, {"start": 1804.75, "end": 1806.75, "text": "在这乱世之时"}, {"start": 1806.75, "end": 1808.75, "text": "我们更应该相互扶持"}, {"start": 1808.75, "end": 1810.75, "text": "共复国难才是"}, {"start": 1810.75, "end": 1812.75, "text": "你告诉刘备"}, {"start": 1812.75, "end": 1813.75, "text": "就说"}, {"start": 1813.75, "end": 1823.46, "text": "主公"}, {"start": 1823.46, "end": 1825.46, "text": "哦 这样吧"}, {"start": 1825.46, "end": 1827.46, "text": "你先下去歇息"}, {"start": 1827.46, "end": 1829.46, "text": "待会我让刘齐"}, {"start": 1829.46, "end": 1831.46, "text": "为你白酒洗尘"}, {"start": 1831.46, "end": 1834.77, "text": "在下告退"}, {"start": 1834.77, "end": 1842.69, "text": "有话就说"}, {"start": 1842.69, "end": 1844.69, "text": "主公"}, {"start": 1844.69, "end": 1846.69, "text": "刘备是个灾星啊"}, {"start": 1846.69, "end": 1848.69, "text": "刘备现在兵危剑寡"}, {"start": 1848.69, "end": 1850.69, "text": "无一做成俊可以攻他立足"}, {"start": 1850.69, "end": 1852.69, "text": "又惨遭曹操追杀"}, {"start": 1852.69, "end": 1854.69, "text": "他是在走投无路之下"}, {"start": 1854.69, "end": 1856.69, "text": "才到主公这来求个存身之处"}, {"start": 1856.69, "end": 1857.69, "text": "主公"}, {"start": 1857.69, "end": 1859.69, "text": "我们万万不可被他利用"}, {"start": 1859.69, "end": 1861.69, "text": "如果一拟"}, {"start": 1861.69, "end": 1863.69, "text": "怎么办才算妥当呢"}, {"start": 1863.69, "end": 1865.69, "text": "眼下曹操势力滔天"}, {"start": 1865.69, "end": 1867.69, "text": "无人可敌"}, {"start": 1867.69, "end": 1869.69, "text": "但他对刘备却恨之入骨"}, {"start": 1869.69, "end": 1873.32, "text": "我们不如斩了使者"}, {"start": 1873.32, "end": 1875.32, "text": "将手机送给曹操"}, {"start": 1875.32, "end": 1877.32, "text": "以表明主公拒留何操之意"}, {"start": 1877.32, "end": 1878.32, "text": "如此一来"}, {"start": 1878.32, "end": 1880.32, "text": "曹操定然欢喜"}, {"start": 1880.32, "end": 1882.32, "text": "也绝不会向荆州发兵了"}, {"start": 1882.32, "end": 1886.5, "text": "你看呢"}, {"start": 1886.5, "end": 1888.5, "text": "副帅"}, {"start": 1888.5, "end": 1890.5, "text": "而认为蔡将军所言"}, {"start": 1890.5, "end": 1892.5, "text": "误国误主"}, {"start": 1892.5, "end": 1894.5, "text": "早晚会断送荆州"}, {"start": 1894.5, "end": 1896.5, "text": "公子言过了吧"}, {"start": 1896.5, "end": 1898.5, "text": "副帅与刘备同为黄金地州"}, {"start": 1898.5, "end": 1899.5, "text": "血脉相连"}, {"start": 1899.5, "end": 1901.5, "text": "如今刘备失穷来头"}, {"start": 1901.5, "end": 1903.5, "text": "想要与副帅共敌曹操"}, {"start": 1903.5, "end": 1906.5, "text": "我们完全可以隐为荆州之助啊"}, {"start": 1906.5, "end": 1909.5, "text": "但副帅竟然要把来世给杀了"}, {"start": 1909.5, "end": 1911.5, "text": "这事要是传扬出去"}, {"start": 1911.5, "end": 1914.5, "text": "世人如何看待副帅"}, {"start": 1914.5, "end": 1917.5, "text": "副帅又如何立足于天下呀"}, {"start": 1917.5, "end": 1918.5, "text": "刘备投吕布则吕布网"}, {"start": 1918.5, "end": 1920.5, "text": "投袁绍则袁绍败"}, {"start": 1920.5, "end": 1922.5, "text": "前车之鉴后事之师"}, {"start": 1922.5, "end": 1925.5, "text": "主公千万三思啊"}, {"start": 1925.5, "end": 1926.5, "text": "蔡将军言过了吧"}, {"start": 1926.5, "end": 1928.5, "text": "吕布至晓性贪"}, {"start": 1928.5, "end": 1930.5, "text": "袁绍闲遇不分须有其名"}, {"start": 1930.5, "end": 1931.5, "text": "吕元都是败给曹操"}, {"start": 1931.5, "end": 1933.5, "text": "而不是刘备"}, {"start": 1933.5, "end": 1934.5, "text": "再说"}, {"start": 1934.5, "end": 1936.5, "text": "我副帅又不是吕布袁绍等人"}, {"start": 1936.5, "end": 1940.16, "text": "副帅非但不会被刘备所用"}, {"start": 1940.16, "end": 1943.16, "text": "相反却能用刘备"}, {"start": 1943.16, "end": 1944.16, "text": "主公"}, {"start": 1944.16, "end": 1946.16, "text": "副帅"}, {"start": 1946.16, "end": 1947.16, "text": "好"}, {"start": 1947.16, "end": 1950.44, "text": "让孙乾上来吧"}, {"start": 1950.44, "end": 1974.43, "text": "孙乾上堂"}, {"start": 1974.43, "end": 1977.38, "text": "孙乾哪"}, {"start": 1977.38, "end": 1979.38, "text": "你看"}, {"start": 1979.38, "end": 1981.38, "text": "我这里有个盒子"}, {"start": 1981.38, "end": 1984.38, "text": "原先是装塔叶用的"}, {"start": 1984.38, "end": 1986.38, "text": "现在"}, {"start": 1986.38, "end": 1989.38, "text": "有人建议我取下你的头颅"}, {"start": 1989.38, "end": 1991.38, "text": "装在这个盒子里"}, {"start": 1991.38, "end": 1992.38, "text": "献与曹操"}, {"start": 1992.38, "end": 1994.38, "text": "以表明我"}, {"start": 1994.38, "end": 1996.38, "text": "拒留和曹之意"}, {"start": 1996.38, "end": 1999.38, "text": "保荆州太平"}, {"start": 1999.38, "end": 2004.46, "text": "你觉得这个主意怎么样"}, {"start": 2007.46, "end": 2008.46, "text": "明公"}, {"start": 2008.46, "end": 2010.46, "text": "你在砍下这个头颅之前"}, {"start": 2010.46, "end": 2012.46, "text": "还在征求这个头颅的意见"}, {"start": 2012.46, "end": 2015.46, "text": "真可谓是贤民之君"}, {"start": 2015.46, "end": 2017.46, "text": "多谢"}, {"start": 2017.46, "end": 2019.46, "text": "见听则明"}, {"start": 2019.46, "end": 2021.46, "text": "我总是不止下问"}, {"start": 2021.46, "end": 2023.46, "text": "如果在下这颗头颅"}, {"start": 2023.46, "end": 2025.46, "text": "能够换得荆州的太平"}, {"start": 2025.46, "end": 2026.46, "text": "那太值了"}, {"start": 2026.46, "end": 2029.46, "text": "在下也建议明公砍了去"}, {"start": 2029.46, "end": 2032.46, "text": "可是曹操何需人也"}, {"start": 2032.46, "end": 2036.46, "text": "曹操能为这区区博理而动心吗"}, {"start": 2036.46, "end": 2038.46, "text": "如果在下是曹操"}, {"start": 2038.46, "end": 2039.46, "text": "看到这颗头颅"}, {"start": 2039.46, "end": 2042.46, "text": "一定会开怀大笑"}, {"start": 2044.46, "end": 2047.46, "text": "我还没向荆州用兵"}, {"start": 2047.46, "end": 2051.46, "text": "刘景升就下得送颗人头来"}, {"start": 2051.46, "end": 2053.46, "text": "如果我挥师东进"}, {"start": 2053.46, "end": 2056.46, "text": "刘景升还不下得开城启祥吗"}, {"start": 2056.46, "end": 2057.46, "text": "如果曹操准备"}, {"start": 2057.46, "end": 2059.46, "text": "明年攻打荆州"}, {"start": 2059.46, "end": 2061.46, "text": "在下的人头一到"}, {"start": 2061.46, "end": 2064.46, "text": "曹操定会提前攻去荆州"}, {"start": 2064.46, "end": 2065.46, "text": "看了在下"}, {"start": 2065.46, "end": 2067.46, "text": "非但保不住荆州的太平"}, {"start": 2067.46, "end": 2069.46, "text": "而且会惹祸上身"}, {"start": 2069.46, "end": 2070.46, "text": "明公"}, {"start": 2070.46, "end": 2074.46, "text": "你用一颗头颅换来两个强敌"}, {"start": 2076.46, "end": 2078.46, "text": "那第二个强敌是谁"}, {"start": 2081.46, "end": 2082.46, "text": "明公怎会不知"}, {"start": 2082.46, "end": 2085.46, "text": "正是我主刘备"}, {"start": 2085.46, "end": 2088.46, "text": "你杀了刘备特意派来联谊的使者"}, {"start": 2088.46, "end": 2089.46, "text": "让他在众人面前"}, {"start": 2089.46, "end": 2091.46, "text": "饱受耻辱痛不可当"}, {"start": 2091.46, "end": 2093.46, "text": "试问明公刘备"}, {"start": 2093.46, "end": 2095.46, "text": "不会和你拼命吗"}, {"start": 2099.46, "end": 2104.46, "text": "想不到刘备在刘王之中"}, {"start": 2104.46, "end": 2109.46, "text": "身边还跟随着你这样的义序"}, {"start": 2109.46, "end": 2112.46, "text": "我主刘备身边义士众多"}, {"start": 2112.46, "end": 2114.46, "text": "除了关羽 张飞 赵云之外"}, {"start": 2114.46, "end": 2117.46, "text": "还有周沧 芈芳 简雍等等等等"}, {"start": 2117.46, "end": 2120.46, "text": "怎么也得数到五十位之后"}, {"start": 2120.46, "end": 2123.46, "text": "才能数到我区区孙前"}, {"start": 2124.46, "end": 2126.46, "text": "回刘皇叔"}, {"start": 2126.46, "end": 2129.46, "text": "请他尽快来荆州"}, {"start": 2129.46, "end": 2131.46, "text": "我会大排一仗"}, {"start": 2131.46, "end": 2133.46, "text": "出城相迎"}, {"start": 2133.46, "end": 2139.69, "text": "在下领命"}, {"start": 2139.69, "end": 2154.87, "text": "屡败之将刘备"}, {"start": 2154.87, "end": 2157.87, "text": "深谢景升皇兄收容之"}, {"start": 2157.87, "end": 2158.87, "text": "宣德啊"}, {"start": 2158.87, "end": 2160.87, "text": "你鲜明扬天下"}, {"start": 2160.87, "end": 2162.87, "text": "我是仰慕已久"}, {"start": 2162.87, "end": 2163.87, "text": "从今日起"}, {"start": 2163.87, "end": 2165.87, "text": "景升兄有何差遣"}, {"start": 2165.87, "end": 2167.87, "text": "宣德定当消灭"}, {"start": 2167.87, "end": 2169.87, "text": "不敢当 不敢当"}, {"start": 2169.87, "end": 2171.87, "text": "来 我给你介绍一下"}, {"start": 2171.87, "end": 2174.87, "text": "这是长子刘齐"}, {"start": 2174.87, "end": 2176.87, "text": "次子刘从"}, {"start": 2176.87, "end": 2178.87, "text": "拜见刘皇叔"}, {"start": 2178.87, "end": 2180.87, "text": "真是英雄初少年"}, {"start": 2180.87, "end": 2182.87, "text": "景升兄这两位龙虎公子"}, {"start": 2182.87, "end": 2184.87, "text": "实在是让人羡慕"}, {"start": 2184.87, "end": 2186.87, "text": "宣德 请入城"}, {"start": 2186.87, "end": 2187.87, "text": "明公请"}, {"start": 2187.87, "end": 2188.87, "text": "请"}, {"start": 2188.87, "end": 2193.18, "text": "五年多来"}, {"start": 2193.18, "end": 2196.18, "text": "我刘备可以说是日夜不宁"}, {"start": 2196.18, "end": 2199.18, "text": "每念及天子密授血诏"}, {"start": 2199.18, "end": 2201.18, "text": "都有如万箭穿心"}, {"start": 2201.18, "end": 2203.18, "text": "痛不可当"}, {"start": 2203.18, "end": 2206.18, "text": "我刘备上不能承天负寒"}, {"start": 2206.18, "end": 2208.18, "text": "下不能手刃奸贼"}, {"start": 2208.18, "end": 2211.18, "text": "虽然是东征西逃"}, {"start": 2211.18, "end": 2214.18, "text": "却是屡战屡败"}, {"start": 2214.18, "end": 2216.18, "text": "愧对天子"}, {"start": 2216.18, "end": 2218.18, "text": "愧对苍生"}, {"start": 2218.18, "end": 2220.18, "text": "先帝之大"}, {"start": 2220.18, "end": 2224.18, "text": "当然就有天大的烦恼"}, {"start": 2224.18, "end": 2226.18, "text": "于兄至小"}, {"start": 2226.18, "end": 2231.18, "text": "因此也就牵挂也少"}, {"start": 2231.18, "end": 2234.18, "text": "我只想独守一郁"}, {"start": 2234.18, "end": 2237.18, "text": "保荆州太平"}, {"start": 2237.18, "end": 2239.18, "text": "恕在下直言"}, {"start": 2239.18, "end": 2243.18, "text": "曹操是个百年不遇的奸凶"}, {"start": 2243.18, "end": 2247.18, "text": "其权谋 兵略 淫威 罢属"}, {"start": 2247.18, "end": 2250.18, "text": "据可以说又狠又毒"}, {"start": 2250.18, "end": 2253.52, "text": "自邪天子令诸侯开始"}, {"start": 2253.52, "end": 2255.52, "text": "篡汉自立的野心"}, {"start": 2255.52, "end": 2257.52, "text": "可为路人皆知"}, {"start": 2257.52, "end": 2260.52, "text": "明公乃汉皇后仪"}, {"start": 2260.52, "end": 2262.52, "text": "世寿国恩"}, {"start": 2262.52, "end": 2265.52, "text": "岂能坐视曹贼篡国呢"}, {"start": 2265.52, "end": 2266.52, "text": "更何况"}, {"start": 2266.52, "end": 2269.52, "text": "曹操他早就对荆州"}, {"start": 2269.52, "end": 2270.52, "text": "垂涎三尺了"}, {"start": 2270.52, "end": 2271.52, "text": "下一步"}, {"start": 2271.52, "end": 2272.52, "text": "下一步"}, {"start": 2272.52, "end": 2273.52, "text": "下一步"}, {"start": 2273.52, "end": 2276.52, "text": "定会向荆州用兵"}, {"start": 2276.52, "end": 2278.52, "text": "依你所料"}, {"start": 2278.52, "end": 2281.52, "text": "我应该怎么办"}, {"start": 2281.52, "end": 2283.52, "text": "高清亡起"}, {"start": 2283.52, "end": 2285.52, "text": "召集天下之士"}, {"start": 2285.52, "end": 2289.12, "text": "举兵伐草"}, {"start": 2289.12, "end": 2293.59, "text": "只怕现在时机还不到吧"}, {"start": 2293.59, "end": 2294.59, "text": "明公"}, {"start": 2294.59, "end": 2297.59, "text": "你正逢其时啊"}, {"start": 2297.59, "end": 2299.59, "text": "袁绍虽然兵败"}, {"start": 2299.59, "end": 2302.59, "text": "但有如百族大宠"}, {"start": 2302.59, "end": 2303.59, "text": "死而不僵"}, {"start": 2303.59, "end": 2305.59, "text": "他手下仍有残兵二三十万"}, {"start": 2305.59, "end": 2308.59, "text": "凶狙在济青幽等州"}, {"start": 2308.59, "end": 2310.59, "text": "图谋东山再起呀"}, {"start": 2310.59, "end": 2313.59, "text": "曹操想跟除袁绍"}, {"start": 2313.59, "end": 2315.59, "text": "此时正在攻打济州"}, {"start": 2315.59, "end": 2316.59, "text": "战事震撼"}, {"start": 2316.59, "end": 2319.59, "text": "但我料不到半年至一年的工夫"}, {"start": 2319.59, "end": 2321.59, "text": "他根本无法彻底消灭袁绍"}, {"start": 2321.59, "end": 2322.59, "text": "明公"}, {"start": 2322.59, "end": 2326.59, "text": "此时你若率一支近旅"}, {"start": 2326.59, "end": 2328.59, "text": "奔袭曹操首辅许昌"}, {"start": 2328.59, "end": 2330.59, "text": "定可大获成功啊"}, {"start": 2330.59, "end": 2336.43, "text": "奔赴许昌"}, {"start": 2337.43, "end": 2339.43, "text": "贤德啊"}, {"start": 2339.43, "end": 2342.43, "text": "我把话跟你说明了吧"}, {"start": 2342.43, "end": 2346.43, "text": "我已经连过六巡"}, {"start": 2346.43, "end": 2349.43, "text": "既无在诸侯中称霸之志"}, {"start": 2349.43, "end": 2355.43, "text": "更没有争夺天下之心"}, {"start": 2355.43, "end": 2358.43, "text": "我主掌金香九郡之地"}, {"start": 2358.43, "end": 2361.43, "text": "已经有十几年了"}, {"start": 2361.43, "end": 2363.43, "text": "这里的一草一木木"}, {"start": 2363.43, "end": 2365.43, "text": "一山一水"}, {"start": 2365.43, "end": 2367.43, "text": "一村一镇"}, {"start": 2367.43, "end": 2369.43, "text": "一兵一民"}, {"start": 2369.43, "end": 2372.43, "text": "都是我苦心栽培出来的"}, {"start": 2372.43, "end": 2378.54, "text": "荆州背衣群山"}, {"start": 2378.54, "end": 2380.54, "text": "足踏长江"}, {"start": 2380.54, "end": 2382.54, "text": "甲士三十万"}, {"start": 2382.54, "end": 2385.54, "text": "战船五千艘"}, {"start": 2385.54, "end": 2387.54, "text": "我握有这些"}, {"start": 2387.54, "end": 2389.54, "text": "坚守一方太平"}, {"start": 2389.54, "end": 2391.54, "text": "足矣吧"}, {"start": 2391.54, "end": 2393.54, "text": "曹操"}, {"start": 2394.54, "end": 2396.54, "text": "凭他那北方战绩"}, {"start": 2396.54, "end": 2398.54, "text": "休想灭我"}, {"start": 2398.54, "end": 2401.54, "text": "我靠我的水军战船"}, {"start": 2401.54, "end": 2404.54, "text": "也灭不了曹操"}, {"start": 2404.54, "end": 2406.54, "text": "因此"}, {"start": 2406.54, "end": 2411.54, "text": "双方都应该明智一些"}, {"start": 2411.54, "end": 2415.91, "text": "听了明公这一番话"}, {"start": 2415.91, "end": 2419.26, "text": "在下十分欣慰"}, {"start": 2419.26, "end": 2424.08, "text": "请尽此中以表敬意"}, {"start": 2424.08, "end": 2429.52, "text": "我虽然没有争夺天下之心"}, {"start": 2430.52, "end": 2433.52, "text": "却真心失意的"}, {"start": 2433.52, "end": 2436.52, "text": "想要以重于你"}, {"start": 2436.52, "end": 2438.52, "text": "请明公吩咐"}, {"start": 2438.52, "end": 2442.52, "text": "不管曹操是否真向荆州用兵"}, {"start": 2442.52, "end": 2445.52, "text": "我都要做好御敌的准备"}, {"start": 2445.52, "end": 2451.22, "text": "我想拨出一座城池"}, {"start": 2451.22, "end": 2453.22, "text": "明教新野"}, {"start": 2453.22, "end": 2455.22, "text": "共你驻军"}, {"start": 2455.22, "end": 2459.22, "text": "帮助我共举曹操"}, {"start": 2459.22, "end": 2463.22, "text": "听你那官长召三员虎将"}, {"start": 2463.22, "end": 2467.22, "text": "足可令曹军丧打"}, {"start": 2468.22, "end": 2470.22, "text": "当然了"}, {"start": 2470.22, "end": 2474.22, "text": "你需要的军械粮草"}, {"start": 2474.22, "end": 2477.22, "text": "完全由我共举"}, {"start": 2477.22, "end": 2479.22, "text": "行吗"}, {"start": 2479.22, "end": 2485.95, "text": "在下遵命"}]