[{"start": 0.69, "end": 146.14, "text": "宁甘宝贝啊,你可让我想死了啊!"}, {"start": 148.83, "end": 149.83, "text": "放开我!"}, {"start": 149.83, "end": 150.83, "text": "你!"}, {"start": 150.83, "end": 158.43, "text": "你不喜欢咱家?"}, {"start": 158.43, "end": 166.11, "text": "相国不是答应奴婢要做贵妃吗?"}, {"start": 166.11, "end": 170.11, "text": "怎么把奴婢,怎么把奴婢抬到这儿来了?"}, {"start": 170.11, "end": 175.94, "text": "这,这霉物比皇宫是好多了,"}, {"start": 175.94, "end": 178.94, "text": "霉物是人间天堂啊!"}, {"start": 179.94, "end": 189.11, "text": "霉物虽好,可是相国,相国毕竟不是天子。"}, {"start": 189.11, "end": 194.11, "text": "你既然已经答应了奴婢,就不该食言的。"}, {"start": 194.11, "end": 200.11, "text": "宁甘啊,咱家跟你说实话吧。"}, {"start": 200.11, "end": 202.11, "text": "那天子是什么呀?"}, {"start": 202.11, "end": 208.11, "text": "天子就是咱们养的一个掌上之物,徒有虚名。"}, {"start": 208.11, "end": 211.11, "text": "咱家是谁呀?咱家是尚父。"}, {"start": 211.11, "end": 213.11, "text": "尚父是什么,你知道吗?"}, {"start": 213.11, "end": 218.11, "text": "尚父,他是天子的主子,是天子的爹。"}, {"start": 218.11, "end": 221.11, "text": "宁甘啊,你,"}, {"start": 221.11, "end": 224.11, "text": "与其伺候那个徒有虚名的天子,"}, {"start": 224.11, "end": 229.11, "text": "倒不如伺候伺候天子他爹。"}, {"start": 230.11, "end": 232.11, "text": "你,你弄疼我了。"}, {"start": 234.11, "end": 236.11, "text": "好好好,弄疼你了。"}, {"start": 236.11, "end": 240.11, "text": "宝贝啊,我向你赔罪呀。"}, {"start": 245.11, "end": 250.11, "text": "你听我说,以后你就住在这。"}, {"start": 251.11, "end": 255.11, "text": "咱家要让你想尽天下之乐,"}, {"start": 255.11, "end": 259.11, "text": "咱家要把天下所有的珍惜宝物全都送给你。"}, {"start": 259.11, "end": 262.11, "text": "没事呢,你给我唱个小曲。"}, {"start": 263.11, "end": 268.87, "text": "不知相国想听什么曲子?"}, {"start": 268.87, "end": 275.87, "text": "我最爱听那个,那个叫暖意温香,抱满怀,离魂到天外。"}, {"start": 275.87, "end": 278.87, "text": "这句我是最爱听了。"}, {"start": 279.87, "end": 283.87, "text": "奴婢,这就去卸妆更衣准备。"}, {"start": 283.87, "end": 288.87, "text": "更衣?更衣好,更衣好。"}, {"start": 288.87, "end": 292.87, "text": "不过你可要快着点啊,咱家等着你。"}, {"start": 292.87, "end": 294.87, "text": "来人哪,在。"}, {"start": 294.87, "end": 296.87, "text": "侧候小姐更衣。"}, {"start": 296.87, "end": 297.87, "text": "诺。"}, {"start": 297.87, "end": 345.7, "text": "为了兴汉,灭贼,非如此不可呀。"}, {"start": 346.7, "end": 353.7, "text": "女儿,我求你了,求你为大汉献身哪。"}, {"start": 353.7, "end": 367.86, "text": "心肝宝贝,你快着点啊,咱家都等不及了。"}, {"start": 367.86, "end": 371.21, "text": "来了。"}, {"start": 371.21, "end": 406.98, "text": "将军,为何独坐在此?"}, {"start": 407.98, "end": 412.51, "text": "此刻上朝也太早了吧?"}, {"start": 412.51, "end": 417.72, "text": "我不是上朝,我想见貂蝉。"}, {"start": 417.72, "end": 421.72, "text": "见貂蝉?干嘛坐这儿啊?"}, {"start": 421.72, "end": 427.09, "text": "这儿离貂蝉近一些。"}, {"start": 428.09, "end": 436.54, "text": "老夫直言,貂蝉根本就不在皇宫里。"}, {"start": 436.54, "end": 443.34, "text": "那它在哪儿?"}, {"start": 443.34, "end": 446.34, "text": "将军,你还不知道啊,"}, {"start": 446.34, "end": 452.34, "text": "昨夜出耕时分,貂蝉就被抬进了梅雾,"}, {"start": 452.34, "end": 458.55, "text": "伺候相国大人去了。"}, {"start": 458.55, "end": 460.55, "text": "梅雾?"}, {"start": 460.55, "end": 462.55, "text": "老夫担心哪。"}, {"start": 462.55, "end": 464.55, "text": "担心什么?"}, {"start": 464.55, "end": 467.55, "text": "快说你担心什么?"}, {"start": 467.55, "end": 472.55, "text": "老夫担心的是,既然貂蝉被抬进了梅雾,"}, {"start": 472.55, "end": 476.55, "text": "它就伤了相国的凤塔牙床了。"}, {"start": 476.55, "end": 486.23, "text": "我万万不信!"}, {"start": 486.23, "end": 497.3, "text": "相国他亲口跟我说过,天子。"}, {"start": 497.3, "end": 504.4, "text": "相国不但跟将军这么说过,"}, {"start": 504.4, "end": 508.4, "text": "跟百官也是这么说的。"}, {"start": 508.4, "end": 510.4, "text": "否则的话,"}, {"start": 510.4, "end": 516.4, "text": "相国怎么能够堂堂正正地把貂蝉抬走呢?"}, {"start": 516.4, "end": 520.4, "text": "这事让人万难相信。"}, {"start": 521.4, "end": 524.4, "text": "不过刚才我碰上了内廷侍奉,"}, {"start": 524.4, "end": 526.4, "text": "他亲口跟我说,"}, {"start": 526.4, "end": 530.4, "text": "昨天夜里就是他亲手提着灯笼,"}, {"start": 530.4, "end": 535.4, "text": "把貂蝉做的工匠引入梅雾的。"}, {"start": 535.4, "end": 554.2, "text": "亲手?老亲手?"}, {"start": 554.2, "end": 563.58, "text": "小女本该是将军的爱妻,"}, {"start": 563.58, "end": 567.58, "text": "可相国却借着天子的名义,"}, {"start": 567.58, "end": 570.58, "text": "强占了将军的爱妻。"}, {"start": 570.58, "end": 574.58, "text": "这种事也确实近乎禽兽。"}, {"start": 574.58, "end": 580.93, "text": "万一传扬出去,相国自然不在意。"}, {"start": 580.93, "end": 584.93, "text": "可将军你怎么做人呢?"}, {"start": 584.93, "end": 590.84, "text": "将军,你要干什么去?"}, {"start": 590.84, "end": 636.88, "text": "你怎么了这是?"}, {"start": 636.88, "end": 638.88, "text": "再躺一会儿。"}, {"start": 638.88, "end": 644.88, "text": "相国,相国,您该早朝了。"}, {"start": 644.88, "end": 646.88, "text": "你看看,你看看。"}, {"start": 647.88, "end": 650.88, "text": "我都不急,你急什么呢?"}, {"start": 650.88, "end": 653.88, "text": "来来来,再躺一会儿。"}, {"start": 655.88, "end": 657.88, "text": "我去梳妆。"}, {"start": 658.88, "end": 662.88, "text": "梳妆,梳妆好啊,梳妆好。"}, {"start": 760.88, "end": 761.88, "text": "冯夕!"}, {"start": 761.88, "end": 770.26, "text": "冯夕,你干什么?"}, {"start": 770.26, "end": 786.94, "text": "我来请相国上朝。"}, {"start": 786.94, "end": 791.6, "text": "这样,既然如此,"}, {"start": 791.6, "end": 794.6, "text": "那你暂且到宫外等候。"}, {"start": 794.6, "end": 797.6, "text": "记住,今后没有我的命令,"}, {"start": 797.6, "end": 803.25, "text": "不许到我的寝宫来。"}, {"start": 803.25, "end": 840.02, "text": "遵命。"}, {"start": 840.02, "end": 842.02, "text": "冯夕,冯夕,"}, {"start": 842.02, "end": 845.02, "text": "为何如此惊慌啊?"}, {"start": 845.02, "end": 847.02, "text": "不急,慢慢说。"}, {"start": 847.02, "end": 851.94, "text": "相国他占了貂蝉。"}, {"start": 851.94, "end": 856.21, "text": "那貂蝉与你有什么关系?"}, {"start": 856.21, "end": 863.24, "text": "就和貂蝉定情,"}, {"start": 863.24, "end": 865.24, "text": "相悦白头到老,"}, {"start": 865.24, "end": 873.96, "text": "生死与共,"}, {"start": 873.96, "end": 876.96, "text": "给天子丽妃为名,"}, {"start": 876.96, "end": 884.67, "text": "把貂蝉借到梅屋来了。"}, {"start": 884.67, "end": 886.67, "text": "冯夕呢,冯夕,"}, {"start": 886.67, "end": 888.67, "text": "你已经贵为公侯了。"}, {"start": 888.67, "end": 890.67, "text": "什么样的女人没有啊?"}, {"start": 890.67, "end": 892.67, "text": "区区一个貂蝉只剩啊,"}, {"start": 892.67, "end": 894.67, "text": "何至于此伤感呢?"}, {"start": 894.67, "end": 895.67, "text": "不,"}, {"start": 895.67, "end": 902.38, "text": "那是我的命根子。"}, {"start": 902.38, "end": 904.38, "text": "冯夕呢,"}, {"start": 904.38, "end": 906.38, "text": "恕我斗胆问一句,"}, {"start": 906.38, "end": 909.38, "text": "如果你得不到貂蝉,"}, {"start": 909.38, "end": 924.78, "text": "你将会怎样?"}, {"start": 924.78, "end": 926.78, "text": "臣斗胆借言,"}, {"start": 926.78, "end": 929.78, "text": "还是把那貂蝉赏还给吕布吧。"}, {"start": 929.78, "end": 931.78, "text": "此刻,"}, {"start": 931.78, "end": 932.78, "text": "天下未定,"}, {"start": 932.78, "end": 935.78, "text": "相国仍需将士用命。"}, {"start": 935.78, "end": 937.78, "text": "相国欲夺天下的话,"}, {"start": 937.78, "end": 939.78, "text": "必须笼络住吕布,"}, {"start": 939.78, "end": 941.78, "text": "让他驰骋疆场,"}, {"start": 941.78, "end": 943.78, "text": "攻城拔寨。"}, {"start": 943.78, "end": 945.78, "text": "只有这样,"}, {"start": 945.78, "end": 951.78, "text": "相国才能成就大业呀。"}, {"start": 951.78, "end": 953.78, "text": "吕布啊,"}, {"start": 953.78, "end": 954.78, "text": "他要什么,"}, {"start": 954.78, "end": 956.78, "text": "咱家都可以给他。"}, {"start": 956.78, "end": 958.78, "text": "唯独这个貂蝉,"}, {"start": 958.78, "end": 959.78, "text": "你要知道,"}, {"start": 959.78, "end": 962.78, "text": "貂蝉是人间极品,"}, {"start": 962.78, "end": 965.78, "text": "咱家舍不得。"}, {"start": 965.78, "end": 967.78, "text": "请相国斟酌,"}, {"start": 967.78, "end": 968.78, "text": "万一,"}, {"start": 968.78, "end": 970.78, "text": "吕布怒而背反,"}, {"start": 970.78, "end": 972.78, "text": "甚至投奔袁绍,"}, {"start": 972.78, "end": 974.78, "text": "与我们为敌的话,"}, {"start": 974.78, "end": 975.78, "text": "那,"}, {"start": 975.78, "end": 978.78, "text": "可就大失去业呀。"}, {"start": 978.78, "end": 981.78, "text": "我是吕布的义父,"}, {"start": 982.78, "end": 985.78, "text": "我对他不薄,"}, {"start": 985.78, "end": 989.78, "text": "他对我也是忠心耿耿,"}, {"start": 989.78, "end": 992.78, "text": "他怎会因此女而背我呀?"}, {"start": 992.78, "end": 994.78, "text": "敢问相国,"}, {"start": 994.78, "end": 1000.95, "text": "丁元是怎么死的?"}, {"start": 1000.95, "end": 1003.95, "text": "相国你只用了一匹赤兔马,"}, {"start": 1003.95, "end": 1005.95, "text": "就收得吕布前来归顺,"}, {"start": 1005.95, "end": 1007.95, "text": "不但如此,"}, {"start": 1007.95, "end": 1010.95, "text": "吕布居然为了这匹赤兔马,"}, {"start": 1010.95, "end": 1015.95, "text": "还亲手杀了自己的义父丁元。"}, {"start": 1015.95, "end": 1016.95, "text": "那么现在,"}, {"start": 1016.95, "end": 1018.95, "text": "吕布为了貂蝉,"}, {"start": 1018.95, "end": 1020.95, "text": "又会做出何等事来?"}, {"start": 1020.95, "end": 1023.95, "text": "貂蝉与赤兔马相比,"}, {"start": 1023.95, "end": 1025.95, "text": "孰重孰轻,"}, {"start": 1025.95, "end": 1028.95, "text": "大业与一个粉带油雾相比,"}, {"start": 1028.95, "end": 1030.95, "text": "何者当取,"}, {"start": 1030.95, "end": 1084.33, "text": "何者当弃呀?"}, {"start": 1084.33, "end": 1088.33, "text": "你可真是个仙人啊,"}, {"start": 1088.33, "end": 1093.33, "text": "咱家是越看越爱看。"}, {"start": 1107.96, "end": 1111.82, "text": "心肝儿啊,"}, {"start": 1111.82, "end": 1115.82, "text": "咱家今天跟你说个事。"}, {"start": 1115.82, "end": 1130.58, "text": "相国请讲。"}, {"start": 1130.58, "end": 1140.05, "text": "吕布想要你,"}, {"start": 1140.05, "end": 1142.05, "text": "虽说吕布是我的义子,"}, {"start": 1142.05, "end": 1145.05, "text": "又是天下第一勇夫,"}, {"start": 1145.05, "end": 1147.05, "text": "我思来想去啊,"}, {"start": 1147.05, "end": 1149.05, "text": "既然他对你是这样的,"}, {"start": 1149.05, "end": 1151.05, "text": "放心不下,"}, {"start": 1151.05, "end": 1155.05, "text": "我就成人之美,"}, {"start": 1155.05, "end": 1158.05, "text": "把你赏给他。"}, {"start": 1158.05, "end": 1162.58, "text": "你们两个在一起,"}, {"start": 1162.58, "end": 1165.58, "text": "不但是郎才女貌,"}, {"start": 1165.58, "end": 1167.58, "text": "也是情投意合。"}, {"start": 1167.58, "end": 1169.58, "text": "将来定然是,"}, {"start": 1169.58, "end": 1171.58, "text": "如鱼得水,"}, {"start": 1171.58, "end": 1175.15, "text": "如胶似漆。"}, {"start": 1175.15, "end": 1186.91, "text": "你说是不是?"}, {"start": 1186.91, "end": 1188.91, "text": "你,你怎么了?"}, {"start": 1188.91, "end": 1198.78, "text": "奴婢没做错什么吧?"}, {"start": 1198.78, "end": 1203.76, "text": "昨天相国,"}, {"start": 1203.76, "end": 1205.76, "text": "还对奴婢宠爱有加,"}, {"start": 1205.76, "end": 1207.76, "text": "可是今天,"}, {"start": 1207.76, "end": 1210.76, "text": "却要将奴婢转送给别人。"}, {"start": 1210.76, "end": 1216.98, "text": "奴婢还不如相国,"}, {"start": 1216.98, "end": 1219.98, "text": "喜欢的一个物价。"}, {"start": 1219.98, "end": 1221.98, "text": "你这说的什么话?"}, {"start": 1221.98, "end": 1223.98, "text": "我,"}, {"start": 1223.98, "end": 1227.98, "text": "我就是想提出来和你商量商量嘛。"}, {"start": 1227.98, "end": 1233.92, "text": "本以为,"}, {"start": 1233.92, "end": 1236.92, "text": "相国是真心对奴婢好,"}, {"start": 1236.92, "end": 1238.92, "text": "奴婢,"}, {"start": 1238.92, "end": 1241.92, "text": "也愿意侍奉相国一辈子,"}, {"start": 1241.92, "end": 1247.76, "text": "可是相国,"}, {"start": 1247.76, "end": 1250.76, "text": "却要将奴婢转送给一个下人。"}, {"start": 1250.76, "end": 1254.3, "text": "相国,"}, {"start": 1254.3, "end": 1257.3, "text": "你还是赐奴婢一死吧,"}, {"start": 1257.3, "end": 1260.3, "text": "以免侮辱了相国之尊。"}, {"start": 1260.3, "end": 1264.82, "text": "我这心肝啊,"}, {"start": 1264.82, "end": 1270.02, "text": "你看,"}, {"start": 1270.02, "end": 1272.02, "text": "我呀,"}, {"start": 1272.02, "end": 1274.02, "text": "我跟你说吧,"}, {"start": 1274.02, "end": 1276.02, "text": "其实我呀,"}, {"start": 1276.02, "end": 1280.02, "text": "从心里头不愿意放你走啊,"}, {"start": 1280.02, "end": 1282.02, "text": "真的,"}, {"start": 1282.02, "end": 1284.02, "text": "我舍不得你呀。"}, {"start": 1284.02, "end": 1286.02, "text": "来来来,"}, {"start": 1286.02, "end": 1288.02, "text": "宝贝,"}, {"start": 1288.02, "end": 1292.71, "text": "宝贝啊,"}, {"start": 1292.71, "end": 1295.71, "text": "咱家还想跟你呀,"}, {"start": 1295.71, "end": 1300.98, "text": "白头到老,"}, {"start": 1300.98, "end": 1303.98, "text": "富贵终生。"}, {"start": 1303.98, "end": 1305.98, "text": "相国骗人。"}, {"start": 1305.98, "end": 1308.98, "text": "我怎么能骗你呢?"}, {"start": 1308.98, "end": 1310.98, "text": "既然如此,"}, {"start": 1310.98, "end": 1313.98, "text": "为何要将我许配给吕将军?"}, {"start": 1313.98, "end": 1316.98, "text": "莫不是,"}, {"start": 1316.98, "end": 1319.98, "text": "莫不是你怕他不成?"}, {"start": 1319.98, "end": 1322.98, "text": "我,我怕他?"}, {"start": 1322.98, "end": 1325.98, "text": "他是我干儿子。"}, {"start": 1325.98, "end": 1327.98, "text": "既然不怕,"}, {"start": 1327.98, "end": 1330.98, "text": "还要将我许配给他。"}, {"start": 1330.98, "end": 1332.98, "text": "当今天下,"}, {"start": 1332.98, "end": 1334.98, "text": "谁人不知谁人不晓,"}, {"start": 1334.98, "end": 1337.98, "text": "连天子都要尽让你三分,"}, {"start": 1337.98, "end": 1339.98, "text": "可是你,"}, {"start": 1339.98, "end": 1342.98, "text": "连自己的爱妻都留不住。"}, {"start": 1342.98, "end": 1344.98, "text": "这要是传出去了,"}, {"start": 1344.98, "end": 1347.98, "text": "外面的人会怎么想你?"}, {"start": 1347.98, "end": 1350.98, "text": "你岂不成了,"}, {"start": 1350.98, "end": 1353.98, "text": "成了宫亲大臣的笑柄?"}, {"start": 1353.98, "end": 1356.98, "text": "嗯,嗯。"}, {"start": 1356.98, "end": 1358.98, "text": "对,说得对。"}, {"start": 1358.98, "end": 1360.98, "text": "哎呀,咱家糊涂了。"}, {"start": 1360.98, "end": 1362.98, "text": "你放心,"}, {"start": 1362.98, "end": 1365.98, "text": "咱家绝不把你让给别人。"}, {"start": 1365.98, "end": 1368.98, "text": "你永不分离。"}, {"start": 1371.98, "end": 1373.98, "text": "相国,"}, {"start": 1373.98, "end": 1376.98, "text": "到时辰该上朝了。"}, {"start": 1376.98, "end": 1380.77, "text": "上朝?这..."}, {"start": 1380.77, "end": 1383.77, "text": "哦,上朝,上朝。"}, {"start": 1383.77, "end": 1397.01, "text": "相国复朝!"}, {"start": 1397.01, "end": 1405.47, "text": "义父。"}, {"start": 1405.47, "end": 1407.47, "text": "奉献,"}, {"start": 1407.47, "end": 1417.5, "text": "随义父走走。"}, {"start": 1417.5, "end": 1418.5, "text": "是。"}, {"start": 1418.5, "end": 1420.5, "text": "奉献,"}, {"start": 1420.5, "end": 1422.5, "text": "带你如何呀?"}, {"start": 1422.5, "end": 1426.36, "text": "义父待我情义深重,"}, {"start": 1426.36, "end": 1428.36, "text": "恩同在造。"}, {"start": 1428.36, "end": 1429.36, "text": "记着,"}, {"start": 1429.36, "end": 1431.36, "text": "咱家早晚要改朝换代,"}, {"start": 1431.36, "end": 1432.36, "text": "继大魏,"}, {"start": 1432.36, "end": 1435.36, "text": "那个时候咱家定和你共享天下。"}, {"start": 1435.36, "end": 1437.36, "text": "还有,咱家七下无子,"}, {"start": 1437.36, "end": 1440.36, "text": "你就是我的亲儿子。"}, {"start": 1440.36, "end": 1442.36, "text": "咱家继位之后,"}, {"start": 1442.36, "end": 1445.36, "text": "第一件事就是要立你为太子。"}, {"start": 1445.36, "end": 1447.36, "text": "咱家百年之后,"}, {"start": 1447.36, "end": 1448.36, "text": "天下就是你的,"}, {"start": 1448.36, "end": 1450.36, "text": "大魏就是你的。"}, {"start": 1450.36, "end": 1453.95, "text": "谢义父。"}, {"start": 1453.95, "end": 1458.54, "text": "咱们父子俩,"}, {"start": 1458.54, "end": 1460.54, "text": "你说你谢什么谢?"}, {"start": 1464.54, "end": 1465.54, "text": "哦,对了。"}, {"start": 1465.54, "end": 1467.54, "text": "在继位之前,"}, {"start": 1467.54, "end": 1470.54, "text": "咱家得抬举抬举你。"}, {"start": 1470.54, "end": 1473.54, "text": "比如说朝廷中大将军这个位置,"}, {"start": 1473.54, "end": 1475.54, "text": "一直是空缺逮捕,"}, {"start": 1475.54, "end": 1477.54, "text": "咱家早就有意于你。"}, {"start": 1477.54, "end": 1479.54, "text": "但是恐怕西梁军众将不服,"}, {"start": 1479.54, "end": 1481.54, "text": "特别是李雀郭司二将。"}, {"start": 1481.54, "end": 1483.54, "text": "他们说你年轻气盛,"}, {"start": 1483.54, "end": 1484.54, "text": "不堪大任。"}, {"start": 1484.54, "end": 1488.54, "text": "都要和你争这个大将军的位置。"}, {"start": 1488.54, "end": 1490.54, "text": "末将不敢相争。"}, {"start": 1490.54, "end": 1495.3, "text": "咱家决定,"}, {"start": 1495.3, "end": 1498.3, "text": "拜你为朝廷的大将军,"}, {"start": 1498.3, "end": 1501.3, "text": "统管天下所有兵马。"}, {"start": 1501.3, "end": 1505.5, "text": "谢义父大恩。"}, {"start": 1505.5, "end": 1507.5, "text": "吕布肝脑涂地,"}, {"start": 1507.5, "end": 1508.5, "text": "难以回报。"}, {"start": 1508.5, "end": 1509.5, "text": "哎呀,"}, {"start": 1509.5, "end": 1510.5, "text": "快起来快起来,"}, {"start": 1510.5, "end": 1512.5, "text": "快起来快起来。"}, {"start": 1517.9, "end": 1520.62, "text": "义父。"}, {"start": 1520.62, "end": 1522.62, "text": "你还有什么事吗?"}, {"start": 1522.62, "end": 1523.62, "text": "没有就好。"}, {"start": 1523.62, "end": 1535.82, "text": "没有就好。"}, {"start": 1535.82, "end": 1536.82, "text": "没有就好。"}, {"start": 1538.82, "end": 1548.25, "text": "禀相国,"}, {"start": 1548.25, "end": 1550.25, "text": "季州牧韩复,"}, {"start": 1550.25, "end": 1553.25, "text": "近日与袁绍交恶。"}, {"start": 1553.25, "end": 1555.25, "text": "他上表朝廷,"}, {"start": 1555.25, "end": 1558.25, "text": "要求天子下诏讨贼。"}, {"start": 1558.25, "end": 1560.25, "text": "好啊。"}, {"start": 1560.25, "end": 1563.25, "text": "那就赐他一诏。"}, {"start": 1563.25, "end": 1567.25, "text": "卓他奉诏剿灭袁绍。"}, {"start": 1567.25, "end": 1569.25, "text": "他如是胜了,"}, {"start": 1569.25, "end": 1571.25, "text": "咱家就再赐他。"}, {"start": 1571.25, "end": 1573.25, "text": "再赐他三郡之地。"}, {"start": 1573.25, "end": 1575.25, "text": "臣遵命。"}, {"start": 1575.25, "end": 1577.25, "text": "上月以来,"}, {"start": 1577.25, "end": 1580.25, "text": "曹操在青衍二州,"}, {"start": 1580.25, "end": 1585.25, "text": "连续剿灭了五路黄金乱军。"}, {"start": 1585.25, "end": 1589.25, "text": "得祥族二十余万,"}, {"start": 1589.25, "end": 1592.25, "text": "号称青州兵,"}, {"start": 1592.25, "end": 1595.25, "text": "声势一大。"}, {"start": 1595.25, "end": 1596.25, "text": "哎呀呀呀,"}, {"start": 1596.25, "end": 1598.25, "text": "这个曹阿满,"}, {"start": 1598.25, "end": 1600.25, "text": "是越发了得了。"}, {"start": 1600.25, "end": 1604.56, "text": "咱家得想法子收拢他才好。"}, {"start": 1604.56, "end": 1607.56, "text": "臣还有一事。"}, {"start": 1607.56, "end": 1610.56, "text": "爱卿只管说。"}, {"start": 1610.56, "end": 1612.56, "text": "自开春以来,"}, {"start": 1612.56, "end": 1615.56, "text": "中原一直大旱。"}, {"start": 1615.56, "end": 1617.56, "text": "近日几个州,"}, {"start": 1617.56, "end": 1620.56, "text": "已经是义子相识。"}, {"start": 1620.56, "end": 1623.56, "text": "好几个州郡,"}, {"start": 1623.56, "end": 1625.56, "text": "都上书,"}, {"start": 1625.56, "end": 1627.56, "text": "要求朝廷,"}, {"start": 1627.56, "end": 1630.56, "text": "拨梁相敬。"}, {"start": 1631.56, "end": 1634.56, "text": "咱家的粮食还不够吃呢。"}, {"start": 1634.56, "end": 1637.56, "text": "哪里有粮食给他们呢?"}, {"start": 1637.56, "end": 1640.56, "text": "那朝廷要是不拨,"}, {"start": 1640.56, "end": 1643.56, "text": "做事不顾的话,"}, {"start": 1643.56, "end": 1646.56, "text": "恐怕要有几十万灾民,"}, {"start": 1646.56, "end": 1648.56, "text": "丧生。"}, {"start": 1648.56, "end": 1651.56, "text": "这你怕什么呢?"}, {"start": 1651.56, "end": 1653.56, "text": "这千百年来,"}, {"start": 1653.56, "end": 1656.56, "text": "这七灾八难的,"}, {"start": 1656.56, "end": 1658.56, "text": "不是也都没断过吗?"}, {"start": 1658.56, "end": 1660.56, "text": "可是怎么着了?"}, {"start": 1660.56, "end": 1663.56, "text": "这人丁是越来越兴旺啊,"}, {"start": 1663.56, "end": 1666.56, "text": "人是越来越多了。"}, {"start": 1667.56, "end": 1669.56, "text": "牵手百姓,"}, {"start": 1669.56, "end": 1671.56, "text": "见着呢。"}, {"start": 1671.56, "end": 1678.55, "text": "启奏相国,"}, {"start": 1678.55, "end": 1681.55, "text": "百姓的口粮虽然可以不管,"}, {"start": 1681.55, "end": 1685.55, "text": "但是股种必须要与义相计。"}, {"start": 1685.55, "end": 1687.55, "text": "否则,"}, {"start": 1687.55, "end": 1689.55, "text": "明年春天,"}, {"start": 1689.55, "end": 1692.55, "text": "粮农们没有股种播种,"}, {"start": 1692.55, "end": 1694.55, "text": "则是全年无收,"}, {"start": 1694.55, "end": 1697.55, "text": "朝廷的税赋也就断了。"}, {"start": 1697.55, "end": 1699.55, "text": "那股种哪儿去了?"}, {"start": 1699.55, "end": 1701.55, "text": "那股种都哪儿去了?"}, {"start": 1701.55, "end": 1704.55, "text": "岩岩一息的鸡民,"}, {"start": 1704.55, "end": 1706.55, "text": "什么都会吃啊。"}, {"start": 1706.55, "end": 1709.55, "text": "谁叫他把股种都给吃了呀?"}, {"start": 1711.55, "end": 1714.55, "text": "真是鸡不得食。"}, {"start": 1714.55, "end": 1717.55, "text": "臣斗胆启奏相国,"}, {"start": 1718.55, "end": 1722.55, "text": "煤雾吞有百万袋粮草,"}, {"start": 1722.55, "end": 1725.55, "text": "足够二十年使用。"}, {"start": 1725.55, "end": 1729.55, "text": "请相国为天下百姓着想,"}, {"start": 1729.55, "end": 1731.55, "text": "拨出十分之一,"}, {"start": 1731.55, "end": 1734.55, "text": "以供粮农做股种。"}, {"start": 1734.55, "end": 1736.55, "text": "等到明年秋收以后,"}, {"start": 1736.55, "end": 1738.55, "text": "令他们加倍偿还。"}, {"start": 1738.55, "end": 1740.55, "text": "你等会儿,"}, {"start": 1740.55, "end": 1744.22, "text": "谁说我们煤雾里头"}, {"start": 1744.22, "end": 1747.22, "text": "存着百万袋粮草啊?"}, {"start": 1747.22, "end": 1749.22, "text": "谁说的?"}, {"start": 1749.22, "end": 1751.22, "text": "纯属胡说八道。"}, {"start": 1751.22, "end": 1753.22, "text": "没有,没有。"}, {"start": 1759.04, "end": 1761.04, "text": "你要不信的话,"}, {"start": 1761.04, "end": 1763.04, "text": "你可以问问奉先吗?"}, {"start": 1763.04, "end": 1765.04, "text": "他是朝廷的大将军,"}, {"start": 1765.04, "end": 1767.04, "text": "他应该知道相情啊。"}, {"start": 1767.04, "end": 1769.04, "text": "是不是奉先?"}, {"start": 1769.04, "end": 1774.85, "text": "奉先哪儿去了?"}, {"start": 1774.85, "end": 1789.58, "text": "吕布哪儿去了?"}, {"start": 1789.58, "end": 1790.58, "text": "将军,"}, {"start": 1790.58, "end": 1791.58, "text": "相国差我前来。"}, {"start": 1791.58, "end": 1792.58, "text": "闪开!"}, {"start": 1792.58, "end": 1793.58, "text": "诺。"}, {"start": 1793.58, "end": 1848.54, "text": "将军。"}, {"start": 1848.54, "end": 1881.03, "text": "我日日夜夜都在想你。"}, {"start": 1881.03, "end": 1883.03, "text": "调禅之所以,"}, {"start": 1883.03, "end": 1885.03, "text": "人肉通生地活着,"}, {"start": 1885.03, "end": 1892.86, "text": "就是为了见将军最后一面。"}, {"start": 1892.86, "end": 1897.81, "text": "调禅终于见着将军你了。"}, {"start": 1897.81, "end": 1901.6, "text": "调禅的心愿已了,"}, {"start": 1901.6, "end": 1903.6, "text": "就让调禅,"}, {"start": 1903.6, "end": 1906.6, "text": "来生再侍奉将军吧。"}, {"start": 1906.6, "end": 1916.34, "text": "若你死了,"}, {"start": 1916.34, "end": 1921.41, "text": "我会怎么活?"}, {"start": 1921.41, "end": 1923.41, "text": "能和将军在一起,"}, {"start": 1923.41, "end": 1925.41, "text": "调禅活着,"}, {"start": 1925.41, "end": 1927.41, "text": "又有什么意思呢?"}, {"start": 1927.41, "end": 1929.41, "text": "将军,"}, {"start": 1929.41, "end": 1930.41, "text": "就,"}, {"start": 1930.41, "end": 1931.41, "text": "就让调禅,"}, {"start": 1931.41, "end": 1932.41, "text": "死了吧?"}, {"start": 1932.41, "end": 1941.06, "text": "我有余意。"}, {"start": 1941.06, "end": 1984.82, "text": "听说他。"}, {"start": 1984.82, "end": 1986.82, "text": "吕布可曾来过?"}, {"start": 1986.82, "end": 1987.82, "text": "禀相国,"}, {"start": 1987.82, "end": 2054.23, "text": "吕将军刚进去不久。"}, {"start": 2054.23, "end": 2055.23, "text": "咱家小妾,"}, {"start": 2055.23, "end": 2058.38, "text": "逆,"}, {"start": 2058.38, "end": 2059.38, "text": "饶不了你。"}, {"start": 2059.38, "end": 2061.38, "text": "你这个逆子。"}, {"start": 2061.38, "end": 2062.38, "text": "逆你,"}, {"start": 2062.38, "end": 2063.38, "text": "逆子,"}, {"start": 2063.38, "end": 2064.38, "text": "武逆,"}, {"start": 2064.38, "end": 2066.38, "text": "我饶不了你。"}, {"start": 2066.38, "end": 2095.54, "text": "军之贼,"}, {"start": 2095.54, "end": 2097.54, "text": "备军之贼,"}, {"start": 2097.54, "end": 2100.55, "text": "气死我了,"}, {"start": 2100.55, "end": 2122.97, "text": "气死我了。"}, {"start": 2122.97, "end": 2125.54, "text": "不急,"}, {"start": 2125.54, "end": 2128.54, "text": "将军抱着奴婢就是不放。"}, {"start": 2130.54, "end": 2138.53, "text": "你可要为奴婢做主啊。"}, {"start": 2141.84, "end": 2142.84, "text": "吕布武逆,"}, {"start": 2142.84, "end": 2144.84, "text": "无耻之徒。"}, {"start": 2144.84, "end": 2147.15, "text": "咱家,"}, {"start": 2147.15, "end": 2149.15, "text": "一定饶不了他。"}, {"start": 2149.15, "end": 2153.14, "text": "让你受惊了。"}, {"start": 2153.14, "end": 2156.51, "text": "吕当时,"}, {"start": 2156.51, "end": 2158.51, "text": "只想偷捕自己,"}, {"start": 2158.51, "end": 2162.95, "text": "辱没了相国之身。"}, {"start": 2162.95, "end": 2164.95, "text": "可是吕将军,"}, {"start": 2164.95, "end": 2166.95, "text": "把奴婢死死地抱住,"}, {"start": 2166.95, "end": 2173.25, "text": "幸亏相国及时赶到。"}, {"start": 2174.25, "end": 2175.25, "text": "姓甘,"}, {"start": 2175.25, "end": 2186.5, "text": "咱不怕,"}, {"start": 2186.5, "end": 2187.5, "text": "咱不怕,"}, {"start": 2187.5, "end": 2188.5, "text": "来,"}, {"start": 2188.5, "end": 2189.5, "text": "不怕。"}, {"start": 2189.5, "end": 2191.5, "text": "咱家给你做主,"}, {"start": 2191.5, "end": 2193.5, "text": "我一定饶不了那司。"}, {"start": 2194.5, "end": 2195.5, "text": "不哭,"}, {"start": 2195.5, "end": 2196.5, "text": "咱不怕。"}, {"start": 2196.5, "end": 2198.5, "text": "臣王允,"}, {"start": 2198.5, "end": 2199.5, "text": "拜见相国。"}, {"start": 2199.5, "end": 2201.5, "text": "王允呢?"}, {"start": 2201.5, "end": 2203.5, "text": "你都知道了吗?"}, {"start": 2203.5, "end": 2205.5, "text": "臣刚才见吕布,"}, {"start": 2205.5, "end": 2207.5, "text": "匆匆忙忙奔命,"}, {"start": 2207.5, "end": 2208.5, "text": "老夫,"}, {"start": 2208.5, "end": 2211.5, "text": "也就猜测出一二了。"}, {"start": 2211.5, "end": 2213.5, "text": "吕布武逆,"}, {"start": 2213.5, "end": 2215.5, "text": "这无耻之徒,"}, {"start": 2215.5, "end": 2216.5, "text": "竟然干出这种,"}, {"start": 2216.5, "end": 2219.5, "text": "卑鄙无耻的勾当来。"}, {"start": 2219.5, "end": 2220.5, "text": "我要,"}, {"start": 2220.5, "end": 2222.5, "text": "要把他正罚。"}, {"start": 2222.5, "end": 2224.5, "text": "相国,"}, {"start": 2224.5, "end": 2225.5, "text": "老臣,"}, {"start": 2225.5, "end": 2227.5, "text": "赶紧相国借一步说话。"}, {"start": 2227.5, "end": 2243.1, "text": "怎么着?"}, {"start": 2243.1, "end": 2245.1, "text": "老臣琢磨着,"}, {"start": 2245.1, "end": 2247.1, "text": "事情既然已经做下了,"}, {"start": 2247.1, "end": 2248.1, "text": "吕布,"}, {"start": 2248.1, "end": 2250.1, "text": "当然是罪不可赦。"}, {"start": 2250.1, "end": 2251.1, "text": "但吕布,"}, {"start": 2251.1, "end": 2253.1, "text": "是相国的义子,"}, {"start": 2253.1, "end": 2254.1, "text": "爱将。"}, {"start": 2254.1, "end": 2256.1, "text": "凤怡亭之事,"}, {"start": 2256.1, "end": 2258.1, "text": "如果传扬出去,"}, {"start": 2258.1, "end": 2260.1, "text": "这必然百官沸然,"}, {"start": 2260.1, "end": 2261.1, "text": "天下失效,"}, {"start": 2261.1, "end": 2264.1, "text": "也大损相国的威严了。"}, {"start": 2264.1, "end": 2265.1, "text": "再者说,"}, {"start": 2265.1, "end": 2267.1, "text": "吕布,"}, {"start": 2267.1, "end": 2269.1, "text": "英勇无双,"}, {"start": 2269.1, "end": 2271.1, "text": "足堪大任。"}, {"start": 2271.1, "end": 2273.1, "text": "如斩了吕布,"}, {"start": 2273.1, "end": 2275.1, "text": "就如同自断臂膀,"}, {"start": 2275.1, "end": 2278.1, "text": "阴小施大呀。"}, {"start": 2279.1, "end": 2281.1, "text": "那你说怎么办?"}, {"start": 2281.1, "end": 2284.41, "text": "与其治吕布之罪,"}, {"start": 2284.41, "end": 2287.41, "text": "不如赐他一条生路,"}, {"start": 2287.41, "end": 2290.41, "text": "化祸为福。"}, {"start": 2290.41, "end": 2293.41, "text": "怎么个化祸为福?"}, {"start": 2293.41, "end": 2296.41, "text": "相国顺水推舟,"}, {"start": 2296.41, "end": 2299.41, "text": "将小女貂蝉赐给他。"}, {"start": 2299.41, "end": 2301.41, "text": "什么?"}, {"start": 2301.41, "end": 2302.41, "text": "你!"}, {"start": 2302.41, "end": 2305.69, "text": "把小女貂蝉赐给他,"}, {"start": 2305.69, "end": 2307.69, "text": "以安其心。"}, {"start": 2307.69, "end": 2308.69, "text": "这样,"}, {"start": 2308.69, "end": 2311.69, "text": "以后吕布必然感恩戴德,"}, {"start": 2311.69, "end": 2314.69, "text": "生生死死忠于相国,"}, {"start": 2314.69, "end": 2317.69, "text": "如是皆大欢喜。"}, {"start": 2317.69, "end": 2322.38, "text": "王司徒!"}, {"start": 2322.38, "end": 2326.05, "text": "你!"}, {"start": 2326.05, "end": 2328.62, "text": "这个事,"}, {"start": 2328.62, "end": 2330.62, "text": "咱家也想过,"}, {"start": 2330.62, "end": 2333.62, "text": "可是咱家同意了,"}, {"start": 2333.62, "end": 2335.62, "text": "那爱姬不同意呀。"}, {"start": 2335.62, "end": 2341.66, "text": "吕布是貂蝉的义父,"}, {"start": 2341.66, "end": 2343.66, "text": "臣可令他从命。"}, {"start": 2343.66, "end": 2356.12, "text": "也罢。"}, {"start": 2357.12, "end": 2359.12, "text": "你去和他说说试试。"}, {"start": 2359.12, "end": 2360.12, "text": "遵命。"}, {"start": 2360.12, "end": 2365.83, "text": "拜见义父。"}, {"start": 2365.83, "end": 2367.83, "text": "死丫头,"}, {"start": 2367.83, "end": 2370.83, "text": "看你给相国惹下多少麻烦,"}, {"start": 2370.83, "end": 2372.83, "text": "给相国父子之间,"}, {"start": 2372.83, "end": 2375.83, "text": "惹下多少误会。"}, {"start": 2375.83, "end": 2376.83, "text": "听着,"}, {"start": 2376.83, "end": 2378.83, "text": "即刻更衣,"}, {"start": 2378.83, "end": 2385.38, "text": "随老夫离去。"}, {"start": 2385.38, "end": 2387.38, "text": "要带我去哪儿啊?"}, {"start": 2387.38, "end": 2392.38, "text": "我带你到吕布将军处谢罪。"}, {"start": 2393.38, "end": 2395.38, "text": "从今往后啊,"}, {"start": 2395.38, "end": 2397.38, "text": "你就伺候吕将军吧。"}, {"start": 2397.38, "end": 2400.39, "text": "你个死丫头,"}, {"start": 2400.39, "end": 2402.39, "text": "你听见没有?"}, {"start": 2402.39, "end": 2404.39, "text": "我是你父,"}, {"start": 2404.39, "end": 2406.39, "text": "你敢违抗父命吗?"}, {"start": 2406.39, "end": 2413.47, "text": "我不去。"}, {"start": 2413.47, "end": 2414.47, "text": "你放肆!"}, {"start": 2414.47, "end": 2419.18, "text": "相国,"}, {"start": 2419.18, "end": 2422.62, "text": "生再见吧。"}, {"start": 2422.62, "end": 2427.34, "text": "貂蝉!"}, {"start": 2427.34, "end": 2428.34, "text": "貂蝉哪!"}, {"start": 2428.34, "end": 2430.34, "text": "我的心肝啊!"}, {"start": 2430.34, "end": 2432.34, "text": "你怎么能这样?"}, {"start": 2432.34, "end": 2433.34, "text": "貂蝉哪!"}, {"start": 2433.34, "end": 2434.34, "text": "相国,"}, {"start": 2434.34, "end": 2435.34, "text": "相国,"}, {"start": 2435.34, "end": 2437.34, "text": "不用管他,"}, {"start": 2437.34, "end": 2439.34, "text": "让他死好了。"}, {"start": 2439.34, "end": 2441.34, "text": "这种无情无义,"}, {"start": 2441.34, "end": 2443.34, "text": "无忠无孝的死丫头,"}, {"start": 2443.34, "end": 2445.34, "text": "留他何用?"}, {"start": 2445.34, "end": 2446.34, "text": "住口!"}, {"start": 2446.34, "end": 2447.34, "text": "都是你!"}, {"start": 2447.34, "end": 2451.34, "text": "你是想害死咱们爱姬啊!"}, {"start": 2451.34, "end": 2452.34, "text": "相国,"}, {"start": 2452.34, "end": 2455.34, "text": "老臣可是处处为相国着想。"}, {"start": 2455.34, "end": 2456.34, "text": "滚!"}, {"start": 2456.34, "end": 2457.34, "text": "相国!"}, {"start": 2457.34, "end": 2458.34, "text": "滚!"}, {"start": 2458.34, "end": 2460.34, "text": "再不跟我劈了你!"}, {"start": 2460.34, "end": 2462.34, "text": "是是是。"}, {"start": 2462.34, "end": 2465.34, "text": "太医!"}, {"start": 2465.34, "end": 2467.34, "text": "我的心肝啊!"}]