[{"start": 14.35, "end": 15.43, "text": "大都督! 大都督!"}, {"start": 15.43, "end": 17.43, "text": "贼无辜杀我兄长啊,大都督!"}, {"start": 18.67, "end": 20.87, "text": "京城九部无不切齿痛恨!"}, {"start": 21.31, "end": 23.11, "text": "我兄弟特来投奔大都督!"}, {"start": 23.63, "end": 24.83, "text": "为大都督效命!"}, {"start": 25.15, "end": 25.83, "text": "杀曹贼!"}, {"start": 26.11, "end": 27.99, "text": "为我兄长报仇啊,大都督!"}, {"start": 27.99, "end": 28.63, "text": "好,好!"}, {"start": 30.6, "end": 32.68, "text": "靖乡水军也愿意返曹吗?"}, {"start": 33.0, "end": 33.4, "text": "大都督!"}, {"start": 33.68, "end": 35.4, "text": "我俩来之前,你和弟兄们相约!"}, {"start": 35.76, "end": 37.32, "text": "大家都愿意奉都督号令!"}, {"start": 37.6, "end": 39.24, "text": "待大战起时,一起返曹!"}, {"start": 43.58, "end": 44.78, "text": "真是上天助我!"}, {"start": 46.26, "end": 46.82, "text": "两位兄弟,"}, {"start": 47.38, "end": 48.54, "text": "请随我进城喝酒去!"}, {"start": 48.66, "end": 49.22, "text": "好!"}, {"start": 58.11, "end": 59.67, "text": "恭敬留用蔡氏兄弟了吗?"}, {"start": 60.79, "end": 61.51, "text": "留下了,"}, {"start": 62.15, "end": 64.11, "text": "任命为水师将军!"}, {"start": 65.87, "end": 66.31, "text": "好!"}, {"start": 67.19, "end": 68.63, "text": "有趣,有趣!"}, {"start": 70.19, "end": 70.79, "text": "孔明啊,"}, {"start": 71.75, "end": 73.47, "text": "蔡氏兄弟前来相投,"}, {"start": 74.79, "end": 75.83, "text": "却没带家眷!"}, {"start": 76.79, "end": 78.75, "text": "我担心二人是奸细!"}, {"start": 79.35, "end": 80.23, "text": "奸细好啊!"}, {"start": 80.55, "end": 82.03, "text": "奸细有奸细的妙律!"}, {"start": 82.15, "end": 85.15, "text": "有时候,一个奸细能顶十万兵!"}, {"start": 87.35, "end": 87.91, "text": "正是!"}, {"start": 88.43, "end": 90.43, "text": "且看公瑾如何用他们吧!"}, {"start": 93.27, "end": 94.67, "text": "曹操率百万之众,"}, {"start": 94.91, "end": 95.87, "text": "连赢二百多里,"}, {"start": 96.19, "end": 97.19, "text": "非一日可后!"}, {"start": 98.39, "end": 99.23, "text": "先领诸将,"}, {"start": 99.55, "end": 100.75, "text": "各领三个月粮草!"}, {"start": 101.71, "end": 102.87, "text": "分发至各营中,"}, {"start": 103.27, "end": 104.19, "text": "准备持久战!"}, {"start": 104.51, "end": 111.17, "text": "大都督!"}, {"start": 112.01, "end": 113.09, "text": "我们屯兵下口,"}, {"start": 113.25, "end": 114.13, "text": "已快半年了!"}, {"start": 114.61, "end": 116.33, "text": "始终不见都督有任何动作!"}, {"start": 117.01, "end": 117.61, "text": "现在,"}, {"start": 118.09, "end": 119.61, "text": "又要我们再等三个月!"}, {"start": 119.97, "end": 120.57, "text": "叫我说,"}, {"start": 120.77, "end": 121.61, "text": "别说三个月!"}, {"start": 122.01, "end": 123.25, "text": "你就是三十个月!"}, {"start": 123.49, "end": 124.61, "text": "也无济于事!"}, {"start": 125.25, "end": 125.81, "text": "如果,"}, {"start": 126.05, "end": 127.49, "text": "本月能破草金就破了!"}, {"start": 127.73, "end": 128.53, "text": "本月破不了!"}, {"start": 128.73, "end": 130.81, "text": "都督还是向主公谢罪请辞吧!"}, {"start": 136.86, "end": 137.46, "text": "黄盖,"}, {"start": 139.22, "end": 140.62, "text": "你是想夺我军权吗?"}, {"start": 141.82, "end": 142.34, "text": "不敢!"}, {"start": 143.62, "end": 145.34, "text": "都督如果没有破敌之策,"}, {"start": 145.62, "end": 146.78, "text": "应该另选贤能!"}, {"start": 147.18, "end": 147.74, "text": "放肆!"}, {"start": 148.7, "end": 149.9, "text": "如再敢胡言乱语,"}, {"start": 150.3, "end": 151.06, "text": "军法不容!"}, {"start": 152.22, "end": 152.74, "text": "周云!"}, {"start": 153.46, "end": 154.86, "text": "你本是无能之辈,"}, {"start": 155.3, "end": 156.66, "text": "却擅用狂妖自大,"}, {"start": 156.94, "end": 157.94, "text": "来欺使道明!"}, {"start": 158.34, "end": 161.02, "text": "我担心江东六郡要断足在你手里!"}, {"start": 161.74, "end": 162.42, "text": "老皮肤!"}, {"start": 162.94, "end": 163.86, "text": "你辱我太甚!"}, {"start": 164.46, "end": 165.02, "text": "黄老将军!"}, {"start": 166.3, "end": 168.14, "text": "我随上将军打天下使,"}, {"start": 168.22, "end": 169.18, "text": "哪有你啊!"}, {"start": 169.9, "end": 171.58, "text": "如果不是主公宽然为怀,"}, {"start": 171.78, "end": 173.22, "text": "我等岂容你张罚!"}, {"start": 176.02, "end": 176.42, "text": "来人!"}, {"start": 179.67, "end": 180.75, "text": "黄盖看我将力,"}, {"start": 180.95, "end": 181.67, "text": "乱我军心!"}, {"start": 182.47, "end": 184.03, "text": "卓将黄盖斩首示众!"}, {"start": 184.47, "end": 185.11, "text": "即刻执行!"}, {"start": 185.11, "end": 185.43, "text": "诺!"}, {"start": 185.43, "end": 186.59, "text": "大都督!"}, {"start": 186.67, "end": 187.79, "text": "黄盖虽然犯下罪过,"}, {"start": 188.03, "end": 188.91, "text": "但是战前斩将,"}, {"start": 189.23, "end": 190.11, "text": "与我军不利啊!"}, {"start": 190.31, "end": 191.19, "text": "是啊大都督!"}, {"start": 191.19, "end": 191.87, "text": "收督七度!"}, {"start": 192.35, "end": 194.35, "text": "黄将军随先生征战多年,"}, {"start": 194.51, "end": 195.23, "text": "孤不可没!"}, {"start": 195.95, "end": 197.51, "text": "还是先免了他的死罪吧!"}, {"start": 198.83, "end": 199.67, "text": "待破了曹军,"}, {"start": 200.11, "end": 200.95, "text": "再斩不迟啊!"}, {"start": 211.16, "end": 212.68, "text": "如果不是看在众老将面上,"}, {"start": 214.16, "end": 214.76, "text": "我真把你!"}, {"start": 215.0, "end": 215.44, "text": "赵羽!"}, {"start": 216.08, "end": 217.0, "text": "你要杀便杀,"}, {"start": 217.28, "end": 218.16, "text": "要砍便砍!"}, {"start": 218.72, "end": 219.92, "text": "我九泉之下,"}, {"start": 220.24, "end": 221.28, "text": "也不服你!"}, {"start": 222.48, "end": 222.96, "text": "屠将军!"}, {"start": 223.36, "end": 223.8, "text": "急斩!"}, {"start": 224.28, "end": 225.0, "text": "大都督!"}, {"start": 225.0, "end": 225.48, "text": "大都督!"}, {"start": 225.48, "end": 225.88, "text": "大都督!"}, {"start": 225.88, "end": 226.64, "text": "饶了黄将军!"}, {"start": 226.64, "end": 227.36, "text": "大都督!"}, {"start": 227.36, "end": 236.14, "text": "也不服你!"}, {"start": 236.14, "end": 239.2, "text": "你个无能斩罚!"}, {"start": 239.2, "end": 242.94, "text": "大都督!"}, {"start": 242.94, "end": 244.1, "text": "求你饶了他们!"}, {"start": 244.14, "end": 251.87, "text": "死罪可免,"}, {"start": 252.79, "end": 253.71, "text": "活罪难赦!"}, {"start": 256.95, "end": 257.83, "text": "卓将黄盖,"}, {"start": 258.19, "end": 259.11, "text": "打一百军仗!"}, {"start": 259.79, "end": 260.87, "text": "罢免一切军职!"}, {"start": 261.51, "end": 262.43, "text": "谨留新凤!"}, {"start": 262.91, "end": 263.39, "text": "共锦!"}, {"start": 264.31, "end": 266.03, "text": "黄将军已年纪六十,"}, {"start": 266.35, "end": 267.51, "text": "这一百军会下去,"}, {"start": 267.87, "end": 268.95, "text": "不死也惨啊!"}, {"start": 269.39, "end": 270.15, "text": "还望共锦,"}, {"start": 270.43, "end": 271.75, "text": "多宽容他一些吧!"}, {"start": 272.07, "end": 272.51, "text": "不准!"}, {"start": 273.51, "end": 273.91, "text": "听令!"}, {"start": 274.87, "end": 275.95, "text": "痛打一百军仗!"}, {"start": 276.83, "end": 277.91, "text": "仗掌无虚!"}, {"start": 278.87, "end": 279.75, "text": "赢仗也不许少!"}, {"start": 281.63, "end": 286.28, "text": "我死了也不服你!"}, {"start": 286.8, "end": 288.0, "text": "你什么东西!"}, {"start": 288.2, "end": 289.96, "text": "岂是盗名之徒!"}, {"start": 317.06, "end": 318.06, "text": "空明!空明!"}, {"start": 319.46, "end": 319.94, "text": "紫禁!"}, {"start": 320.46, "end": 322.14, "text": "你不是去柴桑见吴侯了吗?"}, {"start": 322.94, "end": 324.38, "text": "我刚刚从柴桑归来,"}, {"start": 324.78, "end": 327.06, "text": "就听说共锦在大庭广众之下,"}, {"start": 327.26, "end": 330.62, "text": "把皇公傅老将军打得皮开肉绽死去活来!"}, {"start": 331.7, "end": 332.38, "text": "我刚才,"}, {"start": 332.74, "end": 333.62, "text": "才去探望过,"}, {"start": 334.42, "end": 335.74, "text": "老将军现在已是,"}, {"start": 335.94, "end": 336.78, "text": "双腿剧断,"}, {"start": 336.94, "end": 338.02, "text": "惨不忍睹啊!"}, {"start": 338.58, "end": 339.42, "text": "真断了腿啊?"}, {"start": 342.58, "end": 343.7, "text": "你唉呦什么呀?"}, {"start": 344.66, "end": 345.3, "text": "疼啊!"}, {"start": 345.9, "end": 347.66, "text": "替皇老将军心疼啊!"}, {"start": 349.22, "end": 349.82, "text": "空明啊!"}, {"start": 350.7, "end": 351.74, "text": "我听人家说,"}, {"start": 352.18, "end": 353.94, "text": "共锦在打黄丐的时候,"}, {"start": 354.3, "end": 356.14, "text": "在场所有的人都苦劝,"}, {"start": 356.78, "end": 358.42, "text": "唯独你飘然而过,"}, {"start": 358.74, "end": 359.66, "text": "一言不发,"}, {"start": 360.1, "end": 361.14, "text": "可有此事啊?"}, {"start": 361.82, "end": 363.1, "text": "紫禁难为我了,"}, {"start": 363.9, "end": 365.42, "text": "这是你们东吴自家的事,"}, {"start": 365.94, "end": 367.62, "text": "你们的将军都劝不下来,"}, {"start": 368.18, "end": 369.42, "text": "我客居于此,"}, {"start": 369.54, "end": 370.7, "text": "岂敢多嘴!"}, {"start": 371.42, "end": 372.38, "text": "此言差矣,"}, {"start": 373.1, "end": 374.66, "text": "将军们是共锦的部下,"}, {"start": 374.66, "end": 375.5, "text": "劝也无用,"}, {"start": 375.9, "end": 376.82, "text": "而你却不然,"}, {"start": 377.38, "end": 378.3, "text": "你是宾客,"}, {"start": 378.62, "end": 380.42, "text": "恰恰可以直言相劝啊!"}, {"start": 381.22, "end": 382.34, "text": "紫禁欺我,"}, {"start": 382.98, "end": 384.34, "text": "紫禁又欺我!"}, {"start": 386.74, "end": 387.7, "text": "我怎的欺你了?"}, {"start": 389.9, "end": 391.46, "text": "我何时欺过你啊?"}, {"start": 395.02, "end": 396.5, "text": "紫禁难道看不出来,"}, {"start": 397.02, "end": 398.26, "text": "周瑜打黄丐,"}, {"start": 398.38, "end": 399.54, "text": "可谓一个怨大,"}, {"start": 399.54, "end": 400.42, "text": "一个怨哀?"}, {"start": 400.9, "end": 402.74, "text": "这是大都督的苦肉计啊!"}, {"start": 411.3, "end": 413.7, "text": "既然你当时已经看出是苦肉计,"}, {"start": 414.3, "end": 416.1, "text": "那你就更应该相劝他!"}, {"start": 417.42, "end": 418.02, "text": "为何?"}, {"start": 418.74, "end": 419.74, "text": "因为你劝了,"}, {"start": 420.1, "end": 421.26, "text": "共锦才会相信,"}, {"start": 421.26, "end": 424.74, "text": "你没有试过他的语劝啊!"}, {"start": 425.06, "end": 425.98, "text": "这个苦肉计,"}, {"start": 426.06, "end": 427.58, "text": "才会显得更苦,"}, {"start": 427.62, "end": 428.26, "text": "更痛,"}, {"start": 428.3, "end": 429.22, "text": "更真切,"}, {"start": 429.7, "end": 431.7, "text": "共锦才会显得更高明!"}, {"start": 437.06, "end": 437.78, "text": "对对对,"}, {"start": 439.02, "end": 440.1, "text": "是我糊涂,"}, {"start": 440.26, "end": 441.1, "text": "我该劝,"}, {"start": 441.46, "end": 442.46, "text": "我清高了,"}, {"start": 442.58, "end": 444.74, "text": "辜负了紫禁一片苦心啊!"}, {"start": 448.7, "end": 450.34, "text": "为了维护孙柳两家,"}, {"start": 450.34, "end": 451.82, "text": "联合抗草的大族,"}, {"start": 453.18, "end": 454.22, "text": "这半年来,"}, {"start": 454.98, "end": 456.82, "text": "我夹在你们两个人之间,"}, {"start": 457.7, "end": 459.7, "text": "可以说是口已说破,"}, {"start": 459.7, "end": 461.02, "text": "心已操碎了,"}, {"start": 461.7, "end": 463.22, "text": "可你们二位高士呢?"}, {"start": 464.22, "end": 466.82, "text": "斗法斗得是御家的起劲啊!"}, {"start": 467.7, "end": 469.22, "text": "我左支右挡,"}, {"start": 469.38, "end": 470.7, "text": "两头遭罪啊!"}, {"start": 472.76, "end": 474.48, "text": "可怜我一个愚者,"}, {"start": 475.2, "end": 476.56, "text": "真是太累,"}, {"start": 477.0, "end": 478.4, "text": "太累了!"}, {"start": 478.88, "end": 480.2, "text": "抱歉抱歉,"}, {"start": 480.28, "end": 481.56, "text": "在下告罪了,"}, {"start": 482.88, "end": 484.0, "text": "不过紫禁啊,"}, {"start": 484.4, "end": 486.56, "text": "你切莫谦诚什么愚者,"}, {"start": 487.04, "end": 490.64, "text": "你才真正是大智若愚啊!"}, {"start": 499.58, "end": 500.5, "text": "禀丞相,"}, {"start": 500.74, "end": 502.78, "text": "黄丐受先主厚恩,"}, {"start": 502.94, "end": 504.5, "text": "本不当怀有二心,"}, {"start": 504.66, "end": 505.9, "text": "但周虞如子,"}, {"start": 505.98, "end": 507.06, "text": "狂傲度恨,"}, {"start": 507.14, "end": 508.22, "text": "作威作福,"}, {"start": 508.5, "end": 509.58, "text": "有功不赏,"}, {"start": 509.58, "end": 510.7, "text": "无罪则罚,"}, {"start": 511.06, "end": 513.7, "text": "与其让江东陷于此辈之手,"}, {"start": 513.78, "end": 515.3, "text": "不如陷于朝廷,"}, {"start": 515.58, "end": 517.42, "text": "黄丐久仰丞相,"}, {"start": 517.5, "end": 518.62, "text": "开诚待物,"}, {"start": 518.82, "end": 519.98, "text": "虚怀纳士,"}, {"start": 520.14, "end": 523.06, "text": "丐愿率所部倾城归乡,"}, {"start": 523.38, "end": 524.14, "text": "及时,"}, {"start": 524.22, "end": 527.62, "text": "粮草弃蟹也将随传奉运,"}, {"start": 527.9, "end": 530.02, "text": "黄丐弃学百败。"}, {"start": 531.5, "end": 532.38, "text": "黄丐,"}, {"start": 532.66, "end": 538.66, "text": "苦肉计给我下炸乡书,"}, {"start": 539.82, "end": 541.58, "text": "如此雕虫小计,"}, {"start": 541.58, "end": 543.02, "text": "岂能瞒得过我?"}, {"start": 543.74, "end": 544.46, "text": "白亚!"}, {"start": 544.46, "end": 545.06, "text": "在!"}, {"start": 545.46, "end": 546.7, "text": "把此人推出去,"}, {"start": 546.7, "end": 547.42, "text": "斩了!"}, {"start": 547.42, "end": 548.06, "text": "诺!"}, {"start": 548.46, "end": 549.18, "text": "丞相!"}, {"start": 549.38, "end": 550.1, "text": "丞相!"}, {"start": 550.58, "end": 551.74, "text": "我无罪丞相!"}, {"start": 551.82, "end": 552.54, "text": "丞相!"}, {"start": 553.26, "end": 554.26, "text": "启禀丞相,"}, {"start": 555.06, "end": 556.06, "text": "蔡中蔡禾,"}, {"start": 556.38, "end": 558.18, "text": "卓密许快传,送来此剑。"}, {"start": 558.9, "end": 559.5, "text": "念。"}, {"start": 560.1, "end": 562.26, "text": "蔡禾蔡中百败丞相,"}, {"start": 562.78, "end": 564.94, "text": "昨日于军仗异兵,"}, {"start": 565.66, "end": 573.82, "text": "黄丐一夺舟于军权,"}, {"start": 573.82, "end": 575.14, "text": "被舟于识破,"}, {"start": 575.42, "end": 576.62, "text": "将罪斩首,"}, {"start": 576.82, "end": 579.58, "text": "幸得成仆甘宁等老将苦求,"}, {"start": 579.58, "end": 581.06, "text": "侥幸免死,"}, {"start": 581.34, "end": 582.82, "text": "重仗一百,"}, {"start": 583.18, "end": 584.7, "text": "仗义一百,"}, {"start": 584.94, "end": 586.3, "text": "仗义一百,"}, {"start": 586.34, "end": 587.46, "text": "敬免死,"}, {"start": 587.82, "end": 589.18, "text": "重仗一百,"}, {"start": 589.54, "end": 591.42, "text": "黄丐双腿俱断,"}, {"start": 591.82, "end": 593.38, "text": "吾军军心惶惶,"}, {"start": 593.38, "end": 594.98, "text": "末将亲自探得,"}, {"start": 594.98, "end": 599.14, "text": "甘宁祖茂等老将皆愤愤不平,"}, {"start": 599.54, "end": 603.02, "text": "亦有反舟于降丞相之心,"}, {"start": 603.02, "end": 604.94, "text": "因未得丞相允许,"}, {"start": 604.94, "end": 607.66, "text": "我等尚不敢与其接触,"}, {"start": 607.66, "end": 609.22, "text": "盼丞相明示,"}, {"start": 609.54, "end": 610.54, "text": "蔡禾蔡中尚。"}, {"start": 615.94, "end": 620.06, "text": "舟于少年得志,"}, {"start": 620.7, "end": 622.58, "text": "焦狂不可一世,"}, {"start": 623.7, "end": 626.78, "text": "瞬间就不反他那是早晚的事。"}, {"start": 632.22, "end": 634.9, "text": "丞相,此简如何回复?"}, {"start": 635.18, "end": 636.1, "text": "告诉他们,"}, {"start": 636.1, "end": 640.37, "text": "他们暗中联络甘宁祖茂,"}, {"start": 641.09, "end": 642.45, "text": "大战起时,"}, {"start": 642.85, "end": 643.77, "text": "一起来想。"}, {"start": 644.77, "end": 645.41, "text": "遵命。"}, {"start": 652.99, "end": 653.67, "text": "禀丞相,"}, {"start": 653.99, "end": 655.79, "text": "末将已把水军战船营寨"}, {"start": 655.79, "end": 656.95, "text": "全部调询完毕,"}, {"start": 657.35, "end": 658.95, "text": "请丞相责十月军。"}, {"start": 659.07, "end": 659.67, "text": "好,"}, {"start": 661.83, "end": 664.11, "text": "十一月十五日正午,"}, {"start": 665.51, "end": 670.51, "text": "我会率文臣武将一起前往约军。"}, {"start": 671.87, "end": 673.39, "text": "末将这就去准备。"}, {"start": 673.59, "end": 704.49, "text": "把我的眼都看花了。"}, {"start": 708.28, "end": 710.52, "text": "自从盘古开天地以来,"}, {"start": 711.12, "end": 713.72, "text": "我曾有过如此雄壮的水军吗?"}, {"start": 715.44, "end": 716.24, "text": "沃丞相,"}, {"start": 716.88, "end": 720.24, "text": "便不会有这雄壮的水军。"}, {"start": 721.32, "end": 723.0, "text": "我起兵二十年来,"}, {"start": 723.6, "end": 726.0, "text": "为国出凶去暴,"}, {"start": 726.84, "end": 728.48, "text": "利势扫平四海,"}, {"start": 728.8, "end": 730.0, "text": "扩清天下。"}, {"start": 730.84, "end": 732.72, "text": "如今只剩江南为定,"}, {"start": 733.24, "end": 734.56, "text": "无心不足啊。"}, {"start": 737.05, "end": 737.85, "text": "为此,"}, {"start": 738.41, "end": 740.01, "text": "率百万穷师,"}, {"start": 740.33, "end": 741.45, "text": "八千战船,"}, {"start": 741.93, "end": 742.97, "text": "替天行道,"}, {"start": 743.37, "end": 744.49, "text": "收复江南,"}, {"start": 744.69, "end": 746.37, "text": "承千秋功年。"}, {"start": 747.89, "end": 748.97, "text": "到了那一时,"}, {"start": 751.32, "end": 754.6, "text": "我与中卿就可以安享富贵,"}, {"start": 755.28, "end": 756.6, "text": "欢乐太平了。"}, {"start": 757.28, "end": 758.84, "text": "成年少,万岁,"}, {"start": 758.84, "end": 760.48, "text": "皇兄万岁,"}, {"start": 760.48, "end": 776.43, "text": "家宴席我要靠什么?"}, {"start": 776.43, "end": 813.53, "text": "我曹操今年五十有四,"}, {"start": 814.09, "end": 817.18, "text": "追思往西,"}, {"start": 817.66, "end": 820.77, "text": "获黄金,"}, {"start": 822.45, "end": 823.69, "text": "擒吕布,"}, {"start": 825.25, "end": 826.41, "text": "灭袁术,"}, {"start": 827.65, "end": 828.81, "text": "拜袁绍,"}, {"start": 829.93, "end": 831.53, "text": "马他塞北,"}, {"start": 832.57, "end": 833.65, "text": "见敌,"}, {"start": 834.05, "end": 838.41, "text": "纵横天下,"}, {"start": 839.37, "end": 841.13, "text": "笑傲苍穹,"}, {"start": 841.13, "end": 845.15, "text": "此生如此,"}, {"start": 845.55, "end": 850.18, "text": "夫妇何求?"}, {"start": 851.46, "end": 920.66, "text": "真生不朝露玉日以抗,"}, {"start": 927.68, "end": 940.6, "text": "忧思何以解忧杜抗?"}, {"start": 940.6, "end": 971.69, "text": "听清悠悠沉意,"}, {"start": 971.69, "end": 984.02, "text": "悠悠执品,"}, {"start": 987.96, "end": 988.84, "text": "执品,"}, {"start": 989.4, "end": 994.48, "text": "我有佳宾五色吹笙,"}, {"start": 995.4, "end": 1001.1, "text": "明明何时可多,"}, {"start": 1001.7, "end": 1006.9, "text": "有从终来不可断绝,"}, {"start": 1007.46, "end": 1009.38, "text": "月末渡迁,"}, {"start": 1010.06, "end": 1012.38, "text": "往用相存,"}, {"start": 1012.98, "end": 1015.38, "text": "气阔谈夜,"}, {"start": 1015.78, "end": 1018.14, "text": "新念旧魂,"}, {"start": 1019.1, "end": 1022.02, "text": "月明兴夕,"}, {"start": 1022.02, "end": 1024.94, "text": "吾阙南飞,"}, {"start": 1024.94, "end": 1027.54, "text": "绕树三杂,"}, {"start": 1027.54, "end": 1030.54, "text": "何至何依?"}, {"start": 1031.46, "end": 1034.3, "text": "山不厌高,"}, {"start": 1034.3, "end": 1037.26, "text": "海不厌深,"}, {"start": 1037.74, "end": 1040.54, "text": "州公徒步,"}, {"start": 1040.98, "end": 1044.54, "text": "天下归心。"}, {"start": 1044.54, "end": 1069.71, "text": "小巧你看,"}, {"start": 1069.71, "end": 1073.72, "text": "大疆东去,"}, {"start": 1075.42, "end": 1076.7, "text": "天高地阔,"}, {"start": 1076.7, "end": 1088.32, "text": "好战场啊。"}, {"start": 1088.32, "end": 1091.04, "text": "我家夫君定能在此建立,"}, {"start": 1091.04, "end": 1092.56, "text": "盖世功勋的,"}, {"start": 1092.56, "end": 1137.96, "text": "你突然晕倒,"}, {"start": 1137.96, "end": 1157.89, "text": "到底患了何病啊?"}, {"start": 1157.89, "end": 1158.97, "text": "公秦,"}, {"start": 1159.93, "end": 1160.65, "text": "公秦,"}, {"start": 1160.65, "end": 1230.36, "text": "我的话真是心情肉跳啊。"}, {"start": 1230.36, "end": 1231.76, "text": "先生,"}, {"start": 1231.76, "end": 1233.36, "text": "周郎此病,"}, {"start": 1233.36, "end": 1236.08, "text": "大夫竟查不出是何原因,"}, {"start": 1236.08, "end": 1238.6, "text": "都为之惊骇不已,"}, {"start": 1238.6, "end": 1240.44, "text": "我与他相处多年,"}, {"start": 1240.44, "end": 1243.0, "text": "也从未见他病得如此厉害,"}, {"start": 1243.0, "end": 1250.98, "text": "如此奇怪过。"}, {"start": 1250.98, "end": 1255.6, "text": "天意难料啊。"}, {"start": 1255.6, "end": 1256.88, "text": "我想,"}, {"start": 1256.88, "end": 1260.4, "text": "只怕是周郎心有快乐,"}, {"start": 1260.4, "end": 1266.77, "text": "愚闷难当。"}, {"start": 1266.77, "end": 1270.54, "text": "究竟是为何呢?"}, {"start": 1270.54, "end": 1272.66, "text": "我再三相问,"}, {"start": 1272.66, "end": 1283.82, "text": "他就是不肯说。"}, {"start": 1283.82, "end": 1286.63, "text": "我想有一人,"}, {"start": 1286.63, "end": 1289.55, "text": "他和公秦心心相印,"}, {"start": 1289.55, "end": 1293.09, "text": "生息相通,"}, {"start": 1293.09, "end": 1297.87, "text": "他最知道公秦的心思,"}, {"start": 1297.87, "end": 1300.27, "text": "或许可以把他请来,"}, {"start": 1300.27, "end": 1304.05, "text": "给公秦看看。"}, {"start": 1304.09, "end": 1306.01, "text": "先生说的是,"}, {"start": 1306.01, "end": 1311.78, "text": "诸葛亮?"}, {"start": 1311.78, "end": 1314.54, "text": "医师已经把过脉了,"}, {"start": 1314.54, "end": 1318.58, "text": "竟然断不出公秦所患何病。"}, {"start": 1319.54, "end": 1321.74, "text": "据吕蒙将军说,"}, {"start": 1321.74, "end": 1324.62, "text": "当时公秦正在江边水寨,"}, {"start": 1324.62, "end": 1327.78, "text": "跳往曹军的大营,"}, {"start": 1327.78, "end": 1329.66, "text": "突然江风骤起,"}, {"start": 1329.66, "end": 1330.86, "text": "吹动展起,"}, {"start": 1330.86, "end": 1333.22, "text": "大肚肚凝神看去,"}, {"start": 1333.22, "end": 1335.18, "text": "随后大叫一声,"}, {"start": 1335.22, "end": 1336.66, "text": "口吐鲜血,"}, {"start": 1336.66, "end": 1339.06, "text": "跌倒于地。"}, {"start": 1339.06, "end": 1340.98, "text": "江风骤起,"}, {"start": 1340.98, "end": 1341.98, "text": "督督大叫,"}, {"start": 1341.98, "end": 1343.94, "text": "跌倒于地。"}, {"start": 1344.94, "end": 1345.94, "text": "紫禁,"}, {"start": 1345.94, "end": 1348.92, "text": "当时是什么风向?"}, {"start": 1348.92, "end": 1351.4, "text": "这个季节,"}, {"start": 1351.4, "end": 1354.81, "text": "当然是西北风了。"}, {"start": 1354.81, "end": 1358.94, "text": "西北?"}, {"start": 1358.94, "end": 1360.34, "text": "紫禁,"}, {"start": 1360.34, "end": 1361.86, "text": "公秦这个病,"}, {"start": 1361.86, "end": 1363.94, "text": "在下已知病因,"}, {"start": 1363.94, "end": 1366.14, "text": "在下或许能治。"}, {"start": 1367.34, "end": 1368.86, "text": "你会医病吗?"}, {"start": 1369.86, "end": 1371.26, "text": "天文地理,"}, {"start": 1371.26, "end": 1372.66, "text": "奇门遁甲,"}, {"start": 1372.66, "end": 1373.86, "text": "古今已难,"}, {"start": 1373.86, "end": 1375.26, "text": "人间伤病,"}, {"start": 1375.26, "end": 1377.26, "text": "我无所不通。"}, {"start": 1377.26, "end": 1380.4, "text": "快,"}, {"start": 1380.4, "end": 1381.8, "text": "快随我走。"}, {"start": 1381.8, "end": 1399.94, "text": "先生,"}, {"start": 1399.94, "end": 1403.43, "text": "好些吗?"}, {"start": 1403.43, "end": 1405.03, "text": "这半日来,"}, {"start": 1405.03, "end": 1407.83, "text": "周郎只觉得心腹保障,"}, {"start": 1407.83, "end": 1409.43, "text": "阵阵泛熬,"}, {"start": 1409.43, "end": 1411.03, "text": "头晕目眩,"}, {"start": 1411.03, "end": 1416.88, "text": "浑身酸痛难当。"}, {"start": 1416.88, "end": 1418.68, "text": "我方才去看孔明,"}, {"start": 1418.68, "end": 1420.48, "text": "说到了你的病症,"}, {"start": 1420.48, "end": 1423.28, "text": "他说他能够医治。"}, {"start": 1423.48, "end": 1425.48, "text": "现在正在帐外候着呢。"}, {"start": 1425.48, "end": 1442.29, "text": "我不想让周国梁看见我这副样子。"}, {"start": 1442.29, "end": 1457.06, "text": "大都督,"}, {"start": 1457.06, "end": 1463.92, "text": "坐吧。"}, {"start": 1463.92, "end": 1464.92, "text": "几日不见,"}, {"start": 1464.92, "end": 1466.52, "text": "在下极为挂念,"}, {"start": 1466.52, "end": 1468.92, "text": "不料大都督竟一病如此。"}, {"start": 1468.92, "end": 1473.3, "text": "人有丹蝎护腹,"}, {"start": 1473.3, "end": 1477.99, "text": "又岂能治。"}, {"start": 1477.99, "end": 1479.99, "text": "天有不测风云,"}, {"start": 1479.99, "end": 1481.59, "text": "人又岂能预料。"}, {"start": 1481.59, "end": 1504.07, "text": "都督觉得心中烦闷吗?"}, {"start": 1504.07, "end": 1505.07, "text": "闷哪,"}, {"start": 1505.07, "end": 1512.34, "text": "好像闷着一团火。"}, {"start": 1512.34, "end": 1513.94, "text": "那当用良药解治啊。"}, {"start": 1513.94, "end": 1520.76, "text": "无用啊。"}, {"start": 1520.76, "end": 1522.76, "text": "若是良药无用,"}, {"start": 1522.76, "end": 1524.76, "text": "在下另有一个方子,"}, {"start": 1524.76, "end": 1527.76, "text": "或许能解都督病症。"}, {"start": 1527.76, "end": 1537.06, "text": "那就有劳先生写个方子吧。"}, {"start": 1537.06, "end": 1561.49, "text": "都督请看,"}, {"start": 1561.49, "end": 1562.49, "text": "这便是药方。"}, {"start": 1562.49, "end": 1595.5, "text": "你真是神啊。"}, {"start": 1595.5, "end": 1596.5, "text": "欲破曹宫,"}, {"start": 1596.5, "end": 1598.5, "text": "需用火功,"}, {"start": 1598.5, "end": 1600.5, "text": "万事皆备,"}, {"start": 1600.5, "end": 1603.5, "text": "只欠东风。"}, {"start": 1603.5, "end": 1608.4, "text": "实不相瞒,"}, {"start": 1608.4, "end": 1611.4, "text": "这确实是我的心病。"}, {"start": 1611.4, "end": 1614.4, "text": "龙冬季节,"}, {"start": 1614.4, "end": 1616.4, "text": "长江上只有西北风,"}, {"start": 1616.4, "end": 1618.4, "text": "并无东南风。"}, {"start": 1618.4, "end": 1622.4, "text": "我军如果用火功攻草,"}, {"start": 1622.4, "end": 1624.4, "text": "那么火势一起,"}, {"start": 1624.4, "end": 1626.4, "text": "反而会烧了我自家的战船。"}, {"start": 1626.4, "end": 1635.26, "text": "什么都料想好了,"}, {"start": 1635.26, "end": 1638.26, "text": "就是疏忽了风向。"}, {"start": 1638.26, "end": 1646.88, "text": "先生既然知我病症,"}, {"start": 1646.88, "end": 1650.86, "text": "可有办法治他吗?"}, {"start": 1650.86, "end": 1657.32, "text": "在下虽然才博,"}, {"start": 1657.32, "end": 1660.32, "text": "却有幸识得一位艺人,"}, {"start": 1660.32, "end": 1663.32, "text": "承他恩典授我奇门遁甲之术,"}, {"start": 1663.32, "end": 1665.32, "text": "一旦施其法来,"}, {"start": 1665.32, "end": 1672.54, "text": "便可呼风唤雨。"}, {"start": 1672.54, "end": 1673.54, "text": "当真?"}, {"start": 1673.54, "end": 1676.65, "text": "当真。"}, {"start": 1676.65, "end": 1677.65, "text": "紫禁啊,"}, {"start": 1677.65, "end": 1678.65, "text": "你立刻着人"}, {"start": 1678.65, "end": 1680.65, "text": "在南平山上修建一座奇星潭,"}, {"start": 1680.65, "end": 1683.65, "text": "潭高九尺,方圆三丈。"}, {"start": 1683.65, "end": 1685.65, "text": "令一百二十人手持奇帆,"}, {"start": 1685.65, "end": 1686.65, "text": "将祭潭为定。"}, {"start": 1686.65, "end": 1687.65, "text": "我在潭上做法,"}, {"start": 1687.65, "end": 1691.65, "text": "为恭敬借三天三夜的东南大风。"}, {"start": 1691.65, "end": 1696.59, "text": "何用三天三夜?"}, {"start": 1696.59, "end": 1698.59, "text": "只要能给我借来一夜东风,"}, {"start": 1698.59, "end": 1700.59, "text": "我就能灭曹。"}, {"start": 1700.59, "end": 1705.19, "text": "但是,我急着等风,"}, {"start": 1705.19, "end": 1707.19, "text": "我急着等用风啊!"}, {"start": 1707.19, "end": 1708.19, "text": "大都督,"}, {"start": 1708.19, "end": 1710.19, "text": "今日是十一月十五,"}, {"start": 1710.19, "end": 1712.19, "text": "如果十月二十日,"}, {"start": 1712.19, "end": 1713.19, "text": "甲子启封,"}, {"start": 1713.19, "end": 1714.19, "text": "至二十二日,"}, {"start": 1714.19, "end": 1716.19, "text": "禀吟封旨,"}, {"start": 1716.19, "end": 1717.19, "text": "你看如何呀?"}, {"start": 1717.19, "end": 1730.0, "text": "都督,"}, {"start": 1730.0, "end": 1808.34, "text": "成普将军,"}, {"start": 1808.34, "end": 1811.78, "text": "令你率五千经济,"}, {"start": 1811.78, "end": 1813.78, "text": "打着曹军旗号,"}, {"start": 1813.78, "end": 1815.78, "text": "直奔江北巫林,"}, {"start": 1815.78, "end": 1818.78, "text": "那里吞放曹操的军械粮草,"}, {"start": 1818.78, "end": 1820.78, "text": "令将他们全部焚尽。"}, {"start": 1820.78, "end": 1821.78, "text": "诺。"}, {"start": 1822.78, "end": 1823.78, "text": "甘宁将军。"}, {"start": 1823.78, "end": 1824.78, "text": "在。"}, {"start": 1824.78, "end": 1826.78, "text": "令你率兵三千,"}, {"start": 1826.78, "end": 1828.78, "text": "直奔黄州地界,"}, {"start": 1828.78, "end": 1830.78, "text": "断曹军后援。"}, {"start": 1830.78, "end": 1831.78, "text": "诺。"}, {"start": 1831.78, "end": 1832.78, "text": "太史司听令。"}, {"start": 1832.78, "end": 1833.78, "text": "在。"}, {"start": 1833.78, "end": 1835.78, "text": "令宁爷率兵三千,"}, {"start": 1835.78, "end": 1837.78, "text": "隔一日前往巫林,"}, {"start": 1837.78, "end": 1838.78, "text": "接应成普将军,"}, {"start": 1838.78, "end": 1840.78, "text": "斩断曹操东陆援军。"}, {"start": 1840.78, "end": 1841.78, "text": "诺。"}, {"start": 1841.78, "end": 1843.78, "text": "令统听令。"}, {"start": 1843.78, "end": 1844.78, "text": "在。"}, {"start": 1844.78, "end": 1845.78, "text": "率兵三千,"}, {"start": 1845.78, "end": 1846.78, "text": "取戒守。"}, {"start": 1846.78, "end": 1847.78, "text": "诺。"}, {"start": 1847.78, "end": 1848.78, "text": "潘昌听令。"}, {"start": 1848.78, "end": 1849.78, "text": "在。"}, {"start": 1849.78, "end": 1850.78, "text": "令你率兵三千,"}, {"start": 1850.78, "end": 1851.78, "text": "直取汉阳。"}, {"start": 1851.78, "end": 1852.78, "text": "诺。"}, {"start": 1852.78, "end": 1853.78, "text": "潘昌听令。"}, {"start": 1853.78, "end": 1854.78, "text": "在。"}, {"start": 1854.78, "end": 1855.78, "text": "令你率兵三千,"}, {"start": 1855.78, "end": 1857.78, "text": "打着曹军旗号,"}, {"start": 1857.78, "end": 1859.78, "text": "隔一天前往汉阳,"}, {"start": 1859.78, "end": 1861.78, "text": "接应董席,"}, {"start": 1861.78, "end": 1863.78, "text": "斩断曹操西北退路。"}, {"start": 1863.78, "end": 1864.78, "text": "诺。"}, {"start": 1864.78, "end": 1866.78, "text": "你杀,"}, {"start": 1866.78, "end": 1870.58, "text": "皆为不齐的禁军方律。"}, {"start": 1870.58, "end": 1872.58, "text": "水军战船,"}, {"start": 1872.58, "end": 1874.92, "text": "当分六旅,"}, {"start": 1874.92, "end": 1875.92, "text": "第一路统领,"}, {"start": 1875.92, "end": 1876.92, "text": "盘当。"}, {"start": 1876.92, "end": 1877.92, "text": "领命。"}, {"start": 1877.92, "end": 1878.92, "text": "第二路统领,"}, {"start": 1878.92, "end": 1879.92, "text": "盘当。"}, {"start": 1879.92, "end": 1880.92, "text": "第二路统领,"}, {"start": 1880.92, "end": 1881.92, "text": "周太。"}, {"start": 1881.92, "end": 1882.92, "text": "诺。"}, {"start": 1882.92, "end": 1883.92, "text": "第三路统领,"}, {"start": 1883.92, "end": 1884.92, "text": "贾青。"}, {"start": 1884.92, "end": 1885.92, "text": "诺。"}, {"start": 1885.92, "end": 1886.92, "text": "第四路统领,"}, {"start": 1886.92, "end": 1887.92, "text": "陈吴。"}, {"start": 1887.92, "end": 1888.92, "text": "诺。"}, {"start": 1888.92, "end": 1889.92, "text": "第五路统领,"}, {"start": 1889.92, "end": 1890.92, "text": "丁凤。"}, {"start": 1890.92, "end": 1891.92, "text": "诺。"}, {"start": 1891.92, "end": 1892.92, "text": "第六路统领,"}, {"start": 1892.92, "end": 1895.84, "text": "徐胜。"}, {"start": 1895.84, "end": 1896.84, "text": "诺。"}, {"start": 1896.84, "end": 1897.84, "text": "六路各引战船,"}, {"start": 1897.84, "end": 1898.84, "text": "三百艘。"}, {"start": 1898.84, "end": 1903.05, "text": "共计一千八百艘。"}, {"start": 1903.05, "end": 1904.05, "text": "东风起来之后,"}, {"start": 1904.05, "end": 1907.19, "text": "半个时辰,"}, {"start": 1907.19, "end": 1910.19, "text": "杨帆进攻北岸。"}, {"start": 1910.19, "end": 1911.19, "text": "我会在南平山,"}, {"start": 1911.19, "end": 1912.19, "text": "西风顶,"}, {"start": 1912.19, "end": 1914.19, "text": "布下降台。"}, {"start": 1914.19, "end": 1916.19, "text": "进攻时辰一到,"}, {"start": 1916.19, "end": 1918.19, "text": "即有号令发出。"}, {"start": 1918.19, "end": 1919.19, "text": "遵命。"}, {"start": 1919.19, "end": 1970.22, "text": "孔明施法已经快三天了,"}, {"start": 1970.22, "end": 1972.22, "text": "仍不见东南风起。"}, {"start": 1972.22, "end": 1974.22, "text": "今天已经是二十日,"}, {"start": 1974.22, "end": 1975.22, "text": "再过两个时辰,"}, {"start": 1975.22, "end": 1977.22, "text": "我军就要动兵了。"}, {"start": 1977.22, "end": 1980.02, "text": "你听着,"}, {"start": 1980.02, "end": 1983.81, "text": "如果甲子时辰到了,"}, {"start": 1983.81, "end": 1985.81, "text": "仍然不见东南风起,"}, {"start": 1985.81, "end": 1992.55, "text": "你即率兵赶往七星潭,"}, {"start": 1992.55, "end": 1995.55, "text": "斩杀孔明以证军法。"}, {"start": 1995.55, "end": 1996.55, "text": "遵命。"}, {"start": 1996.55, "end": 2001.02, "text": "大都督,"}, {"start": 2001.02, "end": 2003.02, "text": "若末将赶往七星潭,"}, {"start": 2003.02, "end": 2005.02, "text": "见东南风起,"}, {"start": 2005.02, "end": 2006.02, "text": "又该如何?"}, {"start": 2006.02, "end": 2007.02, "text": "那更要斩他,"}, {"start": 2007.02, "end": 2010.74, "text": "当场斩杀。"}, {"start": 2010.74, "end": 2013.86, "text": "东南风起,"}, {"start": 2013.86, "end": 2014.86, "text": "留着诸葛亮已经没用。"}, {"start": 2014.86, "end": 2018.3, "text": "此人有诡神不测之术,"}, {"start": 2018.3, "end": 2024.66, "text": "令日后必成我江东大海。"}, {"start": 2024.66, "end": 2028.35, "text": "末将遵命。"}, {"start": 2028.35, "end": 2081.16, "text": "请快上车。"}, {"start": 2081.16, "end": 2115.86, "text": "恶中何人?"}, {"start": 2115.86, "end": 2120.02, "text": "是我。"}, {"start": 2120.02, "end": 2122.5, "text": "惊扰夫人了。"}, {"start": 2122.5, "end": 2125.81, "text": "夫人可有见过诸葛亮?"}, {"start": 2125.81, "end": 2128.38, "text": "没有。"}, {"start": 2128.38, "end": 2151.11, "text": "夫人为何救我?"}, {"start": 2151.11, "end": 2154.11, "text": "因为你救过周朗。"}, {"start": 2154.11, "end": 2164.33, "text": "先生,"}, {"start": 2164.33, "end": 2166.33, "text": "燕子机到了,"}, {"start": 2166.33, "end": 2168.33, "text": "你自行去吧。"}, {"start": 2168.33, "end": 2172.33, "text": "夫人为何知道我要去燕子机?"}, {"start": 2172.33, "end": 2174.33, "text": "前两天,"}, {"start": 2174.33, "end": 2176.33, "text": "我看见这里停着一艘快船,"}, {"start": 2176.33, "end": 2178.33, "text": "那船夫英气夺人,"}, {"start": 2178.33, "end": 2181.33, "text": "他显然不是渔夫吧?"}, {"start": 2181.33, "end": 2183.33, "text": "禀夫人,"}, {"start": 2183.33, "end": 2185.33, "text": "他是常山赵子龙。"}, {"start": 2223.68, "end": 2225.68, "text": "回去告诉大都督,"}, {"start": 2225.68, "end": 2227.68, "text": "让他好生用兵。"}, {"start": 2227.68, "end": 2241.13, "text": "诸葛亮下唐后,"}, {"start": 2241.13, "end": 2243.13, "text": "就消失得无影无踪。"}, {"start": 2243.13, "end": 2246.13, "text": "末将追到燕子机江边的时候,"}, {"start": 2246.13, "end": 2248.13, "text": "他已经被一艘快船接走了。"}, {"start": 2248.13, "end": 2249.13, "text": "接他的人,"}, {"start": 2249.13, "end": 2251.13, "text": "是赵云将军。"}, {"start": 2251.13, "end": 2252.13, "text": "在下追查过,"}, {"start": 2252.13, "end": 2253.13, "text": "那艘快船,"}, {"start": 2253.13, "end": 2255.13, "text": "已在江边等候了三日。"}, {"start": 2255.13, "end": 2264.72, "text": "孔明事事料于我先,"}, {"start": 2264.72, "end": 2267.19, "text": "他不死,"}, {"start": 2267.19, "end": 2273.22, "text": "我咒于不安。"}, {"start": 2273.22, "end": 2274.22, "text": "人已走,"}, {"start": 2274.22, "end": 2276.22, "text": "恨也无用。"}, {"start": 2276.22, "end": 2278.22, "text": "等灭逃之后,"}, {"start": 2278.22, "end": 2280.22, "text": "再作图谋吧。"}, {"start": 2280.22, "end": 2389.77, "text": "放走了朱..."}, {"start": 2389.77, "end": 2446.51, "text": "夫君!"}]