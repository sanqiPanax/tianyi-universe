[{"start": 6.58, "end": 9.78, "text": "相父 这十年下来"}, {"start": 9.98, "end": 11.58, "text": "你已经古出旗山了"}, {"start": 12.46, "end": 14.78, "text": "你身体已大不如从前了"}, {"start": 15.26, "end": 16.66, "text": "可千万要保重啊"}, {"start": 17.38, "end": 18.58, "text": "谢陛下"}, {"start": 19.7, "end": 23.02, "text": "此次臣定能成功"}, {"start": 28.91, "end": 29.67, "text": "相父"}, {"start": 30.47, "end": 32.11, "text": "陛下还有何吩咐"}, {"start": 33.51, "end": 34.95, "text": "我扶你上车吧"}, {"start": 35.55, "end": 38.35, "text": "朕如何使得你是天子"}, {"start": 39.07, "end": 41.15, "text": "朕既是天子"}, {"start": 42.03, "end": 43.63, "text": "也是你的义子啊"}, {"start": 48.19, "end": 49.59, "text": "请你上车吧"}, {"start": 49.79, "end": 67.82, "text": "臣走了"}, {"start": 69.22, "end": 104.32, "text": "相父已经老了"}, {"start": 105.64, "end": 106.52, "text": "真怕"}, {"start": 107.92, "end": 109.32, "text": "再见不到了"}, {"start": 157.76, "end": 158.44, "text": "上将军"}, {"start": 159.04, "end": 160.24, "text": "在下在外巡营"}, {"start": 160.36, "end": 162.16, "text": "忽然看见此人前来投败"}, {"start": 162.28, "end": 163.84, "text": "便拿下他面见上将军"}, {"start": 166.86, "end": 168.26, "text": "你是何人哪"}, {"start": 168.86, "end": 170.66, "text": "为何来我军中"}, {"start": 171.86, "end": 172.78, "text": "禀上将军"}, {"start": 172.98, "end": 174.06, "text": "在下郑文"}, {"start": 174.18, "end": 175.66, "text": "是魏国前军偏将"}, {"start": 176.06, "end": 177.66, "text": "与秦朗同手武功"}, {"start": 178.26, "end": 180.66, "text": "上月蜀军攻城"}, {"start": 180.98, "end": 182.26, "text": "我等抵挡不住"}, {"start": 182.58, "end": 184.06, "text": "只得弃城而逃"}, {"start": 184.46, "end": 185.86, "text": "我等回到大营后"}, {"start": 186.38, "end": 189.26, "text": "秦朗将弃城之罪全加于我"}, {"start": 189.66, "end": 193.18, "text": "将坚守之功全归于他"}, {"start": 193.86, "end": 197.18, "text": "司马仪便升秦朗为前将军"}, {"start": 197.78, "end": 199.58, "text": "去下令杀我"}, {"start": 200.46, "end": 202.46, "text": "幸得军中袍泽说情"}, {"start": 202.98, "end": 204.26, "text": "才幸免我于死"}, {"start": 204.94, "end": 206.74, "text": "却令我再率部前来"}, {"start": 206.86, "end": 207.94, "text": "夺取武功城"}, {"start": 208.54, "end": 210.14, "text": "武功在我手中"}, {"start": 211.14, "end": 212.74, "text": "你岂能拿得回去"}, {"start": 213.86, "end": 215.54, "text": "在下深知上将军神武"}, {"start": 216.58, "end": 218.14, "text": "若我再攻打武功城"}, {"start": 218.86, "end": 220.14, "text": "岂不自寻死路"}, {"start": 220.74, "end": 222.58, "text": "又恨那司马仪"}, {"start": 223.26, "end": 224.54, "text": "上伐不分"}, {"start": 226.84, "end": 228.44, "text": "逼我上绝路啊"}, {"start": 229.64, "end": 231.24, "text": "所以在下想来想去"}, {"start": 232.04, "end": 233.64, "text": "只有前来投奔上将军"}, {"start": 234.16, "end": 235.44, "text": "才有生路一条"}, {"start": 237.7, "end": 240.1, "text": "在下求上将军收纳在下"}, {"start": 241.1, "end": 243.3, "text": "在下愿意牵马追荡"}, {"start": 244.5, "end": 245.9, "text": "以死报效"}, {"start": 258.72, "end": 260.32, "text": "想之计来虚化我"}, {"start": 261.92, "end": 263.12, "text": "拿我当什么人了"}, {"start": 264.89, "end": 265.29, "text": "来啊"}, {"start": 265.29, "end": 265.77, "text": "在"}, {"start": 265.97, "end": 267.29, "text": "将此人推出去斩首"}, {"start": 267.29, "end": 267.77, "text": "诺"}, {"start": 267.97, "end": 269.29, "text": "求上将军明察"}, {"start": 269.57, "end": 270.77, "text": "在下是真真切切"}, {"start": 270.77, "end": 271.97, "text": "前来投上将军的呀"}, {"start": 272.29, "end": 274.29, "text": "上将军若是今天杀了在下"}, {"start": 274.57, "end": 276.57, "text": "往后谁还敢来投靠上将军"}, {"start": 277.09, "end": 279.09, "text": "上将军不准为军投降"}, {"start": 280.09, "end": 282.57, "text": "岂不逼我等死战吗"}, {"start": 282.97, "end": 286.55, "text": "这外面何事啊"}, {"start": 286.55, "end": 286.95, "text": "报"}, {"start": 287.55, "end": 289.9, "text": "启禀上将军"}, {"start": 290.1, "end": 291.3, "text": "城外来了一支卫军"}, {"start": 291.5, "end": 292.9, "text": "领兵将军自胜秦朗"}, {"start": 293.3, "end": 294.3, "text": "说是什么"}, {"start": 294.3, "end": 296.5, "text": "阴阳将军单挑正文交战"}, {"start": 297.1, "end": 301.38, "text": "陈滚啊"}, {"start": 302.38, "end": 304.18, "text": "秦朗不是你的上司吗"}, {"start": 305.58, "end": 307.18, "text": "他的武艺比你如何"}, {"start": 308.18, "end": 309.58, "text": "请上将军下令"}, {"start": 309.98, "end": 311.78, "text": "在下愿取他首级"}, {"start": 312.58, "end": 313.58, "text": "你一表忠心"}, {"start": 313.58, "end": 314.18, "text": "好"}, {"start": 316.55, "end": 317.95, "text": "你若能斩下秦朗"}, {"start": 318.15, "end": 319.35, "text": "我升你做千将军"}, {"start": 319.95, "end": 321.15, "text": "在下领命"}, {"start": 322.75, "end": 323.95, "text": "上将军稍待"}, {"start": 325.95, "end": 330.95, "text": "自拦受死"}, {"start": 331.75, "end": 346.61, "text": "莫怪我"}, {"start": 347.01, "end": 348.21, "text": "秦朗狗头在此"}, {"start": 348.61, "end": 376.37, "text": "请上将军查验"}, {"start": 377.97, "end": 378.57, "text": "上酒"}, {"start": 385.13, "end": 386.13, "text": "谢上将军"}, {"start": 387.53, "end": 387.93, "text": "坐"}, {"start": 388.53, "end": 395.76, "text": "谢上将军"}, {"start": 396.36, "end": 397.16, "text": "郑文大"}, {"start": 397.16, "end": 398.16, "text": "谢上将军"}, {"start": 403.66, "end": 404.46, "text": "郑文大"}, {"start": 405.66, "end": 408.06, "text": "既然你投到我的账项"}, {"start": 408.46, "end": 411.06, "text": "今后咱们就是生死兄弟"}, {"start": 411.26, "end": 413.66, "text": "我这个人没什么别的长处"}, {"start": 413.66, "end": 414.86, "text": "就是重义气"}, {"start": 415.66, "end": 417.06, "text": "喜欢忠勇之士"}, {"start": 418.86, "end": 420.86, "text": "上将军乃蜀汉第一盟将"}, {"start": 421.46, "end": 422.66, "text": "为名遍天下"}, {"start": 423.26, "end": 425.26, "text": "卫军听说上将军在此"}, {"start": 425.66, "end": 427.66, "text": "早已经有恐惧之心了"}, {"start": 428.66, "end": 429.66, "text": "郑文大"}, {"start": 430.06, "end": 431.66, "text": "既然从卫军中来"}, {"start": 432.06, "end": 434.46, "text": "就应该知道司马一的虚实"}, {"start": 434.46, "end": 435.86, "text": "他的龙溪大营"}, {"start": 435.86, "end": 437.66, "text": "现有多少兵马啊"}, {"start": 438.26, "end": 440.46, "text": "龙溪大营共扎有"}, {"start": 440.46, "end": 443.06, "text": "左中右三座大战"}, {"start": 443.26, "end": 444.66, "text": "共计兵马十三万"}, {"start": 445.26, "end": 447.06, "text": "而且都是卫军的精锐"}, {"start": 447.66, "end": 448.66, "text": "不少啊"}, {"start": 450.06, "end": 453.81, "text": "无怪乎司马一"}, {"start": 453.81, "end": 455.21, "text": "敢坚守不出"}, {"start": 456.21, "end": 457.41, "text": "上将军"}, {"start": 457.41, "end": 460.41, "text": "其实司马一早就不在"}, {"start": 460.41, "end": 461.81, "text": "龙溪大营了"}, {"start": 462.21, "end": 463.21, "text": "他在何处"}, {"start": 463.41, "end": 464.81, "text": "他在北渊营中"}, {"start": 465.01, "end": 465.61, "text": "为何"}, {"start": 466.01, "end": 470.14, "text": "司马一料诸个量"}, {"start": 470.54, "end": 472.34, "text": "早晚避过龙中大盗"}, {"start": 473.94, "end": 476.34, "text": "因此他亲自驻守在那儿"}, {"start": 477.34, "end": 478.14, "text": "以观动静"}, {"start": 478.34, "end": 478.74, "text": "还有"}, {"start": 478.74, "end": 480.34, "text": "北渊营中有多少兵马"}, {"start": 480.74, "end": 481.74, "text": "五千铁骑"}, {"start": 481.94, "end": 483.54, "text": "近游司马一之子"}, {"start": 483.54, "end": 484.74, "text": "司马昭统领"}, {"start": 484.94, "end": 485.94, "text": "你听见了吧"}, {"start": 486.34, "end": 487.34, "text": "司马一"}, {"start": 487.34, "end": 488.54, "text": "而我有铁骑两万"}, {"start": 488.94, "end": 495.23, "text": "如果全军"}, {"start": 495.43, "end": 496.83, "text": "攻沙北渊"}, {"start": 497.03, "end": 499.23, "text": "以四机一定可全胜"}, {"start": 499.43, "end": 504.05, "text": "收拾了司马一"}, {"start": 504.25, "end": 505.65, "text": "为全军震动"}, {"start": 506.05, "end": 507.05, "text": "到那时"}, {"start": 508.05, "end": 510.05, "text": "中原就可敷战二地"}, {"start": 513.85, "end": 515.05, "text": "果真如此的话"}, {"start": 515.45, "end": 516.45, "text": "那上将军"}, {"start": 516.65, "end": 518.05, "text": "便是北伐守攻"}, {"start": 519.45, "end": 521.94, "text": "那是"}, {"start": 521.94, "end": 522.94, "text": "北伐守攻"}, {"start": 525.57, "end": 526.37, "text": "那是"}, {"start": 526.37, "end": 527.57, "text": "便是北伐守攻"}, {"start": 528.77, "end": 529.97, "text": "但丞相留有言命"}, {"start": 530.37, "end": 531.37, "text": "他不在的时候"}, {"start": 531.77, "end": 532.97, "text": "三军不可轻动啊"}, {"start": 533.57, "end": 534.57, "text": "待丞相回来"}, {"start": 534.57, "end": 535.97, "text": "那就一无战机了"}, {"start": 536.37, "end": 538.57, "text": "北渊在龙溪之后"}, {"start": 538.97, "end": 540.37, "text": "距此一百五十里"}, {"start": 540.97, "end": 542.77, "text": "我军如是长驱奔袭"}, {"start": 542.97, "end": 543.97, "text": "孤军深入"}, {"start": 544.37, "end": 545.77, "text": "这是不是太过冒险了"}, {"start": 546.97, "end": 548.17, "text": "兵者归齐"}, {"start": 548.57, "end": 550.37, "text": "不入虎穴焉得虎子"}, {"start": 551.97, "end": 552.37, "text": "正位"}, {"start": 552.57, "end": 553.37, "text": "末将在"}, {"start": 553.97, "end": 554.77, "text": "逐你带路"}, {"start": 555.17, "end": 556.57, "text": "绕过魏军的龙溪大营"}, {"start": 556.77, "end": 557.77, "text": "直袭司马一"}, {"start": 557.97, "end": 558.97, "text": "末将领命"}, {"start": 562.22, "end": 562.82, "text": "上将军"}, {"start": 563.02, "end": 564.22, "text": "还是等丞相回来"}, {"start": 564.42, "end": 565.02, "text": "再说吧"}, {"start": 566.02, "end": 567.22, "text": "丞相声信谨慎"}, {"start": 567.42, "end": 569.02, "text": "他即使回营也未必会同意"}, {"start": 573.53, "end": 574.13, "text": "阿得呀"}, {"start": 575.13, "end": 576.33, "text": "你入巨敌"}, {"start": 576.53, "end": 577.73, "text": "就在此守营吧"}, {"start": 578.33, "end": 579.53, "text": "将军这是何话"}, {"start": 579.73, "end": 580.73, "text": "我与你同去"}, {"start": 584.02, "end": 585.02, "text": "众将听令"}, {"start": 585.02, "end": 585.82, "text": "末将在"}, {"start": 586.02, "end": 587.02, "text": "传令全军"}, {"start": 587.62, "end": 589.42, "text": "二更造范 三更起行"}, {"start": 589.62, "end": 590.42, "text": "天亮之前"}, {"start": 590.62, "end": 591.82, "text": "绕过龙溪"}, {"start": 592.22, "end": 593.22, "text": "直去北苑"}, {"start": 593.42, "end": 608.15, "text": "拜见丞相"}, {"start": 610.51, "end": 611.31, "text": "我来介绍"}, {"start": 611.91, "end": 613.71, "text": "这位是我的老友杨夷"}, {"start": 614.11, "end": 615.91, "text": "我请他出参任参军"}, {"start": 616.11, "end": 617.91, "text": "助我办理北伐军事"}, {"start": 618.71, "end": 619.91, "text": "见过参军"}, {"start": 620.51, "end": 622.51, "text": "众将威名 杨某久仰"}, {"start": 622.71, "end": 625.11, "text": "愿与列威将军共襄大业"}, {"start": 625.91, "end": 626.51, "text": "魏炎哪"}, {"start": 626.91, "end": 628.31, "text": "为何不来参见呢"}, {"start": 628.71, "end": 629.51, "text": "回丞相"}, {"start": 629.91, "end": 632.31, "text": "末将在半个时辰以前刚刚得知"}, {"start": 632.51, "end": 633.31, "text": "昨天夜里"}, {"start": 633.51, "end": 635.51, "text": "魏炎将军领着他的本部骑兵"}, {"start": 635.51, "end": 636.71, "text": "奔袭北园去了"}, {"start": 636.71, "end": 637.51, "text": "什么"}, {"start": 638.51, "end": 640.51, "text": "北园巨次近二百里"}, {"start": 640.51, "end": 642.31, "text": "深入敌军腹地"}, {"start": 643.51, "end": 645.51, "text": "他把两万铁骑都带去了吗"}, {"start": 645.91, "end": 646.51, "text": "是"}, {"start": 646.71, "end": 649.91, "text": "究竟发生何事了"}, {"start": 650.71, "end": 651.31, "text": "回丞相"}, {"start": 651.91, "end": 652.51, "text": "三天前"}, {"start": 652.71, "end": 653.71, "text": "魏军偏将郑文"}, {"start": 653.71, "end": 654.71, "text": "迎兵败将战"}, {"start": 655.11, "end": 656.31, "text": "不得已归降了魏炎"}, {"start": 656.91, "end": 657.91, "text": "尚将军怀疑此人"}, {"start": 657.91, "end": 658.91, "text": "是奉司马夷之命"}, {"start": 658.91, "end": 659.71, "text": "前来炸响"}, {"start": 659.91, "end": 660.71, "text": "夷的事"}, {"start": 661.31, "end": 662.11, "text": "接着说"}, {"start": 662.11, "end": 662.51, "text": "诺"}, {"start": 663.31, "end": 663.91, "text": "丞相"}, {"start": 664.31, "end": 665.11, "text": "事情是这样的"}, {"start": 665.31, "end": 668.56, "text": "吾文本是个无名小族"}, {"start": 668.96, "end": 671.16, "text": "其上司秦朗倒是一位小将"}, {"start": 671.56, "end": 672.76, "text": "郑文与其交战"}, {"start": 672.96, "end": 674.36, "text": "两何就斩了秦朗"}, {"start": 674.36, "end": 675.56, "text": "你们相信吗"}, {"start": 675.76, "end": 677.56, "text": "司马夷会这么用人吗"}, {"start": 678.76, "end": 679.56, "text": "照我看"}, {"start": 680.56, "end": 682.76, "text": "不但郑文归降是假"}, {"start": 683.36, "end": 685.36, "text": "只怕你个秦朗也是假的"}, {"start": 685.76, "end": 686.36, "text": "还有"}, {"start": 686.76, "end": 688.56, "text": "连司马夷在北园这事"}, {"start": 688.96, "end": 689.96, "text": "也一定是假的"}, {"start": 690.36, "end": 693.47, "text": "我的天哪"}, {"start": 693.87, "end": 695.27, "text": "若非丞相道破"}, {"start": 695.67, "end": 697.07, "text": "我等都还在梦中"}, {"start": 698.27, "end": 698.87, "text": "丞相"}, {"start": 699.47, "end": 700.87, "text": "魏炎所属两万铁骑"}, {"start": 700.87, "end": 702.07, "text": "皆是我军精锐"}, {"start": 702.47, "end": 703.87, "text": "以后攻长安下洛阳"}, {"start": 703.87, "end": 704.67, "text": "少不得他们"}, {"start": 705.07, "end": 706.07, "text": "如果他们被包围了"}, {"start": 706.07, "end": 707.27, "text": "被司马夷拒奸了"}, {"start": 707.87, "end": 709.67, "text": "那我们的北伐也就结束了"}, {"start": 714.05, "end": 714.45, "text": "这里"}, {"start": 715.65, "end": 717.25, "text": "魏炎前往北园"}, {"start": 717.25, "end": 718.45, "text": "必经紫石谷"}, {"start": 718.85, "end": 721.05, "text": "司马夷肯定会在这里服兵的"}, {"start": 723.47, "end": 724.67, "text": "将为王平听令"}, {"start": 725.07, "end": 725.47, "text": "在"}, {"start": 725.87, "end": 727.27, "text": "你二人率本部骑兵"}, {"start": 727.27, "end": 727.87, "text": "赶往此地"}, {"start": 727.87, "end": 729.07, "text": "反超魏军后路"}, {"start": 729.47, "end": 729.87, "text": "记住"}, {"start": 730.27, "end": 732.07, "text": "司马夷必带重军"}, {"start": 732.67, "end": 734.07, "text": "遇敌不可立战"}, {"start": 734.27, "end": 735.67, "text": "救出魏炎即可"}, {"start": 736.47, "end": 736.87, "text": "遵命"}, {"start": 747.17, "end": 747.77, "text": "郑文"}, {"start": 748.57, "end": 750.17, "text": "此地距北园还有多远"}, {"start": 750.17, "end": 750.97, "text": "禀尚将军"}, {"start": 751.97, "end": 753.17, "text": "还有十五里上下"}, {"start": 757.96, "end": 758.36, "text": "马丹"}, {"start": 758.96, "end": 759.36, "text": "你看"}, {"start": 759.96, "end": 761.36, "text": "此地地形险峻"}, {"start": 761.36, "end": 762.36, "text": "急已藏病"}, {"start": 762.76, "end": 763.56, "text": "传令各营"}, {"start": 763.96, "end": 764.76, "text": "快速通行"}, {"start": 765.36, "end": 765.76, "text": "遵命"}, {"start": 766.96, "end": 767.96, "text": "众军听令"}, {"start": 768.16, "end": 769.16, "text": "快速前行"}, {"start": 769.36, "end": 770.36, "text": "奔出谷地"}, {"start": 770.56, "end": 771.76, "text": "再行歇马"}, {"start": 771.96, "end": 772.96, "text": "快快快"}, {"start": 773.16, "end": 841.72, "text": "快快"}, {"start": 841.92, "end": 843.32, "text": "魏炎那几万铁骑"}, {"start": 843.52, "end": 844.72, "text": "都是蜀军精锐"}, {"start": 845.32, "end": 846.32, "text": "消灭他们之后"}, {"start": 846.72, "end": 848.32, "text": "就像长矛断了矛尖"}, {"start": 848.72, "end": 850.32, "text": "朱阁亮必为之胆寒"}, {"start": 853.96, "end": 856.36, "text": "那个骑黑马的就是魏炎吧"}, {"start": 866.54, "end": 872.14, "text": "十年前"}, {"start": 872.54, "end": 876.15, "text": "朱阁亮在剑阁道射伏"}, {"start": 877.15, "end": 878.95, "text": "又杀了张河将军"}, {"start": 879.15, "end": 882.8, "text": "今日我在此地斩杀魏炎"}, {"start": 883.6, "end": 886.0, "text": "也好告慰张河老将军了"}, {"start": 886.0, "end": 892.97, "text": "快带兵前往虎口"}, {"start": 893.97, "end": 895.37, "text": "不要让魏炎脱身了"}, {"start": 895.97, "end": 896.57, "text": "遵命"}, {"start": 896.97, "end": 904.18, "text": "蜀军援兵到了"}, {"start": 904.18, "end": 905.98, "text": "他们正从侧翼供我防后路"}, {"start": 905.98, "end": 918.67, "text": "这些人是来救援的"}, {"start": 919.27, "end": 920.07, "text": "并无大碍"}, {"start": 920.47, "end": 925.46, "text": "众军一起前往"}, {"start": 925.66, "end": 978.55, "text": "老将有罪"}, {"start": 978.95, "end": 980.15, "text": "请丞相言办"}, {"start": 981.75, "end": 982.15, "text": "丞相"}, {"start": 982.75, "end": 983.75, "text": "此事不怪魏炎"}, {"start": 984.15, "end": 985.35, "text": "是末将立功心切"}, {"start": 985.95, "end": 987.55, "text": "传到他去奔袭司马怡大营的"}, {"start": 988.35, "end": 988.95, "text": "怎么"}, {"start": 989.95, "end": 991.95, "text": "这八十军杖要你来领了"}, {"start": 996.39, "end": 996.79, "text": "丞相"}, {"start": 997.79, "end": 999.39, "text": "魏炎和马戴二位将军"}, {"start": 999.39, "end": 1000.59, "text": "虽然贪攻冒进"}, {"start": 1000.99, "end": 1002.99, "text": "但是在危机时刻并没有慌乱"}, {"start": 1003.19, "end": 1004.39, "text": "而是与我不相和"}, {"start": 1004.59, "end": 1006.39, "text": "共同攻杀了司马怡的后路"}, {"start": 1006.79, "end": 1007.99, "text": "也杀敌尽万的"}, {"start": 1008.19, "end": 1014.82, "text": "丞相啊"}, {"start": 1015.22, "end": 1016.62, "text": "既然魏炎马戴他们"}, {"start": 1016.82, "end": 1018.02, "text": "能够反败为胜"}, {"start": 1018.02, "end": 1018.62, "text": "不妨"}, {"start": 1019.02, "end": 1020.22, "text": "宽恕他们一回吧"}, {"start": 1020.42, "end": 1022.22, "text": "令他们日后将功折罪"}, {"start": 1022.62, "end": 1028.62, "text": "不是看在众人面上"}, {"start": 1029.82, "end": 1031.82, "text": "本相定不轻饶"}, {"start": 1034.02, "end": 1037.02, "text": "八十军杖暂时挂着"}, {"start": 1038.62, "end": 1040.02, "text": "今日教训"}, {"start": 1041.22, "end": 1042.82, "text": "你们可要牢记啊"}, {"start": 1043.22, "end": 1044.42, "text": "多谢丞相"}, {"start": 1049.73, "end": 1050.33, "text": "将尉"}, {"start": 1050.73, "end": 1052.13, "text": "魏军情形如何"}, {"start": 1052.93, "end": 1053.53, "text": "禀丞相"}, {"start": 1053.73, "end": 1054.93, "text": "司马怡已经退回了"}, {"start": 1054.93, "end": 1056.13, "text": "魏北的冷西大营了"}, {"start": 1056.33, "end": 1058.13, "text": "那有三座她精心修筑的大寨"}, {"start": 1058.13, "end": 1059.53, "text": "估计她是见首不站了"}, {"start": 1061.59, "end": 1065.59, "text": "司马怡是天下第一善守大将"}, {"start": 1065.79, "end": 1072.28, "text": "魏炎马戴"}, {"start": 1073.28, "end": 1076.88, "text": "命你二人日日迎兵挑战"}, {"start": 1077.28, "end": 1079.48, "text": "如果设法引出司马怡"}, {"start": 1080.08, "end": 1081.48, "text": "我就恕了你们"}, {"start": 1081.48, "end": 1083.88, "text": "轻军冒进之罪"}, {"start": 1084.48, "end": 1084.88, "text": "遵命"}, {"start": 1087.52, "end": 1088.12, "text": "遵命"}, {"start": 1095.02, "end": 1137.62, "text": "你出来啊"}, {"start": 1137.62, "end": 1138.22, "text": "尚将军"}, {"start": 1139.02, "end": 1140.22, "text": "我们都挑战十来天了"}, {"start": 1140.62, "end": 1141.82, "text": "王玛高子就是不出来"}, {"start": 1142.02, "end": 1146.14, "text": "早就料到了"}, {"start": 1148.29, "end": 1149.29, "text": "司马怡"}, {"start": 1149.89, "end": 1152.29, "text": "她是不会上丞相的当的"}, {"start": 1154.22, "end": 1155.42, "text": "莫说十日"}, {"start": 1156.02, "end": 1158.22, "text": "就是白日她也不会出战"}, {"start": 1161.17, "end": 1161.77, "text": "那怎么办"}, {"start": 1163.68, "end": 1164.48, "text": "没办法"}, {"start": 1165.88, "end": 1166.48, "text": "熬着吧"}, {"start": 1166.88, "end": 1171.13, "text": "丞相令我们在这叫阵"}, {"start": 1172.13, "end": 1174.33, "text": "那就是在熬炼咱们呢"}, {"start": 1176.98, "end": 1177.98, "text": "我是熬不住了"}, {"start": 1178.78, "end": 1180.18, "text": "尚将军你在这儿守着吧"}, {"start": 1180.38, "end": 1180.98, "text": "我会赢了"}, {"start": 1195.58, "end": 1196.18, "text": "丞相"}, {"start": 1197.98, "end": 1198.78, "text": "兄台啊"}, {"start": 1200.18, "end": 1202.78, "text": "烦劳你亲自去一趟魏盈"}, {"start": 1203.98, "end": 1207.58, "text": "把这战书送给司马怡"}, {"start": 1210.68, "end": 1212.68, "text": "还有这盒礼物也一并带上"}, {"start": 1219.61, "end": 1221.61, "text": "如果司马怡收了礼物"}, {"start": 1222.21, "end": 1223.61, "text": "却仍然坚守不战"}, {"start": 1224.01, "end": 1225.01, "text": "该当如何呀"}, {"start": 1225.81, "end": 1227.01, "text": "兄台放心"}, {"start": 1227.61, "end": 1228.81, "text": "此物一到"}, {"start": 1229.41, "end": 1232.41, "text": "司马怡必率军出战"}, {"start": 1243.34, "end": 1243.94, "text": "大多多"}, {"start": 1245.82, "end": 1246.42, "text": "大多多"}, {"start": 1247.02, "end": 1248.82, "text": "蜀军日日在我营前骂阵"}, {"start": 1249.22, "end": 1250.62, "text": "从五更一直骂到日落"}, {"start": 1251.62, "end": 1252.62, "text": "都骂些什么"}, {"start": 1254.42, "end": 1255.62, "text": "什么臭话都骂出来了"}, {"start": 1256.82, "end": 1258.22, "text": "末将学不出口"}, {"start": 1259.02, "end": 1260.22, "text": "让他们骂吧"}, {"start": 1261.62, "end": 1262.82, "text": "骂得越厉害"}, {"start": 1263.62, "end": 1266.02, "text": "说明诸葛亮求战越急"}, {"start": 1267.42, "end": 1269.42, "text": "而我才越来越高兴"}, {"start": 1274.92, "end": 1275.52, "text": "大多多"}, {"start": 1275.72, "end": 1277.12, "text": "诸葛亮派使者前来拜营"}, {"start": 1278.12, "end": 1279.52, "text": "直接冲我来了"}, {"start": 1280.92, "end": 1281.72, "text": "让他进来"}, {"start": 1282.12, "end": 1282.72, "text": "诺"}, {"start": 1283.12, "end": 1285.12, "text": "在下参军杨夷"}, {"start": 1285.32, "end": 1296.58, "text": "奉我家丞相之命"}, {"start": 1296.78, "end": 1299.78, "text": "前来拜见魏国大都督"}, {"start": 1300.98, "end": 1301.58, "text": "杨夷"}, {"start": 1302.38, "end": 1304.18, "text": "朱葛亮让你来做何事"}, {"start": 1304.78, "end": 1306.18, "text": "丞相命在下"}, {"start": 1307.18, "end": 1310.38, "text": "送来战书一封礼物一件"}, {"start": 1310.78, "end": 1311.58, "text": "怕我杀你"}, {"start": 1320.6, "end": 1322.2, "text": "我家丞相说了"}, {"start": 1322.6, "end": 1326.4, "text": "大都督大而勇 智而壮"}, {"start": 1326.8, "end": 1329.8, "text": "立身威如泰山 皮厚"}, {"start": 1330.0, "end": 1331.4, "text": "赛过城墙"}, {"start": 1332.0, "end": 1335.2, "text": "水火不侵 喜怒无形"}, {"start": 1335.6, "end": 1338.8, "text": "因此大都督你断不会"}, {"start": 1339.2, "end": 1340.8, "text": "迁怒来时啊"}, {"start": 1342.0, "end": 1343.8, "text": "知我者诸葛亮也"}, {"start": 1344.6, "end": 1345.4, "text": "拿上来吧"}, {"start": 1356.98, "end": 1359.38, "text": "亮 九慕重达神勇"}, {"start": 1359.38, "end": 1361.18, "text": "统领万众之事"}, {"start": 1361.58, "end": 1364.98, "text": "不料君竟然萎缩首尾狗拳性命"}, {"start": 1364.98, "end": 1366.58, "text": "藏于土窟之中"}, {"start": 1366.58, "end": 1368.18, "text": "与女人何以"}, {"start": 1368.38, "end": 1371.78, "text": "亮 特此赠送金国艳符制"}, {"start": 1371.98, "end": 1373.18, "text": "若不出战"}, {"start": 1373.38, "end": 1375.58, "text": "请君败而受之"}, {"start": 1375.78, "end": 1412.27, "text": "葛亮使我为妇人哪"}, {"start": 1413.47, "end": 1414.07, "text": "孙李"}, {"start": 1414.67, "end": 1438.73, "text": "这身衣服好生鲜艳哪"}, {"start": 1439.73, "end": 1444.13, "text": "却不知大都督何提否"}, {"start": 1482.98, "end": 1483.78, "text": "何提"}, {"start": 1484.38, "end": 1489.38, "text": "恰如杯盏盖子盖在杯盏之上"}, {"start": 1489.78, "end": 1491.58, "text": "言思何风啊"}, {"start": 1492.98, "end": 1497.71, "text": "回去后替我向孔明致谢"}, {"start": 1498.51, "end": 1501.71, "text": "好衣服 好料子 好心意"}, {"start": 1502.91, "end": 1503.71, "text": "遵命"}, {"start": 1505.51, "end": 1507.51, "text": "杨夷乃蜀汉大贤"}, {"start": 1508.31, "end": 1510.31, "text": "你与我相见实属不易"}, {"start": 1511.11, "end": 1511.91, "text": "将酒来"}, {"start": 1512.51, "end": 1514.51, "text": "我要和杨大贤合几招"}, {"start": 1514.71, "end": 1539.42, "text": "杨夷请"}, {"start": 1539.62, "end": 1551.7, "text": "我都不害羞 你害什么羞"}, {"start": 1553.1, "end": 1553.9, "text": "在下"}, {"start": 1554.9, "end": 1556.3, "text": "从来没有见过"}, {"start": 1556.5, "end": 1557.9, "text": "这么鲜艳的衣裳"}, {"start": 1558.3, "end": 1559.9, "text": "照得我眼都花了"}, {"start": 1560.3, "end": 1567.19, "text": "大都督请"}, {"start": 1576.4, "end": 1577.4, "text": "精神如何"}, {"start": 1578.0, "end": 1580.6, "text": "我家丞相身体健康"}, {"start": 1581.4, "end": 1582.4, "text": "精神旺盛"}, {"start": 1582.8, "end": 1586.23, "text": "饮食如何"}, {"start": 1586.83, "end": 1588.03, "text": "睡眠如何"}, {"start": 1588.43, "end": 1589.63, "text": "功务忙碌否"}, {"start": 1592.31, "end": 1593.11, "text": "就是"}, {"start": 1594.11, "end": 1595.51, "text": "睡眠少差些"}, {"start": 1596.71, "end": 1597.71, "text": "我家丞相"}, {"start": 1598.31, "end": 1600.71, "text": "功务禅身 日理万机"}, {"start": 1600.91, "end": 1602.51, "text": "不得片刻闲暇"}, {"start": 1602.91, "end": 1604.51, "text": "少睡而事多"}, {"start": 1604.71, "end": 1605.71, "text": "不能长久"}, {"start": 1606.11, "end": 1609.72, "text": "回去告诉孔明"}, {"start": 1610.32, "end": 1611.32, "text": "人哪"}, {"start": 1612.32, "end": 1614.32, "text": "得先清心寡欲"}, {"start": 1615.32, "end": 1616.92, "text": "方能高枕无忧"}, {"start": 1630.02, "end": 1631.62, "text": "谢大都督"}, {"start": 1632.02, "end": 1634.3, "text": "告辞"}, {"start": 1634.5, "end": 1652.96, "text": "丞相"}, {"start": 1653.76, "end": 1655.76, "text": "司马一收了金国女符"}, {"start": 1655.76, "end": 1656.96, "text": "非但不怒"}, {"start": 1657.36, "end": 1658.96, "text": "反而当场穿在身上"}, {"start": 1659.16, "end": 1660.36, "text": "请我饮酒"}, {"start": 1660.76, "end": 1661.96, "text": "并问我丞相"}, {"start": 1662.16, "end": 1663.76, "text": "饮食睡眠等事"}, {"start": 1664.16, "end": 1665.36, "text": "我具实相告"}, {"start": 1666.16, "end": 1667.36, "text": "司马一说"}, {"start": 1667.96, "end": 1668.76, "text": "人哪"}, {"start": 1669.16, "end": 1671.16, "text": "得先清心寡欲"}, {"start": 1671.56, "end": 1673.16, "text": "方能高枕无忧"}, {"start": 1674.36, "end": 1676.96, "text": "知我者司马一也"}, {"start": 1677.96, "end": 1680.36, "text": "他看破了我的用心啊"}, {"start": 1680.76, "end": 1683.32, "text": "丞相"}, {"start": 1683.92, "end": 1684.92, "text": "军中粮草"}, {"start": 1685.12, "end": 1686.72, "text": "只够五日所用了"}, {"start": 1687.32, "end": 1688.32, "text": "如果司马一"}, {"start": 1688.32, "end": 1689.72, "text": "还是坚守不战"}, {"start": 1689.92, "end": 1690.72, "text": "那我们"}, {"start": 1691.32, "end": 1693.12, "text": "只好缓缓撤军了"}, {"start": 1693.92, "end": 1694.72, "text": "丞相"}, {"start": 1696.12, "end": 1696.92, "text": "丞相"}, {"start": 1698.77, "end": 1700.37, "text": "粮稻可有消息"}, {"start": 1700.77, "end": 1702.17, "text": "我成会计急迟三十余里"}, {"start": 1702.17, "end": 1703.17, "text": "快到祁山脚底下了"}, {"start": 1703.17, "end": 1704.57, "text": "也没有看到粮车的影子"}, {"start": 1704.77, "end": 1714.96, "text": "来信说"}, {"start": 1715.96, "end": 1718.76, "text": "此次穿粮所运甚多"}, {"start": 1720.5, "end": 1724.3, "text": "借粮官由上书令李峰担任"}, {"start": 1724.9, "end": 1727.7, "text": "此人是我亲自举荐的"}, {"start": 1728.5, "end": 1730.9, "text": "他从来不曾误过诗"}, {"start": 1732.3, "end": 1733.1, "text": "丞相"}, {"start": 1733.5, "end": 1735.1, "text": "期限已过三日"}, {"start": 1735.1, "end": 1737.5, "text": "但李峰并未到营啊"}, {"start": 1737.7, "end": 1747.02, "text": "每次北伐都为粮草所苦"}, {"start": 1748.22, "end": 1750.42, "text": "要是荆州还在我们手里"}, {"start": 1750.42, "end": 1751.82, "text": "那该多好啊"}, {"start": 1752.02, "end": 1758.3, "text": "北域战事不顺"}, {"start": 1759.3, "end": 1762.3, "text": "我都不免会想起荆州啊"}, {"start": 1762.9, "end": 1764.3, "text": "在下理解"}, {"start": 1782.39, "end": 1783.79, "text": "请大都督下令"}, {"start": 1783.99, "end": 1785.59, "text": "我等要出营杀敌"}, {"start": 1785.79, "end": 1787.59, "text": "请大都督下令"}, {"start": 1787.79, "end": 1788.59, "text": "且慢"}, {"start": 1789.99, "end": 1790.79, "text": "告诉我"}, {"start": 1791.19, "end": 1792.39, "text": "为何这么激动"}, {"start": 1792.59, "end": 1793.79, "text": "主帅受辱"}, {"start": 1794.79, "end": 1796.19, "text": "三军谋凶"}, {"start": 1797.39, "end": 1798.39, "text": "朱可良竟然"}, {"start": 1798.39, "end": 1800.19, "text": "赶送女人的艳符来"}, {"start": 1801.19, "end": 1803.39, "text": "可大都督居然不以为意"}, {"start": 1804.19, "end": 1805.19, "text": "就这事啊"}, {"start": 1806.39, "end": 1807.79, "text": "区区小事"}, {"start": 1808.39, "end": 1809.79, "text": "何足挂齿"}, {"start": 1810.59, "end": 1811.79, "text": "大都督能忍"}, {"start": 1812.59, "end": 1813.99, "text": "众将不能忍啊"}, {"start": 1813.99, "end": 1815.59, "text": "请大都督下令"}, {"start": 1815.59, "end": 1816.99, "text": "我们愿意出战"}, {"start": 1816.99, "end": 1818.39, "text": "让大都督下令吧"}, {"start": 1827.94, "end": 1829.14, "text": "我早有令在先"}, {"start": 1829.34, "end": 1830.34, "text": "不准出战"}, {"start": 1833.46, "end": 1834.26, "text": "大都督"}, {"start": 1836.06, "end": 1837.66, "text": "恕末将抗命了"}, {"start": 1838.06, "end": 1840.26, "text": "我这就出营杀敌去"}, {"start": 1841.06, "end": 1841.66, "text": "孙离"}, {"start": 1841.86, "end": 1844.78, "text": "你找死吗"}, {"start": 1846.78, "end": 1848.58, "text": "我宁肯死了"}, {"start": 1849.38, "end": 1852.18, "text": "我也不能忍受这种耻辱"}, {"start": 1852.98, "end": 1853.58, "text": "你听着"}, {"start": 1853.78, "end": 1858.09, "text": "可以指涂自己快乐"}, {"start": 1858.69, "end": 1859.69, "text": "但你死后"}, {"start": 1860.09, "end": 1861.29, "text": "不但无功"}, {"start": 1862.09, "end": 1863.49, "text": "我还会上奏朝廷"}, {"start": 1864.09, "end": 1865.49, "text": "以叛将之罪"}, {"start": 1866.89, "end": 1868.09, "text": "朝廷必然剥夺你"}, {"start": 1868.09, "end": 1869.29, "text": "全部功名俸禄"}, {"start": 1871.09, "end": 1872.29, "text": "你的父母妻儿"}, {"start": 1872.69, "end": 1874.69, "text": "将会为你蒙受耻辱"}, {"start": 1875.29, "end": 1876.89, "text": "被朝廷发配到边疆"}, {"start": 1876.89, "end": 1877.89, "text": "被贬为奴"}, {"start": 1878.49, "end": 1879.89, "text": "终生回不了京都"}, {"start": 1884.49, "end": 1904.66, "text": "李将军"}, {"start": 1908.41, "end": 1909.81, "text": "一定要相信本都"}, {"start": 1910.81, "end": 1911.81, "text": "坚守不战"}, {"start": 1912.01, "end": 1914.01, "text": "恰恰就是至上之道"}, {"start": 1914.21, "end": 1916.54, "text": "毕将"}, {"start": 1917.14, "end": 1918.74, "text": "只助个量于死地"}, {"start": 1926.54, "end": 1927.14, "text": "诺"}, {"start": 1927.14, "end": 1927.94, "text": "诺"}, {"start": 1928.74, "end": 1929.74, "text": "为什么停下"}, {"start": 1933.54, "end": 1934.34, "text": "前面怎么回事"}, {"start": 1934.74, "end": 1935.34, "text": "禀大人"}, {"start": 1935.54, "end": 1936.54, "text": "道路全让沙石冲塌了"}, {"start": 1936.54, "end": 1937.14, "text": "什么"}, {"start": 1937.94, "end": 1938.54, "text": "大人你看"}, {"start": 1938.94, "end": 1940.34, "text": "这里在那天下了一场暴雨"}, {"start": 1940.74, "end": 1941.54, "text": "道路全塌了"}, {"start": 1942.94, "end": 1944.34, "text": "留下一百人看守粮食"}, {"start": 1944.94, "end": 1946.54, "text": "其余的人全部跟我上去"}, {"start": 1946.54, "end": 1947.34, "text": "抢修栈道"}, {"start": 1947.74, "end": 1948.34, "text": "大人"}, {"start": 1948.94, "end": 1949.94, "text": "咱们人本来就不多"}, {"start": 1950.14, "end": 1950.74, "text": "再说"}, {"start": 1950.74, "end": 1951.94, "text": "也没有开山的工具啊"}, {"start": 1956.62, "end": 1957.82, "text": "就该走剑阁小道"}, {"start": 1958.02, "end": 1959.82, "text": "该走剑阁小道要过百丈山"}, {"start": 1960.02, "end": 1961.02, "text": "那里道路戏区"}, {"start": 1961.02, "end": 1961.82, "text": "山路险峻"}, {"start": 1962.02, "end": 1963.22, "text": "这粮食根本过不去啊"}, {"start": 1963.22, "end": 1964.62, "text": "那咱们得靠人扛啊"}, {"start": 1965.22, "end": 1965.82, "text": "就这么定了"}, {"start": 1966.62, "end": 1967.62, "text": "能扛多少吃多少"}, {"start": 1969.22, "end": 1969.62, "text": "遵命"}, {"start": 1970.62, "end": 1971.62, "text": "兄弟们听着"}, {"start": 1971.82, "end": 1973.42, "text": "该走剑阁小道"}, {"start": 1985.7, "end": 1986.3, "text": "丞相"}, {"start": 1988.85, "end": 1989.65, "text": "立风啊"}, {"start": 1990.25, "end": 1992.05, "text": "总算把你盼来了"}, {"start": 1993.05, "end": 1994.65, "text": "军粮运到了吧"}, {"start": 1996.05, "end": 1996.65, "text": "丞相"}, {"start": 1997.25, "end": 1998.25, "text": "栈道被冲坏了"}, {"start": 1999.05, "end": 2000.25, "text": "下官带领军士们"}, {"start": 2000.85, "end": 2001.85, "text": "坚扛人体"}, {"start": 2002.45, "end": 2003.65, "text": "历经千般万苦"}, {"start": 2004.25, "end": 2005.45, "text": "终于扛过来军粮"}, {"start": 2005.45, "end": 2006.25, "text": "五千余弹"}, {"start": 2007.25, "end": 2008.05, "text": "八个军师"}, {"start": 2008.45, "end": 2009.25, "text": "跌落山崖"}, {"start": 2009.65, "end": 2014.38, "text": "损害得严重吗"}, {"start": 2015.38, "end": 2016.58, "text": "下官仔细查探过"}, {"start": 2017.18, "end": 2018.38, "text": "总共损坏的山道"}, {"start": 2018.58, "end": 2019.18, "text": "十四里"}, {"start": 2020.58, "end": 2021.38, "text": "若要修复"}, {"start": 2021.78, "end": 2022.78, "text": "非要来年不可"}, {"start": 2023.18, "end": 2025.54, "text": "丞相"}, {"start": 2026.14, "end": 2027.34, "text": "这栈道已断"}, {"start": 2027.54, "end": 2029.14, "text": "粮车则不能通行"}, {"start": 2029.34, "end": 2030.14, "text": "只能靠人"}, {"start": 2030.34, "end": 2032.14, "text": "背着粮食走剑阁道"}, {"start": 2032.14, "end": 2033.34, "text": "翻越百丈山"}, {"start": 2033.94, "end": 2034.54, "text": "这样"}, {"start": 2034.54, "end": 2037.14, "text": "一天最多也就能运来几百弹"}, {"start": 2037.14, "end": 2038.14, "text": "无论如何"}, {"start": 2038.14, "end": 2040.14, "text": "也不够大军用度的呀"}, {"start": 2041.54, "end": 2045.74, "text": "苍天诛草不诛寒哪"}, {"start": 2047.74, "end": 2048.34, "text": "丞相"}, {"start": 2050.66, "end": 2051.26, "text": "是的"}, {"start": 2055.0, "end": 2055.6, "text": "丞相"}, {"start": 2056.8, "end": 2059.4, "text": "我们还是缓缓撤回寒中吧"}, {"start": 2059.4, "end": 2060.0, "text": "否则"}, {"start": 2060.6, "end": 2062.0, "text": "营中断粮后再走"}, {"start": 2062.4, "end": 2063.4, "text": "就难了"}, {"start": 2064.4, "end": 2066.0, "text": "不能撤军啊"}, {"start": 2067.0, "end": 2069.2, "text": "大军进出一趟西山"}, {"start": 2069.4, "end": 2071.2, "text": "诛多不易呀"}, {"start": 2073.14, "end": 2073.74, "text": "李峰啊"}, {"start": 2074.14, "end": 2076.72, "text": "你夜间"}, {"start": 2077.32, "end": 2079.92, "text": "能扛多少粮过百丈山哪"}, {"start": 2080.52, "end": 2081.52, "text": "哪怕日夜不出"}, {"start": 2082.72, "end": 2083.92, "text": "也只能扛千丹上下"}, {"start": 2084.72, "end": 2085.32, "text": "若果"}, {"start": 2086.12, "end": 2087.92, "text": "给你添拨几千军士"}, {"start": 2087.92, "end": 2088.92, "text": "可以多运些吗"}, {"start": 2089.32, "end": 2090.32, "text": "山道崎岖险峻"}, {"start": 2091.12, "end": 2091.92, "text": "只有池水困"}, {"start": 2092.52, "end": 2093.52, "text": "人多并无用处"}, {"start": 2094.12, "end": 2098.32, "text": "我有办法了"}, {"start": 2099.32, "end": 2100.52, "text": "我有办法了"}, {"start": 2100.92, "end": 2113.14, "text": "杨夷啊"}, {"start": 2113.14, "end": 2119.13, "text": "劳给军营中的工匠"}, {"start": 2119.73, "end": 2120.93, "text": "让他们赵徒"}, {"start": 2121.13, "end": 2122.33, "text": "打造三百架"}, {"start": 2122.33, "end": 2123.53, "text": "用来运粮"}, {"start": 2124.13, "end": 2126.74, "text": "丞相"}, {"start": 2127.54, "end": 2128.54, "text": "这是何物啊"}, {"start": 2129.14, "end": 2130.14, "text": "又像是车"}, {"start": 2130.74, "end": 2131.94, "text": "又像是牛马"}, {"start": 2131.94, "end": 2133.34, "text": "这叫木牛"}, {"start": 2134.79, "end": 2137.59, "text": "可以行驶于崎岖的山路"}, {"start": 2139.19, "end": 2140.59, "text": "二十五年前"}, {"start": 2141.59, "end": 2144.39, "text": "我在卧龙岗时就设计出来"}, {"start": 2145.59, "end": 2148.59, "text": "原以为到中原打仗用不到它"}, {"start": 2148.99, "end": 2149.79, "text": "没想到"}, {"start": 2150.19, "end": 2153.79, "text": "今日竟然用于剑阁山道啊"}, {"start": 2154.59, "end": 2154.99, "text": "好"}, {"start": 2155.99, "end": 2156.79, "text": "这就好了"}, {"start": 2156.99, "end": 2158.9, "text": "丞相"}, {"start": 2159.7, "end": 2160.5, "text": "我这就去"}, {"start": 2161.7, "end": 2162.9, "text": "打造三百架"}, {"start": 2163.3, "end": 2166.95, "text": "少坦化妆深入旗山"}, {"start": 2166.95, "end": 2168.15, "text": "他们看得清清楚楚"}, {"start": 2168.35, "end": 2170.15, "text": "剑阁站道被冲回几十里"}, {"start": 2170.35, "end": 2172.15, "text": "蜀军只能背梁过百丈山"}, {"start": 2172.15, "end": 2173.55, "text": "实有赘颜二四正"}, {"start": 2174.95, "end": 2176.75, "text": "他们费了九牛二虎之力"}, {"start": 2176.75, "end": 2178.35, "text": "才扛过了几千单粮"}, {"start": 2178.75, "end": 2180.55, "text": "现都囤在山外的驹马寨中"}, {"start": 2183.15, "end": 2184.75, "text": "翻山扛粮"}, {"start": 2185.95, "end": 2188.95, "text": "短短不足以养活三十万大军哪"}, {"start": 2189.15, "end": 2190.15, "text": "如此看来"}, {"start": 2190.55, "end": 2192.95, "text": "这蜀军只能喝西州了吧"}, {"start": 2194.35, "end": 2195.15, "text": "长此以往"}, {"start": 2195.35, "end": 2197.35, "text": "军无斗志 民无战心"}, {"start": 2197.55, "end": 2198.75, "text": "必生变乱哪"}, {"start": 2199.95, "end": 2202.55, "text": "应该让他们连粥也喝不成"}, {"start": 2205.49, "end": 2206.69, "text": "司马昭听令"}, {"start": 2207.09, "end": 2207.89, "text": "末将在"}, {"start": 2209.49, "end": 2211.69, "text": "亲率五千赶战之事"}, {"start": 2212.49, "end": 2214.09, "text": "扶于驹马寨附近"}, {"start": 2215.09, "end": 2216.29, "text": "等寨中蜀军"}, {"start": 2216.49, "end": 2218.89, "text": "转运粮食于旗山大营时"}, {"start": 2219.09, "end": 2220.29, "text": "就大特个福气"}, {"start": 2220.49, "end": 2222.89, "text": "连驹马寨一并烧掉"}, {"start": 2224.09, "end": 2224.69, "text": "遵命"}, {"start": 2227.71, "end": 2230.51, "text": "这里面会不会有诸葛亮的奸计"}, {"start": 2231.31, "end": 2232.31, "text": "什么奸计"}, {"start": 2233.11, "end": 2233.91, "text": "比如"}, {"start": 2234.51, "end": 2235.31, "text": "比如说"}, {"start": 2235.71, "end": 2238.11, "text": "剑阁栈道是诸葛亮自己毁掉的"}, {"start": 2238.51, "end": 2239.71, "text": "以此诱我出军呢"}, {"start": 2240.51, "end": 2241.91, "text": "想法很深远"}, {"start": 2242.91, "end": 2244.51, "text": "可你也不必多虑了"}, {"start": 2245.51, "end": 2247.71, "text": "诸葛亮什么都敢拿来诱我"}, {"start": 2248.31, "end": 2250.91, "text": "唯独这剑阁栈道他断然不敢"}, {"start": 2251.51, "end": 2252.71, "text": "毁了剑阁栈道"}, {"start": 2253.91, "end": 2255.71, "text": "就算蜀军打赢咱们"}, {"start": 2256.11, "end": 2257.51, "text": "蜀军也得饿死"}, {"start": 2258.91, "end": 2260.11, "text": "你放心前去吧"}, {"start": 2260.31, "end": 2260.91, "text": "遵命"}, {"start": 2263.02, "end": 2265.42, "text": "末将愿和少将军一同前往"}, {"start": 2265.82, "end": 2266.42, "text": "主人"}, {"start": 2266.62, "end": 2290.53, "text": "蜀军俩车来了"}, {"start": 2302.89, "end": 2304.09, "text": "飞车飞船"}, {"start": 2304.29, "end": 2305.49, "text": "飞驴飞马的"}, {"start": 2306.29, "end": 2307.29, "text": "还能用来运粮"}, {"start": 2312.14, "end": 2313.34, "text": "蜀军兵士不多"}, {"start": 2313.54, "end": 2316.54, "text": "不可大意"}, {"start": 2317.54, "end": 2319.54, "text": "我看我们最好分成两步"}, {"start": 2319.74, "end": 2320.74, "text": "一步负责冲杀"}, {"start": 2320.74, "end": 2321.74, "text": "一步担任援军"}, {"start": 2321.94, "end": 2322.74, "text": "以防不测"}, {"start": 2322.94, "end": 2323.54, "text": "好"}, {"start": 2323.94, "end": 2325.14, "text": "少将军为援军"}, {"start": 2325.34, "end": 2326.34, "text": "我引军杀过去"}, {"start": 2330.07, "end": 2330.67, "text": "孙离"}, {"start": 2332.27, "end": 2333.07, "text": "你要记住"}, {"start": 2334.07, "end": 2335.07, "text": "只可冲杀"}, {"start": 2335.27, "end": 2336.07, "text": "不能追击"}, {"start": 2337.07, "end": 2337.67, "text": "另外"}, {"start": 2338.27, "end": 2340.07, "text": "最好能夺回几两大怪物"}, {"start": 2340.27, "end": 2341.27, "text": "带回去呈给大都督"}, {"start": 2357.84, "end": 2358.24, "text": "来慢点"}, {"start": 2358.24, "end": 2359.04, "text": "兄弟们"}, {"start": 2359.24, "end": 2381.08, "text": "给我杀"}, {"start": 2381.08, "end": 2381.68, "text": "你来看"}, {"start": 2381.68, "end": 2382.68, "text": "大都督"}, {"start": 2384.81, "end": 2386.01, "text": "末将亲眼所见"}, {"start": 2386.61, "end": 2388.61, "text": "蜀军就是用这么个玩意运粮草"}, {"start": 2395.02, "end": 2396.82, "text": "此物可在上千斤粮草"}, {"start": 2398.22, "end": 2399.82, "text": "旗下却只有一个轮子"}, {"start": 2400.82, "end": 2402.02, "text": "只要人能过的山路"}, {"start": 2402.22, "end": 2403.02, "text": "他都能过"}, {"start": 2403.42, "end": 2405.02, "text": "我和少将军一个都没给他们留"}, {"start": 2405.62, "end": 2406.42, "text": "全部拿回来了"}, {"start": 2422.44, "end": 2426.69, "text": "这物看起来沉重"}, {"start": 2427.49, "end": 2429.29, "text": "用起来真是轻便啊"}, {"start": 2429.69, "end": 2433.38, "text": "这两针一人哪"}, {"start": 2434.58, "end": 2436.38, "text": "能设计出这等怪物来"}, {"start": 2438.78, "end": 2440.38, "text": "或许不是朱国亮设计的"}, {"start": 2441.18, "end": 2441.98, "text": "山野林下"}, {"start": 2442.18, "end": 2443.58, "text": "何处没有异事怪节"}, {"start": 2445.18, "end": 2445.78, "text": "是吗"}, {"start": 2447.78, "end": 2450.38, "text": "那异事怪节为何不投靠位"}, {"start": 2450.38, "end": 2452.18, "text": "反而投靠蜀呢"}, {"start": 2452.98, "end": 2453.58, "text": "国怀啊"}, {"start": 2460.27, "end": 2460.87, "text": "在"}, {"start": 2461.27, "end": 2462.27, "text": "传令工匠"}, {"start": 2462.67, "end": 2464.47, "text": "熟悉此物 用以运粮"}, {"start": 2465.27, "end": 2465.87, "text": "遵命"}]