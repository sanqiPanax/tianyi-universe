[{"start": 7.57, "end": 173.28, "text": "这都是你的老熟人,说说吧,谁主使你的?"}, {"start": 173.28, "end": 175.28, "text": "国贼。"}, {"start": 175.28, "end": 183.47, "text": "你原本有十根手指,怎么变成九根了呢?"}, {"start": 183.47, "end": 190.17, "text": "脚趾为势,是,是杀国贼。"}, {"start": 190.17, "end": 194.17, "text": "好一个,脚趾为势。"}, {"start": 194.17, "end": 199.17, "text": "来啊。"}, {"start": 199.17, "end": 200.17, "text": "在。"}, {"start": 200.17, "end": 202.17, "text": "将他剩下的手指全部斩去,"}, {"start": 202.17, "end": 204.17, "text": "看他还有何可教。"}, {"start": 204.17, "end": 205.17, "text": "诺。"}, {"start": 205.17, "end": 208.17, "text": "我就是没了手指,"}, {"start": 208.17, "end": 214.34, "text": "仍然有口可以吞贼,"}, {"start": 214.34, "end": 217.34, "text": "有舌可以骂贼。"}, {"start": 217.34, "end": 220.34, "text": "割掉他的舌头,砸掉他的牙齿。"}, {"start": 220.34, "end": 222.34, "text": "诺。"}, {"start": 224.34, "end": 252.05, "text": "董成,你的病可好点了吗?"}, {"start": 252.05, "end": 257.67, "text": "看来一剂药还不够,还得再来一剂。"}, {"start": 257.67, "end": 261.05, "text": "来啊,带上来。"}, {"start": 261.05, "end": 262.05, "text": "诺。"}, {"start": 262.05, "end": 277.3, "text": "庆彤,把你听到的给大伙说说。"}, {"start": 277.3, "end": 279.3, "text": "奴,奴才遵命。"}, {"start": 279.3, "end": 281.3, "text": "前天晚上,奴才经过主子的上房,"}, {"start": 281.3, "end": 284.3, "text": "在窗外听见主子和太医急评商量,"}, {"start": 284.3, "end": 288.3, "text": "商量要在丞相的糖药里下毒。"}, {"start": 288.3, "end": 290.3, "text": "贱奴。"}, {"start": 290.3, "end": 293.3, "text": "骂得好,这个奴才是贱。"}, {"start": 293.3, "end": 294.3, "text": "曹贼。"}, {"start": 294.3, "end": 297.3, "text": "事已至此,我别无所求,"}, {"start": 297.3, "end": 301.73, "text": "只求速死。"}, {"start": 301.73, "end": 304.73, "text": "不急,不急。"}, {"start": 304.73, "end": 307.73, "text": "我都不着急,你着什么急呢?"}, {"start": 307.73, "end": 309.73, "text": "我还有话要问你。"}, {"start": 309.73, "end": 311.73, "text": "庆彤,"}, {"start": 311.73, "end": 313.73, "text": "你的主子说你贱,"}, {"start": 313.73, "end": 318.3, "text": "你自个儿说你贱不贱。"}, {"start": 318.3, "end": 320.3, "text": "奴才,奴才。"}, {"start": 320.3, "end": 322.3, "text": "你贱。"}, {"start": 322.3, "end": 323.3, "text": "因为你,"}, {"start": 323.3, "end": 325.3, "text": "奴才,"}, {"start": 325.3, "end": 327.3, "text": "你贱。"}, {"start": 327.3, "end": 332.3, "text": "因为你犯了两条大罪。"}, {"start": 332.3, "end": 333.3, "text": "其一,"}, {"start": 333.3, "end": 335.3, "text": "身为奴才,"}, {"start": 335.3, "end": 338.3, "text": "你却与主子的小妾通奸。"}, {"start": 338.3, "end": 340.3, "text": "其二,"}, {"start": 340.3, "end": 342.3, "text": "你身为奴才,"}, {"start": 342.3, "end": 344.3, "text": "却隔窗偷听主子谈话,"}, {"start": 344.3, "end": 345.3, "text": "这还不算。"}, {"start": 345.3, "end": 348.3, "text": "还跑来向我告密。"}, {"start": 348.3, "end": 353.3, "text": "你这不是卖主丘容吗?"}, {"start": 353.3, "end": 356.3, "text": "这两桩大罪的任何一桩"}, {"start": 356.3, "end": 359.3, "text": "都可以让你碎尸万段。"}, {"start": 359.3, "end": 361.3, "text": "东城,"}, {"start": 361.3, "end": 363.3, "text": "看来你是有眼无珠啊,"}, {"start": 363.3, "end": 365.3, "text": "竟然养出这种奴才,"}, {"start": 365.3, "end": 367.3, "text": "还不如养一条赖皮狗。"}, {"start": 367.3, "end": 369.3, "text": "你说对不对?"}, {"start": 369.3, "end": 371.3, "text": "是。"}, {"start": 371.3, "end": 372.3, "text": "是。"}, {"start": 372.3, "end": 375.54, "text": "老杨。"}, {"start": 375.54, "end": 376.54, "text": "在。"}, {"start": 376.54, "end": 379.54, "text": "即刻把这个奴才拉下去,"}, {"start": 379.54, "end": 380.54, "text": "斩首。"}, {"start": 380.54, "end": 381.54, "text": "诺。"}, {"start": 381.54, "end": 382.54, "text": "丞相,我救了你,"}, {"start": 382.54, "end": 383.54, "text": "为何还要杀我呀?"}, {"start": 383.54, "end": 384.54, "text": "丞相!"}, {"start": 384.54, "end": 385.54, "text": "饶命啊!"}, {"start": 385.54, "end": 386.54, "text": "丞相!"}, {"start": 386.54, "end": 387.54, "text": "饶命啊!"}, {"start": 387.54, "end": 388.54, "text": "丞相!"}, {"start": 388.54, "end": 389.54, "text": "饶命啊!"}, {"start": 389.54, "end": 391.54, "text": "各位都看见了吧?"}, {"start": 393.54, "end": 395.54, "text": "我曹操虽狠,"}, {"start": 395.54, "end": 397.54, "text": "却正邪分明。"}, {"start": 397.54, "end": 399.54, "text": "你们说对不对啊?"}, {"start": 399.54, "end": 402.54, "text": "丞相说得极是。"}, {"start": 402.54, "end": 404.54, "text": "丞相说得极是。"}, {"start": 404.54, "end": 406.54, "text": "东城,"}, {"start": 406.54, "end": 408.54, "text": "拿出来吧。"}, {"start": 408.54, "end": 412.54, "text": "把玉带诏拿出来吧。"}, {"start": 413.54, "end": 415.54, "text": "什么玉带诏?"}, {"start": 415.54, "end": 419.54, "text": "就是陛下藏在玉带里的雪诏。"}, {"start": 419.54, "end": 421.54, "text": "你以为我不知道吗?"}, {"start": 421.54, "end": 425.94, "text": "没有。"}, {"start": 425.94, "end": 427.94, "text": "万万没有。"}, {"start": 433.03, "end": 436.03, "text": "丞相,这是在东城府中送出来的。"}, {"start": 442.74, "end": 450.58, "text": "这都是拿纸写签的名啊。"}, {"start": 450.58, "end": 452.58, "text": "车骑将军,"}, {"start": 452.58, "end": 454.58, "text": "东城,"}, {"start": 454.58, "end": 456.58, "text": "西梁太守,"}, {"start": 456.58, "end": 458.58, "text": "马腾,"}, {"start": 458.58, "end": 460.58, "text": "长水校尉,"}, {"start": 460.58, "end": 462.58, "text": "总记,"}, {"start": 462.58, "end": 464.58, "text": "左将军刘备。"}, {"start": 464.58, "end": 468.5, "text": "果然有这个奸贼。"}, {"start": 468.5, "end": 477.41, "text": "我非得把他碎尸万段不可。"}, {"start": 477.41, "end": 549.1, "text": "来,喝酒。"}, {"start": 549.1, "end": 555.07, "text": "爱妃!"}, {"start": 555.07, "end": 578.74, "text": "爱妃!"}, {"start": 578.74, "end": 584.7, "text": "东城谋反你知道吗?"}, {"start": 584.7, "end": 586.7, "text": "破纸修照的事,"}, {"start": 586.7, "end": 590.98, "text": "你这么快就忘了?"}, {"start": 590.98, "end": 592.98, "text": "那是我做的事,"}, {"start": 592.98, "end": 594.98, "text": "不关陛下的事。"}, {"start": 594.98, "end": 599.98, "text": "你是董臣的女儿吗?"}, {"start": 599.98, "end": 601.98, "text": "你们父女何谋?"}, {"start": 601.98, "end": 612.08, "text": "陛下,"}, {"start": 612.08, "end": 615.68, "text": "倾听臣的一句忠告,"}, {"start": 615.68, "end": 617.68, "text": "这回的事,"}, {"start": 617.68, "end": 619.68, "text": "我只处置董非一人,"}, {"start": 619.68, "end": 623.06, "text": "但是如果还有下回,"}, {"start": 623.06, "end": 653.41, "text": "爱卿,爱卿,"}, {"start": 653.41, "end": 655.41, "text": "董非一有身孕,"}, {"start": 655.41, "end": 668.99, "text": "能不能等他生下皇子在?"}, {"start": 668.99, "end": 670.99, "text": "你是想让那个逆子将来为母报仇吗?"}, {"start": 670.99, "end": 768.26, "text": "陛下知道他是谁吗?"}, {"start": 768.26, "end": 773.68, "text": "朕当然知道,"}, {"start": 773.68, "end": 775.68, "text": "他是爱卿的女儿,"}, {"start": 775.68, "end": 806.42, "text": "朕的曹妃。"}, {"start": 806.42, "end": 808.42, "text": "陛下喜欢他吗?"}, {"start": 808.42, "end": 812.02, "text": "朕喜欢他。"}, {"start": 812.02, "end": 817.31, "text": "喜欢就好,"}, {"start": 817.31, "end": 819.31, "text": "中宫不可空虚,"}, {"start": 819.31, "end": 821.31, "text": "陛下不可无后,"}, {"start": 821.31, "end": 823.31, "text": "曹妃贤德,"}, {"start": 823.31, "end": 825.31, "text": "请陛下立曹妃为后。"}, {"start": 825.31, "end": 859.98, "text": "朕"}, {"start": 859.98, "end": 861.98, "text": "册封曹妃为"}, {"start": 861.98, "end": 865.33, "text": "中宫皇后。"}, {"start": 865.33, "end": 884.64, "text": "吾皇万岁!"}, {"start": 884.64, "end": 974.96, "text": "吾宗天领,"}, {"start": 974.96, "end": 976.96, "text": "朝廷不幸,"}, {"start": 976.96, "end": 978.96, "text": "陆巍四律,"}, {"start": 978.96, "end": 980.96, "text": "贵妃惨遭徒毒,"}, {"start": 980.96, "end": 982.96, "text": "中臣"}, {"start": 982.96, "end": 984.96, "text": "引恨久久,"}, {"start": 984.96, "end": 986.96, "text": "刘备尚不能安邦"}, {"start": 986.96, "end": 988.96, "text": "兴国,"}, {"start": 988.96, "end": 990.96, "text": "下不能剿贼出海,"}, {"start": 990.96, "end": 992.96, "text": "苦冬日月,"}, {"start": 992.96, "end": 994.96, "text": "痛断干场,"}, {"start": 994.96, "end": 996.96, "text": "刘备今此"}, {"start": 996.96, "end": 998.96, "text": "焚香告天。"}, {"start": 998.96, "end": 1000.96, "text": "臣与那曹贼"}, {"start": 1000.96, "end": 1002.96, "text": "势不两立,"}, {"start": 1002.96, "end": 1004.96, "text": "宁愿赴汤蹈火,"}, {"start": 1004.96, "end": 1006.2, "text": "狗认奸贼"}, {"start": 1020.9, "end": 1021.7, "text": "曹军来了"}, {"start": 1047.1, "end": 1047.94, "text": "准备好了吗"}, {"start": 1048.3, "end": 1050.06, "text": "末将 只等主公令下"}, {"start": 1053.97, "end": 1056.21, "text": "袁绍大军也据此不远了"}, {"start": 1057.17, "end": 1058.77, "text": "你进入袁军大营后"}, {"start": 1059.37, "end": 1060.61, "text": "不要先去见袁绍"}, {"start": 1061.45, "end": 1062.57, "text": "去见许忧"}, {"start": 1063.17, "end": 1065.49, "text": "许忧乃袁绍心腹谋臣"}, {"start": 1065.85, "end": 1066.81, "text": "具足轻重"}, {"start": 1067.45, "end": 1069.53, "text": "你见到他后跟他道明原位"}, {"start": 1070.05, "end": 1071.37, "text": "得到他的支持以后"}, {"start": 1071.45, "end": 1072.45, "text": "再去见袁绍"}, {"start": 1072.97, "end": 1075.05, "text": "如此 把握会更大些"}, {"start": 1075.65, "end": 1076.25, "text": "明白了"}, {"start": 1081.42, "end": 1083.06, "text": "善战者一往无前"}, {"start": 1083.54, "end": 1085.38, "text": "善谋者瞻前顾后"}, {"start": 1085.86, "end": 1086.82, "text": "此次出征"}, {"start": 1086.82, "end": 1088.42, "text": "丞相动用了全部精锐"}, {"start": 1088.86, "end": 1090.54, "text": "延州几乎是一座空城"}, {"start": 1090.82, "end": 1091.82, "text": "据少探报"}, {"start": 1091.82, "end": 1093.18, "text": "袁绍的数十万大军"}, {"start": 1093.18, "end": 1095.14, "text": "已经进铸关渡 虎视延州"}, {"start": 1095.78, "end": 1097.3, "text": "如果袁绍聪明的话"}, {"start": 1097.3, "end": 1099.54, "text": "令数万仪兵在正面牵制我们"}, {"start": 1099.7, "end": 1100.9, "text": "自己亲率近旅"}, {"start": 1100.9, "end": 1102.06, "text": "及攻我们的后方"}, {"start": 1102.3, "end": 1103.58, "text": "则许昌堪威啊"}, {"start": 1103.86, "end": 1105.14, "text": "一旦许昌有失"}, {"start": 1105.22, "end": 1106.98, "text": "我们将败无可归"}, {"start": 1106.98, "end": 1108.02, "text": "失去根据啊"}, {"start": 1108.26, "end": 1109.82, "text": "此一招对袁绍"}, {"start": 1110.22, "end": 1111.54, "text": "难道不是上策吗"}, {"start": 1112.02, "end": 1113.26, "text": "确实是上策"}, {"start": 1113.86, "end": 1115.18, "text": "但对袁绍来讲"}, {"start": 1115.18, "end": 1116.14, "text": "那就未必了"}, {"start": 1116.66, "end": 1118.74, "text": "袁绍是个多余寡断之主"}, {"start": 1119.02, "end": 1121.02, "text": "他进而畏惧 退而贪力"}, {"start": 1121.26, "end": 1122.86, "text": "临敌时是五分把握"}, {"start": 1122.86, "end": 1124.7, "text": "他不占七分把握也不占"}, {"start": 1124.7, "end": 1126.22, "text": "非等到十分把握了"}, {"start": 1126.22, "end": 1127.34, "text": "他才全力以战"}, {"start": 1128.78, "end": 1130.38, "text": "军机瞬息万变"}, {"start": 1130.38, "end": 1132.18, "text": "哪有十分把握的机会"}, {"start": 1132.58, "end": 1135.06, "text": "我料如果丞相在十日之内"}, {"start": 1135.06, "end": 1136.18, "text": "拿下渠州城"}, {"start": 1136.3, "end": 1138.18, "text": "袁绍不敢轻举望"}, {"start": 1138.62, "end": 1139.5, "text": "恕我直言"}, {"start": 1140.18, "end": 1142.46, "text": "你看渠州城如此坚实"}, {"start": 1142.46, "end": 1144.22, "text": "十日之内能拿下吗"}, {"start": 1144.54, "end": 1145.46, "text": "不可能"}, {"start": 1146.18, "end": 1148.74, "text": "再者 袁绍多余寡断"}, {"start": 1149.06, "end": 1151.46, "text": "可他身边不乏制谋之势啊"}, {"start": 1151.9, "end": 1153.22, "text": "天封许忧等人"}, {"start": 1153.42, "end": 1155.14, "text": "难道看不出胜机所在"}, {"start": 1155.38, "end": 1156.74, "text": "他们不会建议袁绍"}, {"start": 1156.74, "end": 1157.58, "text": "回攻衍州"}, {"start": 1158.18, "end": 1159.98, "text": "那就看我们的衍州将士"}, {"start": 1160.34, "end": 1161.86, "text": "能够坚守到多久"}, {"start": 1162.02, "end": 1163.5, "text": "如果坚守到丞相"}, {"start": 1163.98, "end": 1165.94, "text": "能一举攻下渠州城"}, {"start": 1165.94, "end": 1167.46, "text": "那我们就是南北双线"}, {"start": 1167.46, "end": 1168.66, "text": "双获胜利"}, {"start": 1170.46, "end": 1171.42, "text": "如果不能的话"}, {"start": 1171.42, "end": 1171.82, "text": "先生"}, {"start": 1171.82, "end": 1172.3, "text": "那就"}, {"start": 1172.5, "end": 1173.3, "text": "如果"}, {"start": 1174.34, "end": 1176.1, "text": "拿不下这渠州"}, {"start": 1176.66, "end": 1178.06, "text": "那我们将退屋根据"}, {"start": 1179.92, "end": 1181.08, "text": "先入险境啊"}, {"start": 1182.36, "end": 1184.04, "text": "用兵就是用险"}, {"start": 1184.2, "end": 1185.52, "text": "无险就无胜"}, {"start": 1185.72, "end": 1188.2, "text": "丞相如果现在不去渠州城"}, {"start": 1188.2, "end": 1190.28, "text": "那么日后再去渠州的话"}, {"start": 1190.44, "end": 1192.84, "text": "刘备他必定要偷袭渠州"}, {"start": 1193.2, "end": 1196.08, "text": "日后之险大于今日之险"}, {"start": 1196.08, "end": 1197.8, "text": "程昱有谋略"}, {"start": 1198.32, "end": 1199.88, "text": "寻昱有见识"}, {"start": 1200.44, "end": 1201.76, "text": "你们二人的话"}, {"start": 1201.76, "end": 1203.8, "text": "我听了都阔受教议"}, {"start": 1204.92, "end": 1205.92, "text": "你们知道吗"}, {"start": 1206.16, "end": 1207.12, "text": "想当年"}, {"start": 1207.36, "end": 1210.04, "text": "袁绍做十八路诸侯盟主的时候"}, {"start": 1210.44, "end": 1213.0, "text": "对董卓就是畏首畏尾"}, {"start": 1213.0, "end": 1214.2, "text": "谦言不见"}, {"start": 1214.96, "end": 1216.12, "text": "由此可见"}, {"start": 1216.88, "end": 1219.2, "text": "袁绍兵多却是雍主"}, {"start": 1219.92, "end": 1222.32, "text": "刘备兵少却有雄才"}, {"start": 1223.28, "end": 1225.16, "text": "若要战胜袁绍"}, {"start": 1225.84, "end": 1228.72, "text": "必须得先行攻去渠州"}, {"start": 1228.72, "end": 1277.43, "text": "刘备"}, {"start": 1280.03, "end": 1282.83, "text": "你本是我的囊中物 池中鱼"}, {"start": 1283.79, "end": 1285.07, "text": "只因我一时疏忽"}, {"start": 1285.07, "end": 1286.67, "text": "才让你偷得渠州"}, {"start": 1287.43, "end": 1288.15, "text": "曹操"}, {"start": 1289.47, "end": 1292.39, "text": "你名为汉相 实为汉贼"}, {"start": 1293.95, "end": 1297.51, "text": "刘备与天下英雄都以奉旨讨贼"}, {"start": 1297.51, "end": 1298.55, "text": "势必杀"}, {"start": 1298.95, "end": 1301.51, "text": "天底下想杀我的人多了"}, {"start": 1302.59, "end": 1305.11, "text": "可惜都成了种中枯谷"}, {"start": 1305.83, "end": 1307.55, "text": "你不是我的对手"}, {"start": 1307.99, "end": 1309.83, "text": "还是赶快现成吧"}, {"start": 1310.27, "end": 1311.55, "text": "我会给你一片地"}, {"start": 1311.55, "end": 1313.55, "text": "让你继续种韭菜"}, {"start": 1314.55, "end": 1317.67, "text": "否则破城之时 鸡犬不留"}, {"start": 1318.91, "end": 1319.99, "text": "那就试试吧"}, {"start": 1321.47, "end": 1324.03, "text": "我军虽少 却兵精将勇"}, {"start": 1324.95, "end": 1327.51, "text": "你兵马虽多 却必败无疑"}, {"start": 1327.95, "end": 1329.71, "text": "你何以如此自大"}, {"start": 1330.59, "end": 1333.59, "text": "因为袁绍已举大军奔袭卒下后方"}, {"start": 1334.23, "end": 1336.47, "text": "几日后定会攻陷徐昌"}, {"start": 1336.83, "end": 1337.83, "text": "试问卒下"}, {"start": 1338.39, "end": 1341.03, "text": "那时候你是入黄土呢"}, {"start": 1341.03, "end": 1342.43, "text": "还是下九泉呢"}, {"start": 1342.87, "end": 1345.67, "text": "你对袁绍的估计过高了吗"}, {"start": 1347.35, "end": 1349.27, "text": "我对卒下的估计过高了"}, {"start": 1350.15, "end": 1352.31, "text": "我原以为你心在主"}, {"start": 1352.31, "end": 1354.11, "text": "也当有一丝人伦"}, {"start": 1354.11, "end": 1355.75, "text": "不至于杀害贵妃"}, {"start": 1356.15, "end": 1356.99, "text": "没想到"}, {"start": 1357.63, "end": 1360.27, "text": "你竟然剿死了怀胎的贵妃"}, {"start": 1360.27, "end": 1362.31, "text": "让自己的女儿见味忠公"}, {"start": 1362.75, "end": 1364.55, "text": "可见你禽兽不如"}, {"start": 1365.35, "end": 1366.79, "text": "你当真要战吗"}, {"start": 1367.23, "end": 1368.79, "text": "战至最后一息"}, {"start": 1368.99, "end": 1369.63, "text": "好"}, {"start": 1388.46, "end": 1391.42, "text": "主公开火 渐渐惨剧续流"}, {"start": 1404.19, "end": 1405.03, "text": "这么说"}, {"start": 1405.71, "end": 1407.15, "text": "那曹操曹孟德"}, {"start": 1407.51, "end": 1408.99, "text": "亲统二十万兵马"}, {"start": 1409.23, "end": 1410.75, "text": "正在攻打徐州"}, {"start": 1411.03, "end": 1412.39, "text": "是啊 徐州万急"}, {"start": 1412.39, "end": 1414.47, "text": "我家主公请员工快快发兵啊"}, {"start": 1414.91, "end": 1415.95, "text": "万急"}, {"start": 1418.08, "end": 1419.28, "text": "你的意思是说"}, {"start": 1420.04, "end": 1421.24, "text": "你家主公刘备"}, {"start": 1421.68, "end": 1423.28, "text": "已经守不住城池了"}, {"start": 1423.88, "end": 1424.4, "text": "不不"}, {"start": 1424.72, "end": 1426.24, "text": "徐州固若金汤"}, {"start": 1426.76, "end": 1427.76, "text": "激战震撼哪"}, {"start": 1427.96, "end": 1429.6, "text": "好一个固若金汤"}, {"start": 1430.56, "end": 1431.28, "text": "直说吧"}, {"start": 1431.64, "end": 1432.24, "text": "尼芳"}, {"start": 1433.2, "end": 1435.52, "text": "刘备上能支撑多少时"}, {"start": 1436.08, "end": 1437.32, "text": "百日 胡说"}, {"start": 1440.69, "end": 1441.69, "text": "五十日"}, {"start": 1444.65, "end": 1447.21, "text": "恐怕也多说了吧"}, {"start": 1452.42, "end": 1453.22, "text": "徐先生"}, {"start": 1453.7, "end": 1455.06, "text": "我家主公的原话是"}, {"start": 1455.06, "end": 1456.58, "text": "他定战至最后一人"}, {"start": 1456.58, "end": 1457.42, "text": "最后一个"}, {"start": 1457.78, "end": 1458.62, "text": "我主公说"}, {"start": 1458.74, "end": 1460.22, "text": "徐先生满腹刀劣"}, {"start": 1460.42, "end": 1462.62, "text": "在员工架前是一言九鼎啊"}, {"start": 1463.26, "end": 1465.1, "text": "只有先请徐先生准了"}, {"start": 1465.14, "end": 1466.42, "text": "才能让员工进军哪"}, {"start": 1467.06, "end": 1469.06, "text": "你家主公真是这么说的"}, {"start": 1469.06, "end": 1470.26, "text": "一字不差"}, {"start": 1472.02, "end": 1473.1, "text": "实话跟你说吧"}, {"start": 1473.46, "end": 1475.62, "text": "我这儿正等着他攻打徐州呢"}, {"start": 1479.22, "end": 1480.38, "text": "这该如何是好啊"}, {"start": 1481.02, "end": 1482.58, "text": "如等在这儿说些什么"}, {"start": 1483.34, "end": 1484.1, "text": "小公子病了"}, {"start": 1484.38, "end": 1485.26, "text": "主公焦虑万分"}, {"start": 1485.58, "end": 1486.58, "text": "我等都不敢进去"}, {"start": 1488.91, "end": 1489.79, "text": "都给我闪开"}, {"start": 1490.15, "end": 1490.47, "text": "诺"}, {"start": 1490.79, "end": 1501.67, "text": "苍见哪"}, {"start": 1502.23, "end": 1505.23, "text": "这 这 这可怎么办哪"}, {"start": 1506.83, "end": 1508.03, "text": "我可怎么办"}, {"start": 1510.62, "end": 1512.62, "text": "在下徐游拜见主公"}, {"start": 1513.94, "end": 1514.78, "text": "徐州王"}, {"start": 1516.02, "end": 1517.66, "text": "小儿突然患病"}, {"start": 1518.42, "end": 1519.82, "text": "生命垂危"}, {"start": 1520.22, "end": 1521.5, "text": "你说怎么办"}, {"start": 1523.54, "end": 1524.54, "text": "主公无忧"}, {"start": 1524.98, "end": 1527.02, "text": "少公子定无大碍"}, {"start": 1527.26, "end": 1528.74, "text": "一点小急而已"}, {"start": 1529.62, "end": 1530.1, "text": "主公"}, {"start": 1530.5, "end": 1532.02, "text": "我们的圣机到了"}, {"start": 1533.22, "end": 1534.42, "text": "什么圣机"}, {"start": 1535.18, "end": 1535.86, "text": "主公啊"}, {"start": 1536.94, "end": 1538.46, "text": "方才刘备派迷芳"}, {"start": 1538.5, "end": 1539.42, "text": "刚前来报信"}, {"start": 1540.1, "end": 1542.82, "text": "说是那曹操正亲统二十万大军"}, {"start": 1543.22, "end": 1544.42, "text": "在攻打徐州"}, {"start": 1545.62, "end": 1546.42, "text": "如此一来"}, {"start": 1546.66, "end": 1548.66, "text": "那徐昌定然空虚"}, {"start": 1549.38, "end": 1551.42, "text": "请主公立刻挥师东进"}, {"start": 1551.58, "end": 1552.94, "text": "一举荡平徐昌"}, {"start": 1553.26, "end": 1555.22, "text": "那曹贼一旦失去了根据"}, {"start": 1555.42, "end": 1556.54, "text": "势必大乱"}, {"start": 1557.3, "end": 1557.86, "text": "而且"}, {"start": 1558.38, "end": 1560.46, "text": "我们可以顺手牵羊"}, {"start": 1561.18, "end": 1563.26, "text": "顺势迎娶县帝"}, {"start": 1564.18, "end": 1565.22, "text": "从今以后"}, {"start": 1565.34, "end": 1567.7, "text": "这邪天子已令诸侯的"}, {"start": 1567.7, "end": 1569.58, "text": "可就是主公你了"}, {"start": 1570.14, "end": 1570.86, "text": "天下"}, {"start": 1571.54, "end": 1573.18, "text": "指日可待呀"}, {"start": 1574.18, "end": 1575.78, "text": "徐昌有多远哪"}, {"start": 1576.98, "end": 1577.58, "text": "主公"}, {"start": 1578.14, "end": 1580.58, "text": "你不会连徐昌有多远都不记得了"}, {"start": 1581.14, "end": 1582.98, "text": "才二百五十里啊"}, {"start": 1586.63, "end": 1588.79, "text": "我儿现在一步都走不动"}, {"start": 1589.63, "end": 1591.71, "text": "哪走得了二百多里呢"}, {"start": 1592.47, "end": 1593.15, "text": "主公啊"}, {"start": 1593.47, "end": 1593.79, "text": "我"}, {"start": 1594.31, "end": 1596.27, "text": "我没说要少公子前去啊"}, {"start": 1596.75, "end": 1597.95, "text": "我是恳请主公"}, {"start": 1598.27, "end": 1600.23, "text": "你派兵齐袭徐昌"}, {"start": 1600.23, "end": 1602.83, "text": "主公 你就快快下令吧"}, {"start": 1603.63, "end": 1605.71, "text": "我儿是我的掌上明珠"}, {"start": 1607.15, "end": 1608.47, "text": "他害又不测"}, {"start": 1609.27, "end": 1610.55, "text": "我也就不活了"}, {"start": 1611.43, "end": 1611.91, "text": "主公"}, {"start": 1612.99, "end": 1615.43, "text": "这兵法院既不可失十步再来啊"}, {"start": 1615.51, "end": 1617.59, "text": "灭曹完全在此一举"}, {"start": 1617.71, "end": 1619.15, "text": "时不我待 主公"}, {"start": 1619.75, "end": 1622.75, "text": "在下恳求你快快发兵吧"}, {"start": 1625.49, "end": 1627.73, "text": "我心乱如麻"}, {"start": 1628.41, "end": 1630.49, "text": "我生魂颠倒"}, {"start": 1631.29, "end": 1633.13, "text": "还打什么仗啊"}, {"start": 1637.32, "end": 1638.8, "text": "我儿如又不测"}, {"start": 1639.76, "end": 1641.36, "text": "我也就不活了"}, {"start": 1643.8, "end": 1644.36, "text": "主公"}, {"start": 1644.88, "end": 1646.04, "text": "你醒醒醒吧"}, {"start": 1646.24, "end": 1646.8, "text": "退下"}, {"start": 1647.08, "end": 1647.52, "text": "主公"}, {"start": 1647.84, "end": 1648.12, "text": "我"}, {"start": 1648.2, "end": 1649.04, "text": "主公"}, {"start": 1649.36, "end": 1674.14, "text": "主啊"}, {"start": 1676.53, "end": 1677.69, "text": "庸主啊"}, {"start": 1678.69, "end": 1679.37, "text": "庸主"}, {"start": 1682.22, "end": 1683.7, "text": "竟然为了一个孺子"}, {"start": 1684.78, "end": 1686.7, "text": "遗物了这么好的战绩"}, {"start": 1689.02, "end": 1691.1, "text": "真乃根骨奇闻哪"}, {"start": 1691.58, "end": 1692.7, "text": "庸主"}, {"start": 1696.96, "end": 1698.44, "text": "徐庸如我"}, {"start": 1698.64, "end": 1701.46, "text": "二师军官"}, {"start": 1701.62, "end": 1702.06, "text": "遵命"}, {"start": 1702.06, "end": 1702.54, "text": "庸主"}, {"start": 1703.38, "end": 1704.94, "text": "庸 庸主"}, {"start": 1705.58, "end": 1707.38, "text": "你是个庸主"}, {"start": 1718.87, "end": 1719.91, "text": "庸主"}, {"start": 1720.51, "end": 1722.03, "text": "你是个庸主"}, {"start": 1724.54, "end": 1727.7, "text": "儿啊"}, {"start": 1727.9, "end": 1731.35, "text": "已经被备五六天了"}, {"start": 1732.27, "end": 1733.11, "text": "展狂如"}, {"start": 1733.95, "end": 1734.79, "text": "少纪报"}, {"start": 1734.95, "end": 1736.39, "text": "徐州城日夜激战"}, {"start": 1736.55, "end": 1738.79, "text": "城官面前全是曹军的死尸"}, {"start": 1739.71, "end": 1741.43, "text": "曹操是有备而来"}, {"start": 1741.83, "end": 1744.03, "text": "如果曹军伤亡巨大的话"}, {"start": 1744.67, "end": 1746.47, "text": "怕是主公的伤亡也少不了"}, {"start": 1746.59, "end": 1748.67, "text": "但是城池还在主公的手里"}, {"start": 1749.23, "end": 1750.47, "text": "估计数日之后"}, {"start": 1750.99, "end": 1752.43, "text": "袁绍就该出兵了"}, {"start": 1754.07, "end": 1756.71, "text": "如果主公坚持不了数日啊"}, {"start": 1763.22, "end": 1763.7, "text": "这样"}, {"start": 1764.42, "end": 1765.06, "text": "我"}, {"start": 1766.26, "end": 1768.5, "text": "率兵出城偷袭曹操"}, {"start": 1769.02, "end": 1770.82, "text": "或许能解徐州之危"}, {"start": 1771.3, "end": 1773.06, "text": "下必成就交给你把手"}, {"start": 1773.06, "end": 1774.02, "text": "绝对不可"}, {"start": 1774.42, "end": 1776.38, "text": "将军难道忘了主公的军令了吗"}, {"start": 1776.9, "end": 1777.98, "text": "只可坚守"}, {"start": 1778.22, "end": 1779.26, "text": "不可出战"}, {"start": 1779.58, "end": 1781.18, "text": "主公正在血战"}, {"start": 1781.18, "end": 1782.78, "text": "我岂能站在这里看着"}, {"start": 1783.3, "end": 1783.98, "text": "将军"}, {"start": 1784.62, "end": 1787.02, "text": "整个下必成里只有八千守军"}, {"start": 1787.18, "end": 1789.02, "text": "其实你全部带出去攻袭"}, {"start": 1789.02, "end": 1790.58, "text": "也无济于事啊"}, {"start": 1791.38, "end": 1791.98, "text": "相反"}, {"start": 1792.38, "end": 1793.3, "text": "如果不出战"}, {"start": 1793.5, "end": 1794.86, "text": "曹操就不知虚实"}, {"start": 1796.34, "end": 1797.18, "text": "将军你看"}, {"start": 1797.98, "end": 1800.66, "text": "连日来咱们牵制了曹军五六万人嘛"}, {"start": 1801.22, "end": 1802.78, "text": "他们之所以不敢妄动"}, {"start": 1802.78, "end": 1804.3, "text": "就是提防将军你呀"}, {"start": 1804.74, "end": 1805.22, "text": "所以"}, {"start": 1805.5, "end": 1806.78, "text": "主公的军令是对的"}, {"start": 1807.18, "end": 1809.78, "text": "不出战比出战的作用更大"}, {"start": 1815.52, "end": 1816.28, "text": "直率"}, {"start": 1817.08, "end": 1819.16, "text": "两千骑兵偷袭曹操"}, {"start": 1820.4, "end": 1822.0, "text": "你打着我的旗号守城"}, {"start": 1822.2, "end": 1824.12, "text": "我偷袭得手即刻回来"}, {"start": 1824.2, "end": 1825.08, "text": "绝不练战"}, {"start": 1825.64, "end": 1826.76, "text": "我受命监军"}, {"start": 1827.12, "end": 1828.68, "text": "如果将军执意要出城"}, {"start": 1829.96, "end": 1831.2, "text": "就从我的尸体上踏过去"}, {"start": 1831.52, "end": 1859.04, "text": "将军回来了"}, {"start": 1862.07, "end": 1863.07, "text": "将军回来了"}, {"start": 1865.42, "end": 1866.06, "text": "主公"}, {"start": 1867.18, "end": 1867.94, "text": "伤着没有"}, {"start": 1868.62, "end": 1869.18, "text": "还好"}, {"start": 1877.1, "end": 1878.06, "text": "袁绍发病了吗"}, {"start": 1878.94, "end": 1880.18, "text": "袁绍他不肯发病"}, {"start": 1880.94, "end": 1881.62, "text": "袁绍"}, {"start": 1882.14, "end": 1882.62, "text": "他"}, {"start": 1883.02, "end": 1884.02, "text": "他小儿病了"}, {"start": 1884.5, "end": 1885.66, "text": "他心思恍惚"}, {"start": 1885.82, "end": 1886.82, "text": "无心作战的"}, {"start": 1887.22, "end": 1888.22, "text": "他小儿病了"}, {"start": 1888.5, "end": 1891.66, "text": "你当前生死关头"}, {"start": 1891.98, "end": 1892.86, "text": "他身为统帅"}, {"start": 1892.86, "end": 1894.7, "text": "岂能为一介小儿一物容忌"}, {"start": 1895.06, "end": 1896.7, "text": "要是在下不亲眼看见"}, {"start": 1896.78, "end": 1897.9, "text": "也不敢相信呢"}, {"start": 1897.98, "end": 1899.94, "text": "但是袁绍他偏偏就这么做了"}, {"start": 1902.34, "end": 1903.42, "text": "那徐悠可是明白人"}, {"start": 1903.42, "end": 1904.18, "text": "他劝了没有"}, {"start": 1904.54, "end": 1905.26, "text": "劝了"}, {"start": 1905.46, "end": 1906.82, "text": "袁绍就是不听啊"}, {"start": 1907.1, "end": 1907.86, "text": "他就大喊"}, {"start": 1908.22, "end": 1908.74, "text": "什么"}, {"start": 1909.02, "end": 1909.62, "text": "雍主"}, {"start": 1909.7, "end": 1910.38, "text": "雍主"}, {"start": 1910.78, "end": 1913.1, "text": "就还被袁绍打了二十军棍呢"}, {"start": 1914.38, "end": 1915.46, "text": "就这种主公啊"}, {"start": 1915.66, "end": 1916.86, "text": "还不如个婆娘呢"}, {"start": 1917.1, "end": 1918.1, "text": "杀了咱倘啊"}, {"start": 1918.18, "end": 1919.22, "text": "他也得尿裤子"}, {"start": 1920.54, "end": 1921.14, "text": "大哥"}, {"start": 1921.74, "end": 1922.86, "text": "咱们不求他相助"}, {"start": 1923.14, "end": 1925.06, "text": "咱们自个儿也能打退曹三"}, {"start": 1935.91, "end": 1936.43, "text": "主公"}, {"start": 1937.07, "end": 1939.19, "text": "曹操把徐州围得像铁筒一般"}, {"start": 1940.03, "end": 1941.11, "text": "你是怎么进城的"}, {"start": 1942.11, "end": 1943.19, "text": "奇怪呀主公"}, {"start": 1943.75, "end": 1945.39, "text": "我本来没指望能回来"}, {"start": 1945.75, "end": 1947.11, "text": "我前到城关下一看"}, {"start": 1947.43, "end": 1949.07, "text": "到处都是死尸啊"}, {"start": 1949.39, "end": 1951.03, "text": "这 曹军他撤围了"}, {"start": 1951.91, "end": 1952.79, "text": "撤围了"}, {"start": 1953.87, "end": 1954.39, "text": "当真"}, {"start": 1954.75, "end": 1955.35, "text": "当真"}, {"start": 1955.59, "end": 1956.63, "text": "撤围三十里外"}, {"start": 1956.79, "end": 1957.91, "text": "扎下了几座大营"}, {"start": 1958.19, "end": 1966.9, "text": "看来曹操连日攻城"}, {"start": 1967.18, "end": 1968.18, "text": "伤亡惨重"}, {"start": 1969.66, "end": 1971.1, "text": "这是想休息调整"}, {"start": 1971.34, "end": 1972.98, "text": "养足军力以力再战"}, {"start": 1973.98, "end": 1974.94, "text": "他扎的几座大营"}, {"start": 1974.94, "end": 1975.94, "text": "一定在药道口上"}, {"start": 1976.06, "end": 1976.46, "text": "对付"}, {"start": 1976.62, "end": 1977.02, "text": "对"}, {"start": 1977.62, "end": 1978.58, "text": "主公要是突围"}, {"start": 1978.94, "end": 1980.9, "text": "他们仍可迎头阻击啊"}, {"start": 1981.22, "end": 1987.21, "text": "曹操的军力已经是不知了"}, {"start": 1987.49, "end": 1989.21, "text": "所以他才退得远远的嘛"}, {"start": 1989.93, "end": 1990.45, "text": "咱们呀"}, {"start": 1990.73, "end": 1991.89, "text": "要抓住这个时机"}, {"start": 1992.61, "end": 1994.97, "text": "趁夜齐袭曹军大营"}, {"start": 1995.37, "end": 1996.29, "text": "定可大胜"}, {"start": 1996.65, "end": 2001.0, "text": "也只能如此了"}, {"start": 2003.59, "end": 2004.91, "text": "袁绍是没有指望了"}, {"start": 2005.15, "end": 2006.35, "text": "我们只能靠自己"}, {"start": 2007.51, "end": 2008.91, "text": "若等曹操养足军力"}, {"start": 2009.03, "end": 2010.23, "text": "我们就更没有机会了"}, {"start": 2010.87, "end": 2012.15, "text": "只有夜出骑兵"}, {"start": 2012.35, "end": 2013.67, "text": "放到有几分生机"}, {"start": 2015.03, "end": 2015.71, "text": "看看看看"}, {"start": 2015.91, "end": 2017.11, "text": "我不就是这么说的吗"}, {"start": 2018.75, "end": 2019.23, "text": "传令"}, {"start": 2019.79, "end": 2020.87, "text": "各营三更造反"}, {"start": 2021.07, "end": 2021.87, "text": "四更出城"}, {"start": 2022.39, "end": 2023.59, "text": "人嫌没马过体"}, {"start": 2024.19, "end": 2025.75, "text": "知悉曹操中军大营"}, {"start": 2026.39, "end": 2028.11, "text": "若能攻杀曹操本人"}, {"start": 2028.27, "end": 2029.59, "text": "此意便可胜"}, {"start": 2029.99, "end": 2030.43, "text": "答令"}, {"start": 2030.71, "end": 2031.15, "text": "遵命"}, {"start": 2046.38, "end": 2046.82, "text": "主公"}, {"start": 2047.9, "end": 2048.86, "text": "依照兵法"}, {"start": 2049.26, "end": 2050.14, "text": "我军远来"}, {"start": 2050.46, "end": 2051.34, "text": "力在速战"}, {"start": 2052.02, "end": 2053.66, "text": "可你为何要撤军呢"}, {"start": 2057.15, "end": 2058.63, "text": "莫非是主公"}, {"start": 2058.99, "end": 2060.03, "text": "觉得伤亡太大"}, {"start": 2060.43, "end": 2061.27, "text": "有些担心"}, {"start": 2063.53, "end": 2065.13, "text": "那五千多具尸首"}, {"start": 2066.09, "end": 2068.89, "text": "是我有意留在刘备眼皮底下的"}, {"start": 2069.57, "end": 2069.93, "text": "什么"}, {"start": 2070.41, "end": 2070.65, "text": "这"}, {"start": 2071.61, "end": 2072.65, "text": "曹仁娜"}, {"start": 2073.37, "end": 2076.9, "text": "兵法交出来的都是呆子"}, {"start": 2077.98, "end": 2080.5, "text": "你何时才能成为真正的主将"}, {"start": 2081.78, "end": 2082.82, "text": "连日攻城"}, {"start": 2084.38, "end": 2086.18, "text": "我用的大多都是弱力"}, {"start": 2087.1, "end": 2089.1, "text": "精锐部队根本没用"}, {"start": 2089.86, "end": 2090.9, "text": "我为何不用"}, {"start": 2092.26, "end": 2094.26, "text": "就是因为徐州城间"}, {"start": 2094.86, "end": 2096.7, "text": "枪空伤亡太大"}, {"start": 2097.02, "end": 2100.18, "text": "既然非伤亡不可"}, {"start": 2101.06, "end": 2102.46, "text": "那我就留给刘备"}, {"start": 2103.02, "end": 2104.82, "text": "几千具弱力的尸首"}, {"start": 2106.88, "end": 2108.24, "text": "刘备看到城下"}, {"start": 2108.56, "end": 2109.72, "text": "尸首密布"}, {"start": 2111.44, "end": 2112.48, "text": "他肯定会想"}, {"start": 2112.88, "end": 2116.02, "text": "曹军伐力了"}, {"start": 2117.3, "end": 2118.94, "text": "撤军三十里修整"}, {"start": 2119.14, "end": 2121.11, "text": "于是"}, {"start": 2122.35, "end": 2123.19, "text": "他会怎么样"}, {"start": 2124.75, "end": 2125.27, "text": "你说"}, {"start": 2129.53, "end": 2130.41, "text": "他肯定会"}, {"start": 2130.81, "end": 2131.53, "text": "趁夜结营"}, {"start": 2131.81, "end": 2132.33, "text": "对了"}, {"start": 2134.83, "end": 2135.63, "text": "这就是"}, {"start": 2136.75, "end": 2139.43, "text": "那几千具尸首换来的战机"}, {"start": 2139.75, "end": 2143.35, "text": "我们必须要把刘备"}, {"start": 2143.79, "end": 2144.63, "text": "引出城"}, {"start": 2145.15, "end": 2146.23, "text": "才能消灭他"}, {"start": 2148.55, "end": 2149.59, "text": "末将明白了"}, {"start": 2155.01, "end": 2156.05, "text": "尤其是今夜"}, {"start": 2157.09, "end": 2158.41, "text": "务必加倍提防"}, {"start": 2160.26, "end": 2161.9, "text": "至于如何设伏"}, {"start": 2162.94, "end": 2163.94, "text": "交你安排"}, {"start": 2164.62, "end": 2165.38, "text": "我要睡了"}, {"start": 2166.46, "end": 2166.98, "text": "分兵"}, {"start": 2210.02, "end": 2211.38, "text": "曹操是好物防备"}, {"start": 2211.66, "end": 2212.58, "text": "咱们杀进去吧"}, {"start": 2212.66, "end": 2213.14, "text": "慢着"}, {"start": 2214.58, "end": 2216.46, "text": "为何连巡逻的少记都没有"}, {"start": 2220.04, "end": 2221.76, "text": "曹操一向军纪严明"}, {"start": 2222.88, "end": 2224.6, "text": "不可能连少记都不设"}, {"start": 2231.3, "end": 2231.7, "text": "主公"}, {"start": 2232.58, "end": 2232.98, "text": "你看"}, {"start": 2233.86, "end": 2234.54, "text": "那两个少记"}, {"start": 2239.67, "end": 2240.19, "text": "看来"}, {"start": 2241.31, "end": 2243.19, "text": "曹军上下也是疲惫过度了"}, {"start": 2258.49, "end": 2260.73, "text": "我现在令你们不顾一切代价冲过去"}, {"start": 2261.29, "end": 2262.65, "text": "若能斩杀曹操"}, {"start": 2263.13, "end": 2264.53, "text": "那就大功告成了"}, {"start": 2264.89, "end": 2265.49, "text": "遵命"}, {"start": 2266.69, "end": 2267.05, "text": "上"}, {"start": 2267.41, "end": 2314.81, "text": "这帐内空无一人"}, {"start": 2317.66, "end": 2318.34, "text": "这里也没人"}, {"start": 2325.26, "end": 2325.86, "text": "撞计了"}, {"start": 2326.02, "end": 2326.38, "text": "撤"}, {"start": 2326.74, "end": 2473.11, "text": "御助"}, {"start": 2473.19, "end": 2473.51, "text": "走"}, {"start": 2473.83, "end": 2584.66, "text": "在青天之御助"}, {"start": 2585.18, "end": 2586.9, "text": "驾海之金粮"}, {"start": 2587.38, "end": 2588.82, "text": "这宽伏汉室"}, {"start": 2589.06, "end": 2590.62, "text": "辱则无旁贷"}, {"start": 2591.46, "end": 2593.02, "text": "安可轻生了"}, {"start": 2594.18, "end": 2595.26, "text": "来来来"}, {"start": 2595.78, "end": 2597.22, "text": "在下许忧"}, {"start": 2597.7, "end": 2598.5, "text": "这香"}, {"start": 2598.94, "end": 2599.9, "text": "有礼了"}]