[{"start": 7.57, "end": 15.47, "text": "在线上不得不。"}, {"start": 15.47, "end": 162.43, "text": "令你立即召集五百虎奔甲士"}, {"start": 162.43, "end": 163.43, "text": "随我前往客馆"}, {"start": 164.43, "end": 165.43, "text": "吴将军"}, {"start": 165.43, "end": 167.43, "text": "令你调集六万精兵囤禹城外"}, {"start": 167.43, "end": 168.43, "text": "待命攻沙新野"}, {"start": 169.43, "end": 170.43, "text": "宋将军"}, {"start": 170.43, "end": 171.43, "text": "命你封锁靖州九门"}, {"start": 171.43, "end": 172.43, "text": "严加防范"}, {"start": 172.43, "end": 174.43, "text": "不准一人一鸡熟肉"}, {"start": 174.43, "end": 175.43, "text": "遵命"}, {"start": 175.43, "end": 181.39, "text": "刘皇叔"}, {"start": 181.39, "end": 185.34, "text": "公子"}, {"start": 185.34, "end": 194.73, "text": "为何深夜到此"}, {"start": 194.73, "end": 195.73, "text": "皇叔"}, {"start": 195.73, "end": 196.73, "text": "容小臣先问一句"}, {"start": 196.73, "end": 199.73, "text": "皇叔今天与我父亲单独相会了吗"}, {"start": 199.73, "end": 200.73, "text": "是啊"}, {"start": 200.73, "end": 201.73, "text": "端午节嘛"}, {"start": 201.73, "end": 203.73, "text": "明公召我喝酒"}, {"start": 203.73, "end": 204.73, "text": "西间可谈了什么"}, {"start": 204.73, "end": 209.16, "text": "明公问我立世子之事"}, {"start": 209.16, "end": 210.16, "text": "我说"}, {"start": 210.16, "end": 211.16, "text": "费掌利诱"}, {"start": 211.16, "end": 213.16, "text": "自古便是取乱之道"}, {"start": 214.16, "end": 216.16, "text": "多谢皇叔直言"}, {"start": 216.16, "end": 220.08, "text": "这话也给皇叔引来了大祸"}, {"start": 221.08, "end": 222.08, "text": "怎么"}, {"start": 222.08, "end": 224.08, "text": "景升兄会杀我吗"}, {"start": 224.08, "end": 225.08, "text": "不不"}, {"start": 225.08, "end": 227.08, "text": "父亲绝不会"}, {"start": 227.08, "end": 229.08, "text": "但菜猫要对你下手了"}, {"start": 229.08, "end": 231.08, "text": "今晚将军府灯火通明"}, {"start": 231.08, "end": 233.08, "text": "菜猫正在调兵遣将"}, {"start": 233.08, "end": 234.08, "text": "皇叔啊"}, {"start": 234.08, "end": 236.08, "text": "赶紧离开京州返回西野吧"}, {"start": 236.08, "end": 245.95, "text": "多谢公子相救"}, {"start": 246.95, "end": 247.95, "text": "不过依礼"}, {"start": 247.95, "end": 249.95, "text": "我是景升兄请来的"}, {"start": 249.95, "end": 252.95, "text": "我总要回禀过明公才好走"}, {"start": 252.95, "end": 254.95, "text": "否则岂不是失礼"}, {"start": 254.95, "end": 255.95, "text": "生死关头"}, {"start": 255.95, "end": 256.95, "text": "皇叔还顾得这些虚礼"}, {"start": 256.95, "end": 257.95, "text": "快走快走"}, {"start": 257.95, "end": 258.95, "text": "拿出刘备了吗"}, {"start": 258.95, "end": 286.64, "text": "将军"}, {"start": 286.64, "end": 287.64, "text": "防守空空"}, {"start": 287.64, "end": 288.64, "text": "里面全都搜遍了"}, {"start": 288.64, "end": 289.64, "text": "没有发现刘备踪影"}, {"start": 289.64, "end": 291.64, "text": "刘备明明就住在这里"}, {"start": 291.64, "end": 292.64, "text": "咱们就不见踪影了"}, {"start": 292.64, "end": 293.64, "text": "带馆主来"}, {"start": 293.64, "end": 294.64, "text": "沿上来"}, {"start": 294.64, "end": 295.64, "text": "遵命"}, {"start": 295.64, "end": 296.64, "text": "刘备哪儿去了"}, {"start": 296.64, "end": 302.12, "text": "禀将军"}, {"start": 302.12, "end": 303.12, "text": "这二更天的时候"}, {"start": 303.12, "end": 305.12, "text": "刘备突然冲出客馆"}, {"start": 305.12, "end": 306.12, "text": "骑上马就走了"}, {"start": 306.12, "end": 308.12, "text": "什么都没说"}, {"start": 308.12, "end": 309.12, "text": "没说"}, {"start": 309.12, "end": 311.12, "text": "深京半夜的"}, {"start": 311.12, "end": 362.78, "text": "这里为何聚集"}, {"start": 362.78, "end": 364.78, "text": "这么多的虎喷假事"}, {"start": 364.78, "end": 365.78, "text": "主公"}, {"start": 365.78, "end": 367.78, "text": "末将挺关注禀报"}, {"start": 367.78, "end": 368.78, "text": "说刘备在二京时"}, {"start": 368.78, "end": 369.78, "text": "冲出客馆"}, {"start": 369.78, "end": 370.78, "text": "匆匆跑了"}, {"start": 371.78, "end": 373.78, "text": "末将身负安危大任"}, {"start": 373.78, "end": 375.78, "text": "刘备又是主公的贵客"}, {"start": 375.78, "end": 376.78, "text": "万一有个闪失"}, {"start": 376.78, "end": 378.78, "text": "末将罪不可赦"}, {"start": 378.78, "end": 379.78, "text": "所以末将代表"}, {"start": 379.78, "end": 380.78, "text": "前来探查"}, {"start": 380.78, "end": 381.78, "text": "是这样吗"}, {"start": 381.78, "end": 382.78, "text": "是"}, {"start": 382.78, "end": 385.34, "text": "灯来"}, {"start": 385.34, "end": 386.34, "text": "拿来"}, {"start": 386.34, "end": 423.42, "text": "暮年土手困"}, {"start": 423.42, "end": 426.42, "text": "空对旧山川"}, {"start": 426.42, "end": 429.42, "text": "龙起池中雾"}, {"start": 429.42, "end": 432.42, "text": "城雷遇上天"}, {"start": 433.42, "end": 434.42, "text": "主公"}, {"start": 434.42, "end": 435.42, "text": "这是反噬啊"}, {"start": 435.42, "end": 436.42, "text": "刘备不甘心"}, {"start": 436.42, "end": 438.42, "text": "做京中的池中之物"}, {"start": 438.42, "end": 440.42, "text": "他就称雷上九霄啊"}, {"start": 440.42, "end": 442.42, "text": "我对他人之一击"}, {"start": 442.42, "end": 443.42, "text": "看来"}, {"start": 443.42, "end": 445.42, "text": "真是想谋取我的京中吧"}, {"start": 445.42, "end": 446.42, "text": "是"}, {"start": 446.42, "end": 448.42, "text": "我非出调他不可"}, {"start": 448.42, "end": 450.42, "text": "此事粗疏不堪"}, {"start": 450.42, "end": 452.42, "text": "不想悬得笔墨"}, {"start": 452.42, "end": 454.42, "text": "再者"}, {"start": 454.42, "end": 455.42, "text": "我也从来没见他"}, {"start": 455.42, "end": 466.09, "text": "写过诗啊"}, {"start": 466.09, "end": 467.09, "text": "主公"}, {"start": 467.09, "end": 469.09, "text": "刘备肯定心怀意志"}, {"start": 469.09, "end": 470.09, "text": "否则"}, {"start": 470.09, "end": 472.09, "text": "为何连夜离开京中啊"}, {"start": 472.09, "end": 473.09, "text": "末将已调急兵马"}, {"start": 473.09, "end": 474.09, "text": "请主公下定"}, {"start": 474.09, "end": 475.09, "text": "末将"}, {"start": 475.09, "end": 476.09, "text": "末将"}, {"start": 476.09, "end": 477.09, "text": "末将"}, {"start": 477.09, "end": 478.09, "text": "末将"}, {"start": 478.09, "end": 479.09, "text": "末将"}, {"start": 479.09, "end": 480.09, "text": "末将"}, {"start": 480.09, "end": 481.09, "text": "有急兵马"}, {"start": 481.09, "end": 482.09, "text": "请主公下定"}, {"start": 482.09, "end": 483.09, "text": "准末将前往新野"}, {"start": 483.09, "end": 488.32, "text": "擒拿刘备"}, {"start": 488.32, "end": 490.32, "text": "我怀疑此事真伪"}, {"start": 490.32, "end": 491.32, "text": "那么"}, {"start": 491.32, "end": 492.32, "text": "先拿下刘备"}, {"start": 492.32, "end": 494.32, "text": "主公也好当面问个明白"}, {"start": 494.32, "end": 496.32, "text": "你到新野去捉拿刘备"}, {"start": 496.32, "end": 497.32, "text": "关羽 张飞"}, {"start": 497.32, "end": 499.32, "text": "会坐视不管吗"}, {"start": 499.32, "end": 501.32, "text": "还有赵云 赵子龙"}, {"start": 501.32, "end": 502.32, "text": "我们两家"}, {"start": 502.32, "end": 505.79, "text": "不是立刻就要打起来吗"}, {"start": 505.79, "end": 507.79, "text": "都退了吧"}, {"start": 507.79, "end": 508.79, "text": "此事"}, {"start": 508.79, "end": 515.5, "text": "日后我定有详查"}, {"start": 515.5, "end": 516.5, "text": "车民回营"}, {"start": 516.5, "end": 524.38, "text": "没有听见吗"}, {"start": 524.38, "end": 526.38, "text": "你们都看他干什么"}, {"start": 526.38, "end": 528.38, "text": "我是京中之主"}, {"start": 529.38, "end": 530.38, "text": "你们没听见主公的禁令吗"}, {"start": 530.38, "end": 531.38, "text": "马上手臂回营"}, {"start": 531.38, "end": 532.38, "text": "快"}, {"start": 543.08, "end": 545.08, "text": "昨夜我们赶到客馆之后"}, {"start": 545.08, "end": 546.08, "text": "刘备仓皇逃命了"}, {"start": 546.08, "end": 548.08, "text": "我们扑了个空"}, {"start": 548.08, "end": 549.08, "text": "此外"}, {"start": 549.08, "end": 551.08, "text": "我请命攻杀新野"}, {"start": 551.08, "end": 552.08, "text": "主公也不准"}, {"start": 552.08, "end": 557.38, "text": "可是怀疑我了"}, {"start": 557.38, "end": 558.38, "text": "当然怀疑了"}, {"start": 558.38, "end": 564.93, "text": "主公深夜回府"}, {"start": 564.93, "end": 565.93, "text": "进门就大骂"}, {"start": 565.93, "end": 568.93, "text": "京中城内暗藏奸贼"}, {"start": 568.93, "end": 570.93, "text": "气得他差点吐血"}, {"start": 571.93, "end": 572.93, "text": "那我们怎么办"}, {"start": 572.93, "end": 575.85, "text": "别慌嘛"}, {"start": 576.85, "end": 577.85, "text": "侥幸的是"}, {"start": 578.85, "end": 579.85, "text": "他大骂之后"}, {"start": 580.85, "end": 582.85, "text": "竟然旧病复发"}, {"start": 583.85, "end": 584.85, "text": "我看"}, {"start": 585.85, "end": 586.85, "text": "这十天半个月"}, {"start": 587.85, "end": 589.85, "text": "他是不能立正了"}, {"start": 590.85, "end": 591.85, "text": "可是主公病好之后"}, {"start": 591.85, "end": 593.85, "text": "还会追究此事的"}, {"start": 593.85, "end": 594.85, "text": "这是当然"}, {"start": 596.85, "end": 597.85, "text": "不过"}, {"start": 597.85, "end": 602.15, "text": "我可以让他的病"}, {"start": 602.15, "end": 604.15, "text": "好得别那么快吗"}, {"start": 604.15, "end": 607.56, "text": "我已经吩咐府医"}, {"start": 608.56, "end": 610.56, "text": "让他用药当心"}, {"start": 611.56, "end": 612.56, "text": "一方面"}, {"start": 613.56, "end": 617.22, "text": "要让主公好生活着"}, {"start": 618.22, "end": 619.22, "text": "另一方面"}, {"start": 620.22, "end": 622.22, "text": "要让主公病势不紧"}, {"start": 624.22, "end": 625.22, "text": "所以你有的是时间"}, {"start": 626.22, "end": 627.22, "text": "抓紧办事吧"}, {"start": 627.22, "end": 633.76, "text": "还当军师啊"}, {"start": 633.76, "end": 635.76, "text": "女的又如何"}, {"start": 635.76, "end": 636.76, "text": "女的"}, {"start": 636.76, "end": 638.76, "text": "就不能当京中之主了吗"}, {"start": 638.76, "end": 639.76, "text": "是是"}, {"start": 639.76, "end": 672.86, "text": "多谢皇叔相迎"}, {"start": 673.86, "end": 674.86, "text": "公子客气了"}, {"start": 674.86, "end": 676.86, "text": "客管相救之事"}, {"start": 676.86, "end": 677.86, "text": "还要多谢你呢"}, {"start": 678.86, "end": 679.86, "text": "对了"}, {"start": 679.86, "end": 680.86, "text": "那日"}, {"start": 680.86, "end": 681.86, "text": "我不辞而去"}, {"start": 682.86, "end": 683.86, "text": "景升兄"}, {"start": 683.86, "end": 684.86, "text": "打算如何料理这事"}, {"start": 685.86, "end": 686.86, "text": "巧了"}, {"start": 686.86, "end": 687.86, "text": "第二天"}, {"start": 687.86, "end": 688.86, "text": "父亲就救急重犯"}, {"start": 688.86, "end": 689.86, "text": "不能下榻了"}, {"start": 689.86, "end": 690.86, "text": "因此"}, {"start": 690.86, "end": 691.86, "text": "这事就搁下了"}, {"start": 691.86, "end": 692.86, "text": "那今日"}, {"start": 692.86, "end": 696.55, "text": "公子亲自到新野来"}, {"start": 696.55, "end": 697.55, "text": "有何事吩咐"}, {"start": 698.55, "end": 701.18, "text": "后天就是京乡庙会了"}, {"start": 701.18, "end": 703.18, "text": "此会每年举行一次"}, {"start": 703.18, "end": 704.18, "text": "凡京乡九军"}, {"start": 704.18, "end": 705.18, "text": "县令以上文武官员"}, {"start": 705.18, "end": 706.18, "text": "均必须到会议政"}, {"start": 707.18, "end": 708.18, "text": "今年又直到古大熟"}, {"start": 709.18, "end": 710.18, "text": "庙会将更加隆重"}, {"start": 711.18, "end": 712.18, "text": "依律"}, {"start": 712.18, "end": 713.18, "text": "父亲应该亲自出行"}, {"start": 714.18, "end": 715.18, "text": "但他病重不会复会"}, {"start": 716.18, "end": 717.18, "text": "便令我带他出行"}, {"start": 719.66, "end": 720.66, "text": "好啊"}, {"start": 720.66, "end": 721.66, "text": "这说明景升兄"}, {"start": 721.66, "end": 722.66, "text": "还是信任你啊"}, {"start": 723.66, "end": 726.38, "text": "但我对父亲说"}, {"start": 726.38, "end": 727.38, "text": "京乡各军官员"}, {"start": 727.38, "end": 728.38, "text": "多为我叔伯执辈"}, {"start": 729.38, "end": 730.38, "text": "万年轻德伯"}, {"start": 730.38, "end": 731.38, "text": "恐怕有如父亲之尊"}, {"start": 732.38, "end": 733.38, "text": "于是父亲说"}, {"start": 734.38, "end": 735.38, "text": "那就请留先"}, {"start": 735.38, "end": 736.38, "text": "那就请刘先得与你同去"}, {"start": 737.38, "end": 738.38, "text": "他乃当今天子的皇叔"}, {"start": 739.38, "end": 740.38, "text": "这份尊贵"}, {"start": 740.38, "end": 741.38, "text": "足够让官员们敬服了吧"}, {"start": 742.38, "end": 743.38, "text": "不敢当"}, {"start": 743.38, "end": 744.38, "text": "既然景升兄有命"}, {"start": 744.38, "end": 745.38, "text": "公子就亲自出驾"}, {"start": 746.38, "end": 747.38, "text": "那我奉命就是了"}, {"start": 748.38, "end": 749.38, "text": "多谢"}, {"start": 749.38, "end": 750.38, "text": "公子请"}, {"start": 750.38, "end": 751.38, "text": "皇叔请"}, {"start": 751.38, "end": 755.65, "text": "京乡庙会"}, {"start": 755.65, "end": 756.65, "text": "乃京州府"}, {"start": 757.65, "end": 758.65, "text": "极其重要的政事"}, {"start": 759.65, "end": 760.65, "text": "九军官吏七纪御堂"}, {"start": 761.65, "end": 762.65, "text": "共同议政"}, {"start": 763.65, "end": 764.65, "text": "刘景升患病"}, {"start": 765.65, "end": 766.65, "text": "不能亲往"}, {"start": 766.65, "end": 767.65, "text": "令我代为出席"}, {"start": 769.65, "end": 770.65, "text": "我明日既去"}, {"start": 770.65, "end": 771.65, "text": "三五日归来"}, {"start": 773.65, "end": 775.65, "text": "列尉务必各守其职"}, {"start": 775.65, "end": 776.65, "text": "不得大意"}, {"start": 777.65, "end": 778.65, "text": "我不再是"}, {"start": 778.65, "end": 779.65, "text": "城中大小事"}, {"start": 780.65, "end": 781.65, "text": "均由云长做主"}, {"start": 783.65, "end": 784.65, "text": "遵命"}, {"start": 785.65, "end": 786.65, "text": "哥哥刚刚死里逃生"}, {"start": 787.65, "end": 788.65, "text": "好不容易离开了京州"}, {"start": 789.65, "end": 790.65, "text": "还去那面会干吗"}, {"start": 791.65, "end": 792.65, "text": "叫我说呀"}, {"start": 792.65, "end": 793.65, "text": "这宴无好宴"}, {"start": 794.65, "end": 795.65, "text": "会无好会"}, {"start": 795.65, "end": 796.65, "text": "哥哥不去"}, {"start": 796.65, "end": 797.65, "text": "如若不去"}, {"start": 798.65, "end": 799.65, "text": "那就是对"}, {"start": 799.65, "end": 800.65, "text": "刘景升的失礼"}, {"start": 800.65, "end": 801.65, "text": "人家好生待我"}, {"start": 802.65, "end": 803.65, "text": "我怎能推辞"}, {"start": 804.65, "end": 805.65, "text": "哪怕是有些风险"}, {"start": 805.65, "end": 806.65, "text": "我也得去"}, {"start": 807.65, "end": 808.65, "text": "我不能负了景升兄"}, {"start": 809.65, "end": 810.65, "text": "那我跟着"}, {"start": 810.65, "end": 811.65, "text": "为你护驾"}, {"start": 811.65, "end": 816.59, "text": "你性情过于火爆了"}, {"start": 817.59, "end": 819.59, "text": "还是子隆"}, {"start": 819.59, "end": 820.59, "text": "随我去吧"}, {"start": 821.59, "end": 822.59, "text": "遵命"}, {"start": 822.59, "end": 839.59, "text": "神车啊神车"}, {"start": 840.59, "end": 843.61, "text": "万里挑一人"}, {"start": 843.61, "end": 847.52, "text": "先生慧眼"}, {"start": 848.52, "end": 849.52, "text": "能敲出此马不凡"}, {"start": 851.52, "end": 853.52, "text": "请问先生尊姓大名"}, {"start": 854.52, "end": 855.52, "text": "萍水相逢"}, {"start": 856.52, "end": 857.52, "text": "不必通报姓"}, {"start": 858.52, "end": 859.52, "text": "我是否可以"}, {"start": 860.52, "end": 861.52, "text": "细细看看此马"}, {"start": 861.52, "end": 863.9, "text": "请"}, {"start": 863.9, "end": 873.22, "text": "此马虽是沈骏"}, {"start": 873.22, "end": 875.22, "text": "眼下却有一道类草"}, {"start": 875.22, "end": 876.22, "text": "名叫狄鲁"}, {"start": 879.11, "end": 880.11, "text": "尊家不可再用它"}, {"start": 880.11, "end": 881.11, "text": "作为乘骑"}, {"start": 882.11, "end": 883.11, "text": "骑则防主啊"}, {"start": 883.11, "end": 887.47, "text": "请问"}, {"start": 887.47, "end": 888.47, "text": "它如何防我"}, {"start": 891.97, "end": 892.97, "text": "数日之内"}, {"start": 892.97, "end": 893.97, "text": "恐怕就会有"}, {"start": 893.97, "end": 894.97, "text": "血光之灾"}, {"start": 894.97, "end": 898.62, "text": "敢问先生"}, {"start": 898.62, "end": 899.62, "text": "此灾能避吗"}, {"start": 900.62, "end": 905.5, "text": "避也不难"}, {"start": 906.5, "end": 908.5, "text": "尊家只需将此马"}, {"start": 908.5, "end": 909.5, "text": "送给任何一位仇家"}, {"start": 910.5, "end": 911.5, "text": "待狄鲁马"}, {"start": 911.5, "end": 912.5, "text": "伤害那位仇家之后"}, {"start": 913.5, "end": 914.5, "text": "尊家再取回"}, {"start": 915.5, "end": 916.5, "text": "自用乘骑"}, {"start": 917.5, "end": 918.5, "text": "这样"}, {"start": 918.5, "end": 920.5, "text": "就利害两遍了"}, {"start": 925.37, "end": 926.37, "text": "先生这是何话"}, {"start": 927.37, "end": 928.37, "text": "损人利己"}, {"start": 928.37, "end": 929.37, "text": "伤天害理"}, {"start": 930.37, "end": 931.37, "text": "此等事"}, {"start": 931.37, "end": 933.37, "text": "我是宁死不为的"}, {"start": 937.58, "end": 939.58, "text": "人言留玄得人意"}, {"start": 939.58, "end": 940.58, "text": "金剑"}, {"start": 940.58, "end": 941.58, "text": "果然哪"}, {"start": 941.58, "end": 950.49, "text": "先生如何得知我姓名"}, {"start": 965.41, "end": 967.41, "text": "京乡九郡四十二剑官员"}, {"start": 967.41, "end": 968.41, "text": "欢聚于此"}, {"start": 968.41, "end": 970.41, "text": "共贺道古江蜀"}, {"start": 970.41, "end": 971.41, "text": "国泰民安"}, {"start": 972.41, "end": 973.41, "text": "家父因偶然危恙"}, {"start": 973.41, "end": 975.41, "text": "未能亲临此会"}, {"start": 975.41, "end": 977.41, "text": "只能在荆州府中"}, {"start": 977.41, "end": 978.41, "text": "向各位同仁"}, {"start": 978.41, "end": 979.41, "text": "遥相致贺了"}, {"start": 980.41, "end": 982.41, "text": "祝父祖道日康复"}, {"start": 982.41, "end": 984.41, "text": "谢大夫子国民"}, {"start": 984.41, "end": 985.41, "text": "家父特意请来"}, {"start": 985.41, "end": 987.41, "text": "左将军怡成侯"}, {"start": 987.41, "end": 989.41, "text": "也即是当今天子的皇叔"}, {"start": 989.41, "end": 990.41, "text": "刘玄德"}, {"start": 992.41, "end": 993.41, "text": "刘皇叔"}, {"start": 995.41, "end": 996.41, "text": "在下"}, {"start": 996.41, "end": 999.41, "text": "自从踏进京乡地界"}, {"start": 999.41, "end": 1000.41, "text": "那刻起"}, {"start": 1001.41, "end": 1002.41, "text": "就深感这里"}, {"start": 1003.41, "end": 1004.41, "text": "天灵地秀"}, {"start": 1005.41, "end": 1006.41, "text": "物胜民风"}, {"start": 1008.41, "end": 1010.41, "text": "与朝军铁骑下的"}, {"start": 1010.41, "end": 1011.41, "text": "乱世相比"}, {"start": 1012.41, "end": 1013.41, "text": "京乡"}, {"start": 1013.41, "end": 1015.41, "text": "简直就是天上人间"}, {"start": 1015.41, "end": 1016.41, "text": "刘皇叔说得对"}, {"start": 1016.41, "end": 1017.41, "text": "我京乡九郡"}, {"start": 1017.41, "end": 1019.41, "text": "本就是世外桃源"}, {"start": 1019.41, "end": 1020.41, "text": "天上人间嘛"}, {"start": 1020.41, "end": 1022.41, "text": "刘皇叔果然是个贤君子"}, {"start": 1022.41, "end": 1023.41, "text": "是不是"}, {"start": 1023.41, "end": 1024.41, "text": "是啊是啊"}, {"start": 1024.41, "end": 1026.41, "text": "这里的这片太平"}, {"start": 1026.41, "end": 1028.41, "text": "尚靠名公刘景生"}, {"start": 1029.41, "end": 1032.41, "text": "下赖列为文武官吏"}, {"start": 1033.41, "end": 1034.41, "text": "今日"}, {"start": 1035.41, "end": 1037.41, "text": "刘备受景生兄委托"}, {"start": 1037.41, "end": 1039.41, "text": "特此前来相和"}, {"start": 1040.41, "end": 1041.41, "text": "请"}, {"start": 1041.41, "end": 1042.41, "text": "刘皇叔请"}, {"start": 1042.41, "end": 1043.41, "text": "你也下去"}, {"start": 1043.41, "end": 1044.41, "text": "陪他们喝杯酒"}, {"start": 1055.01, "end": 1056.01, "text": "主公"}, {"start": 1056.01, "end": 1058.01, "text": "子龙有护甲之责"}, {"start": 1058.01, "end": 1059.01, "text": "还是不喝的"}, {"start": 1059.01, "end": 1061.01, "text": "这些都是冷地官员"}, {"start": 1062.01, "end": 1064.01, "text": "我们如想久居此地"}, {"start": 1064.01, "end": 1066.01, "text": "就必须以礼相待"}, {"start": 1067.01, "end": 1068.01, "text": "再说"}, {"start": 1068.01, "end": 1069.01, "text": "你岸间在此"}, {"start": 1069.01, "end": 1070.01, "text": "也不好看"}, {"start": 1071.01, "end": 1072.01, "text": "遵命"}, {"start": 1072.01, "end": 1073.01, "text": "在下敬你一杯"}, {"start": 1080.07, "end": 1081.07, "text": "你们听着"}, {"start": 1097.66, "end": 1098.66, "text": "刘备在此"}, {"start": 1099.66, "end": 1100.66, "text": "刘备此行"}, {"start": 1100.66, "end": 1102.66, "text": "只带了赵云一人及吴北军士"}, {"start": 1102.66, "end": 1104.66, "text": "你们立即把神庙四周"}, {"start": 1104.66, "end": 1105.66, "text": "各围上"}, {"start": 1105.66, "end": 1106.66, "text": "待我号令一下"}, {"start": 1106.66, "end": 1107.66, "text": "马上冲进去"}, {"start": 1107.66, "end": 1108.66, "text": "如有人问"}, {"start": 1108.66, "end": 1110.66, "text": "就说刘备勾结曹操"}, {"start": 1110.66, "end": 1111.66, "text": "谋取京州"}, {"start": 1111.66, "end": 1113.66, "text": "主公命令斩杀"}, {"start": 1113.66, "end": 1114.66, "text": "这一回"}, {"start": 1114.66, "end": 1116.66, "text": "绝对不能让他再逃脱"}, {"start": 1116.66, "end": 1117.66, "text": "遵命"}, {"start": 1118.66, "end": 1119.66, "text": "来来来"}, {"start": 1119.66, "end": 1122.52, "text": "先干"}, {"start": 1122.52, "end": 1123.52, "text": "干干干"}, {"start": 1124.52, "end": 1127.95, "text": "我敬你一杯"}, {"start": 1127.95, "end": 1128.95, "text": "好酒"}, {"start": 1129.95, "end": 1133.32, "text": "公子何事"}, {"start": 1133.32, "end": 1134.32, "text": "相爷主播刚才禀报我"}, {"start": 1135.32, "end": 1136.32, "text": "说外面已经布满了"}, {"start": 1136.32, "end": 1137.32, "text": "虎奔军师"}, {"start": 1138.32, "end": 1139.32, "text": "虎奔军师"}, {"start": 1140.32, "end": 1143.05, "text": "京州兄您要杀我吗"}, {"start": 1144.05, "end": 1149.46, "text": "全是将军府的"}, {"start": 1149.46, "end": 1154.43, "text": "从边门出去"}, {"start": 1156.43, "end": 1158.71, "text": "公子"}, {"start": 1158.71, "end": 1159.71, "text": "我能不能不逃了"}, {"start": 1160.71, "end": 1165.04, "text": "你说"}, {"start": 1165.04, "end": 1166.04, "text": "我这辈子"}, {"start": 1166.04, "end": 1167.04, "text": "颠沛于柳林"}, {"start": 1168.04, "end": 1169.04, "text": "东奔西跑"}, {"start": 1169.04, "end": 1171.04, "text": "总是在逃"}, {"start": 1172.04, "end": 1173.04, "text": "我能不能不逃了"}, {"start": 1174.04, "end": 1177.18, "text": "听天由命吧"}, {"start": 1177.18, "end": 1180.72, "text": "我就在此恭候"}, {"start": 1181.72, "end": 1182.72, "text": "看那菜猫"}, {"start": 1182.72, "end": 1183.72, "text": "能把我怎养"}, {"start": 1184.72, "end": 1185.72, "text": "皇叔"}, {"start": 1185.72, "end": 1187.72, "text": "你是个仁义贤民之君"}, {"start": 1187.72, "end": 1188.72, "text": "早晚必成大业"}, {"start": 1189.72, "end": 1190.72, "text": "如果束手就死"}, {"start": 1190.72, "end": 1191.72, "text": "岂是大上不作为啊"}, {"start": 1195.92, "end": 1196.92, "text": "京州肯定会"}, {"start": 1196.92, "end": 1197.92, "text": "酿出一场血光之灾"}, {"start": 1198.92, "end": 1199.92, "text": "关正赵三位将军"}, {"start": 1199.92, "end": 1200.92, "text": "必会找我夫妻复仇"}, {"start": 1201.92, "end": 1208.46, "text": "到那时恐怕连我父亲"}, {"start": 1208.46, "end": 1209.46, "text": "都难逃厄运了"}, {"start": 1210.46, "end": 1217.57, "text": "公子说得是"}, {"start": 1217.57, "end": 1218.57, "text": "快走吧"}, {"start": 1218.57, "end": 1219.57, "text": "不要惊动任何人"}, {"start": 1247.32, "end": 1248.32, "text": "我家主公呢"}, {"start": 1248.32, "end": 1249.32, "text": "将军不必着急"}, {"start": 1249.32, "end": 1250.32, "text": "皇叔已经走了"}, {"start": 1365.46, "end": 1366.46, "text": "你家主公嘛"}, {"start": 1366.46, "end": 1367.46, "text": "他已经越到对岸去了"}, {"start": 1368.46, "end": 1377.24, "text": "这西界如此之高"}, {"start": 1378.24, "end": 1379.24, "text": "没有马可以越得过去"}, {"start": 1381.58, "end": 1382.58, "text": "将军说得没错"}, {"start": 1383.58, "end": 1384.58, "text": "可刘备却越过去了"}, {"start": 1389.58, "end": 1390.58, "text": "你为何带兵马来"}, {"start": 1391.58, "end": 1392.58, "text": "九郡四十二县的官员"}, {"start": 1392.58, "end": 1393.58, "text": "都聚在襄阳"}, {"start": 1394.58, "end": 1395.58, "text": "我身为京州上将"}, {"start": 1396.58, "end": 1397.58, "text": "岂能不来护卫"}, {"start": 1400.66, "end": 1401.66, "text": "你快说"}, {"start": 1401.66, "end": 1402.66, "text": "你把我主公怎么样了"}, {"start": 1403.66, "end": 1404.66, "text": "我并没有把他怎么样"}, {"start": 1405.66, "end": 1406.66, "text": "如果不信"}, {"start": 1406.66, "end": 1407.66, "text": "你自己问刘备去"}, {"start": 1407.66, "end": 1410.26, "text": "让开"}, {"start": 1410.26, "end": 1414.11, "text": "赵云"}, {"start": 1414.11, "end": 1415.11, "text": "你"}, {"start": 1416.11, "end": 1417.11, "text": "你家主公现在生死未过"}, {"start": 1419.42, "end": 1429.7, "text": "你想厮杀吗"}, {"start": 1537.23, "end": 1538.23, "text": "秦升突转高抗"}, {"start": 1539.23, "end": 1540.23, "text": "必有英雄窃听啊"}, {"start": 1544.23, "end": 1545.23, "text": "老朽无名"}, {"start": 1545.23, "end": 1546.23, "text": "别号水净"}, {"start": 1548.23, "end": 1549.23, "text": "在下刘备刘玄德"}, {"start": 1550.23, "end": 1551.23, "text": "拜见水净先生"}, {"start": 1554.23, "end": 1555.23, "text": "是刘皇叔啊"}, {"start": 1556.23, "end": 1557.23, "text": "幸会"}, {"start": 1559.23, "end": 1560.23, "text": "将军的作技"}, {"start": 1560.23, "end": 1561.23, "text": "如此神俊"}, {"start": 1562.23, "end": 1563.23, "text": "可将军的衣着"}, {"start": 1564.23, "end": 1565.23, "text": "却有如此的狼狈"}, {"start": 1567.23, "end": 1569.23, "text": "想必是刚刚多显吧"}, {"start": 1571.67, "end": 1572.67, "text": "先生慧眼"}, {"start": 1572.67, "end": 1573.67, "text": "动若观火"}, {"start": 1574.67, "end": 1576.67, "text": "在下被人追杀"}, {"start": 1577.67, "end": 1578.67, "text": "献马于五里外的"}, {"start": 1578.67, "end": 1579.67, "text": "河西间"}, {"start": 1580.67, "end": 1581.67, "text": "追兵张弓搭剑"}, {"start": 1582.67, "end": 1583.67, "text": "我以为必死无疑"}, {"start": 1584.67, "end": 1585.67, "text": "万疾之中"}, {"start": 1586.67, "end": 1587.67, "text": "不料这匹敌鲁马"}, {"start": 1588.67, "end": 1589.67, "text": "腾空而起"}, {"start": 1589.67, "end": 1590.67, "text": "越向对面高雅"}, {"start": 1591.67, "end": 1592.67, "text": "我才得图此难"}, {"start": 1593.67, "end": 1594.67, "text": "侥幸 侥幸"}, {"start": 1596.67, "end": 1597.67, "text": "若果真如此"}, {"start": 1598.67, "end": 1599.67, "text": "那老夫我"}, {"start": 1599.67, "end": 1600.67, "text": "更要祝贺你了"}, {"start": 1602.67, "end": 1603.67, "text": "为何"}, {"start": 1603.67, "end": 1604.67, "text": "那条河西"}, {"start": 1605.67, "end": 1606.67, "text": "名叫潭西"}, {"start": 1607.67, "end": 1608.67, "text": "想当年"}, {"start": 1608.67, "end": 1609.67, "text": "楚王项羽"}, {"start": 1609.67, "end": 1610.67, "text": "曾在那里"}, {"start": 1610.67, "end": 1611.67, "text": "屠杀了"}, {"start": 1611.67, "end": 1613.67, "text": "三十万秦国降兵啊"}, {"start": 1614.67, "end": 1616.67, "text": "整整杀了一个月呀"}, {"start": 1617.67, "end": 1618.67, "text": "真是不得了"}, {"start": 1619.67, "end": 1620.67, "text": "真是"}, {"start": 1620.67, "end": 1621.67, "text": "血流如河"}, {"start": 1621.67, "end": 1622.67, "text": "头颅如山啊"}, {"start": 1624.67, "end": 1625.67, "text": "潭西"}, {"start": 1625.67, "end": 1627.67, "text": "足足冲杀了好几年"}, {"start": 1628.67, "end": 1629.67, "text": "才将他们"}, {"start": 1629.67, "end": 1630.67, "text": "冲进了滔滔向江"}, {"start": 1632.67, "end": 1633.67, "text": "可想而知啊"}, {"start": 1633.67, "end": 1634.67, "text": "那溪水之中"}, {"start": 1635.67, "end": 1636.67, "text": "埋葬了多少"}, {"start": 1636.67, "end": 1637.67, "text": "英雄壮士"}, {"start": 1638.67, "end": 1639.67, "text": "又击砸了"}, {"start": 1639.67, "end": 1641.67, "text": "多少冤魂亡灵啊"}, {"start": 1642.67, "end": 1644.67, "text": "也只有刘将军你呀"}, {"start": 1645.67, "end": 1646.67, "text": "献马潭西之后"}, {"start": 1646.67, "end": 1648.67, "text": "居然还能腾空而起"}, {"start": 1648.67, "end": 1649.67, "text": "脱此踏难啊"}, {"start": 1650.67, "end": 1661.37, "text": "将军"}, {"start": 1661.37, "end": 1663.37, "text": "是应该感谢苍天了"}, {"start": 1664.37, "end": 1666.37, "text": "摄下还有水酒赋坛"}, {"start": 1667.37, "end": 1668.37, "text": "将军若不嫌弃"}, {"start": 1668.37, "end": 1669.37, "text": "吃剩几杯"}, {"start": 1669.37, "end": 1670.37, "text": "压压惊怒火"}, {"start": 1671.37, "end": 1673.37, "text": "多谢先生赐酒"}, {"start": 1674.37, "end": 1675.37, "text": "请吧"}, {"start": 1675.37, "end": 1689.97, "text": "将军"}, {"start": 1690.97, "end": 1691.97, "text": "依你所见"}, {"start": 1692.97, "end": 1695.97, "text": "荆州刘表的前途如何"}, {"start": 1695.97, "end": 1697.97, "text": "刘景升是无皇兄"}, {"start": 1697.97, "end": 1699.97, "text": "贤德仁义"}, {"start": 1699.97, "end": 1702.25, "text": "志勇生"}, {"start": 1702.25, "end": 1704.25, "text": "定能担当得起"}, {"start": 1704.25, "end": 1707.69, "text": "忠心汉业的大人"}, {"start": 1708.69, "end": 1711.0, "text": "将军啊"}, {"start": 1714.88, "end": 1716.88, "text": "将军所言"}, {"start": 1716.88, "end": 1717.88, "text": "怕是连将军"}, {"start": 1717.88, "end": 1719.88, "text": "自己都不相信"}, {"start": 1719.88, "end": 1721.88, "text": "你是爱于情面"}, {"start": 1721.88, "end": 1724.88, "text": "不仁直言其短罢了"}, {"start": 1725.88, "end": 1727.88, "text": "那么先生以为"}, {"start": 1727.88, "end": 1730.88, "text": "景升兄前景如何呢"}, {"start": 1730.88, "end": 1731.88, "text": "刘景升"}, {"start": 1734.26, "end": 1735.26, "text": "外有强敌"}, {"start": 1736.26, "end": 1737.26, "text": "家有内乱"}, {"start": 1738.26, "end": 1739.26, "text": "文武离心"}, {"start": 1739.26, "end": 1741.26, "text": "将帅不和"}, {"start": 1741.26, "end": 1742.26, "text": "荆州"}, {"start": 1743.26, "end": 1747.54, "text": "迟早落入他人之手啊"}, {"start": 1747.54, "end": 1748.54, "text": "在下是"}, {"start": 1749.54, "end": 1750.54, "text": "有苦难言"}, {"start": 1751.54, "end": 1752.54, "text": "先生则是"}, {"start": 1752.54, "end": 1754.54, "text": "一语道破"}, {"start": 1754.54, "end": 1755.54, "text": "年来"}, {"start": 1756.54, "end": 1762.0, "text": "这荆襄各郡之间"}, {"start": 1762.0, "end": 1764.0, "text": "盛传着一首"}, {"start": 1764.0, "end": 1765.0, "text": "童谣"}, {"start": 1767.0, "end": 1769.0, "text": "其末两句是"}, {"start": 1770.0, "end": 1771.0, "text": "最终天命"}, {"start": 1772.0, "end": 1773.0, "text": "有所归"}, {"start": 1774.0, "end": 1777.0, "text": "西中盘龙向天飞"}, {"start": 1778.0, "end": 1779.0, "text": "刘将军"}, {"start": 1780.0, "end": 1781.0, "text": "不觉得"}, {"start": 1782.0, "end": 1783.0, "text": "此谣"}, {"start": 1783.0, "end": 1785.0, "text": "正应了刘将军"}, {"start": 1785.0, "end": 1787.0, "text": "今日谈西月马"}, {"start": 1787.0, "end": 1788.0, "text": "最终天命"}, {"start": 1788.0, "end": 1789.0, "text": "有所归"}, {"start": 1791.5, "end": 1793.5, "text": "西中盘龙"}, {"start": 1793.5, "end": 1796.5, "text": "西中盘龙向天飞"}, {"start": 1797.5, "end": 1798.5, "text": "先生啊"}, {"start": 1798.5, "end": 1802.3, "text": "我兵威将寡"}, {"start": 1802.3, "end": 1804.3, "text": "多少年来"}, {"start": 1804.3, "end": 1805.3, "text": "屡战屡败"}, {"start": 1805.3, "end": 1808.41, "text": "我"}, {"start": 1808.41, "end": 1810.41, "text": "我这等人"}, {"start": 1811.41, "end": 1813.41, "text": "真的能成大业吗"}, {"start": 1814.41, "end": 1815.41, "text": "这世上"}, {"start": 1815.41, "end": 1817.41, "text": "英雄不少"}, {"start": 1818.41, "end": 1819.41, "text": "可叹"}, {"start": 1819.41, "end": 1821.41, "text": "兄有大志者多"}, {"start": 1822.41, "end": 1824.41, "text": "成其大业者少"}, {"start": 1824.41, "end": 1826.72, "text": "为何呀"}, {"start": 1828.72, "end": 1831.72, "text": "因为你想要一飞冲天"}, {"start": 1831.72, "end": 1834.72, "text": "那总得有两支羽翼相助吧"}, {"start": 1835.72, "end": 1836.72, "text": "也就是"}, {"start": 1836.72, "end": 1838.72, "text": "文武两翼"}, {"start": 1839.72, "end": 1840.72, "text": "将军是"}, {"start": 1840.72, "end": 1842.72, "text": "武强文弱"}, {"start": 1842.72, "end": 1843.72, "text": "其不下"}, {"start": 1843.72, "end": 1845.72, "text": "关羽张飞赵云"}, {"start": 1845.72, "end": 1847.72, "text": "都堪称是万人敌"}, {"start": 1848.72, "end": 1849.72, "text": "可是"}, {"start": 1849.72, "end": 1851.72, "text": "孙贤简雍弥方等辈"}, {"start": 1852.72, "end": 1854.72, "text": "均无经国济世之才呀"}, {"start": 1857.1, "end": 1858.1, "text": "所以呢"}, {"start": 1858.1, "end": 1859.1, "text": "将军"}, {"start": 1859.1, "end": 1861.1, "text": "只有一支羽翼"}, {"start": 1862.1, "end": 1863.1, "text": "将军"}, {"start": 1863.1, "end": 1865.1, "text": "缺少的是一位"}, {"start": 1865.1, "end": 1867.1, "text": "仰观天下"}, {"start": 1867.1, "end": 1870.1, "text": "胸有韬略的军师啊"}, {"start": 1871.1, "end": 1872.1, "text": "先生说得极是"}, {"start": 1872.1, "end": 1875.76, "text": "请问先生"}, {"start": 1875.76, "end": 1877.76, "text": "那这样的军师"}, {"start": 1878.76, "end": 1880.76, "text": "我何处寻求呢"}, {"start": 1880.76, "end": 1884.46, "text": "是有卧龙凤雏"}, {"start": 1884.46, "end": 1886.46, "text": "二人得一"}, {"start": 1886.46, "end": 1887.46, "text": "便可安天下"}, {"start": 1888.46, "end": 1889.46, "text": "卧龙凤雏"}, {"start": 1890.46, "end": 1891.46, "text": "此二人何在"}, {"start": 1892.46, "end": 1894.77, "text": "请先生指点"}, {"start": 1897.94, "end": 1898.94, "text": "天机不可谢"}, {"start": 1899.94, "end": 1900.94, "text": "将军见谅"}, {"start": 1900.94, "end": 1906.71, "text": "先生"}, {"start": 1906.71, "end": 1910.24, "text": "刘备"}, {"start": 1910.24, "end": 1912.24, "text": "既是得不到卧龙凤雏"}, {"start": 1913.24, "end": 1914.24, "text": "但若能"}, {"start": 1915.24, "end": 1917.24, "text": "请先生出山相助"}, {"start": 1917.24, "end": 1919.24, "text": "那也是三生有幸啊"}, {"start": 1922.24, "end": 1923.24, "text": "老朽年迈"}, {"start": 1923.24, "end": 1924.24, "text": "来日不多"}, {"start": 1925.24, "end": 1926.24, "text": "只有"}, {"start": 1926.24, "end": 1929.24, "text": "与这青山绿水相伴了"}, {"start": 1937.02, "end": 1938.02, "text": "将军莫急"}, {"start": 1938.02, "end": 1939.02, "text": "迟早会有"}, {"start": 1939.02, "end": 1941.02, "text": "强过老夫十倍者"}, {"start": 1941.02, "end": 1942.02, "text": "相助于你"}, {"start": 1943.02, "end": 1945.02, "text": "只待时运吧"}, {"start": 1946.02, "end": 1947.02, "text": "时不来"}, {"start": 1947.02, "end": 1948.02, "text": "运宜不至"}, {"start": 1949.02, "end": 1950.02, "text": "时来"}, {"start": 1950.02, "end": 1952.02, "text": "万事顺遂"}, {"start": 1953.02, "end": 1957.93, "text": "多谢先生教诲"}, {"start": 1958.93, "end": 1959.93, "text": "来来来"}, {"start": 1959.93, "end": 1960.93, "text": "吃酒"}, {"start": 1960.93, "end": 1961.93, "text": "吃酒"}, {"start": 1961.93, "end": 1962.93, "text": "是原池啊"}, {"start": 1978.42, "end": 1979.42, "text": "你不是受刘表之约"}, {"start": 1979.42, "end": 1981.42, "text": "去青州了吗"}, {"start": 1982.42, "end": 1984.42, "text": "言何深夜到此"}, {"start": 1984.42, "end": 1985.42, "text": "在下失去了一趟"}, {"start": 1985.42, "end": 1986.42, "text": "荆州府"}, {"start": 1987.42, "end": 1988.42, "text": "但刘锦升此功啊"}, {"start": 1989.42, "end": 1990.42, "text": "虽有善心"}, {"start": 1990.42, "end": 1991.42, "text": "却无大事"}, {"start": 1991.42, "end": 1992.42, "text": "徒具虚名而已"}, {"start": 1993.42, "end": 1994.42, "text": "两天不到"}, {"start": 1994.42, "end": 1995.42, "text": "我已看破极短"}, {"start": 1996.42, "end": 1997.42, "text": "刘表喜善"}, {"start": 1997.42, "end": 1998.42, "text": "而不能用"}, {"start": 1998.42, "end": 1999.42, "text": "恨恶"}, {"start": 1999.42, "end": 2000.42, "text": "又不能除之"}, {"start": 2001.42, "end": 2002.42, "text": "外不能遇将士"}, {"start": 2003.42, "end": 2004.42, "text": "内不能治家政"}, {"start": 2005.42, "end": 2006.42, "text": "我料他"}, {"start": 2006.42, "end": 2007.42, "text": "早晚自献其祸"}, {"start": 2007.42, "end": 2009.42, "text": "我怕刘府强留于我"}, {"start": 2009.42, "end": 2011.42, "text": "我便星夜离开了荆州"}, {"start": 2011.42, "end": 2012.42, "text": "轻声轻声"}, {"start": 2012.42, "end": 2013.42, "text": "我这里另有贵客"}, {"start": 2015.42, "end": 2016.42, "text": "放心"}, {"start": 2016.42, "end": 2017.42, "text": "贵客何人"}, {"start": 2017.42, "end": 2019.42, "text": "在下大梦初醒"}, {"start": 2019.42, "end": 2020.42, "text": "左将军刘备"}, {"start": 2020.42, "end": 2025.23, "text": "拜上"}, {"start": 2026.23, "end": 2027.23, "text": "原来是刘皇叔啊"}, {"start": 2028.23, "end": 2029.23, "text": "缘分"}, {"start": 2029.23, "end": 2030.23, "text": "缘分啊"}, {"start": 2030.23, "end": 2031.23, "text": "先生"}, {"start": 2031.23, "end": 2032.23, "text": "是你"}, {"start": 2035.22, "end": 2036.22, "text": "敢问阁下"}, {"start": 2036.22, "end": 2038.22, "text": "是卧龙还是凤雏"}, {"start": 2039.22, "end": 2040.22, "text": "区区在下"}, {"start": 2040.22, "end": 2041.22, "text": "既非卧龙"}, {"start": 2041.22, "end": 2042.22, "text": "也非凤雏"}, {"start": 2043.22, "end": 2044.22, "text": "在下"}, {"start": 2044.22, "end": 2045.22, "text": "姓徐名树"}, {"start": 2045.22, "end": 2046.22, "text": "在下"}, {"start": 2046.22, "end": 2047.22, "text": "姓徐名树"}, {"start": 2047.22, "end": 2048.22, "text": "自原之"}, {"start": 2049.22, "end": 2050.22, "text": "刚才我在里面"}, {"start": 2050.22, "end": 2051.22, "text": "听先生所言"}, {"start": 2052.22, "end": 2053.22, "text": "一语便能道破"}, {"start": 2053.22, "end": 2054.22, "text": "刘景升之弊端"}, {"start": 2055.22, "end": 2056.22, "text": "即使不是卧龙凤雏"}, {"start": 2056.22, "end": 2058.22, "text": "定然远胜卧龙凤雏"}, {"start": 2059.22, "end": 2060.22, "text": "万不敢当"}, {"start": 2060.22, "end": 2062.22, "text": "在下与卧龙和凤雏相比"}, {"start": 2063.22, "end": 2064.22, "text": "犹如繁星"}, {"start": 2064.22, "end": 2065.22, "text": "比于昊玥"}, {"start": 2066.22, "end": 2067.22, "text": "先生太过谦虚了"}, {"start": 2069.22, "end": 2071.22, "text": "玄德所说不错"}, {"start": 2072.22, "end": 2073.22, "text": "但凡才华超群"}, {"start": 2073.22, "end": 2074.22, "text": "精伦满腹者"}, {"start": 2075.22, "end": 2076.22, "text": "往往偏做谦虚"}, {"start": 2077.22, "end": 2078.22, "text": "请吧请吧"}, {"start": 2078.22, "end": 2079.22, "text": "请入座"}, {"start": 2079.22, "end": 2080.22, "text": "皇叔请"}, {"start": 2080.22, "end": 2081.22, "text": "皇叔请"}, {"start": 2081.22, "end": 2097.52, "text": "我久闻刘皇叔仁义"}, {"start": 2097.52, "end": 2099.52, "text": "那天故意借狄鲁玛一事"}, {"start": 2101.52, "end": 2102.52, "text": "果然是"}, {"start": 2104.52, "end": 2106.52, "text": "先生说狄鲁玛房主"}, {"start": 2107.52, "end": 2109.52, "text": "果然异语重地"}, {"start": 2110.52, "end": 2111.52, "text": "当日"}, {"start": 2111.52, "end": 2113.52, "text": "我便现马谈西"}, {"start": 2113.52, "end": 2114.52, "text": "差点送命"}, {"start": 2114.52, "end": 2116.52, "text": "狄鲁玛方得懂寻常庸主"}, {"start": 2116.52, "end": 2118.52, "text": "却方不懂名功"}, {"start": 2119.52, "end": 2120.52, "text": "我离开荆州时"}, {"start": 2120.52, "end": 2122.52, "text": "顺路访查了新野"}, {"start": 2123.52, "end": 2125.52, "text": "在乡下已有名谣了"}, {"start": 2126.52, "end": 2127.52, "text": "唱的是"}, {"start": 2128.52, "end": 2129.52, "text": "新野牧"}, {"start": 2129.52, "end": 2130.52, "text": "刘皇叔"}, {"start": 2131.52, "end": 2134.12, "text": "自到此"}, {"start": 2134.12, "end": 2135.12, "text": "名丰足"}, {"start": 2137.12, "end": 2138.12, "text": "我听后甚是感慨"}, {"start": 2139.12, "end": 2140.12, "text": "因为阁下铸新野"}, {"start": 2140.12, "end": 2141.12, "text": "刚刚一年"}, {"start": 2141.12, "end": 2143.12, "text": "就有如此的名声"}, {"start": 2143.12, "end": 2144.12, "text": "真是"}, {"start": 2144.12, "end": 2145.12, "text": "仁义之君"}, {"start": 2145.12, "end": 2146.12, "text": "感召天下"}, {"start": 2148.12, "end": 2149.12, "text": "阁下"}, {"start": 2149.12, "end": 2151.12, "text": "无论是荣是衰"}, {"start": 2151.12, "end": 2153.12, "text": "也无论是胜是败"}, {"start": 2154.12, "end": 2156.12, "text": "总会有民心相随"}, {"start": 2156.12, "end": 2157.12, "text": "须知"}, {"start": 2157.12, "end": 2159.12, "text": "民谣所唱"}, {"start": 2159.12, "end": 2160.12, "text": "便是民心所向"}, {"start": 2161.12, "end": 2163.12, "text": "而能得到民心者"}, {"start": 2163.12, "end": 2165.12, "text": "距离得天意"}, {"start": 2165.12, "end": 2166.12, "text": "也就不远了"}, {"start": 2167.12, "end": 2168.12, "text": "宣德君"}, {"start": 2168.12, "end": 2169.12, "text": "你也知道"}, {"start": 2169.12, "end": 2170.12, "text": "刚才"}, {"start": 2170.12, "end": 2171.12, "text": "原旨所言"}, {"start": 2179.84, "end": 2180.84, "text": "是刘备此声"}, {"start": 2181.84, "end": 2182.84, "text": "听到的"}, {"start": 2182.84, "end": 2183.84, "text": "最动心的"}, {"start": 2183.84, "end": 2184.84, "text": "但也犹如"}, {"start": 2184.84, "end": 2186.84, "text": "一把利剑传心的"}, {"start": 2186.84, "end": 2188.84, "text": "痛且快哉"}, {"start": 2188.84, "end": 2189.84, "text": "刘备不才"}, {"start": 2192.38, "end": 2194.38, "text": "想请你出山"}, {"start": 2194.38, "end": 2197.78, "text": "担当我的军师"}, {"start": 2197.78, "end": 2206.41, "text": "以便早晚手脚"}, {"start": 2207.41, "end": 2208.41, "text": "在下"}, {"start": 2208.41, "end": 2209.41, "text": "才识学弄"}, {"start": 2209.41, "end": 2210.41, "text": "却不知"}, {"start": 2210.41, "end": 2211.41, "text": "何以"}, {"start": 2211.41, "end": 2212.41, "text": "却不知"}, {"start": 2212.41, "end": 2214.82, "text": "怎么讲"}, {"start": 2214.82, "end": 2215.82, "text": "在下"}, {"start": 2215.82, "end": 2216.82, "text": "才识学弄"}, {"start": 2217.82, "end": 2218.82, "text": "万万当不起"}, {"start": 2218.82, "end": 2219.82, "text": "如此大任"}, {"start": 2219.82, "end": 2220.82, "text": "明宫"}, {"start": 2220.82, "end": 2221.82, "text": "另请他人吧"}, {"start": 2222.82, "end": 2223.82, "text": "我刘备"}, {"start": 2224.82, "end": 2225.82, "text": "二十多年"}, {"start": 2225.82, "end": 2226.82, "text": "一直盼望"}, {"start": 2226.82, "end": 2227.82, "text": "能有先生"}, {"start": 2227.82, "end": 2228.82, "text": "这样的高士相助"}, {"start": 2229.82, "end": 2230.82, "text": "可以说"}, {"start": 2230.82, "end": 2231.82, "text": "朝思暮想"}, {"start": 2232.82, "end": 2233.82, "text": "今日"}, {"start": 2233.82, "end": 2234.82, "text": "能与先生相遇"}, {"start": 2235.82, "end": 2236.82, "text": "有如大寒风干练"}, {"start": 2237.82, "end": 2238.82, "text": "刘备"}, {"start": 2238.82, "end": 2239.82, "text": "叩请先生"}, {"start": 2240.82, "end": 2241.82, "text": "相助我一笔之礼"}, {"start": 2241.82, "end": 2244.16, "text": "明宫之意"}, {"start": 2244.16, "end": 2245.16, "text": "令我万分感动"}, {"start": 2246.16, "end": 2247.16, "text": "但军师大任"}, {"start": 2248.16, "end": 2249.16, "text": "我确实"}, {"start": 2249.16, "end": 2250.16, "text": "不敢担当"}, {"start": 2260.82, "end": 2261.82, "text": "徐述啊"}, {"start": 2261.82, "end": 2262.82, "text": "刘皇叔"}, {"start": 2262.82, "end": 2264.82, "text": "如此将尊于贵"}, {"start": 2264.82, "end": 2266.82, "text": "屈膝相求"}, {"start": 2266.82, "end": 2268.82, "text": "已足见其成了"}, {"start": 2268.82, "end": 2270.82, "text": "你就答应了吧"}, {"start": 2270.82, "end": 2271.82, "text": "否则"}, {"start": 2271.82, "end": 2273.82, "text": "您那满腹经纶"}, {"start": 2273.82, "end": 2275.82, "text": "怕是要荒废了呀"}, {"start": 2276.82, "end": 2277.82, "text": "自古来"}, {"start": 2278.82, "end": 2280.82, "text": "才是一德"}, {"start": 2280.82, "end": 2281.82, "text": "名主难求啊"}, {"start": 2283.82, "end": 2284.82, "text": "刘皇叔"}, {"start": 2284.82, "end": 2286.82, "text": "虽然时运不济"}, {"start": 2286.82, "end": 2288.82, "text": "可他无疑是一位"}, {"start": 2288.82, "end": 2289.82, "text": "贤民之主啊"}, {"start": 2290.82, "end": 2291.82, "text": "迟早"}, {"start": 2291.82, "end": 2293.82, "text": "会亦飞冲天"}, {"start": 2293.82, "end": 2294.82, "text": "成其大业"}, {"start": 2295.82, "end": 2296.82, "text": "今日"}, {"start": 2296.82, "end": 2299.82, "text": "你俩在我寒舍相见"}, {"start": 2299.82, "end": 2302.82, "text": "也是天衣使然"}, {"start": 2307.06, "end": 2308.06, "text": "奉先生为师"}, {"start": 2309.06, "end": 2310.06, "text": "终生不改"}, {"start": 2310.06, "end": 2319.51, "text": "徐述"}, {"start": 2319.51, "end": 2320.51, "text": "奉命了"}, {"start": 2320.51, "end": 2324.97, "text": "好"}, {"start": 2324.97, "end": 2325.97, "text": "好"}, {"start": 2325.97, "end": 2326.97, "text": "先生快快请起"}, {"start": 2329.97, "end": 2330.97, "text": "二位相识"}, {"start": 2331.97, "end": 2333.97, "text": "真是天地宦然"}, {"start": 2333.97, "end": 2336.97, "text": "可贺可贺可贺可贺"}, {"start": 2336.97, "end": 2337.97, "text": "是子龙"}, {"start": 2342.78, "end": 2343.78, "text": "二位先生"}, {"start": 2343.78, "end": 2345.78, "text": "是我不将赵云寻我来了"}, {"start": 2346.78, "end": 2347.78, "text": "常山赵子龙"}, {"start": 2348.78, "end": 2349.78, "text": "威名满天下"}, {"start": 2349.78, "end": 2350.78, "text": "快请"}, {"start": 2350.78, "end": 2351.78, "text": "快请他进来"}, {"start": 2351.78, "end": 2352.78, "text": "子龙"}, {"start": 2352.78, "end": 2353.78, "text": "主公"}, {"start": 2353.78, "end": 2362.2, "text": "子龙"}, {"start": 2362.2, "end": 2364.51, "text": "你怎么寻到这里来的"}, {"start": 2364.51, "end": 2365.51, "text": "牧家找了一夜"}, {"start": 2365.51, "end": 2366.51, "text": "终于发现马蹄印"}, {"start": 2366.51, "end": 2367.51, "text": "按照马蹄印"}, {"start": 2367.51, "end": 2368.51, "text": "才找到这儿的"}, {"start": 2369.51, "end": 2370.51, "text": "忠勇啊"}, {"start": 2370.51, "end": 2371.51, "text": "难得呀"}, {"start": 2372.51, "end": 2373.51, "text": "这位是"}, {"start": 2374.51, "end": 2375.51, "text": "水净先生"}, {"start": 2375.51, "end": 2377.51, "text": "这位是徐述先生"}, {"start": 2377.51, "end": 2378.51, "text": "这位便是"}, {"start": 2378.51, "end": 2380.51, "text": "赵云赵子龙"}, {"start": 2380.51, "end": 2388.3, "text": "曹操战败袁绍之后"}, {"start": 2388.3, "end": 2390.3, "text": "当需修兵一年"}, {"start": 2390.3, "end": 2392.3, "text": "以求囤积粮饷"}, {"start": 2392.3, "end": 2393.3, "text": "军信"}, {"start": 2393.3, "end": 2396.3, "text": "之后再挥师取天下"}, {"start": 2396.3, "end": 2397.3, "text": "其兵封所向"}, {"start": 2397.3, "end": 2400.3, "text": "必然只取荆州九郡"}, {"start": 2400.3, "end": 2401.3, "text": "而我们依附刘表"}, {"start": 2401.3, "end": 2403.3, "text": "驻兵兴隐"}, {"start": 2403.3, "end": 2405.3, "text": "自然是首当其冲"}, {"start": 2405.3, "end": 2408.87, "text": "我料曹操大军启时"}, {"start": 2408.87, "end": 2410.87, "text": "应在明年开春"}, {"start": 2410.87, "end": 2412.87, "text": "依曹操用兵的习惯"}, {"start": 2413.87, "end": 2414.87, "text": "在大军启之前"}, {"start": 2414.87, "end": 2416.87, "text": "总要先着一支禁吕"}, {"start": 2416.87, "end": 2418.87, "text": "攻入荆乡"}, {"start": 2418.87, "end": 2419.87, "text": "攻城略地"}, {"start": 2420.87, "end": 2422.87, "text": "但曹操的用意"}, {"start": 2422.87, "end": 2424.87, "text": "并不在乎此禁吕"}, {"start": 2424.87, "end": 2425.87, "text": "胜负如何"}, {"start": 2425.87, "end": 2427.87, "text": "战祸多少"}, {"start": 2427.87, "end": 2429.87, "text": "而是用这支禁吕"}, {"start": 2429.87, "end": 2432.87, "text": "探查荆州的防务虚实"}, {"start": 2432.87, "end": 2435.87, "text": "以找出敌军的薄弱所在"}, {"start": 2436.87, "end": 2437.87, "text": "甚至找出"}, {"start": 2437.87, "end": 2440.87, "text": "刘表兵马的优劣长短"}, {"start": 2441.87, "end": 2443.87, "text": "昔日我与曹操交战"}, {"start": 2443.87, "end": 2445.87, "text": "曾有多少不解除"}, {"start": 2446.87, "end": 2448.87, "text": "今日听军师一言"}, {"start": 2448.87, "end": 2450.87, "text": "豁然开朗"}, {"start": 2450.87, "end": 2451.87, "text": "因此"}, {"start": 2451.87, "end": 2457.33, "text": "我军当前药物有二"}, {"start": 2458.33, "end": 2459.33, "text": "其"}, {"start": 2459.33, "end": 2461.33, "text": "请云长子龙各饮一步"}, {"start": 2461.33, "end": 2463.33, "text": "在新野城外三十里处"}, {"start": 2463.33, "end": 2465.33, "text": "扎下营寨"}, {"start": 2465.33, "end": 2466.33, "text": "云长营为虚"}, {"start": 2466.33, "end": 2468.33, "text": "子龙营为实"}, {"start": 2468.33, "end": 2469.33, "text": "二营于新野"}, {"start": 2469.33, "end": 2471.33, "text": "互成计较之势"}, {"start": 2471.33, "end": 2473.33, "text": "而且虚实相应"}, {"start": 2473.33, "end": 2475.33, "text": "已被曹军来犯"}, {"start": 2475.33, "end": 2477.61, "text": "其二"}, {"start": 2477.61, "end": 2479.61, "text": "孙乾芈芳继续招兵买马"}, {"start": 2479.61, "end": 2481.61, "text": "扩充军备"}, {"start": 2481.61, "end": 2482.61, "text": "已准备明年那场"}, {"start": 2482.61, "end": 2484.61, "text": "生死存亡的大战"}, {"start": 2484.61, "end": 2487.98, "text": "其实说了半天"}, {"start": 2487.98, "end": 2488.98, "text": "却没有说"}, {"start": 2488.98, "end": 2489.98, "text": "曹操那支禁吕"}, {"start": 2489.98, "end": 2491.98, "text": "何时来犯"}, {"start": 2491.98, "end": 2492.98, "text": "三十天以后"}, {"start": 2492.98, "end": 2495.98, "text": "前后相差不会一两天"}, {"start": 2496.98, "end": 2498.98, "text": "干吗非要三十日之后"}, {"start": 2498.98, "end": 2499.98, "text": "我要是曹操"}, {"start": 2499.98, "end": 2501.98, "text": "明天就攻过来了"}, {"start": 2501.98, "end": 2503.98, "text": "三弟所言极是"}, {"start": 2504.98, "end": 2505.98, "text": "官某"}, {"start": 2505.98, "end": 2506.98, "text": "虽然不像先生那样"}, {"start": 2506.98, "end": 2507.98, "text": "会算命"}, {"start": 2507.98, "end": 2509.98, "text": "但也粗知兵法"}, {"start": 2509.98, "end": 2511.98, "text": "兵贵神速"}, {"start": 2511.98, "end": 2512.98, "text": "才是良将"}, {"start": 2512.98, "end": 2514.98, "text": "官将近谦虚了"}, {"start": 2517.78, "end": 2518.78, "text": "你深知兵法"}, {"start": 2518.78, "end": 2520.78, "text": "早已堪称良将"}, {"start": 2520.78, "end": 2522.78, "text": "不过兵者"}, {"start": 2522.78, "end": 2524.78, "text": "应当顺天而进"}, {"start": 2524.78, "end": 2526.78, "text": "不应当逆天而行"}, {"start": 2526.78, "end": 2527.78, "text": "兵后天起"}, {"start": 2527.78, "end": 2528.78, "text": "京乡一带"}, {"start": 2528.78, "end": 2530.78, "text": "将进入秋雨时节"}, {"start": 2530.78, "end": 2531.78, "text": "长达二时"}, {"start": 2531.78, "end": 2533.78, "text": "等地面风干"}, {"start": 2533.78, "end": 2534.78, "text": "还需三五日"}, {"start": 2534.78, "end": 2536.78, "text": "从许昌发兵至此"}, {"start": 2536.78, "end": 2538.78, "text": "又需三五日"}, {"start": 2538.78, "end": 2539.78, "text": "而曹操的禁吕"}, {"start": 2539.78, "end": 2541.78, "text": "多为北方铁技"}, {"start": 2541.78, "end": 2542.78, "text": "总不至于"}, {"start": 2542.78, "end": 2544.78, "text": "陷在泥泞当中作战吧"}, {"start": 2546.78, "end": 2547.78, "text": "所以我说"}, {"start": 2547.78, "end": 2548.78, "text": "各位"}, {"start": 2548.78, "end": 2550.78, "text": "快快遵从军师吩咐"}, {"start": 2550.78, "end": 2551.78, "text": "分头行事"}, {"start": 2551.78, "end": 2552.78, "text": "切记"}, {"start": 2553.78, "end": 2565.7, "text": "军师所言"}, {"start": 2565.7, "end": 2567.7, "text": "句句都是军令"}, {"start": 2567.7, "end": 2568.7, "text": "遵命"}, {"start": 2568.7, "end": 2569.7, "text": "据报"}, {"start": 2570.7, "end": 2572.7, "text": "刘表旧病复发"}, {"start": 2572.7, "end": 2573.7, "text": "卧床不起"}, {"start": 2573.7, "end": 2575.7, "text": "金州军务"}, {"start": 2575.7, "end": 2581.82, "text": "大多落在了"}, {"start": 2581.82, "end": 2583.82, "text": "水师将军蔡茂手里"}, {"start": 2583.82, "end": 2584.82, "text": "此人"}, {"start": 2584.82, "end": 2585.82, "text": "水战尚可"}, {"start": 2585.82, "end": 2586.82, "text": "陆战尚可"}, {"start": 2586.82, "end": 2587.82, "text": "此人"}, {"start": 2587.82, "end": 2588.82, "text": "此人"}, {"start": 2588.82, "end": 2589.82, "text": "此人"}, {"start": 2589.82, "end": 2590.82, "text": "此人"}, {"start": 2590.82, "end": 2591.82, "text": "此人"}, {"start": 2591.82, "end": 2592.82, "text": "水战尚可"}, {"start": 2592.82, "end": 2593.82, "text": "陆战无能"}, {"start": 2593.82, "end": 2595.82, "text": "而与此同时"}, {"start": 2595.82, "end": 2597.82, "text": "刘备正在新野"}, {"start": 2597.82, "end": 2598.82, "text": "招兵买马"}, {"start": 2598.82, "end": 2600.82, "text": "扩军备战"}, {"start": 2600.82, "end": 2602.82, "text": "一日作大一日"}, {"start": 2602.82, "end": 2603.82, "text": "我意"}, {"start": 2603.82, "end": 2606.82, "text": "即向金州用兵"}, {"start": 2606.82, "end": 2608.82, "text": "攻伐刘备"}]