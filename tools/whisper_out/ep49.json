[{"start": 6.06, "end": 9.06, "text": "末将是有意让他们给擒去的。"}, {"start": 10.06, "end": 12.06, "text": "什么?你是有意让他们给擒去的?"}, {"start": 13.06, "end": 18.26, "text": "刚才末将出战时,"}, {"start": 19.26, "end": 20.26, "text": "这敌方军事浩大。"}, {"start": 21.26, "end": 22.26, "text": "我想,"}, {"start": 22.26, "end": 24.26, "text": "此战只宜制曲,"}, {"start": 25.26, "end": 26.26, "text": "不宜强攻。"}, {"start": 26.26, "end": 29.26, "text": "所以,等我与张飞赵云接战时,"}, {"start": 29.26, "end": 31.26, "text": "我虽然可以抵挡一阵,"}, {"start": 32.26, "end": 33.26, "text": "却故意扬作不敌,"}, {"start": 34.26, "end": 36.26, "text": "有意让赵云包给拿下。"}, {"start": 37.26, "end": 41.34, "text": "那后来呢?"}, {"start": 41.34, "end": 44.81, "text": "后来到了刘备的中军大帐,"}, {"start": 45.81, "end": 46.81, "text": "刘备见了我,"}, {"start": 46.81, "end": 48.81, "text": "亲自为末将松绑,"}, {"start": 48.81, "end": 50.81, "text": "并许末将以高官厚路,"}, {"start": 51.81, "end": 52.81, "text": "赐金封爵。"}, {"start": 53.81, "end": 54.81, "text": "更无耻的是,"}, {"start": 55.81, "end": 57.81, "text": "刘备想收末将为女婿,"}, {"start": 58.81, "end": 60.81, "text": "硬要把女儿嫁于末将。"}, {"start": 61.81, "end": 62.81, "text": "星道荣,"}, {"start": 62.81, "end": 64.81, "text": "你艳福不浅哪。"}, {"start": 64.81, "end": 67.34, "text": "启禀主公,"}, {"start": 68.34, "end": 70.34, "text": "我岂不知刘备虚心假意,"}, {"start": 70.34, "end": 71.34, "text": "暗藏祸心。"}, {"start": 72.34, "end": 73.34, "text": "我呢,"}, {"start": 73.34, "end": 74.34, "text": "就假装接受了。"}, {"start": 75.34, "end": 76.34, "text": "果然,"}, {"start": 76.34, "end": 78.34, "text": "刘备让我扬作内应,"}, {"start": 78.34, "end": 81.34, "text": "约定今夜三更举火为后,"}, {"start": 81.34, "end": 82.34, "text": "他引兵来袭。"}, {"start": 83.34, "end": 84.34, "text": "主公,"}, {"start": 84.34, "end": 86.34, "text": "这可是天大的良机啊。"}, {"start": 87.34, "end": 88.34, "text": "到时,"}, {"start": 88.34, "end": 90.34, "text": "主公可以在城内设下伏兵,"}, {"start": 90.34, "end": 91.34, "text": "安排好弩手,"}, {"start": 91.34, "end": 93.34, "text": "待末将把他们引入瓮城,"}, {"start": 93.34, "end": 94.34, "text": "万箭齐发,"}, {"start": 94.34, "end": 96.34, "text": "射杀刘备张飞诸葛亮。"}, {"start": 96.34, "end": 97.34, "text": "到时候,"}, {"start": 97.34, "end": 98.34, "text": "本将军再以一队兵马,"}, {"start": 98.34, "end": 99.34, "text": "直取荆州,"}, {"start": 99.34, "end": 100.34, "text": "拿下关羽。"}, {"start": 100.34, "end": 101.34, "text": "此荆襄九郡,"}, {"start": 101.34, "end": 103.34, "text": "可竟归主公之首啊。"}, {"start": 105.34, "end": 106.34, "text": "妙计啊妙计,"}, {"start": 106.34, "end": 108.94, "text": "行道荣,"}, {"start": 108.94, "end": 110.94, "text": "看来你使计炸了刘备他们,"}, {"start": 111.94, "end": 112.94, "text": "可是,"}, {"start": 113.94, "end": 115.94, "text": "又怎见得你不会使计炸我们呢。"}, {"start": 117.94, "end": 118.94, "text": "公子,"}, {"start": 118.94, "end": 119.94, "text": "公子你,"}, {"start": 120.94, "end": 129.57, "text": "这么看待末将,"}, {"start": 129.57, "end": 131.57, "text": "我行道荣跟随主公多年,"}, {"start": 135.29, "end": 138.29, "text": "主公对我分同采造。"}, {"start": 138.29, "end": 141.29, "text": "我既能做出如此悲主之事啊。"}, {"start": 142.29, "end": 143.29, "text": "我行道荣,"}, {"start": 143.29, "end": 145.29, "text": "如有半句虚言,"}, {"start": 146.29, "end": 147.29, "text": "生死,"}, {"start": 147.29, "end": 148.29, "text": "天打雷劈,"}, {"start": 148.29, "end": 149.29, "text": "死死,"}, {"start": 150.29, "end": 151.29, "text": "错过扬回啊。"}, {"start": 153.29, "end": 154.29, "text": "行将军,"}, {"start": 155.29, "end": 161.18, "text": "是个直人,"}, {"start": 162.18, "end": 163.18, "text": "再说,"}, {"start": 163.18, "end": 164.18, "text": "依他的本事,"}, {"start": 164.18, "end": 168.18, "text": "是想不出这个诱敌伏击的主意的。"}, {"start": 169.18, "end": 170.18, "text": "这个主意,"}, {"start": 170.18, "end": 172.18, "text": "必是诸葛亮令他这么做的。"}, {"start": 173.18, "end": 174.18, "text": "道荣啊,"}, {"start": 175.18, "end": 176.18, "text": "我看,"}, {"start": 176.18, "end": 179.46, "text": "你就依计行事吧。"}, {"start": 180.46, "end": 181.46, "text": "末将,"}, {"start": 181.46, "end": 182.46, "text": "遵命。"}, {"start": 185.46, "end": 186.46, "text": "行将军何在?"}, {"start": 186.46, "end": 203.28, "text": "我家主公要和他说啊。"}, {"start": 204.28, "end": 205.28, "text": "刘皇叔何在?"}, {"start": 205.28, "end": 209.97, "text": "我家主公在此,"}, {"start": 209.97, "end": 217.86, "text": "快快打开城门。"}, {"start": 217.86, "end": 218.86, "text": "开城门。"}, {"start": 218.86, "end": 219.86, "text": "你中计了,"}, {"start": 219.86, "end": 224.77, "text": "还不快下马戳墙。"}, {"start": 224.77, "end": 261.67, "text": "不好,"}, {"start": 261.67, "end": 262.67, "text": "他一定有埋伏。"}, {"start": 263.67, "end": 264.67, "text": "赶快掩护主公,"}, {"start": 264.67, "end": 265.67, "text": "从中从尾。"}, {"start": 265.67, "end": 266.67, "text": "诺。"}, {"start": 266.67, "end": 267.67, "text": "放箭射杀。"}, {"start": 267.67, "end": 268.67, "text": "诺。"}, {"start": 268.67, "end": 269.67, "text": "你不要抓我吗?"}, {"start": 270.67, "end": 274.98, "text": "反倒被我给拿下了。"}, {"start": 375.6, "end": 376.6, "text": "左右。"}, {"start": 376.6, "end": 377.6, "text": "在。"}, {"start": 377.6, "end": 378.6, "text": "把他给我绑了。"}, {"start": 378.6, "end": 379.6, "text": "诺。"}, {"start": 384.6, "end": 385.6, "text": "公子,"}, {"start": 385.6, "end": 386.6, "text": "此人不是刘备。"}, {"start": 387.6, "end": 388.6, "text": "刘备,"}, {"start": 388.6, "end": 389.6, "text": "听这脚步声,"}, {"start": 389.6, "end": 391.6, "text": "定是大获全胜了。"}, {"start": 427.42, "end": 428.42, "text": "军师,"}, {"start": 428.42, "end": 430.42, "text": "你果然是料事如神啊。"}, {"start": 430.42, "end": 434.17, "text": "那行道容,"}, {"start": 434.17, "end": 435.17, "text": "真不是个好鸟。"}, {"start": 436.17, "end": 438.17, "text": "他摆下了个工土阵,"}, {"start": 438.17, "end": 439.17, "text": "骗我入圈套。"}, {"start": 440.17, "end": 441.17, "text": "不过,"}, {"start": 441.17, "end": 443.17, "text": "幸亏他使了这奸计。"}, {"start": 444.17, "end": 446.17, "text": "反而让我不用工程,"}, {"start": 446.17, "end": 448.17, "text": "就拿了刘杜的儿子刘贤了。"}, {"start": 450.17, "end": 451.17, "text": "刘贤在哪儿?"}, {"start": 451.17, "end": 452.17, "text": "在那儿。"}, {"start": 452.17, "end": 453.17, "text": "刘贤在哪儿?"}, {"start": 453.17, "end": 454.17, "text": "在那儿。"}, {"start": 454.17, "end": 455.17, "text": "刘贤在哪儿?"}, {"start": 456.17, "end": 457.17, "text": "让我绑在后头马就了。"}, {"start": 458.17, "end": 459.17, "text": "这岂是待客之道?"}, {"start": 459.17, "end": 460.17, "text": "快快快,请上来。"}, {"start": 461.17, "end": 462.17, "text": "易德,"}, {"start": 462.17, "end": 463.17, "text": "你立了大功,"}, {"start": 463.17, "end": 464.17, "text": "拿了刘贤,"}, {"start": 464.17, "end": 466.17, "text": "就等于得到了灵灵。"}, {"start": 467.17, "end": 468.17, "text": "这是为何?"}, {"start": 469.17, "end": 470.17, "text": "我早就说过,"}, {"start": 470.17, "end": 471.17, "text": "刘杜生性懦弱,"}, {"start": 472.17, "end": 473.17, "text": "却一向疼爱这个独子,"}, {"start": 473.17, "end": 474.17, "text": "视作为姓名。"}, {"start": 475.17, "end": 477.17, "text": "灵灵城中有大半事情,"}, {"start": 477.17, "end": 478.17, "text": "都是刘贤做的主。"}, {"start": 479.17, "end": 480.17, "text": "看着吧,"}, {"start": 480.17, "end": 481.17, "text": "明儿一大早,"}, {"start": 481.17, "end": 482.17, "text": "刘杜定会高举祥旗,"}, {"start": 482.17, "end": 483.17, "text": "大开城门,"}, {"start": 483.17, "end": 484.17, "text": "击凤授印前来请祥,"}, {"start": 485.17, "end": 486.17, "text": "以换取刘贤的性命。"}, {"start": 487.17, "end": 488.17, "text": "这小子,"}, {"start": 488.17, "end": 489.17, "text": "竟是一座大城啊。"}, {"start": 490.17, "end": 491.17, "text": "好,"}, {"start": 491.17, "end": 492.17, "text": "值了,值了。"}, {"start": 493.17, "end": 518.97, "text": "灵灵城,"}, {"start": 519.97, "end": 520.97, "text": "太守刘杜,"}, {"start": 520.97, "end": 522.97, "text": "恭迎刘皇叔。"}, {"start": 523.97, "end": 525.97, "text": "恭迎刘皇叔。"}, {"start": 525.97, "end": 526.97, "text": "太客气了,"}, {"start": 533.25, "end": 534.25, "text": "你也是皇族后裔,"}, {"start": 535.25, "end": 536.25, "text": "我们相见很晚了。"}, {"start": 536.25, "end": 537.25, "text": "不敢,不敢。"}, {"start": 538.25, "end": 539.25, "text": "在下,"}, {"start": 539.25, "end": 540.25, "text": "断断不敢,"}, {"start": 540.25, "end": 542.25, "text": "与皇叔相见。"}, {"start": 543.25, "end": 544.25, "text": "请公子刘贤。"}, {"start": 548.9, "end": 549.9, "text": "你活着,"}, {"start": 569.25, "end": 571.25, "text": "这我就放心了。"}, {"start": 573.25, "end": 574.25, "text": "父亲,"}, {"start": 574.25, "end": 575.25, "text": "请香吧。"}, {"start": 577.88, "end": 590.14, "text": "罪臣刘杜,"}, {"start": 591.14, "end": 594.14, "text": "奉上灵灵太守印寿,"}, {"start": 594.14, "end": 596.14, "text": "请皇叔收纳。"}, {"start": 597.14, "end": 598.14, "text": "素闻刘兄贤,"}, {"start": 617.17, "end": 619.17, "text": "任灵灵太守十年来,"}, {"start": 619.17, "end": 621.17, "text": "百姓衣食保暖,"}, {"start": 621.17, "end": 622.17, "text": "盗贼不敢入境。"}, {"start": 623.17, "end": 624.17, "text": "宣德斗胆,"}, {"start": 625.17, "end": 628.17, "text": "恳请刘兄继续执掌此人,"}, {"start": 628.17, "end": 630.17, "text": "担当灵灵太守。"}, {"start": 631.17, "end": 632.17, "text": "灵皇叔啊,"}, {"start": 633.17, "end": 637.17, "text": "灵灵虽然地僻民少,"}, {"start": 637.17, "end": 639.17, "text": "但她终归是一个君啊,"}, {"start": 639.17, "end": 642.17, "text": "你可不能弃之不要啊。"}, {"start": 643.17, "end": 645.17, "text": "我求还难求呢,"}, {"start": 645.17, "end": 647.17, "text": "怎么会弃之不要啊?"}, {"start": 647.17, "end": 648.17, "text": "皇叔,"}, {"start": 648.17, "end": 653.17, "text": "那你为何不叫自家人做灵灵太守啊?"}, {"start": 653.17, "end": 655.17, "text": "你不就是自家人吗?"}, {"start": 655.17, "end": 656.17, "text": "你姓刘,"}, {"start": 656.17, "end": 657.17, "text": "我也姓刘,"}, {"start": 657.17, "end": 658.17, "text": "舍你之外,"}, {"start": 658.17, "end": 660.17, "text": "还有谁才合适担当呢?"}, {"start": 661.17, "end": 662.17, "text": "刘兄,"}, {"start": 662.17, "end": 663.17, "text": "你放胆知道,"}, {"start": 663.17, "end": 664.17, "text": "一如从前。"}, {"start": 666.17, "end": 667.17, "text": "刘皇叔啊,"}, {"start": 668.17, "end": 670.17, "text": "刘皇叔之胸怀,"}, {"start": 671.17, "end": 675.17, "text": "真是海阔天高啊。"}, {"start": 675.17, "end": 677.17, "text": "久闻灵灵太守,"}, {"start": 677.17, "end": 682.65, "text": "九闻灵灵,"}, {"start": 682.65, "end": 683.65, "text": "凤花酒,"}, {"start": 683.65, "end": 684.65, "text": "醇厚香浓。"}, {"start": 684.65, "end": 685.65, "text": "你这做太守的,"}, {"start": 685.65, "end": 687.65, "text": "也不请我们喝一中吗?"}, {"start": 687.65, "end": 688.65, "text": "我们可都是饿了。"}, {"start": 689.65, "end": 690.65, "text": "对对对,"}, {"start": 690.65, "end": 691.65, "text": "走走走,"}, {"start": 691.65, "end": 692.65, "text": "咱们喝酒去,"}, {"start": 692.65, "end": 693.65, "text": "我在这儿都闻到酒香了。"}, {"start": 694.65, "end": 695.65, "text": "皇叔,"}, {"start": 696.65, "end": 697.65, "text": "不,"}, {"start": 697.65, "end": 698.65, "text": "主公,"}, {"start": 699.65, "end": 701.65, "text": "请进城。"}, {"start": 709.34, "end": 711.34, "text": "主公当众把姓胤还给刘渡,"}, {"start": 711.34, "end": 713.34, "text": "此举着实高明。"}, {"start": 713.34, "end": 714.34, "text": "你们知道,"}, {"start": 714.34, "end": 716.34, "text": "像刘渡这样的俊手,"}, {"start": 716.34, "end": 717.34, "text": "他心里想什么吗?"}, {"start": 718.34, "end": 719.34, "text": "其一,"}, {"start": 719.34, "end": 721.34, "text": "当然是他的官位了。"}, {"start": 721.34, "end": 722.34, "text": "其二,"}, {"start": 722.34, "end": 724.34, "text": "就是何人能做他的主子。"}, {"start": 724.34, "end": 725.34, "text": "对他而言,"}, {"start": 725.34, "end": 727.34, "text": "皇帝太遥远,"}, {"start": 727.34, "end": 729.34, "text": "而荆州之主则是可以"}, {"start": 729.34, "end": 731.34, "text": "置他生死的顶头上司。"}, {"start": 732.34, "end": 733.34, "text": "所以,"}, {"start": 733.34, "end": 734.34, "text": "谁做荆州之主,"}, {"start": 734.34, "end": 736.34, "text": "竟比谁做皇帝还重要。"}, {"start": 738.34, "end": 740.34, "text": "荆州先主刘表,"}, {"start": 740.34, "end": 741.34, "text": "后来是曹子。"}, {"start": 741.34, "end": 742.34, "text": "而我呢,"}, {"start": 742.34, "end": 745.34, "text": "自以为比刘表强些,"}, {"start": 745.34, "end": 746.34, "text": "比曹操善些,"}, {"start": 746.34, "end": 748.34, "text": "又继续拜他为郡守。"}, {"start": 748.34, "end": 749.34, "text": "他岂能不大喜国望,"}, {"start": 749.34, "end": 751.34, "text": "岂能不忠心耿耿。"}, {"start": 752.34, "end": 753.34, "text": "主公以仁义攻心,"}, {"start": 753.34, "end": 756.34, "text": "此举比刀剑更锋利百倍。"}, {"start": 756.34, "end": 758.34, "text": "主公是一发厉害了,"}, {"start": 758.34, "end": 760.34, "text": "在下钦佩之至。"}, {"start": 761.34, "end": 763.34, "text": "这刘渡归顺的消息传出去,"}, {"start": 763.34, "end": 765.34, "text": "这武林长沙贵阳,"}, {"start": 765.34, "end": 767.34, "text": "必定是人心大乱,"}, {"start": 767.34, "end": 770.34, "text": "或许可不攻自下。"}, {"start": 770.34, "end": 772.34, "text": "子龙说得不错,"}, {"start": 772.34, "end": 774.34, "text": "我也以为这三郡"}, {"start": 774.34, "end": 776.34, "text": "已无需主公带军一个一个打,"}, {"start": 776.34, "end": 778.34, "text": "只需遣一上将,"}, {"start": 778.34, "end": 780.34, "text": "引一偏师取之足矣。"}, {"start": 780.34, "end": 782.34, "text": "主公可率大部兵马再次修整,"}, {"start": 782.34, "end": 784.34, "text": "整军练兵以待十遍,"}, {"start": 784.34, "end": 787.34, "text": "毕竟北边和东边都有强临溃失。"}, {"start": 787.34, "end": 793.74, "text": "好,马梁有言在先,"}, {"start": 793.74, "end": 795.74, "text": "先取陵陵,"}, {"start": 795.74, "end": 796.74, "text": "次取贵阳,"}, {"start": 796.74, "end": 798.74, "text": "最后当具长沙和武陵,"}, {"start": 798.74, "end": 800.74, "text": "现在陵陵已下,"}, {"start": 800.74, "end": 802.74, "text": "该着贵阳了,"}, {"start": 802.74, "end": 804.74, "text": "谁愿领兵取贵阳?"}, {"start": 804.74, "end": 805.74, "text": "我愿意。"}, {"start": 805.74, "end": 809.66, "text": "我也愿意。"}, {"start": 809.66, "end": 811.66, "text": "义德,"}, {"start": 811.66, "end": 813.66, "text": "陵陵此意,你已立下大功,"}, {"start": 813.66, "end": 815.66, "text": "这贵阳该轮到我了。"}, {"start": 815.66, "end": 818.94, "text": "这陵陵算什么?"}, {"start": 818.94, "end": 820.94, "text": "我这杖巴蛇毛还没展开,"}, {"start": 820.94, "end": 822.94, "text": "这杖就打完了。"}, {"start": 822.94, "end": 824.94, "text": "不过意不过意,太不过意了。"}, {"start": 824.94, "end": 826.94, "text": "这贵阳还得让我打。"}, {"start": 826.94, "end": 827.94, "text": "义德,"}, {"start": 827.94, "end": 829.94, "text": "是我跟主公先开的口。"}, {"start": 829.94, "end": 831.94, "text": "你先开口,"}, {"start": 831.94, "end": 833.94, "text": "就归你了。"}, {"start": 833.94, "end": 835.94, "text": "我是南征先锋,"}, {"start": 835.94, "end": 837.94, "text": "你是傅先锋。"}, {"start": 837.94, "end": 839.94, "text": "先锋不去,让傅先锋去。"}, {"start": 839.94, "end": 841.94, "text": "这不豈不成笑话了?"}, {"start": 841.94, "end": 843.94, "text": "好,"}, {"start": 843.94, "end": 845.94, "text": "你们俩不要争了。"}, {"start": 845.94, "end": 847.94, "text": "要不,"}, {"start": 847.94, "end": 849.94, "text": "抓究决定。"}, {"start": 849.94, "end": 851.94, "text": "好,"}, {"start": 851.94, "end": 853.94, "text": "抓究。"}, {"start": 853.94, "end": 855.94, "text": "我已经写好了。"}, {"start": 855.94, "end": 877.46, "text": "义德,"}, {"start": 877.46, "end": 879.46, "text": "莫要反悔,"}, {"start": 879.46, "end": 881.46, "text": "是你自己抓到不去,"}, {"start": 881.46, "end": 883.46, "text": "说明天意该着子龙出战。"}, {"start": 883.46, "end": 885.46, "text": "主公,"}, {"start": 885.46, "end": 887.46, "text": "那就请子龙引三千兵马"}, {"start": 887.46, "end": 889.46, "text": "攻取贵阳如何?"}, {"start": 889.46, "end": 892.8, "text": "好,就这么定了。"}, {"start": 892.8, "end": 894.8, "text": "我只需两千兵马,"}, {"start": 894.8, "end": 895.8, "text": "就能拿下贵阳。"}, {"start": 895.8, "end": 901.0, "text": "退下了。"}, {"start": 901.0, "end": 902.0, "text": "义德,"}, {"start": 902.0, "end": 904.0, "text": "你就等候我的佳音吧。"}, {"start": 904.0, "end": 918.77, "text": "我先去准备了。"}, {"start": 918.77, "end": 921.34, "text": "军师。"}, {"start": 921.34, "end": 932.35, "text": "子龙。"}, {"start": 932.35, "end": 934.35, "text": "我想问军师,"}, {"start": 934.35, "end": 936.35, "text": "为何使用障眼法,"}, {"start": 936.35, "end": 941.1, "text": "助我得到攻取贵阳的机会?"}, {"start": 941.1, "end": 943.1, "text": "你难道不想要这个机会吗?"}, {"start": 943.1, "end": 945.1, "text": "我当然想要,"}, {"start": 945.1, "end": 946.1, "text": "但,"}, {"start": 946.1, "end": 948.1, "text": "我不想军师偏袒。"}, {"start": 948.1, "end": 950.1, "text": "到底是子龙,"}, {"start": 950.1, "end": 952.1, "text": "忠勇刚正。"}, {"start": 952.1, "end": 954.1, "text": "我告诉你,"}, {"start": 954.1, "end": 956.1, "text": "我并没有偏袒你。"}, {"start": 956.1, "end": 958.1, "text": "长军者最忌讳的,"}, {"start": 958.1, "end": 960.1, "text": "就是在将领中有轻疏远径。"}, {"start": 960.1, "end": 962.1, "text": "我之所以正做,"}, {"start": 962.1, "end": 964.1, "text": "完全是为了大局。"}, {"start": 964.1, "end": 966.1, "text": "请军师试想。"}, {"start": 966.1, "end": 968.1, "text": "主公此次南征,"}, {"start": 968.1, "end": 971.1, "text": "想要的是南部四军轻臣而已。"}, {"start": 971.1, "end": 973.1, "text": "要想达成这个目的,"}, {"start": 973.1, "end": 975.1, "text": "仅凭刀枪攻杀,"}, {"start": 975.1, "end": 977.1, "text": "就远远不够。"}, {"start": 977.1, "end": 978.1, "text": "如果闹了个"}, {"start": 978.1, "end": 980.1, "text": "祥而不服的南局,"}, {"start": 980.1, "end": 982.1, "text": "则非但不能扩大荆州水地,"}, {"start": 982.1, "end": 984.1, "text": "反而落下个"}, {"start": 984.1, "end": 986.1, "text": "狼烟不止的后面。"}, {"start": 986.1, "end": 988.1, "text": "易得生性粗犷,"}, {"start": 988.1, "end": 990.1, "text": "勇猛好战。"}, {"start": 990.1, "end": 992.1, "text": "一旦遇到宁死不祥的守将,"}, {"start": 992.1, "end": 994.1, "text": "他定会火冒三丈,"}, {"start": 994.1, "end": 996.1, "text": "动不动就捅人几个透明窟窿。"}, {"start": 996.1, "end": 998.1, "text": "所以,"}, {"start": 998.1, "end": 1000.1, "text": "我选你,"}, {"start": 1000.1, "end": 1003.74, "text": "去攻取贵阳。"}, {"start": 1003.74, "end": 1046.63, "text": "我乃常山赵子龙。"}, {"start": 1046.63, "end": 1048.63, "text": "来将何人?"}, {"start": 1048.63, "end": 1050.63, "text": "贵阳军前校尉陈应。"}, {"start": 1050.63, "end": 1052.63, "text": "赵范何在?"}, {"start": 1052.63, "end": 1054.63, "text": "我家赵太守,"}, {"start": 1054.63, "end": 1057.91, "text": "岂能见你?"}, {"start": 1057.91, "end": 1059.91, "text": "武主刘玄德,"}, {"start": 1059.91, "end": 1061.91, "text": "乃荆州旧主刘景生之弟。"}, {"start": 1061.91, "end": 1063.91, "text": "今与公子刘齐共领荆州,"}, {"start": 1063.91, "end": 1065.91, "text": "本将奉命特来府民,"}, {"start": 1065.91, "end": 1067.91, "text": "你怎敢应战?"}, {"start": 1067.91, "end": 1069.91, "text": "我等只服曹丞相,"}, {"start": 1069.91, "end": 1071.91, "text": "岂能顺从你家"}, {"start": 1071.91, "end": 1073.91, "text": "知己犯履的常尔贼?"}, {"start": 1073.91, "end": 1102.92, "text": "你听说过青釭剑的威名吗?"}, {"start": 1102.92, "end": 1104.92, "text": "什么?"}, {"start": 1104.92, "end": 1106.92, "text": "这就是青釭剑?"}, {"start": 1106.92, "end": 1110.94, "text": "刚才我若杀你的话,"}, {"start": 1110.94, "end": 1112.94, "text": "你断了头颅都不知道疼。"}, {"start": 1112.94, "end": 1114.94, "text": "赶紧换件结实的兵器吧,"}, {"start": 1114.94, "end": 1125.22, "text": "我等你。"}, {"start": 1125.22, "end": 1127.22, "text": "将军!"}, {"start": 1127.22, "end": 1130.63, "text": "赵云!"}, {"start": 1130.63, "end": 1132.63, "text": "你我再战三百回合!"}, {"start": 1132.63, "end": 1134.63, "text": "陈应,"}, {"start": 1134.63, "end": 1136.63, "text": "我这一辈子就没跟人战过三十回合,"}, {"start": 1136.63, "end": 1170.25, "text": "何谈三百啊?"}, {"start": 1170.25, "end": 1172.25, "text": "难道你们贵阳城都是破铜烂铁吗?"}, {"start": 1172.25, "end": 1175.5, "text": "你再去换件结实的兵器来,"}, {"start": 1175.5, "end": 1181.53, "text": "我还等你。"}, {"start": 1181.53, "end": 1183.53, "text": "你也没什么真本领,"}, {"start": 1183.53, "end": 1185.53, "text": "只是你手中的青釭剑厉害。"}, {"start": 1185.53, "end": 1187.53, "text": "好,"}, {"start": 1187.53, "end": 1189.53, "text": "那我收起青釭剑,"}, {"start": 1189.53, "end": 1191.53, "text": "让你看看真本事。"}, {"start": 1191.53, "end": 1209.02, "text": "你可要看好,"}, {"start": 1209.02, "end": 1211.02, "text": "你先使插,又使刀,"}, {"start": 1211.02, "end": 1213.02, "text": "现在又使双锤。"}, {"start": 1213.02, "end": 1215.02, "text": "陈应啊,你这个校尉"}, {"start": 1215.02, "end": 1217.02, "text": "还真是有意思。"}, {"start": 1217.02, "end": 1219.02, "text": "赵云!本将宁死不辱!"}, {"start": 1219.02, "end": 1221.02, "text": "来啊!"}, {"start": 1221.02, "end": 1331.37, "text": "我不杀好汉,"}, {"start": 1331.37, "end": 1333.37, "text": "你走吧,"}, {"start": 1333.37, "end": 1335.37, "text": "回去告诉赵藩,"}, {"start": 1335.37, "end": 1348.25, "text": "让他早早归向我主公。"}, {"start": 1348.25, "end": 1350.25, "text": "赵云不愧是世上名将,"}, {"start": 1350.25, "end": 1352.25, "text": "的确有万夫不等之用。"}, {"start": 1352.25, "end": 1354.25, "text": "末将先使插,"}, {"start": 1354.25, "end": 1356.25, "text": "再使刀,"}, {"start": 1356.25, "end": 1358.25, "text": "后使锤,"}, {"start": 1358.25, "end": 1360.25, "text": "都被他瞬间击败。"}, {"start": 1360.25, "end": 1363.59, "text": "他本可取我性命,"}, {"start": 1363.59, "end": 1365.59, "text": "却放我归来,"}, {"start": 1365.59, "end": 1367.59, "text": "他可是个义士啊!"}, {"start": 1367.59, "end": 1369.59, "text": "赵云已是如此,"}, {"start": 1369.59, "end": 1371.59, "text": "可想,他主刘备"}, {"start": 1371.59, "end": 1373.59, "text": "一定是个贤明之君。"}, {"start": 1373.59, "end": 1375.59, "text": "你想说什么,"}, {"start": 1375.59, "end": 1377.59, "text": "就直说吧。"}, {"start": 1377.59, "end": 1379.59, "text": "归向吧主公,"}, {"start": 1379.59, "end": 1381.59, "text": "长板坡上"}, {"start": 1381.59, "end": 1383.59, "text": "百万曹军都奈何不了赵云,"}, {"start": 1383.59, "end": 1385.59, "text": "而他只是刘备"}, {"start": 1385.59, "end": 1387.59, "text": "亏欠的一员大将而已。"}, {"start": 1387.59, "end": 1389.59, "text": "那关羽张飞"}, {"start": 1389.59, "end": 1391.59, "text": "还没有出面呢,"}, {"start": 1391.59, "end": 1393.59, "text": "我桂阳"}, {"start": 1393.59, "end": 1395.59, "text": "有何能力"}, {"start": 1395.59, "end": 1397.59, "text": "与刘备大军相抗,"}, {"start": 1397.59, "end": 1399.59, "text": "只怕曹操也不能。"}, {"start": 1399.59, "end": 1401.59, "text": "归向吧主公,"}, {"start": 1401.59, "end": 1403.59, "text": "住口!"}, {"start": 1403.59, "end": 1405.59, "text": "投降?"}, {"start": 1405.59, "end": 1407.59, "text": "亏你说得出口!"}, {"start": 1407.59, "end": 1412.92, "text": "若赵反浴血拼杀"}, {"start": 1412.92, "end": 1414.92, "text": "争下他,"}, {"start": 1414.92, "end": 1416.92, "text": "岂能拱手送给刘备?"}, {"start": 1416.92, "end": 1418.92, "text": "伪将者宁死不想!"}, {"start": 1418.92, "end": 1422.68, "text": "你们且说说,"}, {"start": 1422.68, "end": 1424.68, "text": "如何才能抵住赵云?"}, {"start": 1424.68, "end": 1430.78, "text": "怎么都不吭声呢?"}, {"start": 1430.78, "end": 1432.78, "text": "太守大人,"}, {"start": 1432.78, "end": 1434.78, "text": "如果陈将军都抵挡不住赵云,"}, {"start": 1434.78, "end": 1436.78, "text": "我等又岂是对手?"}, {"start": 1436.78, "end": 1438.78, "text": "末将以为以祥为上策。"}, {"start": 1438.78, "end": 1440.78, "text": "你们,"}, {"start": 1440.78, "end": 1442.78, "text": "你们也太没有骨气了!"}, {"start": 1442.78, "end": 1444.78, "text": "我平日,"}, {"start": 1444.78, "end": 1446.78, "text": "是怎么对待你们的?"}, {"start": 1446.78, "end": 1448.78, "text": "主公,"}, {"start": 1448.78, "end": 1450.78, "text": "零零流渡,归向刘备后,"}, {"start": 1450.78, "end": 1452.78, "text": "仍然被刘备封为太守啊?"}, {"start": 1452.78, "end": 1454.78, "text": "是啊是啊是啊。"}, {"start": 1454.78, "end": 1456.78, "text": "看来,"}, {"start": 1456.78, "end": 1458.78, "text": "你们都铁了心归祥了。"}, {"start": 1458.78, "end": 1462.22, "text": "如果"}, {"start": 1462.22, "end": 1468.95, "text": "我不祥呢?"}, {"start": 1468.95, "end": 1472.97, "text": "哥哥,休怪我等了。"}, {"start": 1472.97, "end": 1474.97, "text": "你们要干什么?"}, {"start": 1474.97, "end": 1476.97, "text": "公劝太守归祥刘皇叔。"}, {"start": 1476.97, "end": 1478.97, "text": "归祥刘皇叔。"}, {"start": 1478.97, "end": 1480.97, "text": "哎哟,将军们啊,"}, {"start": 1480.97, "end": 1482.97, "text": "别生气,别生气啊。"}, {"start": 1482.97, "end": 1484.97, "text": "都是自家人,"}, {"start": 1484.97, "end": 1486.97, "text": "自家的事,"}, {"start": 1486.97, "end": 1488.97, "text": "有事好商量吗?"}, {"start": 1488.97, "end": 1492.31, "text": "赵太守,"}, {"start": 1492.31, "end": 1494.31, "text": "依我看,将军们所意之事,"}, {"start": 1494.31, "end": 1496.31, "text": "也是为了桂阳好,"}, {"start": 1496.31, "end": 1500.84, "text": "更是为了你好,"}, {"start": 1500.84, "end": 1527.35, "text": "为了将军们吧。"}, {"start": 1527.35, "end": 1529.35, "text": "张刘备,"}, {"start": 1529.35, "end": 1531.35, "text": "敢问太守何日出巷?"}, {"start": 1531.35, "end": 1533.35, "text": "哎哟,"}, {"start": 1533.35, "end": 1535.35, "text": "大事都定了,"}, {"start": 1535.35, "end": 1537.35, "text": "时辰的事就不用太着急了吗?"}, {"start": 1537.35, "end": 1539.35, "text": "总须太守"}, {"start": 1539.35, "end": 1541.35, "text": "清点一下兵丁名册,"}, {"start": 1541.35, "end": 1543.35, "text": "钱粮税付,"}, {"start": 1543.35, "end": 1545.35, "text": "准备好售印呢?"}, {"start": 1545.35, "end": 1547.35, "text": "是吗?"}, {"start": 1547.35, "end": 1549.35, "text": "我看这样吧,"}, {"start": 1549.35, "end": 1551.35, "text": "后天即刻出巷。"}, {"start": 1551.35, "end": 1553.35, "text": "那好,"}, {"start": 1553.35, "end": 1555.35, "text": "我等就等太守"}, {"start": 1555.35, "end": 1569.03, "text": "下令了。"}, {"start": 1569.03, "end": 1573.82, "text": "保龙,最心得过你,"}, {"start": 1573.82, "end": 1575.82, "text": "怎么到了万急时刻,"}, {"start": 1575.82, "end": 1577.82, "text": "你怎么替他们一般人"}, {"start": 1577.82, "end": 1579.82, "text": "说话呢?"}, {"start": 1579.82, "end": 1581.82, "text": "大人哪,"}, {"start": 1581.82, "end": 1583.82, "text": "其一,敌兵势大,"}, {"start": 1583.82, "end": 1585.82, "text": "我们断然打不过。"}, {"start": 1585.82, "end": 1587.82, "text": "其二,兵心已变,"}, {"start": 1587.82, "end": 1589.82, "text": "已独木难支。"}, {"start": 1589.82, "end": 1591.82, "text": "依我看,"}, {"start": 1591.82, "end": 1593.82, "text": "与其战败而降,"}, {"start": 1593.82, "end": 1595.82, "text": "不如主动投降,"}, {"start": 1595.82, "end": 1597.82, "text": "如此还可以像刘渡一样,"}, {"start": 1597.82, "end": 1599.82, "text": "保留一个官位啊。"}, {"start": 1599.82, "end": 1605.72, "text": "难道,"}, {"start": 1605.72, "end": 1607.72, "text": "我们就束手就擒了吗?"}, {"start": 1607.72, "end": 1609.72, "text": "难道,"}, {"start": 1609.72, "end": 1613.58, "text": "我们就没有别的什么办法了吗?"}, {"start": 1613.58, "end": 1615.58, "text": "办法嘛,倒是有,"}, {"start": 1615.58, "end": 1617.58, "text": "不过,"}, {"start": 1617.58, "end": 1619.58, "text": "那样做,"}, {"start": 1619.58, "end": 1627.53, "text": "可太险恶了。"}, {"start": 1627.53, "end": 1635.7, "text": "请,将军,"}, {"start": 1635.7, "end": 1637.7, "text": "将军,请上座。"}, {"start": 1637.7, "end": 1639.7, "text": "赵大人是贵阳郡守,"}, {"start": 1639.7, "end": 1641.7, "text": "理应上座。"}, {"start": 1641.7, "end": 1643.7, "text": "万万不敢,"}, {"start": 1643.7, "end": 1645.7, "text": "赵某身为侠官,"}, {"start": 1645.7, "end": 1647.7, "text": "立当下座相陪。"}, {"start": 1647.7, "end": 1649.7, "text": "将军,请。"}, {"start": 1649.7, "end": 1654.87, "text": "赵大人,"}, {"start": 1654.87, "end": 1656.87, "text": "你我已是义主同仁,"}, {"start": 1656.87, "end": 1661.75, "text": "还何必客气?"}, {"start": 1661.75, "end": 1669.19, "text": "将军,请坐。"}, {"start": 1669.19, "end": 1671.19, "text": "将军,明镇天下,"}, {"start": 1671.19, "end": 1674.89, "text": "却如此谦和,"}, {"start": 1674.89, "end": 1676.89, "text": "下官照范,"}, {"start": 1676.89, "end": 1681.0, "text": "敬子龙将军。"}, {"start": 1681.0, "end": 1701.08, "text": "请。"}, {"start": 1701.08, "end": 1703.08, "text": "贵阳刚刚归顺刘备,"}, {"start": 1703.08, "end": 1705.08, "text": "你等务虚严加寻防,"}, {"start": 1705.08, "end": 1707.08, "text": "你等立即去关闭城门,"}, {"start": 1707.08, "end": 1709.08, "text": "禁止任何人出入。"}, {"start": 1709.08, "end": 1711.08, "text": "诺。"}, {"start": 1711.08, "end": 1719.26, "text": "将军,"}, {"start": 1719.26, "end": 1721.26, "text": "姓赵,"}, {"start": 1721.26, "end": 1723.26, "text": "我也姓赵,"}, {"start": 1723.26, "end": 1725.26, "text": "五百年前何是一家呀?"}, {"start": 1725.26, "end": 1727.26, "text": "此外,"}, {"start": 1727.26, "end": 1729.26, "text": "将军是正定人,"}, {"start": 1729.26, "end": 1731.26, "text": "某"}, {"start": 1731.26, "end": 1733.26, "text": "也是正定人,"}, {"start": 1733.26, "end": 1735.26, "text": "万世中,"}, {"start": 1735.26, "end": 1737.26, "text": "两个正定人在此相逢,"}, {"start": 1737.26, "end": 1739.26, "text": "乃天意呀。"}, {"start": 1739.26, "end": 1741.26, "text": "如若将军不弃,"}, {"start": 1741.26, "end": 1743.26, "text": "下官愿与将军"}, {"start": 1743.26, "end": 1745.26, "text": "结为兄弟,"}, {"start": 1745.26, "end": 1747.26, "text": "可好啊。"}, {"start": 1747.26, "end": 1749.26, "text": "那大人,"}, {"start": 1749.26, "end": 1751.26, "text": "小弟敬你为兄啊。"}, {"start": 1751.26, "end": 1753.26, "text": "哪里哪里。"}, {"start": 1753.26, "end": 1755.26, "text": "兄弟,"}, {"start": 1755.26, "end": 1757.26, "text": "你这是。"}, {"start": 1757.26, "end": 1759.26, "text": "兄长在上,"}, {"start": 1759.26, "end": 1761.26, "text": "受小弟一。"}, {"start": 1761.26, "end": 1764.79, "text": "醉了,"}, {"start": 1764.79, "end": 1766.79, "text": "真快。"}, {"start": 1766.79, "end": 1775.0, "text": "来人,"}, {"start": 1775.0, "end": 1777.0, "text": "咋了?"}, {"start": 1777.0, "end": 1779.0, "text": "先把酒倒掉,"}, {"start": 1779.0, "end": 1781.0, "text": "把他的佩剑拿掉,"}, {"start": 1781.0, "end": 1783.0, "text": "把人抬进屋里休息吧。"}, {"start": 1783.0, "end": 1785.0, "text": "诺。"}, {"start": 1785.0, "end": 1820.79, "text": "待会儿我请嫂夫人出来。"}, {"start": 1820.79, "end": 1822.79, "text": "将军请擦脸。"}, {"start": 1822.79, "end": 1824.79, "text": "这里是?"}, {"start": 1824.79, "end": 1829.67, "text": "这里是我夫君先前的卧房。"}, {"start": 1829.67, "end": 1834.36, "text": "我走错地方了。"}, {"start": 1834.36, "end": 1836.36, "text": "兄弟,"}, {"start": 1836.36, "end": 1838.36, "text": "你没走错啊。"}, {"start": 1838.36, "end": 1840.36, "text": "兄长,"}, {"start": 1840.36, "end": 1842.36, "text": "这到底怎么回事?"}, {"start": 1842.36, "end": 1844.36, "text": "我哥已经去世。"}, {"start": 1844.36, "end": 1846.36, "text": "嫂嫂"}, {"start": 1846.36, "end": 1848.36, "text": "久仰将军大名。"}, {"start": 1848.36, "end": 1850.36, "text": "所以,"}, {"start": 1850.36, "end": 1852.36, "text": "就让嫂嫂"}, {"start": 1852.36, "end": 1854.36, "text": "侍奉兄弟吧。"}, {"start": 1854.36, "end": 1856.36, "text": "这有位李叔,"}, {"start": 1856.36, "end": 1868.41, "text": "断断不可。"}, {"start": 1868.41, "end": 1870.41, "text": "兄弟啊,"}, {"start": 1870.41, "end": 1872.41, "text": "错怪我了。"}, {"start": 1872.41, "end": 1874.41, "text": "此事绝非乱伦。"}, {"start": 1874.41, "end": 1876.41, "text": "中间,"}, {"start": 1876.41, "end": 1879.82, "text": "有个缘故啊。"}, {"start": 1879.82, "end": 1886.01, "text": "你听我给你解释。"}, {"start": 1886.01, "end": 1889.96, "text": "你说说,"}, {"start": 1889.96, "end": 1891.96, "text": "先兄弃世已经三年多了。"}, {"start": 1891.96, "end": 1893.96, "text": "嫂嫂孤军,"}, {"start": 1893.96, "end": 1895.96, "text": "终非了局啊。"}, {"start": 1895.96, "end": 1897.96, "text": "我多次劝她改嫁,"}, {"start": 1897.96, "end": 1899.96, "text": "可她非要嫁给一个"}, {"start": 1899.96, "end": 1901.96, "text": "文武双全,"}, {"start": 1901.96, "end": 1903.96, "text": "文明天下,"}, {"start": 1903.96, "end": 1905.96, "text": "相貌堂堂,"}, {"start": 1905.96, "end": 1907.96, "text": "威仪出众的人啊。"}, {"start": 1907.96, "end": 1909.96, "text": "此外,"}, {"start": 1909.96, "end": 1911.96, "text": "这个人还必须得姓赵。"}, {"start": 1911.96, "end": 1913.96, "text": "你看,天下哪有这般巧合的事啊。"}, {"start": 1913.96, "end": 1915.96, "text": "兄弟,"}, {"start": 1915.96, "end": 1917.96, "text": "我都不愿啊。"}, {"start": 1917.96, "end": 1919.96, "text": "那如此,"}, {"start": 1919.96, "end": 1921.96, "text": "我要多谢你的好意了。"}, {"start": 1921.96, "end": 1923.96, "text": "那敢问赵大人,"}, {"start": 1923.96, "end": 1925.96, "text": "如果我答应了这门亲事,"}, {"start": 1925.96, "end": 1927.96, "text": "你还有什么长远打算吗?"}, {"start": 1927.96, "end": 1929.96, "text": "玉雄,"}, {"start": 1929.96, "end": 1931.96, "text": "我在徐昌有一座豪宅。"}, {"start": 1931.96, "end": 1933.96, "text": "徐昌?"}, {"start": 1933.96, "end": 1935.96, "text": "那不是嫂嫂的属地吗?"}, {"start": 1935.96, "end": 1937.96, "text": "正是,"}, {"start": 1937.96, "end": 1941.98, "text": "正是啊。"}, {"start": 1941.98, "end": 1943.98, "text": "丞相对子龙将军,"}, {"start": 1943.98, "end": 1945.98, "text": "压目已久啊。"}, {"start": 1945.98, "end": 1947.98, "text": "你设下此局,"}, {"start": 1947.98, "end": 1951.83, "text": "就是要我投奔曹贼。"}, {"start": 1951.83, "end": 1953.83, "text": "不是啊,兄弟啊。"}, {"start": 1953.83, "end": 1955.83, "text": "谁是你兄弟?"}, {"start": 1955.83, "end": 1957.83, "text": "我们毕竟结为兄弟了嘛。"}, {"start": 1957.83, "end": 1959.83, "text": "兄弟,你听我说,"}, {"start": 1959.83, "end": 1961.83, "text": "刘备成不了大事。"}, {"start": 1961.83, "end": 1963.83, "text": "多其天下,必定是曹操啊。"}, {"start": 1963.83, "end": 1965.83, "text": "兄弟,"}, {"start": 1965.83, "end": 1976.76, "text": "你们是要拿我吗?"}, {"start": 1976.76, "end": 1978.76, "text": "将赵云拿下!"}, {"start": 2010.41, "end": 2044.98, "text": "快追,"}, {"start": 2044.98, "end": 2046.98, "text": "抓住赵云!"}, {"start": 2046.98, "end": 2048.98, "text": "大人啊,"}, {"start": 2048.98, "end": 2050.98, "text": "看来赵云的武艺,"}, {"start": 2050.98, "end": 2052.98, "text": "果然是匪夷所思啊。"}, {"start": 2052.98, "end": 2054.98, "text": "赵云再勇,也是肉身凡胎。"}, {"start": 2054.98, "end": 2056.98, "text": "再说,他只带了五计人。"}, {"start": 2056.98, "end": 2058.98, "text": "和烈,"}, {"start": 2058.98, "end": 2060.98, "text": "斗不过他,就杀了他。"}, {"start": 2060.98, "end": 2062.98, "text": "绝不可以放走赵云!"}, {"start": 2062.98, "end": 2123.16, "text": "快,追!"}, {"start": 2123.16, "end": 2125.16, "text": "拿住赵云了吗?"}, {"start": 2125.16, "end": 2127.16, "text": "没,没有。"}, {"start": 2127.16, "end": 2129.16, "text": "杀死他了吗?"}, {"start": 2129.16, "end": 2131.16, "text": "也没有。"}, {"start": 2131.16, "end": 2133.16, "text": "中军效费沉硬,"}, {"start": 2133.16, "end": 2135.16, "text": "打开城门,把赵云送出城了。"}, {"start": 2135.16, "end": 2137.16, "text": "什么?"}, {"start": 2137.16, "end": 2139.16, "text": "赵云,"}, {"start": 2139.16, "end": 2150.89, "text": "他出城了!"}, {"start": 2150.89, "end": 2152.89, "text": "咱们快走吧,不到一个时辰,"}, {"start": 2152.89, "end": 2154.89, "text": "赵云必率军进城。"}, {"start": 2154.89, "end": 2173.37, "text": "你这是找什么啊?"}, {"start": 2173.37, "end": 2175.37, "text": "印寿,"}, {"start": 2175.37, "end": 2177.37, "text": "我的太守印寿啊。"}, {"start": 2177.37, "end": 2179.37, "text": "我连命都过不了了,"}, {"start": 2179.37, "end": 2181.37, "text": "还要什么印寿啊?"}, {"start": 2181.37, "end": 2185.35, "text": "找到了!"}, {"start": 2185.35, "end": 2187.35, "text": "快走!"}, {"start": 2187.35, "end": 2230.5, "text": "快逃命吧!"}, {"start": 2230.5, "end": 2232.5, "text": "关将军,主公和军师正在后堂议事。"}, {"start": 2232.5, "end": 2246.76, "text": "大哥,军师,"}, {"start": 2246.76, "end": 2248.76, "text": "我来了。"}, {"start": 2248.76, "end": 2250.76, "text": "印长啊,怎么来的这么快?"}, {"start": 2250.76, "end": 2252.76, "text": "我算你至少还得两日呢。"}, {"start": 2252.76, "end": 2254.76, "text": "在荆州,"}, {"start": 2254.76, "end": 2256.76, "text": "除了操练士族,就是打造军械。"}, {"start": 2256.76, "end": 2258.76, "text": "办得很啊。"}, {"start": 2258.76, "end": 2260.76, "text": "哪有易得子龙他们痛快。"}, {"start": 2260.76, "end": 2262.76, "text": "军师,"}, {"start": 2262.76, "end": 2264.76, "text": "图看得怎么样?"}, {"start": 2264.76, "end": 2266.76, "text": "长沙一定是我的。"}, {"start": 2266.76, "end": 2268.76, "text": "啊,"}, {"start": 2268.76, "end": 2270.76, "text": "关将军路途劳顿,"}, {"start": 2270.76, "end": 2272.76, "text": "我看先休息两日,"}, {"start": 2272.76, "end": 2274.76, "text": "此事以后再议吧。"}, {"start": 2274.76, "end": 2276.76, "text": "些什么呀?"}, {"start": 2276.76, "end": 2278.76, "text": "赤壁之后,"}, {"start": 2278.76, "end": 2280.76, "text": "你们一直让我操练兵马,"}, {"start": 2280.76, "end": 2282.76, "text": "我可是练就了"}, {"start": 2282.76, "end": 2284.76, "text": "一万进足啊。"}, {"start": 2284.76, "end": 2286.76, "text": "如果再不出战,刀都要朽了。"}, {"start": 2286.76, "end": 2290.07, "text": "看这样,"}, {"start": 2290.07, "end": 2292.07, "text": "不让运长早些上阵是不行了。"}, {"start": 2292.07, "end": 2295.58, "text": "既然如此,"}, {"start": 2295.58, "end": 2301.06, "text": "那就请主公下令吧。"}, {"start": 2301.06, "end": 2303.06, "text": "丹羽听令。"}, {"start": 2303.06, "end": 2305.06, "text": "在。"}, {"start": 2305.06, "end": 2307.06, "text": "令你三十日内收取长沙及其所属各处城关。"}, {"start": 2307.06, "end": 2309.06, "text": "此议,"}, {"start": 2309.06, "end": 2311.06, "text": "务须恩威并治,不可坏了城国,"}, {"start": 2311.06, "end": 2313.06, "text": "不可扰民,更不可妄杀无辜。"}, {"start": 2313.06, "end": 2315.06, "text": "遵命。"}, {"start": 2315.06, "end": 2317.06, "text": "嬴长啊,"}, {"start": 2317.06, "end": 2319.06, "text": "子龙娶贵阳,易得娶玲玲,"}, {"start": 2319.06, "end": 2321.06, "text": "都只带了三千军去。"}, {"start": 2321.06, "end": 2323.06, "text": "但此次长沙不同,"}, {"start": 2323.06, "end": 2325.06, "text": "其太守韩玄所部,可谓兵经将。"}, {"start": 2325.06, "end": 2327.06, "text": "尤其是手下老将黄忠,"}, {"start": 2327.06, "end": 2329.06, "text": "年余六巡,"}, {"start": 2329.06, "end": 2331.06, "text": "你不可小识。"}, {"start": 2331.06, "end": 2333.06, "text": "此议,"}, {"start": 2333.06, "end": 2335.06, "text": "你带六千军去。"}, {"start": 2335.06, "end": 2337.06, "text": "军师,"}, {"start": 2337.06, "end": 2339.06, "text": "何以长他人锐气,"}, {"start": 2339.06, "end": 2341.06, "text": "灭自家威风呢?"}, {"start": 2341.06, "end": 2343.06, "text": "量一老族,"}, {"start": 2343.06, "end": 2346.95, "text": "不足瓜池。"}, {"start": 2346.95, "end": 2348.95, "text": "我无须带这么多人吧。"}, {"start": 2348.95, "end": 2350.95, "text": "只带本部五百孝道手,"}, {"start": 2350.95, "end": 2352.95, "text": "便可娶黄忠,"}, {"start": 2352.95, "end": 2354.95, "text": "韩玄首级,"}, {"start": 2354.95, "end": 2356.95, "text": "县宇大哥。"}, {"start": 2356.95, "end": 2358.95, "text": "嬴长,你未免太轻敌了。"}, {"start": 2358.95, "end": 2360.95, "text": "请军师带六千军去。"}, {"start": 2360.95, "end": 2366.63, "text": "不,"}, {"start": 2366.63, "end": 2368.63, "text": "我只带五百孝道手。"}, {"start": 2368.63, "end": 2370.63, "text": "这……"}, {"start": 2370.63, "end": 2377.18, "text": "大哥,你就放心吧。"}, {"start": 2377.18, "end": 2379.18, "text": "不然,"}, {"start": 2379.18, "end": 2381.18, "text": "我愿立军令庄。"}, {"start": 2381.18, "end": 2383.18, "text": "若秦不到皇中,"}, {"start": 2383.18, "end": 2385.18, "text": "甘愿军法从事。"}, {"start": 2385.18, "end": 2388.84, "text": "华戎道一事,"}, {"start": 2388.84, "end": 2390.84, "text": "将军也曾立过军令庄。"}, {"start": 2390.84, "end": 2404.04, "text": "请军师相信,"}, {"start": 2404.04, "end": 2406.04, "text": "此次,"}, {"start": 2406.04, "end": 2408.04, "text": "官某,"}, {"start": 2408.04, "end": 2410.04, "text": "愿为华戎道之罪,"}, {"start": 2410.04, "end": 2412.04, "text": "学齿。"}, {"start": 2412.04, "end": 2415.54, "text": "好了,"}, {"start": 2415.54, "end": 2417.54, "text": "备酒,为嬴长壮行。"}, {"start": 2417.54, "end": 2419.54, "text": "不用了,"}, {"start": 2419.54, "end": 2421.54, "text": "大哥军师,待我娶了长沙,"}, {"start": 2421.54, "end": 2423.54, "text": "再回来痛饮庆功酒。"}, {"start": 2423.54, "end": 2425.54, "text": "军令庄,"}, {"start": 2425.54, "end": 2427.54, "text": "随后送上。"}, {"start": 2427.54, "end": 2443.98, "text": "嬴长为将这么多年,"}, {"start": 2443.98, "end": 2445.98, "text": "这争强好胜的性子"}, {"start": 2445.98, "end": 2450.66, "text": "还是改不了。"}, {"start": 2450.66, "end": 2452.66, "text": "你料此意,嬴长能成吗?"}, {"start": 2452.66, "end": 2454.66, "text": "此意,"}, {"start": 2454.66, "end": 2456.66, "text": "嬴长必成,必胜。"}, {"start": 2456.66, "end": 2460.87, "text": "你好像比他自己还缺心吗?"}, {"start": 2460.87, "end": 2462.87, "text": "因为我们提到的华戎道,"}, {"start": 2462.87, "end": 2464.87, "text": "此事,"}, {"start": 2464.87, "end": 2466.87, "text": "是官将军心中的一块隐痛。"}, {"start": 2466.87, "end": 2468.87, "text": "他非要学齿建功不可。"}]