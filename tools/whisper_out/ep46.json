[{"start": 8.66, "end": 9.38, "text": "大都督"}, {"start": 10.18, "end": 11.38, "text": "昨日少记来报"}, {"start": 11.98, "end": 14.42, "text": "说刘备已率军进驻油江口"}, {"start": 15.06, "end": 17.5, "text": "我天后大惊却不敢相信"}, {"start": 18.42, "end": 20.82, "text": "今晨我亲自率兵前去探望"}, {"start": 21.86, "end": 25.06, "text": "果然刘备已经涅山一江现营"}, {"start": 25.5, "end": 27.7, "text": "营前漂着刘备的大道"}, {"start": 28.46, "end": 29.18, "text": "看这形势"}, {"start": 29.82, "end": 31.54, "text": "刘备是想攻去南郡了"}, {"start": 32.3, "end": 33.62, "text": "程老将军辛苦了"}, {"start": 34.42, "end": 35.82, "text": "南郡是荆州重镇"}, {"start": 36.42, "end": 38.46, "text": "取荆州必先取南郡"}, {"start": 39.54, "end": 40.02, "text": "大都督"}, {"start": 40.62, "end": 41.54, "text": "荆州是我们的"}, {"start": 42.06, "end": 43.22, "text": "刘备如敢起探念"}, {"start": 43.46, "end": 44.3, "text": "不等他取南郡"}, {"start": 44.74, "end": 45.78, "text": "我先引兵取了他"}, {"start": 47.58, "end": 48.46, "text": "兴爸说得对"}, {"start": 49.58, "end": 51.5, "text": "曹操在赤皮大败之后"}, {"start": 52.02, "end": 53.06, "text": "敌我形势有变"}, {"start": 54.14, "end": 55.3, "text": "我们与刘备之间"}, {"start": 55.66, "end": 56.86, "text": "早晚必有一战"}, {"start": 57.78, "end": 59.7, "text": "刘皇叔做梦都惦着荆州"}, {"start": 61.53, "end": 62.25, "text": "这是自然的"}, {"start": 63.73, "end": 65.37, "text": "欲取荆州必先取南郡"}, {"start": 66.37, "end": 67.29, "text": "这也是自然的"}, {"start": 68.65, "end": 69.17, "text": "不过"}, {"start": 70.53, "end": 71.81, "text": "如果他们欲取南郡"}, {"start": 72.53, "end": 73.77, "text": "不妨就让他们取好了"}, {"start": 75.21, "end": 75.73, "text": "大都督"}, {"start": 76.85, "end": 78.65, "text": "将士们千辛万苦击败了曹操"}, {"start": 78.97, "end": 80.05, "text": "就是为了进取中原"}, {"start": 80.05, "end": 81.01, "text": "夺取荆州九郡"}, {"start": 81.85, "end": 83.53, "text": "我们付出了那么多血汗性命"}, {"start": 84.01, "end": 85.37, "text": "怎么能让刘备独占便宜"}, {"start": 85.93, "end": 87.05, "text": "如果刘备得了荆州"}, {"start": 87.61, "end": 89.45, "text": "日后江东将会两面受敌"}, {"start": 89.93, "end": 90.53, "text": "北有曹操"}, {"start": 91.21, "end": 92.17, "text": "西有刘备啊"}, {"start": 94.57, "end": 95.77, "text": "兴爸这话不妥当"}, {"start": 96.53, "end": 97.69, "text": "我们与刘备非敌"}, {"start": 98.01, "end": 98.65, "text": "仍是有"}, {"start": 100.13, "end": 102.21, "text": "主公与刘备仍然要联手抗曹"}, {"start": 103.17, "end": 103.61, "text": "主公"}, {"start": 104.41, "end": 105.21, "text": "我这话对吗"}, {"start": 109.47, "end": 110.59, "text": "既然仍是联盟"}, {"start": 111.07, "end": 112.23, "text": "就不应该勾心斗角"}, {"start": 112.91, "end": 115.15, "text": "而应该同心同德共同聚曹"}, {"start": 116.27, "end": 117.59, "text": "至于他们欲攻取南郡"}, {"start": 118.59, "end": 120.23, "text": "我看咱们非但不应该阻拦"}, {"start": 120.75, "end": 122.55, "text": "反而更应该助他们一臂之力"}, {"start": 125.75, "end": 126.31, "text": "禀主公"}, {"start": 128.28, "end": 129.12, "text": "据我所知"}, {"start": 129.68, "end": 131.08, "text": "刘备经过前番恶战"}, {"start": 131.84, "end": 132.92, "text": "营中已无粮草"}, {"start": 133.72, "end": 134.52, "text": "春荒刚过"}, {"start": 135.12, "end": 136.84, "text": "刘军中已经宰马为实"}, {"start": 138.6, "end": 139.72, "text": "在下想请示主公"}, {"start": 140.28, "end": 141.48, "text": "可否以主公的名义"}, {"start": 141.64, "end": 143.16, "text": "赠刘备三千弹军粮"}, {"start": 148.1, "end": 149.62, "text": "攻紧心系大局"}, {"start": 150.06, "end": 151.18, "text": "可喜可敬啊"}, {"start": 152.9, "end": 153.98, "text": "至于赠粮之事"}, {"start": 154.46, "end": 155.46, "text": "你尽管去办"}, {"start": 157.34, "end": 158.02, "text": "中将听着"}, {"start": 158.58, "end": 159.66, "text": "凡前线军务"}, {"start": 160.1, "end": 161.26, "text": "均由大都督做主"}, {"start": 161.9, "end": 162.9, "text": "不用事事禀我"}, {"start": 163.42, "end": 164.9, "text": "我断无异议"}, {"start": 166.26, "end": 166.7, "text": "遵命"}, {"start": 167.82, "end": 168.62, "text": "遵命"}, {"start": 186.15, "end": 186.63, "text": "大都督"}, {"start": 187.27, "end": 189.03, "text": "三千弹军粮已经备好"}, {"start": 194.86, "end": 195.82, "text": "末将这就去吗"}, {"start": 196.26, "end": 205.81, "text": "那干吗还不走"}, {"start": 206.77, "end": 207.77, "text": "末将心里憋屈"}, {"start": 208.37, "end": 209.13, "text": "想问个明白"}, {"start": 210.85, "end": 211.13, "text": "问吧"}, {"start": 213.05, "end": 214.69, "text": "南郡是荆州首要之城"}, {"start": 215.17, "end": 216.13, "text": "如此重要之地"}, {"start": 216.77, "end": 218.73, "text": "大都督为何要拱手让于刘备呢"}, {"start": 220.29, "end": 220.77, "text": "羽盟啊"}, {"start": 223.94, "end": 225.5, "text": "你看得见这水下面有什么吗"}, {"start": 229.21, "end": 230.21, "text": "末将肉眼凡胎"}, {"start": 231.09, "end": 231.61, "text": "看不出来"}, {"start": 234.63, "end": 235.31, "text": "不必赌气"}, {"start": 236.47, "end": 237.71, "text": "我也是肉眼凡胎"}, {"start": 238.55, "end": 240.51, "text": "跟你一样看不出这水面下有什么"}, {"start": 244.1, "end": 244.62, "text": "不过"}, {"start": 246.18, "end": 247.34, "text": "我却心有灵犀"}, {"start": 251.78, "end": 252.82, "text": "眼虽看不见"}, {"start": 253.7, "end": 255.02, "text": "心里却能感觉得到"}, {"start": 257.9, "end": 260.5, "text": "这底下正有一条二尺多长的大鲤鱼"}, {"start": 266.45, "end": 267.89, "text": "我把孔明当成这条鱼"}, {"start": 269.13, "end": 270.73, "text": "孔明也把我当成这条鱼"}, {"start": 273.94, "end": 275.54, "text": "就看谁能调上谁来了"}, {"start": 275.54, "end": 279.22, "text": "末都的意思是"}, {"start": 281.44, "end": 283.4, "text": "刘备的全部兵力只有一万五千"}, {"start": 284.56, "end": 286.2, "text": "南郡的城池又坚实无比"}, {"start": 286.56, "end": 288.56, "text": "守将是曹操的心腹大将曹仁"}, {"start": 288.56, "end": 289.48, "text": "率军两万"}, {"start": 290.92, "end": 292.12, "text": "任何将领都知道"}, {"start": 292.84, "end": 295.12, "text": "如果想攻取一座两万军的城池"}, {"start": 296.28, "end": 298.32, "text": "他必须具备六万以上的精兵"}, {"start": 300.7, "end": 301.38, "text": "刘备有吗"}, {"start": 303.69, "end": 304.21, "text": "全无"}, {"start": 306.84, "end": 308.84, "text": "如此力量想要强行攻城"}, {"start": 309.2, "end": 310.2, "text": "则必然大败"}, {"start": 313.51, "end": 314.03, "text": "别忘了"}, {"start": 316.05, "end": 318.37, "text": "这南郡的不远处还有一座仪灵城"}, {"start": 319.33, "end": 321.33, "text": "曹军上将曹洪聚成而始"}, {"start": 321.77, "end": 323.45, "text": "与南郡护城计较之势"}, {"start": 326.99, "end": 328.23, "text": "以诸葛亮的精明"}, {"start": 329.47, "end": 331.55, "text": "他岂能不明白这南郡虽好"}, {"start": 333.52, "end": 335.16, "text": "却是暗藏险恶呀"}, {"start": 337.76, "end": 339.04, "text": "既然无此力量"}, {"start": 340.0, "end": 341.4, "text": "他们为何还要攻南郡呢"}, {"start": 342.08, "end": 344.52, "text": "实际上诸葛亮不敢攻也不能攻"}, {"start": 345.8, "end": 346.96, "text": "他只是故意装出一副"}, {"start": 346.96, "end": 348.36, "text": "要攻取南郡的样子"}, {"start": 350.53, "end": 350.93, "text": "为何"}, {"start": 353.1, "end": 354.82, "text": "因为他知道我不会袖手旁观"}, {"start": 355.78, "end": 357.7, "text": "他想激我让我出兵攻取南郡"}, {"start": 358.3, "end": 360.22, "text": "让我跟曹仁杀个死去活来"}, {"start": 360.22, "end": 361.38, "text": "他再坐收余力"}, {"start": 367.26, "end": 368.94, "text": "所以我要送他三千军粮"}, {"start": 369.26, "end": 370.42, "text": "这等于鼓励他去攻"}, {"start": 372.4, "end": 374.92, "text": "我则偏要袖手旁观"}, {"start": 375.96, "end": 376.96, "text": "大都督英明啊"}, {"start": 379.34, "end": 380.1, "text": "无需多久"}, {"start": 381.38, "end": 382.42, "text": "只要等上二十天"}, {"start": 385.18, "end": 386.82, "text": "诸葛亮见我们巫动于衷"}, {"start": 386.82, "end": 388.06, "text": "不举兵攻取南郡"}, {"start": 389.06, "end": 390.06, "text": "他就会沉不住气"}, {"start": 391.66, "end": 393.58, "text": "等他跟曹仁打个两败俱伤"}, {"start": 393.58, "end": 395.5, "text": "我们再迅雷一般地冲上去"}, {"start": 395.5, "end": 396.9, "text": "一鼓作气取下南郡"}, {"start": 400.83, "end": 401.95, "text": "岂不事半功倍"}, {"start": 411.93, "end": 412.49, "text": "看见了吧"}, {"start": 413.41, "end": 414.77, "text": "这余比我预计的还要大"}, {"start": 415.57, "end": 415.97, "text": "子敬"}, {"start": 416.21, "end": 418.05, "text": "公瑾要给刘军助粮"}, {"start": 419.05, "end": 422.49, "text": "难道他真的想和刘备言欢吗"}, {"start": 423.65, "end": 424.33, "text": "当然不"}, {"start": 425.25, "end": 427.77, "text": "在下猜想公瑾是在用计"}, {"start": 428.37, "end": 430.77, "text": "他的目的还是要取南郡"}, {"start": 432.17, "end": 433.85, "text": "南郡是荆州之首要"}, {"start": 434.61, "end": 436.25, "text": "孙柳两家都要取"}, {"start": 437.41, "end": 438.33, "text": "但取不好"}, {"start": 439.37, "end": 440.73, "text": "两家便会交恶"}, {"start": 441.97, "end": 443.69, "text": "且看公瑾如何取"}, {"start": 444.01, "end": 444.53, "text": "是啊"}, {"start": 445.29, "end": 446.53, "text": "既要争南郡"}, {"start": 447.05, "end": 448.81, "text": "又要避免彼此交恶"}, {"start": 450.05, "end": 451.09, "text": "这就难了"}, {"start": 451.85, "end": 456.1, "text": "我想公瑾给刘备三千军粮"}, {"start": 456.66, "end": 458.42, "text": "是想要刘备先取"}, {"start": 458.86, "end": 460.74, "text": "他自己则后发之人"}, {"start": 461.26, "end": 462.34, "text": "回去告诉公瑾"}, {"start": 463.14, "end": 467.23, "text": "好生用兵"}, {"start": 468.19, "end": 469.51, "text": "我即日返回柴仓"}, {"start": 469.83, "end": 470.83, "text": "静候嘉义"}, {"start": 471.15, "end": 471.79, "text": "主公啊"}, {"start": 472.19, "end": 473.43, "text": "你怎么说走就走"}, {"start": 473.91, "end": 475.63, "text": "竟不找公瑾相送啊"}, {"start": 475.95, "end": 476.83, "text": "我若在此"}, {"start": 478.23, "end": 480.76, "text": "公瑾不方便"}, {"start": 481.92, "end": 483.04, "text": "我也不方便"}, {"start": 484.32, "end": 485.04, "text": "我走了"}, {"start": 486.04, "end": 486.92, "text": "她舒服"}, {"start": 487.64, "end": 488.56, "text": "我也舒服"}, {"start": 490.04, "end": 490.64, "text": "紫敬"}, {"start": 491.56, "end": 492.64, "text": "难道看不出"}, {"start": 493.04, "end": 496.2, "text": "公瑾早就想让我赶快走呢"}, {"start": 497.76, "end": 500.52, "text": "她想让我远远地坐在主公的宝座上"}, {"start": 501.6, "end": 504.24, "text": "然后把前线的军权"}, {"start": 504.24, "end": 505.2, "text": "全都交给她"}, {"start": 505.68, "end": 506.44, "text": "所以"}, {"start": 507.6, "end": 512.38, "text": "你就当着重将的面"}, {"start": 513.54, "end": 515.38, "text": "真的就把大权托付给她了"}, {"start": 516.02, "end": 517.02, "text": "因为我相信"}, {"start": 517.82, "end": 523.18, "text": "公瑾无负于我"}, {"start": 524.38, "end": 525.86, "text": "她定会占上诸葛亮"}, {"start": 526.54, "end": 527.62, "text": "军师 你看"}, {"start": 528.42, "end": 529.26, "text": "照你的分数"}, {"start": 576.22, "end": 577.9, "text": "我们已经打造了十幅云梯"}, {"start": 578.22, "end": 580.06, "text": "明天就可以拉到大帐外面"}, {"start": 580.5, "end": 582.1, "text": "让那些动物的探少看见"}, {"start": 582.7, "end": 584.02, "text": "咱们要强攻南郡了"}, {"start": 584.62, "end": 585.1, "text": "坐下"}, {"start": 585.14, "end": 586.38, "text": "这些东西不光是摆设"}, {"start": 586.9, "end": 588.18, "text": "早晚咱们得用走它们"}, {"start": 588.5, "end": 589.1, "text": "你歇会儿"}, {"start": 589.94, "end": 590.5, "text": "不行"}, {"start": 590.7, "end": 591.3, "text": "大哥"}, {"start": 591.62, "end": 592.86, "text": "都三个月没打仗了"}, {"start": 596.22, "end": 597.02, "text": "咱们闷坏了"}, {"start": 597.9, "end": 599.06, "text": "赶着一步子下去"}, {"start": 599.58, "end": 601.62, "text": "就好像要把那东宇小儿"}, {"start": 601.62, "end": 602.46, "text": "劈成两半"}, {"start": 603.7, "end": 604.98, "text": "舒服 舒服呀"}, {"start": 608.26, "end": 609.26, "text": "主公 军师"}, {"start": 609.58, "end": 611.62, "text": "吴侯差吕蒙送来三千袋粮食"}, {"start": 611.94, "end": 612.7, "text": "说是劳军"}, {"start": 613.1, "end": 614.94, "text": "吴侯差吕蒙送来三千袋粮食"}, {"start": 615.38, "end": 616.94, "text": "吴侯差吕蒙送来三千袋粮食"}, {"start": 617.54, "end": 618.66, "text": "粮船已经到岸边了"}, {"start": 619.3, "end": 621.74, "text": "吴侯前吕蒙送了三千袋军粮"}, {"start": 625.62, "end": 626.86, "text": "我们倒是正缺粮"}, {"start": 627.9, "end": 628.58, "text": "不过"}, {"start": 629.34, "end": 630.3, "text": "这挺奇怪的"}, {"start": 631.38, "end": 632.78, "text": "主公为何觉得奇怪"}, {"start": 634.66, "end": 636.26, "text": "吴侯知道我们要攻许南郡"}, {"start": 636.26, "end": 637.42, "text": "本应该大怒才对"}, {"start": 638.38, "end": 639.78, "text": "可现在他非但不怒"}, {"start": 639.9, "end": 641.06, "text": "华尔要助我军粮"}, {"start": 641.34, "end": 642.06, "text": "不奇怪吗"}, {"start": 642.58, "end": 643.86, "text": "如此装腔作势"}, {"start": 644.54, "end": 645.78, "text": "定是周公警所"}, {"start": 650.85, "end": 651.89, "text": "你觉得该当吴侯"}, {"start": 655.41, "end": 656.01, "text": "毕德"}, {"start": 656.69, "end": 658.01, "text": "你把这些工程的用具"}, {"start": 658.53, "end": 659.21, "text": "都藏起来"}, {"start": 659.49, "end": 660.41, "text": "不要露出痕迹"}, {"start": 663.62, "end": 664.62, "text": "你不是说过"}, {"start": 665.02, "end": 666.26, "text": "咱们倒这些云梯"}, {"start": 666.38, "end": 667.7, "text": "就是给东吴看的吗"}, {"start": 668.94, "end": 669.98, "text": "现在人家来了"}, {"start": 670.5, "end": 671.7, "text": "为何又要收起来的"}, {"start": 672.02, "end": 672.78, "text": "没法子"}, {"start": 673.34, "end": 674.58, "text": "周瑜比我想得聪明"}, {"start": 674.94, "end": 676.06, "text": "你给他真东西看"}, {"start": 676.26, "end": 677.26, "text": "他会以为是假的"}, {"start": 677.5, "end": 678.98, "text": "你把这些假东西藏起来"}, {"start": 679.22, "end": 680.42, "text": "他反而以为是真的"}, {"start": 680.66, "end": 681.98, "text": "人家是聪明人哪"}, {"start": 682.26, "end": 683.98, "text": "不明白 不明白"}, {"start": 684.54, "end": 686.22, "text": "咱怎么越听越不明白呢"}, {"start": 687.22, "end": 687.62, "text": "三弟"}, {"start": 687.82, "end": 688.66, "text": "照军师吩咐地做"}, {"start": 688.74, "end": 689.18, "text": "快去"}, {"start": 690.74, "end": 691.1, "text": "好"}, {"start": 691.82, "end": 692.3, "text": "兄弟们"}, {"start": 692.62, "end": 694.38, "text": "快把这些梯子放在后面"}, {"start": 696.73, "end": 697.57, "text": "一会吕公来了"}, {"start": 704.7, "end": 705.5, "text": "吕将军啊"}, {"start": 705.82, "end": 707.78, "text": "吴侯真是大有古贤之意"}, {"start": 707.78, "end": 708.7, "text": "明君之风啊"}, {"start": 709.14, "end": 710.5, "text": "真是太让人感动了"}, {"start": 711.38, "end": 713.22, "text": "我正要用兵急需军粮"}, {"start": 713.5, "end": 714.46, "text": "万想不到吴侯"}, {"start": 714.46, "end": 715.82, "text": "竟相助了三千代"}, {"start": 716.18, "end": 717.54, "text": "真是雪中送炭啊"}, {"start": 718.82, "end": 719.5, "text": "刘皇叔啊"}, {"start": 719.78, "end": 720.62, "text": "你太客气了"}, {"start": 721.06, "end": 721.9, "text": "我主公说了"}, {"start": 722.34, "end": 723.14, "text": "你们的困难"}, {"start": 723.14, "end": 724.14, "text": "就是我们的困难"}, {"start": 724.7, "end": 725.34, "text": "再者"}, {"start": 725.62, "end": 726.46, "text": "江东富有"}, {"start": 727.1, "end": 728.1, "text": "钱粮赋税"}, {"start": 728.18, "end": 730.18, "text": "取之不尽 用之不竭"}, {"start": 731.02, "end": 732.18, "text": "王叔若是不嫌弃"}, {"start": 732.58, "end": 734.22, "text": "我主公可以再送些来"}, {"start": 735.1, "end": 736.06, "text": "如此厚礼"}, {"start": 736.18, "end": 737.18, "text": "何以为谢啊"}, {"start": 738.38, "end": 739.94, "text": "南山水蜜桃刚成熟"}, {"start": 740.06, "end": 740.98, "text": "甜美无比"}, {"start": 741.26, "end": 742.9, "text": "我及卓人采摘三百枚"}, {"start": 743.06, "end": 744.5, "text": "凡将军给吴侯代举"}, {"start": 744.98, "end": 745.94, "text": "区区博礼"}, {"start": 746.06, "end": 747.22, "text": "稍至情意罢了"}, {"start": 748.02, "end": 748.98, "text": "好 多谢"}, {"start": 751.3, "end": 752.22, "text": "刘皇叔刚才说"}, {"start": 752.22, "end": 752.94, "text": "要用兵"}, {"start": 753.3, "end": 754.58, "text": "不知用兵何处啊"}, {"start": 757.9, "end": 758.38, "text": "什么"}, {"start": 759.66, "end": 761.74, "text": "我刚才说用兵了"}, {"start": 765.29, "end": 765.93, "text": "没有吧"}, {"start": 768.41, "end": 769.97, "text": "皇叔刚才亲口所说"}, {"start": 770.33, "end": 772.89, "text": "在下也听得真真切切"}, {"start": 776.13, "end": 776.65, "text": "是呀"}, {"start": 780.16, "end": 783.2, "text": "你刚才确实说了用兵二字"}, {"start": 785.2, "end": 786.28, "text": "子明也不是外人"}, {"start": 786.68, "end": 788.04, "text": "我们就把事情告诉他吧"}, {"start": 791.8, "end": 792.44, "text": "子明啊"}, {"start": 792.88, "end": 793.64, "text": "不瞒你说"}, {"start": 794.0, "end": 794.84, "text": "上个月来"}, {"start": 795.76, "end": 797.72, "text": "玲玲出现了蔡茂旧部"}, {"start": 798.52, "end": 800.32, "text": "占住山城拥兵为患"}, {"start": 800.92, "end": 804.36, "text": "我呢想取玲玲为立足之地"}, {"start": 805.08, "end": 805.72, "text": "玲玲"}, {"start": 806.6, "end": 809.28, "text": "皇叔要取玲玲而不是南郡"}, {"start": 810.6, "end": 812.96, "text": "南郡由曹军主将曹仁聚首"}, {"start": 812.96, "end": 813.64, "text": "难哪"}, {"start": 818.62, "end": 819.14, "text": "主公"}, {"start": 819.62, "end": 820.9, "text": "没看见我在迎客吗"}, {"start": 821.62, "end": 822.14, "text": "退下"}, {"start": 822.62, "end": 823.54, "text": "有事以后再说"}, {"start": 824.46, "end": 824.94, "text": "皇叔"}, {"start": 826.38, "end": 827.22, "text": "有事你先忙"}, {"start": 827.58, "end": 828.26, "text": "在下不急"}, {"start": 830.7, "end": 831.18, "text": "何事"}, {"start": 833.02, "end": 833.62, "text": "回主公"}, {"start": 833.86, "end": 835.26, "text": "刘齐公子又吐血了"}, {"start": 835.58, "end": 836.54, "text": "大夫束手无策"}, {"start": 836.78, "end": 837.78, "text": "公子一怒之下"}, {"start": 837.98, "end": 839.14, "text": "领兵回江下了"}, {"start": 839.66, "end": 840.14, "text": "知道了"}, {"start": 842.34, "end": 843.34, "text": "你告诉刘齐公子"}, {"start": 843.58, "end": 844.34, "text": "我稍候急来"}, {"start": 844.98, "end": 845.3, "text": "诺"}, {"start": 849.34, "end": 849.86, "text": "来 子明"}, {"start": 849.98, "end": 850.18, "text": "请"}, {"start": 850.18, "end": 850.42, "text": "好"}, {"start": 851.78, "end": 852.3, "text": "子明"}, {"start": 853.54, "end": 854.78, "text": "刘齐也到了游江口了"}, {"start": 855.38, "end": 856.54, "text": "而且是率军而至"}, {"start": 857.26, "end": 859.1, "text": "那个侍卫不小心说漏了嘴"}, {"start": 859.54, "end": 860.74, "text": "你亲眼看见刘齐了吗"}, {"start": 861.58, "end": 862.46, "text": "是他们禀报的"}, {"start": 863.02, "end": 864.06, "text": "我没有其言所见"}, {"start": 864.46, "end": 869.09, "text": "如果刘齐真的在刘备军营中"}, {"start": 871.08, "end": 872.52, "text": "那么就有另外一种可能了"}, {"start": 874.26, "end": 874.82, "text": "什么可能"}, {"start": 876.1, "end": 877.26, "text": "诸葛亮不是宗室"}, {"start": 877.9, "end": 879.1, "text": "他肯定要攻取南郡"}, {"start": 879.66, "end": 880.1, "text": "大都督"}, {"start": 880.74, "end": 882.42, "text": "刘备军队只有一万五千人马"}, {"start": 883.34, "end": 884.1, "text": "攻取南郡"}, {"start": 884.66, "end": 885.9, "text": "岂不是以卵击石吗"}, {"start": 886.9, "end": 888.9, "text": "刘齐在江下有五万多兵马"}, {"start": 890.78, "end": 891.9, "text": "他如果到了游江口"}, {"start": 892.26, "end": 894.38, "text": "就会与刘备和兵共同攻取南郡"}, {"start": 895.58, "end": 897.42, "text": "这两军加起来有六万多兵马"}, {"start": 898.1, "end": 898.86, "text": "攻城足够"}, {"start": 899.7, "end": 901.22, "text": "可是我在刘备军营当中"}, {"start": 901.54, "end": 903.14, "text": "没有看到一架攻城云梯"}, {"start": 906.5, "end": 907.5, "text": "你所看到的"}, {"start": 908.06, "end": 909.66, "text": "是人家想让你看到的"}, {"start": 915.25, "end": 915.73, "text": "其二"}, {"start": 916.33, "end": 917.25, "text": "攻城器械中"}, {"start": 918.21, "end": 919.65, "text": "最可怕的也不是云梯"}, {"start": 921.74, "end": 922.42, "text": "而是内应"}, {"start": 924.06, "end": 925.26, "text": "大都督的意思是"}, {"start": 929.98, "end": 930.74, "text": "京乡九郡"}, {"start": 931.22, "end": 932.58, "text": "原本是刘表的属地"}, {"start": 933.3, "end": 935.02, "text": "他苦心经营了大半辈子"}, {"start": 935.34, "end": 937.1, "text": "最终还是落入了曹操之手"}, {"start": 938.18, "end": 938.58, "text": "但是"}, {"start": 939.3, "end": 941.02, "text": "驻京乡各城的守军之中"}, {"start": 941.58, "end": 943.54, "text": "仍然有不少是刘氏的旧部"}, {"start": 945.52, "end": 946.56, "text": "是本地氏族"}, {"start": 946.56, "end": 947.68, "text": "在南郡城也一样"}, {"start": 948.84, "end": 949.36, "text": "这些人"}, {"start": 950.24, "end": 951.76, "text": "往往怀念着旧主之恩"}, {"start": 953.6, "end": 956.04, "text": "如果孔明既用了刘齐的兵马"}, {"start": 956.96, "end": 958.84, "text": "又勾结了城中的刘氏旧部"}, {"start": 959.44, "end": 964.86, "text": "那么去南郡城则大有可为"}, {"start": 967.61, "end": 967.93, "text": "是啊"}, {"start": 969.65, "end": 971.93, "text": "刘备还不慎吐布了一句"}, {"start": 972.61, "end": 973.97, "text": "说他近日即将用兵"}, {"start": 974.33, "end": 976.13, "text": "这三千粮草来得正是时候"}, {"start": 976.73, "end": 978.61, "text": "末将臣妓问他要用兵何处"}, {"start": 979.61, "end": 982.09, "text": "刘备竟然唐色说要去玲玲立族"}, {"start": 986.58, "end": 987.14, "text": "玲玲"}, {"start": 989.85, "end": 992.25, "text": "区区一座小城何至于大都干涸"}, {"start": 993.45, "end": 995.17, "text": "蠢话临篇 欺人之谈"}, {"start": 995.53, "end": 998.66, "text": "简直是我东"}, {"start": 1001.77, "end": 1002.17, "text": "大都督"}, {"start": 1003.33, "end": 1004.37, "text": "我们接下来该怎么做"}, {"start": 1006.84, "end": 1007.4, "text": "不必较急"}, {"start": 1010.07, "end": 1011.03, "text": "孔明冠使诈"}, {"start": 1012.83, "end": 1013.71, "text": "我不会上他的当"}, {"start": 1016.1, "end": 1018.94, "text": "此事真伪必须明辨而后断"}, {"start": 1019.3, "end": 1025.37, "text": "我要亲自走一趟刘备军营"}, {"start": 1025.37, "end": 1028.09, "text": "还要亲眼看看 刘齐在不在营"}, {"start": 1028.45, "end": 1054.51, "text": "在下昭夜司 慕夜暇"}, {"start": 1054.79, "end": 1056.75, "text": "早就盼望能与大都督相聚了"}, {"start": 1057.07, "end": 1059.67, "text": "今日如愿以偿 幸慎幸慎"}, {"start": 1060.15, "end": 1064.1, "text": "周瑜早就该来拜见刘皇叔了"}, {"start": 1064.7, "end": 1067.22, "text": "怎奈军务繁忙 意志脱不开身"}, {"start": 1068.14, "end": 1069.54, "text": "赶请刘皇叔恕罪"}, {"start": 1072.86, "end": 1074.42, "text": "贵君如此之雄壮"}, {"start": 1074.82, "end": 1075.86, "text": "望之党寒哪"}, {"start": 1076.3, "end": 1078.46, "text": "好 知道大都督亲自光临"}, {"start": 1078.46, "end": 1079.46, "text": "又惊又喜"}, {"start": 1079.46, "end": 1081.54, "text": "当然要以这三宫之礼迎接大都督"}, {"start": 1081.54, "end": 1082.54, "text": "好 多谢 多谢"}, {"start": 1084.3, "end": 1086.78, "text": "我也听说"}, {"start": 1087.22, "end": 1089.7, "text": "这刘齐将军由江下来到油江了"}, {"start": 1091.1, "end": 1092.1, "text": "为何不见呢"}, {"start": 1093.34, "end": 1096.74, "text": "刘公子病重 不能亲自恭候大家"}, {"start": 1097.34, "end": 1098.14, "text": "病了"}, {"start": 1098.98, "end": 1099.94, "text": "这病得重吗"}, {"start": 1101.06, "end": 1102.14, "text": "长病还是短病"}, {"start": 1102.62, "end": 1103.74, "text": "饿症还是小急啊"}, {"start": 1104.54, "end": 1107.74, "text": "公子他旧病复发 卧榻奔起"}, {"start": 1108.06, "end": 1110.54, "text": "那我就更应该来拜访刘将军了"}, {"start": 1111.46, "end": 1112.26, "text": "皇叔请看"}, {"start": 1112.86, "end": 1114.74, "text": "我把这江东名医都给带来了"}, {"start": 1115.22, "end": 1117.62, "text": "他体型消瘦 精力不知"}, {"start": 1117.62, "end": 1119.42, "text": "只想静养 不愿见客"}, {"start": 1119.62, "end": 1127.27, "text": "要不这样吧"}, {"start": 1127.67, "end": 1129.59, "text": "我替他拜谢大都督"}, {"start": 1129.83, "end": 1131.79, "text": "足下呢 就不必看望了"}, {"start": 1132.19, "end": 1134.07, "text": "如果我坚持要见刘齐"}, {"start": 1135.55, "end": 1136.87, "text": "皇叔会不会多谢"}, {"start": 1140.67, "end": 1141.67, "text": "这是何话"}, {"start": 1141.99, "end": 1143.51, "text": "我只是想请你来"}, {"start": 1143.55, "end": 1144.47, "text": "主公啊"}, {"start": 1145.71, "end": 1147.99, "text": "既然大都督要拜访刘齐将军"}, {"start": 1148.27, "end": 1150.51, "text": "我看还是应该请他去"}, {"start": 1150.83, "end": 1152.47, "text": "要不然大都督心里"}, {"start": 1152.47, "end": 1154.23, "text": "肯定有诸多的不安"}, {"start": 1154.71, "end": 1155.71, "text": "这话不错"}, {"start": 1156.11, "end": 1157.55, "text": "好 那就请吧"}, {"start": 1157.87, "end": 1158.51, "text": "公子"}, {"start": 1160.11, "end": 1161.11, "text": "多年不见"}, {"start": 1163.53, "end": 1167.3, "text": "没想到你一病如此"}, {"start": 1168.62, "end": 1192.77, "text": "多谢公金前来看我"}, {"start": 1193.77, "end": 1195.53, "text": "我一定会再次感谢你"}, {"start": 1196.25, "end": 1196.97, "text": "公子"}, {"start": 1198.61, "end": 1199.21, "text": "公子"}, {"start": 1206.45, "end": 1207.05, "text": "公子"}, {"start": 1212.71, "end": 1213.31, "text": "公子"}, {"start": 1215.31, "end": 1215.91, "text": "公子"}, {"start": 1215.99, "end": 1216.99, "text": "送你回来"}, {"start": 1217.83, "end": 1218.27, "text": "快"}, {"start": 1224.7, "end": 1225.18, "text": "公子"}, {"start": 1225.46, "end": 1226.86, "text": "你们都没干啥"}, {"start": 1227.22, "end": 1227.98, "text": "还说不去"}, {"start": 1228.14, "end": 1228.78, "text": "公子"}, {"start": 1229.3, "end": 1229.9, "text": "啊"}, {"start": 1230.5, "end": 1231.06, "text": "公子"}, {"start": 1231.3, "end": 1233.78, "text": "公子"}, {"start": 1233.86, "end": 1234.46, "text": "公子"}, {"start": 1242.72, "end": 1243.36, "text": "公子"}, {"start": 1250.16, "end": 1252.2, "text": "公子大志可敬可佩"}, {"start": 1257.06, "end": 1258.18, "text": "在下就不打扰了"}, {"start": 1258.9, "end": 1260.26, "text": "请公子安心静养"}, {"start": 1260.74, "end": 1262.3, "text": "荆州早晚会光复的"}, {"start": 1283.82, "end": 1285.1, "text": "江东多义士"}, {"start": 1285.1, "end": 1286.66, "text": "世事暖人心啊"}, {"start": 1286.86, "end": 1287.46, "text": "公瑾"}, {"start": 1287.78, "end": 1290.7, "text": "前几日吴侯前吕蒙赠粮"}, {"start": 1291.02, "end": 1292.38, "text": "今日公瑾又听说"}, {"start": 1292.38, "end": 1293.54, "text": "刘齐公子病重"}, {"start": 1293.54, "end": 1294.66, "text": "亲自送衣"}, {"start": 1295.62, "end": 1297.9, "text": "刘某实在是感激不尽啊"}, {"start": 1298.22, "end": 1298.7, "text": "来"}, {"start": 1299.02, "end": 1300.38, "text": "我敬足下一尊"}, {"start": 1300.86, "end": 1301.98, "text": "皇叔太客气了"}, {"start": 1308.15, "end": 1308.87, "text": "皇叔啊"}, {"start": 1309.79, "end": 1310.75, "text": "某有一言"}, {"start": 1310.95, "end": 1311.87, "text": "不知该不该问"}, {"start": 1311.87, "end": 1312.43, "text": "请讲"}, {"start": 1314.61, "end": 1316.09, "text": "刘齐一兵游疆"}, {"start": 1316.97, "end": 1318.53, "text": "与阁下和军一处"}, {"start": 1318.81, "end": 1319.69, "text": "送为何来"}, {"start": 1321.93, "end": 1322.77, "text": "这个"}, {"start": 1325.38, "end": 1326.74, "text": "莫非真要娶南军吗"}, {"start": 1330.44, "end": 1331.16, "text": "这个嘛"}, {"start": 1331.16, "end": 1333.04, "text": "我正要跟大都督商量"}, {"start": 1333.68, "end": 1334.64, "text": "怎么个商量方"}, {"start": 1339.79, "end": 1340.43, "text": "公瑾啊"}, {"start": 1341.23, "end": 1342.71, "text": "容在下直言相比"}, {"start": 1343.83, "end": 1345.47, "text": "曹操虽然遁回许昌"}, {"start": 1345.79, "end": 1348.39, "text": "可是在南军留下了精兵猛将"}, {"start": 1349.11, "end": 1350.47, "text": "这颗虎牙不拔了"}, {"start": 1351.19, "end": 1353.23, "text": "便是孙柳两家的心腹巨患"}, {"start": 1354.07, "end": 1354.63, "text": "于是"}, {"start": 1355.03, "end": 1357.03, "text": "我主打算不必刀剑"}, {"start": 1357.27, "end": 1358.95, "text": "豁出去几万人马不要了"}, {"start": 1359.19, "end": 1360.35, "text": "也要攻下南军"}, {"start": 1360.75, "end": 1362.27, "text": "以为江东之屏障"}, {"start": 1367.35, "end": 1368.87, "text": "孔明先生真会说话"}, {"start": 1369.19, "end": 1371.47, "text": "竟然是助我江东夺取南军"}, {"start": 1371.91, "end": 1372.83, "text": "果真如此嘛"}, {"start": 1376.44, "end": 1377.4, "text": "谁人不知"}, {"start": 1378.24, "end": 1380.12, "text": "得了南军就等于得到了荆州"}, {"start": 1380.6, "end": 1381.72, "text": "咱们都是明白人"}, {"start": 1382.28, "end": 1384.52, "text": "乱世之中诸侯割据"}, {"start": 1385.0, "end": 1386.96, "text": "最珍贵的就是城池土地"}, {"start": 1389.53, "end": 1391.13, "text": "孙柳两家虽是联盟"}, {"start": 1391.45, "end": 1393.53, "text": "但亲兄弟都还得明算账"}, {"start": 1395.55, "end": 1396.79, "text": "此次赤壁血债"}, {"start": 1397.43, "end": 1398.95, "text": "我东吴举兵最多"}, {"start": 1398.95, "end": 1400.23, "text": "阵亡将士最多"}, {"start": 1401.07, "end": 1402.11, "text": "恶仗打完"}, {"start": 1402.91, "end": 1404.99, "text": "总不能让我主公两手空空"}, {"start": 1405.63, "end": 1407.83, "text": "而刘皇叔却想独自摘取"}, {"start": 1407.83, "end": 1409.27, "text": "这胜利的果实嘛"}, {"start": 1414.79, "end": 1415.23, "text": "公瑾"}, {"start": 1415.79, "end": 1417.59, "text": "我断断没有想到这一层啊"}, {"start": 1417.99, "end": 1420.43, "text": "我只是想把曹人逐出南郡"}, {"start": 1420.43, "end": 1421.71, "text": "免得利剑当头"}, {"start": 1421.71, "end": 1423.71, "text": "成天在你我两家面前晃动"}, {"start": 1424.71, "end": 1427.43, "text": "如果吴侯想取南郡"}, {"start": 1428.03, "end": 1429.55, "text": "那我断不敢相争"}, {"start": 1430.71, "end": 1431.47, "text": "真话"}, {"start": 1431.99, "end": 1433.27, "text": "字字无虚"}, {"start": 1438.16, "end": 1439.48, "text": "还是刘皇叔厚道"}, {"start": 1440.16, "end": 1441.24, "text": "在下领情了"}, {"start": 1444.04, "end": 1445.88, "text": "我也实情禀报给皇叔吧"}, {"start": 1446.32, "end": 1448.8, "text": "我以奉主公令调集五万大军"}, {"start": 1448.8, "end": 1450.56, "text": "从江北进军直逼南郡"}, {"start": 1450.56, "end": 1451.6, "text": "三十日之内"}, {"start": 1452.64, "end": 1453.36, "text": "必下"}, {"start": 1462.22, "end": 1462.9, "text": "那"}, {"start": 1463.38, "end": 1467.06, "text": "那我们只好静候大都督佳音了"}, {"start": 1469.79, "end": 1471.79, "text": "曹操虽然赤壁大败"}, {"start": 1471.79, "end": 1473.43, "text": "但仍然雄居中原四周"}, {"start": 1473.95, "end": 1476.79, "text": "兵马潜梁远胜于你我两家"}, {"start": 1476.79, "end": 1478.59, "text": "南郡守城将领曹仁"}, {"start": 1478.59, "end": 1480.99, "text": "更是一名能争贯战的大将"}, {"start": 1480.99, "end": 1483.31, "text": "曹操用他守城定有所谋"}, {"start": 1485.19, "end": 1487.63, "text": "东吴兵马刚刚经历了赤壁大战"}, {"start": 1488.47, "end": 1489.87, "text": "马上又要攻城略地"}, {"start": 1490.83, "end": 1493.31, "text": "在下替阁下担心啊"}, {"start": 1493.31, "end": 1496.37, "text": "孔明担心什么"}, {"start": 1496.77, "end": 1498.57, "text": "担心阁下攻不下南郡"}, {"start": 1498.57, "end": 1499.65, "text": "反受其累"}, {"start": 1508.5, "end": 1509.66, "text": "驱驱南郡"}, {"start": 1510.5, "end": 1512.06, "text": "我娶她如探囊取物"}, {"start": 1512.06, "end": 1513.06, "text": "唾手可得"}, {"start": 1514.94, "end": 1516.7, "text": "原来公瑾早就把南郡"}, {"start": 1516.7, "end": 1518.14, "text": "作为囊中之物了"}, {"start": 1518.86, "end": 1520.34, "text": "敬佩 敬佩"}, {"start": 1520.74, "end": 1521.74, "text": "孔明不必敬佩"}, {"start": 1523.54, "end": 1524.54, "text": "三十日之内"}, {"start": 1525.22, "end": 1526.42, "text": "我如娶不下南郡"}, {"start": 1527.66, "end": 1529.26, "text": "那时便任凭你去娶"}, {"start": 1530.34, "end": 1531.86, "text": "公瑾此话当真吗"}, {"start": 1533.18, "end": 1534.82, "text": "借用皇叔刚才一句话"}, {"start": 1540.81, "end": 1541.61, "text": "好"}, {"start": 1542.77, "end": 1544.69, "text": "就为大都督这句豪言"}, {"start": 1545.73, "end": 1547.17, "text": "那我们就按兵不动"}, {"start": 1547.17, "end": 1548.17, "text": "拭目以待"}, {"start": 1551.26, "end": 1552.34, "text": "三十天后"}, {"start": 1553.06, "end": 1554.94, "text": "若大都督娶不下南郡"}, {"start": 1555.38, "end": 1556.78, "text": "我们就不自量力"}, {"start": 1556.78, "end": 1558.02, "text": "发兵攻取了"}, {"start": 1559.02, "end": 1559.94, "text": "三十日之内"}, {"start": 1559.94, "end": 1561.98, "text": "我就在南郡城头摆下盛宴"}, {"start": 1562.38, "end": 1564.22, "text": "邀请刘皇叔喝酒赏月"}, {"start": 1569.22, "end": 1570.86, "text": "孔明先生如有闲暇"}, {"start": 1571.58, "end": 1572.5, "text": "也不妨一同来"}, {"start": 1573.74, "end": 1575.06, "text": "多谢大都督盛情"}, {"start": 1575.62, "end": 1578.26, "text": "在下现在就想着那席酒宴呢"}, {"start": 1578.54, "end": 1579.94, "text": "早就不饮而醉了"}, {"start": 1628.63, "end": 1630.03, "text": "多谢你报病相助"}, {"start": 1638.38, "end": 1640.42, "text": "他相信你们要攻取南郡吗"}, {"start": 1641.86, "end": 1642.74, "text": "深信不疑"}, {"start": 1643.42, "end": 1644.54, "text": "甚至立下誓言"}, {"start": 1645.02, "end": 1647.14, "text": "要在三十天之内攻取南郡"}, {"start": 1649.46, "end": 1651.06, "text": "这多亏了贤侄你啊"}, {"start": 1652.34, "end": 1655.06, "text": "若不是你报病行船几百里"}, {"start": 1655.34, "end": 1656.54, "text": "从江夏赶到这"}, {"start": 1657.9, "end": 1659.58, "text": "那周瑜万万不能上钩"}, {"start": 1661.3, "end": 1662.14, "text": "只是这样"}, {"start": 1662.98, "end": 1664.02, "text": "累了你的身体"}, {"start": 1664.5, "end": 1666.1, "text": "我实在于心不安呢"}, {"start": 1667.42, "end": 1669.06, "text": "京乡是六世祖业"}, {"start": 1670.38, "end": 1672.14, "text": "本该由我率军夺回来"}, {"start": 1675.22, "end": 1675.94, "text": "我无能"}, {"start": 1678.96, "end": 1680.4, "text": "只有拜托皇叔了"}, {"start": 1680.76, "end": 1688.49, "text": "付出一把力"}, {"start": 1688.69, "end": 1694.16, "text": "远离万里"}, {"start": 1695.0, "end": 1696.28, "text": "我也心甘情愿"}, {"start": 1697.72, "end": 1698.92, "text": "贤侄这番话"}, {"start": 1699.88, "end": 1701.2, "text": "京生在天之灵"}, {"start": 1701.56, "end": 1702.84, "text": "也当深感欣悲"}, {"start": 1709.45, "end": 1710.85, "text": "要是能把荆州大业"}, {"start": 1711.41, "end": 1712.41, "text": "传给贤侄"}, {"start": 1712.93, "end": 1713.93, "text": "那该多好啊"}, {"start": 1715.37, "end": 1717.49, "text": "过去的事情只能让它过去了"}, {"start": 1717.73, "end": 1721.59, "text": "不愿父亲没有离我为私"}, {"start": 1721.87, "end": 1738.84, "text": "只将荆州传给皇叔"}, {"start": 1739.72, "end": 1741.12, "text": "甘能丢了大业"}, {"start": 1741.84, "end": 1744.24, "text": "又岂能有今日草草之祸呀"}, {"start": 1744.56, "end": 1784.12, "text": "周瑜君朕"}, {"start": 1784.4, "end": 1787.37, "text": "眼睁盛啊"}, {"start": 1787.89, "end": 1788.85, "text": "奔袭百里"}, {"start": 1789.05, "end": 1790.29, "text": "还毫无决意"}, {"start": 1791.09, "end": 1791.45, "text": "谋"}, {"start": 1792.29, "end": 1793.41, "text": "愿领精兵一支"}, {"start": 1794.05, "end": 1795.37, "text": "与之决一死战"}, {"start": 1795.73, "end": 1796.29, "text": "好"}, {"start": 1796.93, "end": 1798.33, "text": "牛将军奋勇可驾"}, {"start": 1798.81, "end": 1799.25, "text": "你们说"}, {"start": 1799.77, "end": 1800.49, "text": "战是不战"}, {"start": 1800.89, "end": 1801.53, "text": "战"}, {"start": 1802.01, "end": 1802.57, "text": "上将军"}, {"start": 1803.53, "end": 1804.73, "text": "我军赤壁兴败"}, {"start": 1805.09, "end": 1806.29, "text": "敌军气势正盛"}, {"start": 1806.97, "end": 1807.61, "text": "按兵法"}, {"start": 1808.09, "end": 1809.69, "text": "当以坚守不战一上"}, {"start": 1810.73, "end": 1812.21, "text": "待敌气衰再战"}, {"start": 1812.77, "end": 1813.57, "text": "为将者"}, {"start": 1814.17, "end": 1815.17, "text": "乍逢大败"}, {"start": 1815.73, "end": 1817.33, "text": "确实是应该避战"}, {"start": 1818.29, "end": 1820.01, "text": "不但兵法上是这么说的"}, {"start": 1820.93, "end": 1821.77, "text": "我廖敌将"}, {"start": 1822.49, "end": 1823.49, "text": "他也是这么想的"}, {"start": 1825.05, "end": 1827.09, "text": "你们细看城下的敌军军战"}, {"start": 1828.37, "end": 1829.21, "text": "表面严整"}, {"start": 1829.53, "end": 1831.77, "text": "阵中却存在若干空隙"}, {"start": 1832.13, "end": 1832.61, "text": "所以"}, {"start": 1833.33, "end": 1834.89, "text": "正因为我军新败"}, {"start": 1835.61, "end": 1836.65, "text": "敌军焦狂"}, {"start": 1837.41, "end": 1838.53, "text": "果而才有机会"}, {"start": 1838.93, "end": 1840.77, "text": "出其不意地打他一回胜仗"}, {"start": 1842.99, "end": 1843.39, "text": "牛军"}, {"start": 1844.47, "end": 1845.07, "text": "末将在"}, {"start": 1845.79, "end": 1848.35, "text": "下面就是东吴上将甘宁"}, {"start": 1849.35, "end": 1850.23, "text": "听说此人"}, {"start": 1851.03, "end": 1852.79, "text": "有万夫不党之勇"}, {"start": 1854.11, "end": 1855.95, "text": "如果给你五百精兵"}, {"start": 1856.59, "end": 1858.51, "text": "你是否敢出城和他交战"}, {"start": 1860.89, "end": 1861.29, "text": "赶着"}, {"start": 1862.05, "end": 1862.69, "text": "好"}, {"start": 1863.73, "end": 1864.97, "text": "我亲自雷鼓"}, {"start": 1865.77, "end": 1866.85, "text": "撞你胜威"}, {"start": 1868.17, "end": 1868.77, "text": "谢将军"}, {"start": 1871.28, "end": 1871.76, "text": "尚将军"}, {"start": 1872.84, "end": 1874.56, "text": "城下甘宁率五千军马"}, {"start": 1875.4, "end": 1876.36, "text": "你让牛将军"}, {"start": 1876.84, "end": 1877.96, "text": "带五百营敌"}, {"start": 1879.04, "end": 1881.32, "text": "那岂不有去无回呀"}, {"start": 1883.12, "end": 1885.6, "text": "我正是要他有去无回呀"}, {"start": 1899.65, "end": 1900.09, "text": "跟我上"}, {"start": 2031.02, "end": 2032.54, "text": "马上铭金收兵吧"}, {"start": 2032.78, "end": 2038.45, "text": "如今率领的五百个兄弟"}, {"start": 2038.77, "end": 2040.17, "text": "还剩百十个人呢"}, {"start": 2040.65, "end": 2041.05, "text": "好"}, {"start": 2041.49, "end": 2042.05, "text": "打得好"}, {"start": 2042.45, "end": 2045.42, "text": "如今的弟兄"}, {"start": 2046.06, "end": 2047.5, "text": "就快全部战死了"}, {"start": 2047.78, "end": 2048.3, "text": "好啊"}, {"start": 2048.54, "end": 2049.3, "text": "下得好"}, {"start": 2050.1, "end": 2051.18, "text": "你好好给我看看"}, {"start": 2051.94, "end": 2053.34, "text": "我只用了五百个军士"}, {"start": 2053.86, "end": 2054.78, "text": "把五千帝军"}, {"start": 2055.1, "end": 2056.18, "text": "背得筋疲力尽"}, {"start": 2056.5, "end": 2071.86, "text": "五千军马"}, {"start": 2072.46, "end": 2073.54, "text": "都到城门聚集"}, {"start": 2074.3, "end": 2075.1, "text": "三鼓之后"}, {"start": 2076.06, "end": 2076.98, "text": "大开城门"}, {"start": 2077.38, "end": 2078.78, "text": "我领你们全部杀出去"}, {"start": 2079.26, "end": 2080.06, "text": "遵旨"}, {"start": 2080.42, "end": 2083.74, "text": "只有一万五千军士"}, {"start": 2084.46, "end": 2085.54, "text": "这都豁出去了"}, {"start": 2086.26, "end": 2087.78, "text": "谁来守城啊"}, {"start": 2088.5, "end": 2089.3, "text": "南郡城"}, {"start": 2089.74, "end": 2091.1, "text": "就留你一人接手"}, {"start": 2092.06, "end": 2092.78, "text": "我一个人"}, {"start": 2093.18, "end": 2093.62, "text": "不错"}, {"start": 2094.26, "end": 2095.26, "text": "就留你一人"}, {"start": 2095.94, "end": 2096.78, "text": "你不必接战"}, {"start": 2097.5, "end": 2098.7, "text": "只管给我雷鼓"}, {"start": 2099.06, "end": 2103.13, "text": "那五千帝军"}, {"start": 2103.77, "end": 2104.97, "text": "刚刚战过一场"}, {"start": 2105.65, "end": 2106.57, "text": "筋疲力尽"}, {"start": 2107.01, "end": 2108.13, "text": "我若以三倍之兵"}, {"start": 2108.41, "end": 2109.29, "text": "猛扑而上"}, {"start": 2109.69, "end": 2110.97, "text": "就能在半个时辰之内"}, {"start": 2111.29, "end": 2112.21, "text": "把他们打垮"}, {"start": 2112.85, "end": 2114.05, "text": "半个时辰之内"}, {"start": 2114.77, "end": 2115.97, "text": "要是打不垮他们"}, {"start": 2116.65, "end": 2117.17, "text": "周瑜"}, {"start": 2117.73, "end": 2119.37, "text": "你就会带领大队人马"}, {"start": 2119.37, "end": 2120.29, "text": "兵临城下"}, {"start": 2120.61, "end": 2124.54, "text": "是我们唯一的战机"}, {"start": 2125.42, "end": 2127.54, "text": "稍纵急势啊"}, {"start": 2128.7, "end": 2129.14, "text": "末将"}, {"start": 2129.74, "end": 2130.78, "text": "遵命守城"}, {"start": 2131.18, "end": 2278.54, "text": "南平山上的树只怕砍光了"}, {"start": 2279.46, "end": 2281.66, "text": "也不够做江东子弟的棺材"}, {"start": 2282.18, "end": 2282.66, "text": "不强攻"}, {"start": 2283.06, "end": 2283.74, "text": "又该如何"}, {"start": 2286.44, "end": 2287.36, "text": "把敌军引出来"}, {"start": 2287.72, "end": 2318.71, "text": "又折了上万兵马"}, {"start": 2319.07, "end": 2320.19, "text": "情势如此危急"}, {"start": 2320.51, "end": 2322.07, "text": "下一步我们该如何应敌"}, {"start": 2322.55, "end": 2323.07, "text": "周瑜"}, {"start": 2323.39, "end": 2324.83, "text": "不愧为东吴的大都督"}, {"start": 2325.15, "end": 2326.11, "text": "善能用兵啊"}, {"start": 2326.71, "end": 2327.55, "text": "以临失守后"}, {"start": 2327.87, "end": 2329.95, "text": "我军已无法拒守南郡"}, {"start": 2330.67, "end": 2331.95, "text": "那我们是不是弃城撤退"}, {"start": 2332.35, "end": 2334.38, "text": "弃城"}, {"start": 2335.34, "end": 2337.06, "text": "南郡是何等要害之地"}, {"start": 2337.42, "end": 2338.3, "text": "失了南郡"}, {"start": 2338.7, "end": 2339.94, "text": "连荆州都难保"}, {"start": 2340.46, "end": 2341.98, "text": "我如何向丞相交代"}, {"start": 2342.62, "end": 2342.86, "text": "不"}, {"start": 2344.54, "end": 2346.14, "text": "我宁死不弃南郡"}, {"start": 2346.82, "end": 2347.1, "text": "好"}, {"start": 2347.58, "end": 2348.66, "text": "那我们就固守待缘"}, {"start": 2350.42, "end": 2352.42, "text": "守是守不住了"}, {"start": 2354.64, "end": 2356.04, "text": "我估计丞相他"}, {"start": 2357.04, "end": 2359.24, "text": "也发不出救兵来"}, {"start": 2360.44, "end": 2361.84, "text": "那你有何良策"}, {"start": 2365.02, "end": 2365.7, "text": "弃城"}, {"start": 2370.01, "end": 2370.41, "text": "大都督"}, {"start": 2371.93, "end": 2372.45, "text": "大都督"}, {"start": 2373.29, "end": 2373.65, "text": "子明"}, {"start": 2373.65, "end": 2374.29, "text": "前军来报"}, {"start": 2374.89, "end": 2376.21, "text": "曹军兵分三门而出"}, {"start": 2376.69, "end": 2377.85, "text": "腰上都附有包裹"}, {"start": 2378.37, "end": 2379.57, "text": "恐怕是要弃城了"}, {"start": 2381.25, "end": 2381.73, "text": "什么"}, {"start": 2382.53, "end": 2383.21, "text": "出来多少人"}, {"start": 2383.61, "end": 2384.97, "text": "据说已经有几千人了"}, {"start": 2387.77, "end": 2389.41, "text": "原来估计他们可以顽抗几天"}, {"start": 2389.93, "end": 2391.09, "text": "想不到竟然要走"}, {"start": 2392.73, "end": 2393.65, "text": "赶紧召集全军"}, {"start": 2393.89, "end": 2394.57, "text": "追杀曹人"}, {"start": 2394.85, "end": 2395.93, "text": "同时夺取城池"}, {"start": 2396.29, "end": 2396.57, "text": "诺"}, {"start": 2403.7, "end": 2404.34, "text": "大都督看"}, {"start": 2406.95, "end": 2407.95, "text": "曹军弃城北逃"}, {"start": 2408.07, "end": 2408.83, "text": "我们赶快追杀吧"}, {"start": 2410.98, "end": 2411.54, "text": "再等下去"}, {"start": 2411.7, "end": 2412.5, "text": "敌军要跑光了"}, {"start": 2413.62, "end": 2415.02, "text": "看见他们的主将曹仁了吗"}, {"start": 2417.78, "end": 2418.3, "text": "这倒没有"}, {"start": 2420.59, "end": 2421.59, "text": "曹仁不出现"}, {"start": 2421.71, "end": 2424.03, "text": "我们就不动兵"}, {"start": 2424.39, "end": 2436.46, "text": "那个就是曹仁"}]