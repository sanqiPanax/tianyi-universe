[{"start": 8.46, "end": 10.14, "text": "自陛下出征后"}, {"start": 10.14, "end": 12.74, "text": "天威所向平平告诫"}, {"start": 13.38, "end": 14.62, "text": "臣为陛下"}, {"start": 14.62, "end": 16.46, "text": "知智勇精叹不已"}, {"start": 16.46, "end": 17.94, "text": "敬佩无疑"}, {"start": 18.46, "end": 20.74, "text": "但臣声性谨慎"}, {"start": 20.74, "end": 22.58, "text": "常怀岐人之忧"}, {"start": 23.46, "end": 24.54, "text": "陆迅岐人"}, {"start": 24.54, "end": 26.54, "text": "虽名不扬声不远"}, {"start": 26.94, "end": 29.54, "text": "但臣闻岐研习兵法多年"}, {"start": 29.54, "end": 32.06, "text": "十年铸剑不露锋芒"}, {"start": 32.5, "end": 35.14, "text": "盼陛下不可轻视"}, {"start": 35.38, "end": 39.2, "text": "马苏啊"}, {"start": 40.2, "end": 42.08, "text": "你押运粮草是假"}, {"start": 42.68, "end": 44.76, "text": "替孔明送信才是真吧"}, {"start": 46.69, "end": 48.49, "text": "陛下一语刀破"}, {"start": 49.01, "end": 51.68, "text": "臣动身之前"}, {"start": 52.0, "end": 53.8, "text": "丞相是树叶不能寐"}, {"start": 54.0, "end": 55.6, "text": "总是为君情而忧虑"}, {"start": 56.64, "end": 58.24, "text": "孔明在忧虑什么呢"}, {"start": 58.56, "end": 61.87, "text": "丞相自己也说不清楚"}, {"start": 62.47, "end": 63.63, "text": "据臣猜测"}, {"start": 64.39, "end": 65.99, "text": "他还是担忧陆迅"}, {"start": 66.23, "end": 70.42, "text": "孔明说得已经很清楚了"}, {"start": 70.62, "end": 75.25, "text": "陆迅研习兵法多年"}, {"start": 75.45, "end": 78.74, "text": "十年铸剑"}, {"start": 79.9, "end": 81.34, "text": "不露锋芒"}, {"start": 81.62, "end": 89.2, "text": "马苏啊"}, {"start": 89.84, "end": 91.32, "text": "你肯定知道"}, {"start": 92.04, "end": 93.92, "text": "春秋使的赵阔吧"}, {"start": 94.52, "end": 96.4, "text": "赵阔研习过的兵法"}, {"start": 96.88, "end": 98.96, "text": "只怕要比这陆迅多得多"}, {"start": 100.04, "end": 101.08, "text": "但结果呢"}, {"start": 101.4, "end": 105.28, "text": "只上谈兵罢了"}, {"start": 106.04, "end": 107.08, "text": "合作为绩"}, {"start": 107.56, "end": 118.09, "text": "你歇息几日"}, {"start": 118.09, "end": 119.09, "text": "寄回成都"}, {"start": 119.57, "end": 121.93, "text": "帮我传话给孔明"}, {"start": 122.25, "end": 123.65, "text": "就说此时"}, {"start": 124.09, "end": 126.09, "text": "乃法务关键之一"}, {"start": 126.85, "end": 130.38, "text": "我们只可尽"}, {"start": 136.89, "end": 139.09, "text": "这是我给我自己的军令"}, {"start": 142.76, "end": 143.36, "text": "还有"}, {"start": 145.2, "end": 147.88, "text": "让孔明多备些粮草军血"}, {"start": 148.12, "end": 149.28, "text": "待秋粮时"}, {"start": 149.64, "end": 151.12, "text": "运至萧廷前线"}, {"start": 156.8, "end": 157.4, "text": "遵命"}, {"start": 201.69, "end": 202.41, "text": "末将在"}, {"start": 202.65, "end": 205.86, "text": "天过去了"}, {"start": 206.74, "end": 208.98, "text": "为什么还没有攻下炮火寨"}, {"start": 210.58, "end": 211.94, "text": "吴军抵抗甚为顽强"}, {"start": 211.94, "end": 212.9, "text": "我军只要攻打"}, {"start": 212.98, "end": 213.38, "text": "敌"}, {"start": 213.82, "end": 214.66, "text": "四战不退"}, {"start": 214.86, "end": 222.94, "text": "增兵两万"}, {"start": 223.34, "end": 225.26, "text": "三日之内能否拿下"}, {"start": 227.78, "end": 229.38, "text": "末将必定四战"}, {"start": 241.02, "end": 242.1, "text": "朕在问你"}, {"start": 242.74, "end": 244.42, "text": "能否攻下敌寨"}, {"start": 244.62, "end": 246.74, "text": "你难道没有胆气直说吗"}, {"start": 247.58, "end": 248.22, "text": "禀陛下"}, {"start": 248.46, "end": 251.78, "text": "怕是疲惫不堪"}, {"start": 252.7, "end": 253.7, "text": "吴军居高临下"}, {"start": 253.7, "end": 254.5, "text": "易守难攻"}, {"start": 255.22, "end": 256.22, "text": "末将定会四战"}, {"start": 256.22, "end": 256.58, "text": "但"}, {"start": 257.54, "end": 258.62, "text": "没有毕生的把握"}, {"start": 259.78, "end": 262.1, "text": "你还是不是张义德的儿子"}, {"start": 264.18, "end": 265.62, "text": "你还是不是我的侄儿"}, {"start": 265.9, "end": 269.72, "text": "如果你没有毕生的把握"}, {"start": 270.2, "end": 271.12, "text": "就直说"}, {"start": 271.48, "end": 272.6, "text": "战令换人"}, {"start": 273.6, "end": 274.2, "text": "陛下"}, {"start": 274.6, "end": 276.16, "text": "三日内我定攻下敌寨"}, {"start": 276.44, "end": 277.16, "text": "如不胜"}, {"start": 277.44, "end": 278.24, "text": "肝当军法"}, {"start": 278.24, "end": 278.8, "text": "好"}, {"start": 279.4, "end": 280.32, "text": "拿纸笔"}, {"start": 280.56, "end": 281.44, "text": "立军领状"}, {"start": 281.88, "end": 282.68, "text": "禀陛下"}, {"start": 283.2, "end": 285.28, "text": "我义兄三日内连续重杀十二次"}, {"start": 285.52, "end": 287.04, "text": "身上已有五处战伤"}, {"start": 287.6, "end": 288.44, "text": "末将想"}, {"start": 289.16, "end": 290.16, "text": "如果连他都"}, {"start": 290.56, "end": 292.32, "text": "无法攻克炮火寨的话"}, {"start": 293.0, "end": 293.68, "text": "那别人"}, {"start": 294.6, "end": 296.32, "text": "恐怕就更难攻上去了"}, {"start": 296.64, "end": 303.2, "text": "传命"}, {"start": 304.16, "end": 305.52, "text": "各营撤自山下"}, {"start": 306.48, "end": 307.76, "text": "休整两日"}, {"start": 309.52, "end": 310.32, "text": "之后"}, {"start": 311.16, "end": 312.24, "text": "另做布置"}, {"start": 312.76, "end": 314.04, "text": "再战再攻"}, {"start": 315.16, "end": 316.16, "text": "遵命"}, {"start": 317.0, "end": 317.56, "text": "遵命"}, {"start": 318.04, "end": 334.75, "text": "陛下"}, {"start": 336.59, "end": 337.27, "text": "眼下"}, {"start": 337.39, "end": 339.79, "text": "巫军已到了退无可退的地步"}, {"start": 341.35, "end": 342.75, "text": "必会鼓足余勇"}, {"start": 343.83, "end": 344.79, "text": "拼死一搏"}, {"start": 344.79, "end": 351.37, "text": "朕要改变"}, {"start": 351.37, "end": 359.1, "text": "陛下的意思是"}, {"start": 359.26, "end": 362.69, "text": "那巫军诱出山寨来打"}, {"start": 363.09, "end": 366.37, "text": "休整之后"}, {"start": 367.37, "end": 369.57, "text": "各营都须派出老弱兵马"}, {"start": 369.73, "end": 372.49, "text": "日到寨下交阵"}, {"start": 372.49, "end": 374.17, "text": "如其主 击其将"}, {"start": 375.13, "end": 376.97, "text": "敌军有五十余寨"}, {"start": 377.69, "end": 380.01, "text": "必有哪一寨守将按耐不住"}, {"start": 380.65, "end": 381.77, "text": "出寨迎战"}, {"start": 381.77, "end": 383.01, "text": "只要他出来"}, {"start": 383.65, "end": 385.37, "text": "我军便可趁虚攻寨"}, {"start": 386.09, "end": 387.69, "text": "只要攻破三五个寨"}, {"start": 387.69, "end": 391.68, "text": "便会牵动敌军所有营派"}, {"start": 391.68, "end": 396.18, "text": "我在全军出击"}, {"start": 396.78, "end": 397.3, "text": "定会"}, {"start": 397.3, "end": 402.68, "text": "陛下圣明"}, {"start": 402.92, "end": 403.64, "text": "大都督"}, {"start": 432.53, "end": 433.61, "text": "蜀军败退了"}, {"start": 434.97, "end": 435.73, "text": "什么时候"}, {"start": 436.05, "end": 437.33, "text": "半个时辰之前"}, {"start": 437.33, "end": 438.53, "text": "蜀军连续苦战"}, {"start": 438.53, "end": 439.65, "text": "终于不治"}, {"start": 440.29, "end": 441.81, "text": "开始全面败退"}, {"start": 442.81, "end": 445.21, "text": "连尸体都来不及抬走啊"}, {"start": 445.49, "end": 446.21, "text": "大都督"}, {"start": 446.21, "end": 447.41, "text": "敌人损伤惨重"}, {"start": 447.41, "end": 448.57, "text": "未尽寸步"}, {"start": 449.05, "end": 450.81, "text": "我看不如抓住有力战机"}, {"start": 450.81, "end": 452.69, "text": "请一支精兵杀至山下"}, {"start": 452.69, "end": 454.25, "text": "狠狠地击他一下"}, {"start": 454.25, "end": 454.81, "text": "如果"}, {"start": 454.81, "end": 456.41, "text": "才能夺占几座敌营盘"}, {"start": 456.41, "end": 457.65, "text": "赶他三十里外"}, {"start": 457.65, "end": 458.77, "text": "那就更好了"}, {"start": 459.25, "end": 460.53, "text": "你们不许出击"}, {"start": 464.91, "end": 465.71, "text": "你们听着"}, {"start": 469.87, "end": 471.23, "text": "没有本都督的命令"}, {"start": 471.55, "end": 472.95, "text": "没有本都督的命令"}, {"start": 473.75, "end": 475.27, "text": "任何人不许出击"}, {"start": 476.07, "end": 476.87, "text": "为者"}, {"start": 477.39, "end": 478.47, "text": "均罚从事"}, {"start": 478.83, "end": 479.47, "text": "大都督"}, {"start": 479.71, "end": 481.27, "text": "我军毕竟兵少"}, {"start": 481.27, "end": 482.31, "text": "蜀军兵多"}, {"start": 482.51, "end": 483.71, "text": "若不乘胜而追"}, {"start": 484.07, "end": 485.19, "text": "一扣咬死他"}, {"start": 485.71, "end": 487.51, "text": "一旦蜀军缓过气来"}, {"start": 487.51, "end": 488.47, "text": "我们再战"}, {"start": 488.47, "end": 490.03, "text": "恐怕会损失得更多"}, {"start": 490.35, "end": 492.19, "text": "你们只管坚守就是了"}, {"start": 494.39, "end": 495.95, "text": "本都督有一支援兵"}, {"start": 495.95, "end": 497.23, "text": "正向这里赶来"}, {"start": 499.74, "end": 501.14, "text": "应该快到了吧"}, {"start": 501.54, "end": 502.18, "text": "援军"}, {"start": 502.34, "end": 506.56, "text": "东吴哪儿还有可用之兵啊"}, {"start": 508.54, "end": 509.5, "text": "我说了"}, {"start": 510.06, "end": 511.7, "text": "是东吴之兵了吗"}, {"start": 513.72, "end": 515.32, "text": "我说的是时辰一到"}, {"start": 515.32, "end": 517.68, "text": "三十万精兵从天而降"}, {"start": 521.2, "end": 521.72, "text": "算了"}, {"start": 522.88, "end": 524.0, "text": "你们也不要再问了"}, {"start": 526.01, "end": 527.17, "text": "总之一句话"}, {"start": 528.13, "end": 529.37, "text": "没有本都督的命令"}, {"start": 529.37, "end": 530.89, "text": "任何人不许出击"}, {"start": 535.05, "end": 535.69, "text": "遵命"}, {"start": 551.57, "end": 552.45, "text": "不敢了吧"}, {"start": 552.57, "end": 553.61, "text": "那孙权二次"}, {"start": 553.61, "end": 555.09, "text": "就应该倒过来呀"}, {"start": 555.09, "end": 555.33, "text": "对"}, {"start": 555.33, "end": 556.17, "text": "全村"}, {"start": 556.77, "end": 558.21, "text": "吴军全都是村子"}, {"start": 558.21, "end": 559.33, "text": "咱们为这帮村子"}, {"start": 559.33, "end": 560.25, "text": "赶一碗"}, {"start": 566.77, "end": 567.73, "text": "这奶奶的"}, {"start": 568.41, "end": 569.85, "text": "给我召集两千甲士"}, {"start": 569.85, "end": 570.81, "text": "随我出击"}, {"start": 570.81, "end": 572.09, "text": "砍了那帮畜生"}, {"start": 572.09, "end": 572.65, "text": "将军"}, {"start": 572.65, "end": 573.33, "text": "大都督有令"}, {"start": 573.33, "end": 574.33, "text": "不可出击"}, {"start": 574.33, "end": 575.65, "text": "你没看到那帮畜生"}, {"start": 575.65, "end": 576.97, "text": "在骂我们的主公吗"}, {"start": 577.69, "end": 578.53, "text": "兄弟们"}, {"start": 578.81, "end": 580.65, "text": "听说有个败将叫傅俊"}, {"start": 580.89, "end": 582.57, "text": "还是全村的内地呢"}, {"start": 583.45, "end": 585.01, "text": "是可忍熟不可忍"}, {"start": 585.01, "end": 586.17, "text": "我非杀了他们不可"}, {"start": 586.17, "end": 586.93, "text": "将军"}, {"start": 586.93, "end": 587.89, "text": "你个信要不能去啊"}, {"start": 587.89, "end": 589.09, "text": "大都督如果怪罪下来"}, {"start": 589.09, "end": 589.45, "text": "那"}, {"start": 589.45, "end": 590.69, "text": "什么大都督"}, {"start": 591.33, "end": 591.97, "text": "闪开"}, {"start": 592.45, "end": 593.69, "text": "当我这死"}, {"start": 594.13, "end": 594.89, "text": "将军"}, {"start": 594.89, "end": 595.69, "text": "将军"}, {"start": 596.05, "end": 639.18, "text": "傅俊已经把寨子夺去了"}, {"start": 640.58, "end": 641.82, "text": "快朝袍湖寨撤"}, {"start": 641.82, "end": 642.46, "text": "撤"}, {"start": 668.1, "end": 671.38, "text": "就在这里"}, {"start": 671.38, "end": 672.74, "text": "你还记得本都督"}, {"start": 672.74, "end": 675.7, "text": "跟你说过什么吗"}, {"start": 675.7, "end": 676.74, "text": "都督下令"}, {"start": 677.34, "end": 678.42, "text": "不许出寨"}, {"start": 680.97, "end": 682.69, "text": "你违令出击"}, {"start": 682.69, "end": 684.29, "text": "牵动左右各营"}, {"start": 685.37, "end": 686.97, "text": "蜀军御学半月"}, {"start": 686.97, "end": 688.69, "text": "都不能前进寸步"}, {"start": 689.77, "end": 691.37, "text": "你这贸然一击"}, {"start": 692.01, "end": 693.29, "text": "就让我们丢失了"}, {"start": 693.29, "end": 699.06, "text": "四座营寨"}, {"start": 699.1, "end": 699.94, "text": "传令"}, {"start": 700.66, "end": 701.78, "text": "押出傅俊"}, {"start": 702.38, "end": 703.58, "text": "迎前正法"}, {"start": 703.58, "end": 704.34, "text": "诺"}, {"start": 704.34, "end": 705.14, "text": "大都督"}, {"start": 705.86, "end": 707.82, "text": "傅将军虽然有过失"}, {"start": 708.42, "end": 709.98, "text": "可蜀军的声声辱骂"}, {"start": 709.98, "end": 712.1, "text": "实在是不堪入耳啊"}, {"start": 712.78, "end": 713.66, "text": "再说"}, {"start": 714.02, "end": 715.42, "text": "他毕竟是"}, {"start": 718.45, "end": 720.85, "text": "他毕竟是主公的内地"}, {"start": 722.05, "end": 722.69, "text": "对吗"}, {"start": 723.21, "end": 724.05, "text": "不错"}, {"start": 724.05, "end": 725.61, "text": "我是主公内地"}, {"start": 725.61, "end": 726.49, "text": "我也是为了主公"}, {"start": 726.49, "end": 728.29, "text": "不受那些畜生辱骂"}, {"start": 728.29, "end": 729.73, "text": "我才出债杀敌的"}, {"start": 730.49, "end": 731.25, "text": "陆徐"}, {"start": 731.49, "end": 733.17, "text": "你能把我怎么样啊"}, {"start": 734.89, "end": 743.41, "text": "傅俊啊"}, {"start": 743.41, "end": 746.59, "text": "你给我听好了"}, {"start": 746.59, "end": 748.51, "text": "在本都督的营帐里"}, {"start": 748.51, "end": 751.75, "text": "只有将帅没有皇亲国戚"}, {"start": 752.83, "end": 753.95, "text": "拉出去"}, {"start": 753.95, "end": 754.51, "text": "扎了"}, {"start": 754.51, "end": 755.07, "text": "诺"}, {"start": 755.07, "end": 756.07, "text": "陆徐"}, {"start": 756.07, "end": 757.71, "text": "我是有功之臣"}, {"start": 757.71, "end": 758.07, "text": "报"}, {"start": 758.07, "end": 758.75, "text": "陆徐"}, {"start": 758.75, "end": 759.63, "text": "大都督"}, {"start": 759.63, "end": 761.19, "text": "主公亲自来大营靠军"}, {"start": 761.19, "end": 762.59, "text": "王驾离此不到吴岭"}, {"start": 764.23, "end": 765.03, "text": "陆徐"}, {"start": 765.03, "end": 766.51, "text": "你还不快去进驾"}, {"start": 766.51, "end": 767.27, "text": "陆徐"}, {"start": 768.23, "end": 769.51, "text": "大都督"}, {"start": 769.51, "end": 770.27, "text": "大都督"}, {"start": 770.59, "end": 771.75, "text": "还是接驾吧"}, {"start": 773.51, "end": 774.35, "text": "陆徐"}, {"start": 774.35, "end": 775.99, "text": "乖乖去接驾吧"}, {"start": 781.31, "end": 782.03, "text": "拉出去"}, {"start": 782.03, "end": 782.83, "text": "斩了"}, {"start": 782.83, "end": 783.39, "text": "遵命"}, {"start": 783.87, "end": 785.15, "text": "陆徐"}, {"start": 785.15, "end": 785.63, "text": "你"}, {"start": 794.93, "end": 795.77, "text": "大都督"}, {"start": 795.77, "end": 796.69, "text": "傅俊服法了"}, {"start": 822.72, "end": 823.72, "text": "末将陆徐"}, {"start": 824.56, "end": 825.88, "text": "拜见主公"}, {"start": 825.88, "end": 827.28, "text": "拜见主公"}, {"start": 827.92, "end": 828.6, "text": "霍言"}, {"start": 828.6, "end": 829.48, "text": "快一快请起"}, {"start": 830.48, "end": 831.8, "text": "谢主公"}, {"start": 832.32, "end": 833.28, "text": "霍言"}, {"start": 833.28, "end": 835.4, "text": "当了几个月的大都督"}, {"start": 835.4, "end": 836.84, "text": "瘦了不少啊"}, {"start": 838.24, "end": 839.28, "text": "姑"}, {"start": 839.28, "end": 840.28, "text": "想念你们"}, {"start": 841.44, "end": 844.08, "text": "趁巡查荆州之际"}, {"start": 844.08, "end": 846.32, "text": "可以弯过来靠军"}, {"start": 846.32, "end": 846.92, "text": "走"}, {"start": 846.92, "end": 847.84, "text": "进账说话"}, {"start": 878.48, "end": 879.52, "text": "列为将士"}, {"start": 880.36, "end": 881.76, "text": "与五倍敌军"}, {"start": 882.84, "end": 884.88, "text": "周旋两月有余"}, {"start": 884.88, "end": 885.72, "text": "是敌"}, {"start": 886.6, "end": 887.68, "text": "寸步能进"}, {"start": 889.77, "end": 891.97, "text": "大挫刘备焦狂之气"}, {"start": 892.81, "end": 893.69, "text": "大展"}, {"start": 893.69, "end": 895.33, "text": "我东吴之军威"}, {"start": 896.29, "end": 896.89, "text": "姑"}, {"start": 897.49, "end": 898.69, "text": "本职之后"}, {"start": 899.89, "end": 901.21, "text": "喜不自禁哪"}, {"start": 901.81, "end": 903.25, "text": "多谢主公厚爱"}, {"start": 905.4, "end": 906.4, "text": "这些赏赐"}, {"start": 907.36, "end": 909.44, "text": "应该全部分给三军将士"}, {"start": 911.62, "end": 912.38, "text": "只是"}, {"start": 914.06, "end": 915.94, "text": "末将非但不该领赏"}, {"start": 917.06, "end": 918.62, "text": "还请主公赐罪"}, {"start": 921.62, "end": 922.58, "text": "为何"}, {"start": 922.58, "end": 923.86, "text": "末将将傅俊"}, {"start": 925.18, "end": 926.38, "text": "斩首正法了"}, {"start": 933.48, "end": 934.36, "text": "说实话"}, {"start": 935.24, "end": 936.88, "text": "姑在进园门的时候"}, {"start": 938.24, "end": 958.3, "text": "看见傅俊的头"}, {"start": 958.54, "end": 959.58, "text": "列为将军"}, {"start": 960.42, "end": 961.58, "text": "你们知道姑"}, {"start": 962.54, "end": 963.66, "text": "是怎么想的吗"}, {"start": 963.66, "end": 973.09, "text": "如果陆迅贪望法"}, {"start": 973.09, "end": 974.37, "text": "不斩傅俊的话"}, {"start": 974.93, "end": 976.33, "text": "那过不了多久"}, {"start": 976.33, "end": 977.37, "text": "我孙权的人头"}, {"start": 977.37, "end": 978.65, "text": "就会被刘备斩下"}, {"start": 978.65, "end": 980.21, "text": "挂在建业的城楼上"}, {"start": 981.13, "end": 982.21, "text": "主公"}, {"start": 983.33, "end": 983.97, "text": "陆迅"}, {"start": 984.57, "end": 986.17, "text": "你不是不要赏赐吗"}, {"start": 986.89, "end": 987.53, "text": "好"}, {"start": 988.09, "end": 989.97, "text": "我再交给你另外一些东西"}, {"start": 990.57, "end": 991.25, "text": "来呀"}, {"start": 992.05, "end": 992.93, "text": "抬上来"}, {"start": 992.93, "end": 993.53, "text": "喏"}, {"start": 1010.07, "end": 1010.79, "text": "陆迅"}, {"start": 1011.79, "end": 1013.47, "text": "这是你继任大都督以来"}, {"start": 1015.14, "end": 1016.62, "text": "所有朝中老臣"}, {"start": 1017.62, "end": 1019.14, "text": "要替换你的奏章"}, {"start": 1020.58, "end": 1021.3, "text": "今天"}, {"start": 1022.14, "end": 1022.9, "text": "我把他"}, {"start": 1023.18, "end": 1024.3, "text": "一并交给你"}, {"start": 1062.14, "end": 1063.46, "text": "我陆迅发誓"}, {"start": 1065.59, "end": 1067.51, "text": "一定会还主公一把火"}, {"start": 1069.45, "end": 1071.93, "text": "一把天崩地裂的胜利之火"}, {"start": 1080.17, "end": 1080.77, "text": "陛下"}, {"start": 1081.61, "end": 1082.53, "text": "细作探报"}, {"start": 1083.05, "end": 1083.69, "text": "陆迅斩了"}, {"start": 1083.69, "end": 1085.25, "text": "擅自出战的傅俊之后"}, {"start": 1085.25, "end": 1086.21, "text": "制下严令"}, {"start": 1086.73, "end": 1088.77, "text": "吴军便兼并不出"}, {"start": 1088.77, "end": 1089.77, "text": "拒险而守"}, {"start": 1090.73, "end": 1091.41, "text": "现在"}, {"start": 1091.85, "end": 1093.61, "text": "无论我不将士怎么叫骂"}, {"start": 1094.49, "end": 1096.25, "text": "吴军再也不肯出来接战了"}, {"start": 1100.25, "end": 1101.13, "text": "陆迅"}, {"start": 1102.61, "end": 1104.41, "text": "自然是惧怕吴军"}, {"start": 1105.25, "end": 1106.41, "text": "但孙权"}, {"start": 1107.29, "end": 1109.13, "text": "不会容他一味避战的"}, {"start": 1110.37, "end": 1111.45, "text": "更何况"}, {"start": 1111.45, "end": 1113.61, "text": "建业城里面的文武老臣"}, {"start": 1115.05, "end": 1117.09, "text": "岂容他一败再败"}, {"start": 1117.81, "end": 1119.53, "text": "他们定会弹劾陆迅"}, {"start": 1119.81, "end": 1120.73, "text": "逼他出战"}, {"start": 1123.42, "end": 1124.38, "text": "这陆迅"}, {"start": 1126.8, "end": 1128.56, "text": "是在等待战机呀"}, {"start": 1130.86, "end": 1131.62, "text": "禀陛下"}, {"start": 1132.5, "end": 1134.58, "text": "我军久居战地"}, {"start": 1134.86, "end": 1135.78, "text": "水土不适"}, {"start": 1136.7, "end": 1137.98, "text": "眼下天已入树"}, {"start": 1137.98, "end": 1139.02, "text": "酷热难挡"}, {"start": 1139.5, "end": 1141.7, "text": "军营中水源也已干涸了"}, {"start": 1142.02, "end": 1143.98, "text": "将士们不得不取乌水为食"}, {"start": 1144.78, "end": 1146.5, "text": "致使疫病流行"}, {"start": 1146.94, "end": 1147.54, "text": "臣"}, {"start": 1148.02, "end": 1149.7, "text": "昨日前去营中视察"}, {"start": 1150.22, "end": 1152.78, "text": "看到前少士兵染病甚多"}, {"start": 1153.14, "end": 1155.86, "text": "十厅中竟然病到三厅"}, {"start": 1156.58, "end": 1157.34, "text": "臣想"}, {"start": 1158.46, "end": 1159.18, "text": "可否"}, {"start": 1159.82, "end": 1162.46, "text": "让三军轮番退入紫归城中"}, {"start": 1163.58, "end": 1165.46, "text": "让将士们休整几时日"}, {"start": 1165.9, "end": 1167.9, "text": "等秋后再继续出战"}, {"start": 1173.07, "end": 1174.11, "text": "都有此意"}, {"start": 1176.4, "end": 1178.44, "text": "将士们若能休整一下"}, {"start": 1178.88, "end": 1180.8, "text": "定然会精神倍增"}, {"start": 1181.2, "end": 1182.16, "text": "斗志更盛"}, {"start": 1186.83, "end": 1187.95, "text": "有经沙场"}, {"start": 1189.07, "end": 1190.67, "text": "深知用兵之道"}, {"start": 1191.79, "end": 1193.11, "text": "此时此刻"}, {"start": 1193.83, "end": 1195.59, "text": "兵马若后退半步"}, {"start": 1195.59, "end": 1198.32, "text": "气便泄了"}, {"start": 1200.52, "end": 1202.64, "text": "如果你们觉得苦数难当"}, {"start": 1203.44, "end": 1205.84, "text": "那么吴军定然也会觉得"}, {"start": 1205.84, "end": 1206.76, "text": "苦数难当"}, {"start": 1206.76, "end": 1209.84, "text": "都在熬"}, {"start": 1210.96, "end": 1212.8, "text": "就看谁熬得过谁"}, {"start": 1214.2, "end": 1214.88, "text": "传命"}, {"start": 1216.36, "end": 1217.88, "text": "三军断不可退"}, {"start": 1218.96, "end": 1221.84, "text": "只需把营寨迁入山林茂盛处"}, {"start": 1222.52, "end": 1224.24, "text": "依稀伴水驻场"}, {"start": 1224.72, "end": 1225.92, "text": "待秋凉时"}, {"start": 1226.28, "end": 1227.48, "text": "兵力紧闭"}, {"start": 1229.34, "end": 1230.26, "text": "遵命"}, {"start": 1233.38, "end": 1234.02, "text": "陛下"}, {"start": 1234.82, "end": 1237.62, "text": "眼下战局已成焦灼之势"}, {"start": 1238.06, "end": 1241.7, "text": "臣可否把双方营寨化成图本"}, {"start": 1241.98, "end": 1244.02, "text": "送成丞相遗约"}, {"start": 1244.38, "end": 1246.42, "text": "看看丞相有无两策"}, {"start": 1249.33, "end": 1251.61, "text": "莫非朕不知兵吗"}, {"start": 1256.22, "end": 1257.78, "text": "书信图本相送"}, {"start": 1258.06, "end": 1259.46, "text": "来往太过繁琐"}, {"start": 1260.22, "end": 1260.94, "text": "不必了"}, {"start": 1262.42, "end": 1263.26, "text": "古人云"}, {"start": 1263.46, "end": 1264.5, "text": "监听则明"}, {"start": 1264.58, "end": 1265.62, "text": "偏听则暗"}, {"start": 1266.58, "end": 1268.82, "text": "陛下乃圣君也"}, {"start": 1269.06, "end": 1271.14, "text": "定能博彩重昌"}, {"start": 1274.59, "end": 1275.79, "text": "你再去阵营"}, {"start": 1276.63, "end": 1279.87, "text": "将敌我阵势化成四至八道图本"}, {"start": 1280.51, "end": 1282.31, "text": "前往西川问问孔明"}, {"start": 1282.99, "end": 1284.35, "text": "若有不便之处"}, {"start": 1284.75, "end": 1285.75, "text": "速来报我"}, {"start": 1286.15, "end": 1288.27, "text": "臣领旨"}, {"start": 1307.46, "end": 1308.1, "text": "大多多"}, {"start": 1308.42, "end": 1309.42, "text": "守军不带库属"}, {"start": 1309.54, "end": 1310.78, "text": "都已在林中扎营了"}, {"start": 1311.06, "end": 1311.94, "text": "总横数百里"}, {"start": 1311.94, "end": 1312.98, "text": "共有四十余吞"}, {"start": 1315.22, "end": 1316.46, "text": "查清楚了吗"}, {"start": 1317.46, "end": 1318.82, "text": "是部分仪应"}, {"start": 1319.18, "end": 1323.02, "text": "末将看清楚了"}, {"start": 1323.18, "end": 1324.26, "text": "守军全部仪应"}, {"start": 1324.58, "end": 1325.9, "text": "就连刘备的中军龙杖"}, {"start": 1326.06, "end": 1327.14, "text": "也已进入林中"}, {"start": 1327.54, "end": 1330.46, "text": "他们是想在秋凉后作战"}, {"start": 1330.66, "end": 1351.9, "text": "主军必败了"}, {"start": 1352.1, "end": 1367.29, "text": "两个月前"}, {"start": 1368.01, "end": 1369.85, "text": "我跟诸位将军说"}, {"start": 1370.69, "end": 1374.09, "text": "我会有三十万大军从天而降"}, {"start": 1374.25, "end": 1375.25, "text": "你们不信"}, {"start": 1376.93, "end": 1378.41, "text": "现在我告诉你们"}, {"start": 1379.93, "end": 1382.77, "text": "我的三十万大军已经到了"}, {"start": 1384.25, "end": 1385.05, "text": "到了"}, {"start": 1387.98, "end": 1389.66, "text": "你们不必动张细娃"}, {"start": 1391.9, "end": 1394.22, "text": "我所指的三十万大军"}, {"start": 1395.34, "end": 1397.66, "text": "就是现在的库属"}, {"start": 1397.66, "end": 1399.22, "text": "义病和瘴气"}, {"start": 1400.58, "end": 1401.66, "text": "入府以来"}, {"start": 1401.86, "end": 1403.42, "text": "属军中十庭"}, {"start": 1403.42, "end": 1405.3, "text": "已然病倒了三庭"}, {"start": 1406.02, "end": 1407.06, "text": "即便未病者"}, {"start": 1407.06, "end": 1408.26, "text": "也是士气低落"}, {"start": 1409.66, "end": 1411.1, "text": "属军耗损如此"}, {"start": 1412.46, "end": 1414.02, "text": "岂不等于是上天"}, {"start": 1414.38, "end": 1416.42, "text": "赐给我们三十万大军吗"}, {"start": 1417.82, "end": 1418.54, "text": "是"}, {"start": 1418.54, "end": 1419.7, "text": "七十万属军"}, {"start": 1419.82, "end": 1420.7, "text": "转眼之间"}, {"start": 1420.7, "end": 1422.74, "text": "就变成七十万条病虫了呀"}, {"start": 1427.06, "end": 1428.82, "text": "何止是病虫啊"}, {"start": 1431.26, "end": 1432.3, "text": "六位将军"}, {"start": 1433.94, "end": 1435.98, "text": "亲看眼前这片山林"}, {"start": 1436.82, "end": 1438.06, "text": "它就像是"}, {"start": 1439.02, "end": 1441.74, "text": "一只堆满干柴的火炉子"}, {"start": 1443.64, "end": 1445.36, "text": "只需要一把火"}, {"start": 1447.19, "end": 1449.59, "text": "刘备和他的七十万大军"}, {"start": 1450.55, "end": 1452.75, "text": "就将死无葬身之地"}, {"start": 1453.87, "end": 1454.51, "text": "大都督"}, {"start": 1454.75, "end": 1455.91, "text": "你说是用火弓"}, {"start": 1458.62, "end": 1459.38, "text": "正是"}, {"start": 1460.5, "end": 1461.82, "text": "昔日周瑜"}, {"start": 1462.06, "end": 1463.7, "text": "赤壁一把火"}, {"start": 1464.3, "end": 1466.7, "text": "烧得草草片甲不留"}, {"start": 1468.3, "end": 1469.66, "text": "我们今日之火"}, {"start": 1470.78, "end": 1473.86, "text": "要烧得比赤壁之火更加猛烈"}, {"start": 1475.26, "end": 1477.98, "text": "定是刘备和他的七十万大军"}, {"start": 1478.58, "end": 1479.82, "text": "灰飞烟灭"}, {"start": 1485.6, "end": 1486.32, "text": "我大军"}, {"start": 1487.2, "end": 1488.6, "text": "以夷营夹脚"}, {"start": 1489.92, "end": 1491.52, "text": "横七百余里"}, {"start": 1492.4, "end": 1494.0, "text": "扎住四十余吞"}, {"start": 1494.68, "end": 1496.52, "text": "皆依稀绑箭"}, {"start": 1496.52, "end": 1498.2, "text": "拘于临沐茂盛之处"}, {"start": 1500.64, "end": 1501.52, "text": "怎么了 丞相"}, {"start": 1501.76, "end": 1505.11, "text": "何人哪"}, {"start": 1506.15, "end": 1508.83, "text": "何人叫陛下如此下债啊"}, {"start": 1509.07, "end": 1510.43, "text": "此人不是祸害"}, {"start": 1510.43, "end": 1512.87, "text": "便是奸贼当力斩此人哪"}, {"start": 1512.95, "end": 1513.47, "text": "这这"}, {"start": 1514.71, "end": 1515.39, "text": "丞相啊"}, {"start": 1516.43, "end": 1517.71, "text": "关于夷营的事"}, {"start": 1518.59, "end": 1520.39, "text": "全是陛下圣意独断"}, {"start": 1520.99, "end": 1522.39, "text": "绝无他人所谋啊"}, {"start": 1522.79, "end": 1530.92, "text": "不缘其休矣啊"}, {"start": 1531.0, "end": 1531.52, "text": "为何"}, {"start": 1534.25, "end": 1537.13, "text": "包园习祖厨劫营扎寨"}, {"start": 1537.57, "end": 1540.05, "text": "自古乃兵家大计"}, {"start": 1541.05, "end": 1542.65, "text": "陆迅如用火弓"}, {"start": 1542.89, "end": 1544.45, "text": "如何解救啊"}, {"start": 1550.36, "end": 1552.04, "text": "处处山林茂密"}, {"start": 1552.6, "end": 1555.24, "text": "我七十万大军都进了林子"}, {"start": 1555.68, "end": 1557.6, "text": "虽可遮蔽枯树"}, {"start": 1557.88, "end": 1559.88, "text": "但容易引发大火呀"}, {"start": 1563.37, "end": 1566.77, "text": "岂有连营七百里可拒敌的吗"}, {"start": 1567.29, "end": 1568.49, "text": "这一旦火起"}, {"start": 1568.49, "end": 1569.61, "text": "七百里连营"}, {"start": 1569.61, "end": 1572.01, "text": "就是七百里的火喷哪"}, {"start": 1572.29, "end": 1575.87, "text": "明白了"}, {"start": 1575.87, "end": 1580.51, "text": "可坚守不出"}, {"start": 1580.95, "end": 1586.14, "text": "正是为此啊"}, {"start": 1586.3, "end": 1586.98, "text": "马良"}, {"start": 1588.42, "end": 1589.98, "text": "你行夜返回萧廷"}, {"start": 1589.98, "end": 1590.98, "text": "觐见陛下"}, {"start": 1591.22, "end": 1593.34, "text": "告诉他立刻转移空旷处"}, {"start": 1593.86, "end": 1594.62, "text": "迟者"}, {"start": 1595.02, "end": 1596.34, "text": "断然无酒"}, {"start": 1599.5, "end": 1600.1, "text": "丞相"}, {"start": 1600.78, "end": 1601.46, "text": "你说"}, {"start": 1601.9, "end": 1603.94, "text": "从成都到萧廷最快"}, {"start": 1604.94, "end": 1606.5, "text": "也要五天五夜呀"}, {"start": 1607.22, "end": 1608.9, "text": "万一已经发生不测"}, {"start": 1609.18, "end": 1612.15, "text": "如何是好啊"}, {"start": 1612.43, "end": 1620.9, "text": "大火已经烧起来了"}, {"start": 1621.02, "end": 1627.51, "text": "我们二十多年积攒的兵马"}, {"start": 1627.51, "end": 1629.31, "text": "就要毁于一旦了"}, {"start": 1634.97, "end": 1636.17, "text": "马良你听着"}, {"start": 1637.57, "end": 1639.45, "text": "待你赶到萧廷时"}, {"start": 1639.93, "end": 1641.73, "text": "如果吴军已经破营"}, {"start": 1641.97, "end": 1643.73, "text": "你和将领们护着陛下"}, {"start": 1644.09, "end": 1646.33, "text": "今往川东白地城避难"}, {"start": 1646.61, "end": 1648.85, "text": "那里地势险峻 粮草足备"}, {"start": 1649.09, "end": 1650.85, "text": "可保陛下无虞"}, {"start": 1651.25, "end": 1651.93, "text": "丞相"}, {"start": 1652.57, "end": 1654.89, "text": "万一吴军追杀不舍"}, {"start": 1655.25, "end": 1655.85, "text": "不妨"}, {"start": 1656.81, "end": 1658.21, "text": "我在余府府一带"}, {"start": 1658.21, "end": 1659.69, "text": "布下十万夫君"}, {"start": 1660.05, "end": 1662.17, "text": "陆迅断不敢追杀"}, {"start": 1663.33, "end": 1666.29, "text": "我来成都路过余府府"}, {"start": 1667.09, "end": 1669.01, "text": "那里是空空如也"}, {"start": 1669.33, "end": 1671.05, "text": "未曾见到任何伏兵啊"}, {"start": 1672.13, "end": 1674.25, "text": "不当有时自然没有"}, {"start": 1675.09, "end": 1677.33, "text": "当有时自然会有"}, {"start": 1679.05, "end": 1680.09, "text": "不必多问了"}, {"start": 1680.25, "end": 1682.17, "text": "行业返回萧廷去吧"}, {"start": 1682.73, "end": 1683.21, "text": "好"}, {"start": 1683.97, "end": 1684.85, "text": "我这就出发"}, {"start": 1729.39, "end": 1730.67, "text": "陛下 陛下"}, {"start": 1731.43, "end": 1732.63, "text": "快起来用药吧"}, {"start": 1734.47, "end": 1735.15, "text": "陛下"}, {"start": 1736.47, "end": 1737.79, "text": "奴才马上换太医来"}, {"start": 1738.03, "end": 1750.29, "text": "医里看过了"}, {"start": 1755.49, "end": 1757.21, "text": "年少时得的顾疾"}, {"start": 1758.41, "end": 1759.69, "text": "是好是坏"}, {"start": 1770.09, "end": 1770.73, "text": "陛下"}, {"start": 1771.29, "end": 1772.13, "text": "请用吧"}, {"start": 1772.41, "end": 1793.15, "text": "不让任何人"}, {"start": 1793.15, "end": 1825.18, "text": "司马仪请求见驾"}, {"start": 1825.5, "end": 1830.38, "text": "陛下口谕"}, {"start": 1830.78, "end": 1832.54, "text": "请司马大人入鉴"}, {"start": 1848.28, "end": 1848.96, "text": "仲达啊"}, {"start": 1849.52, "end": 1850.24, "text": "何事啊"}, {"start": 1850.64, "end": 1852.6, "text": "竟然连朕上朝都等不及了"}, {"start": 1865.72, "end": 1866.6, "text": "禀陛下"}, {"start": 1867.32, "end": 1870.12, "text": "我军少纪已萧廷前线探知"}, {"start": 1871.16, "end": 1872.32, "text": "法武蜀军"}, {"start": 1872.72, "end": 1873.72, "text": "库蜀难耐"}, {"start": 1875.54, "end": 1878.22, "text": "全部移入山林中驻扎"}, {"start": 1879.42, "end": 1880.82, "text": "总横七百余里"}, {"start": 1881.26, "end": 1882.62, "text": "扎营四十余吨"}, {"start": 1888.33, "end": 1889.21, "text": "这又如何"}, {"start": 1889.65, "end": 1909.25, "text": "这是败兵者"}, {"start": 1909.25, "end": 1911.29, "text": "总横七百余里拒敌的"}, {"start": 1911.93, "end": 1912.57, "text": "七三"}, {"start": 1913.37, "end": 1914.45, "text": "库蜀当头"}, {"start": 1915.69, "end": 1916.73, "text": "林沐易燃"}, {"start": 1917.41, "end": 1918.81, "text": "陆迅若用火攻"}, {"start": 1919.17, "end": 1921.21, "text": "刘备死无葬身之地"}, {"start": 1930.95, "end": 1931.95, "text": "记得当初"}, {"start": 1932.59, "end": 1934.19, "text": "在刘备东征之初"}, {"start": 1935.11, "end": 1936.07, "text": "你曾经断言"}, {"start": 1937.59, "end": 1938.87, "text": "说陆迅"}, {"start": 1939.75, "end": 1941.31, "text": "绝不是刘备的对手"}, {"start": 1941.99, "end": 1942.59, "text": "此意"}, {"start": 1943.27, "end": 1944.51, "text": "蜀军必胜"}, {"start": 1945.51, "end": 1946.99, "text": "吴军必败啊"}, {"start": 1947.11, "end": 1959.71, "text": "吴备清国初一万万没料到"}, {"start": 1960.31, "end": 1961.79, "text": "陆迅竟然会有"}, {"start": 1962.23, "end": 1963.23, "text": "这般阴谋"}, {"start": 1964.39, "end": 1966.39, "text": "他数月间屡屡败战"}, {"start": 1967.35, "end": 1968.91, "text": "继而坚守不战"}, {"start": 1970.03, "end": 1970.99, "text": "原来这是他的"}, {"start": 1971.23, "end": 1972.23, "text": "交兵吃鸡"}, {"start": 1972.51, "end": 1973.19, "text": "其目的"}, {"start": 1973.83, "end": 1975.23, "text": "就是要等待刘备"}, {"start": 1975.59, "end": 1976.91, "text": "失老兵癖"}, {"start": 1977.91, "end": 1979.75, "text": "最后欲以致命一击"}, {"start": 1980.39, "end": 1981.83, "text": "臣昏庸短实"}, {"start": 1982.59, "end": 1983.75, "text": "误导了陛下"}, {"start": 1984.79, "end": 1985.55, "text": "臣请罪"}, {"start": 1987.66, "end": 1988.26, "text": "罢了"}, {"start": 1989.58, "end": 1991.1, "text": "不只是李小看了陆迅"}, {"start": 1992.22, "end": 1993.62, "text": "朕当初也以为"}, {"start": 1993.94, "end": 1995.3, "text": "刘备必胜嘛"}, {"start": 1995.62, "end": 2001.93, "text": "依现在的情形"}, {"start": 2003.01, "end": 2006.09, "text": "吴军大败蜀军之后"}, {"start": 2006.41, "end": 2010.68, "text": "该当如何呢"}, {"start": 2010.68, "end": 2020.09, "text": "吴迅战败刘备后"}, {"start": 2021.33, "end": 2022.57, "text": "当乘胜晋军"}, {"start": 2023.01, "end": 2024.61, "text": "挥师直取成都"}, {"start": 2025.49, "end": 2026.01, "text": "不错"}, {"start": 2026.57, "end": 2029.66, "text": "森泉梦寐以求"}, {"start": 2029.66, "end": 2031.46, "text": "想得到川蜀之力呀"}, {"start": 2031.7, "end": 2040.28, "text": "我敢请陛下"}, {"start": 2040.28, "end": 2041.88, "text": "赐予臣二十万军"}, {"start": 2042.32, "end": 2044.28, "text": "待陆迅大军西撤后"}, {"start": 2044.28, "end": 2045.76, "text": "臣率军断旗后"}, {"start": 2045.76, "end": 2047.36, "text": "挥师直取青香"}, {"start": 2048.24, "end": 2049.12, "text": "如不胜"}, {"start": 2049.6, "end": 2050.96, "text": "臣甘当军法"}, {"start": 2051.24, "end": 2059.98, "text": "要亲自率军征古"}, {"start": 2060.5, "end": 2062.18, "text": "臣必胜最大的心愿"}, {"start": 2062.78, "end": 2063.86, "text": "就是能为陛下"}, {"start": 2063.86, "end": 2064.86, "text": "沙场建功"}, {"start": 2065.78, "end": 2069.41, "text": "先生啊"}, {"start": 2069.65, "end": 2070.49, "text": "朕相信"}, {"start": 2073.71, "end": 2075.67, "text": "你如果亲自出征的话"}, {"start": 2077.03, "end": 2077.99, "text": "必定是"}, {"start": 2078.23, "end": 2079.47, "text": "大胜无疑啊"}, {"start": 2080.63, "end": 2081.51, "text": "谢陛下"}, {"start": 2081.83, "end": 2082.47, "text": "是"}, {"start": 2085.35, "end": 2085.91, "text": "朕"}, {"start": 2087.99, "end": 2090.74, "text": "离不开你呀"}, {"start": 2090.74, "end": 2092.22, "text": "朕更想留你在身边"}, {"start": 2092.54, "end": 2095.02, "text": "帮助朕运筹帷幄呀"}, {"start": 2096.62, "end": 2098.74, "text": "至于领军出征等事"}, {"start": 2098.98, "end": 2104.69, "text": "还是交给为将者去吧"}, {"start": 2106.01, "end": 2106.73, "text": "朕意"}, {"start": 2107.21, "end": 2119.23, "text": "拜曹仁为大将军"}, {"start": 2119.71, "end": 2120.91, "text": "率军十万"}, {"start": 2121.55, "end": 2122.59, "text": "出如须"}, {"start": 2123.35, "end": 2125.03, "text": "曹修为左将军"}, {"start": 2125.27, "end": 2126.43, "text": "率军五万"}, {"start": 2126.67, "end": 2127.47, "text": "出洞口"}, {"start": 2127.95, "end": 2129.79, "text": "曹臣为右将军"}, {"start": 2129.79, "end": 2130.91, "text": "率军五万"}, {"start": 2130.91, "end": 2131.99, "text": "出南郡"}, {"start": 2132.03, "end": 2132.71, "text": "三军"}, {"start": 2132.95, "end": 2134.59, "text": "接奉曹仁之号令"}, {"start": 2134.79, "end": 2135.55, "text": "俺遵旨"}, {"start": 2135.75, "end": 2136.99, "text": "何事啊 长官"}, {"start": 2136.99, "end": 2153.48, "text": "朝中传言"}, {"start": 2188.4, "end": 2193.88, "text": "说父亲"}, {"start": 2194.4, "end": 2196.04, "text": "今日被陛下斥责了"}, {"start": 2198.2, "end": 2199.68, "text": "传得真快"}, {"start": 2201.32, "end": 2202.48, "text": "莫非是真的"}, {"start": 2203.64, "end": 2204.6, "text": "不瞒你"}, {"start": 2204.84, "end": 2205.84, "text": "是真的"}, {"start": 2206.04, "end": 2210.38, "text": "我原以为刘备出军"}, {"start": 2210.66, "end": 2212.18, "text": "蜀军必胜"}, {"start": 2212.42, "end": 2214.34, "text": "想到区区陆迅"}, {"start": 2214.7, "end": 2217.89, "text": "竟能战胜陆军"}, {"start": 2217.89, "end": 2219.57, "text": "竟能战败刘备"}, {"start": 2219.89, "end": 2225.12, "text": "刘备东中之初兵士滔天"}, {"start": 2225.12, "end": 2226.44, "text": "当时满朝文武"}, {"start": 2226.44, "end": 2227.68, "text": "甚至包括陛下"}, {"start": 2227.68, "end": 2229.2, "text": "都相信刘备必胜"}, {"start": 2230.32, "end": 2232.2, "text": "岂止是父亲判断失误了"}, {"start": 2232.2, "end": 2236.1, "text": "常之处就在这儿啊"}, {"start": 2236.98, "end": 2238.42, "text": "你好生想想"}, {"start": 2238.42, "end": 2242.88, "text": "家为何不责备别人"}, {"start": 2243.6, "end": 2246.44, "text": "反而偏偏降罪于我呢"}, {"start": 2246.68, "end": 2253.05, "text": "陛下是有意贬蚀父亲"}, {"start": 2253.45, "end": 2254.45, "text": "不错"}, {"start": 2255.37, "end": 2256.89, "text": "我入幕多年"}, {"start": 2256.93, "end": 2258.89, "text": "为陛下屡见恭讯"}, {"start": 2259.13, "end": 2261.05, "text": "虽然位居高位"}, {"start": 2262.21, "end": 2265.25, "text": "可我在朝中却是一言九鼎"}, {"start": 2265.49, "end": 2268.5, "text": "此等权威"}, {"start": 2269.14, "end": 2270.86, "text": "岂不遭人记恨"}, {"start": 2270.86, "end": 2275.98, "text": "为我不放心哪"}, {"start": 2275.98, "end": 2279.22, "text": "心最痛苦的"}, {"start": 2279.22, "end": 2281.42, "text": "不是遭陛下责备"}, {"start": 2281.42, "end": 2287.18, "text": "陛下始终提防着父亲哪"}, {"start": 2287.18, "end": 2290.76, "text": "这 这何以见得"}, {"start": 2290.76, "end": 2298.1, "text": "我向陛下请命"}, {"start": 2298.1, "end": 2299.74, "text": "要率军出征"}, {"start": 2300.38, "end": 2302.14, "text": "陛下当面拒绝"}, {"start": 2302.22, "end": 2305.1, "text": "反而派曹修 曹仁 曹真"}, {"start": 2305.1, "end": 2306.38, "text": "率军出征"}, {"start": 2307.14, "end": 2309.02, "text": "他们都是曹氏亲贵"}, {"start": 2309.02, "end": 2310.14, "text": "明白了吗"}, {"start": 2310.62, "end": 2314.3, "text": "陛下不允许我长兵"}, {"start": 2314.3, "end": 2315.46, "text": "明白了吗"}, {"start": 2315.86, "end": 2317.14, "text": "密主是所宗人"}, {"start": 2317.14, "end": 2323.53, "text": "及各处门生亲信"}, {"start": 2324.01, "end": 2325.05, "text": "从现在起"}, {"start": 2325.81, "end": 2327.13, "text": "反在朝为官者"}, {"start": 2327.13, "end": 2328.41, "text": "务须谨晓慎为"}, {"start": 2328.41, "end": 2329.89, "text": "切不可一时弄全"}, {"start": 2330.21, "end": 2331.25, "text": "反在外"}, {"start": 2331.61, "end": 2333.49, "text": "治学为礼行商者"}, {"start": 2334.13, "end": 2335.73, "text": "绝不可妄议朝政"}, {"start": 2336.45, "end": 2337.25, "text": "不错"}, {"start": 2337.25, "end": 2338.29, "text": "应该这样"}, {"start": 2338.29, "end": 2340.45, "text": "本儿大有长进哪"}, {"start": 2340.77, "end": 2344.3, "text": "外面是谁啊"}, {"start": 2345.06, "end": 2348.87, "text": "老爷"}, {"start": 2349.27, "end": 2350.27, "text": "老爷"}, {"start": 2351.19, "end": 2367.9, "text": "奴婢熬了碗羹"}, {"start": 2368.7, "end": 2369.9, "text": "你吃一些吧"}, {"start": 2369.9, "end": 2372.3, "text": "我已越来越惊到啦"}, {"start": 2372.62, "end": 2378.28, "text": "老爷若是喜欢"}, {"start": 2378.28, "end": 2381.68, "text": "以后奴婢经常熬给老爷吃"}, {"start": 2382.08, "end": 2383.48, "text": "奴婢退下了"}, {"start": 2383.48, "end": 2389.06, "text": "不必"}, {"start": 2389.06, "end": 2390.38, "text": "就坐这儿吧"}, {"start": 2390.38, "end": 2394.45, "text": "都是自家人"}, {"start": 2395.13, "end": 2396.17, "text": "净说啊"}, {"start": 2396.17, "end": 2397.17, "text": "记住"}, {"start": 2398.25, "end": 2400.77, "text": "今后我和昭儿说话"}, {"start": 2400.77, "end": 2402.33, "text": "你不必回避"}, {"start": 2402.33, "end": 2403.33, "text": "昭儿"}, {"start": 2403.33, "end": 2406.41, "text": "接着说"}]