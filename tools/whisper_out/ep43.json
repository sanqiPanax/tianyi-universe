[{"start": 24.75, "end": 25.55, "text": "丞相"}, {"start": 28.97, "end": 29.57, "text": "丞相"}, {"start": 70.48, "end": 73.88, "text": "现在把所有累赘的东西都扔了"}, {"start": 74.48, "end": 75.88, "text": "包括长兵器"}, {"start": 77.86, "end": 79.66, "text": "我们只要能回到南郡"}, {"start": 80.46, "end": 82.06, "text": "我们只要能进了城"}, {"start": 82.86, "end": 84.66, "text": "就等于打了个大胜仗"}, {"start": 86.7, "end": 87.3, "text": "这个"}, {"start": 89.2, "end": 92.97, "text": "这个旗也扔了"}, {"start": 94.57, "end": 94.97, "text": "丞相"}, {"start": 95.37, "end": 96.17, "text": "扔了"}, {"start": 99.74, "end": 100.74, "text": "不要舍不得"}, {"start": 101.54, "end": 103.54, "text": "只要我们能回到南郡"}, {"start": 104.14, "end": 104.94, "text": "之后"}, {"start": 105.74, "end": 107.54, "text": "我们能输几千百面"}, {"start": 108.14, "end": 109.54, "text": "沾新的大气"}, {"start": 111.77, "end": 112.77, "text": "扶我上马"}, {"start": 112.97, "end": 113.77, "text": "扶丞相上马"}, {"start": 121.75, "end": 122.35, "text": "小心"}, {"start": 123.95, "end": 124.35, "text": "出发"}, {"start": 124.55, "end": 139.66, "text": "禀大都督"}, {"start": 139.86, "end": 141.66, "text": "城土将军杀敌五万"}, {"start": 141.66, "end": 143.66, "text": "缴获战马三千多匹啊"}, {"start": 143.86, "end": 145.06, "text": "好"}, {"start": 147.09, "end": 147.89, "text": "禀大都督"}, {"start": 148.09, "end": 150.09, "text": "领统将军班氏回营了"}, {"start": 150.49, "end": 152.09, "text": "该营斩首七千"}, {"start": 152.29, "end": 154.49, "text": "缴获兵器粮草无数"}, {"start": 161.74, "end": 163.14, "text": "先主公孙階孙策"}, {"start": 163.34, "end": 164.34, "text": "虽征战多年"}, {"start": 164.74, "end": 166.54, "text": "也未取得如此辉煌战功"}, {"start": 167.34, "end": 169.34, "text": "大都督更加英雄了得"}, {"start": 170.34, "end": 172.34, "text": "大都督堪称雄势古今"}, {"start": 173.14, "end": 174.34, "text": "空前绝后啊"}, {"start": 174.54, "end": 174.94, "text": "是啊"}, {"start": 174.94, "end": 175.54, "text": "是啊"}, {"start": 175.54, "end": 176.34, "text": "是啊"}, {"start": 176.34, "end": 176.94, "text": "来"}, {"start": 178.54, "end": 180.74, "text": "区区小胜你们便如此轻薄"}, {"start": 181.54, "end": 182.14, "text": "此意"}, {"start": 182.34, "end": 184.74, "text": "如果不是少主公决意抗曹"}, {"start": 185.54, "end": 187.54, "text": "并且运筹帷幄权力支持"}, {"start": 188.14, "end": 189.34, "text": "我等岂能取胜"}, {"start": 190.34, "end": 191.34, "text": "都督说得是"}, {"start": 191.34, "end": 192.34, "text": "都督说得是"}, {"start": 192.54, "end": 200.86, "text": "主公驾到"}, {"start": 202.46, "end": 203.06, "text": "主公"}, {"start": 203.26, "end": 204.46, "text": "拜见主公"}, {"start": 206.26, "end": 207.46, "text": "在下拜见主公"}, {"start": 207.86, "end": 208.86, "text": "甲州在身"}, {"start": 208.86, "end": 210.26, "text": "恕不能行君臣之礼"}, {"start": 210.46, "end": 212.06, "text": "拜见主公"}, {"start": 215.04, "end": 216.24, "text": "列伪将军辛苦了"}, {"start": 217.44, "end": 218.04, "text": "此意"}, {"start": 218.24, "end": 220.04, "text": "在恭谨都督率领之下"}, {"start": 220.24, "end": 221.44, "text": "我们大败曹军"}, {"start": 221.84, "end": 223.44, "text": "创我历史从未有过的"}, {"start": 223.44, "end": 224.44, "text": "矿石殊荣"}, {"start": 225.04, "end": 227.24, "text": "我既为之喜又为之贺"}, {"start": 227.64, "end": 229.04, "text": "傅兄在天之灵"}, {"start": 229.84, "end": 231.04, "text": "也深感欣慰啊"}, {"start": 232.04, "end": 233.44, "text": "谢主公"}, {"start": 233.44, "end": 234.24, "text": "主公里面请"}, {"start": 245.57, "end": 246.17, "text": "恭谨"}, {"start": 246.77, "end": 247.97, "text": "可有曹操的消息"}, {"start": 248.57, "end": 249.17, "text": "据报"}, {"start": 249.37, "end": 250.37, "text": "曹操大败之后"}, {"start": 250.37, "end": 252.37, "text": "只算数十计逃往华融道"}, {"start": 253.37, "end": 254.57, "text": "如果不出我所料"}, {"start": 254.77, "end": 255.77, "text": "此事应该落入"}, {"start": 255.77, "end": 256.77, "text": "诸葛亮的埋伏了"}, {"start": 257.97, "end": 260.17, "text": "为何我军要让曹操漏我儿头"}, {"start": 263.6, "end": 264.4, "text": "不是漏我"}, {"start": 264.8, "end": 265.8, "text": "是我有意让他"}, {"start": 265.8, "end": 266.8, "text": "落入刘备手里"}, {"start": 268.0, "end": 268.6, "text": "因为"}, {"start": 269.4, "end": 271.0, "text": "让曹操死于刘备之手"}, {"start": 271.2, "end": 272.2, "text": "更有利于我们"}, {"start": 274.39, "end": 274.99, "text": "高明"}, {"start": 275.79, "end": 276.79, "text": "恭谨之事"}, {"start": 276.99, "end": 278.59, "text": "远胜于孔明啊"}, {"start": 281.23, "end": 282.23, "text": "紫禁你来得正好"}, {"start": 282.63, "end": 284.03, "text": "我正想劳你走一趟"}, {"start": 285.23, "end": 286.83, "text": "大都督有何差事啊"}, {"start": 287.83, "end": 288.63, "text": "探营"}, {"start": 289.43, "end": 291.43, "text": "请你前往下口刘备军中"}, {"start": 291.43, "end": 292.83, "text": "看看他们拿下曹操明"}, {"start": 293.23, "end": 294.03, "text": "顺便打探一下"}, {"start": 294.03, "end": 295.63, "text": "他们下一步有何动作"}, {"start": 301.47, "end": 302.27, "text": "遵命"}, {"start": 306.06, "end": 306.66, "text": "恭谨"}, {"start": 307.66, "end": 310.26, "text": "连我都能猜破诸葛亮的用心"}, {"start": 311.26, "end": 312.46, "text": "你却猜不破"}, {"start": 314.46, "end": 315.66, "text": "请主公示向"}, {"start": 318.37, "end": 319.17, "text": "荆州"}, {"start": 320.37, "end": 321.37, "text": "他们想趁胜"}, {"start": 322.17, "end": 323.37, "text": "夺取荆州"}, {"start": 338.82, "end": 339.42, "text": "来人"}, {"start": 342.54, "end": 343.74, "text": "主公有何吩咐"}, {"start": 343.74, "end": 345.14, "text": "华融道有消息吗"}, {"start": 345.14, "end": 346.34, "text": "回主公话没有"}, {"start": 347.74, "end": 348.34, "text": "下去吧"}, {"start": 348.74, "end": 349.14, "text": "诺"}, {"start": 356.03, "end": 357.43, "text": "主公是惦记关羽"}, {"start": 358.03, "end": 359.43, "text": "还是惦记曹操"}, {"start": 365.08, "end": 366.28, "text": "当然是关羽啊"}, {"start": 367.28, "end": 368.88, "text": "一德和子龙都回来了"}, {"start": 369.28, "end": 370.88, "text": "只是关羽没有消息"}, {"start": 371.08, "end": 376.14, "text": "我听说曹操带着残兵"}, {"start": 376.34, "end": 377.54, "text": "逃往华融道"}, {"start": 378.14, "end": 379.74, "text": "云长急重意气"}, {"start": 380.74, "end": 382.14, "text": "虽然立了军令状"}, {"start": 382.54, "end": 385.31, "text": "我还是担心"}, {"start": 385.71, "end": 387.11, "text": "主公心里着急"}, {"start": 388.51, "end": 390.71, "text": "只怕有人比主公还要急"}, {"start": 391.31, "end": 392.11, "text": "谁啊"}, {"start": 392.51, "end": 394.56, "text": "东边"}, {"start": 394.96, "end": 405.26, "text": "主公"}, {"start": 405.46, "end": 406.66, "text": "鲁苏大人过江来了"}, {"start": 408.26, "end": 409.86, "text": "我原以为东吴要过两三天"}, {"start": 409.86, "end": 410.66, "text": "才会来人"}, {"start": 410.66, "end": 412.46, "text": "没想到宫井如此急不可耐"}, {"start": 413.46, "end": 414.66, "text": "没办法了主公"}, {"start": 415.26, "end": 417.46, "text": "咱们白酒迎客吧"}, {"start": 419.06, "end": 419.86, "text": "紫敬啊"}, {"start": 420.66, "end": 421.46, "text": "此役"}, {"start": 421.86, "end": 423.26, "text": "贵君斩获曹操"}, {"start": 423.26, "end": 425.06, "text": "数十万兵马粮草"}, {"start": 425.46, "end": 426.86, "text": "可喜可贺"}, {"start": 427.06, "end": 427.66, "text": "来"}, {"start": 428.06, "end": 430.26, "text": "我们谣敬吴侯一杯"}, {"start": 430.66, "end": 443.1, "text": "真正应该祝贺的"}, {"start": 443.5, "end": 444.7, "text": "是刘皇叔啊"}, {"start": 445.7, "end": 447.1, "text": "曹操大败以后"}, {"start": 447.3, "end": 448.3, "text": "落荒而逃"}, {"start": 449.1, "end": 450.9, "text": "听说孔明早就在吴侯"}, {"start": 450.9, "end": 453.1, "text": "一带连设下三道伏兵"}, {"start": 454.1, "end": 455.3, "text": "如此料想"}, {"start": 455.5, "end": 457.9, "text": "曹操定是插翅难飞"}, {"start": 459.3, "end": 460.9, "text": "刘皇叔勤得曹操后"}, {"start": 461.3, "end": 463.1, "text": "便立下了矿式功勋"}, {"start": 463.7, "end": 464.9, "text": "攻击天地"}, {"start": 465.1, "end": 467.5, "text": "天子定会龙颜大悦"}, {"start": 467.9, "end": 471.1, "text": "朝廷也会为皇叔数倍露名"}, {"start": 471.9, "end": 472.5, "text": "来"}, {"start": 473.1, "end": 475.3, "text": "在下再敬皇叔一杯"}, {"start": 476.5, "end": 482.55, "text": "紫敬啊"}, {"start": 483.55, "end": 485.15, "text": "若不是东吴赤壁一把"}, {"start": 485.15, "end": 486.95, "text": "东吴赤壁一把大火"}, {"start": 487.35, "end": 489.15, "text": "我主公区区两万人马"}, {"start": 489.35, "end": 491.15, "text": "如何能大破曹军呢"}, {"start": 492.15, "end": 494.15, "text": "如果朝廷要立碑露名"}, {"start": 494.35, "end": 496.75, "text": "那也应该为吴侯立才是吗"}, {"start": 499.39, "end": 500.39, "text": "只是"}, {"start": 500.79, "end": 501.99, "text": "到现在为止"}, {"start": 502.59, "end": 504.39, "text": "曹操还生死不明"}, {"start": 505.39, "end": 506.19, "text": "敢问"}, {"start": 506.39, "end": 508.59, "text": "是哪位将军把守环绒道啊"}, {"start": 509.19, "end": 511.59, "text": "莫要让曹操露谎了呀"}, {"start": 512.39, "end": 513.19, "text": "你放心吧"}, {"start": 513.39, "end": 514.59, "text": "是我二哥关羽"}, {"start": 514.79, "end": 516.19, "text": "亲自把守环绒道"}, {"start": 516.39, "end": 516.99, "text": "待会儿"}, {"start": 517.19, "end": 519.39, "text": "他一定会提着曹操的脑袋回来"}, {"start": 519.79, "end": 522.74, "text": "好好好"}, {"start": 523.74, "end": 524.94, "text": "有云长在"}, {"start": 525.34, "end": 526.94, "text": "曹操断无生路"}, {"start": 538.98, "end": 539.58, "text": "二哥"}, {"start": 539.98, "end": 546.79, "text": "二哥"}, {"start": 551.07, "end": 553.86, "text": "二哥 进来"}, {"start": 554.86, "end": 557.06, "text": "恭喜关将军立了盖世之功"}, {"start": 557.26, "end": 559.26, "text": "为汉室除去一个巨害啊"}, {"start": 559.46, "end": 563.46, "text": "关将军"}, {"start": 563.86, "end": 565.66, "text": "莫非因为我等不曾远迎"}, {"start": 565.66, "end": 566.86, "text": "故而不乐呀"}, {"start": 567.26, "end": 574.98, "text": "又成啊"}, {"start": 575.58, "end": 577.18, "text": "关将军凯旋归迎"}, {"start": 577.18, "end": 578.98, "text": "你为何不预先禀告呢"}, {"start": 578.98, "end": 579.58, "text": "这"}, {"start": 580.38, "end": 580.98, "text": "禀"}, {"start": 582.58, "end": 583.58, "text": "助攻武军师"}, {"start": 584.18, "end": 589.1, "text": "最将为亲得曹操"}, {"start": 589.5, "end": 593.7, "text": "这"}, {"start": 594.1, "end": 597.78, "text": "莫非是我估计错了"}, {"start": 598.78, "end": 600.78, "text": "曹操不曾往华融道上来"}, {"start": 601.38, "end": 604.85, "text": "军师了体如神"}, {"start": 605.65, "end": 607.25, "text": "曹操是走的这条道"}, {"start": 607.65, "end": 608.45, "text": "官某无能"}, {"start": 610.05, "end": 611.05, "text": "被他走脱了"}, {"start": 612.05, "end": 634.09, "text": "关将军"}, {"start": 634.49, "end": 639.85, "text": "你跨下千里赤土马"}, {"start": 640.65, "end": 642.45, "text": "手中青龙雁月刀"}, {"start": 642.45, "end": 643.65, "text": "神运无敌"}, {"start": 643.85, "end": 648.12, "text": "可穷途末路的曹操呢"}, {"start": 648.52, "end": 653.31, "text": "紫禁则问的是啊"}, {"start": 654.11, "end": 654.91, "text": "关将军"}, {"start": 655.71, "end": 658.31, "text": "分明是你念及曹操昔日之情"}, {"start": 658.31, "end": 660.11, "text": "不忍杀贼才将他放走"}, {"start": 660.31, "end": 661.31, "text": "是也不是"}, {"start": 661.71, "end": 663.11, "text": "你联手抗曹"}, {"start": 682.26, "end": 684.46, "text": "可谓是费尽心机"}, {"start": 684.46, "end": 685.66, "text": "力尽坚信"}, {"start": 686.66, "end": 688.66, "text": "死伤了那么多的将士"}, {"start": 688.86, "end": 689.86, "text": "关羽现在"}, {"start": 690.06, "end": 695.23, "text": "私自放走了曹操"}, {"start": 695.43, "end": 699.28, "text": "不判浴血奋战的将士"}, {"start": 699.28, "end": 700.28, "text": "如何能答应"}, {"start": 700.28, "end": 700.88, "text": "请问"}, {"start": 702.28, "end": 703.68, "text": "这该当何罪"}, {"start": 704.08, "end": 705.28, "text": "把军令撞来"}, {"start": 705.48, "end": 715.21, "text": "关将军"}, {"start": 715.41, "end": 733.82, "text": "是谁立的军令撞"}, {"start": 736.45, "end": 737.65, "text": "官某所立"}, {"start": 738.05, "end": 739.25, "text": "军令撞在此"}, {"start": 739.25, "end": 740.45, "text": "你还有何话讲"}, {"start": 741.45, "end": 742.45, "text": "曹操脱名汉相"}, {"start": 742.45, "end": 743.45, "text": "实为汉贼"}, {"start": 743.65, "end": 744.85, "text": "世上人人欲"}, {"start": 744.85, "end": 745.65, "text": "但其肉"}, {"start": 745.65, "end": 746.45, "text": "寝其皮"}, {"start": 746.85, "end": 748.25, "text": "你既得军令"}, {"start": 748.25, "end": 749.85, "text": "怎能私自抗命纵敌"}, {"start": 750.65, "end": 752.45, "text": "别说江东将士不能容你"}, {"start": 752.45, "end": 753.65, "text": "我也不能容你"}, {"start": 754.25, "end": 754.85, "text": "左右"}, {"start": 754.85, "end": 755.45, "text": "在"}, {"start": 755.45, "end": 756.65, "text": "将关羽推下"}, {"start": 757.45, "end": 758.05, "text": "斩"}, {"start": 758.05, "end": 758.65, "text": "诺"}, {"start": 759.25, "end": 760.05, "text": "军师"}, {"start": 760.85, "end": 765.36, "text": "当真要斩我二哥"}, {"start": 765.56, "end": 766.56, "text": "我细言"}, {"start": 766.96, "end": 767.96, "text": "推下"}, {"start": 771.97, "end": 775.93, "text": "斩"}, {"start": 775.93, "end": 776.53, "text": "遵命"}, {"start": 778.33, "end": 778.93, "text": "住手"}, {"start": 779.53, "end": 780.33, "text": "给我滚开"}, {"start": 780.53, "end": 781.13, "text": "张飞"}, {"start": 782.33, "end": 783.53, "text": "主公在上"}, {"start": 783.93, "end": 785.73, "text": "又有紫禁兄在此"}, {"start": 786.33, "end": 788.13, "text": "你岂敢放肆"}, {"start": 788.33, "end": 789.13, "text": "孔明"}, {"start": 789.93, "end": 792.5, "text": "恕我不恭"}, {"start": 792.5, "end": 793.7, "text": "给你个鸡毛"}, {"start": 794.1, "end": 795.5, "text": "你就当令箭了"}, {"start": 796.3, "end": 797.7, "text": "你可知道他是谁吗"}, {"start": 798.1, "end": 799.1, "text": "是我二哥"}, {"start": 799.1, "end": 799.9, "text": "关羽"}, {"start": 800.1, "end": 801.5, "text": "桃园劫役"}, {"start": 803.48, "end": 808.03, "text": "立誓生死与共"}, {"start": 808.83, "end": 810.23, "text": "谁若杀他"}, {"start": 810.83, "end": 812.03, "text": "我先杀了谁"}, {"start": 812.23, "end": 813.03, "text": "放肆"}, {"start": 813.63, "end": 814.23, "text": "三弟"}, {"start": 815.23, "end": 829.14, "text": "我既拜孔明为军师"}, {"start": 829.94, "end": 830.94, "text": "军中士"}, {"start": 830.94, "end": 832.14, "text": "就一凭他决断"}, {"start": 832.74, "end": 834.14, "text": "你如对军师不敬"}, {"start": 834.54, "end": 835.74, "text": "就是当军师"}, {"start": 837.77, "end": 839.37, "text": "你如对军师不敬"}, {"start": 839.77, "end": 841.17, "text": "就是对我不敬"}, {"start": 848.23, "end": 848.83, "text": "先生"}, {"start": 850.43, "end": 851.83, "text": "我三弟性情鲁莽"}, {"start": 851.83, "end": 853.23, "text": "请不要放在心上"}, {"start": 854.23, "end": 856.43, "text": "云长既然违反了军规"}, {"start": 856.63, "end": 858.23, "text": "就该当军法从事"}, {"start": 859.03, "end": 859.63, "text": "一切"}, {"start": 859.83, "end": 861.23, "text": "均凭先生做主"}, {"start": 861.43, "end": 862.03, "text": "这"}, {"start": 862.03, "end": 862.63, "text": "大哥"}, {"start": 868.41, "end": 869.01, "text": "三弟"}, {"start": 871.1, "end": 871.9, "text": "先退下"}, {"start": 873.1, "end": 874.7, "text": "是我违反了军令"}, {"start": 875.3, "end": 876.5, "text": "理当问斩"}, {"start": 877.3, "end": 877.9, "text": "不"}, {"start": 879.1, "end": 879.9, "text": "大哥"}, {"start": 880.5, "end": 881.3, "text": "大哥"}, {"start": 881.9, "end": 884.3, "text": "你万万不能杀云长啊"}, {"start": 885.1, "end": 887.1, "text": "你不能杀二哥啊"}, {"start": 891.22, "end": 891.82, "text": "三弟"}, {"start": 893.42, "end": 894.82, "text": "军中无父子"}, {"start": 895.62, "end": 897.42, "text": "法令大如天"}, {"start": 898.42, "end": 900.22, "text": "二弟既然违反了军令"}, {"start": 901.42, "end": 903.82, "text": "我们谁也不能阻止军师执法"}, {"start": 906.22, "end": 906.82, "text": "但是"}, {"start": 909.39, "end": 910.59, "text": "我们兄弟三哥"}, {"start": 910.59, "end": 911.99, "text": "桃园三劫役"}, {"start": 912.39, "end": 914.19, "text": "早已誓同生死"}, {"start": 916.39, "end": 917.59, "text": "二弟如死"}, {"start": 918.59, "end": 922.23, "text": "我断不能独生"}, {"start": 922.23, "end": 923.43, "text": "身为兄长"}, {"start": 924.23, "end": 926.23, "text": "我应该先走一步"}, {"start": 927.43, "end": 928.23, "text": "大哥"}, {"start": 928.43, "end": 929.23, "text": "大哥"}, {"start": 929.63, "end": 930.23, "text": "大哥"}, {"start": 930.23, "end": 930.83, "text": "大哥"}, {"start": 931.03, "end": 932.03, "text": "你不能这样"}, {"start": 933.23, "end": 934.63, "text": "是我对不起大哥"}, {"start": 934.63, "end": 937.08, "text": "办了军法"}, {"start": 937.88, "end": 939.08, "text": "罪不容恕"}, {"start": 945.14, "end": 946.34, "text": "引经受禄"}, {"start": 947.34, "end": 948.54, "text": "我子儿无怨"}, {"start": 948.74, "end": 955.94, "text": "爱做兄弟"}, {"start": 956.94, "end": 957.54, "text": "大哥"}, {"start": 958.14, "end": 958.74, "text": "好"}, {"start": 959.74, "end": 961.94, "text": "我们来世再做兄弟"}, {"start": 962.54, "end": 963.34, "text": "大哥"}, {"start": 963.34, "end": 964.34, "text": "刘皇叔"}, {"start": 964.54, "end": 975.94, "text": "刘皇叔万金之躯"}, {"start": 976.14, "end": 977.54, "text": "切不可轻生"}, {"start": 978.94, "end": 980.54, "text": "眼下曹操未死"}, {"start": 980.54, "end": 981.94, "text": "早晚还会再来"}, {"start": 983.14, "end": 984.94, "text": "皇叔是汉室宗亲"}, {"start": 985.14, "end": 986.74, "text": "肩负社稷重任"}, {"start": 987.34, "end": 988.54, "text": "如果这么走了"}, {"start": 989.54, "end": 990.54, "text": "我主无后"}, {"start": 990.94, "end": 992.94, "text": "和谁联手抗拒曹操"}, {"start": 993.34, "end": 994.74, "text": "众星大汉哪"}, {"start": 998.17, "end": 998.77, "text": "锦敬"}, {"start": 998.97, "end": 1001.25, "text": "你不必劝"}, {"start": 1002.85, "end": 1004.45, "text": "不军师杀云长"}, {"start": 1004.85, "end": 1006.05, "text": "我必死无疑"}, {"start": 1006.65, "end": 1007.45, "text": "你要劝"}, {"start": 1007.65, "end": 1008.85, "text": "就劝军师吧"}, {"start": 1009.25, "end": 1010.45, "text": "我三兄弟的生死"}, {"start": 1010.45, "end": 1012.05, "text": "全凭你一言而决"}, {"start": 1023.5, "end": 1025.7, "text": "云长虽然违抗了军令"}, {"start": 1026.9, "end": 1028.3, "text": "但也是念及"}, {"start": 1028.9, "end": 1031.3, "text": "曹操昔日对他的恩情"}, {"start": 1033.94, "end": 1035.34, "text": "人非草木"}, {"start": 1036.34, "end": 1038.34, "text": "殊能无情啊"}, {"start": 1039.34, "end": 1040.14, "text": "要么"}, {"start": 1040.54, "end": 1042.94, "text": "请先生先放过他这一回"}, {"start": 1043.54, "end": 1046.74, "text": "令他来日将功补过吧"}, {"start": 1057.89, "end": 1060.29, "text": "既然紫禁兄都这么说了"}, {"start": 1063.72, "end": 1065.72, "text": "我要是再坚持的话"}, {"start": 1066.32, "end": 1068.32, "text": "就成了重视之地了"}, {"start": 1069.12, "end": 1069.72, "text": "大哥"}, {"start": 1069.92, "end": 1070.52, "text": "起来"}, {"start": 1073.55, "end": 1074.35, "text": "又长啊"}, {"start": 1075.35, "end": 1076.75, "text": "取军令册来"}, {"start": 1077.15, "end": 1079.35, "text": "祭下关羽这次大过"}, {"start": 1079.95, "end": 1082.35, "text": "令他日后将功折罪"}, {"start": 1082.75, "end": 1083.95, "text": "如再抗命"}, {"start": 1084.55, "end": 1086.15, "text": "两罪并罚"}, {"start": 1106.26, "end": 1109.26, "text": "该让关羽把守华融道"}, {"start": 1109.46, "end": 1111.26, "text": "曹贼不死"}, {"start": 1112.26, "end": 1113.86, "text": "战事不休"}, {"start": 1114.46, "end": 1117.46, "text": "天下不宁啊"}, {"start": 1122.44, "end": 1123.44, "text": "云长一德"}, {"start": 1124.04, "end": 1125.64, "text": "快快拜谢紫禁"}, {"start": 1127.54, "end": 1129.14, "text": "多谢紫禁大恩"}, {"start": 1132.1, "end": 1133.1, "text": "我三兄弟"}, {"start": 1133.9, "end": 1134.9, "text": "给你靠手了"}, {"start": 1136.1, "end": 1137.5, "text": "多谢大恩"}, {"start": 1137.5, "end": 1145.98, "text": "不量真是功于心计"}, {"start": 1146.58, "end": 1147.58, "text": "我唯三缺一"}, {"start": 1147.58, "end": 1149.18, "text": "就是要将曹操驱入"}, {"start": 1149.18, "end": 1149.98, "text": "刘备的房地"}, {"start": 1149.98, "end": 1151.18, "text": "来个借刀杀人"}, {"start": 1151.38, "end": 1152.78, "text": "日后让曹操的部众"}, {"start": 1152.78, "end": 1153.78, "text": "找刘备寻仇"}, {"start": 1154.18, "end": 1155.78, "text": "好让主公坐于不败之地"}, {"start": 1155.98, "end": 1158.71, "text": "他竟然搬出个关羽"}, {"start": 1158.71, "end": 1159.91, "text": "把守华融道"}, {"start": 1160.11, "end": 1161.51, "text": "放了曹操一条生路"}, {"start": 1164.47, "end": 1166.27, "text": "此人惯意算计别人"}, {"start": 1166.67, "end": 1168.87, "text": "别人又如何能算计过他呀"}, {"start": 1170.47, "end": 1171.27, "text": "我怀疑"}, {"start": 1171.87, "end": 1173.67, "text": "朱可亮是有意如此"}, {"start": 1174.87, "end": 1176.07, "text": "岂止是有意"}, {"start": 1176.87, "end": 1178.47, "text": "这关羽私纵曹操之后"}, {"start": 1178.67, "end": 1180.87, "text": "曹操就欠了刘备一桩人情"}, {"start": 1181.07, "end": 1181.67, "text": "将来"}, {"start": 1181.87, "end": 1183.87, "text": "曹操必将视我们为头号大敌"}, {"start": 1184.87, "end": 1185.27, "text": "不"}, {"start": 1186.27, "end": 1188.07, "text": "就算关羽没有放过曹操"}, {"start": 1188.27, "end": 1189.67, "text": "曹操仍然会把我们"}, {"start": 1189.67, "end": 1190.87, "text": "当成头号大敌"}, {"start": 1191.47, "end": 1192.87, "text": "因为现在刘备的势力"}, {"start": 1192.87, "end": 1194.27, "text": "还远不及我们"}, {"start": 1196.17, "end": 1196.77, "text": "紫荆啊"}, {"start": 1197.57, "end": 1199.57, "text": "这事我就不能不责备你两句了"}, {"start": 1200.77, "end": 1201.97, "text": "这刘玄德要抹脖子"}, {"start": 1201.97, "end": 1203.17, "text": "你只管让他抹好了"}, {"start": 1203.17, "end": 1204.17, "text": "你还拦他做什么"}, {"start": 1204.37, "end": 1205.37, "text": "难道你没看出来"}, {"start": 1206.17, "end": 1207.97, "text": "他们君臣一个敲锣一个打鼓"}, {"start": 1207.97, "end": 1209.17, "text": "合起伙来唱戏"}, {"start": 1209.17, "end": 1210.57, "text": "就等你出来求情"}, {"start": 1210.97, "end": 1211.77, "text": "他们好推卸掉"}, {"start": 1211.77, "end": 1213.17, "text": "放走曹操的罪责"}, {"start": 1213.57, "end": 1216.64, "text": "你呀"}, {"start": 1217.64, "end": 1218.84, "text": "就是过于心善"}, {"start": 1220.64, "end": 1221.24, "text": "公瑾啊"}, {"start": 1222.04, "end": 1223.64, "text": "我知道他们是在演戏啊"}, {"start": 1224.24, "end": 1225.24, "text": "那你还拦他做什么"}, {"start": 1228.98, "end": 1229.98, "text": "这有唱戏的"}, {"start": 1230.38, "end": 1231.98, "text": "就应该有看戏的嘛"}, {"start": 1233.18, "end": 1233.78, "text": "再说"}, {"start": 1234.18, "end": 1235.38, "text": "我虽然心善"}, {"start": 1235.98, "end": 1237.58, "text": "但我却并不糊涂"}, {"start": 1238.58, "end": 1239.18, "text": "只是"}, {"start": 1239.58, "end": 1240.98, "text": "有时候不糊涂者"}, {"start": 1241.38, "end": 1242.98, "text": "却不得不装糊涂"}, {"start": 1243.98, "end": 1244.58, "text": "为何"}, {"start": 1245.78, "end": 1246.38, "text": "禀主公"}, {"start": 1247.38, "end": 1249.18, "text": "曹操虽然战败于赤壁"}, {"start": 1249.38, "end": 1250.18, "text": "元气大上"}, {"start": 1250.98, "end": 1252.38, "text": "但是他人没有死"}, {"start": 1252.98, "end": 1253.78, "text": "非但如此"}, {"start": 1254.18, "end": 1256.78, "text": "曹操的四周数十郡城池聚在"}, {"start": 1257.18, "end": 1259.58, "text": "他北方的军备田牧子民"}, {"start": 1259.78, "end": 1261.38, "text": "仍然是毫发无损啊"}, {"start": 1262.58, "end": 1263.98, "text": "就天下大势看"}, {"start": 1264.38, "end": 1266.18, "text": "曹操仍是最为强悍"}, {"start": 1266.78, "end": 1268.98, "text": "各地诸侯还是处于弱势"}, {"start": 1269.78, "end": 1271.18, "text": "我们和刘备两家"}, {"start": 1271.18, "end": 1272.38, "text": "无论折了哪一支"}, {"start": 1272.58, "end": 1274.38, "text": "另一支都断断和曹操"}, {"start": 1274.38, "end": 1275.58, "text": "在继续抗衡"}, {"start": 1276.58, "end": 1278.98, "text": "所以保存住了另一家"}, {"start": 1279.18, "end": 1280.98, "text": "也就等于保存住了自己"}, {"start": 1281.38, "end": 1283.78, "text": "此乃求存取胜之道"}, {"start": 1284.78, "end": 1285.38, "text": "主公"}, {"start": 1286.38, "end": 1287.78, "text": "在今后一段时日"}, {"start": 1287.98, "end": 1289.78, "text": "我们仍然不得不和刘备"}, {"start": 1289.78, "end": 1291.38, "text": "继续联手抗曹啊"}, {"start": 1291.98, "end": 1292.58, "text": "所以"}, {"start": 1293.38, "end": 1295.38, "text": "关羽给了曹操一点恩典"}, {"start": 1295.78, "end": 1298.18, "text": "那我们也给刘备一点恩典吧"}, {"start": 1299.95, "end": 1300.95, "text": "子敬言重了吧"}, {"start": 1303.76, "end": 1305.76, "text": "赤壁之意全靠我东吴之力"}, {"start": 1306.36, "end": 1307.76, "text": "刘备只有一两万兵"}, {"start": 1308.16, "end": 1309.76, "text": "他怎么能与我们相提并论"}, {"start": 1309.96, "end": 1310.56, "text": "不错"}, {"start": 1311.36, "end": 1312.56, "text": "刘军虽然不多"}, {"start": 1312.96, "end": 1314.76, "text": "但是刘备他姓刘啊"}, {"start": 1315.16, "end": 1316.56, "text": "他是当今的皇叔"}, {"start": 1316.56, "end": 1318.96, "text": "是胸怀大志的汉室正徒"}, {"start": 1319.96, "end": 1320.76, "text": "两年前"}, {"start": 1320.96, "end": 1322.36, "text": "曹操青梅竹酒"}, {"start": 1322.36, "end": 1323.96, "text": "论遍天下英雄"}, {"start": 1324.36, "end": 1324.96, "text": "事实"}, {"start": 1324.96, "end": 1326.96, "text": "曹操已拥雄兵数十万"}, {"start": 1327.56, "end": 1329.36, "text": "可刘备只有落魄数人"}, {"start": 1329.36, "end": 1331.16, "text": "且济于曹操篱下"}, {"start": 1331.96, "end": 1333.56, "text": "可当时曹操却断言"}, {"start": 1333.76, "end": 1335.56, "text": "天下英雄谁敌手"}, {"start": 1336.56, "end": 1338.16, "text": "是他曹操和刘备"}, {"start": 1340.71, "end": 1342.11, "text": "请恕在下直言"}, {"start": 1342.91, "end": 1344.71, "text": "当时曹操连你的名字"}, {"start": 1344.71, "end": 1345.51, "text": "都没有提到"}, {"start": 1345.51, "end": 1346.91, "text": "却只说到了刘备"}, {"start": 1347.31, "end": 1348.51, "text": "他为何要这样"}, {"start": 1349.11, "end": 1350.71, "text": "因为他不仅看出了"}, {"start": 1350.71, "end": 1352.11, "text": "刘备胸怀大志"}, {"start": 1352.71, "end": 1353.71, "text": "他也看出了"}, {"start": 1354.11, "end": 1355.51, "text": "虽然汉室衰微"}, {"start": 1355.51, "end": 1357.91, "text": "但是天下士族的心仍然向汉"}, {"start": 1358.11, "end": 1359.31, "text": "所以他才不得不"}, {"start": 1359.31, "end": 1360.71, "text": "挟天子以令诸侯"}, {"start": 1360.91, "end": 1362.91, "text": "而不敢悍然废汉自立"}, {"start": 1364.11, "end": 1365.11, "text": "在下认为"}, {"start": 1365.31, "end": 1367.71, "text": "主公日后预想屠霸中原"}, {"start": 1367.71, "end": 1368.71, "text": "成就伟业"}, {"start": 1368.71, "end": 1370.51, "text": "早晚必须战胜曹操"}, {"start": 1371.11, "end": 1372.91, "text": "而战胜曹操的前提"}, {"start": 1373.11, "end": 1375.31, "text": "仍然是要和刘备联手啊"}, {"start": 1376.51, "end": 1377.31, "text": "所以"}, {"start": 1377.71, "end": 1379.91, "text": "我们现在非但不能让刘备死"}, {"start": 1380.11, "end": 1381.51, "text": "还要在他危难的时候"}, {"start": 1381.51, "end": 1382.51, "text": "扶住他一下"}, {"start": 1383.11, "end": 1384.71, "text": "只有刘备的声势越大"}, {"start": 1384.91, "end": 1386.51, "text": "才越能牵制住曹操"}, {"start": 1386.91, "end": 1388.51, "text": "让刘备为我所用"}, {"start": 1388.91, "end": 1391.91, "text": "我江东方能立于不败之地呀"}, {"start": 1394.23, "end": 1394.83, "text": "紫禁"}, {"start": 1396.23, "end": 1397.83, "text": "我知道你与诸葛寥交后"}, {"start": 1399.03, "end": 1400.23, "text": "是我提醒你一句"}, {"start": 1401.43, "end": 1402.83, "text": "你实的是江东奉路"}, {"start": 1402.83, "end": 1404.23, "text": "做的是主公臣子"}, {"start": 1405.63, "end": 1407.03, "text": "不要把心思掌歪了"}, {"start": 1408.03, "end": 1408.63, "text": "公瑾"}, {"start": 1409.03, "end": 1409.63, "text": "公瑾"}, {"start": 1409.63, "end": 1410.63, "text": "公瑾留步"}, {"start": 1417.21, "end": 1417.81, "text": "紫禁啊"}, {"start": 1418.61, "end": 1420.21, "text": "公瑾赤壁大盛"}, {"start": 1420.61, "end": 1421.61, "text": "名声大振"}, {"start": 1422.21, "end": 1423.21, "text": "说起话来"}, {"start": 1423.61, "end": 1425.61, "text": "语气跟以前自然不一样"}, {"start": 1426.01, "end": 1427.61, "text": "你可千万不要见怪啊"}, {"start": 1430.9, "end": 1433.5, "text": "在下还想劝主公不要在意呢"}, {"start": 1434.1, "end": 1434.9, "text": "主公啊"}, {"start": 1435.7, "end": 1437.7, "text": "我和公瑾相交十几年了"}, {"start": 1438.9, "end": 1440.1, "text": "公瑾的谋略"}, {"start": 1440.1, "end": 1441.7, "text": "胜过在下十倍"}, {"start": 1442.1, "end": 1443.1, "text": "她的脾气"}, {"start": 1443.1, "end": 1444.5, "text": "我也最为熟知"}, {"start": 1445.5, "end": 1447.5, "text": "方才公瑾之所以发火"}, {"start": 1447.9, "end": 1449.7, "text": "她气的并不是在下"}, {"start": 1450.1, "end": 1452.5, "text": "她气的是诸葛孔明啊"}, {"start": 1454.5, "end": 1455.5, "text": "主公啊"}, {"start": 1456.3, "end": 1458.7, "text": "这朗朗乾坤 茫茫苍穹"}, {"start": 1459.3, "end": 1460.9, "text": "现在在公瑾的眼里"}, {"start": 1461.1, "end": 1462.5, "text": "还是太小了"}, {"start": 1463.5, "end": 1464.3, "text": "小到了"}, {"start": 1464.5, "end": 1467.1, "text": "容不下两个顶尖的智者呀"}, {"start": 1467.7, "end": 1468.3, "text": "紫禁"}, {"start": 1469.3, "end": 1472.1, "text": "你刚才对公瑾说的那番道理"}, {"start": 1472.9, "end": 1473.9, "text": "极为精辟"}, {"start": 1475.84, "end": 1478.24, "text": "但是公瑾未必能听得进去"}, {"start": 1479.04, "end": 1479.64, "text": "不过"}, {"start": 1480.64, "end": 1482.44, "text": "方才在下的那番话"}, {"start": 1483.04, "end": 1485.24, "text": "并不仅仅是说给公瑾听的"}, {"start": 1487.44, "end": 1490.24, "text": "难道你是要说给我听的"}, {"start": 1494.84, "end": 1496.04, "text": "三十年之内"}, {"start": 1496.24, "end": 1498.44, "text": "孙柳两家联手便可共存"}, {"start": 1499.24, "end": 1501.64, "text": "否则早晚被北军并已"}, {"start": 1516.15, "end": 1516.75, "text": "记住了"}, {"start": 1516.95, "end": 1561.51, "text": "谁在哭啊"}, {"start": 1563.51, "end": 1564.31, "text": "这些天"}, {"start": 1565.31, "end": 1567.51, "text": "残兵陆续从乌林归来"}, {"start": 1569.51, "end": 1571.51, "text": "弟兄们都是九死一生"}, {"start": 1572.51, "end": 1573.31, "text": "见了面"}, {"start": 1574.71, "end": 1576.31, "text": "忍不住抱头痛哭"}, {"start": 1577.31, "end": 1579.11, "text": "今日是谁回来了"}, {"start": 1579.31, "end": 1591.23, "text": "阿爷会哭吗"}, {"start": 1593.46, "end": 1597.96, "text": "哭得最伤心的就是徐楚了"}, {"start": 1610.58, "end": 1611.18, "text": "丞相"}, {"start": 1611.98, "end": 1612.98, "text": "你要去哪啊"}, {"start": 1625.79, "end": 1626.39, "text": "别哭了"}, {"start": 1627.19, "end": 1628.59, "text": "我三千铁甲"}, {"start": 1629.59, "end": 1631.39, "text": "杀的就剩八伏狗回来"}, {"start": 1633.24, "end": 1634.84, "text": "我的三千个弟兄"}, {"start": 1635.44, "end": 1637.84, "text": "三千个壮士啊"}, {"start": 1639.04, "end": 1646.46, "text": "拜见丞相"}, {"start": 1664.34, "end": 1665.14, "text": "哭什么呢"}, {"start": 1665.14, "end": 1671.22, "text": "虎将"}, {"start": 1672.02, "end": 1673.42, "text": "流血不流泪"}, {"start": 1675.17, "end": 1675.97, "text": "胜败"}, {"start": 1676.57, "end": 1677.97, "text": "乃兵家常事"}, {"start": 1681.34, "end": 1681.94, "text": "徐楚"}, {"start": 1682.74, "end": 1683.34, "text": "去"}, {"start": 1683.74, "end": 1684.94, "text": "击鼓声仗"}, {"start": 1691.2, "end": 1692.6, "text": "没听见我说的话"}, {"start": 1694.88, "end": 1695.48, "text": "丞相"}, {"start": 1696.88, "end": 1698.08, "text": "我的三千个弟兄"}, {"start": 1698.68, "end": 1699.68, "text": "全死过了"}, {"start": 1703.64, "end": 1704.84, "text": "我对不住他们"}, {"start": 1707.46, "end": 1709.06, "text": "我对不住丞相"}, {"start": 1711.54, "end": 1712.84, "text": "你不是还活着吗"}, {"start": 1714.69, "end": 1715.49, "text": "你活着"}, {"start": 1716.09, "end": 1717.89, "text": "我做梦都能消醒过来"}, {"start": 1718.89, "end": 1720.29, "text": "死了三千兵算什么"}, {"start": 1720.89, "end": 1722.29, "text": "我再给你三万"}, {"start": 1746.0, "end": 1746.8, "text": "雷苦家"}, {"start": 1749.09, "end": 1750.19, "text": "让我自个儿去吗"}, {"start": 1751.19, "end": 1751.79, "text": "徐将军"}, {"start": 1752.19, "end": 1753.19, "text": "快去呀"}, {"start": 1798.51, "end": 1799.71, "text": "如同医者"}, {"start": 1800.91, "end": 1801.51, "text": "医者"}, {"start": 1803.51, "end": 1805.11, "text": "是医过的人越多"}, {"start": 1806.51, "end": 1807.51, "text": "医术越高明"}, {"start": 1807.71, "end": 1809.11, "text": "换句话说就是"}, {"start": 1809.51, "end": 1811.11, "text": "医死的人越多"}, {"start": 1811.51, "end": 1812.71, "text": "医术越高明"}, {"start": 1815.51, "end": 1816.11, "text": "将军"}, {"start": 1817.51, "end": 1819.71, "text": "如果不经历几次败仗"}, {"start": 1820.91, "end": 1822.11, "text": "如何能够知道"}, {"start": 1822.51, "end": 1823.71, "text": "怎么去打胜仗"}, {"start": 1824.91, "end": 1826.91, "text": "这个世上从来就没有"}, {"start": 1828.11, "end": 1829.91, "text": "百战百胜的将军"}, {"start": 1831.51, "end": 1832.11, "text": "只有"}, {"start": 1833.31, "end": 1834.51, "text": "败而不败"}, {"start": 1835.71, "end": 1837.11, "text": "败而易勇"}, {"start": 1838.11, "end": 1839.11, "text": "并且最终"}, {"start": 1840.11, "end": 1841.11, "text": "取得胜利的人"}, {"start": 1841.51, "end": 1842.11, "text": "我们"}, {"start": 1842.91, "end": 1843.91, "text": "八十三万大军"}, {"start": 1844.11, "end": 1845.11, "text": "挥师南下"}, {"start": 1847.09, "end": 1848.49, "text": "却败于孙刘"}, {"start": 1849.89, "end": 1853.02, "text": "五六万军队"}, {"start": 1853.42, "end": 1855.02, "text": "我看最根本的原因"}, {"start": 1856.62, "end": 1858.42, "text": "是因为最近这些年"}, {"start": 1859.22, "end": 1860.82, "text": "我们胜仗打得太多"}, {"start": 1863.56, "end": 1864.76, "text": "兵交将待"}, {"start": 1865.96, "end": 1867.16, "text": "文田武戏"}, {"start": 1868.36, "end": 1869.56, "text": "轻敌自负"}, {"start": 1869.96, "end": 1870.76, "text": "尤其是我"}, {"start": 1872.56, "end": 1874.16, "text": "居然连一个小小的"}, {"start": 1874.56, "end": 1876.76, "text": "苦肉计都未能识破"}, {"start": 1877.76, "end": 1878.76, "text": "只是东吴"}, {"start": 1879.36, "end": 1880.16, "text": "火功得手"}, {"start": 1881.16, "end": 1881.96, "text": "由此看来"}, {"start": 1883.16, "end": 1884.16, "text": "我们是到了"}, {"start": 1886.46, "end": 1889.26, "text": "该吃一个败仗的时候了"}, {"start": 1889.86, "end": 1891.26, "text": "失败是个好事"}, {"start": 1893.43, "end": 1896.71, "text": "失败能教会我们"}, {"start": 1897.71, "end": 1898.71, "text": "如何成功"}, {"start": 1899.91, "end": 1900.51, "text": "失败"}, {"start": 1901.51, "end": 1902.71, "text": "能够教会我们"}, {"start": 1903.11, "end": 1904.11, "text": "如何取胜"}, {"start": 1904.51, "end": 1906.91, "text": "失败能够教会我们"}, {"start": 1907.31, "end": 1908.91, "text": "如何取天下"}, {"start": 1909.51, "end": 1910.11, "text": "一个人"}, {"start": 1910.91, "end": 1912.11, "text": "要想成事"}, {"start": 1912.51, "end": 1912.91, "text": "就得"}, {"start": 1913.51, "end": 1914.51, "text": "拿得起方向"}, {"start": 1915.31, "end": 1916.51, "text": "打仗也是如此"}, {"start": 1917.51, "end": 1918.31, "text": "要胜得起"}, {"start": 1919.31, "end": 1920.51, "text": "也要败得起"}, {"start": 1921.51, "end": 1922.11, "text": "我们"}, {"start": 1923.31, "end": 1924.91, "text": "虽受赤壁重创"}, {"start": 1925.71, "end": 1926.91, "text": "但是我们的根基"}, {"start": 1927.31, "end": 1928.31, "text": "基本未上"}, {"start": 1929.31, "end": 1930.31, "text": "天下周军"}, {"start": 1931.11, "end": 1932.31, "text": "我们仍然掌握"}, {"start": 1933.11, "end": 1936.31, "text": "清 忧 病 忌"}, {"start": 1937.11, "end": 1937.91, "text": "四个种"}, {"start": 1938.31, "end": 1940.11, "text": "我们的城池"}, {"start": 1941.71, "end": 1942.51, "text": "兵马"}, {"start": 1943.31, "end": 1944.31, "text": "子民"}, {"start": 1945.11, "end": 1945.71, "text": "赋税"}, {"start": 1946.51, "end": 1947.91, "text": "仍然数倍于"}, {"start": 1948.51, "end": 1949.51, "text": "孙权刘备"}, {"start": 1949.71, "end": 1952.72, "text": "朝廷仍然在许长"}, {"start": 1953.72, "end": 1955.72, "text": "仍然在我们的手中"}, {"start": 1956.72, "end": 1958.32, "text": "反观孙权刘备"}, {"start": 1958.32, "end": 1958.92, "text": "刘备"}, {"start": 1959.52, "end": 1960.12, "text": "则不然"}, {"start": 1962.38, "end": 1963.38, "text": "危难的时候"}, {"start": 1963.78, "end": 1964.38, "text": "他们会"}, {"start": 1964.78, "end": 1965.58, "text": "抱成一团"}, {"start": 1965.98, "end": 1966.98, "text": "同仇敌忾"}, {"start": 1969.01, "end": 1970.21, "text": "一旦取胜"}, {"start": 1971.21, "end": 1973.01, "text": "他们就会明真暗斗"}, {"start": 1973.61, "end": 1974.21, "text": "就会"}, {"start": 1975.01, "end": 1976.01, "text": "尔虞我诈"}, {"start": 1977.21, "end": 1978.01, "text": "比方说"}, {"start": 1979.21, "end": 1980.41, "text": "要是周瑜"}, {"start": 1981.01, "end": 1981.81, "text": "和诸葛亮"}, {"start": 1982.01, "end": 1982.61, "text": "能够"}, {"start": 1982.81, "end": 1984.41, "text": "同心同德的话"}, {"start": 1985.21, "end": 1986.01, "text": "无邻道"}, {"start": 1986.61, "end": 1987.81, "text": "我们怎么可能"}, {"start": 1988.01, "end": 1988.81, "text": "突出重围"}, {"start": 1989.21, "end": 1990.21, "text": "你们说对不对"}, {"start": 1991.72, "end": 1992.32, "text": "对"}, {"start": 1992.32, "end": 1993.52, "text": "孙刘之辈"}, {"start": 1994.12, "end": 1995.32, "text": "先前如此"}, {"start": 1996.32, "end": 1997.72, "text": "日后会更甚"}, {"start": 1998.52, "end": 1999.32, "text": "总之"}, {"start": 1999.72, "end": 2001.32, "text": "他们早晚分裂"}, {"start": 2001.52, "end": 2002.12, "text": "早晚"}, {"start": 2002.52, "end": 2003.32, "text": "必败"}, {"start": 2004.12, "end": 2004.52, "text": "对"}, {"start": 2004.72, "end": 2005.52, "text": "早晚必败"}, {"start": 2005.52, "end": 2005.92, "text": "对"}, {"start": 2005.92, "end": 2006.72, "text": "早晚必败"}, {"start": 2006.72, "end": 2007.72, "text": "丞相说得对"}, {"start": 2016.96, "end": 2017.96, "text": "这是何人"}, {"start": 2020.6, "end": 2021.2, "text": "丞相"}, {"start": 2021.4, "end": 2022.0, "text": "他叫马恒"}, {"start": 2022.2, "end": 2023.6, "text": "在我正下做牧兵"}, {"start": 2032.1, "end": 2032.9, "text": "算了算了"}, {"start": 2033.9, "end": 2034.7, "text": "不去理他了"}, {"start": 2036.1, "end": 2038.3, "text": "我们在讨论军政大事"}, {"start": 2038.7, "end": 2040.3, "text": "此人却滥税如泥"}, {"start": 2040.7, "end": 2041.7, "text": "由此可见"}, {"start": 2042.3, "end": 2044.1, "text": "他是个酒囊饭袋"}, {"start": 2044.5, "end": 2045.5, "text": "愚蠢如猪"}, {"start": 2046.1, "end": 2046.9, "text": "不可救药"}, {"start": 2048.1, "end": 2048.7, "text": "对"}, {"start": 2078.9, "end": 2080.9, "text": "罪徒马恒恭候丞相"}, {"start": 2083.83, "end": 2084.63, "text": "恭候"}, {"start": 2086.76, "end": 2087.96, "text": "莫非你猜到"}, {"start": 2088.96, "end": 2089.96, "text": "我会前来"}, {"start": 2090.56, "end": 2091.16, "text": "是"}, {"start": 2091.56, "end": 2096.11, "text": "你为何这么想"}, {"start": 2096.51, "end": 2097.71, "text": "丞相谈论兵机"}, {"start": 2098.91, "end": 2100.71, "text": "诸将听得津津有味"}, {"start": 2101.71, "end": 2102.91, "text": "唯独罪徒一人"}, {"start": 2102.91, "end": 2103.91, "text": "憨睡如泥"}, {"start": 2104.51, "end": 2106.31, "text": "丞相定会来问个究竟"}, {"start": 2107.11, "end": 2109.71, "text": "你既不愿意听我谈论兵机"}, {"start": 2109.71, "end": 2111.71, "text": "想必有超凡之见"}, {"start": 2112.51, "end": 2113.11, "text": "说吧"}, {"start": 2113.51, "end": 2114.91, "text": "我愿闻其想"}, {"start": 2117.88, "end": 2118.88, "text": "赤壁之败"}, {"start": 2121.46, "end": 2123.46, "text": "并不是丞相兵交将待"}, {"start": 2124.26, "end": 2125.66, "text": "也非指挥失当"}, {"start": 2127.26, "end": 2128.66, "text": "而是天道所致"}, {"start": 2128.86, "end": 2136.17, "text": "此话怎讲"}, {"start": 2136.57, "end": 2147.04, "text": "丞相兵将八十三万"}, {"start": 2147.44, "end": 2149.64, "text": "孙刘二军不过五七万人"}, {"start": 2149.84, "end": 2152.24, "text": "按理说丞相兵逢所向"}, {"start": 2152.24, "end": 2154.04, "text": "孙刘本该夙守"}, {"start": 2154.24, "end": 2157.24, "text": "可他们身负绝境"}, {"start": 2157.24, "end": 2158.64, "text": "却联为一起"}, {"start": 2158.64, "end": 2159.84, "text": "疏死相抗"}, {"start": 2159.84, "end": 2160.44, "text": "为何"}, {"start": 2161.04, "end": 2164.04, "text": "因为在天下大半士族眼里"}, {"start": 2164.24, "end": 2166.24, "text": "丞相虽然脱名汉相"}, {"start": 2166.44, "end": 2167.64, "text": "是位汉贼"}, {"start": 2168.24, "end": 2170.84, "text": "而刘备虽然苍首匹夫"}, {"start": 2171.24, "end": 2172.84, "text": "却是当今皇叔"}, {"start": 2173.64, "end": 2175.04, "text": "是大汉正统"}, {"start": 2176.44, "end": 2177.24, "text": "丞相啊"}, {"start": 2177.84, "end": 2180.24, "text": "汉氏虽衰而未亡"}, {"start": 2180.44, "end": 2183.04, "text": "百族大宠随死而未将"}, {"start": 2184.04, "end": 2184.84, "text": "实际上"}, {"start": 2185.44, "end": 2188.24, "text": "人心仍然像汉不像曹"}, {"start": 2188.64, "end": 2190.95, "text": "天道所致"}, {"start": 2191.95, "end": 2194.55, "text": "这就是丞相兵败的根本原因"}, {"start": 2194.75, "end": 2197.12, "text": "继续说"}, {"start": 2197.92, "end": 2198.92, "text": "治病之后"}, {"start": 2200.72, "end": 2202.72, "text": "天下将分为三分之十"}, {"start": 2203.12, "end": 2204.12, "text": "丞相为一方"}, {"start": 2204.52, "end": 2206.92, "text": "独霸于中原及其北国"}, {"start": 2207.32, "end": 2208.52, "text": "孙权为一方"}, {"start": 2208.52, "end": 2209.72, "text": "刘备为另一方"}, {"start": 2210.32, "end": 2213.52, "text": "他们二人将彼此称雄于江南"}, {"start": 2213.52, "end": 2216.12, "text": "且争斗于荆州及其西川"}, {"start": 2216.32, "end": 2218.72, "text": "罪徒以为十年之内"}, {"start": 2220.32, "end": 2223.12, "text": "丞相怕是难以一统天下了"}, {"start": 2224.12, "end": 2225.72, "text": "因为丞相要公留"}, {"start": 2226.32, "end": 2227.92, "text": "孙权必相援"}, {"start": 2228.32, "end": 2230.52, "text": "公孙刘备断其后"}, {"start": 2231.72, "end": 2232.92, "text": "丞相能做的"}, {"start": 2233.92, "end": 2235.32, "text": "就是整理军纪"}, {"start": 2235.92, "end": 2237.12, "text": "肯编屯粮"}, {"start": 2237.32, "end": 2238.52, "text": "减免税赋"}, {"start": 2238.72, "end": 2239.92, "text": "复国强兵"}, {"start": 2240.12, "end": 2242.72, "text": "丞相只要把中原四周治理好了"}, {"start": 2242.92, "end": 2244.72, "text": "丞相就能居高临下"}, {"start": 2244.72, "end": 2245.92, "text": "居强临弱"}, {"start": 2246.32, "end": 2247.72, "text": "在三国之争中"}, {"start": 2247.92, "end": 2249.72, "text": "始终立于不败之地"}, {"start": 2250.12, "end": 2251.12, "text": "十年之后"}, {"start": 2251.52, "end": 2252.72, "text": "局势必变"}, {"start": 2253.12, "end": 2253.92, "text": "那时"}, {"start": 2254.92, "end": 2257.72, "text": "丞相只需举天子令旗"}, {"start": 2258.52, "end": 2260.32, "text": "前三十万境遇难征"}, {"start": 2260.92, "end": 2262.52, "text": "定然处处受手"}, {"start": 2262.52, "end": 2263.52, "text": "马到攻城"}, {"start": 2264.52, "end": 2265.92, "text": "甚至兵不血染"}, {"start": 2266.72, "end": 2267.92, "text": "顺其自然"}, {"start": 2268.72, "end": 2269.92, "text": "顺其自然"}, {"start": 2270.12, "end": 2272.92, "text": "即可停整个天下收入囊中"}, {"start": 2276.55, "end": 2277.75, "text": "真没想到"}, {"start": 2278.55, "end": 2279.95, "text": "许昌城中"}, {"start": 2280.75, "end": 2283.55, "text": "还有第二个人有此见识"}, {"start": 2283.75, "end": 2287.06, "text": "那一人是谁"}, {"start": 2287.46, "end": 2288.06, "text": "我"}, {"start": 2297.4, "end": 2298.8, "text": "最土恭喜丞相"}, {"start": 2301.63, "end": 2302.83, "text": "十年哪"}, {"start": 2304.03, "end": 2306.43, "text": "天知道我还能不能活十年"}, {"start": 2307.23, "end": 2308.63, "text": "或许我这辈子"}, {"start": 2309.03, "end": 2311.63, "text": "都见不到一统天下的时候了"}, {"start": 2313.56, "end": 2314.56, "text": "谋事在人"}, {"start": 2314.56, "end": 2315.76, "text": "诚事在天"}, {"start": 2316.16, "end": 2318.56, "text": "智者既能奋发不休"}, {"start": 2318.56, "end": 2320.76, "text": "就能尽人事顺天命"}, {"start": 2329.92, "end": 2332.32, "text": "对酒当歌人生几何"}, {"start": 2332.32, "end": 2334.12, "text": "这不是我的诗句吗"}, {"start": 2334.92, "end": 2336.92, "text": "正是丞相的短歌行"}, {"start": 2338.12, "end": 2340.12, "text": "现在他已经流传天下了"}, {"start": 2340.52, "end": 2341.72, "text": "最土以为"}, {"start": 2342.32, "end": 2343.52, "text": "丞相此事"}, {"start": 2343.92, "end": 2346.12, "text": "雄把古今空前绝后"}, {"start": 2348.31, "end": 2349.91, "text": "最土对他爱不释手"}, {"start": 2356.26, "end": 2357.86, "text": "你真的姓马"}, {"start": 2361.98, "end": 2363.38, "text": "我认得这笔记"}, {"start": 2365.86, "end": 2368.06, "text": "你根本就不叫什么马衡"}, {"start": 2368.46, "end": 2369.86, "text": "你的真名叫"}, {"start": 2370.46, "end": 2371.86, "text": "司马夷"}, {"start": 2372.06, "end": 2373.46, "text": "字重达"}, {"start": 2376.8, "end": 2378.4, "text": "罪徒司马夷"}, {"start": 2379.8, "end": 2380.8, "text": "拜见丞相"}, {"start": 2390.03, "end": 2391.03, "text": "五年前"}, {"start": 2391.43, "end": 2393.43, "text": "我就多次听人举荐过你"}, {"start": 2393.63, "end": 2395.43, "text": "说你才识仇群"}, {"start": 2397.11, "end": 2398.11, "text": "我曾经"}, {"start": 2398.31, "end": 2399.91, "text": "派人请你来做官"}, {"start": 2400.31, "end": 2402.51, "text": "你躺在床上假装贪了"}, {"start": 2402.71, "end": 2403.91, "text": "拒不应招"}, {"start": 2404.51, "end": 2405.51, "text": "两年后"}, {"start": 2406.51, "end": 2408.11, "text": "我又派人去招你"}, {"start": 2409.11, "end": 2410.31, "text": "我还下令"}, {"start": 2410.71, "end": 2412.71, "text": "如果你不愿意来就抓你"}, {"start": 2414.11, "end": 2416.91, "text": "结果你却抢先一步逃走了"}, {"start": 2417.11, "end": 2419.51, "text": "最后他们只取回了你的诗文"}, {"start": 2419.91, "end": 2421.91, "text": "最后我也多次派人拿你"}, {"start": 2421.91, "end": 2424.71, "text": "部署们把中原各州郡都查访遍了"}, {"start": 2425.11, "end": 2427.31, "text": "没想到你却躲到这儿"}, {"start": 2429.91, "end": 2431.11, "text": "在下也没想到"}, {"start": 2431.51, "end": 2433.71, "text": "丞相能够认出在下的笔迹"}, {"start": 2435.51, "end": 2436.71, "text": "我那是讹你呢"}, {"start": 2436.91, "end": 2439.31, "text": "其实我根本就记不住你的笔迹"}, {"start": 2441.96, "end": 2443.36, "text": "不过你的相貌"}, {"start": 2443.56, "end": 2446.56, "text": "跟令兄司马朗倒是有几分相似"}, {"start": 2446.96, "end": 2448.36, "text": "欲中一席话"}, {"start": 2448.56, "end": 2449.76, "text": "又见识深远"}, {"start": 2450.96, "end": 2452.56, "text": "我猜你就是司马夷"}, {"start": 2452.56, "end": 2453.76, "text": "当下断合"}, {"start": 2453.96, "end": 2454.96, "text": "果然如此"}, {"start": 2455.36, "end": 2457.36, "text": "在下若要隐瞒真相"}, {"start": 2457.96, "end": 2459.76, "text": "也不敢在牙手里含睡了"}, {"start": 2461.56, "end": 2462.76, "text": "此话何意"}]