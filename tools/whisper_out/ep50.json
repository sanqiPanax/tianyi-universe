[{"start": 10.51, "end": 12.71, "text": "对面的那个人就是关羽吗"}, {"start": 13.51, "end": 15.71, "text": "怎么只带了几百个人来呀"}, {"start": 16.91, "end": 18.51, "text": "兵不在多而在精"}, {"start": 19.11, "end": 21.51, "text": "黄将军切不可轻视关羽"}, {"start": 22.51, "end": 24.51, "text": "此人曾在万军从中"}, {"start": 24.51, "end": 25.91, "text": "斩颜良诸文丑"}, {"start": 25.91, "end": 27.31, "text": "而且是匹马担刀"}, {"start": 27.31, "end": 28.71, "text": "过五关斩六将"}, {"start": 28.71, "end": 29.71, "text": "无人能敌"}, {"start": 29.71, "end": 30.71, "text": "韩大人哪"}, {"start": 30.91, "end": 32.31, "text": "这些区区小事"}, {"start": 32.31, "end": 33.71, "text": "黄某都听说过"}, {"start": 33.71, "end": 34.91, "text": "不值一审"}, {"start": 35.51, "end": 41.65, "text": "主公不必忧虑"}, {"start": 41.85, "end": 43.45, "text": "凭我手上长刀"}, {"start": 43.45, "end": 44.85, "text": "安下雕工"}, {"start": 44.85, "end": 46.85, "text": "一千个来一千个死"}, {"start": 46.85, "end": 47.85, "text": "几谷挖"}, {"start": 48.05, "end": 49.45, "text": "大人拭目以待"}, {"start": 49.45, "end": 50.65, "text": "看我刀斩哪"}, {"start": 50.65, "end": 51.45, "text": "关羽"}, {"start": 52.45, "end": 54.25, "text": "何须老将军出马"}, {"start": 54.45, "end": 56.45, "text": "待在下勤拿关羽"}, {"start": 56.45, "end": 57.25, "text": "好啊"}, {"start": 57.85, "end": 58.85, "text": "众杨将军"}, {"start": 59.25, "end": 60.65, "text": "先行出战"}, {"start": 60.85, "end": 63.45, "text": "为我长沙军斩将立威"}, {"start": 63.45, "end": 64.25, "text": "遵令"}, {"start": 65.25, "end": 75.41, "text": "你重重雷鼓"}, {"start": 75.41, "end": 76.81, "text": "众军士齐声呐喊"}, {"start": 76.81, "end": 78.01, "text": "为杨令助威"}, {"start": 78.01, "end": 78.61, "text": "遵命"}, {"start": 81.32, "end": 84.44, "text": "伟严 雷鼓"}, {"start": 84.84, "end": 85.44, "text": "大人"}, {"start": 86.44, "end": 88.84, "text": "杨将军已经听不到鼓声了"}, {"start": 92.54, "end": 93.94, "text": "黄忠 黄忠"}, {"start": 93.94, "end": 95.14, "text": "属下在此"}, {"start": 95.74, "end": 96.94, "text": "传令撤军吧"}, {"start": 99.14, "end": 99.74, "text": "不撤"}, {"start": 100.34, "end": 101.34, "text": "为何不撤"}, {"start": 101.74, "end": 103.94, "text": "因为天下没有第二个长沙"}, {"start": 103.94, "end": 105.94, "text": "人间也没有第二个黄忠"}, {"start": 105.94, "end": 106.94, "text": "待我拿他"}, {"start": 110.55, "end": 111.75, "text": "黄忠来人"}, {"start": 116.44, "end": 117.84, "text": "你就是黄忠"}, {"start": 118.24, "end": 120.44, "text": "既知我名 怎敢犯境"}, {"start": 122.04, "end": 122.64, "text": "回去吧"}, {"start": 123.04, "end": 124.24, "text": "你太老了"}, {"start": 124.84, "end": 127.24, "text": "官某的大刀不斩老幼"}, {"start": 131.38, "end": 132.58, "text": "族下岂不闻"}, {"start": 132.58, "end": 134.98, "text": "连坡六十上有余勇"}, {"start": 135.18, "end": 135.98, "text": "有我在"}, {"start": 135.98, "end": 137.58, "text": "你进不了长沙"}, {"start": 137.58, "end": 138.38, "text": "看刀"}, {"start": 149.76, "end": 303.99, "text": "黄将军竟然能追上他"}, {"start": 303.99, "end": 305.59, "text": "这不是关羽士斩又是战马"}, {"start": 305.79, "end": 345.22, "text": "你胜了"}, {"start": 346.02, "end": 347.22, "text": "我这颗人头"}, {"start": 347.82, "end": 348.82, "text": "你拿去吧"}, {"start": 349.62, "end": 350.42, "text": "我说过"}, {"start": 351.42, "end": 352.82, "text": "我从不杀老幼"}, {"start": 381.79, "end": 382.79, "text": "黄将军"}, {"start": 383.59, "end": 384.79, "text": "你的作计呢"}, {"start": 385.19, "end": 386.59, "text": "那马九叔战阵"}, {"start": 386.59, "end": 387.99, "text": "尸体栽倒了"}, {"start": 388.19, "end": 390.39, "text": "因此我败了一阵"}, {"start": 391.19, "end": 392.39, "text": "你的保调功呢"}, {"start": 392.39, "end": 393.99, "text": "也有百步穿杨的本领"}, {"start": 394.19, "end": 395.39, "text": "箭无虚发"}, {"start": 395.79, "end": 397.79, "text": "为何只跟他一味斗刀"}, {"start": 398.19, "end": 399.59, "text": "而不射杀关羽"}, {"start": 400.99, "end": 401.99, "text": "明日再战时"}, {"start": 401.99, "end": 403.79, "text": "我定射死那关羽"}, {"start": 404.39, "end": 404.99, "text": "好"}, {"start": 405.19, "end": 405.99, "text": "来人"}, {"start": 406.39, "end": 408.39, "text": "将我的宝马赠予黄忠"}, {"start": 408.79, "end": 409.99, "text": "祝你再战关羽"}, {"start": 410.59, "end": 411.59, "text": "谢大人"}, {"start": 417.76, "end": 419.96, "text": "黄忠说他的作计"}, {"start": 420.36, "end": 421.76, "text": "九叔战阵"}, {"start": 422.36, "end": 423.56, "text": "方才落马"}, {"start": 425.36, "end": 427.16, "text": "在下感觉"}, {"start": 428.76, "end": 430.96, "text": "此言断不可信"}, {"start": 433.76, "end": 434.56, "text": "为何"}, {"start": 435.16, "end": 436.56, "text": "那关羽与黄忠"}, {"start": 437.16, "end": 438.56, "text": "杀出战阵"}, {"start": 440.16, "end": 442.16, "text": "有兵士随其后"}, {"start": 442.76, "end": 444.56, "text": "军士亲眼看到"}, {"start": 445.36, "end": 447.96, "text": "关羽将黄忠砍落马下"}, {"start": 448.56, "end": 449.76, "text": "却舍不得杀"}, {"start": 452.28, "end": 455.28, "text": "那军士还亲耳听到关羽说"}, {"start": 457.08, "end": 457.88, "text": "你走吧"}, {"start": 459.08, "end": 459.68, "text": "不"}, {"start": 460.08, "end": 461.28, "text": "不杀老幼"}, {"start": 461.88, "end": 462.48, "text": "你看这"}, {"start": 462.68, "end": 469.54, "text": "黄忠战败"}, {"start": 471.14, "end": 472.54, "text": "关羽少他一命"}, {"start": 472.94, "end": 475.74, "text": "可疑之处就在于此啊"}, {"start": 477.14, "end": 478.14, "text": "大人请想"}, {"start": 479.74, "end": 480.74, "text": "那关羽"}, {"start": 480.94, "end": 482.94, "text": "既然是来取长沙"}, {"start": 483.94, "end": 487.14, "text": "我等便是他的死敌啊"}, {"start": 488.74, "end": 490.34, "text": "他为何对敌"}, {"start": 490.74, "end": 492.34, "text": "舍而不杀"}, {"start": 493.54, "end": 494.94, "text": "留他一命"}, {"start": 496.34, "end": 497.54, "text": "大人请想一想"}, {"start": 499.34, "end": 500.94, "text": "这桂阳郡"}, {"start": 501.74, "end": 504.14, "text": "是如何丢的呢"}, {"start": 508.67, "end": 510.47, "text": "赵云战败陈英"}, {"start": 510.87, "end": 512.67, "text": "却舍而不杀"}, {"start": 513.87, "end": 515.87, "text": "又是陈英做了内应"}, {"start": 516.47, "end": 517.87, "text": "里应外合"}, {"start": 518.47, "end": 519.67, "text": "写了成冠"}, {"start": 520.47, "end": 522.47, "text": "大人再请想一想"}, {"start": 523.87, "end": 528.07, "text": "这武林郡又是如何丢的"}, {"start": 528.27, "end": 532.5, "text": "从事宫制"}, {"start": 532.7, "end": 535.34, "text": "与长妃赶召"}, {"start": 536.14, "end": 537.54, "text": "叛逆投敌"}, {"start": 539.86, "end": 542.66, "text": "从背后射死其太守金玄"}, {"start": 544.26, "end": 545.06, "text": "后来"}, {"start": 546.06, "end": 547.46, "text": "竟接替主子"}, {"start": 550.51, "end": 552.11, "text": "做了武林太守"}, {"start": 553.11, "end": 556.71, "text": "那今日皇中与关羽之战"}, {"start": 557.11, "end": 558.51, "text": "岂不是有"}, {"start": 558.71, "end": 561.71, "text": "异曲同工之妙吗"}, {"start": 568.26, "end": 569.66, "text": "素来中意"}, {"start": 571.88, "end": 573.28, "text": "他不会叛我"}, {"start": 575.47, "end": 577.27, "text": "我连自己的作计"}, {"start": 577.87, "end": 579.27, "text": "都送与他了"}, {"start": 579.67, "end": 581.07, "text": "大人啊"}, {"start": 581.67, "end": 584.27, "text": "这害人之心不可有"}, {"start": 584.27, "end": 588.27, "text": "可防人之心不可无啊"}, {"start": 594.46, "end": 595.26, "text": "这样"}, {"start": 596.06, "end": 597.86, "text": "明天皇中出战时"}, {"start": 598.86, "end": 600.26, "text": "我会制下严令"}, {"start": 600.86, "end": 603.46, "text": "命他临敌前开弓放箭"}, {"start": 603.66, "end": 604.86, "text": "射死关羽"}, {"start": 605.66, "end": 608.06, "text": "以皇中百步穿杨的本领"}, {"start": 608.86, "end": 610.46, "text": "要想让关羽死"}, {"start": 610.86, "end": 614.06, "text": "一箭一定能取关羽性命"}, {"start": 617.5, "end": 620.7, "text": "如果他与关羽暗中勾结"}, {"start": 621.1, "end": 622.7, "text": "就虚张声势"}, {"start": 623.5, "end": 626.7, "text": "这箭头就一定射不准了"}, {"start": 627.1, "end": 633.58, "text": "这中世间我们拭目以待"}, {"start": 634.78, "end": 636.78, "text": "这太高明了"}, {"start": 656.58, "end": 657.18, "text": "皇中"}, {"start": 657.78, "end": 659.18, "text": "既饶你不死"}, {"start": 659.78, "end": 660.98, "text": "何敢再来啊"}, {"start": 661.38, "end": 662.78, "text": "皇中施主奉路"}, {"start": 662.98, "end": 664.38, "text": "就该与主分忧"}, {"start": 664.58, "end": 666.18, "text": "头可断志不屈"}, {"start": 666.38, "end": 667.98, "text": "只要我有一口气在"}, {"start": 668.18, "end": 670.18, "text": "足下休想进长沙呀"}, {"start": 673.38, "end": 674.38, "text": "你虽年迈"}, {"start": 675.18, "end": 677.18, "text": "却是个尽忠职守的将军"}, {"start": 678.18, "end": 678.78, "text": "那好"}, {"start": 678.98, "end": 679.98, "text": "我就成全你"}, {"start": 680.18, "end": 681.18, "text": "放马过来"}, {"start": 681.98, "end": 682.58, "text": "看刀"}, {"start": 791.9, "end": 793.1, "text": "本将无罪啊"}, {"start": 793.3, "end": 798.94, "text": "你以为我瞎了吗"}, {"start": 800.49, "end": 801.49, "text": "是战关羽"}, {"start": 801.89, "end": 803.29, "text": "你马是前蹄"}, {"start": 803.49, "end": 805.97, "text": "不忍杀辱"}, {"start": 807.37, "end": 809.57, "text": "这期间就必有关通了"}, {"start": 809.97, "end": 811.17, "text": "今日出战"}, {"start": 811.57, "end": 813.57, "text": "你两番虚拽攻险"}, {"start": 814.17, "end": 817.17, "text": "第三箭却只射他冒金"}, {"start": 818.37, "end": 819.57, "text": "这不是通贼"}, {"start": 820.37, "end": 821.17, "text": "又是什么"}, {"start": 829.59, "end": 830.79, "text": "若不杀辱"}, {"start": 830.99, "end": 832.59, "text": "必为长沙后患"}, {"start": 833.99, "end": 834.59, "text": "听令"}, {"start": 834.79, "end": 838.5, "text": "皇中推出府门"}, {"start": 838.9, "end": 839.9, "text": "当众斩首"}, {"start": 840.1, "end": 840.9, "text": "以敬小友"}, {"start": 840.9, "end": 841.3, "text": "诺"}, {"start": 841.3, "end": 842.9, "text": "大人 大人 大人"}, {"start": 842.9, "end": 843.9, "text": "好 好 好"}, {"start": 843.9, "end": 844.9, "text": "让老精请坐"}, {"start": 844.9, "end": 845.9, "text": "让老精请坐"}, {"start": 845.9, "end": 846.9, "text": "让老精请坐"}, {"start": 846.9, "end": 847.7, "text": "让老精请坐"}, {"start": 847.7, "end": 848.3, "text": "住口"}, {"start": 850.82, "end": 853.22, "text": "你们是想学武林城的拱志啊"}, {"start": 854.22, "end": 856.02, "text": "谁再给皇中说情"}, {"start": 857.42, "end": 858.82, "text": "与他缤嘴论处"}, {"start": 869.55, "end": 870.55, "text": "不与你们动手"}, {"start": 872.35, "end": 873.35, "text": "我自己来"}, {"start": 906.94, "end": 908.34, "text": "皇中通敌"}, {"start": 908.74, "end": 910.34, "text": "依法处死"}, {"start": 910.94, "end": 912.34, "text": "刀斧手听令"}, {"start": 927.99, "end": 928.59, "text": "未言"}, {"start": 928.99, "end": 930.99, "text": "你 你想造反"}, {"start": 932.59, "end": 935.39, "text": "汉生将军是长沙的屏障"}, {"start": 935.59, "end": 936.39, "text": "杀了他"}, {"start": 936.59, "end": 938.59, "text": "就等于是杀了全城的百姓"}, {"start": 939.19, "end": 940.59, "text": "皇中通敌"}, {"start": 940.59, "end": 942.59, "text": "太守下令斩首"}, {"start": 942.79, "end": 943.39, "text": "未言"}, {"start": 943.39, "end": 943.99, "text": "你"}, {"start": 944.59, "end": 945.99, "text": "你敢抗命"}, {"start": 946.39, "end": 948.39, "text": "连你一并斩首"}, {"start": 949.39, "end": 951.19, "text": "韩玄算什么东西"}, {"start": 951.59, "end": 953.59, "text": "残暴不仁 倾贤卖势"}, {"start": 953.59, "end": 954.79, "text": "祸害称上"}, {"start": 955.39, "end": 957.19, "text": "我早就想为民除害了"}, {"start": 957.79, "end": 958.59, "text": "中军士"}, {"start": 958.99, "end": 962.23, "text": "随我举议"}, {"start": 962.23, "end": 963.63, "text": "捕杀韩玄"}, {"start": 963.63, "end": 965.03, "text": "投奔流黄庐"}, {"start": 965.03, "end": 968.03, "text": "举议 举议 举议"}, {"start": 968.03, "end": 973.04, "text": "举议 举议"}, {"start": 973.04, "end": 973.24, "text": "举议 举议"}, {"start": 973.24, "end": 973.44, "text": "举议 举议"}, {"start": 973.44, "end": 973.64, "text": "举议 举议"}, {"start": 973.64, "end": 973.84, "text": "举议 举议"}, {"start": 973.84, "end": 974.04, "text": "举议 举议"}, {"start": 974.04, "end": 974.14, "text": "举议 举议"}, {"start": 974.14, "end": 974.24, "text": "举议 举议"}, {"start": 974.24, "end": 974.44, "text": "举议 举议"}, {"start": 974.44, "end": 974.64, "text": "举议 举议"}, {"start": 974.64, "end": 974.74, "text": "举议 举议"}, {"start": 975.14, "end": 975.74, "text": "魏妍"}, {"start": 975.94, "end": 976.74, "text": "快放下剑"}, {"start": 976.94, "end": 977.54, "text": "快乱来"}, {"start": 977.54, "end": 994.26, "text": "韩玄在哪里"}, {"start": 1004.76, "end": 1005.36, "text": "魏妍"}, {"start": 1005.96, "end": 1007.16, "text": "你要 你要干什么"}, {"start": 1010.24, "end": 1011.24, "text": "我要杀贼"}, {"start": 1013.04, "end": 1013.64, "text": "魏妍"}, {"start": 1014.84, "end": 1015.84, "text": "我待你不薄"}, {"start": 1017.04, "end": 1018.44, "text": "你为何要判我"}, {"start": 1019.24, "end": 1020.64, "text": "我屡力战功"}, {"start": 1021.24, "end": 1022.64, "text": "但你却有功不赏"}, {"start": 1022.64, "end": 1023.64, "text": "无罪缺乏"}, {"start": 1024.24, "end": 1026.44, "text": "让我做一个偏君校位"}, {"start": 1030.46, "end": 1032.46, "text": "这还叫不薄吗"}, {"start": 1036.06, "end": 1038.97, "text": "可造刺"}, {"start": 1042.76, "end": 1043.36, "text": "魏妍"}, {"start": 1044.36, "end": 1045.96, "text": "你为何杀了韩太守"}, {"start": 1046.16, "end": 1047.56, "text": "韩生不必惊慌"}, {"start": 1048.36, "end": 1049.56, "text": "这样子太守死了"}, {"start": 1049.76, "end": 1050.96, "text": "那是一城之务"}, {"start": 1055.52, "end": 1056.12, "text": "黄将军"}, {"start": 1057.12, "end": 1058.52, "text": "在这长沙城文武中"}, {"start": 1059.12, "end": 1060.32, "text": "属你德高望重"}, {"start": 1061.52, "end": 1062.52, "text": "我等请你领衔"}, {"start": 1063.12, "end": 1064.32, "text": "我们一起打开城门"}, {"start": 1064.72, "end": 1065.72, "text": "迎接刘备吧"}, {"start": 1073.24, "end": 1075.24, "text": "你以为我和你一样下作"}, {"start": 1076.64, "end": 1078.44, "text": "这种背祖求荣的事"}, {"start": 1078.44, "end": 1079.64, "text": "足下自辩吧"}, {"start": 1080.44, "end": 1081.04, "text": "将军"}, {"start": 1081.44, "end": 1082.04, "text": "殷长"}, {"start": 1084.15, "end": 1096.87, "text": "拜见主公军师"}, {"start": 1098.47, "end": 1100.27, "text": "殷长 殷长"}, {"start": 1100.47, "end": 1101.47, "text": "我前日起身"}, {"start": 1104.16, "end": 1105.56, "text": "只见营中轻骑盗卷"}, {"start": 1105.96, "end": 1107.16, "text": "医押自北南飞"}, {"start": 1107.36, "end": 1108.76, "text": "连教三声而去"}, {"start": 1108.96, "end": 1109.96, "text": "我便问军师"}, {"start": 1110.16, "end": 1111.56, "text": "此诏何应获福啊"}, {"start": 1111.76, "end": 1112.96, "text": "军师袖战一刻"}, {"start": 1113.16, "end": 1114.36, "text": "说长沙军已得"}, {"start": 1114.56, "end": 1115.56, "text": "我都不敢相信"}, {"start": 1115.76, "end": 1116.96, "text": "结果当天下午"}, {"start": 1117.16, "end": 1118.36, "text": "便收到了你的结报"}, {"start": 1119.76, "end": 1122.16, "text": "大哥让我三十日取下长城"}, {"start": 1122.16, "end": 1124.16, "text": "让我三十日取下长沙"}, {"start": 1124.56, "end": 1125.36, "text": "而今天"}, {"start": 1126.36, "end": 1127.76, "text": "已经十九天了"}, {"start": 1128.56, "end": 1129.76, "text": "更可赞的是"}, {"start": 1129.96, "end": 1131.36, "text": "云长只用五百孝刀手"}, {"start": 1131.56, "end": 1132.76, "text": "便取下了长沙"}, {"start": 1132.96, "end": 1133.96, "text": "如此勇烈"}, {"start": 1134.16, "end": 1136.36, "text": "无异于当年过五关斩六将"}, {"start": 1138.44, "end": 1139.04, "text": "大哥"}, {"start": 1139.24, "end": 1139.84, "text": "军师"}, {"start": 1140.24, "end": 1141.24, "text": "请入蜀崖"}, {"start": 1144.04, "end": 1146.64, "text": "这长沙军到底非小军"}, {"start": 1147.84, "end": 1149.24, "text": "太守蜀崖"}, {"start": 1149.44, "end": 1150.84, "text": "气派非凡啊"}, {"start": 1151.84, "end": 1153.24, "text": "那黄忠怎么样了"}, {"start": 1153.84, "end": 1155.84, "text": "这个老黄忠真是个英雄啊"}, {"start": 1156.04, "end": 1157.64, "text": "我和他交手两日"}, {"start": 1157.84, "end": 1159.24, "text": "大战三百回合"}, {"start": 1159.44, "end": 1160.44, "text": "不分胜负"}, {"start": 1160.84, "end": 1161.64, "text": "他人呢"}, {"start": 1162.04, "end": 1163.24, "text": "快快请来相见"}, {"start": 1164.44, "end": 1165.44, "text": "你们来之前"}, {"start": 1165.64, "end": 1167.24, "text": "我请他出来迎候"}, {"start": 1167.64, "end": 1170.04, "text": "日后也好辅佐兄长"}, {"start": 1170.24, "end": 1172.64, "text": "可他托兵拒绝了"}, {"start": 1173.04, "end": 1177.62, "text": "我早就知道"}, {"start": 1177.82, "end": 1179.02, "text": "这黄瀚生"}, {"start": 1179.22, "end": 1181.42, "text": "在长沙军民中威望甚高"}, {"start": 1182.02, "end": 1183.62, "text": "我若得不到他的辅助"}, {"start": 1183.62, "end": 1185.62, "text": "便难得长沙一军的民心"}, {"start": 1186.62, "end": 1187.82, "text": "主公说得甚是"}, {"start": 1188.22, "end": 1189.62, "text": "既然汉生撑病"}, {"start": 1190.02, "end": 1192.02, "text": "主公就应该亲自探陪"}, {"start": 1192.22, "end": 1193.22, "text": "好剑法"}, {"start": 1193.42, "end": 1222.62, "text": "此功无力"}, {"start": 1222.82, "end": 1241.79, "text": "剑头没有穿透银壶"}, {"start": 1241.99, "end": 1243.19, "text": "在下刘备"}, {"start": 1256.41, "end": 1257.61, "text": "久仰将军大名"}, {"start": 1257.81, "end": 1258.81, "text": "故不揣冒昧"}, {"start": 1259.01, "end": 1260.21, "text": "前来拜访"}, {"start": 1260.61, "end": 1262.41, "text": "我知道你是刘皇叔"}, {"start": 1262.61, "end": 1265.21, "text": "可不知道你是怎么进来的"}, {"start": 1265.81, "end": 1267.21, "text": "诸夏府门大厂"}, {"start": 1267.41, "end": 1269.01, "text": "在下不请自如"}, {"start": 1269.01, "end": 1270.21, "text": "如果我请你出去"}, {"start": 1270.41, "end": 1272.01, "text": "你会出去吗"}, {"start": 1272.41, "end": 1273.21, "text": "会"}, {"start": 1273.61, "end": 1275.41, "text": "但我会一直在府门等候"}, {"start": 1275.61, "end": 1279.45, "text": "直到将军准我进来"}, {"start": 1281.25, "end": 1284.08, "text": "此处无座"}, {"start": 1284.28, "end": 1286.68, "text": "请皇叔入内拜茶吧"}, {"start": 1287.68, "end": 1288.48, "text": "不必了"}, {"start": 1288.88, "end": 1291.48, "text": "何不席地而坐 开城相谈"}, {"start": 1291.68, "end": 1292.68, "text": "黄老将军"}, {"start": 1310.53, "end": 1311.73, "text": "今日在下"}, {"start": 1311.93, "end": 1314.33, "text": "是想请将军出山相助的"}, {"start": 1314.73, "end": 1315.93, "text": "这些年间"}, {"start": 1315.93, "end": 1321.1, "text": "奸雄祸国"}, {"start": 1321.5, "end": 1323.1, "text": "天子盟臣"}, {"start": 1323.7, "end": 1325.1, "text": "刚长金锥"}, {"start": 1325.5, "end": 1327.9, "text": "黎民百姓更是饱受苦难"}, {"start": 1328.1, "end": 1330.1, "text": "我等这些大汉臣子们"}, {"start": 1330.3, "end": 1333.52, "text": "何忍作势啊"}, {"start": 1333.72, "end": 1336.12, "text": "我老了也厌倦了"}, {"start": 1336.32, "end": 1342.27, "text": "心灰意蓝"}, {"start": 1342.87, "end": 1345.67, "text": "全无功名大业之念了"}, {"start": 1346.87, "end": 1347.87, "text": "非也"}, {"start": 1348.07, "end": 1349.87, "text": "将军名字为忠"}, {"start": 1350.07, "end": 1353.19, "text": "人如其名"}, {"start": 1353.39, "end": 1356.89, "text": "事忠贞如性命"}, {"start": 1356.89, "end": 1358.09, "text": "自汉生"}, {"start": 1358.29, "end": 1360.69, "text": "可见是为大汉而生"}, {"start": 1360.89, "end": 1362.49, "text": "盼望大汉太平"}, {"start": 1362.69, "end": 1364.29, "text": "繁荣生平啊"}, {"start": 1364.89, "end": 1366.69, "text": "仅从将军的性命中"}, {"start": 1366.89, "end": 1369.69, "text": "就足见将军的雄心壮志了"}, {"start": 1370.89, "end": 1371.89, "text": "更何况"}, {"start": 1372.09, "end": 1373.89, "text": "将军虽年长些"}, {"start": 1374.29, "end": 1375.89, "text": "但武艺盖世"}, {"start": 1376.09, "end": 1377.29, "text": "忠勇无双"}, {"start": 1377.49, "end": 1378.89, "text": "一口金背大刀"}, {"start": 1379.09, "end": 1380.89, "text": "竟让官羽敬佩不已"}, {"start": 1381.09, "end": 1382.29, "text": "时常赞叹"}, {"start": 1382.49, "end": 1383.09, "text": "还有"}, {"start": 1383.29, "end": 1384.69, "text": "所有的将军"}, {"start": 1387.58, "end": 1388.38, "text": "还有"}, {"start": 1388.58, "end": 1389.78, "text": "所持宝雕弓"}, {"start": 1389.98, "end": 1392.18, "text": "百步穿杨剑舞叙发"}, {"start": 1392.38, "end": 1393.78, "text": "连张飞和子龙"}, {"start": 1393.98, "end": 1396.32, "text": "都自叹不如"}, {"start": 1396.52, "end": 1397.52, "text": "将军啊"}, {"start": 1398.12, "end": 1400.72, "text": "你不仅是长沙威望所在"}, {"start": 1401.12, "end": 1402.92, "text": "更是天下之助"}, {"start": 1404.67, "end": 1407.07, "text": "皇叔过誉了"}, {"start": 1408.47, "end": 1409.47, "text": "皇将军"}, {"start": 1410.27, "end": 1411.67, "text": "大汉将位"}, {"start": 1412.67, "end": 1414.87, "text": "只有你这样的英雄豪杰"}, {"start": 1415.07, "end": 1422.08, "text": "才可以擎天助地"}, {"start": 1422.28, "end": 1423.28, "text": "是想请你"}, {"start": 1423.48, "end": 1425.28, "text": "相助一臂之力的"}, {"start": 1440.56, "end": 1443.36, "text": "在下对将军虽然渴望已久"}, {"start": 1443.76, "end": 1445.76, "text": "但实事不敢勉强"}, {"start": 1446.56, "end": 1449.36, "text": "希望将军三思而后决"}, {"start": 1449.96, "end": 1451.76, "text": "我会一直等候将军"}, {"start": 1459.06, "end": 1465.34, "text": "我有一个愿望"}, {"start": 1465.54, "end": 1466.34, "text": "请讲"}, {"start": 1470.68, "end": 1472.28, "text": "韩玄虽然无道"}, {"start": 1472.68, "end": 1474.28, "text": "可他是我的救主"}, {"start": 1475.68, "end": 1477.68, "text": "我想起回他的尸体"}, {"start": 1478.68, "end": 1480.68, "text": "厚葬于南山"}, {"start": 1481.28, "end": 1482.48, "text": "如将军不弃"}, {"start": 1482.68, "end": 1483.88, "text": "下葬之日"}, {"start": 1484.08, "end": 1485.88, "text": "我与将军共同祭奠"}, {"start": 1487.82, "end": 1489.02, "text": "多谢"}, {"start": 1500.65, "end": 1501.45, "text": "魏将军请"}, {"start": 1507.04, "end": 1508.64, "text": "主公和军师在里面候着呢"}, {"start": 1509.04, "end": 1509.84, "text": "请进吧"}, {"start": 1535.14, "end": 1536.54, "text": "末将拜见主公"}, {"start": 1536.94, "end": 1538.34, "text": "拜见孔明先生"}, {"start": 1543.36, "end": 1544.96, "text": "你就是首任韩玄"}, {"start": 1545.36, "end": 1547.16, "text": "开城献祥的魏炎吧"}, {"start": 1549.32, "end": 1550.12, "text": "正是在下"}, {"start": 1551.32, "end": 1551.92, "text": "左右"}, {"start": 1552.12, "end": 1552.72, "text": "在"}, {"start": 1552.92, "end": 1554.12, "text": "将此人拖下去斩了"}, {"start": 1554.32, "end": 1554.92, "text": "诺"}, {"start": 1556.52, "end": 1557.12, "text": "先生"}, {"start": 1557.32, "end": 1558.52, "text": "魏炎无罪啊"}, {"start": 1563.54, "end": 1564.34, "text": "主公"}, {"start": 1573.95, "end": 1575.75, "text": "识其路而杀其主"}, {"start": 1576.15, "end": 1576.95, "text": "不忠意"}, {"start": 1577.55, "end": 1579.15, "text": "居其土而陷其地"}, {"start": 1579.35, "end": 1580.15, "text": "不义"}, {"start": 1580.75, "end": 1585.12, "text": "如此投机小人必须杀"}, {"start": 1593.23, "end": 1594.23, "text": "话虽如此"}, {"start": 1595.03, "end": 1596.43, "text": "但若斩了此人"}, {"start": 1597.23, "end": 1598.03, "text": "只怕"}, {"start": 1598.83, "end": 1600.23, "text": "想者人人自危"}, {"start": 1600.83, "end": 1602.03, "text": "顺者不寒而栗"}, {"start": 1602.63, "end": 1604.03, "text": "还望军师宽恕"}, {"start": 1608.6, "end": 1610.0, "text": "你抬起头来看着"}, {"start": 1615.39, "end": 1615.99, "text": "听着"}, {"start": 1617.19, "end": 1619.59, "text": "我能看透人间的中间善恶"}, {"start": 1619.99, "end": 1622.19, "text": "更能看透你的隐秘心思"}, {"start": 1622.99, "end": 1624.79, "text": "今日主公替你求情"}, {"start": 1624.99, "end": 1626.19, "text": "我且饶你"}, {"start": 1626.79, "end": 1628.59, "text": "日后尽忠报主"}, {"start": 1628.79, "end": 1629.99, "text": "勿生一心"}, {"start": 1630.39, "end": 1631.59, "text": "若生一心"}, {"start": 1631.59, "end": 1633.79, "text": "哪怕是一丝一毫的一心"}, {"start": 1634.39, "end": 1636.99, "text": "我谭指尖便能取你手机"}, {"start": 1639.37, "end": 1640.37, "text": "在下谨记"}, {"start": 1640.57, "end": 1641.77, "text": "在下谨记了"}, {"start": 1646.59, "end": 1648.59, "text": "请主公赐魏炎五百斤"}, {"start": 1648.79, "end": 1651.59, "text": "升他做前军副将吧"}, {"start": 1653.72, "end": 1654.32, "text": "传命"}, {"start": 1655.52, "end": 1656.72, "text": "赠魏炎五百斤"}, {"start": 1656.72, "end": 1657.92, "text": "拜前军副将"}, {"start": 1660.82, "end": 1661.62, "text": "谢主公"}, {"start": 1662.62, "end": 1663.42, "text": "谢军师"}, {"start": 1667.06, "end": 1667.66, "text": "退下吧"}, {"start": 1668.06, "end": 1694.47, "text": "你刚才是真的想杀他"}, {"start": 1695.07, "end": 1696.27, "text": "还是做事震慑"}, {"start": 1698.44, "end": 1699.84, "text": "我是真想杀了他"}, {"start": 1700.84, "end": 1702.24, "text": "此人心存投机"}, {"start": 1702.44, "end": 1703.44, "text": "生性凶狠"}, {"start": 1704.44, "end": 1705.84, "text": "我担心此人留着"}, {"start": 1706.44, "end": 1707.84, "text": "迟早会是个祸患"}, {"start": 1709.04, "end": 1710.24, "text": "那为何又要我"}, {"start": 1710.64, "end": 1711.84, "text": "赠金升职呢"}, {"start": 1712.64, "end": 1714.84, "text": "震起胆之后便得安其心"}, {"start": 1715.24, "end": 1716.44, "text": "魏炎虽然不贤"}, {"start": 1716.44, "end": 1717.64, "text": "但敢做事"}, {"start": 1717.84, "end": 1718.84, "text": "胆大过人"}, {"start": 1719.64, "end": 1722.24, "text": "昨日营场考教过他的兵法和武艺"}, {"start": 1722.24, "end": 1723.84, "text": "所学也是颇有所长"}, {"start": 1725.44, "end": 1727.84, "text": "此人留之可律 杀之可惜"}, {"start": 1728.04, "end": 1729.44, "text": "今日主公开口"}, {"start": 1730.04, "end": 1731.44, "text": "我就趁势饶他一命"}, {"start": 1732.24, "end": 1733.64, "text": "只要主公与我健在"}, {"start": 1733.84, "end": 1736.04, "text": "魏炎就不敢起异行"}, {"start": 1738.44, "end": 1742.5, "text": "今时恩为并用"}, {"start": 1742.9, "end": 1744.7, "text": "片刻之间折服魏炎"}, {"start": 1744.7, "end": 1745.5, "text": "令人钦佩"}, {"start": 1746.1, "end": 1748.3, "text": "主公片言之间请出皇中"}, {"start": 1748.3, "end": 1749.9, "text": "这才是恩威齐恬"}, {"start": 1751.7, "end": 1752.5, "text": "主公"}, {"start": 1752.7, "end": 1753.5, "text": "主公"}, {"start": 1754.3, "end": 1755.1, "text": "主公"}, {"start": 1756.1, "end": 1756.7, "text": "主公"}, {"start": 1756.9, "end": 1757.5, "text": "军师"}, {"start": 1757.7, "end": 1758.7, "text": "金州传来急报"}, {"start": 1758.9, "end": 1760.1, "text": "说刘七公子病重"}, {"start": 1760.5, "end": 1761.5, "text": "命在旦夕啊"}, {"start": 1761.7, "end": 1762.7, "text": "也悬心"}, {"start": 1770.41, "end": 1772.61, "text": "却不能消灾免祸呀"}, {"start": 1773.01, "end": 1773.61, "text": "主公"}, {"start": 1774.41, "end": 1775.61, "text": "刘七一旦过世"}, {"start": 1776.21, "end": 1778.21, "text": "东吴内宾必生波澜"}, {"start": 1778.61, "end": 1784.68, "text": "我率三千军星夜返回荆州"}, {"start": 1785.08, "end": 1786.88, "text": "我一定要见刘七公子一面"}, {"start": 1787.28, "end": 1788.48, "text": "我随主公一起去"}, {"start": 1788.48, "end": 1789.28, "text": "谢你"}, {"start": 1818.86, "end": 1826.55, "text": "你为何众人而去"}, {"start": 1827.55, "end": 1829.35, "text": "令人痛断"}, {"start": 1829.75, "end": 1835.45, "text": "感情痛在先知"}, {"start": 1836.05, "end": 1840.79, "text": "爱在先知啊"}, {"start": 1840.99, "end": 1894.06, "text": "刘七乃大贤大义"}, {"start": 1894.26, "end": 1898.41, "text": "还记得吗"}, {"start": 1899.01, "end": 1900.41, "text": "长坂坡之后"}, {"start": 1901.21, "end": 1903.81, "text": "草草追杀我们多时"}, {"start": 1904.81, "end": 1907.61, "text": "若无刘七率船相救"}, {"start": 1907.61, "end": 1909.81, "text": "我们造成倒下之鬼"}, {"start": 1910.21, "end": 1911.61, "text": "还有赤壁之战"}, {"start": 1915.03, "end": 1916.23, "text": "刘七公子"}, {"start": 1918.51, "end": 1921.11, "text": "倾其所不为我所用"}, {"start": 1921.51, "end": 1922.71, "text": "如果无他"}, {"start": 1924.64, "end": 1926.64, "text": "何以成今日之机也"}, {"start": 1927.04, "end": 1929.04, "text": "何以有荆州啊"}, {"start": 1929.44, "end": 1936.49, "text": "刘七虽是若贯之主"}, {"start": 1937.49, "end": 1939.49, "text": "但多自助我们脱大难"}, {"start": 1939.89, "end": 1941.09, "text": "无刘七"}, {"start": 1943.14, "end": 1944.94, "text": "无我今日之生"}, {"start": 1945.34, "end": 1945.94, "text": "大哥"}, {"start": 1946.34, "end": 1949.36, "text": "公子已去"}, {"start": 1949.96, "end": 1951.56, "text": "人死人活"}, {"start": 1951.76, "end": 1953.36, "text": "人死不能复生"}, {"start": 1954.16, "end": 1954.76, "text": "大哥"}, {"start": 1955.56, "end": 1957.16, "text": "你不要太过于伤心了"}, {"start": 1957.96, "end": 1958.76, "text": "二弟"}, {"start": 1960.66, "end": 1966.44, "text": "我不仅为刘七公子难过"}, {"start": 1966.64, "end": 1969.24, "text": "也为荆乡前途担忧啊"}, {"start": 1969.84, "end": 1971.24, "text": "现在我们兵多将广"}, {"start": 1971.64, "end": 1972.64, "text": "粮草富足"}, {"start": 1973.44, "end": 1974.64, "text": "又何可担忧的"}, {"start": 1978.05, "end": 1979.45, "text": "我们占据荆州"}, {"start": 1980.65, "end": 1985.08, "text": "是用了刘七公子的名号"}, {"start": 1985.08, "end": 1985.88, "text": "而如今"}, {"start": 1987.28, "end": 1988.88, "text": "公子殡田而去"}, {"start": 1989.88, "end": 1992.28, "text": "那周瑜岂有不追讨的道理"}, {"start": 1992.28, "end": 1995.56, "text": "赤壁之意"}, {"start": 1996.16, "end": 1997.96, "text": "东吴出力最多"}, {"start": 1998.56, "end": 2000.56, "text": "在荆州城下败曹人的"}, {"start": 2000.56, "end": 2001.76, "text": "仍是周瑜"}, {"start": 2002.56, "end": 2004.16, "text": "鲁素与我们有约"}, {"start": 2004.56, "end": 2005.76, "text": "刘七如在"}, {"start": 2006.16, "end": 2007.76, "text": "荆州归刘七"}, {"start": 2008.16, "end": 2011.08, "text": "刘七如不在"}, {"start": 2011.68, "end": 2013.68, "text": "荆州当归东吴"}, {"start": 2013.88, "end": 2018.8, "text": "如果我们不见前诺"}, {"start": 2020.61, "end": 2022.61, "text": "周瑜必起刀兵"}, {"start": 2022.61, "end": 2026.74, "text": "或许主公记错了"}, {"start": 2027.74, "end": 2029.54, "text": "鲁素与我们定约时"}, {"start": 2030.34, "end": 2031.34, "text": "我说的是"}, {"start": 2032.34, "end": 2033.54, "text": "刘七如在"}, {"start": 2034.14, "end": 2035.54, "text": "荆州归刘七"}, {"start": 2036.14, "end": 2037.34, "text": "刘七如不在"}, {"start": 2037.74, "end": 2038.94, "text": "倒是在商量"}, {"start": 2039.34, "end": 2044.04, "text": "话虽如此"}, {"start": 2044.84, "end": 2046.24, "text": "可怎么商量"}, {"start": 2046.64, "end": 2048.44, "text": "人家岂肯商量啊"}, {"start": 2048.44, "end": 2049.04, "text": "大哥"}, {"start": 2050.24, "end": 2052.24, "text": "我们现在并非当年弱驴"}, {"start": 2053.98, "end": 2056.18, "text": "取下长沙四郡后"}, {"start": 2056.78, "end": 2057.98, "text": "拥并六万"}, {"start": 2058.38, "end": 2059.78, "text": "兼呈十余座"}, {"start": 2060.58, "end": 2062.98, "text": "进可攻 退可守"}, {"start": 2063.78, "end": 2065.18, "text": "周瑜若想来"}, {"start": 2065.38, "end": 2066.58, "text": "就让他来好了"}, {"start": 2067.38, "end": 2069.38, "text": "斗志有先手"}, {"start": 2069.78, "end": 2071.58, "text": "斗兵有我和易德"}, {"start": 2071.78, "end": 2074.03, "text": "本无虑"}, {"start": 2074.43, "end": 2075.03, "text": "是啊"}, {"start": 2075.23, "end": 2076.03, "text": "有我等的"}, {"start": 2076.83, "end": 2077.83, "text": "打仗好啊"}, {"start": 2079.03, "end": 2080.43, "text": "我们是越打越强"}, {"start": 2080.43, "end": 2081.83, "text": "何惧周瑜那小子"}, {"start": 2082.03, "end": 2088.72, "text": "你亏呀"}, {"start": 2091.75, "end": 2092.75, "text": "为大局起"}, {"start": 2093.75, "end": 2094.95, "text": "只要曹操在"}, {"start": 2095.35, "end": 2096.55, "text": "主公与东吴"}, {"start": 2096.55, "end": 2098.15, "text": "无论如何不可开战"}, {"start": 2099.35, "end": 2100.75, "text": "我们虽得了四郡"}, {"start": 2100.95, "end": 2102.15, "text": "但根基未稳"}, {"start": 2102.35, "end": 2103.75, "text": "兵马虽多了些"}, {"start": 2103.95, "end": 2105.55, "text": "但多为星母兵丁"}, {"start": 2105.75, "end": 2106.75, "text": "弓马不惊"}, {"start": 2107.95, "end": 2108.75, "text": "何况"}, {"start": 2109.55, "end": 2111.75, "text": "四郡还需要分兵把守"}, {"start": 2111.95, "end": 2113.35, "text": "反观周瑜所不"}, {"start": 2113.55, "end": 2114.95, "text": "他让甘宁领统"}, {"start": 2114.95, "end": 2115.95, "text": "屯兵巴黎"}, {"start": 2115.95, "end": 2117.35, "text": "全力打造军械"}, {"start": 2117.55, "end": 2118.55, "text": "操练士族"}, {"start": 2118.55, "end": 2120.15, "text": "一意待劳已久"}, {"start": 2121.35, "end": 2122.55, "text": "一旦开战"}, {"start": 2123.95, "end": 2126.15, "text": "最好的结果是两败俱伤"}, {"start": 2127.35, "end": 2128.75, "text": "最差的结果"}, {"start": 2129.35, "end": 2131.15, "text": "是我军大势崩坏"}, {"start": 2131.95, "end": 2134.55, "text": "再度落于赤壁之前的境遇"}, {"start": 2135.55, "end": 2140.6, "text": "那密不发丧"}, {"start": 2141.0, "end": 2142.2, "text": "过一阵子再说"}, {"start": 2142.8, "end": 2144.4, "text": "没有不脱风的强"}, {"start": 2146.0, "end": 2147.6, "text": "如果我们密不发丧"}, {"start": 2148.2, "end": 2149.6, "text": "万一让周瑜知道"}, {"start": 2150.2, "end": 2152.2, "text": "反而让他判明我军心虚"}, {"start": 2152.4, "end": 2155.0, "text": "促使他冒险吸取精香"}, {"start": 2157.35, "end": 2158.95, "text": "此事我心神已乱"}, {"start": 2160.92, "end": 2162.32, "text": "但我冷静几日"}, {"start": 2162.32, "end": 2163.92, "text": "再从长计议吧"}, {"start": 2164.72, "end": 2165.32, "text": "主公"}, {"start": 2165.72, "end": 2166.72, "text": "变乱在即"}, {"start": 2166.72, "end": 2167.72, "text": "事不宜迟"}, {"start": 2169.84, "end": 2170.84, "text": "您要何意"}, {"start": 2171.84, "end": 2172.64, "text": "我意"}, {"start": 2173.64, "end": 2174.84, "text": "我们不但不满"}, {"start": 2175.44, "end": 2177.24, "text": "还要主动向动物发丧"}, {"start": 2177.64, "end": 2179.24, "text": "坦率地告诉孙权他们"}, {"start": 2179.44, "end": 2181.44, "text": "荆州刺史刘奇去世死了"}, {"start": 2181.44, "end": 2182.64, "text": "我们正在治丧"}, {"start": 2184.04, "end": 2184.64, "text": "另外"}, {"start": 2184.84, "end": 2186.24, "text": "让所有兵马全部回营"}, {"start": 2186.24, "end": 2187.24, "text": "掩藏起来"}, {"start": 2187.24, "end": 2188.84, "text": "不要有一兵一卒的调动"}, {"start": 2189.84, "end": 2191.44, "text": "周瑜不知我军虚实"}, {"start": 2192.24, "end": 2193.84, "text": "或许不敢轻举妄动"}, {"start": 2194.84, "end": 2195.64, "text": "之后"}, {"start": 2196.64, "end": 2198.04, "text": "我们看动物举动"}, {"start": 2198.44, "end": 2199.64, "text": "再相继行事"}, {"start": 2209.64, "end": 2210.84, "text": "照军事说的办"}, {"start": 2211.84, "end": 2212.44, "text": "遵命"}, {"start": 2212.84, "end": 2213.44, "text": "大哥"}, {"start": 2213.64, "end": 2229.52, "text": "紫荆"}, {"start": 2231.58, "end": 2232.78, "text": "我已下了诏命"}, {"start": 2234.18, "end": 2235.58, "text": "任何人不必打扰"}, {"start": 2237.16, "end": 2238.16, "text": "可我也想"}, {"start": 2238.76, "end": 2239.96, "text": "有一个知心的人"}, {"start": 2242.08, "end": 2244.08, "text": "来让我倒到心中的苦水"}, {"start": 2244.88, "end": 2246.08, "text": "主公请讲"}, {"start": 2249.11, "end": 2250.71, "text": "此次合肥大战"}, {"start": 2252.56, "end": 2253.96, "text": "我连败于张廖"}, {"start": 2257.65, "end": 2259.05, "text": "这是我击毁以来"}, {"start": 2259.25, "end": 2260.65, "text": "第一次率兵出征"}, {"start": 2262.25, "end": 2263.65, "text": "本想借此立威的"}, {"start": 2263.85, "end": 2266.03, "text": "却不料"}, {"start": 2266.43, "end": 2267.83, "text": "连众敌军埋伏"}, {"start": 2268.43, "end": 2270.43, "text": "四千多将士阵亡"}, {"start": 2270.63, "end": 2276.34, "text": "还折了太史次将军"}, {"start": 2279.14, "end": 2280.54, "text": "反思赤壁之战"}, {"start": 2282.52, "end": 2284.12, "text": "周瑜仅用五万精兵"}, {"start": 2284.32, "end": 2286.52, "text": "就烧掉了曹操八十三万大军"}, {"start": 2287.12, "end": 2288.52, "text": "势精天下"}, {"start": 2288.92, "end": 2290.12, "text": "气吞山河"}, {"start": 2291.52, "end": 2292.72, "text": "而我身为人主"}, {"start": 2292.92, "end": 2297.63, "text": "脸自立"}, {"start": 2298.03, "end": 2303.26, "text": "还有一件事情"}, {"start": 2303.66, "end": 2306.52, "text": "更为压抑"}, {"start": 2310.54, "end": 2312.54, "text": "刘备连驱长沙四军"}, {"start": 2313.34, "end": 2314.34, "text": "并未搭阵"}, {"start": 2315.34, "end": 2315.94, "text": "不错"}, {"start": 2317.34, "end": 2318.74, "text": "就在我战败之时"}, {"start": 2319.14, "end": 2320.74, "text": "刘备却连连攻城拔寨"}, {"start": 2320.74, "end": 2321.74, "text": "我岂能不分"}, {"start": 2322.94, "end": 2323.54, "text": "自警"}, {"start": 2324.54, "end": 2325.74, "text": "我想下道诏命"}, {"start": 2328.13, "end": 2329.33, "text": "言成己过"}, {"start": 2331.2, "end": 2332.4, "text": "饮罪自责"}, {"start": 2332.6, "end": 2333.2, "text": "不可"}, {"start": 2333.6, "end": 2337.24, "text": "无过亦无罪"}, {"start": 2337.84, "end": 2339.64, "text": "即便是偶尔打了败仗"}, {"start": 2339.84, "end": 2341.24, "text": "也要像打了胜仗一样"}, {"start": 2341.24, "end": 2342.84, "text": "带给部下一志气"}, {"start": 2347.69, "end": 2349.49, "text": "无论是曹操还是刘备"}, {"start": 2349.49, "end": 2350.89, "text": "他们都是熬不过你"}, {"start": 2350.89, "end": 2352.89, "text": "他们都会死在你的前面的"}, {"start": 2359.89, "end": 2360.49, "text": "耐性"}, {"start": 2362.29, "end": 2364.09, "text": "你说的是坚韧和耐性"}, {"start": 2364.89, "end": 2365.49, "text": "正是"}, {"start": 2368.27, "end": 2368.87, "text": "主公"}, {"start": 2369.87, "end": 2371.67, "text": "在下还有一事相比"}, {"start": 2372.47, "end": 2372.87, "text": "讲"}, {"start": 2373.87, "end": 2374.47, "text": "现在"}, {"start": 2375.47, "end": 2377.47, "text": "不仅在主公面前有一座坟"}, {"start": 2378.47, "end": 2379.47, "text": "此时此刻"}, {"start": 2379.87, "end": 2380.67, "text": "在江北"}, {"start": 2380.87, "end": 2382.67, "text": "野心添了一座孤坟"}, {"start": 2383.87, "end": 2384.47, "text": "谁死了"}, {"start": 2384.67, "end": 2395.71, "text": "喝酒去"}, {"start": 2402.28, "end": 2403.88, "text": "主公何出此言呢"}, {"start": 2404.48, "end": 2405.68, "text": "三个月前"}, {"start": 2405.88, "end": 2407.28, "text": "你出使荆州"}, {"start": 2407.88, "end": 2410.08, "text": "就看出刘岐已病务高荒"}, {"start": 2410.08, "end": 2411.08, "text": "命不久矣"}, {"start": 2411.68, "end": 2413.48, "text": "你说长者半年"}, {"start": 2414.48, "end": 2415.88, "text": "短者三个月"}, {"start": 2416.28, "end": 2417.68, "text": "此人必死"}, {"start": 2418.68, "end": 2419.28, "text": "果然"}, {"start": 2419.48, "end": 2420.68, "text": "才刚过三个月"}, {"start": 2420.88, "end": 2422.08, "text": "他就真的死了"}, {"start": 2423.48, "end": 2426.28, "text": "我们现在再去向刘备索要荆州"}, {"start": 2426.68, "end": 2427.48, "text": "看他"}, {"start": 2427.68, "end": 2429.28, "text": "还有何话说"}, {"start": 2435.5, "end": 2436.5, "text": "主公啊"}, {"start": 2437.5, "end": 2439.1, "text": "刘岐固然已死"}, {"start": 2440.5, "end": 2441.3, "text": "但是"}, {"start": 2442.5, "end": 2443.5, "text": "你估计"}, {"start": 2444.1, "end": 2445.1, "text": "这荆州"}, {"start": 2445.3, "end": 2446.7, "text": "咱们要得回来吗"}, {"start": 2448.61, "end": 2449.81, "text": "你的意思是"}, {"start": 2451.21, "end": 2452.61, "text": "他们竟敢备约"}, {"start": 2454.59, "end": 2455.19, "text": "不"}, {"start": 2456.39, "end": 2457.79, "text": "在下的意思是"}, {"start": 2458.59, "end": 2460.39, "text": "如果我们去要荆州"}, {"start": 2461.19, "end": 2462.39, "text": "就要先想好了"}, {"start": 2463.59, "end": 2464.99, "text": "要得回来怎么办"}, {"start": 2465.79, "end": 2467.79, "text": "要不回来又怎么办"}]