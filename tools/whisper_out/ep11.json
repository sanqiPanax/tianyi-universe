[{"start": 4.21, "end": 7.21, "text": "我本想结交曹操这个肖雄,"}, {"start": 7.21, "end": 9.21, "text": "谁知弄巧成拙,"}, {"start": 9.21, "end": 12.21, "text": "惹起了逃遍拘祸呀,"}, {"start": 12.21, "end": 19.62, "text": "与周旦保了。"}, {"start": 19.62, "end": 22.62, "text": "父亲,曹老太爷致死,"}, {"start": 22.62, "end": 24.62, "text": "罪在贼将张凯。"}, {"start": 24.62, "end": 27.62, "text": "父亲也只是用人不明而已呀。"}, {"start": 27.62, "end": 29.62, "text": "儿子琢磨着,"}, {"start": 29.62, "end": 32.62, "text": "医者,我立刻派兵追杀张凯,"}, {"start": 32.62, "end": 34.62, "text": "务必取他手机。"}, {"start": 34.62, "end": 35.62, "text": "儿子,"}, {"start": 35.62, "end": 38.62, "text": "有我写张凯的手机去他们眼中,"}, {"start": 38.62, "end": 40.62, "text": "面向曹操向他说明事情的原本,"}, {"start": 40.62, "end": 42.62, "text": "赔礼请罪呀。"}, {"start": 42.62, "end": 43.62, "text": "对了父亲,"}, {"start": 43.62, "end": 45.62, "text": "他们不准缺手粮饷吗?"}, {"start": 45.62, "end": 48.62, "text": "我们可以再赔偿他们几十万箱,"}, {"start": 48.62, "end": 49.62, "text": "化解此事啊。"}, {"start": 49.62, "end": 60.46, "text": "你听说过一句话吗?"}, {"start": 60.46, "end": 63.46, "text": "您恳我负天下人,"}, {"start": 63.46, "end": 66.46, "text": "休叫天下人负我。"}, {"start": 66.46, "end": 72.34, "text": "这话谁说的?"}, {"start": 72.34, "end": 81.39, "text": "你现在知道他是何等人了吗?"}, {"start": 82.39, "end": 84.39, "text": "儿啊,"}, {"start": 84.39, "end": 87.39, "text": "徐州大难临头了。"}, {"start": 87.39, "end": 88.39, "text": "父亲,"}, {"start": 88.39, "end": 90.39, "text": "那我们该怎么办呢?"}, {"start": 90.39, "end": 91.39, "text": "怎么办呀父亲?"}, {"start": 91.39, "end": 96.66, "text": "即刻传命,"}, {"start": 96.66, "end": 99.66, "text": "各部召集所有兵马回防徐州,"}, {"start": 99.66, "end": 100.66, "text": "准备营地。"}, {"start": 100.66, "end": 101.66, "text": "好。"}, {"start": 101.66, "end": 104.13, "text": "等等,"}, {"start": 104.13, "end": 107.7, "text": "我还有一事,"}, {"start": 107.7, "end": 110.7, "text": "曹操要是清朝而出,"}, {"start": 110.7, "end": 112.7, "text": "仅凭我们的力量,"}, {"start": 112.7, "end": 115.7, "text": "是难以阻挡曹操的大军的。"}, {"start": 115.7, "end": 119.7, "text": "我计刻携旗到首书,"}, {"start": 119.7, "end": 120.7, "text": "你拿上它,"}, {"start": 120.7, "end": 122.7, "text": "星夜兼程,"}, {"start": 122.7, "end": 125.7, "text": "去冀州拜见袁绍,"}, {"start": 125.7, "end": 127.7, "text": "南洋的袁术,"}, {"start": 127.7, "end": 129.7, "text": "平原的公孙寨。"}, {"start": 129.7, "end": 131.7, "text": "他们距离徐州,"}, {"start": 131.7, "end": 135.7, "text": "都不过五日的行程。"}, {"start": 135.7, "end": 139.7, "text": "请他们发兵相救。"}, {"start": 139.7, "end": 140.7, "text": "你可说过,"}, {"start": 140.7, "end": 141.7, "text": "这几位诸侯,"}, {"start": 141.7, "end": 143.7, "text": "可都贪图咱们徐州城啊?"}, {"start": 143.7, "end": 146.7, "text": "正因为他们贪图徐州,"}, {"start": 146.7, "end": 150.7, "text": "才不愿意徐州落到曹操的手里啊?"}, {"start": 150.7, "end": 152.7, "text": "一旦落入曹操的手里,"}, {"start": 152.7, "end": 154.7, "text": "他便能称霸中原,"}, {"start": 154.7, "end": 156.7, "text": "对他们有违不利啊。"}, {"start": 156.7, "end": 157.7, "text": "你告诉他们,"}, {"start": 157.7, "end": 162.84, "text": "谁能劝退曹操退兵,"}, {"start": 162.84, "end": 165.84, "text": "化干戈为玉帛?"}, {"start": 165.84, "end": 167.84, "text": "我陶谦,"}, {"start": 167.84, "end": 170.84, "text": "愿意每年向他们敬送,"}, {"start": 170.84, "end": 173.84, "text": "二十万粮饷,"}, {"start": 173.84, "end": 175.84, "text": "至死不渝。"}, {"start": 175.84, "end": 179.53, "text": "好。"}, {"start": 179.53, "end": 186.49, "text": "事已至此,"}, {"start": 186.49, "end": 187.49, "text": "请主公节哀自重,"}, {"start": 187.49, "end": 189.49, "text": "请主公下令,"}, {"start": 189.49, "end": 191.49, "text": "末将只需三千精兵,"}, {"start": 191.49, "end": 194.49, "text": "五日之内便能踏平五凤山。"}, {"start": 194.49, "end": 195.49, "text": "末将保证,"}, {"start": 195.49, "end": 196.49, "text": "生擒张凯,"}, {"start": 196.49, "end": 199.49, "text": "拿他脑袋来给曹老太爷寄灵。"}, {"start": 199.49, "end": 201.49, "text": "不,"}, {"start": 201.49, "end": 204.49, "text": "为何要征缴五凤山?"}, {"start": 204.49, "end": 207.49, "text": "杀害曹公的虽然是贼人张凯,"}, {"start": 207.49, "end": 209.49, "text": "但是最后扩手,"}, {"start": 209.49, "end": 211.49, "text": "却是那徐州城里的陶谦。"}, {"start": 211.49, "end": 217.1, "text": "主公遭此大难,"}, {"start": 217.1, "end": 219.1, "text": "已经是肝肠痛断。"}, {"start": 219.1, "end": 221.1, "text": "列位可否先退下,"}, {"start": 221.1, "end": 227.85, "text": "让主公稍早休息。"}, {"start": 227.85, "end": 242.67, "text": "走走走。"}, {"start": 242.67, "end": 246.34, "text": "在下一者能悲伤,"}, {"start": 246.34, "end": 257.06, "text": "二者给主公道喜。"}, {"start": 257.06, "end": 259.06, "text": "你胡说什么?"}, {"start": 259.06, "end": 261.06, "text": "家父刚刚过世,"}, {"start": 261.06, "end": 264.3, "text": "我何喜之有?"}, {"start": 264.3, "end": 266.3, "text": "福中有祸,"}, {"start": 266.3, "end": 268.3, "text": "祸中有福,"}, {"start": 268.3, "end": 270.3, "text": "福祸相医,"}, {"start": 270.3, "end": 275.57, "text": "大势可期。"}, {"start": 275.57, "end": 279.57, "text": "你所说的祸中之福指的是什么?"}, {"start": 279.57, "end": 281.57, "text": "主公心如明镜,"}, {"start": 281.57, "end": 286.87, "text": "何必要拷问在下?"}, {"start": 286.87, "end": 288.87, "text": "主公自起兵两年以来,"}, {"start": 288.87, "end": 290.87, "text": "势如破竹,"}, {"start": 290.87, "end": 291.87, "text": "威震四方,"}, {"start": 291.87, "end": 295.87, "text": "但却有一桩难言之隐。"}, {"start": 295.87, "end": 296.87, "text": "那就是,"}, {"start": 296.87, "end": 298.87, "text": "虽然拥兵二十一万,"}, {"start": 298.87, "end": 304.15, "text": "却只能折服与远州一余。"}, {"start": 304.15, "end": 306.15, "text": "主公要想成天下大业,"}, {"start": 306.15, "end": 310.15, "text": "首先要突霸中原。"}, {"start": 310.15, "end": 312.15, "text": "中原守望之地,"}, {"start": 312.15, "end": 314.15, "text": "当属徐州六郡。"}, {"start": 314.15, "end": 315.15, "text": "因此,"}, {"start": 315.15, "end": 320.62, "text": "主公心里头早就惦记着徐州了。"}, {"start": 320.62, "end": 321.62, "text": "否则的话,"}, {"start": 321.62, "end": 324.62, "text": "主公刚才的痛呼声中,"}, {"start": 324.62, "end": 328.62, "text": "怎么会带有这么凛然的杀机呢?"}, {"start": 330.62, "end": 334.1, "text": "让你说着了。"}, {"start": 334.1, "end": 335.1, "text": "我就是想让他们"}, {"start": 335.1, "end": 337.1, "text": "把我的悲伤之情传出去,"}, {"start": 337.1, "end": 339.1, "text": "传给天下的诸侯。"}, {"start": 339.1, "end": 341.1, "text": "陶谦杀了我爹,"}, {"start": 341.1, "end": 344.54, "text": "我痛不欲生。"}, {"start": 344.54, "end": 347.85, "text": "此时刺客这个消息,"}, {"start": 347.85, "end": 350.85, "text": "已经顺风传出百里开外。"}, {"start": 350.85, "end": 357.21, "text": "徐州并不好取。"}, {"start": 357.21, "end": 358.21, "text": "继续说。"}, {"start": 358.21, "end": 359.21, "text": "在下以为,"}, {"start": 359.21, "end": 362.21, "text": "取徐州有两难。"}, {"start": 362.21, "end": 364.21, "text": "这第一难,"}, {"start": 364.21, "end": 366.21, "text": "徐州刺史陶谦,"}, {"start": 366.21, "end": 367.21, "text": "乃先帝亲命。"}, {"start": 367.21, "end": 370.21, "text": "此人制正以宽人为本,"}, {"start": 370.21, "end": 373.21, "text": "御民以厚道主称。"}, {"start": 373.21, "end": 376.21, "text": "官生的口碑马也堪称上家,"}, {"start": 376.21, "end": 379.21, "text": "因此取之不易。"}, {"start": 379.21, "end": 381.21, "text": "这第二难,"}, {"start": 381.21, "end": 382.21, "text": "是济州的袁绍,"}, {"start": 382.21, "end": 384.21, "text": "南洋的袁硕,"}, {"start": 384.21, "end": 385.21, "text": "平原的公孙瓒,"}, {"start": 385.21, "end": 387.21, "text": "甚至连荆州的刘表,"}, {"start": 387.21, "end": 390.21, "text": "都对徐州是垂涎三尺。"}, {"start": 390.21, "end": 394.21, "text": "他们只是望而止不叹不取,"}, {"start": 394.21, "end": 396.21, "text": "就是怕触犯众怒,"}, {"start": 396.21, "end": 398.21, "text": "树敌各路诸侯啊。"}, {"start": 398.21, "end": 400.84, "text": "因此,"}, {"start": 400.84, "end": 402.84, "text": "他们能听凭主公你,"}, {"start": 402.84, "end": 404.84, "text": "去取徐州吗?"}, {"start": 404.84, "end": 407.84, "text": "那你说我是取呢,"}, {"start": 407.84, "end": 410.84, "text": "还是不取?"}, {"start": 410.84, "end": 413.84, "text": "豪谦命不下杀害主公家父,"}, {"start": 413.84, "end": 415.84, "text": "此仇不报,"}, {"start": 415.84, "end": 417.84, "text": "天理难容啊。"}, {"start": 417.84, "end": 418.84, "text": "此外,"}, {"start": 418.84, "end": 420.84, "text": "陶谦厚道近乎于府,"}, {"start": 420.84, "end": 422.84, "text": "宽人如同昏妹。"}, {"start": 422.84, "end": 423.84, "text": "像这样的人,"}, {"start": 423.84, "end": 426.84, "text": "他能具配有徐州吗?"}, {"start": 426.84, "end": 429.84, "text": "徐州是乃中原重人,"}, {"start": 429.84, "end": 431.84, "text": "和黄河耳旁泰山,"}, {"start": 431.84, "end": 434.84, "text": "得知可纵横南北。"}, {"start": 434.84, "end": 437.84, "text": "苍天送徐州给主公,"}, {"start": 437.84, "end": 440.84, "text": "如同送一杆大旗给狂风,"}, {"start": 440.84, "end": 442.84, "text": "送一把宝剑给剑桥。"}, {"start": 442.84, "end": 454.86, "text": "徐女,"}, {"start": 454.86, "end": 456.86, "text": "听李讲话,"}, {"start": 456.86, "end": 458.86, "text": "如饮梅酒,"}, {"start": 458.86, "end": 461.86, "text": "令人陶醉啊。"}, {"start": 469.67, "end": 475.26, "text": "在下建议,"}, {"start": 475.26, "end": 477.26, "text": "主公即刻上书朝廷,"}, {"start": 477.26, "end": 479.26, "text": "奏明陶谦之罪,"}, {"start": 479.26, "end": 481.26, "text": "并派人到袁绍袁树,"}, {"start": 481.26, "end": 483.26, "text": "公孙暂处去报丧,"}, {"start": 483.26, "end": 485.26, "text": "让各路诸侯都知道,"}, {"start": 485.26, "end": 488.26, "text": "陶谦杀害了主公家父。"}, {"start": 488.26, "end": 489.26, "text": "此讯一到,"}, {"start": 489.26, "end": 491.26, "text": "他们也就都明白了。"}, {"start": 491.26, "end": 493.26, "text": "到那个时候,"}, {"start": 493.26, "end": 495.26, "text": "主公起兵去讨贼,"}, {"start": 495.26, "end": 497.26, "text": "那是奉旨讨贼啊。"}, {"start": 497.26, "end": 499.26, "text": "上和天意,"}, {"start": 499.26, "end": 500.26, "text": "下和人情,"}, {"start": 500.26, "end": 502.26, "text": "中和道义。"}, {"start": 502.26, "end": 503.26, "text": "为此,"}, {"start": 503.26, "end": 506.26, "text": "这徐州非主公莫属了。"}, {"start": 506.26, "end": 507.26, "text": "我嘛,"}, {"start": 507.26, "end": 521.58, "text": "因为悲伤过度,"}, {"start": 521.58, "end": 523.58, "text": "不能只比。"}, {"start": 524.58, "end": 525.58, "text": "就劳你,"}, {"start": 525.58, "end": 527.58, "text": "带你一道哀书,"}, {"start": 527.58, "end": 529.58, "text": "在上奏朝廷的同时,"}, {"start": 529.58, "end": 531.58, "text": "飞马传送给各路诸侯,"}, {"start": 531.58, "end": 534.58, "text": "表明杀父之仇,"}, {"start": 534.58, "end": 537.58, "text": "和被迫起兵道仇。"}, {"start": 537.58, "end": 538.58, "text": "此书,"}, {"start": 538.58, "end": 540.58, "text": "在下已腻好,"}, {"start": 540.58, "end": 542.58, "text": "请主公过目。"}, {"start": 542.58, "end": 543.58, "text": "不必了。"}, {"start": 543.58, "end": 544.58, "text": "你写的东西,"}, {"start": 544.58, "end": 547.58, "text": "肯定是字字句句结合我意。"}, {"start": 547.58, "end": 549.58, "text": "传命三军,"}, {"start": 549.58, "end": 551.58, "text": "明日晨时起兵,"}, {"start": 551.58, "end": 553.58, "text": "讨伐陶谦。"}, {"start": 553.58, "end": 555.58, "text": "遵命。"}, {"start": 555.58, "end": 556.58, "text": "主公啊,"}, {"start": 556.58, "end": 557.58, "text": "此次出征,"}, {"start": 557.58, "end": 562.93, "text": "你为什么不分配好,"}, {"start": 562.93, "end": 563.93, "text": "谁为先锋,"}, {"start": 563.93, "end": 564.93, "text": "谁为中军,"}, {"start": 564.93, "end": 565.93, "text": "谁为后应啊?"}, {"start": 565.93, "end": 566.93, "text": "你想说什么?"}, {"start": 566.93, "end": 567.93, "text": "主公从不打无准备之仗。"}, {"start": 567.93, "end": 568.93, "text": "以往出征,"}, {"start": 568.93, "end": 569.93, "text": "都是先分配好,"}, {"start": 569.93, "end": 570.93, "text": "谁为先锋,"}, {"start": 570.93, "end": 571.93, "text": "谁为中军,"}, {"start": 571.93, "end": 572.93, "text": "谁为后应。"}, {"start": 572.93, "end": 573.93, "text": "这回打陶谦,"}, {"start": 573.93, "end": 575.93, "text": "怎么说打中军啊?"}, {"start": 575.93, "end": 577.93, "text": "那是因为这回与以往不同,"}, {"start": 577.93, "end": 579.93, "text": "我是要为父报仇,"}, {"start": 579.93, "end": 580.93, "text": "怒火满墙,"}, {"start": 580.93, "end": 582.93, "text": "我已经乱了方寸了,"}, {"start": 582.93, "end": 584.93, "text": "恨不得朝发西至。"}, {"start": 584.93, "end": 586.93, "text": "所以我的五万大军"}, {"start": 586.93, "end": 587.93, "text": "全都是先锋,"}, {"start": 587.93, "end": 589.93, "text": "我们要一鼓作气,"}, {"start": 589.93, "end": 590.93, "text": "拿下徐州,"}, {"start": 590.93, "end": 592.93, "text": "以免迟则胜变。"}, {"start": 592.93, "end": 593.93, "text": "袁绍袁术等诸侯"}, {"start": 593.93, "end": 595.93, "text": "在接到主公哀疏同时,"}, {"start": 595.93, "end": 596.93, "text": "很可能也会接到"}, {"start": 596.93, "end": 598.93, "text": "陶谦的求言书信。"}, {"start": 598.93, "end": 600.93, "text": "就袁绍的心性而言,"}, {"start": 600.93, "end": 601.93, "text": "他要犹豫解定,"}, {"start": 601.93, "end": 602.93, "text": "拿不定主意,"}, {"start": 602.93, "end": 604.93, "text": "是帮助陶谦好呢,"}, {"start": 604.93, "end": 605.93, "text": "还是保持中立,"}, {"start": 605.93, "end": 607.93, "text": "就在他犹豫这几天里,"}, {"start": 607.93, "end": 609.93, "text": "我们一定要拿下徐州,"}, {"start": 609.93, "end": 610.93, "text": "造成继承事实。"}, {"start": 610.93, "end": 611.93, "text": "你听听,"}, {"start": 611.93, "end": 613.93, "text": "徐玉说得多好,"}, {"start": 613.93, "end": 615.93, "text": "比我自个儿说得多好。"}, {"start": 615.93, "end": 616.93, "text": "末将明白了。"}, {"start": 616.93, "end": 618.93, "text": "我不能和主公相提并论,"}, {"start": 618.93, "end": 620.93, "text": "我是跟着主公时间长了,"}, {"start": 620.93, "end": 622.93, "text": "多学了一些教育。"}, {"start": 622.93, "end": 627.45, "text": "徐玉,"}, {"start": 627.45, "end": 630.45, "text": "你是怕我嫉妒你吗?"}, {"start": 630.45, "end": 632.45, "text": "我可以告诉你不会的,"}, {"start": 632.45, "end": 634.45, "text": "因为我了解你的忠心,"}, {"start": 634.45, "end": 638.24, "text": "我要是嫉妒你,"}, {"start": 639.24, "end": 641.24, "text": "不就是嫉妒我自个儿吗?"}, {"start": 644.24, "end": 645.24, "text": "主公的一席话,"}, {"start": 645.24, "end": 647.24, "text": "真是令人讨不醉。"}, {"start": 650.24, "end": 683.47, "text": "曹孟德,"}, {"start": 683.47, "end": 686.47, "text": "亲率大军征讨,"}, {"start": 686.47, "end": 689.47, "text": "陶谦至之不敌,"}, {"start": 689.47, "end": 692.47, "text": "值得出城起罪。"}, {"start": 694.47, "end": 695.47, "text": "如何罪?"}, {"start": 695.47, "end": 697.47, "text": "曹老太爷,"}, {"start": 697.47, "end": 699.47, "text": "路经徐州时,"}, {"start": 699.47, "end": 704.47, "text": "我想借此机会结交你。"}, {"start": 705.47, "end": 708.47, "text": "所以我们全家老少,"}, {"start": 708.47, "end": 710.47, "text": "像伺候王国,"}, {"start": 710.47, "end": 711.47, "text": "不不不,"}, {"start": 711.47, "end": 713.47, "text": "像伺候自己的父亲那样,"}, {"start": 713.47, "end": 715.47, "text": "伺候曹老太爷。"}, {"start": 716.47, "end": 718.47, "text": "临行时,"}, {"start": 718.47, "end": 722.47, "text": "我征送了价值十万钱的礼品,"}, {"start": 722.47, "end": 726.47, "text": "并派部将张凯护送。"}, {"start": 726.47, "end": 728.47, "text": "万不了,"}, {"start": 728.47, "end": 732.47, "text": "此人恶行未改,"}, {"start": 732.47, "end": 735.47, "text": "杀害了曹老太爷。"}, {"start": 735.47, "end": 737.47, "text": "是我,"}, {"start": 737.47, "end": 739.47, "text": "造成了大错,"}, {"start": 739.47, "end": 742.47, "text": "现已无意之绝境。"}, {"start": 742.47, "end": 746.46, "text": "因此,"}, {"start": 746.46, "end": 748.46, "text": "我们全家老少,"}, {"start": 748.46, "end": 751.46, "text": "和徐州城的老少,"}, {"start": 751.46, "end": 754.46, "text": "都在为曹老太爷,"}, {"start": 754.46, "end": 756.46, "text": "服效。"}, {"start": 757.46, "end": 766.46, "text": "欺骗曹公,"}, {"start": 766.46, "end": 768.46, "text": "我曹乾,"}, {"start": 768.46, "end": 770.46, "text": "虽然身患重病,"}, {"start": 770.46, "end": 772.46, "text": "仍要前往吴凤山,"}, {"start": 772.46, "end": 775.46, "text": "捉拿恶贼张凯,"}, {"start": 775.46, "end": 777.46, "text": "亲手交给你,"}, {"start": 777.46, "end": 780.46, "text": "把他刮心去肝,"}, {"start": 780.46, "end": 785.46, "text": "祭奠曹老太爷的在天之灵。"}, {"start": 785.46, "end": 787.46, "text": "你说得好听。"}, {"start": 787.46, "end": 789.46, "text": "杀父之仇不共戴天,"}, {"start": 789.46, "end": 790.46, "text": "区区一个张凯,"}, {"start": 790.46, "end": 792.46, "text": "能让我父复活吗?"}, {"start": 792.46, "end": 794.46, "text": "在下,"}, {"start": 794.46, "end": 796.46, "text": "虽然有罪,"}, {"start": 796.46, "end": 798.46, "text": "但出于有意献宠,"}, {"start": 798.46, "end": 800.46, "text": "无心获罪呀。"}, {"start": 800.46, "end": 803.84, "text": "祈求曹公,"}, {"start": 803.84, "end": 805.84, "text": "看在这一劫上,"}, {"start": 805.84, "end": 807.84, "text": "少数获罪,"}, {"start": 807.84, "end": 809.84, "text": "暂且退兵,"}, {"start": 809.84, "end": 813.84, "text": "容额杀贼自赎。"}, {"start": 813.84, "end": 815.84, "text": "对了,"}, {"start": 815.84, "end": 817.84, "text": "从今年起,"}, {"start": 817.84, "end": 819.84, "text": "徐州府愿意每年向贵部提供,"}, {"start": 819.84, "end": 821.84, "text": "二十万两侠。"}, {"start": 821.84, "end": 823.84, "text": "你是想收买我?"}, {"start": 823.84, "end": 825.84, "text": "不不不,"}, {"start": 825.84, "end": 827.84, "text": "我不是这个意思,"}, {"start": 827.84, "end": 829.84, "text": "不是这个意思。"}, {"start": 829.84, "end": 831.84, "text": "那你是什么意思?"}, {"start": 831.84, "end": 833.84, "text": "陶谦,"}, {"start": 833.84, "end": 835.84, "text": "你不仅纵使部下,"}, {"start": 835.84, "end": 837.84, "text": "杀害我父,"}, {"start": 837.84, "end": 839.84, "text": "还暗中勾结袁绍,"}, {"start": 839.84, "end": 841.84, "text": "谋我眼中,"}, {"start": 841.84, "end": 843.84, "text": "妄想与他人共分我的属地。"}, {"start": 843.84, "end": 845.84, "text": "曹蒙德呀,"}, {"start": 845.84, "end": 847.84, "text": "世人皆知我陶谦,"}, {"start": 847.84, "end": 849.84, "text": "其实我陶谦,"}, {"start": 849.84, "end": 851.84, "text": "向无大志,"}, {"start": 851.84, "end": 853.84, "text": "只图自保,"}, {"start": 853.84, "end": 855.84, "text": "我何曾贪恋过别人的城池?"}, {"start": 855.84, "end": 857.84, "text": "你瞒得了别人,"}, {"start": 857.84, "end": 859.84, "text": "瞒不了我。"}, {"start": 859.84, "end": 861.84, "text": "陶谦,你一向都是故作讨悔,"}, {"start": 861.84, "end": 863.84, "text": "虚伪,陷恶。"}, {"start": 863.84, "end": 865.84, "text": "我跟你明说了吧,"}, {"start": 865.84, "end": 867.84, "text": "看在你披麻戴孝的份上,"}, {"start": 867.84, "end": 869.84, "text": "今日我就不杀你。"}, {"start": 869.84, "end": 871.84, "text": "赶紧回去备战,"}, {"start": 871.84, "end": 873.84, "text": "两日之后我要拿下徐州。"}, {"start": 873.84, "end": 875.84, "text": "曹蒙德,"}, {"start": 875.84, "end": 877.84, "text": "我陶谦也是义方刺史。"}, {"start": 877.84, "end": 879.84, "text": "身受皇命,"}, {"start": 879.84, "end": 881.84, "text": "士受国恩,"}, {"start": 881.84, "end": 883.84, "text": "其实我比你父亲"}, {"start": 883.84, "end": 885.84, "text": "还大一岁呢。"}, {"start": 885.84, "end": 887.84, "text": "我卑躬屈膝的"}, {"start": 887.84, "end": 889.84, "text": "向你起罪,"}, {"start": 889.84, "end": 891.84, "text": "都起到这个地步了,"}, {"start": 891.84, "end": 895.89, "text": "还不放过我吗?"}, {"start": 895.89, "end": 897.89, "text": "你非要"}, {"start": 897.89, "end": 899.89, "text": "强占徐州,"}, {"start": 899.89, "end": 901.89, "text": "非要比我"}, {"start": 901.89, "end": 903.89, "text": "徐州数十万军民"}, {"start": 903.89, "end": 905.89, "text": "一死,"}, {"start": 905.89, "end": 907.89, "text": "相抗吗?"}, {"start": 907.89, "end": 909.89, "text": "两日之后破城,"}, {"start": 909.89, "end": 911.89, "text": "我要取你的手机,"}, {"start": 911.89, "end": 913.89, "text": "祭奠家父。"}, {"start": 913.89, "end": 915.89, "text": "阁下如果知趣,"}, {"start": 915.89, "end": 917.89, "text": "回家洗尽了脖子等着,"}, {"start": 917.89, "end": 921.3, "text": "转告"}, {"start": 921.3, "end": 923.3, "text": "徐州城中的百姓,"}, {"start": 923.3, "end": 925.3, "text": "破城之后,"}, {"start": 925.3, "end": 927.3, "text": "我不会屠城,凡为我赋,"}, {"start": 927.3, "end": 929.3, "text": "扶丧者都可以免死。"}, {"start": 929.3, "end": 959.52, "text": "主公,你为何不下兵,"}, {"start": 959.52, "end": 961.52, "text": "趁势攻城啊?"}, {"start": 961.52, "end": 970.59, "text": "你不是让我们一鼓作气拿下徐州吗?"}, {"start": 970.59, "end": 974.16, "text": "因为我发现,"}, {"start": 974.16, "end": 976.16, "text": "郝迁比我想象中的要厉害。"}, {"start": 978.16, "end": 980.16, "text": "我刚才仔细看了,"}, {"start": 980.16, "end": 982.16, "text": "虽然他的城关"}, {"start": 982.16, "end": 984.16, "text": "便差白旗,"}, {"start": 984.16, "end": 986.16, "text": "但是每一杆白旗下的"}, {"start": 986.16, "end": 989.41, "text": "都暗藏着强弓印。"}, {"start": 989.41, "end": 991.41, "text": "你看他表面上对我"}, {"start": 991.41, "end": 993.41, "text": "卑躬屈膝,"}, {"start": 993.41, "end": 995.41, "text": "实则,"}, {"start": 995.41, "end": 997.41, "text": "故作讨回暗藏杀机。"}, {"start": 997.41, "end": 999.41, "text": "我相信他们一定"}, {"start": 999.41, "end": 1001.41, "text": "做好了守城的准备,"}, {"start": 1001.41, "end": 1003.41, "text": "而且城里的军民"}, {"start": 1003.41, "end": 1005.41, "text": "也一定会跟他共存。"}, {"start": 1005.41, "end": 1007.41, "text": "郝迁再是顽抗,"}, {"start": 1007.41, "end": 1009.41, "text": "不过是八千守军,"}, {"start": 1009.41, "end": 1011.41, "text": "我们五万精甲,"}, {"start": 1011.41, "end": 1013.41, "text": "岂能拿他不下。"}, {"start": 1013.41, "end": 1015.41, "text": "他除了八千守军,"}, {"start": 1015.41, "end": 1017.41, "text": "还有几十万百姓了。"}, {"start": 1017.41, "end": 1019.41, "text": "郝迁,"}, {"start": 1019.41, "end": 1021.41, "text": "素以忍耐之力,"}, {"start": 1021.41, "end": 1023.41, "text": "大难临头,"}, {"start": 1023.41, "end": 1025.41, "text": "百姓多会效命。"}, {"start": 1025.41, "end": 1027.41, "text": "你在看他的城关,"}, {"start": 1027.41, "end": 1029.41, "text": "高三丈有余,"}, {"start": 1029.41, "end": 1031.41, "text": "我们的人虽多,"}, {"start": 1031.41, "end": 1033.41, "text": "但多是亲戚,"}, {"start": 1033.41, "end": 1035.41, "text": "如果强弓,"}, {"start": 1035.41, "end": 1037.41, "text": "势必伤亡太大。"}, {"start": 1037.41, "end": 1039.41, "text": "我答应给他们两天时间,"}, {"start": 1039.41, "end": 1041.41, "text": "也是迫不得已,"}, {"start": 1041.41, "end": 1043.41, "text": "因为我们攻城的气血"}, {"start": 1043.41, "end": 1045.41, "text": "要两天之后才能到来。"}, {"start": 1045.41, "end": 1047.41, "text": "那是在攻,"}, {"start": 1047.41, "end": 1053.06, "text": "就可一鼓作气,"}, {"start": 1053.06, "end": 1057.26, "text": "将其拿下。传命下去,"}, {"start": 1057.26, "end": 1059.26, "text": "就说陶迁已经下的,"}, {"start": 1059.26, "end": 1061.26, "text": "肝胆都破碎了,"}, {"start": 1061.26, "end": 1063.26, "text": "我们一战可胜,"}, {"start": 1063.26, "end": 1065.26, "text": "让将士们歇息两天,"}, {"start": 1065.26, "end": 1067.26, "text": "第三天日出时分,"}, {"start": 1067.26, "end": 1069.26, "text": "各部合力攻城。"}, {"start": 1071.26, "end": 1073.26, "text": "遵命。"}, {"start": 1073.26, "end": 1075.26, "text": "军医。在。"}, {"start": 1075.26, "end": 1077.26, "text": "陪我喝杯。遵命。"}, {"start": 1077.26, "end": 1086.72, "text": "陶公子。"}, {"start": 1086.72, "end": 1088.72, "text": "徐大人。"}, {"start": 1090.72, "end": 1092.72, "text": "让你久等了。"}, {"start": 1092.72, "end": 1094.72, "text": "陶使军写给我家主公的信,"}, {"start": 1094.72, "end": 1096.72, "text": "我家主公"}, {"start": 1096.72, "end": 1098.72, "text": "已经详细地越过了。"}, {"start": 1098.72, "end": 1100.72, "text": "袁将军何时发兵啊?"}, {"start": 1100.72, "end": 1102.72, "text": "什么?发兵?"}, {"start": 1102.72, "end": 1104.72, "text": "不不不。"}, {"start": 1104.72, "end": 1106.72, "text": "我家主公考虑再三,"}, {"start": 1106.72, "end": 1108.72, "text": "还是不能发兵相救。"}, {"start": 1108.72, "end": 1110.72, "text": "为什么呀?"}, {"start": 1110.72, "end": 1112.72, "text": "在你来冀州求救之前,"}, {"start": 1112.72, "end": 1114.72, "text": "那曹操的哀书"}, {"start": 1114.72, "end": 1116.72, "text": "已经到了冀州。"}, {"start": 1116.72, "end": 1118.72, "text": "书上写的分明,"}, {"start": 1118.72, "end": 1120.72, "text": "这杀父之仇,"}, {"start": 1120.72, "end": 1122.72, "text": "可是不共戴天啊。"}, {"start": 1124.72, "end": 1126.72, "text": "我家主公"}, {"start": 1126.72, "end": 1128.72, "text": "若是在此时此刻"}, {"start": 1128.72, "end": 1130.72, "text": "又为此事而发兵相救,"}, {"start": 1130.72, "end": 1132.72, "text": "不仅难以服众,"}, {"start": 1132.72, "end": 1134.72, "text": "实在是"}, {"start": 1134.72, "end": 1136.72, "text": "出师无名啊。"}, {"start": 1136.72, "end": 1138.72, "text": "徐大人,"}, {"start": 1138.72, "end": 1140.72, "text": "我父亲从未纵使张凯"}, {"start": 1140.72, "end": 1142.72, "text": "杀害曹松啊。"}, {"start": 1142.72, "end": 1144.72, "text": "相反,"}, {"start": 1144.72, "end": 1146.72, "text": "他之所以派人去护送曹松,"}, {"start": 1146.72, "end": 1148.72, "text": "他是想结交曹操啊。"}, {"start": 1148.72, "end": 1150.72, "text": "这正是这件事情的"}, {"start": 1150.72, "end": 1152.72, "text": "可笑可悲之处。"}, {"start": 1152.72, "end": 1154.72, "text": "你父陶谦原本是想"}, {"start": 1154.72, "end": 1156.72, "text": "向那曹操献媚,"}, {"start": 1156.72, "end": 1158.72, "text": "不料想弄巧成拙,"}, {"start": 1158.72, "end": 1160.72, "text": "化虎没成,"}, {"start": 1160.72, "end": 1162.72, "text": "反累其犬,"}, {"start": 1162.72, "end": 1164.72, "text": "致使你们两家反目成仇,"}, {"start": 1164.72, "end": 1166.72, "text": "兵戎相见。"}, {"start": 1166.72, "end": 1168.72, "text": "徐大人。"}, {"start": 1168.72, "end": 1170.72, "text": "可悲啊,"}, {"start": 1170.72, "end": 1172.72, "text": "堂堂的朝廷命官,"}, {"start": 1172.72, "end": 1174.72, "text": "义州之长尊,"}, {"start": 1174.72, "end": 1178.0, "text": "居然"}, {"start": 1178.0, "end": 1180.0, "text": "做出了这种荒唐的事情。"}, {"start": 1180.0, "end": 1183.25, "text": "恕徐悠之言,"}, {"start": 1183.25, "end": 1185.25, "text": "这件事情"}, {"start": 1185.25, "end": 1187.25, "text": "实在是愚蠢之计。"}, {"start": 1187.25, "end": 1191.07, "text": "曹公子不妨想一想,"}, {"start": 1191.07, "end": 1193.07, "text": "我家主公袁绍元本初,"}, {"start": 1193.07, "end": 1195.07, "text": "那是何许人也?"}, {"start": 1195.07, "end": 1197.07, "text": "乃四世三公,"}, {"start": 1197.07, "end": 1199.07, "text": "声震寰雨,"}, {"start": 1199.07, "end": 1201.07, "text": "威名满天下。"}, {"start": 1201.07, "end": 1203.07, "text": "我家主公"}, {"start": 1203.07, "end": 1205.07, "text": "总不能在你父陶谦"}, {"start": 1205.07, "end": 1207.07, "text": "做出了这等"}, {"start": 1207.07, "end": 1209.07, "text": "可笑可悲的事之后,"}, {"start": 1209.07, "end": 1211.07, "text": "在荒唐的天上"}, {"start": 1211.07, "end": 1213.07, "text": "一些可叹"}, {"start": 1213.07, "end": 1215.07, "text": "和可怜吧。"}, {"start": 1215.07, "end": 1223.57, "text": "数不远送。"}, {"start": 1223.57, "end": 1230.43, "text": "七州袁绍不肯"}, {"start": 1230.43, "end": 1232.43, "text": "发兵相助,"}, {"start": 1232.43, "end": 1234.43, "text": "南洋袁术虽然肯发兵聚草,"}, {"start": 1234.43, "end": 1236.43, "text": "但他却让家父"}, {"start": 1236.43, "end": 1238.43, "text": "各让武宁似水两郡之地"}, {"start": 1238.43, "end": 1240.43, "text": "作为仇械。"}, {"start": 1240.43, "end": 1242.43, "text": "二元原本与家父相交最深,"}, {"start": 1242.43, "end": 1244.43, "text": "但在紧要关头"}, {"start": 1244.43, "end": 1246.43, "text": "却都晚年推辞。"}, {"start": 1246.43, "end": 1248.43, "text": "公孙将军,"}, {"start": 1248.43, "end": 1250.43, "text": "家父的生死"}, {"start": 1250.43, "end": 1252.43, "text": "和徐州城谷这三万百姓的存亡"}, {"start": 1252.43, "end": 1254.43, "text": "就仰仗将军了。"}, {"start": 1254.43, "end": 1256.43, "text": "曹操一旦得了徐州,"}, {"start": 1256.43, "end": 1258.43, "text": "必然会图谋中原,"}, {"start": 1258.43, "end": 1260.43, "text": "进而"}, {"start": 1260.43, "end": 1262.43, "text": "会与袁氏二兄争天下。"}, {"start": 1262.43, "end": 1264.43, "text": "只而猜想,"}, {"start": 1264.43, "end": 1266.43, "text": "袁绍和袁术都知道曹操得势之后的后果,"}, {"start": 1266.43, "end": 1268.43, "text": "但这两兄弟"}, {"start": 1268.43, "end": 1270.43, "text": "本来就是面和心不和,"}, {"start": 1270.43, "end": 1272.43, "text": "都想等着对方先发兵,"}, {"start": 1272.43, "end": 1274.43, "text": "自己做官成败,"}, {"start": 1274.43, "end": 1276.43, "text": "以取余翁之力啊。"}, {"start": 1276.43, "end": 1278.43, "text": "这一对唐兄弟可谓是"}, {"start": 1278.43, "end": 1280.43, "text": "一对笑面虎,两头五脚杀。"}, {"start": 1280.43, "end": 1282.43, "text": "两人之间"}, {"start": 1282.43, "end": 1284.43, "text": "老晚必有一场恶斗。"}, {"start": 1284.43, "end": 1286.43, "text": "公孙将军,我求你快快发兵,"}, {"start": 1286.43, "end": 1292.66, "text": "救救徐州城吧。"}, {"start": 1292.66, "end": 1294.66, "text": "禀主公,平原令刘备求见。"}, {"start": 1294.66, "end": 1296.66, "text": "好,玄德老弟来了。"}, {"start": 1296.66, "end": 1298.66, "text": "陶芝啊,你先下去歇息,"}, {"start": 1298.66, "end": 1300.66, "text": "待我和玄德商议之后,"}, {"start": 1300.66, "end": 1302.66, "text": "再做定夺。"}, {"start": 1302.66, "end": 1310.16, "text": "好好好。"}, {"start": 1310.16, "end": 1312.16, "text": "玄德啊。"}, {"start": 1312.16, "end": 1314.16, "text": "刘备拜见公孙将军。"}, {"start": 1314.16, "end": 1316.16, "text": "贤弟啊,"}, {"start": 1316.16, "end": 1318.16, "text": "你先看一下陶谦发给我的求援信。"}, {"start": 1318.16, "end": 1322.18, "text": "曹操亲率五万大军"}, {"start": 1322.18, "end": 1324.18, "text": "攻打徐州。"}, {"start": 1324.18, "end": 1326.18, "text": "陶谦危在旦夕。"}, {"start": 1326.18, "end": 1328.18, "text": "老弟啊,"}, {"start": 1328.18, "end": 1330.18, "text": "你说我是救陶谦"}, {"start": 1330.18, "end": 1332.18, "text": "还是不救啊?"}, {"start": 1332.18, "end": 1337.31, "text": "敢问将军的意思是"}, {"start": 1337.31, "end": 1339.31, "text": "我是想救陶谦,"}, {"start": 1339.31, "end": 1341.31, "text": "但是"}, {"start": 1341.31, "end": 1343.31, "text": "我现在是兵少将弱,"}, {"start": 1343.31, "end": 1345.31, "text": "非曹操之对手。"}, {"start": 1345.31, "end": 1347.31, "text": "再说了,"}, {"start": 1347.31, "end": 1349.31, "text": "袁绍和袁束各自有二十多万兵马,"}, {"start": 1349.31, "end": 1351.31, "text": "却做官成败。"}, {"start": 1351.31, "end": 1353.31, "text": "我哪有能力救徐州啊?"}, {"start": 1353.31, "end": 1355.31, "text": "即便是我全军出园,"}, {"start": 1355.31, "end": 1357.31, "text": "而且侥幸成功了,"}, {"start": 1357.31, "end": 1359.31, "text": "我得到了什么?"}, {"start": 1359.31, "end": 1361.31, "text": "我只不过是得到"}, {"start": 1361.31, "end": 1363.31, "text": "像陶谦这般弱勇,"}, {"start": 1363.31, "end": 1365.31, "text": "却结下了像曹操,"}, {"start": 1365.31, "end": 1367.31, "text": "袁绍这样的强敌。"}, {"start": 1367.31, "end": 1369.31, "text": "不至啊。"}, {"start": 1369.31, "end": 1374.51, "text": "将军所言,"}, {"start": 1374.51, "end": 1376.51, "text": "在下万万不敢苟同。"}, {"start": 1376.51, "end": 1378.51, "text": "陶公祖为先帝亲命,"}, {"start": 1378.51, "end": 1380.51, "text": "忠义厚道,"}, {"start": 1380.51, "end": 1382.51, "text": "知徐州多年,"}, {"start": 1382.51, "end": 1384.51, "text": "贤民远播。"}, {"start": 1384.51, "end": 1386.51, "text": "曹孟德以报复仇为名,"}, {"start": 1386.51, "end": 1388.51, "text": "趁火打劫,"}, {"start": 1388.51, "end": 1390.51, "text": "图谋徐州六军。"}, {"start": 1390.51, "end": 1392.51, "text": "虽说是乱世争雄,"}, {"start": 1392.51, "end": 1394.51, "text": "各凭势力,"}, {"start": 1394.51, "end": 1396.51, "text": "但我总觉得,"}, {"start": 1396.51, "end": 1398.51, "text": "最终必定是得人心者,"}, {"start": 1398.51, "end": 1400.51, "text": "方能得天下。"}, {"start": 1400.51, "end": 1402.51, "text": "在下此次前来,"}, {"start": 1402.51, "end": 1404.51, "text": "就是来和将军辞行的。"}, {"start": 1404.51, "end": 1406.51, "text": "我要去徐州"}, {"start": 1406.51, "end": 1408.51, "text": "援救陶谦。"}, {"start": 1408.51, "end": 1410.51, "text": "我说刘备啊,"}, {"start": 1410.51, "end": 1412.51, "text": "你才有多少兵马,"}, {"start": 1412.51, "end": 1414.51, "text": "居两三千人,"}, {"start": 1414.51, "end": 1416.51, "text": "竟敢拒破曹操的五万大军。"}, {"start": 1416.51, "end": 1418.51, "text": "你这可是以卵击石哦。"}, {"start": 1418.51, "end": 1420.51, "text": "我刘备未必是卵,"}, {"start": 1420.51, "end": 1422.51, "text": "他曹操"}, {"start": 1422.51, "end": 1424.51, "text": "也未必就是石头。"}, {"start": 1424.51, "end": 1428.18, "text": "也罢,"}, {"start": 1428.18, "end": 1430.18, "text": "既然你非得要去,"}, {"start": 1430.18, "end": 1432.18, "text": "那我就借给你精兵三千,"}, {"start": 1432.18, "end": 1435.49, "text": "稍壮声势。"}, {"start": 1435.49, "end": 1439.41, "text": "多谢公孙将军,"}, {"start": 1439.41, "end": 1441.41, "text": "在下不要将军任何兵马,"}, {"start": 1441.41, "end": 1443.41, "text": "只向将军借一个人。"}, {"start": 1443.41, "end": 1445.41, "text": "借谁?"}, {"start": 1445.41, "end": 1451.28, "text": "常山赵子龙。"}, {"start": 1451.28, "end": 1459.04, "text": "你为何独独要借赵云?"}, {"start": 1459.04, "end": 1461.04, "text": "世人只知道"}, {"start": 1461.04, "end": 1463.04, "text": "吕布名冠天下,"}, {"start": 1463.04, "end": 1465.04, "text": "却并不知道赵子龙之勇"}, {"start": 1465.04, "end": 1467.04, "text": "远胜于匹夫吕布。"}, {"start": 1467.04, "end": 1470.67, "text": "子龙啊。"}, {"start": 1470.67, "end": 1472.67, "text": "将军。"}, {"start": 1472.67, "end": 1474.67, "text": "你愿意跟随刘备"}, {"start": 1474.67, "end": 1476.67, "text": "去援救徐州吗?"}, {"start": 1476.67, "end": 1480.85, "text": "末将愿望。"}, {"start": 1484.85, "end": 1486.85, "text": "我看出来了,"}, {"start": 1486.85, "end": 1488.85, "text": "你们两个是英雄相惜。"}, {"start": 1490.85, "end": 1492.85, "text": "好,"}, {"start": 1492.85, "end": 1494.85, "text": "子龙啊,"}, {"start": 1494.85, "end": 1498.83, "text": "那你就随刘备去吧。"}, {"start": 1498.83, "end": 1500.83, "text": "谢将军。"}, {"start": 1500.83, "end": 1502.83, "text": "谢将军。"}, {"start": 1502.83, "end": 1504.83, "text": "公孙将军虽有数万将士,"}, {"start": 1504.83, "end": 1506.83, "text": "但真正的英雄"}, {"start": 1506.83, "end": 1508.83, "text": "只有子龙一个。"}, {"start": 1508.83, "end": 1510.83, "text": "其实在下对玄德军的人品"}, {"start": 1510.83, "end": 1512.83, "text": "早已是仰慕已久。"}, {"start": 1512.83, "end": 1514.83, "text": "从今以后,"}, {"start": 1514.83, "end": 1516.83, "text": "只要主公一声领下,"}, {"start": 1516.83, "end": 1518.83, "text": "子龙从此"}, {"start": 1518.83, "end": 1520.83, "text": "刘官张召就是四兄弟了。"}, {"start": 1520.83, "end": 1522.83, "text": "意义如何?"}, {"start": 1522.83, "end": 1524.83, "text": "谢主公的答案。"}, {"start": 1524.83, "end": 1526.83, "text": "主公。"}, {"start": 1526.83, "end": 1528.83, "text": "子龙,我们赶紧赶回平原县,"}, {"start": 1528.83, "end": 1530.83, "text": "明日一早奔赴徐州。"}, {"start": 1530.83, "end": 1532.83, "text": "我估计,"}, {"start": 1532.83, "end": 1534.83, "text": "陶前支持不了多久,"}, {"start": 1534.83, "end": 1536.83, "text": "只怕三五日之内便会破产。"}, {"start": 1536.83, "end": 1538.83, "text": "遵命。"}, {"start": 1538.83, "end": 1540.83, "text": "在下有一事不解。"}, {"start": 1540.83, "end": 1542.83, "text": "请讲。"}, {"start": 1542.83, "end": 1544.83, "text": "元少元术坐拥几十万大军,"}, {"start": 1544.83, "end": 1546.83, "text": "军兵不过两千,将不过官张召。"}, {"start": 1546.83, "end": 1548.83, "text": "却何以敢对抗曹操呢?"}, {"start": 1548.83, "end": 1550.83, "text": "好,"}, {"start": 1550.83, "end": 1552.83, "text": "问得好。"}, {"start": 1552.83, "end": 1554.83, "text": "子龙若不问,我早晚也会告诉你。"}, {"start": 1554.83, "end": 1556.83, "text": "方金天下,各路英雄豪杰"}, {"start": 1556.83, "end": 1558.83, "text": "皆以兵马拳谋,称霸一方。"}, {"start": 1558.83, "end": 1560.83, "text": "而我刘备,"}, {"start": 1560.83, "end": 1562.83, "text": "在兵马上远步他们。"}, {"start": 1562.83, "end": 1564.83, "text": "但我有两样,是他们没有的。"}, {"start": 1564.83, "end": 1566.83, "text": "其一,我以仁义为力生之本,"}, {"start": 1566.83, "end": 1568.83, "text": "待人之道。"}, {"start": 1568.83, "end": 1570.83, "text": "因为天下大乱,首先在于人心丧命。"}, {"start": 1570.83, "end": 1572.83, "text": "一至乱世,必先收人心。"}, {"start": 1572.83, "end": 1574.83, "text": "我必须以仁,抗不忍。"}, {"start": 1574.83, "end": 1576.83, "text": "以义,拒不义。"}, {"start": 1576.83, "end": 1578.83, "text": "其二,我身为"}, {"start": 1578.83, "end": 1580.83, "text": "汉皇后裔,"}, {"start": 1580.83, "end": 1582.83, "text": "除贼俘汉,是我必生心愿。"}, {"start": 1582.83, "end": 1584.83, "text": "那涛迁,是先帝亲命,"}, {"start": 1584.83, "end": 1586.83, "text": "素以仁义之证。"}, {"start": 1586.83, "end": 1588.83, "text": "我助他,便是俘汉。"}, {"start": 1588.83, "end": 1590.83, "text": "而曹操,"}, {"start": 1590.83, "end": 1592.83, "text": "名为保复仇,"}, {"start": 1592.83, "end": 1594.83, "text": "使为取徐州,意在取天下。"}, {"start": 1594.83, "end": 1596.83, "text": "耿耿野心,"}, {"start": 1596.83, "end": 1598.83, "text": "路人皆知。"}, {"start": 1598.83, "end": 1600.83, "text": "我举兵抗曹,便是以仁,"}, {"start": 1600.83, "end": 1602.83, "text": "抗不忍。以天下大义,"}, {"start": 1602.83, "end": 1604.83, "text": "拒萧雄之不义。"}, {"start": 1604.83, "end": 1606.83, "text": "就算此战不胜,"}, {"start": 1606.83, "end": 1608.83, "text": "世人也能看见一件事情。"}, {"start": 1608.83, "end": 1610.83, "text": "何事?"}, {"start": 1610.83, "end": 1612.83, "text": "正道不灭,大义永存。"}, {"start": 1612.83, "end": 1633.65, "text": "探马来报。"}, {"start": 1633.65, "end": 1635.65, "text": "袁绍,袁术,刘表,"}, {"start": 1635.65, "end": 1637.65, "text": "公孙战等各路捉猴,"}, {"start": 1637.65, "end": 1639.65, "text": "都不愿意出兵援助涛迁。"}, {"start": 1639.65, "end": 1643.34, "text": "果然不出我之所料。"}, {"start": 1643.34, "end": 1645.34, "text": "没有人愿意"}, {"start": 1645.34, "end": 1647.34, "text": "为了一个涛迁跟我为敌。"}, {"start": 1647.34, "end": 1649.34, "text": "徐州是我们的囊中之物了。"}, {"start": 1649.34, "end": 1651.34, "text": "工程的器械"}, {"start": 1651.34, "end": 1659.42, "text": "大部分也到位了。"}, {"start": 1659.42, "end": 1661.42, "text": "明日中午"}, {"start": 1661.42, "end": 1663.42, "text": "开始工程。"}, {"start": 1663.42, "end": 1665.42, "text": "还有一件事,令在下不安。"}, {"start": 1665.42, "end": 1667.42, "text": "说。"}, {"start": 1667.42, "end": 1669.42, "text": "远州城来信,"}, {"start": 1669.42, "end": 1671.42, "text": "说南郊一带发现"}, {"start": 1671.42, "end": 1673.42, "text": "吕布的兵马,"}, {"start": 1673.42, "end": 1675.42, "text": "八千至一万,"}, {"start": 1675.42, "end": 1677.42, "text": "似有所图谋。"}, {"start": 1677.42, "end": 1680.86, "text": "吕布?"}, {"start": 1680.86, "end": 1682.86, "text": "败君之将,丧主之徒,"}, {"start": 1682.86, "end": 1688.0, "text": "不足为虑。"}, {"start": 1688.0, "end": 1690.0, "text": "难道他敢攻我的"}, {"start": 1690.0, "end": 1692.0, "text": "远州大营?"}, {"start": 1692.0, "end": 1694.0, "text": "主公,"}, {"start": 1694.0, "end": 1696.0, "text": "善用兵者,"}, {"start": 1696.0, "end": 1698.0, "text": "不虑胜,先虑败。"}, {"start": 1698.0, "end": 1700.0, "text": "万一吕布作乱呢?"}, {"start": 1700.0, "end": 1702.0, "text": "远州可是我们的大本营啊。"}, {"start": 1702.0, "end": 1704.0, "text": "你可是把精兵强将"}, {"start": 1704.0, "end": 1706.0, "text": "都带来打徐州了。"}, {"start": 1706.0, "end": 1708.0, "text": "远州几乎"}, {"start": 1708.0, "end": 1710.0, "text": "是座空城。"}, {"start": 1710.0, "end": 1712.0, "text": "主公,"}, {"start": 1712.0, "end": 1714.0, "text": "吕布可是骁勇异常啊。"}, {"start": 1714.0, "end": 1716.0, "text": "吕布虽勇,"}, {"start": 1716.0, "end": 1718.0, "text": "贪耳好利,勇耳无谋。"}, {"start": 1718.0, "end": 1720.0, "text": "连袁绍、袁树"}, {"start": 1720.0, "end": 1722.0, "text": "都不敢动我的远州大营。"}, {"start": 1722.0, "end": 1724.0, "text": "他敢吗?"}, {"start": 1724.0, "end": 1726.0, "text": "再说了,"}, {"start": 1726.0, "end": 1728.0, "text": "我估计三日之内"}, {"start": 1728.0, "end": 1731.57, "text": "我就能攻下徐州。"}, {"start": 1731.57, "end": 1733.57, "text": "城一破,"}, {"start": 1733.57, "end": 1735.57, "text": "我就令徐楚带领两万精兵"}, {"start": 1735.57, "end": 1737.57, "text": "回防远州大营。"}, {"start": 1737.57, "end": 1739.57, "text": "徐楚早就想跟吕布"}, {"start": 1739.57, "end": 1745.66, "text": "大战三百合了。"}, {"start": 1745.66, "end": 1747.66, "text": "从地图上看,"}, {"start": 1747.66, "end": 1749.66, "text": "吕布似乎已超出了徐州了。"}, {"start": 1751.66, "end": 1753.66, "text": "没错,"}, {"start": 1753.66, "end": 1755.66, "text": "天下有那么大,"}, {"start": 1755.66, "end": 1998.78, "text": "我惦记着他们的。"}, {"start": 1998.78, "end": 2000.78, "text": "吕布已经天下无敌了,"}, {"start": 2000.78, "end": 2002.78, "text": "没想到有人比他还勇猛,"}, {"start": 2002.78, "end": 2004.78, "text": "这是谁的部将?"}, {"start": 2004.78, "end": 2006.78, "text": "主公,"}, {"start": 2006.78, "end": 2008.78, "text": "他们打着平安令的旗号,"}, {"start": 2008.78, "end": 2010.78, "text": "看来此人是刘备的部下。"}, {"start": 2010.78, "end": 2012.78, "text": "刘备?"}, {"start": 2012.78, "end": 2014.78, "text": "他只有区区几千人嘛,"}, {"start": 2014.78, "end": 2016.78, "text": "也敢来与我为敌。"}, {"start": 2016.78, "end": 2018.78, "text": "是的,"}, {"start": 2018.78, "end": 2036.75, "text": "他来了,"}, {"start": 2036.75, "end": 2038.75, "text": "平安令刘备,"}, {"start": 2038.75, "end": 2066.13, "text": "可轻敌啊,"}, {"start": 2066.13, "end": 2068.13, "text": "刘备既来,"}, {"start": 2068.13, "end": 2070.13, "text": "必有准备。"}, {"start": 2070.13, "end": 2072.13, "text": "关羽张飞已经得了,"}, {"start": 2072.13, "end": 2074.13, "text": "现在又多出了这么一员猛将。"}, {"start": 2074.13, "end": 2076.13, "text": "刘备这似乎为何如此明显。"}, {"start": 2076.13, "end": 2151.31, "text": "是不继续攻城?"}, {"start": 2151.31, "end": 2153.31, "text": "传命,"}, {"start": 2153.31, "end": 2155.31, "text": "缓缓退军,"}, {"start": 2155.31, "end": 2159.07, "text": "迎他们来攻。"}, {"start": 2159.07, "end": 2161.07, "text": "主公有令,"}, {"start": 2161.07, "end": 2172.06, "text": "撤退!"}, {"start": 2172.06, "end": 2174.06, "text": "草草大军压境之际,"}, {"start": 2174.06, "end": 2176.06, "text": "徐州生死关头,"}, {"start": 2176.06, "end": 2180.06, "text": "我陶谦便修各镇诸侯,"}, {"start": 2180.06, "end": 2184.06, "text": "而他们虽然坐拥数十万兵马,"}, {"start": 2184.06, "end": 2186.06, "text": "却无一肯拔兵相救。"}, {"start": 2186.06, "end": 2188.06, "text": "玄德军呢,"}, {"start": 2188.06, "end": 2190.06, "text": "我并没有求他,"}, {"start": 2190.06, "end": 2192.06, "text": "他却仗义前来,"}, {"start": 2192.06, "end": 2194.06, "text": "以区区两千兵马,"}, {"start": 2194.06, "end": 2196.06, "text": "却能冲破朝军铁桶般的镇压。"}, {"start": 2196.06, "end": 2198.06, "text": "玄德啊,"}, {"start": 2198.06, "end": 2200.06, "text": "我感激之情,"}, {"start": 2200.06, "end": 2202.06, "text": "无疑言表啊。"}, {"start": 2202.06, "end": 2204.06, "text": "陶公,"}, {"start": 2204.06, "end": 2206.06, "text": "刘备早就知道,"}, {"start": 2206.06, "end": 2208.06, "text": "天下之大,"}, {"start": 2208.06, "end": 2210.06, "text": "为徐州刺史陶公族,"}, {"start": 2210.06, "end": 2212.06, "text": "最是宽仁厚道,"}, {"start": 2212.06, "end": 2215.73, "text": "爱民如子。"}, {"start": 2215.73, "end": 2217.73, "text": "刘备想,"}, {"start": 2217.73, "end": 2219.73, "text": "当天下之大,"}, {"start": 2219.73, "end": 2221.73, "text": "为徐州刺史陶公族,"}, {"start": 2221.73, "end": 2223.73, "text": "最是宽仁厚道,"}, {"start": 2223.73, "end": 2225.73, "text": "爱民如子。"}, {"start": 2225.73, "end": 2227.73, "text": "刘备想,"}, {"start": 2227.73, "end": 2229.73, "text": "如果连陶公族,"}, {"start": 2229.73, "end": 2231.73, "text": "这样的人德之君,"}, {"start": 2231.73, "end": 2233.73, "text": "都无法生存的话,"}, {"start": 2233.73, "end": 2235.73, "text": "那么这个国家,"}, {"start": 2235.73, "end": 2237.73, "text": "还有什么指望的?"}, {"start": 2237.73, "end": 2239.73, "text": "大汉何日才可中兴?"}, {"start": 2239.73, "end": 2241.73, "text": "刘备无尺寸功德,"}, {"start": 2241.73, "end": 2243.73, "text": "唯有忠勇二字。"}, {"start": 2243.73, "end": 2245.73, "text": "今日,"}, {"start": 2245.73, "end": 2247.73, "text": "我相救徐州,"}, {"start": 2247.73, "end": 2249.73, "text": "便是救世道良心,"}, {"start": 2251.73, "end": 2253.73, "text": "救我大汉天下。"}, {"start": 2253.73, "end": 2255.73, "text": "说得好啊。"}, {"start": 2255.73, "end": 2257.73, "text": "请。"}, {"start": 2257.73, "end": 2259.73, "text": "尽饮此中。"}, {"start": 2259.73, "end": 2264.48, "text": "今以此酒,"}, {"start": 2264.48, "end": 2266.48, "text": "敬陶前辈。"}, {"start": 2266.48, "end": 2270.62, "text": "请。"}, {"start": 2270.62, "end": 2272.62, "text": "我知道我自己,"}, {"start": 2272.62, "end": 2274.62, "text": "德薄利弱,"}, {"start": 2274.62, "end": 2276.62, "text": "无福提领徐州。"}, {"start": 2276.62, "end": 2278.62, "text": "而今,"}, {"start": 2278.62, "end": 2280.62, "text": "天下纷乱,"}, {"start": 2280.62, "end": 2282.62, "text": "刚长崩溃,"}, {"start": 2282.62, "end": 2284.62, "text": "能匡扶汉师者,"}, {"start": 2284.62, "end": 2286.62, "text": "非你这样的英雄不可呀。"}, {"start": 2290.42, "end": 2292.42, "text": "现在,"}, {"start": 2292.42, "end": 2294.42, "text": "我就把徐州"}, {"start": 2294.42, "end": 2296.42, "text": "五十万百姓,"}, {"start": 2296.42, "end": 2298.42, "text": "托付给你了。"}, {"start": 2298.42, "end": 2300.42, "text": "明日我就上奏曹廷,"}, {"start": 2300.42, "end": 2302.42, "text": "赐你为"}, {"start": 2302.42, "end": 2306.78, "text": "徐州墓。"}, {"start": 2306.78, "end": 2308.78, "text": "万万不可,"}, {"start": 2308.78, "end": 2310.78, "text": "刘备万万不敢。"}, {"start": 2310.78, "end": 2312.78, "text": "有何不可呀?"}, {"start": 2312.78, "end": 2314.78, "text": "连曹操那样的奸雄"}, {"start": 2314.78, "end": 2316.78, "text": "都能戒去延州。"}, {"start": 2316.78, "end": 2318.78, "text": "你身为汉帝中士,"}, {"start": 2318.78, "end": 2320.78, "text": "德行操守,"}, {"start": 2320.78, "end": 2322.78, "text": "王氏的风范,"}, {"start": 2322.78, "end": 2324.78, "text": "为何就不能统领徐州啊?"}, {"start": 2324.78, "end": 2326.78, "text": "我不是曹操,"}, {"start": 2326.78, "end": 2328.78, "text": "在下此行前来,"}, {"start": 2328.78, "end": 2330.78, "text": "是为了救徐州,"}, {"start": 2330.78, "end": 2332.78, "text": "而不是为了图谋徐州。"}, {"start": 2332.78, "end": 2334.78, "text": "涛公,"}, {"start": 2334.78, "end": 2336.78, "text": "请万万不可,"}, {"start": 2336.78, "end": 2338.78, "text": "陷我于不义。"}, {"start": 2338.78, "end": 2340.78, "text": "玄德呀,"}, {"start": 2340.78, "end": 2342.78, "text": "请为徐州"}, {"start": 2342.78, "end": 2344.78, "text": "百姓着想,"}, {"start": 2344.78, "end": 2346.78, "text": "担此重任罢。"}, {"start": 2346.78, "end": 2356.5, "text": "禀涛公,"}, {"start": 2356.5, "end": 2358.5, "text": "今日流言在此,"}, {"start": 2358.5, "end": 2360.5, "text": "一旦曹操退兵,"}, {"start": 2360.5, "end": 2362.5, "text": "徐州转位为安,"}, {"start": 2362.5, "end": 2364.5, "text": "在下即行离去,"}, {"start": 2364.5, "end": 2371.87, "text": "重归平原县。"}, {"start": 2371.87, "end": 2373.87, "text": "玄德呀,"}, {"start": 2373.87, "end": 2375.87, "text": "真是令人敬佩呀。"}, {"start": 2375.87, "end": 2379.18, "text": "此事,"}, {"start": 2379.18, "end": 2381.18, "text": "咱们以后从长计议吧。"}, {"start": 2381.18, "end": 2385.04, "text": "哥呀,"}, {"start": 2385.04, "end": 2387.04, "text": "你这个人哪,"}, {"start": 2387.04, "end": 2389.04, "text": "是样样都好,"}, {"start": 2389.04, "end": 2391.04, "text": "就是有装毛病不好。"}, {"start": 2391.04, "end": 2393.04, "text": "打装毛病?"}, {"start": 2393.04, "end": 2397.02, "text": "看得太过了。"}, {"start": 2397.02, "end": 2399.02, "text": "心善也是毛病啊。"}, {"start": 2399.02, "end": 2402.69, "text": "人家陶谦"}, {"start": 2402.69, "end": 2404.69, "text": "大好的心意,"}, {"start": 2404.69, "end": 2406.69, "text": "送你一座徐州城,"}, {"start": 2406.69, "end": 2408.69, "text": "你为何不要啊?"}, {"start": 2408.69, "end": 2410.69, "text": "这徐州落在咱手里,"}, {"start": 2410.69, "end": 2412.69, "text": "总比落在曹操手里强吧。"}, {"start": 2412.69, "end": 2414.69, "text": "二哥,你说是不是?"}, {"start": 2414.69, "end": 2416.69, "text": "三弟所言并非没有道理。"}, {"start": 2416.69, "end": 2418.69, "text": "我们这三兄弟,"}, {"start": 2418.69, "end": 2420.69, "text": "自陶渊劫役以来,"}, {"start": 2420.69, "end": 2422.69, "text": "一直漂泊不定。"}, {"start": 2422.69, "end": 2424.69, "text": "如果得了徐州,"}, {"start": 2424.69, "end": 2426.69, "text": "我们能成立。"}, {"start": 2426.69, "end": 2428.69, "text": "进可以图大业,"}, {"start": 2428.69, "end": 2432.8, "text": "退可以保平安。"}, {"start": 2432.8, "end": 2434.8, "text": "住嘴。"}, {"start": 2434.8, "end": 2436.8, "text": "你们俩听着,"}, {"start": 2436.8, "end": 2438.8, "text": "再说此话,"}, {"start": 2438.8, "end": 2440.8, "text": "我就不敢认你们为兄弟了。"}, {"start": 2440.8, "end": 2447.02, "text": "我刘备宁肯粉身碎骨,"}, {"start": 2447.02, "end": 2449.02, "text": "也绝不行此不宜。"}, {"start": 2449.02, "end": 2451.02, "text": "那不让说,"}, {"start": 2451.02, "end": 2453.02, "text": "那咱就把嘴给缝上。"}, {"start": 2453.02, "end": 2455.02, "text": "城池算什么,"}, {"start": 2455.02, "end": 2457.02, "text": "还是兄弟要紧。"}, {"start": 2457.02, "end": 2459.02, "text": "二哥,你说是不是?"}, {"start": 2459.02, "end": 2461.02, "text": "不管如何,"}, {"start": 2461.02, "end": 2463.02, "text": "让徐州,我们都难逃,"}, {"start": 2463.02, "end": 2465.02, "text": "趁人之危之险啊。"}, {"start": 2465.02, "end": 2467.02, "text": "道义人心,"}, {"start": 2467.02, "end": 2469.02, "text": "自有公论。"}, {"start": 2469.02, "end": 2476.37, "text": "人意道德,"}, {"start": 2476.37, "end": 2478.37, "text": "不只是说在嘴上。"}, {"start": 2478.37, "end": 2480.37, "text": "更重要的,"}, {"start": 2480.37, "end": 2482.37, "text": "是要让自己问心无愧。"}]