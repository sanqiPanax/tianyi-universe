[{"start": 7.31, "end": 8.71, "text": "你好糊弄啊"}, {"start": 9.51, "end": 11.87, "text": "你扣了刘备的粮饷也就罢了"}, {"start": 12.87, "end": 16.15, "text": "你干嘛还要扣孙将军的粮草军械"}, {"start": 19.34, "end": 20.62, "text": "孙文台何许人言"}, {"start": 21.46, "end": 23.62, "text": "他是盟军的先锋大将"}, {"start": 24.54, "end": 25.98, "text": "这些我都知道"}, {"start": 27.82, "end": 30.18, "text": "我不但知道孙文台的战功"}, {"start": 30.78, "end": 34.58, "text": "我还知道他从来不把咱们原盟主放在眼里"}, {"start": 34.98, "end": 36.26, "text": "既然你已经知道了"}, {"start": 36.98, "end": 38.5, "text": "那你还责罪他做事"}, {"start": 39.5, "end": 40.1, "text": "大哥"}, {"start": 40.94, "end": 43.02, "text": "你就听于弟一句话吧"}, {"start": 43.78, "end": 45.74, "text": "汉氏气数已尽"}, {"start": 46.18, "end": 47.62, "text": "即将灭亡"}, {"start": 48.34, "end": 51.66, "text": "只有余者才傻乎乎的一味服汉"}, {"start": 53.38, "end": 54.82, "text": "恶者如董卓"}, {"start": 55.14, "end": 56.98, "text": "早已篡汉自立"}, {"start": 57.42, "end": 59.02, "text": "董卓想做的事情"}, {"start": 59.14, "end": 62.46, "text": "是许多枭雄想做而不敢做的事情"}, {"start": 65.63, "end": 67.43, "text": "你是想叫我做余者"}, {"start": 68.23, "end": 69.39, "text": "还是做恶者"}, {"start": 70.31, "end": 71.55, "text": "既不做余者"}, {"start": 72.35, "end": 73.55, "text": "也不做恶者"}, {"start": 74.67, "end": 76.19, "text": "应当做智者"}, {"start": 78.45, "end": 79.09, "text": "眼下"}, {"start": 79.93, "end": 81.97, "text": "虽然十八路诸侯会盟"}, {"start": 83.45, "end": 86.65, "text": "但是十八路诸侯的真正动机"}, {"start": 86.85, "end": 88.37, "text": "未必是为国出"}, {"start": 90.38, "end": 93.34, "text": "他们只是想在天下破乱的时候"}, {"start": 94.18, "end": 97.78, "text": "为自己寻得一块最大的地盘而已"}, {"start": 99.1, "end": 101.54, "text": "最可怕的是长沙太守孙监"}, {"start": 102.5, "end": 105.5, "text": "孙监如果破洛阳斩董卓"}, {"start": 106.22, "end": 107.7, "text": "他会不会把西粮兵"}, {"start": 107.7, "end": 109.1, "text": "囊入自己的手中啊"}, {"start": 110.74, "end": 113.7, "text": "他会不会坐镇朝廷拥兵自立"}, {"start": 114.9, "end": 116.38, "text": "会不会取代董卓"}, {"start": 116.38, "end": 117.5, "text": "称霸天下"}, {"start": 117.5, "end": 120.06, "text": "成为比董卓更可怕的枭雄啊"}, {"start": 124.61, "end": 125.37, "text": "这个"}, {"start": 133.41, "end": 135.33, "text": "也不是没有可能啊"}, {"start": 139.08, "end": 139.92, "text": "所以啊"}, {"start": 141.2, "end": 141.88, "text": "大哥"}, {"start": 143.24, "end": 144.88, "text": "我们的上策就是"}, {"start": 145.4, "end": 147.52, "text": "在剿灭董卓的同时"}, {"start": 148.08, "end": 149.28, "text": "也大大削弱"}, {"start": 149.28, "end": 151.92, "text": "孙监等诸侯的兵马士兵"}, {"start": 152.64, "end": 154.4, "text": "最好让他们一起灭亡"}, {"start": 155.24, "end": 155.88, "text": "这样"}, {"start": 156.56, "end": 160.08, "text": "天下自然就落到袁氏的狼中了"}, {"start": 160.96, "end": 163.12, "text": "这些我何尝不知啊"}, {"start": 163.72, "end": 169.37, "text": "只是你做得太过分了"}, {"start": 169.81, "end": 170.61, "text": "为何呀"}, {"start": 171.21, "end": 171.85, "text": "你想"}, {"start": 172.49, "end": 174.97, "text": "孙监是盟军的先锋大将军"}, {"start": 175.97, "end": 177.09, "text": "他一旦兵败"}, {"start": 177.09, "end": 179.57, "text": "数十万盟军将土崩瓦解"}, {"start": 179.57, "end": 181.81, "text": "到时候你我都将身败名裂"}, {"start": 182.53, "end": 184.25, "text": "还谈什么功名大业"}, {"start": 189.34, "end": 190.02, "text": "禀盟主"}, {"start": 190.02, "end": 190.78, "text": "昨夜三更"}, {"start": 190.78, "end": 191.74, "text": "李绝郭四二将"}, {"start": 191.74, "end": 193.02, "text": "率领八万西粮经纪"}, {"start": 193.02, "end": 194.06, "text": "夜袭孙监大营"}, {"start": 194.06, "end": 195.18, "text": "孙监折兵损将"}, {"start": 195.18, "end": 196.38, "text": "已退出白马要战"}, {"start": 198.35, "end": 199.23, "text": "禀盟主"}, {"start": 199.23, "end": 201.11, "text": "董卓亲率二十五万西粮大军"}, {"start": 201.11, "end": 202.11, "text": "清晨而出"}, {"start": 202.11, "end": 203.75, "text": "扬言要为国剿贼"}, {"start": 204.11, "end": 205.43, "text": "五日内斩孙监"}, {"start": 205.43, "end": 206.63, "text": "十日内取"}, {"start": 207.39, "end": 207.95, "text": "说"}, {"start": 208.99, "end": 210.35, "text": "取袁盟主首级"}, {"start": 212.24, "end": 213.08, "text": "你听到了吗"}, {"start": 215.12, "end": 216.6, "text": "我们倒成贼了"}, {"start": 219.32, "end": 221.28, "text": "朕可谓是胜者为王"}, {"start": 221.28, "end": 222.4, "text": "败者为贼"}, {"start": 223.68, "end": 224.8, "text": "如果董卓胜了"}, {"start": 225.52, "end": 227.36, "text": "你的一切竞囊妙计"}, {"start": 227.36, "end": 229.16, "text": "都成了水中月"}, {"start": 229.16, "end": 230.44, "text": "镜中花"}, {"start": 232.32, "end": 234.52, "text": "这孙监败得也太快了吧这是"}, {"start": 235.36, "end": 236.16, "text": "愚蠢"}, {"start": 236.16, "end": 237.32, "text": "害得我更愚蠢"}, {"start": 237.32, "end": 238.04, "text": "我"}, {"start": 238.04, "end": 239.84, "text": "孙监没有粮食能打仗吗"}, {"start": 240.4, "end": 241.92, "text": "孙文台兵败"}, {"start": 241.92, "end": 243.24, "text": "早在我预料之中"}, {"start": 244.96, "end": 246.08, "text": "曹将军来了"}, {"start": 247.16, "end": 248.8, "text": "敢问孟德兄"}, {"start": 248.8, "end": 250.08, "text": "为何如此说话"}, {"start": 251.6, "end": 254.0, "text": "因为孙监虽然英勇"}, {"start": 254.0, "end": 256.04, "text": "但是求胜心切"}, {"start": 256.04, "end": 257.36, "text": "独军深入"}, {"start": 257.36, "end": 259.44, "text": "已称骄兵而骄兵必败"}, {"start": 260.44, "end": 262.0, "text": "敢问袁盟主"}, {"start": 262.0, "end": 263.04, "text": "此时此刻"}, {"start": 263.64, "end": 265.32, "text": "你准备如何应变"}, {"start": 268.17, "end": 269.89, "text": "立即将孙文台备战"}, {"start": 270.89, "end": 272.97, "text": "董贼亲征的军情"}, {"start": 272.97, "end": 274.21, "text": "传达至各部"}, {"start": 275.41, "end": 277.65, "text": "之后召集各镇诸侯"}, {"start": 277.65, "end": 279.29, "text": "共商御敌大宋"}, {"start": 279.29, "end": 280.09, "text": "不"}, {"start": 280.57, "end": 284.66, "text": "你万万不可将"}, {"start": 284.66, "end": 285.98, "text": "孙监兵败的事情"}, {"start": 285.98, "end": 287.22, "text": "告诉各诸侯"}, {"start": 288.58, "end": 289.42, "text": "相反"}, {"start": 290.3, "end": 291.62, "text": "你要告诉大伙"}, {"start": 291.62, "end": 292.82, "text": "孙监胜了"}, {"start": 292.82, "end": 294.02, "text": "而且是大胜"}, {"start": 294.62, "end": 295.78, "text": "董卓"}, {"start": 295.78, "end": 297.7, "text": "才是兵败如山倒"}, {"start": 298.34, "end": 300.18, "text": "现在就等着大家伙儿"}, {"start": 300.18, "end": 301.34, "text": "义勇而上"}, {"start": 301.34, "end": 302.62, "text": "攻下虎牢关"}, {"start": 302.94, "end": 304.42, "text": "直取洛阳城"}, {"start": 305.42, "end": 306.54, "text": "否则的话"}, {"start": 307.06, "end": 308.58, "text": "孙监兵败"}, {"start": 309.06, "end": 311.38, "text": "必然会引起各诸侯的"}, {"start": 311.38, "end": 312.66, "text": "拒敌之心"}, {"start": 312.98, "end": 314.38, "text": "而人心一散"}, {"start": 314.86, "end": 316.14, "text": "盟军就完了"}, {"start": 316.62, "end": 317.42, "text": "传令"}, {"start": 322.62, "end": 324.1, "text": "率台设宴"}, {"start": 324.62, "end": 327.02, "text": "为孙将军庆功"}, {"start": 327.5, "end": 330.41, "text": "列位将军"}, {"start": 330.81, "end": 332.01, "text": "孙文台雄"}, {"start": 332.01, "end": 334.87, "text": "大破贼军"}, {"start": 335.51, "end": 337.51, "text": "大张我盟军的声音"}, {"start": 337.51, "end": 338.47, "text": "我等"}, {"start": 339.51, "end": 340.87, "text": "为孙将军"}, {"start": 342.19, "end": 343.47, "text": "遥相"}, {"start": 343.47, "end": 344.51, "text": "庆贺"}, {"start": 345.31, "end": 348.07, "text": "为孙将军庆贺"}, {"start": 348.07, "end": 349.31, "text": "董贼"}, {"start": 349.31, "end": 355.81, "text": "谈之可灭"}, {"start": 356.29, "end": 357.85, "text": "我等数日后"}, {"start": 357.85, "end": 359.09, "text": "就可在京城"}, {"start": 359.09, "end": 360.57, "text": "把酒庆功了"}, {"start": 365.01, "end": 366.01, "text": "袁盟主"}, {"start": 367.09, "end": 368.25, "text": "我听说董卓"}, {"start": 368.25, "end": 369.85, "text": "已经拥兵出关了"}, {"start": 369.89, "end": 370.89, "text": "此事确否"}, {"start": 371.21, "end": 372.21, "text": "是"}, {"start": 372.93, "end": 373.93, "text": "那么"}, {"start": 376.37, "end": 377.53, "text": "我等还要在此"}, {"start": 377.53, "end": 379.05, "text": "聚饮高会吗"}, {"start": 379.45, "end": 380.61, "text": "兵法云"}, {"start": 381.33, "end": 385.78, "text": "以静制动"}, {"start": 386.18, "end": 387.58, "text": "以义代劳"}, {"start": 388.14, "end": 390.18, "text": "乃胜战之道也"}, {"start": 390.58, "end": 392.78, "text": "董卓的大军既已出关"}, {"start": 396.04, "end": 397.4, "text": "孙文台的孤军"}, {"start": 397.4, "end": 399.0, "text": "便处于险境了"}, {"start": 400.12, "end": 401.12, "text": "盟主"}, {"start": 401.44, "end": 403.64, "text": "就不担心他会兵败吗"}, {"start": 403.64, "end": 404.64, "text": "为何"}, {"start": 404.64, "end": 405.76, "text": "他不担心"}, {"start": 405.76, "end": 411.91, "text": "兵败吗"}, {"start": 411.91, "end": 412.87, "text": "你为何扣下"}, {"start": 412.87, "end": 414.47, "text": "我哥哥的粮饷步伐"}, {"start": 414.47, "end": 416.35, "text": "为何还打我的属下"}, {"start": 416.35, "end": 418.07, "text": "你一个小小的布工手"}, {"start": 418.07, "end": 419.27, "text": "怎敢如此无礼"}, {"start": 419.27, "end": 420.27, "text": "咱俩"}, {"start": 420.27, "end": 421.47, "text": "俺张飞"}, {"start": 421.47, "end": 423.11, "text": "对这无耻之徒"}, {"start": 423.11, "end": 424.11, "text": "历来无礼"}, {"start": 424.55, "end": 425.55, "text": "你们敢怎么样"}, {"start": 430.45, "end": 433.45, "text": "好啊"}, {"start": 433.45, "end": 434.85, "text": "列位诸公"}, {"start": 436.25, "end": 437.45, "text": "如果你们容得下"}, {"start": 437.45, "end": 438.73, "text": "这三位在这里"}, {"start": 438.73, "end": 439.93, "text": "肆意放肆"}, {"start": 441.05, "end": 442.97, "text": "那就容我袁术"}, {"start": 443.61, "end": 444.97, "text": "告老还乡了"}, {"start": 444.97, "end": 446.49, "text": "龚禄兄息怒了"}, {"start": 451.14, "end": 452.22, "text": "袁弓禄"}, {"start": 453.02, "end": 454.46, "text": "位居副盟主"}, {"start": 454.46, "end": 457.02, "text": "掌管我十九路诸侯之粮饷"}, {"start": 457.02, "end": 458.5, "text": "岂能一走了之"}, {"start": 459.14, "end": 460.14, "text": "你走了"}, {"start": 460.7, "end": 461.98, "text": "我们吃什么"}, {"start": 461.98, "end": 462.98, "text": "吃什么"}, {"start": 462.98, "end": 464.14, "text": "是啊"}, {"start": 466.14, "end": 467.14, "text": "坐坐坐"}, {"start": 469.54, "end": 470.9, "text": "既然如此"}, {"start": 470.9, "end": 472.74, "text": "容我三兄弟告退"}, {"start": 473.14, "end": 474.14, "text": "玄德"}, {"start": 474.54, "end": 482.23, "text": "留步"}, {"start": 482.23, "end": 483.23, "text": "玄德"}, {"start": 484.31, "end": 486.03, "text": "你乃汉皇宗亲"}, {"start": 486.03, "end": 487.75, "text": "有辱我盟军大道"}, {"start": 488.31, "end": 490.11, "text": "岂能一走了之"}, {"start": 490.11, "end": 490.99, "text": "你走了"}, {"start": 490.99, "end": 492.43, "text": "我等岂不寒心"}, {"start": 492.87, "end": 494.27, "text": "孟德不必寒心"}, {"start": 495.11, "end": 496.35, "text": "你完全知道"}, {"start": 497.03, "end": 498.27, "text": "天下虽大"}, {"start": 498.95, "end": 499.95, "text": "列位"}, {"start": 500.67, "end": 502.39, "text": "却难以并列于十"}, {"start": 540.95, "end": 541.95, "text": "奉先哪"}, {"start": 543.23, "end": 544.23, "text": "看见了吧"}, {"start": 545.27, "end": 546.67, "text": "前面那座城池"}, {"start": 547.11, "end": 549.03, "text": "那便是袁绍的大营"}, {"start": 551.72, "end": 552.72, "text": "义父"}, {"start": 553.48, "end": 555.4, "text": "凭我的赤兔马方天几"}, {"start": 555.88, "end": 557.88, "text": "是十八路诸侯如草芥"}, {"start": 558.88, "end": 560.04, "text": "待会儿交兵时"}, {"start": 560.8, "end": 563.12, "text": "我会亲手斩下袁绍的脑袋"}, {"start": 564.44, "end": 565.56, "text": "以报义父厚恩"}, {"start": 567.44, "end": 568.44, "text": "好 好"}, {"start": 569.8, "end": 572.2, "text": "我儿英雄盖世"}, {"start": 572.2, "end": 573.44, "text": "天下无敌"}, {"start": 574.92, "end": 575.84, "text": "不过"}, {"start": 575.84, "end": 578.2, "text": "袁绍他也是徒有虚名"}, {"start": 578.2, "end": 579.2, "text": "不足为虑"}, {"start": 580.56, "end": 582.4, "text": "他的狗头可以"}, {"start": 582.4, "end": 584.12, "text": "占据其向上"}, {"start": 584.8, "end": 586.2, "text": "但有一个人的脑袋"}, {"start": 586.56, "end": 587.56, "text": "奉先"}, {"start": 587.64, "end": 589.92, "text": "务必替咱家把他取来"}, {"start": 591.24, "end": 591.88, "text": "是谁"}, {"start": 592.84, "end": 594.08, "text": "恶贼曹操"}, {"start": 595.16, "end": 597.36, "text": "这小子咱家恨偷他了"}, {"start": 597.84, "end": 599.4, "text": "可莫得把他碎尸万段"}, {"start": 600.16, "end": 601.4, "text": "错骨扬灰"}, {"start": 601.4, "end": 603.4, "text": "才能解我这心头之恨"}, {"start": 604.68, "end": 605.8, "text": "义父请放心"}, {"start": 606.72, "end": 607.72, "text": "儿臣一定会"}, {"start": 608.4, "end": 610.0, "text": "砍下曹操的头颅"}, {"start": 612.76, "end": 613.48, "text": "你再看"}, {"start": 613.96, "end": 615.56, "text": "看看前面那座城官"}, {"start": 616.24, "end": 617.64, "text": "极其高大兼顾"}, {"start": 618.2, "end": 620.44, "text": "我西梁军纪善于野外作战"}, {"start": 620.44, "end": 621.92, "text": "但不善于攻坚"}, {"start": 621.92, "end": 623.56, "text": "如果袁绍他"}, {"start": 624.08, "end": 625.76, "text": "拒手不战的话"}, {"start": 626.4, "end": 627.72, "text": "可就颇为麻烦了"}, {"start": 630.28, "end": 631.12, "text": "义父有何意见"}, {"start": 632.56, "end": 633.4, "text": "我想啊"}, {"start": 634.44, "end": 635.08, "text": "咱们这样"}, {"start": 636.48, "end": 638.08, "text": "让大军在此设伏"}, {"start": 638.08, "end": 640.4, "text": "你带领百计前去挑战"}, {"start": 640.4, "end": 643.0, "text": "设法把袁绍引出关来"}, {"start": 643.0, "end": 645.24, "text": "咱们在野外和他决意持兄"}, {"start": 646.24, "end": 647.2, "text": "不许百计"}, {"start": 648.88, "end": 649.8, "text": "单击便可"}, {"start": 652.92, "end": 656.76, "text": "咱俩势力之族"}, {"start": 657.04, "end": 658.56, "text": "他有什么资格做盟主啊"}, {"start": 658.76, "end": 663.16, "text": "你吓得几个大尔瓜子带走"}, {"start": 663.72, "end": 664.32, "text": "三弟"}, {"start": 664.88, "end": 666.36, "text": "收起你那大尔瓜子吧"}, {"start": 666.84, "end": 668.6, "text": "当心脏了自己的手"}, {"start": 670.24, "end": 671.76, "text": "不瞒二位兄弟说"}, {"start": 673.36, "end": 675.4, "text": "我其实并不想离开盟军"}, {"start": 676.52, "end": 678.76, "text": "但是他们不容我等"}, {"start": 681.23, "end": 682.11, "text": "怎么着哥哥"}, {"start": 682.91, "end": 685.39, "text": "你还惦记着十九镇将军的宝座"}, {"start": 685.79, "end": 687.99, "text": "区区虚名 何足留恋"}, {"start": 689.27, "end": 691.91, "text": "我是惦记着洛阳城内的盟难天子"}, {"start": 692.71, "end": 694.91, "text": "盟军原本可以杀进京城"}, {"start": 695.19, "end": 696.39, "text": "灭贼兴旱的"}, {"start": 697.23, "end": 697.99, "text": "这个好办啊"}, {"start": 698.51, "end": 700.75, "text": "我们三兄弟只管杀进洛阳"}, {"start": 701.55, "end": 703.03, "text": "看他董卓的脑袋就事了"}, {"start": 703.59, "end": 704.11, "text": "三弟"}, {"start": 704.51, "end": 705.39, "text": "就是莽撞"}, {"start": 706.27, "end": 706.79, "text": "大哥"}, {"start": 707.95, "end": 708.91, "text": "我们走了也好"}, {"start": 709.39, "end": 711.71, "text": "来时三兄弟走时兄弟仨"}, {"start": 712.31, "end": 714.59, "text": "无牵无挂 志在天下"}, {"start": 723.2, "end": 729.73, "text": "儿等听着"}, {"start": 730.69, "end": 732.09, "text": "莫要做缩头乌龟"}, {"start": 733.29, "end": 735.49, "text": "快快出来和我吕布决一死战"}, {"start": 738.33, "end": 738.81, "text": "禀盟主"}, {"start": 739.25, "end": 740.73, "text": "西梁军已杀到关前了"}, {"start": 741.45, "end": 742.17, "text": "多少兵马"}, {"start": 742.57, "end": 743.93, "text": "关前只有吕布一人"}, {"start": 744.41, "end": 745.25, "text": "他单人闯关"}, {"start": 745.81, "end": 747.73, "text": "指名要娶曹操头颅"}, {"start": 749.25, "end": 750.21, "text": "多谢多谢啊"}, {"start": 750.77, "end": 752.57, "text": "曹某又要名扬天下了"}, {"start": 754.69, "end": 755.61, "text": "各位将军"}, {"start": 756.61, "end": 757.61, "text": "区区吕布"}, {"start": 758.49, "end": 759.69, "text": "只身闯关"}, {"start": 761.25, "end": 763.09, "text": "是众将军如无物"}, {"start": 765.38, "end": 766.18, "text": "是可忍"}, {"start": 767.9, "end": 769.3, "text": "孰不可忍啊"}, {"start": 770.7, "end": 772.06, "text": "我部汉将刘三刀"}, {"start": 772.7, "end": 773.58, "text": "三刀之内"}, {"start": 773.98, "end": 775.38, "text": "必斩吕布于马下"}, {"start": 775.94, "end": 776.38, "text": "好"}, {"start": 777.14, "end": 778.5, "text": "我有上将韩勇"}, {"start": 778.66, "end": 779.58, "text": "可出战吕布"}, {"start": 780.7, "end": 781.26, "text": "二位且慢"}, {"start": 785.06, "end": 786.3, "text": "我有北海勇驾王充"}, {"start": 786.5, "end": 788.14, "text": "他早就想刀劈吕布"}, {"start": 788.5, "end": 789.42, "text": "博下赤土马"}, {"start": 789.58, "end": 790.86, "text": "做他自己的作计了"}, {"start": 791.78, "end": 792.26, "text": "好"}, {"start": 792.62, "end": 793.1, "text": "盟主"}, {"start": 794.22, "end": 796.38, "text": "韩将军 刘将军 王将军已经出城"}, {"start": 797.1, "end": 798.26, "text": "与吕布战斗一起"}, {"start": 799.54, "end": 800.06, "text": "怎么样"}, {"start": 800.5, "end": 801.34, "text": "三个回合"}, {"start": 801.82, "end": 803.62, "text": "三位将军全都被吕布"}, {"start": 804.54, "end": 805.38, "text": "斩落马下"}, {"start": 819.93, "end": 820.41, "text": "传令"}, {"start": 822.62, "end": 823.58, "text": "紧闭城门"}, {"start": 824.34, "end": 826.78, "text": "任何人不得擅自主战"}, {"start": 827.1, "end": 827.54, "text": "遵命"}, {"start": 830.45, "end": 831.89, "text": "关内各镇诸侯听着"}, {"start": 832.41, "end": 833.61, "text": "你们胆小如鼠"}, {"start": 834.21, "end": 835.13, "text": "所守如归"}, {"start": 836.45, "end": 838.13, "text": "看我吕布如何教训你们"}, {"start": 855.54, "end": 856.54, "text": "关内诸侯们"}, {"start": 857.26, "end": 859.3, "text": "你们不是有十八剑吗"}, {"start": 860.3, "end": 861.54, "text": "今日就让我吕布"}, {"start": 862.06, "end": 863.38, "text": "来送你们十八剑"}, {"start": 863.94, "end": 864.58, "text": "袁盟主"}, {"start": 891.7, "end": 894.1, "text": "大帝当前 懂贼亲智"}, {"start": 894.98, "end": 896.7, "text": "此仗许胜不许败"}, {"start": 896.9, "end": 897.9, "text": "操某不才"}, {"start": 898.1, "end": 900.34, "text": "愿为盟军排兵布阵"}, {"start": 902.7, "end": 903.9, "text": "孟德兄请"}, {"start": 904.46, "end": 909.53, "text": "吕布再是汉勇"}, {"start": 910.93, "end": 912.85, "text": "也不过是一介匹夫"}, {"start": 913.17, "end": 915.29, "text": "他之所以敢如此嚣张"}, {"start": 915.49, "end": 916.89, "text": "是因为董卓的大军"}, {"start": 916.89, "end": 917.73, "text": "居此不远"}, {"start": 918.33, "end": 918.93, "text": "董卓"}, {"start": 919.37, "end": 921.01, "text": "是想用吕布为二"}, {"start": 921.21, "end": 922.65, "text": "迎我们出关作战"}, {"start": 922.85, "end": 924.89, "text": "与他的西凉军野战"}, {"start": 925.97, "end": 926.49, "text": "我意"}, {"start": 927.05, "end": 928.13, "text": "三个时辰之内"}, {"start": 928.33, "end": 929.93, "text": "我们不可出关迎敌"}, {"start": 930.13, "end": 931.25, "text": "我们要等到"}, {"start": 931.85, "end": 932.85, "text": "日过上午"}, {"start": 933.33, "end": 935.37, "text": "西凉军人困马乏的时候"}, {"start": 935.77, "end": 937.29, "text": "方可开关迎敌"}, {"start": 938.29, "end": 939.13, "text": "说得好"}, {"start": 939.73, "end": 940.73, "text": "可袁硕"}, {"start": 940.73, "end": 941.77, "text": "可袁硕"}, {"start": 941.97, "end": 943.33, "text": "答应给我的两万斤粮草"}, {"start": 943.33, "end": 944.61, "text": "至今还没有踪影呢"}, {"start": 944.81, "end": 945.73, "text": "没有粮草"}, {"start": 945.93, "end": 947.89, "text": "叫我的兵马饿着肚子奔袭吗"}, {"start": 948.41, "end": 949.09, "text": "袁国禄"}, {"start": 949.09, "end": 951.01, "text": "你答应布给我的三千兵马在哪里"}, {"start": 951.01, "end": 952.29, "text": "还有我布的粮草呢"}, {"start": 952.29, "end": 953.41, "text": "什么时候发给我"}, {"start": 953.41, "end": 955.09, "text": "兰少给了你多少粮抢兵马"}, {"start": 955.09, "end": 956.65, "text": "你为何老替他说话"}, {"start": 956.65, "end": 957.81, "text": "他是你天王老子吗"}, {"start": 957.81, "end": 958.61, "text": "公孙将军"}, {"start": 958.61, "end": 959.81, "text": "你欺人太甚"}, {"start": 959.81, "end": 961.21, "text": "本太守会盟以来"}, {"start": 961.21, "end": 962.65, "text": "何曾得到过一兵一卒"}, {"start": 962.65, "end": 963.25, "text": "刘代"}, {"start": 963.65, "end": 966.13, "text": "你为何霸占我当阳三军布阵"}, {"start": 966.13, "end": 967.33, "text": "好啊 我倒想问问你"}, {"start": 967.33, "end": 968.65, "text": "你为何纵容不浅"}, {"start": 968.97, "end": 970.09, "text": "出宫出狗"}, {"start": 970.57, "end": 971.89, "text": "听我草谋一言"}, {"start": 972.37, "end": 974.85, "text": "我算是明白天下大乱的根源了"}, {"start": 975.33, "end": 977.01, "text": "正如玄德所言"}, {"start": 978.01, "end": 980.93, "text": "天下大乱的根源在于人心丧乱"}, {"start": 981.33, "end": 984.18, "text": "现在此时此刻"}, {"start": 984.7, "end": 987.02, "text": "董卓的大军正在关前挑战"}, {"start": 987.02, "end": 988.98, "text": "我们却在这儿勾心斗角"}, {"start": 988.98, "end": 990.42, "text": "天下岂能不乱"}, {"start": 990.42, "end": 991.42, "text": "你少废话"}, {"start": 991.42, "end": 992.42, "text": "你别吵了"}, {"start": 992.42, "end": 993.42, "text": "你别吵了"}, {"start": 993.42, "end": 994.42, "text": "你别吵了"}, {"start": 994.42, "end": 995.42, "text": "你别吵了"}, {"start": 995.42, "end": 996.42, "text": "你别吵了"}, {"start": 996.42, "end": 997.42, "text": "你别吵了"}, {"start": 997.42, "end": 998.42, "text": "别吵了"}, {"start": 998.42, "end": 999.42, "text": "你别吵了"}, {"start": 999.66, "end": 1000.66, "text": "你别吵了"}, {"start": 1000.66, "end": 1001.66, "text": "你别吵了"}, {"start": 1001.66, "end": 1002.66, "text": "你别吵了"}, {"start": 1002.66, "end": 1003.66, "text": "种族红蓝鸡"}, {"start": 1003.66, "end": 1004.66, "text": "不要打他"}, {"start": 1004.66, "end": 1009.58, "text": "摘除马汉数字消息"}, {"start": 1009.58, "end": 1010.58, "text": "不足一轮大事"}, {"start": 1011.58, "end": 1022.94, "text": "玄德兄"}, {"start": 1022.94, "end": 1023.94, "text": "留步"}, {"start": 1024.94, "end": 1025.94, "text": "请留步"}, {"start": 1026.94, "end": 1027.94, "text": "梦德"}, {"start": 1027.94, "end": 1029.94, "text": "在下就要出城了"}, {"start": 1029.94, "end": 1031.94, "text": "形色匆匆不及面子"}, {"start": 1031.94, "end": 1032.94, "text": "请阁下恕罪"}, {"start": 1033.94, "end": 1034.94, "text": "为什么要走了"}, {"start": 1036.94, "end": 1038.94, "text": "是觉得袁绍不配做盟主"}, {"start": 1038.94, "end": 1039.94, "text": "还是"}, {"start": 1039.94, "end": 1041.94, "text": "玄德兄无异于功名利益"}, {"start": 1042.18, "end": 1044.18, "text": "袁绍配不配做盟主"}, {"start": 1044.18, "end": 1045.18, "text": "在下不敢往"}, {"start": 1046.18, "end": 1048.18, "text": "但我兄弟三个前来会盟"}, {"start": 1048.18, "end": 1050.18, "text": "是为了诛贼的"}, {"start": 1050.18, "end": 1052.18, "text": "并不是为了功名利益"}, {"start": 1052.18, "end": 1053.18, "text": "说得好"}, {"start": 1054.18, "end": 1055.18, "text": "曹某也有一句话"}, {"start": 1055.18, "end": 1057.18, "text": "搁在心里很久了"}, {"start": 1058.18, "end": 1059.18, "text": "请梦德试下"}, {"start": 1060.18, "end": 1063.53, "text": "你们三兄弟的报国壮志"}, {"start": 1063.53, "end": 1064.53, "text": "忠义豪情"}, {"start": 1064.53, "end": 1066.53, "text": "曹某极为敬佩"}, {"start": 1066.53, "end": 1068.53, "text": "在下斗胆相邀"}, {"start": 1068.53, "end": 1069.53, "text": "请你们"}, {"start": 1069.53, "end": 1072.53, "text": "暂居曹营咱们共壮"}, {"start": 1072.77, "end": 1073.77, "text": "多谢梦德厚爱"}, {"start": 1084.24, "end": 1086.24, "text": "不过我三兄弟"}, {"start": 1086.24, "end": 1088.24, "text": "刚刚离开袁绍"}, {"start": 1088.24, "end": 1090.24, "text": "转眼就投入曹营"}, {"start": 1090.24, "end": 1092.24, "text": "梦德不怕忠诸侯"}, {"start": 1092.24, "end": 1093.24, "text": "非议吗"}, {"start": 1093.24, "end": 1098.22, "text": "在下也斗胆直言"}, {"start": 1098.22, "end": 1100.22, "text": "留备别无所长"}, {"start": 1100.22, "end": 1102.22, "text": "但为使的原则"}, {"start": 1102.22, "end": 1103.22, "text": "却恪守不便"}, {"start": 1103.22, "end": 1105.22, "text": "不过此刻你们也出不了城"}, {"start": 1111.5, "end": 1112.5, "text": "为何"}, {"start": 1112.5, "end": 1114.5, "text": "因为吕布"}, {"start": 1114.5, "end": 1116.5, "text": "此刻正在关前挑战"}, {"start": 1116.74, "end": 1118.74, "text": "此刻正在关前挑战"}, {"start": 1119.74, "end": 1120.74, "text": "这小子真的来了"}, {"start": 1120.74, "end": 1122.74, "text": "来得好"}, {"start": 1123.74, "end": 1125.74, "text": "有句话不知道你们听说过没"}, {"start": 1125.74, "end": 1127.74, "text": "这个世上有两样绝品"}, {"start": 1128.74, "end": 1129.74, "text": "是为"}, {"start": 1129.74, "end": 1130.74, "text": "人中吕布"}, {"start": 1130.74, "end": 1131.74, "text": "马中蚩兔"}, {"start": 1132.74, "end": 1135.74, "text": "吕布手中那杆方天画旗"}, {"start": 1135.74, "end": 1136.74, "text": "使得那是"}, {"start": 1136.74, "end": 1138.74, "text": "出神入化"}, {"start": 1138.74, "end": 1140.74, "text": "他跨下的那批蚩兔马"}, {"start": 1140.74, "end": 1141.74, "text": "日行千里"}, {"start": 1141.74, "end": 1143.74, "text": "快如闪电"}, {"start": 1143.74, "end": 1147.76, "text": "他还视天下英雄"}, {"start": 1147.76, "end": 1149.76, "text": "成为草芥"}, {"start": 1149.76, "end": 1151.76, "text": "山川巨谷在蚩兔马的脚下"}, {"start": 1151.76, "end": 1153.76, "text": "也是如履平地"}, {"start": 1153.76, "end": 1157.07, "text": "董卓得吕布"}, {"start": 1157.07, "end": 1159.07, "text": "胜得十万雄兵"}, {"start": 1159.07, "end": 1161.07, "text": "如今更可怕的是"}, {"start": 1161.07, "end": 1163.07, "text": "这两样绝品居然"}, {"start": 1163.07, "end": 1165.07, "text": "合二为一了"}, {"start": 1165.07, "end": 1169.57, "text": "此刻"}, {"start": 1169.57, "end": 1171.57, "text": "吕布正骑着蚩兔马"}, {"start": 1171.57, "end": 1173.57, "text": "在关前挑战"}, {"start": 1173.57, "end": 1175.57, "text": "可是十八路诸侯"}, {"start": 1175.57, "end": 1177.57, "text": "居然没有一个人敢去应战"}, {"start": 1177.57, "end": 1179.57, "text": "全都像缩头乌龟一样的"}, {"start": 1179.57, "end": 1181.57, "text": "不敢露面"}, {"start": 1181.57, "end": 1183.57, "text": "所以"}, {"start": 1183.57, "end": 1185.57, "text": "我觉得你们也是"}, {"start": 1185.57, "end": 1187.57, "text": "先回避一下"}, {"start": 1187.57, "end": 1189.57, "text": "大哥 二哥"}, {"start": 1189.57, "end": 1191.57, "text": "你们站起来这里稍候"}, {"start": 1191.57, "end": 1193.57, "text": "看我从吕布那小子"}, {"start": 1193.57, "end": 1195.57, "text": "一万个透明窟窿去"}, {"start": 1195.57, "end": 1197.57, "text": "三弟"}, {"start": 1197.57, "end": 1199.57, "text": "吕布勇猛过人"}, {"start": 1199.57, "end": 1201.57, "text": "还是由我来站啊"}, {"start": 1201.57, "end": 1203.57, "text": "二哥"}, {"start": 1203.57, "end": 1205.57, "text": "你先前已经斩了花雄"}, {"start": 1205.57, "end": 1207.57, "text": "如果你要是抢我的功劳"}, {"start": 1207.57, "end": 1209.57, "text": "我就不认你这二哥了"}, {"start": 1209.57, "end": 1211.57, "text": "三弟 还是"}, {"start": 1211.57, "end": 1216.06, "text": "听大哥的吩咐"}, {"start": 1216.06, "end": 1218.06, "text": "孟德 你抢你把我两兄弟"}, {"start": 1218.06, "end": 1220.06, "text": "都系成什么样"}, {"start": 1220.06, "end": 1222.06, "text": "那里 我是好意"}, {"start": 1222.06, "end": 1224.06, "text": "我觉得我们还是要"}, {"start": 1224.06, "end": 1226.06, "text": "回避一下吕布这头猛虎"}, {"start": 1226.06, "end": 1228.06, "text": "好"}, {"start": 1228.06, "end": 1230.06, "text": "在下也有一句话"}, {"start": 1230.06, "end": 1232.06, "text": "请曹公转告袁绍"}, {"start": 1232.06, "end": 1234.06, "text": "请讲"}, {"start": 1234.06, "end": 1236.06, "text": "我三兄弟会盟当日"}, {"start": 1236.06, "end": 1238.06, "text": "便送了一份大礼"}, {"start": 1238.06, "end": 1240.06, "text": "为盟军斩了花雄"}, {"start": 1242.06, "end": 1244.06, "text": "今日我三兄弟离去"}, {"start": 1244.06, "end": 1246.06, "text": "同样"}, {"start": 1246.06, "end": 1248.06, "text": "还要再送盟军一份大礼"}, {"start": 1248.06, "end": 1250.06, "text": "何礼"}, {"start": 1250.06, "end": 1252.06, "text": "斩吕布"}, {"start": 1252.06, "end": 1257.2, "text": "玄德兄这一句话"}, {"start": 1257.2, "end": 1259.2, "text": "足以羞煞"}, {"start": 1259.2, "end": 1261.2, "text": "十八路诸侯"}, {"start": 1261.2, "end": 1269.09, "text": "三弟"}, {"start": 1269.09, "end": 1271.09, "text": "令你初战吕布"}, {"start": 1271.09, "end": 1273.09, "text": "我和你二哥为你略震"}, {"start": 1273.09, "end": 1337.84, "text": "我堂堂吕布"}, {"start": 1337.84, "end": 1339.84, "text": "为何成了三姓家奴"}, {"start": 1339.84, "end": 1341.84, "text": "哼 你小子"}, {"start": 1341.84, "end": 1345.7, "text": "姓吕是不"}, {"start": 1345.7, "end": 1347.7, "text": "可你先带了丁元将军做义父"}, {"start": 1347.7, "end": 1349.7, "text": "那董卓"}, {"start": 1349.7, "end": 1351.7, "text": "用了一匹赤兔马"}, {"start": 1351.7, "end": 1353.7, "text": "就把你给收买过来了"}, {"start": 1353.7, "end": 1355.7, "text": "你竟然为了一匹马"}, {"start": 1355.7, "end": 1357.7, "text": "就亲手杀了你义父丁元"}, {"start": 1357.7, "end": 1359.7, "text": "后来"}, {"start": 1359.7, "end": 1361.7, "text": "任董卓做了义父"}, {"start": 1361.7, "end": 1363.7, "text": "你不是三姓家奴"}, {"start": 1363.7, "end": 1366.98, "text": "是什么呀"}, {"start": 1366.98, "end": 1368.98, "text": "三姓家奴 快来杀死"}, {"start": 1368.98, "end": 1374.82, "text": "三姓家奴"}, {"start": 1374.82, "end": 1680.27, "text": "你是个英雄豪解"}, {"start": 1680.27, "end": 1682.27, "text": "董卓是乱世奸贼"}, {"start": 1682.27, "end": 1684.27, "text": "你为何要施神于贼"}, {"start": 1684.27, "end": 1686.27, "text": "为何不归顺朝廷"}, {"start": 1686.27, "end": 1688.27, "text": "为大汉建立万世功勋"}, {"start": 1688.27, "end": 1690.27, "text": "此时我三兄弟要你性命"}, {"start": 1690.27, "end": 1692.27, "text": "如探囊取物"}, {"start": 1692.27, "end": 1694.27, "text": "但是英雄相惜"}, {"start": 1694.27, "end": 1696.27, "text": "我等不忍杀你"}, {"start": 1696.27, "end": 1698.27, "text": "天舞一眼 快快弃暗透明"}, {"start": 1698.27, "end": 1700.27, "text": "哥哥 不必跟他啰嗦"}, {"start": 1700.27, "end": 1702.27, "text": "三姓家奴"}, {"start": 1706.27, "end": 1785.01, "text": "武艺高强"}, {"start": 1785.01, "end": 1787.01, "text": "不愧是人中吕布 马中赤兔"}, {"start": 1789.01, "end": 1791.01, "text": "可惜啊 如此英雄却陷入奸人之手"}, {"start": 1791.01, "end": 1794.29, "text": "可惜啊 如此英雄却陷入奸人之手"}, {"start": 1794.29, "end": 1796.29, "text": "你又动了侧隐之心了"}, {"start": 1796.29, "end": 1798.29, "text": "此人不可叫话"}, {"start": 1798.29, "end": 1800.29, "text": "大哥 二哥"}, {"start": 1800.29, "end": 1802.29, "text": "现在正好乘胜追杀才是"}, {"start": 1802.29, "end": 1804.29, "text": "董卓大军肯定藏于山后"}, {"start": 1804.29, "end": 1806.29, "text": "二弟 三弟不必再追了"}, {"start": 1806.29, "end": 1808.29, "text": "董贼若待 正好推他手机"}, {"start": 1808.29, "end": 1810.29, "text": "杀过去"}, {"start": 1810.29, "end": 1812.29, "text": "三弟 三弟 三弟 回来"}, {"start": 1812.29, "end": 1814.29, "text": "快回来 走"}, {"start": 1827.71, "end": 1829.71, "text": "袁盟主 贼军失穷 良机难得"}, {"start": 1829.71, "end": 1831.71, "text": "快传命进军吧"}, {"start": 1831.71, "end": 1833.71, "text": "好 众将听令"}, {"start": 1833.71, "end": 1835.71, "text": "大开城门"}, {"start": 1835.71, "end": 1837.71, "text": "出战 董卓"}, {"start": 1837.71, "end": 1839.71, "text": "走"}, {"start": 1839.71, "end": 1841.71, "text": "出战"}, {"start": 1841.71, "end": 1847.74, "text": "快"}, {"start": 1847.74, "end": 1849.74, "text": "曹仁"}, {"start": 1849.74, "end": 1851.74, "text": "在 我部将是何在"}, {"start": 1851.74, "end": 1853.74, "text": "全部集结完毕"}, {"start": 1853.74, "end": 1855.74, "text": "都在城东待命"}, {"start": 1855.74, "end": 1857.74, "text": "随我直奔虎牢关"}, {"start": 1857.74, "end": 1880.67, "text": "共取洛阳"}, {"start": 1880.67, "end": 1882.67, "text": "袁绍率领的王师"}, {"start": 1882.67, "end": 1884.67, "text": "已经攻破了虎牢关"}, {"start": 1884.67, "end": 1886.67, "text": "大获全胜"}, {"start": 1886.67, "end": 1888.67, "text": "西梁军之溃败"}, {"start": 1888.67, "end": 1890.67, "text": "董卓被刘关璋三兄弟"}, {"start": 1890.67, "end": 1892.67, "text": "赐于马下"}, {"start": 1892.67, "end": 1894.67, "text": "生死不明"}, {"start": 1894.67, "end": 1896.67, "text": "好啊"}, {"start": 1896.67, "end": 1898.67, "text": "生死不明 那就是死了"}, {"start": 1898.67, "end": 1900.67, "text": "上天哪"}, {"start": 1900.67, "end": 1902.67, "text": "苍生有幸"}, {"start": 1902.67, "end": 1904.67, "text": "日月光复"}, {"start": 1904.67, "end": 1906.67, "text": "是啊"}, {"start": 1906.67, "end": 1908.67, "text": "西梁军败兵"}, {"start": 1908.67, "end": 1910.67, "text": "正在苍黄逃命"}, {"start": 1910.67, "end": 1912.67, "text": "我王师"}, {"start": 1912.67, "end": 1914.67, "text": "兵临城下"}, {"start": 1914.67, "end": 1916.67, "text": "眼瞅着破城灾及"}, {"start": 1916.67, "end": 1918.67, "text": "我大汉"}, {"start": 1918.67, "end": 1920.67, "text": "不日即可复兴"}, {"start": 1920.67, "end": 1922.67, "text": "我快将这消息"}, {"start": 1922.67, "end": 1924.67, "text": "赶紧告诉太后和天子"}, {"start": 1924.67, "end": 1926.67, "text": "你们赶紧"}, {"start": 1926.67, "end": 1928.67, "text": "召集人手"}, {"start": 1928.67, "end": 1930.67, "text": "准备应变"}, {"start": 1930.67, "end": 1955.26, "text": "是"}, {"start": 1955.26, "end": 1957.26, "text": "带着甲师们闯进皇宫里来了"}, {"start": 1962.66, "end": 1964.66, "text": "袁绍的五十万大军"}, {"start": 1964.66, "end": 1966.66, "text": "被咱家打得落花流水"}, {"start": 1966.66, "end": 1968.66, "text": "死伤大步"}, {"start": 1968.66, "end": 1970.66, "text": "可是还有些部分残余"}, {"start": 1970.66, "end": 1972.66, "text": "可能要"}, {"start": 1972.66, "end": 1974.66, "text": "进犯京城"}, {"start": 1974.66, "end": 1976.66, "text": "掠夺圣驾"}, {"start": 1976.66, "end": 1978.66, "text": "所以咱家是"}, {"start": 1978.66, "end": 1980.66, "text": "不得不防啊"}, {"start": 1980.66, "end": 1982.66, "text": "对了"}, {"start": 1982.66, "end": 1984.66, "text": "近日有童谣说"}, {"start": 1984.66, "end": 1986.66, "text": "东偷一个汉"}, {"start": 1986.66, "end": 1988.66, "text": "西偷一个汉"}, {"start": 1988.66, "end": 1990.66, "text": "迁都入长安"}, {"start": 1990.66, "end": 1992.66, "text": "方可无私难"}, {"start": 1994.66, "end": 1996.66, "text": "好 真好说的"}, {"start": 1998.66, "end": 2000.66, "text": "东都洛阳"}, {"start": 2000.66, "end": 2002.66, "text": "历经二百年"}, {"start": 2002.66, "end": 2004.66, "text": "气数已尽"}, {"start": 2004.66, "end": 2006.66, "text": "咱家是夜观天象"}, {"start": 2006.66, "end": 2008.66, "text": "见地气望于长安"}, {"start": 2008.66, "end": 2010.66, "text": "所以咱家决定"}, {"start": 2010.66, "end": 2012.66, "text": "护驾西兴"}, {"start": 2012.66, "end": 2014.66, "text": "迁都于长安"}, {"start": 2014.66, "end": 2016.66, "text": "那么"}, {"start": 2016.66, "end": 2018.66, "text": "各位百官公卿们"}, {"start": 2018.66, "end": 2020.66, "text": "都快快准备吧"}, {"start": 2022.66, "end": 2024.66, "text": "服装启行吧"}, {"start": 2026.66, "end": 2032.05, "text": "禀相国"}, {"start": 2032.05, "end": 2034.05, "text": "自从黄金启事之后"}, {"start": 2034.05, "end": 2036.05, "text": "连年兵戈"}, {"start": 2036.05, "end": 2038.05, "text": "早已将长安化为一片"}, {"start": 2038.05, "end": 2040.05, "text": "断臂裁员"}, {"start": 2040.05, "end": 2042.05, "text": "相国如果欺骗长安"}, {"start": 2042.05, "end": 2044.05, "text": "犹如弃公事"}, {"start": 2044.05, "end": 2046.05, "text": "而救瓦礼"}, {"start": 2046.05, "end": 2051.25, "text": "与相国明察"}, {"start": 2051.25, "end": 2053.25, "text": "都是个国家大忌"}, {"start": 2053.25, "end": 2055.25, "text": "迁都长安"}, {"start": 2055.25, "end": 2057.25, "text": "那是中兴大汉王朝"}, {"start": 2057.25, "end": 2059.25, "text": "那是百年大忌"}, {"start": 2059.25, "end": 2061.25, "text": "洛阳暗 长安明"}, {"start": 2061.25, "end": 2063.25, "text": "迁都长安"}, {"start": 2063.25, "end": 2066.91, "text": "就是弃暗投明"}, {"start": 2066.91, "end": 2068.91, "text": "启禀相国"}, {"start": 2068.91, "end": 2070.91, "text": "京都洛阳乃朝廷命脉"}, {"start": 2070.91, "end": 2072.91, "text": "倘若无故离宗庙弃皇陵"}, {"start": 2072.91, "end": 2074.91, "text": "将是朝廷大乱"}, {"start": 2074.91, "end": 2076.91, "text": "百姓沦难"}, {"start": 2076.91, "end": 2078.91, "text": "如此关天之事"}, {"start": 2078.91, "end": 2080.91, "text": "启叛相国"}, {"start": 2080.91, "end": 2082.91, "text": "甚之又甚"}, {"start": 2082.91, "end": 2086.9, "text": "甚之又甚"}, {"start": 2086.9, "end": 2088.9, "text": "咱家有什么"}, {"start": 2088.9, "end": 2090.9, "text": "不慎重了"}, {"start": 2090.9, "end": 2092.9, "text": "那长安有"}, {"start": 2092.9, "end": 2094.9, "text": "寒关之险 笼山之右"}, {"start": 2094.9, "end": 2096.9, "text": "建宫用的木材"}, {"start": 2096.9, "end": 2098.9, "text": "砖网"}, {"start": 2098.9, "end": 2100.9, "text": "它是唾手可得"}, {"start": 2100.9, "end": 2102.9, "text": "咱家半月之内"}, {"start": 2102.9, "end": 2104.9, "text": "就可以再造一座皇宫"}, {"start": 2104.9, "end": 2106.9, "text": "那可比"}, {"start": 2106.9, "end": 2108.9, "text": "常乐宫舒服多了"}, {"start": 2112.72, "end": 2114.72, "text": "哈哈哈哈"}, {"start": 2114.72, "end": 2116.72, "text": "对了"}, {"start": 2116.72, "end": 2118.72, "text": "咱家把这宫定名为"}, {"start": 2118.72, "end": 2120.72, "text": "万乐宫"}, {"start": 2120.72, "end": 2122.72, "text": "万乐宫"}, {"start": 2122.72, "end": 2124.72, "text": "哈哈哈哈"}, {"start": 2124.72, "end": 2126.72, "text": "相国"}, {"start": 2126.72, "end": 2128.72, "text": "您驻然迁都"}, {"start": 2128.72, "end": 2130.72, "text": "车马如何筹集"}, {"start": 2130.72, "end": 2132.72, "text": "百官如何安置"}, {"start": 2132.72, "end": 2134.72, "text": "邻民百姓如何料理啊相国"}, {"start": 2134.72, "end": 2136.72, "text": "咱家有战车兵马"}, {"start": 2136.72, "end": 2138.72, "text": "百官们坐上去"}, {"start": 2138.72, "end": 2140.72, "text": "不就完了吗"}, {"start": 2140.72, "end": 2142.72, "text": "至于那些城中小民"}, {"start": 2142.72, "end": 2144.72, "text": "贱如草芥"}, {"start": 2144.72, "end": 2146.72, "text": "爱死爱活"}, {"start": 2146.72, "end": 2148.72, "text": "咱家就管不了那么多了"}, {"start": 2148.72, "end": 2150.72, "text": "随他去随他去"}, {"start": 2152.72, "end": 2154.72, "text": "既然相国的"}, {"start": 2154.72, "end": 2156.72, "text": "迁都大计已定"}, {"start": 2156.72, "end": 2158.72, "text": "请问何日"}, {"start": 2158.72, "end": 2160.72, "text": "启行啊"}, {"start": 2160.72, "end": 2162.72, "text": "你看你看你看"}, {"start": 2162.72, "end": 2164.72, "text": "哈哈哈哈"}, {"start": 2164.72, "end": 2166.72, "text": "这才是你应该问的嘛"}, {"start": 2166.72, "end": 2168.72, "text": "哈哈哈哈"}, {"start": 2168.72, "end": 2170.72, "text": "听着"}, {"start": 2170.72, "end": 2172.72, "text": "咱家做事向来是"}, {"start": 2172.72, "end": 2174.72, "text": "雷厉风行啊"}, {"start": 2174.72, "end": 2176.72, "text": "迁都就在今日"}, {"start": 2176.72, "end": 2178.72, "text": "那么今日午时出客"}, {"start": 2178.72, "end": 2180.72, "text": "启行"}, {"start": 2180.72, "end": 2185.09, "text": "吸亲"}, {"start": 2185.09, "end": 2187.09, "text": "相国 孟然迁都"}, {"start": 2187.09, "end": 2189.09, "text": "必是朝纲大乱"}, {"start": 2189.09, "end": 2191.09, "text": "这万万不可"}, {"start": 2191.09, "end": 2193.09, "text": "万万不可呀"}, {"start": 2193.09, "end": 2195.09, "text": "你这贼子"}, {"start": 2195.09, "end": 2197.09, "text": "肯定是私通元少"}, {"start": 2197.09, "end": 2199.09, "text": "阻我大忌"}, {"start": 2199.09, "end": 2201.09, "text": "除魔不轨"}, {"start": 2201.09, "end": 2203.09, "text": "你今天必死无疑"}, {"start": 2213.15, "end": 2217.04, "text": "各位爱卿"}, {"start": 2217.04, "end": 2219.04, "text": "谁"}, {"start": 2219.04, "end": 2221.04, "text": "还有什么好的建议"}, {"start": 2221.04, "end": 2223.04, "text": "赶快说出来吧"}, {"start": 2225.04, "end": 2227.04, "text": "我这儿听着呢"}, {"start": 2227.04, "end": 2230.64, "text": "说呀"}, {"start": 2230.64, "end": 2236.61, "text": "有没有"}, {"start": 2236.61, "end": 2238.61, "text": "好"}, {"start": 2238.61, "end": 2240.61, "text": "来呀"}, {"start": 2240.61, "end": 2282.0, "text": "伺候天子起驾"}, {"start": 2282.0, "end": 2284.0, "text": "天上安"}, {"start": 2284.0, "end": 2286.0, "text": "数百年汉都洛阳"}, {"start": 2286.0, "end": 2288.0, "text": "被分为灰烬"}, {"start": 2288.0, "end": 2290.0, "text": "豪神富户"}, {"start": 2290.0, "end": 2292.0, "text": "寂寞入关"}, {"start": 2292.0, "end": 2294.0, "text": "宗庙地灵"}, {"start": 2294.0, "end": 2296.0, "text": "道觉殆尽"}, {"start": 2296.0, "end": 2322.35, "text": "你们总算来了"}, {"start": 2322.35, "end": 2324.35, "text": "门太兄"}, {"start": 2324.35, "end": 2326.35, "text": "门太兄"}, {"start": 2326.35, "end": 2328.35, "text": "在下怕你们真是望眼欲穿哪"}, {"start": 2328.35, "end": 2330.35, "text": "岳少何在"}, {"start": 2330.35, "end": 2332.35, "text": "大军何在各路诸侯何在"}, {"start": 2332.35, "end": 2334.35, "text": "他们"}, {"start": 2334.35, "end": 2339.33, "text": "喝酒呢"}, {"start": 2339.33, "end": 2341.33, "text": "卓节驾西逃"}, {"start": 2341.33, "end": 2343.33, "text": "洛阳城一片大火"}, {"start": 2343.33, "end": 2345.33, "text": "西梁军正在拜退"}, {"start": 2345.33, "end": 2347.33, "text": "袁绍为何不成声追杀"}, {"start": 2347.33, "end": 2349.33, "text": "袁绍担心董卓"}, {"start": 2349.33, "end": 2351.33, "text": "暗藏复兵"}, {"start": 2351.33, "end": 2353.33, "text": "各路诸侯也是"}, {"start": 2353.33, "end": 2355.33, "text": "你望我我望你"}, {"start": 2355.33, "end": 2357.33, "text": "谁都不肯率先出兵"}, {"start": 2357.33, "end": 2359.33, "text": "为了一点兵马"}, {"start": 2359.33, "end": 2361.33, "text": "粮草城池都快搭起来了"}, {"start": 2361.33, "end": 2363.33, "text": "只有我"}, {"start": 2363.33, "end": 2365.33, "text": "率本部万余荆棘"}, {"start": 2365.33, "end": 2367.33, "text": "咱们盟主真是"}, {"start": 2367.33, "end": 2369.33, "text": "做事良机啊"}, {"start": 2369.33, "end": 2371.33, "text": "门太兄啊"}, {"start": 2371.33, "end": 2373.33, "text": "你真是太抬举袁绍了"}, {"start": 2373.33, "end": 2375.33, "text": "他连这个千载难逢的机会"}, {"start": 2375.33, "end": 2377.33, "text": "看都没看出来"}, {"start": 2377.33, "end": 2379.33, "text": "谈何做事"}, {"start": 2379.33, "end": 2381.33, "text": "门太兄"}, {"start": 2381.33, "end": 2383.33, "text": "有何高见"}, {"start": 2383.33, "end": 2385.33, "text": "门太兄眼下有一个"}, {"start": 2385.33, "end": 2387.33, "text": "天大的功劳"}, {"start": 2387.33, "end": 2389.33, "text": "摆在你我二人眼前"}, {"start": 2389.33, "end": 2391.33, "text": "会盟之初各路诸侯"}, {"start": 2391.33, "end": 2393.33, "text": "约定谁先攻入京城"}, {"start": 2393.33, "end": 2395.33, "text": "就启奏圣上封谁为"}, {"start": 2395.33, "end": 2397.33, "text": "彪纪大将军"}, {"start": 2397.33, "end": 2399.33, "text": "眼下洛阳空虚"}, {"start": 2399.33, "end": 2401.33, "text": "东贼败逃"}, {"start": 2401.33, "end": 2403.33, "text": "你我何不兵分两路"}, {"start": 2403.33, "end": 2405.33, "text": "一路集中所有的部兵"}, {"start": 2405.33, "end": 2407.33, "text": "开进洛阳"}, {"start": 2407.33, "end": 2409.33, "text": "另一路集中所有的齐兵"}, {"start": 2409.33, "end": 2411.33, "text": "星夜追杀东贼"}, {"start": 2411.33, "end": 2413.33, "text": "孙将军"}, {"start": 2413.33, "end": 2415.33, "text": "你愿意去哪一路"}, {"start": 2415.33, "end": 2421.58, "text": "我部将东子弟"}, {"start": 2421.58, "end": 2423.58, "text": "大多是部军"}, {"start": 2423.58, "end": 2425.58, "text": "齐兵还不到三千"}, {"start": 2427.31, "end": 2429.31, "text": "而我率领的全部都是经纪"}, {"start": 2429.31, "end": 2431.31, "text": "孙将军"}, {"start": 2431.31, "end": 2433.31, "text": "可否把你的三千齐兵"}, {"start": 2433.31, "end": 2435.31, "text": "全部交给我"}, {"start": 2435.31, "end": 2437.31, "text": "我会亲自率领他们"}, {"start": 2437.31, "end": 2439.31, "text": "星夜追杀东贼"}, {"start": 2439.31, "end": 2441.31, "text": "你"}, {"start": 2441.31, "end": 2443.31, "text": "率部军开进洛阳"}, {"start": 2443.31, "end": 2447.87, "text": "当真千真万确"}, {"start": 2447.87, "end": 2454.86, "text": "如此"}, {"start": 2454.86, "end": 2458.21, "text": "真就有劳孟德兄吧"}, {"start": 2458.21, "end": 2460.21, "text": "为国出贼何分彼此"}, {"start": 2460.21, "end": 2462.21, "text": "门太兄"}, {"start": 2462.21, "end": 2464.21, "text": "你我何不即可分头行动"}, {"start": 2464.21, "end": 2466.21, "text": "好"}, {"start": 2466.21, "end": 2470.9, "text": "城铺把所有齐兵"}, {"start": 2470.9, "end": 2474.53, "text": "全部交付曹操"}, {"start": 2474.53, "end": 2478.06, "text": "诺"}, {"start": 2478.06, "end": 2480.06, "text": "保重"}, {"start": 2480.06, "end": 2484.5, "text": "珍重"}]