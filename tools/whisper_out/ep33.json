[{"start": 27.06, "end": 32.27, "text": "外面世界混沌,这里却仿无仙境。"}, {"start": 34.07, "end": 36.03, "text": "真乃高人隐居之处啊。"}, {"start": 36.67, "end": 39.51, "text": "大哥,这诸葛亮比徐军师如何啊?"}, {"start": 40.71, "end": 43.27, "text": "徐叔说了,孔明胜他十倍。"}, {"start": 43.55, "end": 46.99, "text": "他吹牛,这世上岂有胜过徐叔十倍的人,"}, {"start": 47.07, "end": 48.03, "text": "那不成了仙了。"}, {"start": 48.63, "end": 51.39, "text": "大哥,你别信这些,那些文人啊,"}, {"start": 51.63, "end": 54.03, "text": "这读了几年的诗书,懂了些礼术,"}, {"start": 54.31, "end": 55.71, "text": "就变得假惺惺的了。"}, {"start": 56.03, "end": 57.79, "text": "这狂起来啊,是狂的要死。"}, {"start": 57.99, "end": 60.15, "text": "这谦虚起来啊,又谦虚的要命。"}, {"start": 61.07, "end": 63.23, "text": "怪不得人们管他们叫腐儒呢。"}, {"start": 63.79, "end": 64.91, "text": "腐儒是什么呀?"}, {"start": 65.31, "end": 66.91, "text": "那就是腐烂的臭豆腐。"}, {"start": 67.55, "end": 70.83, "text": "大哥,你千万可别拿臭豆腐当宝贝了。"}, {"start": 71.07, "end": 74.11, "text": "三弟说得痛切,当福以大白。"}, {"start": 74.39, "end": 75.23, "text": "那可是。"}, {"start": 76.67, "end": 79.91, "text": "我们三兄弟进山访闲,有如登高拜天,"}, {"start": 80.43, "end": 81.55, "text": "要有一片诚心。"}, {"start": 82.35, "end": 83.91, "text": "你们二位莫要讽刺挖苦了。"}, {"start": 120.75, "end": 122.07, "text": "此歌意境深远,"}, {"start": 122.75, "end": 125.55, "text": "听来仿佛清风拂面,明月荡空啊。"}, {"start": 126.35, "end": 128.75, "text": "去去去,这哥哥又犯傻了。"}, {"start": 129.95, "end": 132.35, "text": "就这等歌同谣啊,那遍地都是。"}, {"start": 132.71, "end": 133.71, "text": "这有啥戏气的?"}, {"start": 134.55, "end": 135.99, "text": "徐述早就说过了,"}, {"start": 137.27, "end": 140.47, "text": "民谣所唱所指,往往是民心所向。"}, {"start": 141.11, "end": 144.83, "text": "得民心者,距离得天意也就不远了。"}, {"start": 148.22, "end": 150.58, "text": "那位乔夫,请你过来。"}, {"start": 152.97, "end": 154.21, "text": "在下有事请教。"}, {"start": 155.13, "end": 156.93, "text": "客官哪,有何吩咐啊?"}, {"start": 161.86, "end": 162.66, "text": "请笑哪。"}, {"start": 164.9, "end": 168.26, "text": "刚才所唱民谣,是何人所作?"}, {"start": 169.46, "end": 172.14, "text": "是卧龙岗上的卧龙先生所作。"}, {"start": 172.54, "end": 174.94, "text": "卧龙先生,就是诸葛亮?"}, {"start": 175.42, "end": 175.9, "text": "正是。"}, {"start": 178.22, "end": 180.46, "text": "那请问卧龙岗距此有多远?"}, {"start": 181.34, "end": 183.74, "text": "由此往北,十二三里以外就是。"}, {"start": 185.3, "end": 185.78, "text": "多谢了。"}, {"start": 186.82, "end": 187.42, "text": "不用谢。"}, {"start": 189.06, "end": 190.34, "text": "二哥,你听见没有?"}, {"start": 191.1, "end": 192.38, "text": "那刚才乔夫说什么?"}, {"start": 192.54, "end": 194.14, "text": "卧龙岗上的卧龙先生。"}, {"start": 194.34, "end": 196.18, "text": "这诸葛亮这胆可真大啊。"}, {"start": 196.98, "end": 199.62, "text": "敢自称自己为龙,还是卧着呢。"}, {"start": 200.26, "end": 203.98, "text": "是啊,天下大乱,风起云涌。"}, {"start": 204.62, "end": 206.3, "text": "大家都在争权夺利。"}, {"start": 206.9, "end": 208.7, "text": "你说,他不卧着他能干什么?"}, {"start": 208.78, "end": 210.14, "text": "他没事呗,自睡。"}, {"start": 210.82, "end": 211.74, "text": "你们两个说完了没有?"}, {"start": 213.58, "end": 215.22, "text": "没听见刚才民谣所唱吗?"}, {"start": 216.22, "end": 218.86, "text": "荣者自安安,庸者定路路。"}, {"start": 219.14, "end": 222.18, "text": "诸葛亮在乱世能够持重首决,太然高涡。"}, {"start": 222.98, "end": 224.42, "text": "天下几人能够做到?"}, {"start": 261.02, "end": 263.1, "text": "请问卧龙先生在此吗?"}, {"start": 273.27, "end": 274.43, "text": "请问客官是谁?"}, {"start": 275.31, "end": 277.79, "text": "汉左将军,易成廷侯。"}, {"start": 278.95, "end": 281.15, "text": "免玉周目,皇叔刘。"}, {"start": 281.15, "end": 282.91, "text": "客官名字太长了,我记不住。"}, {"start": 286.55, "end": 289.43, "text": "就说,刘备前来拜访孔明先生。"}, {"start": 290.27, "end": 291.55, "text": "知道了,你叫刘备?"}, {"start": 291.87, "end": 294.83, "text": "刘备先生,我家先生知道近日会有贵人到访,"}, {"start": 294.83, "end": 296.15, "text": "所以他出门远游了。"}, {"start": 297.23, "end": 299.63, "text": "什么?小哥能再说一遍吗?"}, {"start": 300.11, "end": 302.03, "text": "先生,他知道会有贵客到访,"}, {"start": 302.03, "end": 303.31, "text": "所以出门远游了。"}, {"start": 310.12, "end": 312.16, "text": "那,请小哥留话。"}, {"start": 312.64, "end": 314.2, "text": "待孔明先生回来时,"}, {"start": 314.72, "end": 317.12, "text": "就说刘备专程来拜访。"}, {"start": 317.44, "end": 318.08, "text": "记住了。"}, {"start": 320.19, "end": 321.23, "text": "请再告诉他,"}, {"start": 321.23, "end": 324.27, "text": "数日后,刘备还会再来拜访。"}, {"start": 324.71, "end": 325.55, "text": "也记下了。"}, {"start": 326.79, "end": 327.63, "text": "刘备告辞。"}, {"start": 327.95, "end": 328.75, "text": "客官,请慢走。"}, {"start": 343.18, "end": 343.94, "text": "两位,怎么了?"}, {"start": 344.82, "end": 346.86, "text": "大哥,你都听到了。"}, {"start": 347.62, "end": 350.14, "text": "诸葛亮明明知道你要前来拜访,"}, {"start": 350.62, "end": 352.1, "text": "他却故意出门远游。"}, {"start": 352.1, "end": 353.94, "text": "我..."}, {"start": 353.94, "end": 356.42, "text": "无妨,过几日我们再来。"}, {"start": 357.62, "end": 360.18, "text": "哥哥,你可是大汉皇叔啊。"}, {"start": 361.86, "end": 363.1, "text": "专程来看这厮,"}, {"start": 363.42, "end": 364.94, "text": "你这是给他天大的面子吗?"}, {"start": 366.3, "end": 370.78, "text": "这厮却好生无礼啊,躲着不见,岂有此理。"}, {"start": 371.18, "end": 371.98, "text": "下次不来了,"}, {"start": 380.9, "end": 383.54, "text": "立刻叫他到西野城拜见我大哥。"}, {"start": 383.9, "end": 384.22, "text": "听好了?"}, {"start": 384.22, "end": 385.22, "text": "不可,放肆。"}, {"start": 385.22, "end": 388.42, "text": "否则,大军到处遵守秘密。"}, {"start": 388.42, "end": 388.78, "text": "走。"}, {"start": 392.98, "end": 396.38, "text": "哥哥,无妨,我护他一壶。"}, {"start": 397.26, "end": 398.14, "text": "下回啊,"}, {"start": 398.54, "end": 401.74, "text": "保证他是乖乖地老老实实地来拜见哥哥。"}, {"start": 436.66, "end": 439.06, "text": "敢问,阁下是卧龙先生吗?"}, {"start": 441.02, "end": 442.34, "text": "请问阁下何人?"}, {"start": 442.86, "end": 443.82, "text": "新野刘备。"}, {"start": 444.54, "end": 447.18, "text": "久仰将军,但我并非孔明,"}, {"start": 447.58, "end": 450.26, "text": "我乃孔明学生,柏林崔周平。"}, {"start": 452.3, "end": 456.14, "text": "崔周平,先生大名如雷贯耳,"}, {"start": 456.14, "end": 457.14, "text": "刘备早已久仰。"}, {"start": 458.3, "end": 461.14, "text": "崔先生,刚才我刚刚去过卧龙岗,"}, {"start": 461.98, "end": 464.42, "text": "孔明先生外出云游去了。"}, {"start": 465.7, "end": 469.1, "text": "先生,如有侠,我们可否叙谈一番啊?"}, {"start": 469.1, "end": 472.18, "text": "甚好,在下平生喜欢交友,"}, {"start": 472.18, "end": 475.54, "text": "所以无论走到哪里,都随身携带常敌一杆,"}, {"start": 475.54, "end": 478.34, "text": "茶吹已复,已被高鹏雅士所需。"}, {"start": 479.42, "end": 483.18, "text": "如将军不弃,我们就在那西畔烹茶如何?"}, {"start": 483.18, "end": 483.94, "text": "好极好极。"}, {"start": 484.9, "end": 485.86, "text": "二弟,三弟,"}, {"start": 486.46, "end": 489.34, "text": "你,你们,我去与崔先生叙谈一会儿,"}, {"start": 489.34, "end": 491.9, "text": "你们二位去那边草坡暂歇片刻啊。"}, {"start": 491.9, "end": 493.86, "text": "行,大哥,你只管谈啊,"}, {"start": 493.86, "end": 495.58, "text": "我也当回卧龙,睡觉去了。"}, {"start": 496.82, "end": 499.06, "text": "大哥,只是别耽误了,晚饭就成啊。"}, {"start": 499.1, "end": 499.98, "text": "将军请。"}, {"start": 499.98, "end": 501.14, "text": "先生请。"}, {"start": 501.14, "end": 520.29, "text": "敢问将军,何以要见我失孔明呢?"}, {"start": 520.29, "end": 525.71, "text": "坊间天下大乱,奸雄兵器,"}, {"start": 525.71, "end": 528.63, "text": "刚长沦丧,民不聊生。"}, {"start": 529.47, "end": 531.51, "text": "我想拜访孔明,"}, {"start": 532.19, "end": 534.91, "text": "求取安邦定国之策。"}, {"start": 534.91, "end": 538.67, "text": "将军想拯救乱世,好极了,"}, {"start": 538.67, "end": 542.39, "text": "果然是一片仁义之心。"}, {"start": 543.39, "end": 544.75, "text": "不过,"}, {"start": 544.95, "end": 547.91, "text": "自古以来,有治就有乱,"}, {"start": 547.91, "end": 549.99, "text": "治与乱相辅相成,"}, {"start": 549.99, "end": 552.43, "text": "此起彼伏,永无修之。"}, {"start": 552.43, "end": 555.27, "text": "我高祖斩蛇起义,诛灭暴秦,"}, {"start": 555.27, "end": 557.27, "text": "天下由乱入治,"}, {"start": 557.27, "end": 559.55, "text": "之后太平了约两百年,"}, {"start": 559.55, "end": 564.44, "text": "可见,治与乱互为因果。"}, {"start": 565.32, "end": 568.04, "text": "乱是必然,治也是必然。"}, {"start": 569.12, "end": 571.52, "text": "不乱,反倒可笑了。"}, {"start": 571.52, "end": 572.8, "text": "先生所言,"}, {"start": 572.8, "end": 577.14, "text": "果然真是有道理啊,"}, {"start": 577.14, "end": 579.86, "text": "先生所言,果然阵容发窥,"}, {"start": 579.86, "end": 583.11, "text": "高减高减,"}, {"start": 583.11, "end": 585.91, "text": "但刘备,愧为地骤,"}, {"start": 586.83, "end": 590.23, "text": "胸间流淌着黄沁血脉,"}, {"start": 591.07, "end": 593.19, "text": "既生于世,"}, {"start": 593.19, "end": 595.27, "text": "就该当平乱求治,"}, {"start": 595.27, "end": 598.42, "text": "匡扶大汉啊。"}, {"start": 598.42, "end": 601.34, "text": "将军大致,在下敬佩。"}, {"start": 602.26, "end": 604.5, "text": "周平也盼望着这乱世,"}, {"start": 604.5, "end": 606.66, "text": "越少越短则越好,"}, {"start": 606.66, "end": 609.22, "text": "盛世越多越长则更佳。"}, {"start": 609.98, "end": 612.98, "text": "如果世上多些将军这般英雄,"}, {"start": 612.98, "end": 616.34, "text": "当然是苍生之福,朝廷之幸啊。"}, {"start": 617.18, "end": 620.14, "text": "先生如此大才,"}, {"start": 620.14, "end": 621.62, "text": "何不出山来,"}, {"start": 621.62, "end": 623.18, "text": "助我看平乱世,"}, {"start": 623.18, "end": 624.78, "text": "辅佐王爷。"}, {"start": 626.86, "end": 628.66, "text": "在下山野之人,"}, {"start": 628.66, "end": 631.7, "text": "早已无异于功名大业,"}, {"start": 631.7, "end": 633.14, "text": "还是临流而坐,"}, {"start": 633.14, "end": 635.74, "text": "报稀品茶的好。"}, {"start": 635.74, "end": 637.9, "text": "世上没有神仙,"}, {"start": 637.9, "end": 640.54, "text": "但是却有神仙一般的日子,"}, {"start": 640.54, "end": 641.66, "text": "岂不快哉?"}, {"start": 641.66, "end": 647.14, "text": "连孔明的学生都如此高深莫测,"}, {"start": 647.14, "end": 650.7, "text": "真不知孔明又该当如何?"}, {"start": 652.18, "end": 654.46, "text": "将军过誉了,先生请。"}, {"start": 654.46, "end": 659.94, "text": "请。"}, {"start": 659.94, "end": 661.9, "text": "这又是个腐乳,"}, {"start": 661.9, "end": 664.9, "text": "这一坐下来就卖弄这臭酸。"}, {"start": 664.9, "end": 666.86, "text": "二哥,喝酒。"}, {"start": 668.98, "end": 671.38, "text": "主光叔管个屁用啊,"}, {"start": 671.38, "end": 673.26, "text": "这不丁吃不丁喝的,"}, {"start": 673.26, "end": 675.14, "text": "这连个鸡腿都不吃,"}, {"start": 675.14, "end": 677.94, "text": "哼,管甚用啊?"}, {"start": 707.56, "end": 708.84, "text": "孙前啊。"}, {"start": 708.84, "end": 711.58, "text": "主公。"}, {"start": 711.58, "end": 715.34, "text": "已经是龙冬蜡月了,"}, {"start": 715.34, "end": 717.58, "text": "诸葛亮出游,"}, {"start": 717.58, "end": 719.94, "text": "也该回来了吧?"}, {"start": 719.94, "end": 721.74, "text": "在下每隔五日,"}, {"start": 721.74, "end": 724.7, "text": "便请人去卧龙岗打探消息,"}, {"start": 724.7, "end": 726.02, "text": "截至昨日,"}, {"start": 726.02, "end": 732.42, "text": "诸葛亮还没有回来。"}, {"start": 732.42, "end": 735.22, "text": "中原处处战乱,"}, {"start": 735.22, "end": 737.86, "text": "他独自出游,"}, {"start": 737.86, "end": 740.58, "text": "我担心他的安危啊。"}, {"start": 740.58, "end": 741.94, "text": "主公,"}, {"start": 741.94, "end": 744.58, "text": "你与此人平生素昧相识,"}, {"start": 744.58, "end": 747.06, "text": "甚至连面都没有见过一次,"}, {"start": 747.06, "end": 750.71, "text": "何至于此啊?"}, {"start": 750.71, "end": 753.79, "text": "虽然素昧平生,"}, {"start": 753.79, "end": 757.71, "text": "却又生死相依,"}, {"start": 757.71, "end": 759.95, "text": "不瞒你说,"}, {"start": 759.95, "end": 763.67, "text": "昨夜我与他梦中相会,"}, {"start": 763.67, "end": 765.67, "text": "彼此大发豪情,"}, {"start": 765.67, "end": 767.27, "text": "纵论天下。"}, {"start": 767.27, "end": 778.46, "text": "哦,竟有此等奇事?"}, {"start": 778.46, "end": 780.18, "text": "主公,龙冬传来口信,"}, {"start": 780.18, "end": 782.82, "text": "说诸葛亮运又回来了。"}, {"start": 782.82, "end": 784.14, "text": "真的?"}, {"start": 784.14, "end": 785.38, "text": "他几时回来的?"}, {"start": 785.38, "end": 786.34, "text": "昨夜。"}, {"start": 786.34, "end": 787.34, "text": "孙前,"}, {"start": 787.34, "end": 789.02, "text": "快请关章兄弟来。"}, {"start": 789.02, "end": 796.13, "text": "快去快去快去。"}, {"start": 796.13, "end": 797.09, "text": "二弟、三弟。"}, {"start": 797.09, "end": 798.45, "text": "大哥!"}, {"start": 798.45, "end": 799.05, "text": "大哥,"}, {"start": 799.05, "end": 800.09, "text": "还我等何事?"}, {"start": 800.09, "end": 801.25, "text": "诸葛亮回来了,"}, {"start": 801.25, "end": 802.57, "text": "你们随我前去拜访,"}, {"start": 802.57, "end": 803.81, "text": "立刻就去。"}, {"start": 803.81, "end": 805.09, "text": "大哥,"}, {"start": 805.09, "end": 806.69, "text": "为何如此心切?"}, {"start": 806.69, "end": 807.65, "text": "外面下着大雪,"}, {"start": 807.65, "end": 808.81, "text": "为何不等雪,"}, {"start": 808.81, "end": 809.69, "text": "止了以后才去?"}, {"start": 809.69, "end": 811.05, "text": "不碍事,不碍事。"}, {"start": 811.05, "end": 812.01, "text": "待我们走到路上,"}, {"start": 812.01, "end": 813.17, "text": "这雪就止了,"}, {"start": 813.17, "end": 814.09, "text": "我们一路走,"}, {"start": 814.09, "end": 815.61, "text": "一路欣赏雪景。"}, {"start": 815.61, "end": 816.65, "text": "哥哥,"}, {"start": 816.65, "end": 818.29, "text": "你要是进山打猎,"}, {"start": 818.29, "end": 819.41, "text": "我去,"}, {"start": 819.41, "end": 820.81, "text": "若是见那孔明,"}, {"start": 820.81, "end": 822.05, "text": "我就不去了吧。"}, {"start": 822.05, "end": 824.09, "text": "为何?"}, {"start": 824.09, "end": 825.89, "text": "我要瘦袍子啊,"}, {"start": 825.89, "end": 827.21, "text": "那个腐儒,"}, {"start": 827.21, "end": 828.97, "text": "哪比得上袍子有趣啊?"}, {"start": 828.97, "end": 831.86, "text": "听着,"}, {"start": 831.86, "end": 833.86, "text": "拜访诸葛亮事关重大,"}, {"start": 833.86, "end": 835.86, "text": "你我兄弟三人少一人便是失礼,"}, {"start": 835.86, "end": 839.26, "text": "你非去不可。"}, {"start": 839.26, "end": 840.22, "text": "好好好,"}, {"start": 840.22, "end": 841.3, "text": "罢了,"}, {"start": 841.3, "end": 843.22, "text": "那我可得带上酒肉啊。"}, {"start": 843.22, "end": 877.98, "text": "随你,"}, {"start": 877.98, "end": 880.1, "text": "天地美景,"}, {"start": 880.1, "end": 881.94, "text": "江山如画,"}, {"start": 881.98, "end": 883.1, "text": "这腐儒,"}, {"start": 883.1, "end": 884.74, "text": "整个一匹蜂,"}, {"start": 884.74, "end": 886.42, "text": "他不来拜咱们,"}, {"start": 886.42, "end": 887.9, "text": "咱们却要去拜他。"}, {"start": 889.02, "end": 891.82, "text": "哥哥上回已经拜过他一次了,"}, {"start": 891.82, "end": 893.62, "text": "这一礼啊,"}, {"start": 893.62, "end": 896.66, "text": "这次应该他上门求见才是,"}, {"start": 896.66, "end": 899.1, "text": "这次却竟敢不来,"}, {"start": 899.1, "end": 900.26, "text": "应该叫几个兵,"}, {"start": 900.26, "end": 902.46, "text": "把他抓来见面就是了。"}, {"start": 902.46, "end": 904.66, "text": "三弟不要发牢骚了。"}, {"start": 905.7, "end": 906.78, "text": "哥哥,"}, {"start": 906.78, "end": 908.02, "text": "骂他几句啊,"}, {"start": 908.02, "end": 909.5, "text": "心里舒服,"}, {"start": 909.5, "end": 910.34, "text": "要不然,"}, {"start": 910.34, "end": 915.02, "text": "亏他忘了。"}, {"start": 916.02, "end": 917.74, "text": "前面有一酒肆,"}, {"start": 917.74, "end": 920.34, "text": "上次来可还没有啊。"}, {"start": 921.14, "end": 922.86, "text": "真的诶,"}, {"start": 922.86, "end": 923.86, "text": "快走快走,"}, {"start": 923.86, "end": 924.58, "text": "那里啊,"}, {"start": 924.58, "end": 926.42, "text": "一定有梅酒野味。"}, {"start": 926.42, "end": 928.02, "text": "你不是带酒肉了吗?"}, {"start": 929.02, "end": 932.41, "text": "早就吃光了。"}, {"start": 932.41, "end": 933.49, "text": "大哥,"}, {"start": 933.49, "end": 934.85, "text": "天色尚早,"}, {"start": 934.85, "end": 937.29, "text": "不如吃杯酒再走吧。"}, {"start": 937.29, "end": 938.69, "text": "好好好。"}, {"start": 938.69, "end": 941.73, "text": "壮士功名尚未成,"}, {"start": 941.73, "end": 944.09, "text": "无乎酒不欲扬春,"}, {"start": 944.41, "end": 947.97, "text": "君不见东海老者司京真,"}, {"start": 947.97, "end": 950.89, "text": "长吉芒荡龙准功,"}, {"start": 950.89, "end": 954.13, "text": "高潭霸王惊人耳,"}, {"start": 954.13, "end": 958.21, "text": "绰席言座钦音风。"}, {"start": 958.21, "end": 959.53, "text": "好啊,"}, {"start": 959.53, "end": 961.09, "text": "二弟三弟,"}, {"start": 961.09, "end": 963.13, "text": "那殿内必有高人,"}, {"start": 963.13, "end": 963.89, "text": "走,"}, {"start": 963.89, "end": 965.01, "text": "我们去拜访一下。"}, {"start": 965.01, "end": 965.73, "text": "好好,"}, {"start": 965.73, "end": 967.09, "text": "我们陪着哥哥去啊,"}, {"start": 967.09, "end": 967.81, "text": "走。"}, {"start": 967.81, "end": 985.74, "text": "长吉芒荡龙功,"}, {"start": 985.74, "end": 986.34, "text": "高潭霸王惊人耳,"}, {"start": 986.38, "end": 986.98, "text": "殿家,"}, {"start": 986.98, "end": 988.94, "text": "顾水人有切五斤牛肉。"}, {"start": 988.94, "end": 989.58, "text": "好,"}, {"start": 989.58, "end": 990.34, "text": "客官。"}, {"start": 990.34, "end": 992.38, "text": "绰席言座,"}, {"start": 992.38, "end": 994.7, "text": "隐音风,"}, {"start": 994.7, "end": 996.06, "text": "功下其成,"}, {"start": 996.06, "end": 998.1, "text": "其时二,"}, {"start": 998.1, "end": 1000.1, "text": "天下无人,"}, {"start": 1000.1, "end": 1002.9, "text": "能寄祖好。"}, {"start": 1002.9, "end": 1011.05, "text": "好啊。"}, {"start": 1011.05, "end": 1012.61, "text": "请问二位,"}, {"start": 1012.61, "end": 1015.17, "text": "谁是卧龙先生?"}, {"start": 1015.17, "end": 1016.49, "text": "客官何人,"}, {"start": 1016.49, "end": 1018.65, "text": "为什么要见卧龙呢?"}, {"start": 1018.65, "end": 1020.85, "text": "在下心也留备,"}, {"start": 1020.85, "end": 1022.49, "text": "拜见卧龙先生,"}, {"start": 1022.49, "end": 1026.53, "text": "为求治国安邦之责。"}, {"start": 1026.53, "end": 1027.73, "text": "姓甚,"}, {"start": 1027.73, "end": 1030.17, "text": "姓甚。"}, {"start": 1030.17, "end": 1032.29, "text": "我俩均不是卧龙,"}, {"start": 1032.29, "end": 1034.57, "text": "只是卧龙的朋友,"}, {"start": 1034.57, "end": 1037.93, "text": "我是影川石广元,"}, {"start": 1037.93, "end": 1043.19, "text": "他是汝南孟公威。"}, {"start": 1043.19, "end": 1045.39, "text": "都是京乡高士,"}, {"start": 1045.39, "end": 1047.79, "text": "留备久仰了。"}, {"start": 1047.79, "end": 1049.71, "text": "二位如有闲暇,"}, {"start": 1049.71, "end": 1052.59, "text": "请问能否前往卧龙庄,"}, {"start": 1052.59, "end": 1053.87, "text": "与卧龙先生,"}, {"start": 1053.87, "end": 1056.31, "text": "共同续谈一会儿。"}, {"start": 1056.31, "end": 1058.39, "text": "谢谢将军相邀,"}, {"start": 1058.39, "end": 1061.51, "text": "我们是山野闲览之徒,"}, {"start": 1061.51, "end": 1063.59, "text": "贪杯好酒之辈。"}, {"start": 1063.59, "end": 1064.51, "text": "再说,"}, {"start": 1064.51, "end": 1067.43, "text": "今天我们并不想见诸葛亮。"}, {"start": 1067.43, "end": 1068.39, "text": "将军,"}, {"start": 1068.39, "end": 1071.23, "text": "请便。"}, {"start": 1071.23, "end": 1072.67, "text": "来来来。"}, {"start": 1072.67, "end": 1079.83, "text": "那在下告辞了。"}, {"start": 1079.83, "end": 1081.15, "text": "店家,"}, {"start": 1081.15, "end": 1082.67, "text": "这两位先生的酒钱,"}, {"start": 1082.67, "end": 1084.23, "text": "都算在我身上。"}, {"start": 1084.23, "end": 1088.14, "text": "好嘞。"}, {"start": 1088.14, "end": 1088.86, "text": "这倒好,"}, {"start": 1088.86, "end": 1089.94, "text": "卧龙没见着,"}, {"start": 1089.94, "end": 1094.26, "text": "让卧龙的朋友吃了他们一道。"}, {"start": 1094.26, "end": 1107.06, "text": "客官慢走。"}, {"start": 1107.06, "end": 1113.14, "text": "小哥。"}, {"start": 1113.14, "end": 1114.58, "text": "刘将军。"}, {"start": 1114.58, "end": 1116.06, "text": "小哥,"}, {"start": 1116.06, "end": 1118.9, "text": "请问今日诸葛先生在家吗?"}, {"start": 1118.9, "end": 1120.46, "text": "先生正在堂上读书,"}, {"start": 1120.46, "end": 1121.82, "text": "将军请进吧。"}, {"start": 1121.82, "end": 1125.35, "text": "哦,好。"}, {"start": 1125.35, "end": 1129.51, "text": "凤翱翔于千任兮,"}, {"start": 1129.51, "end": 1132.47, "text": "非武不欺。"}, {"start": 1132.47, "end": 1136.67, "text": "是服储于一方习,"}, {"start": 1136.67, "end": 1140.43, "text": "非主不依。"}, {"start": 1140.43, "end": 1143.51, "text": "乐功耕于龙母兮,"}, {"start": 1143.51, "end": 1147.18, "text": "我爱我母。"}, {"start": 1147.18, "end": 1151.06, "text": "辽季傲于秦书兮,"}, {"start": 1151.06, "end": 1154.7, "text": "以待天时。"}, {"start": 1154.7, "end": 1156.02, "text": "好诗文,"}, {"start": 1156.02, "end": 1164.38, "text": "好志向。"}, {"start": 1164.38, "end": 1165.34, "text": "刘备,"}, {"start": 1165.34, "end": 1166.62, "text": "九慕先生,"}, {"start": 1166.62, "end": 1171.85, "text": "今日总算一睹珍容。"}, {"start": 1171.85, "end": 1172.85, "text": "将军,"}, {"start": 1172.85, "end": 1175.65, "text": "莫非是心野刘玄德?"}, {"start": 1175.65, "end": 1177.29, "text": "正是。"}, {"start": 1177.29, "end": 1179.37, "text": "将军今日前访,"}, {"start": 1179.37, "end": 1183.49, "text": "是想见见家兄诸葛亮吧?"}, {"start": 1183.49, "end": 1187.73, "text": "难道先生不是卧龙先生?"}, {"start": 1187.73, "end": 1189.77, "text": "在下万分抱歉,"}, {"start": 1189.77, "end": 1193.01, "text": "在下乃是孔明之弟诸葛君。"}, {"start": 1193.01, "end": 1195.97, "text": "我们诸葛家中有兄弟三人,"}, {"start": 1195.97, "end": 1197.93, "text": "掌兄诸葛锦,"}, {"start": 1197.93, "end": 1200.97, "text": "刺兄诸葛亮。"}, {"start": 1200.97, "end": 1201.73, "text": "那么,"}, {"start": 1201.73, "end": 1203.93, "text": "卧龙先生何在?"}, {"start": 1203.93, "end": 1205.69, "text": "将军来得不巧,"}, {"start": 1205.69, "end": 1207.45, "text": "家兄外出游玩,"}, {"start": 1207.45, "end": 1208.81, "text": "至今未归,"}, {"start": 1208.81, "end": 1216.18, "text": "在下也是昨日晚些时候才回龙中的。"}, {"start": 1216.18, "end": 1216.94, "text": "敢问,"}, {"start": 1216.94, "end": 1220.98, "text": "卧龙先生往何处游来?"}, {"start": 1220.98, "end": 1223.42, "text": "这可不好说,"}, {"start": 1223.42, "end": 1226.14, "text": "或驾舟游于江湖,"}, {"start": 1226.18, "end": 1229.78, "text": "或访僧旅游于山岭,"}, {"start": 1229.78, "end": 1232.5, "text": "或邀朋友坐于村落,"}, {"start": 1232.5, "end": 1234.82, "text": "或携棋琴坐于洞府,"}, {"start": 1234.82, "end": 1237.42, "text": "总之行踪不定。"}, {"start": 1237.42, "end": 1245.46, "text": "在下替家兄向将军致歉。"}, {"start": 1245.46, "end": 1246.82, "text": "请借纸笔,"}, {"start": 1246.82, "end": 1249.22, "text": "我想留一封书信。"}, {"start": 1249.22, "end": 1249.9, "text": "好,"}, {"start": 1249.9, "end": 1250.98, "text": "将军,"}, {"start": 1250.98, "end": 1277.63, "text": "这边请。"}, {"start": 1277.63, "end": 1278.91, "text": "还是没见着?"}, {"start": 1278.91, "end": 1280.79, "text": "虽然没见着孔明先生,"}, {"start": 1280.79, "end": 1282.55, "text": "但毕竟见着棋弟了,"}, {"start": 1282.55, "end": 1284.67, "text": "总算是没空跑嘛。"}, {"start": 1284.67, "end": 1286.47, "text": "大哥,"}, {"start": 1286.47, "end": 1289.31, "text": "如果孔明有八个兄弟,"}, {"start": 1289.31, "end": 1291.71, "text": "你还要来八次。"}, {"start": 1291.71, "end": 1292.71, "text": "先生来了,"}, {"start": 1292.71, "end": 1293.55, "text": "先生来了,"}, {"start": 1293.55, "end": 1298.39, "text": "先生!"}, {"start": 1298.39, "end": 1302.31, "text": "卧龙先生回来了,"}, {"start": 1302.31, "end": 1303.59, "text": "先生辛苦了,"}, {"start": 1303.59, "end": 1305.15, "text": "在下恭候多时了。"}, {"start": 1305.15, "end": 1306.75, "text": "你是?"}, {"start": 1306.75, "end": 1308.47, "text": "心也留备自全德,"}, {"start": 1308.47, "end": 1310.87, "text": "拜见卧龙先生。"}, {"start": 1310.87, "end": 1312.63, "text": "错了错了,"}, {"start": 1312.63, "end": 1314.03, "text": "他不是孔明先生,"}, {"start": 1314.03, "end": 1316.87, "text": "他是黄老丈。"}, {"start": 1316.87, "end": 1318.91, "text": "在下是诸葛亮的岳父,"}, {"start": 1318.91, "end": 1320.15, "text": "黄承宴,"}, {"start": 1320.15, "end": 1323.95, "text": "此行是来看望小旭的。"}, {"start": 1323.95, "end": 1326.11, "text": "原来是老丈,"}, {"start": 1326.11, "end": 1337.53, "text": "在下有礼了。"}, {"start": 1337.53, "end": 1349.83, "text": "大哥又认错人了。"}, {"start": 1349.83, "end": 1350.83, "text": "哥哥,"}, {"start": 1350.83, "end": 1352.99, "text": "你这是怎么了?"}, {"start": 1352.99, "end": 1355.79, "text": "莫非让这孔明给去蒙了?"}, {"start": 1355.79, "end": 1357.47, "text": "这贱人就叩头,"}, {"start": 1357.47, "end": 1359.11, "text": "到处施大礼的,"}, {"start": 1359.11, "end": 1361.35, "text": "比拜观音菩萨还勤快。"}, {"start": 1361.35, "end": 1363.27, "text": "三弟不要胡言乱语,"}, {"start": 1363.27, "end": 1364.75, "text": "大哥这是,"}, {"start": 1364.75, "end": 1367.75, "text": "求贤若渴。"}, {"start": 1367.75, "end": 1369.35, "text": "大哥,"}, {"start": 1369.39, "end": 1370.59, "text": "我说实话,"}, {"start": 1370.59, "end": 1372.23, "text": "孔明可能是个贤士,"}, {"start": 1372.23, "end": 1373.47, "text": "或许不是。"}, {"start": 1373.47, "end": 1374.79, "text": "或许,"}, {"start": 1374.79, "end": 1376.83, "text": "他不是贤士,"}, {"start": 1376.83, "end": 1378.99, "text": "而是一个,"}, {"start": 1378.99, "end": 1381.03, "text": "孤民钓鱼之徒。"}, {"start": 1381.03, "end": 1383.47, "text": "哥哥说得有道理。"}, {"start": 1383.47, "end": 1384.95, "text": "现在,"}, {"start": 1384.95, "end": 1386.83, "text": "我也是这么想。"}, {"start": 1386.83, "end": 1387.79, "text": "那次,"}, {"start": 1387.79, "end": 1390.51, "text": "老是躲着不见面。"}, {"start": 1390.51, "end": 1395.1, "text": "这就是想抬高自己的身价吗?"}, {"start": 1395.1, "end": 1398.14, "text": "你们不许多言了,"}, {"start": 1398.14, "end": 1400.88, "text": "我坚信,"}, {"start": 1400.88, "end": 1403.24, "text": "郭龙是国士,"}, {"start": 1403.24, "end": 1405.72, "text": "是巨贤,"}, {"start": 1405.72, "end": 1431.83, "text": "是我们的天意所属。"}, {"start": 1431.83, "end": 1432.91, "text": "必是,"}, {"start": 1432.91, "end": 1434.71, "text": "必是!"}, {"start": 1434.71, "end": 1439.52, "text": "等等我!"}, {"start": 1439.52, "end": 1441.4, "text": "我军三个月的粮饷,"}, {"start": 1441.4, "end": 1443.16, "text": "都被蔡茂扣住了。"}, {"start": 1443.16, "end": 1443.8, "text": "昨日,"}, {"start": 1443.8, "end": 1445.2, "text": "在下亲自去荆州,"}, {"start": 1445.2, "end": 1447.2, "text": "和他当面理论。"}, {"start": 1447.2, "end": 1448.16, "text": "我说,"}, {"start": 1448.16, "end": 1449.48, "text": "新野的粮饷,"}, {"start": 1449.48, "end": 1451.32, "text": "是刘锦升答应过的。"}, {"start": 1451.32, "end": 1453.52, "text": "我们刚刚击退曹仁大军,"}, {"start": 1453.52, "end": 1455.24, "text": "保住了荆乡平安,"}, {"start": 1455.24, "end": 1456.52, "text": "为何敌军一退,"}, {"start": 1456.52, "end": 1457.92, "text": "你们却不给粮饷了?"}, {"start": 1457.92, "end": 1459.32, "text": "问得好,"}, {"start": 1459.32, "end": 1460.68, "text": "蔡茂怎么说?"}, {"start": 1460.68, "end": 1461.72, "text": "蔡茂说,"}, {"start": 1461.72, "end": 1462.72, "text": "不是不给,"}, {"start": 1462.72, "end": 1464.16, "text": "是暂缓,"}, {"start": 1464.16, "end": 1466.52, "text": "等各军的粮草上缴以后,"}, {"start": 1466.52, "end": 1469.28, "text": "再示情发放。"}, {"start": 1469.28, "end": 1471.76, "text": "托词。"}, {"start": 1471.76, "end": 1472.68, "text": "还有,"}, {"start": 1472.68, "end": 1475.04, "text": "我们通过商旅买的二百匹战马,"}, {"start": 1475.04, "end": 1477.08, "text": "已被襄阳的主军给扣住了。"}, {"start": 1477.08, "end": 1477.88, "text": "昨日,"}, {"start": 1477.88, "end": 1480.44, "text": "咪方率五百军士前去索要,"}, {"start": 1480.44, "end": 1482.84, "text": "只要回了几十匹奴马。"}, {"start": 1482.84, "end": 1484.04, "text": "他娘的!"}, {"start": 1484.04, "end": 1485.32, "text": "太欺负人了!"}, {"start": 1485.32, "end": 1486.32, "text": "我去!"}, {"start": 1486.32, "end": 1489.41, "text": "三弟,"}, {"start": 1489.41, "end": 1494.99, "text": "你坐下,"}, {"start": 1494.99, "end": 1497.07, "text": "刘景生病势如何?"}, {"start": 1497.07, "end": 1498.51, "text": "听公子说,"}, {"start": 1498.51, "end": 1500.75, "text": "日渐沉重了。"}, {"start": 1500.75, "end": 1502.99, "text": "大哥,"}, {"start": 1502.99, "end": 1504.43, "text": "蔡茂处处排挤,"}, {"start": 1504.43, "end": 1505.91, "text": "世事刁难,"}, {"start": 1505.91, "end": 1507.39, "text": "其用意,"}, {"start": 1507.39, "end": 1510.07, "text": "是想逼我们离开荆乡。"}, {"start": 1510.07, "end": 1512.59, "text": "说得对,"}, {"start": 1512.59, "end": 1515.75, "text": "不过这未必是刘表的意思,"}, {"start": 1515.75, "end": 1519.47, "text": "而是蔡茂肆意妄为。"}, {"start": 1519.47, "end": 1521.39, "text": "如果刘表病好了,"}, {"start": 1521.39, "end": 1523.19, "text": "重掌军政,"}, {"start": 1523.19, "end": 1526.59, "text": "那蔡茂断断不敢如此放肆。"}, {"start": 1526.59, "end": 1528.11, "text": "大哥,二哥,"}, {"start": 1528.11, "end": 1530.19, "text": "你们暂且让我提一支军马,"}, {"start": 1530.19, "end": 1531.39, "text": "这就去荆州,"}, {"start": 1531.39, "end": 1533.79, "text": "管那姓蔡的药粮去,"}, {"start": 1533.79, "end": 1536.39, "text": "她肯定不会给。"}, {"start": 1536.39, "end": 1537.39, "text": "到那个时候,"}, {"start": 1537.39, "end": 1538.99, "text": "我就跟她打起来,"}, {"start": 1538.99, "end": 1540.19, "text": "你们放心,"}, {"start": 1540.19, "end": 1541.59, "text": "我不杀她,"}, {"start": 1541.59, "end": 1542.99, "text": "只是打她个半死,"}, {"start": 1542.99, "end": 1546.19, "text": "把事情一口大。"}, {"start": 1546.19, "end": 1547.39, "text": "那时候,"}, {"start": 1547.39, "end": 1549.59, "text": "刘表的病就全好了,"}, {"start": 1549.59, "end": 1551.19, "text": "我保证!"}, {"start": 1551.19, "end": 1553.59, "text": "三弟的意思是,"}, {"start": 1553.59, "end": 1554.79, "text": "刘表是装病吗?"}, {"start": 1554.79, "end": 1556.39, "text": "那可不是,"}, {"start": 1556.39, "end": 1559.39, "text": "她心里也想逼咱们走,"}, {"start": 1559.39, "end": 1561.19, "text": "可又不好意思说,"}, {"start": 1561.19, "end": 1562.59, "text": "那怎么办?"}, {"start": 1562.59, "end": 1564.19, "text": "就自己装病呗,"}, {"start": 1564.19, "end": 1567.79, "text": "还指使那个蔡茂来为难我们。"}, {"start": 1567.79, "end": 1569.99, "text": "就这等小伎俩,"}, {"start": 1569.99, "end": 1573.19, "text": "那岂能瞒得过我张义德?"}, {"start": 1573.19, "end": 1575.19, "text": "大哥,你说是不?"}, {"start": 1575.19, "end": 1576.99, "text": "不是,"}, {"start": 1576.99, "end": 1580.59, "text": "我义不到万不得已,"}, {"start": 1580.59, "end": 1582.79, "text": "不要和荆州方面闹分,"}, {"start": 1582.79, "end": 1584.79, "text": "实在不行,"}, {"start": 1584.79, "end": 1586.59, "text": "将中军转职,"}, {"start": 1586.59, "end": 1588.39, "text": "返程驻扎,"}, {"start": 1588.39, "end": 1590.59, "text": "离荆州远几百里。"}, {"start": 1590.59, "end": 1592.39, "text": "再等等吧。"}, {"start": 1592.39, "end": 1593.39, "text": "等等,"}, {"start": 1593.39, "end": 1594.99, "text": "还等什么?"}, {"start": 1594.99, "end": 1597.19, "text": "一则,"}, {"start": 1597.19, "end": 1599.79, "text": "等刘景生病逝稍缓,"}, {"start": 1599.79, "end": 1601.79, "text": "二则,"}, {"start": 1601.79, "end": 1606.09, "text": "等孔明回来。"}, {"start": 1606.09, "end": 1608.49, "text": "你还惦记着那个俘儒啊?"}, {"start": 1608.49, "end": 1616.23, "text": "我早把她给忘了!"}, {"start": 1616.23, "end": 1618.03, "text": "见不着孔明,"}, {"start": 1618.03, "end": 1620.23, "text": "我不离开新野。"}, {"start": 1620.23, "end": 1622.23, "text": "大哥,"}, {"start": 1622.23, "end": 1624.63, "text": "竟为了一个山野村夫,"}, {"start": 1624.63, "end": 1626.23, "text": "困坐微诚,"}, {"start": 1626.23, "end": 1632.24, "text": "您不是山野村夫,"}, {"start": 1632.24, "end": 1634.04, "text": "新野也不是微诚,"}, {"start": 1634.04, "end": 1688.83, "text": "上上大吉呀!"}, {"start": 1688.83, "end": 1690.23, "text": "二弟!三弟!"}, {"start": 1690.23, "end": 1695.1, "text": "二弟!三弟!"}, {"start": 1695.1, "end": 1696.5, "text": "二弟!三弟!"}, {"start": 1696.5, "end": 1698.1, "text": "二弟!三弟!"}, {"start": 1698.1, "end": 1700.3, "text": "我刚刚不得已加期,正好是今日,"}, {"start": 1700.3, "end": 1701.5, "text": "我们即刻出发,"}, {"start": 1701.5, "end": 1702.9, "text": "随我去龙中拜访孔明。"}, {"start": 1702.9, "end": 1703.7, "text": "他在吗?"}, {"start": 1703.7, "end": 1704.3, "text": "必在,"}, {"start": 1704.3, "end": 1705.3, "text": "快快备马!"}, {"start": 1705.3, "end": 1707.1, "text": "大哥,"}, {"start": 1707.3, "end": 1709.5, "text": "怕你伤心有句话,"}, {"start": 1709.5, "end": 1713.18, "text": "我一直忍着。"}, {"start": 1713.18, "end": 1717.56, "text": "二弟,你尽管说。"}, {"start": 1717.56, "end": 1719.76, "text": "我们已经去过卧龙岗两次了,"}, {"start": 1719.76, "end": 1721.76, "text": "都没见到朱克亮。"}, {"start": 1721.76, "end": 1723.96, "text": "如果此人是个通情达理之人,"}, {"start": 1723.96, "end": 1724.76, "text": "那么,"}, {"start": 1724.76, "end": 1728.81, "text": "他一定会来新野回拜他。"}, {"start": 1728.81, "end": 1731.21, "text": "但他至今不肯露面,"}, {"start": 1731.21, "end": 1733.21, "text": "说明此人并无才学,"}, {"start": 1733.21, "end": 1734.61, "text": "所以每每躲避着,"}, {"start": 1734.61, "end": 1739.31, "text": "不敢见兄长啊。"}, {"start": 1739.31, "end": 1740.51, "text": "二弟啊,"}, {"start": 1740.51, "end": 1742.91, "text": "七皇宫见东郭先生,"}, {"start": 1743.11, "end": 1745.51, "text": "五次往返方德见一面,"}, {"start": 1746.51, "end": 1748.51, "text": "孔明远胜东郭先生,"}, {"start": 1748.51, "end": 1749.71, "text": "而我求贤之心,"}, {"start": 1749.71, "end": 1753.7, "text": "反倒还不及七皇宫吗?"}, {"start": 1753.7, "end": 1754.5, "text": "大哥,"}, {"start": 1754.5, "end": 1756.1, "text": "你是有诚心啊,"}, {"start": 1756.1, "end": 1758.3, "text": "孔明那次却无真意。"}, {"start": 1758.3, "end": 1759.1, "text": "大哥,二哥,"}, {"start": 1759.1, "end": 1760.7, "text": "今天你们都不用去了,"}, {"start": 1760.7, "end": 1762.1, "text": "我一个人去就行。"}, {"start": 1762.1, "end": 1763.5, "text": "为何你去就行啊?"}, {"start": 1763.5, "end": 1764.5, "text": "怎么不行?"}, {"start": 1764.5, "end": 1765.5, "text": "我拿根绳索,"}, {"start": 1765.5, "end": 1766.5, "text": "把他捆来就是了。"}, {"start": 1766.5, "end": 1768.1, "text": "你不必去了,"}, {"start": 1768.1, "end": 1769.3, "text": "我跟云长去。"}, {"start": 1769.3, "end": 1770.3, "text": "好好好,"}, {"start": 1770.3, "end": 1770.9, "text": "罚了,"}, {"start": 1770.9, "end": 1772.5, "text": "既然两位兄长都去,"}, {"start": 1772.5, "end": 1774.1, "text": "小弟怎能落后?"}, {"start": 1774.1, "end": 1775.5, "text": "我跟着就是了。"}, {"start": 1775.5, "end": 1776.5, "text": "去可以,"}, {"start": 1776.5, "end": 1778.1, "text": "万万不可失礼。"}, {"start": 1778.1, "end": 1779.7, "text": "知道,知道。"}, {"start": 1779.7, "end": 1780.5, "text": "张义德啊,"}, {"start": 1780.5, "end": 1781.7, "text": "是最讲道理的人。"}, {"start": 1781.7, "end": 1782.1, "text": "二哥,"}, {"start": 1782.1, "end": 1783.1, "text": "你说是不是?"}, {"start": 1783.1, "end": 1783.9, "text": "是,"}, {"start": 1783.9, "end": 1784.9, "text": "是啊,"}, {"start": 1784.9, "end": 1786.3, "text": "全天下的道理,"}, {"start": 1786.3, "end": 1788.3, "text": "都在你那杖巴蛇毛上呢。"}, {"start": 1797.04, "end": 1798.44, "text": "此去我龙岗,"}, {"start": 1798.44, "end": 1800.04, "text": "还有两里了,"}, {"start": 1800.04, "end": 1801.24, "text": "下马吧。"}, {"start": 1801.24, "end": 1802.44, "text": "既然还有两里了,"}, {"start": 1802.44, "end": 1803.64, "text": "干嘛下马啊?"}, {"start": 1804.84, "end": 1806.04, "text": "下马不行,"}, {"start": 1806.04, "end": 1807.44, "text": "已是至上。"}, {"start": 1807.84, "end": 1808.44, "text": "哥哥,"}, {"start": 1808.44, "end": 1809.84, "text": "你可够傻的啊,"}, {"start": 1809.84, "end": 1811.24, "text": "这咱成不成的,"}, {"start": 1811.24, "end": 1813.24, "text": "他朱葛亮也看不见呢。"}, {"start": 1813.24, "end": 1814.24, "text": "上有天公,"}, {"start": 1814.24, "end": 1815.84, "text": "下有地母,"}, {"start": 1815.84, "end": 1817.44, "text": "人心中的善善恶恶,"}, {"start": 1817.44, "end": 1818.84, "text": "天地都能看得见,"}, {"start": 1818.84, "end": 1820.44, "text": "听得着。"}, {"start": 1820.44, "end": 1822.24, "text": "诚心是对别人的,"}, {"start": 1822.24, "end": 1828.13, "text": "更是对自己的。"}, {"start": 1829.13, "end": 1831.33, "text": "在下见过刘将军。"}, {"start": 1832.13, "end": 1833.53, "text": "朱葛先生,"}, {"start": 1833.53, "end": 1835.33, "text": "请问尊兄回来没有?"}, {"start": 1835.33, "end": 1836.73, "text": "家兄昨日晚上,"}, {"start": 1836.73, "end": 1838.13, "text": "刚刚返回,"}, {"start": 1838.13, "end": 1840.93, "text": "今日便可与将军在家相会。"}, {"start": 1841.53, "end": 1843.13, "text": "在下有事下山,"}, {"start": 1843.13, "end": 1844.33, "text": "告辞了。"}, {"start": 1844.33, "end": 1848.98, "text": "好,"}, {"start": 1848.98, "end": 1849.98, "text": "不许此行,"}, {"start": 1849.98, "end": 1851.78, "text": "终于可以见到了。"}, {"start": 1851.78, "end": 1852.98, "text": "我也要看一看,"}, {"start": 1852.98, "end": 1853.78, "text": "这孔明,"}, {"start": 1853.78, "end": 1855.98, "text": "到底长了几个鼻子几只眼啊?"}, {"start": 1855.98, "end": 1856.78, "text": "到了乌龙岗,"}, {"start": 1856.78, "end": 1857.98, "text": "我自己去见孔明。"}, {"start": 1857.98, "end": 1859.18, "text": "二位贤弟,"}, {"start": 1859.18, "end": 1860.18, "text": "在外面等候。"}, {"start": 1860.18, "end": 1861.78, "text": "遵命,大哥。"}, {"start": 1862.18, "end": 1863.38, "text": "屋里慢的话,"}, {"start": 1863.38, "end": 1864.98, "text": "我们还是外头爽快。"}, {"start": 1886.66, "end": 1887.86, "text": "刘将军,"}, {"start": 1888.66, "end": 1890.46, "text": "我家先生回来了。"}, {"start": 1891.86, "end": 1893.46, "text": "有劳先同转报,"}, {"start": 1893.46, "end": 1894.46, "text": "就说,"}, {"start": 1894.46, "end": 1896.46, "text": "刘备专程前来拜访。"}, {"start": 1896.46, "end": 1897.66, "text": "我名叫阿三,"}, {"start": 1897.66, "end": 1899.06, "text": "怎么成了先童?"}, {"start": 1899.06, "end": 1899.86, "text": "小子,"}, {"start": 1899.86, "end": 1901.66, "text": "你别臭美了。"}, {"start": 1901.66, "end": 1902.46, "text": "赶快进去,"}, {"start": 1902.46, "end": 1903.86, "text": "叫你们家主子出来迎客了。"}, {"start": 1903.86, "end": 1905.06, "text": "三弟。"}, {"start": 1906.66, "end": 1908.26, "text": "先生半夜才回来,"}, {"start": 1908.26, "end": 1910.26, "text": "现在在草堂上酣睡。"}, {"start": 1911.06, "end": 1912.26, "text": "既然如此,"}, {"start": 1912.26, "end": 1913.66, "text": "不可惊动,"}, {"start": 1913.66, "end": 1915.26, "text": "我就在外面等候好了。"}, {"start": 1915.26, "end": 1916.06, "text": "那可不好,"}, {"start": 1916.06, "end": 1917.06, "text": "先生会怪我的,"}, {"start": 1917.06, "end": 1917.46, "text": "将军,"}, {"start": 1917.46, "end": 1918.86, "text": "你还是进来吧。"}, {"start": 1918.86, "end": 1920.06, "text": "遵命。"}, {"start": 1921.26, "end": 1922.46, "text": "二弟、三弟,"}, {"start": 1922.46, "end": 1924.06, "text": "你们两个在这等候,"}, {"start": 1924.06, "end": 1926.06, "text": "我进去拜会孔明先生,"}, {"start": 1926.06, "end": 1927.46, "text": "切不可喧闹。"}, {"start": 1927.66, "end": 1928.86, "text": "行。"}, {"start": 1928.86, "end": 1929.76, "text": "大哥,"}, {"start": 1929.76, "end": 1930.96, "text": "你放心吧,"}, {"start": 1930.96, "end": 1932.06, "text": "我们不会打扰"}, {"start": 1932.06, "end": 1935.46, "text": "乌龙先生的好梦。"}, {"start": 1935.46, "end": 1999.66, "text": "将军请。"}, {"start": 1999.66, "end": 2002.26, "text": "咱们兄长怎么跟个学童似的,"}, {"start": 2002.26, "end": 2004.26, "text": "乖乖地在那站着呢?"}, {"start": 2005.26, "end": 2006.36, "text": "看来,"}, {"start": 2006.36, "end": 2009.73, "text": "孔明还没睡醒啊。"}, {"start": 2009.73, "end": 2012.63, "text": "咱大哥是满腔斥诚地来拜会他,"}, {"start": 2012.63, "end": 2013.63, "text": "这次,"}, {"start": 2013.63, "end": 2015.83, "text": "竟然如此无礼啊。"}, {"start": 2015.83, "end": 2017.23, "text": "这俘儒啊,"}, {"start": 2017.23, "end": 2019.03, "text": "带我去放把火,"}, {"start": 2019.03, "end": 2020.43, "text": "看他起来不起来。"}, {"start": 2020.43, "end": 2021.23, "text": "三弟,"}, {"start": 2021.23, "end": 2022.43, "text": "不可糟蹋,"}, {"start": 2022.43, "end": 2036.36, "text": "坐下吧,"}, {"start": 2036.36, "end": 2038.26, "text": "你又要干什么?"}, {"start": 2038.26, "end": 2040.46, "text": "我去小解。"}, {"start": 2040.46, "end": 2041.66, "text": "不可走远啊。"}, {"start": 2041.66, "end": 2042.46, "text": "知道了,"}, {"start": 2042.46, "end": 2071.88, "text": "知道了。"}, {"start": 2071.88, "end": 2072.68, "text": "先生。"}, {"start": 2072.68, "end": 2101.96, "text": "大梦谁先觉,"}, {"start": 2101.96, "end": 2105.66, "text": "平生我自知,"}, {"start": 2105.66, "end": 2108.86, "text": "草堂春睡足,"}, {"start": 2108.86, "end": 2112.46, "text": "窗外日迟迟。"}, {"start": 2112.46, "end": 2129.38, "text": "新野刘备,"}, {"start": 2129.38, "end": 2133.33, "text": "拜见乌龙先生。"}, {"start": 2133.33, "end": 2135.33, "text": "惭愧惭愧,"}, {"start": 2135.33, "end": 2136.93, "text": "将军两次前来,"}, {"start": 2136.93, "end": 2138.33, "text": "都未曾如面,"}, {"start": 2138.33, "end": 2141.03, "text": "今日前来又未曾远迎,"}, {"start": 2141.03, "end": 2144.77, "text": "恕罪恕罪。"}, {"start": 2144.77, "end": 2146.27, "text": "知不知,"}, {"start": 2146.27, "end": 2149.07, "text": "这大火是如何烧起来的呀?"}, {"start": 2149.07, "end": 2152.19, "text": "哥哥,"}, {"start": 2152.19, "end": 2153.39, "text": "那是何等人物啊?"}, {"start": 2153.39, "end": 2155.19, "text": "三三两次的来看你,"}, {"start": 2155.19, "end": 2157.29, "text": "你却到处游玩不归的。"}, {"start": 2157.29, "end": 2159.39, "text": "今日总算是回来了,"}, {"start": 2159.39, "end": 2160.99, "text": "又死猪一般地睡,"}, {"start": 2160.99, "end": 2161.89, "text": "害得我哥哥"}, {"start": 2161.89, "end": 2163.79, "text": "足足等了三个多时辰啊。"}, {"start": 2163.79, "end": 2164.69, "text": "是我忍不住,"}, {"start": 2164.69, "end": 2165.79, "text": "放了一把火,"}, {"start": 2165.79, "end": 2166.79, "text": "为你出度假。"}, {"start": 2166.79, "end": 2169.37, "text": "放肆。"}, {"start": 2169.37, "end": 2170.17, "text": "还不快跪下,"}, {"start": 2170.17, "end": 2171.77, "text": "向先生请罪。"}, {"start": 2171.77, "end": 2174.47, "text": "将军不必责怪他。"}, {"start": 2174.47, "end": 2175.97, "text": "你就是张一德吧,"}, {"start": 2175.97, "end": 2177.87, "text": "果然赤胆忠心。"}, {"start": 2177.87, "end": 2179.57, "text": "我这草庐早已破旧,"}, {"start": 2179.57, "end": 2181.17, "text": "今日天降一把大火,"}, {"start": 2181.17, "end": 2182.87, "text": "烧得大快人心,"}, {"start": 2182.87, "end": 2185.47, "text": "还得多谢张将军了。"}, {"start": 2185.47, "end": 2190.79, "text": "这孔明倒是很会说话呀。"}, {"start": 2190.79, "end": 2191.89, "text": "这位便是,"}, {"start": 2191.89, "end": 2193.09, "text": "挂印封经,"}, {"start": 2193.09, "end": 2195.59, "text": "过武官斩将的关云长了。"}, {"start": 2195.59, "end": 2196.99, "text": "在下无耻开外,"}, {"start": 2196.99, "end": 2203.59, "text": "便觉英雄气逼面而来。"}, {"start": 2203.59, "end": 2206.49, "text": "不敢。"}, {"start": 2206.59, "end": 2207.99, "text": "寒舍简陋了,"}, {"start": 2207.99, "end": 2208.89, "text": "阿三烹茶,"}, {"start": 2208.89, "end": 2209.99, "text": "书房待客。"}, {"start": 2209.99, "end": 2242.29, "text": "遵命。"}, {"start": 2242.29, "end": 2243.99, "text": "奸贼四起,"}, {"start": 2243.99, "end": 2246.19, "text": "天下大乱,"}, {"start": 2246.19, "end": 2247.89, "text": "刚长伦丧,"}, {"start": 2247.89, "end": 2251.3, "text": "苍生猛难。"}, {"start": 2251.3, "end": 2254.2, "text": "我身为汉皇后依女,"}, {"start": 2254.2, "end": 2255.6, "text": "每日凌晨,"}, {"start": 2255.6, "end": 2257.6, "text": "眺望蓝天,"}, {"start": 2257.6, "end": 2261.71, "text": "心痛如角啊。"}, {"start": 2261.71, "end": 2264.31, "text": "大痛者必有大志,"}, {"start": 2264.31, "end": 2266.71, "text": "否则痛从何来?"}, {"start": 2266.71, "end": 2271.9, "text": "在下愿闻将军其志。"}, {"start": 2271.9, "end": 2274.8, "text": "我欲奉天子之命,"}, {"start": 2274.8, "end": 2277.4, "text": "扶乾坤与冀斗,"}, {"start": 2277.4, "end": 2280.74, "text": "救黎民与水火。"}, {"start": 2280.74, "end": 2282.94, "text": "可叹我,"}, {"start": 2282.94, "end": 2284.84, "text": "德薄至短,"}, {"start": 2284.84, "end": 2286.54, "text": "起兵至今,"}, {"start": 2286.54, "end": 2289.14, "text": "屡屡被强敌所败。"}, {"start": 2289.14, "end": 2293.34, "text": "几番丧家失所,"}, {"start": 2293.34, "end": 2298.03, "text": "数次颠沛流。"}, {"start": 2298.03, "end": 2300.73, "text": "甚至想拔剑自乎,"}, {"start": 2300.73, "end": 2305.74, "text": "一死了之,"}, {"start": 2305.74, "end": 2308.24, "text": "愧不能言啊。"}, {"start": 2308.24, "end": 2310.04, "text": "所以,"}, {"start": 2310.04, "end": 2312.04, "text": "我三顾茅庐,"}, {"start": 2312.04, "end": 2313.84, "text": "常请先生,"}, {"start": 2313.84, "end": 2319.9, "text": "教我良策。"}, {"start": 2319.9, "end": 2321.7, "text": "董卓之后,"}, {"start": 2321.7, "end": 2324.3, "text": "诸雄并起,"}, {"start": 2324.3, "end": 2326.3, "text": "曹操势力本不及袁绍,"}, {"start": 2326.3, "end": 2327.6, "text": "却能灭了袁绍,"}, {"start": 2327.6, "end": 2329.0, "text": "独成霸业。"}, {"start": 2329.0, "end": 2330.6, "text": "这是为何?"}, {"start": 2330.6, "end": 2332.0, "text": "一在天时,"}, {"start": 2332.0, "end": 2334.2, "text": "二在人谋。"}, {"start": 2334.2, "end": 2335.3, "text": "现如今,"}, {"start": 2335.3, "end": 2336.8, "text": "曹操拥兵百万,"}, {"start": 2336.8, "end": 2338.6, "text": "挟天子以令诸侯,"}, {"start": 2338.6, "end": 2340.0, "text": "执天下牛耳,"}, {"start": 2340.0, "end": 2341.6, "text": "兵威正胜。"}, {"start": 2341.6, "end": 2342.6, "text": "将军,"}, {"start": 2342.6, "end": 2345.95, "text": "不可与之争风。"}, {"start": 2345.95, "end": 2347.15, "text": "再者,"}, {"start": 2347.15, "end": 2348.85, "text": "孙氏兄弟聚江东,"}, {"start": 2348.85, "end": 2350.05, "text": "以立三氏,"}, {"start": 2350.05, "end": 2351.25, "text": "国显而民富,"}, {"start": 2351.25, "end": 2353.15, "text": "兵精而将有。"}, {"start": 2353.15, "end": 2355.25, "text": "将军只可联之为盟,"}, {"start": 2355.25, "end": 2357.45, "text": "不可突发江东。"}, {"start": 2357.45, "end": 2358.55, "text": "再其次,"}, {"start": 2358.55, "end": 2359.65, "text": "京乡九郡,"}, {"start": 2359.65, "end": 2360.75, "text": "四同八达,"}, {"start": 2360.75, "end": 2362.25, "text": "名声富足。"}, {"start": 2362.25, "end": 2364.65, "text": "但其主刘表却十分庸弱,"}, {"start": 2364.65, "end": 2366.45, "text": "断不能久守。"}, {"start": 2366.45, "end": 2369.05, "text": "荆州早晚必将易主。"}, {"start": 2369.05, "end": 2370.15, "text": "这,"}, {"start": 2370.15, "end": 2373.95, "text": "便是上天赐给将军的根据之地。"}, {"start": 2373.95, "end": 2378.05, "text": "难道将军不愿得京乡吗?"}, {"start": 2378.05, "end": 2382.57, "text": "盼直言相告。"}, {"start": 2382.57, "end": 2383.37, "text": "想,"}, {"start": 2383.37, "end": 2388.88, "text": "却不忍心。"}, {"start": 2388.88, "end": 2391.58, "text": "刘景生是我皇兄,"}, {"start": 2391.58, "end": 2396.24, "text": "何人独他激烈?"}, {"start": 2396.24, "end": 2398.64, "text": "我夜观天象,"}, {"start": 2398.64, "end": 2400.84, "text": "刘表已经病危。"}, {"start": 2400.84, "end": 2402.54, "text": "荆州不久,"}, {"start": 2402.54, "end": 2405.44, "text": "便是一座无主之城。"}, {"start": 2405.44, "end": 2407.04, "text": "将军不去,"}, {"start": 2407.04, "end": 2410.14, "text": "难道等曹操来取吗?"}, {"start": 2410.14, "end": 2411.84, "text": "将军得荆州后,"}, {"start": 2411.84, "end": 2412.84, "text": "下一步,"}, {"start": 2412.84, "end": 2414.24, "text": "则要避开中原,"}, {"start": 2414.24, "end": 2415.44, "text": "挥军西向,"}, {"start": 2415.44, "end": 2416.64, "text": "攻取义州,"}, {"start": 2416.64, "end": 2418.34, "text": "也即是西川。"}, {"start": 2418.34, "end": 2419.34, "text": "川地艰险,"}, {"start": 2419.34, "end": 2420.34, "text": "易守难攻,"}, {"start": 2420.34, "end": 2422.54, "text": "古称川地为天府之国,"}, {"start": 2422.54, "end": 2423.94, "text": "那里物产丰盛,"}, {"start": 2423.94, "end": 2425.94, "text": "足可养兵百万。"}, {"start": 2425.94, "end": 2426.74, "text": "当年,"}, {"start": 2426.74, "end": 2428.84, "text": "高祖刘邦就是从川地起兵,"}, {"start": 2428.84, "end": 2431.64, "text": "而得天下成帝也。"}, {"start": 2431.64, "end": 2432.64, "text": "将军得西川、"}, {"start": 2432.64, "end": 2433.94, "text": "京乡两地之后,"}, {"start": 2433.94, "end": 2435.64, "text": "天下一居齐半,"}, {"start": 2435.74, "end": 2436.44, "text": "既知,"}, {"start": 2436.44, "end": 2437.84, "text": "就该南府一跃,"}, {"start": 2437.84, "end": 2438.94, "text": "西合诸荣,"}, {"start": 2438.94, "end": 2440.04, "text": "外劫孙氏,"}, {"start": 2440.04, "end": 2441.94, "text": "内修君正名声。"}, {"start": 2441.94, "end": 2443.14, "text": "待天下有变,"}, {"start": 2443.14, "end": 2444.84, "text": "便可率熊师出秦川,"}, {"start": 2444.84, "end": 2445.74, "text": "取许昌,"}, {"start": 2445.74, "end": 2447.04, "text": "灭曹贼。"}]