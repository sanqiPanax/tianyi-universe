[{"start": 12.11, "end": 16.11, "text": "先前我还以为朝廷会嫌我官职低微"}, {"start": 16.71, "end": 18.51, "text": "不肯将徐州赤封于我"}, {"start": 20.81, "end": 24.53, "text": "可现在不但让我领了徐州墓"}, {"start": 25.33, "end": 27.25, "text": "而且还令我奉诏逃贼"}, {"start": 27.57, "end": 29.65, "text": "征战袁术 攻取南洋军"}, {"start": 30.41, "end": 32.53, "text": "几位兄弟 你们有何建议"}, {"start": 33.41, "end": 36.25, "text": "大哥 你只管做你的徐州墓"}, {"start": 36.53, "end": 38.85, "text": "招兵买马 练兵备战"}, {"start": 39.69, "end": 41.97, "text": "至于征讨袁术吗"}, {"start": 42.53, "end": 45.05, "text": "那肯定是曹操假借天子之名"}, {"start": 45.73, "end": 47.17, "text": "发的狡诏乱命"}, {"start": 47.69, "end": 55.08, "text": "兄弟此话怕是不妥"}, {"start": 55.88, "end": 57.24, "text": "恩诏我们接下了"}, {"start": 57.52, "end": 60.08, "text": "密旨却视为狡诏乱命"}, {"start": 61.04, "end": 62.12, "text": "这岂不是说"}, {"start": 62.6, "end": 64.8, "text": "哪个对我们有利我们就接哪个吗"}, {"start": 65.52, "end": 68.28, "text": "如此的话 非臣子之道"}, {"start": 68.28, "end": 69.32, "text": "这打就打呗"}, {"start": 69.84, "end": 71.8, "text": "这袁术也不是什么好东西"}, {"start": 72.8, "end": 73.68, "text": "你们还记得不"}, {"start": 74.56, "end": 77.04, "text": "这当初征讨董卓的时候"}, {"start": 77.36, "end": 78.56, "text": "就是这个贼袁术"}, {"start": 78.76, "end": 79.8, "text": "断了咱们的粮饷"}, {"start": 80.24, "end": 81.52, "text": "老给咱们使坏"}, {"start": 82.88, "end": 85.8, "text": "今日能打他个痛快 太好了"}, {"start": 86.68, "end": 87.92, "text": "以前的事情不提了"}, {"start": 89.52, "end": 93.64, "text": "今日确实因那袁术有不沉之心"}, {"start": 94.84, "end": 97.56, "text": "天子班照 我只能奉旨逃贼"}, {"start": 98.76, "end": 101.64, "text": "只是大军出征后"}, {"start": 102.48, "end": 106.54, "text": "这徐州城该由谁守备"}, {"start": 107.3, "end": 108.46, "text": "这可是一桩重任"}, {"start": 109.38, "end": 110.82, "text": "可 可别叫我守城啊"}, {"start": 111.62, "end": 112.58, "text": "我早就变坏了"}, {"start": 113.38, "end": 115.38, "text": "这征讨袁术 我得做先锋"}, {"start": 116.18, "end": 119.5, "text": "大哥 我愿留守徐州"}, {"start": 125.34, "end": 128.94, "text": "大军出征 早晚有事我需与你商量"}, {"start": 129.46, "end": 130.58, "text": "你必须与我同行"}, {"start": 133.44, "end": 136.76, "text": "主公 那就由在下领兵守城吧"}, {"start": 138.86, "end": 140.14, "text": "子龙勇猛过人"}, {"start": 140.78, "end": 142.22, "text": "是天赐先锋之将"}, {"start": 143.1, "end": 145.14, "text": "最好也同我一起出征"}, {"start": 145.78, "end": 146.78, "text": "好 好啊"}, {"start": 147.98, "end": 149.22, "text": "你们都出去痛快去了"}, {"start": 149.74, "end": 150.9, "text": "又把我一人丢在家里"}, {"start": 152.82, "end": 155.78, "text": "三弟 徐州可是咱们的根基"}, {"start": 156.22, "end": 157.1, "text": "重如性命"}, {"start": 157.78, "end": 159.02, "text": "你能够把家看好"}, {"start": 159.86, "end": 161.18, "text": "那可是大功一件"}, {"start": 165.66, "end": 169.94, "text": "不行 三弟性情暴躁"}, {"start": 169.94, "end": 171.94, "text": "一时一冲动 不能担当此大任"}, {"start": 172.58, "end": 173.86, "text": "此事从长计议吧"}, {"start": 175.62, "end": 178.38, "text": "什么话呀 哥哥也太少看人了吧"}, {"start": 180.14, "end": 182.1, "text": "我要是连个徐州都守不住"}, {"start": 182.42, "end": 183.3, "text": "哥哥砍了我脑袋"}, {"start": 184.42, "end": 185.74, "text": "三弟 你果真要守城"}, {"start": 186.94, "end": 188.14, "text": "你们只管放弃去吧"}, {"start": 189.06, "end": 190.58, "text": "这徐州交给我了"}, {"start": 194.54, "end": 196.98, "text": "好 既然这样"}, {"start": 197.38, "end": 198.66, "text": "那我给你定几条规矩"}, {"start": 199.46, "end": 201.22, "text": "在我们出征期间你务必遵守"}, {"start": 202.02, "end": 203.02, "text": "大哥 你只管说"}, {"start": 205.61, "end": 208.05, "text": "只是不要进我喝酒教场"}, {"start": 208.49, "end": 210.29, "text": "这第一条便是断不可饮酒"}, {"start": 211.53, "end": 216.37, "text": "这 不让出去打仗已经难过死了"}, {"start": 217.61, "end": 219.09, "text": "这不再让人喝酒"}, {"start": 219.73, "end": 221.05, "text": "这生不如死啊"}, {"start": 222.05, "end": 223.61, "text": "算了 算了 不行 她不行 算了"}, {"start": 224.97, "end": 225.97, "text": "哥哥 哥哥"}, {"start": 226.49, "end": 228.13, "text": "我做得到 做得到"}, {"start": 228.77, "end": 230.53, "text": "哥哥 你只管说你的规矩吧"}, {"start": 233.51, "end": 233.87, "text": "好"}, {"start": 235.67, "end": 238.43, "text": "第一条 不可饮酒之罪"}, {"start": 240.43, "end": 242.47, "text": "第二条 不可暴怒任性"}, {"start": 243.47, "end": 246.27, "text": "第三条 不可打骂军师"}, {"start": 246.27, "end": 249.63, "text": "军师 此三条为军令"}, {"start": 250.19, "end": 253.16, "text": "你万不可误"}, {"start": 253.36, "end": 254.12, "text": "大哥放心"}, {"start": 255.04, "end": 256.08, "text": "这许些小事啊"}, {"start": 257.0, "end": 258.88, "text": "我保证是严守部"}, {"start": 260.28, "end": 261.84, "text": "等你们凯旋归来"}, {"start": 263.0, "end": 264.08, "text": "我再开怀痛饮"}, {"start": 284.39, "end": 286.03, "text": "这直袭范吕之辈"}, {"start": 286.59, "end": 288.27, "text": "同诸脉九之流"}, {"start": 288.59, "end": 291.03, "text": "还 还想谋害我"}, {"start": 291.79, "end": 295.47, "text": "主公骂的可是刘关璋三兄弟"}, {"start": 296.03, "end": 299.19, "text": "郑氏 你们看"}, {"start": 301.67, "end": 303.23, "text": "曹操给我送来了一封密信"}, {"start": 303.95, "end": 306.15, "text": "说刘备给朝廷上了一道密奏"}, {"start": 306.91, "end": 308.59, "text": "诬陷我要称帝"}, {"start": 309.15, "end": 311.91, "text": "还要发兵攻破我的首府南洋"}, {"start": 314.71, "end": 316.23, "text": "刘备是什么东西啊"}, {"start": 317.67, "end": 319.23, "text": "原本一无名鼠辈"}, {"start": 319.59, "end": 321.59, "text": "却要谎称是皇室后裔"}, {"start": 322.27, "end": 323.47, "text": "其事道明嘛"}, {"start": 324.47, "end": 325.99, "text": "臣呀 陶前病亡"}, {"start": 326.43, "end": 328.31, "text": "窃取了偌大一座徐州"}, {"start": 328.71, "end": 329.71, "text": "尚不知足"}, {"start": 330.15, "end": 331.51, "text": "还想打我州县"}, {"start": 332.87, "end": 334.55, "text": "是可忍 说不可忍"}, {"start": 335.31, "end": 338.55, "text": "世风日下 小人得志"}, {"start": 339.11, "end": 340.03, "text": "刘备可恨"}, {"start": 340.63, "end": 342.79, "text": "请主公发兵 剿灭他"}, {"start": 342.95, "end": 345.15, "text": "刘备固然可恨"}, {"start": 345.99, "end": 348.99, "text": "但那曹操是善良之辈吗"}, {"start": 349.67, "end": 351.35, "text": "他说的每一句话"}, {"start": 351.75, "end": 353.31, "text": "就句句都是真的吗"}, {"start": 354.95, "end": 355.83, "text": "在下以为"}, {"start": 356.47, "end": 358.91, "text": "此事有几个疑点"}, {"start": 359.51, "end": 360.23, "text": "其一"}, {"start": 361.03, "end": 363.75, "text": "刘备是否真的给朝廷上过密奏"}, {"start": 364.27, "end": 367.03, "text": "诬陷我家主公有不臣之智"}, {"start": 367.43, "end": 368.79, "text": "这尚且不清"}, {"start": 369.39, "end": 369.87, "text": "其二"}, {"start": 370.43, "end": 372.83, "text": "就算刘备给朝廷上过密奏"}, {"start": 373.47, "end": 377.47, "text": "曹操为何要将此事通报给我家主公"}, {"start": 377.99, "end": 379.43, "text": "其用意何在"}, {"start": 380.59, "end": 382.31, "text": "我家主公也不清楚"}, {"start": 383.15, "end": 383.79, "text": "其三"}, {"start": 384.31, "end": 386.07, "text": "曹操和刘备之间"}, {"start": 386.43, "end": 389.43, "text": "彼此交恶 要害在何处"}, {"start": 391.78, "end": 392.62, "text": "先生"}, {"start": 393.46, "end": 394.7, "text": "你的意思是"}, {"start": 395.02, "end": 396.66, "text": "要害是徐州"}, {"start": 397.26, "end": 398.9, "text": "刘备区区之辈"}, {"start": 399.34, "end": 401.5, "text": "得以偌大徐州之城"}, {"start": 401.66, "end": 403.22, "text": "并兼六军之地"}, {"start": 404.06, "end": 407.86, "text": "这是让天下诸侯都非常眼红的事"}, {"start": 408.5, "end": 411.26, "text": "最为怒恨的就属曹操"}, {"start": 411.26, "end": 415.14, "text": "现在刘备和吕布两人联手"}, {"start": 415.46, "end": 417.18, "text": "共守徐州"}, {"start": 417.18, "end": 419.26, "text": "那是兵强马壮啊"}, {"start": 419.5, "end": 422.78, "text": "曹操他是想攻则不敢"}, {"start": 423.02, "end": 425.26, "text": "欲弃又不舍"}, {"start": 425.9, "end": 426.54, "text": "怎么办"}, {"start": 428.18, "end": 429.02, "text": "怎么办呢"}, {"start": 429.78, "end": 433.38, "text": "他就想挑动主公和刘备打起来"}, {"start": 433.38, "end": 434.94, "text": "弄得两败俱伤"}, {"start": 434.94, "end": 436.74, "text": "他好从宗牟利"}, {"start": 437.26, "end": 439.34, "text": "如果主公败给刘备"}, {"start": 439.34, "end": 440.94, "text": "不 主公败给刘备"}, {"start": 440.94, "end": 442.66, "text": "不 那是万不可能的"}, {"start": 442.66, "end": 444.98, "text": "那他就是去南洋"}, {"start": 444.98, "end": 447.38, "text": "如果刘备败给主公"}, {"start": 447.38, "end": 449.86, "text": "他就是去徐州"}, {"start": 450.34, "end": 453.73, "text": "先生说得极是啊"}, {"start": 455.33, "end": 456.93, "text": "那我该怎么办呢"}, {"start": 457.77, "end": 458.77, "text": "敢问主公"}, {"start": 459.21, "end": 461.29, "text": "你想不想去徐州"}, {"start": 461.29, "end": 462.33, "text": "想啊"}, {"start": 463.53, "end": 464.77, "text": "我天天在想"}, {"start": 464.77, "end": 466.37, "text": "我朝思暮想啊"}, {"start": 466.37, "end": 468.37, "text": "那就趁势去徐州"}, {"start": 468.93, "end": 470.05, "text": "在下有一计"}, {"start": 470.37, "end": 473.29, "text": "可使主公轻娶徐州"}, {"start": 473.29, "end": 474.29, "text": "先生快讲"}, {"start": 476.3, "end": 477.82, "text": "吕布虽然骁勇"}, {"start": 477.82, "end": 480.02, "text": "他却是三姓的家奴"}, {"start": 480.02, "end": 482.34, "text": "其姓多变而又贪婪"}, {"start": 482.34, "end": 484.46, "text": "他和刘备同处一城"}, {"start": 484.46, "end": 486.22, "text": "如出水火"}, {"start": 486.22, "end": 488.82, "text": "如果主公汇他以黄金万两"}, {"start": 488.82, "end": 490.26, "text": "锦缎千匹"}, {"start": 490.26, "end": 492.9, "text": "令他暗中偷袭刘备"}, {"start": 492.9, "end": 495.38, "text": "主公到时出兵相迎"}, {"start": 495.38, "end": 497.9, "text": "如此定能大功告成"}, {"start": 498.58, "end": 500.38, "text": "事成之后嘛"}, {"start": 500.42, "end": 502.94, "text": "主公把徐州下的两个郡"}, {"start": 502.94, "end": 504.54, "text": "赏给他就足够了"}, {"start": 505.46, "end": 506.78, "text": "再以后嘛"}, {"start": 506.78, "end": 509.26, "text": "主公找个机会灭了他"}, {"start": 509.26, "end": 512.26, "text": "那不是易如反掌吗"}, {"start": 517.41, "end": 519.61, "text": "主公意下如何"}, {"start": 520.73, "end": 521.33, "text": "好"}, {"start": 522.21, "end": 522.73, "text": "好"}, {"start": 531.18, "end": 533.14, "text": "这是大哥的座位"}, {"start": 544.54, "end": 545.42, "text": "将军将军"}, {"start": 545.74, "end": 546.3, "text": "来了"}, {"start": 549.14, "end": 549.82, "text": "来了"}, {"start": 550.22, "end": 550.86, "text": "听着"}, {"start": 551.78, "end": 554.7, "text": "我大哥把这徐州城交给我了"}, {"start": 555.22, "end": 558.58, "text": "临行前给我留下了三条军令"}, {"start": 559.62, "end": 562.18, "text": "这第一不可饮酒治罪"}, {"start": 562.58, "end": 565.38, "text": "第二不可暴怒任性"}, {"start": 565.98, "end": 568.5, "text": "第三不可打骂军师"}, {"start": 569.78, "end": 572.82, "text": "我要你把这三条军令写成中堂"}, {"start": 573.18, "end": 575.18, "text": "悬于这个大梁之上"}, {"start": 576.74, "end": 578.66, "text": "我要天天看"}, {"start": 579.46, "end": 580.5, "text": "夜夜相"}, {"start": 581.42, "end": 582.62, "text": "严守不误"}, {"start": 584.86, "end": 585.66, "text": "好"}, {"start": 586.38, "end": 586.9, "text": "对了"}, {"start": 587.22, "end": 590.18, "text": "每一个字都要给我写得碗口那么大"}, {"start": 590.5, "end": 591.94, "text": "要碗口那么大"}, {"start": 592.7, "end": 593.66, "text": "废话"}, {"start": 594.1, "end": 595.34, "text": "按张妃的字"}, {"start": 595.34, "end": 596.58, "text": "那就得碗口那么大"}, {"start": 597.06, "end": 597.62, "text": "是是"}, {"start": 598.94, "end": 599.7, "text": "碗口那么大"}, {"start": 601.82, "end": 603.02, "text": "这写好之后"}, {"start": 603.66, "end": 604.82, "text": "悬于梁上"}, {"start": 605.1, "end": 607.66, "text": "再去传统领以上的将领"}, {"start": 608.42, "end": 609.46, "text": "华庭相见"}, {"start": 609.74, "end": 610.14, "text": "是"}, {"start": 610.14, "end": 610.9, "text": "我要训话"}, {"start": 612.34, "end": 612.9, "text": "对了"}, {"start": 613.5, "end": 615.38, "text": "你再去给我准备好"}, {"start": 615.38, "end": 616.9, "text": "按张妃酿的梅酒"}, {"start": 616.9, "end": 617.54, "text": "无事诞"}, {"start": 617.86, "end": 618.3, "text": "是"}, {"start": 619.22, "end": 619.82, "text": "将军"}, {"start": 620.78, "end": 622.26, "text": "你刚才讲的话"}, {"start": 622.7, "end": 623.78, "text": "怎么忘了"}, {"start": 624.42, "end": 626.46, "text": "那主公留下的第一条军令"}, {"start": 626.46, "end": 628.06, "text": "就是不许饮酒啊"}, {"start": 630.53, "end": 631.33, "text": "你废话"}, {"start": 631.69, "end": 632.53, "text": "我叫你去办"}, {"start": 632.53, "end": 633.17, "text": "就去办"}, {"start": 633.17, "end": 633.85, "text": "是是"}, {"start": 633.85, "end": 634.73, "text": "小的遵命"}, {"start": 635.85, "end": 636.45, "text": "遵命"}, {"start": 636.81, "end": 664.78, "text": "我担心三弟会罪就无事"}, {"start": 666.38, "end": 667.34, "text": "我也担心"}, {"start": 667.94, "end": 669.3, "text": "不过反过来一想"}, {"start": 669.74, "end": 671.74, "text": "易德如果连酒饮都扛不住"}, {"start": 672.02, "end": 673.38, "text": "日后如何成大事"}, {"start": 673.9, "end": 676.06, "text": "所以还是让他历练一下吧"}, {"start": 676.06, "end": 677.62, "text": "前后不过几十天嘛"}, {"start": 678.5, "end": 679.02, "text": "是"}, {"start": 679.98, "end": 681.5, "text": "其实我更担心的"}, {"start": 681.5, "end": 682.42, "text": "还不是易德"}, {"start": 682.86, "end": 683.78, "text": "而是吕布"}, {"start": 684.46, "end": 685.26, "text": "我听说"}, {"start": 685.58, "end": 687.38, "text": "他与成功助手小配后"}, {"start": 687.74, "end": 689.46, "text": "天天都在招兵卖马"}, {"start": 691.2, "end": 691.72, "text": "大哥"}, {"start": 692.04, "end": 693.44, "text": "吕布是头恶虎"}, {"start": 694.68, "end": 695.84, "text": "早晚要生事"}, {"start": 695.88, "end": 698.28, "text": "你应该把他逐出徐州"}, {"start": 698.72, "end": 700.0, "text": "我以仁义待他"}, {"start": 700.44, "end": 701.76, "text": "只盼他不要负我"}, {"start": 702.76, "end": 704.0, "text": "他要是负你呢"}, {"start": 705.32, "end": 706.52, "text": "他负我是他"}, {"start": 707.04, "end": 708.24, "text": "我不负仁义"}, {"start": 718.98, "end": 719.7, "text": "先生啊"}, {"start": 720.3, "end": 722.06, "text": "袁硕既送我黄金万两"}, {"start": 722.06, "end": 723.1, "text": "私筹千匹"}, {"start": 723.5, "end": 724.5, "text": "又发兵助我"}, {"start": 725.06, "end": 727.22, "text": "这可是谋取徐州的大好时机啊"}, {"start": 731.92, "end": 732.8, "text": "好是好啊"}, {"start": 733.84, "end": 736.32, "text": "可是徐州城哪那么容易攻取"}, {"start": 737.56, "end": 738.16, "text": "关羽"}, {"start": 738.44, "end": 739.64, "text": "张飞 赵云"}, {"start": 740.32, "end": 742.4, "text": "他们之勇可都不在将军之下"}, {"start": 744.16, "end": 745.0, "text": "怕什么"}, {"start": 745.88, "end": 747.56, "text": "我有赤兔马方天化际"}, {"start": 747.76, "end": 748.8, "text": "何惧于天下"}, {"start": 750.98, "end": 752.14, "text": "我们现在最需要的"}, {"start": 752.66, "end": 753.94, "text": "就是一座城池"}, {"start": 754.66, "end": 756.22, "text": "总不能老是寄人篱下吧"}, {"start": 759.01, "end": 759.93, "text": "说不定哪一天"}, {"start": 760.53, "end": 761.53, "text": "我跟刘备闹翻了"}, {"start": 761.53, "end": 762.61, "text": "反目成仇怎么办"}, {"start": 763.13, "end": 764.37, "text": "还不如先下手为强"}, {"start": 766.41, "end": 766.77, "text": "这样"}, {"start": 767.49, "end": 768.37, "text": "我的意思是"}, {"start": 768.81, "end": 769.57, "text": "这件事情"}, {"start": 769.93, "end": 771.17, "text": "我们还是要慎重一些"}, {"start": 771.53, "end": 773.41, "text": "不妨我们先答应袁硕"}, {"start": 773.89, "end": 775.17, "text": "让他把黄金筹断"}, {"start": 775.37, "end": 776.17, "text": "先送过来"}, {"start": 777.05, "end": 778.25, "text": "至于攻打徐州城"}, {"start": 779.05, "end": 780.49, "text": "我们可以再找时机"}, {"start": 783.31, "end": 783.71, "text": "好"}, {"start": 793.44, "end": 794.12, "text": "该你了"}, {"start": 796.16, "end": 797.4, "text": "末将不能喝酒"}, {"start": 797.4, "end": 798.36, "text": "一口下去"}, {"start": 798.68, "end": 800.0, "text": "肚子就痛如刀尖"}, {"start": 800.4, "end": 801.4, "text": "真不能喝"}, {"start": 802.84, "end": 804.68, "text": "你这个混账东西"}, {"start": 806.24, "end": 808.48, "text": "这美酒是包治百病"}, {"start": 809.36, "end": 810.56, "text": "哪有肚子痛的"}, {"start": 812.0, "end": 813.12, "text": "这特别是我"}, {"start": 813.12, "end": 814.04, "text": "张飞的酒"}, {"start": 815.64, "end": 817.0, "text": "那能强身健体"}, {"start": 817.32, "end": 819.0, "text": "才给我龙干凤挡呢"}, {"start": 823.37, "end": 824.09, "text": "你要不喝"}, {"start": 824.41, "end": 825.97, "text": "便是犯了我的军令了"}, {"start": 826.61, "end": 827.05, "text": "喝"}, {"start": 827.73, "end": 828.13, "text": "喝"}, {"start": 829.09, "end": 829.69, "text": "喝"}, {"start": 830.29, "end": 831.37, "text": "大狗喝"}, {"start": 831.61, "end": 836.3, "text": "你这喝猫尿呢"}, {"start": 838.3, "end": 838.9, "text": "大狗喝"}, {"start": 839.42, "end": 840.22, "text": "给我喝酒了"}, {"start": 841.06, "end": 842.26, "text": "末将万万喝不得"}, {"start": 842.5, "end": 843.66, "text": "喝了非死不可"}, {"start": 846.46, "end": 848.38, "text": "那你这就是犯了我的军令了"}, {"start": 848.78, "end": 849.98, "text": "要么罚九十万"}, {"start": 850.38, "end": 851.62, "text": "要么打一百军仗"}, {"start": 853.14, "end": 854.3, "text": "你自个儿选一样吧"}, {"start": 855.22, "end": 855.9, "text": "张将军"}, {"start": 855.9, "end": 857.58, "text": "张将军饶了末将吧"}, {"start": 858.18, "end": 859.62, "text": "求您看在我表哥的份上"}, {"start": 859.78, "end": 860.7, "text": "饶了我吧"}, {"start": 861.5, "end": 862.02, "text": "得"}, {"start": 863.78, "end": 864.82, "text": "你找过来"}, {"start": 865.3, "end": 866.26, "text": "是何学人哪"}, {"start": 867.06, "end": 868.94, "text": "我表哥就是上将军女部啊"}, {"start": 869.46, "end": 870.66, "text": "他跟你大哥刘备"}, {"start": 870.98, "end": 871.78, "text": "亲如相依"}, {"start": 871.78, "end": 872.82, "text": "你放屁"}, {"start": 876.98, "end": 877.62, "text": "大军"}, {"start": 878.42, "end": 879.34, "text": "将军 将军"}, {"start": 879.78, "end": 882.34, "text": "女部岂能与我大哥做兄弟"}, {"start": 885.02, "end": 886.06, "text": "你小子"}, {"start": 886.38, "end": 887.94, "text": "今儿不仅犯了你的军令"}, {"start": 889.66, "end": 892.14, "text": "还拿女部那事来唬骗"}, {"start": 892.58, "end": 893.5, "text": "没有 没有"}, {"start": 893.9, "end": 894.38, "text": "好"}, {"start": 895.22, "end": 896.58, "text": "今儿我偏偏要打你"}, {"start": 897.18, "end": 899.34, "text": "打你就是打那贼女部"}, {"start": 900.14, "end": 900.54, "text": "将军"}, {"start": 900.82, "end": 901.62, "text": "将军 将军"}, {"start": 901.9, "end": 902.3, "text": "将军"}, {"start": 903.26, "end": 903.7, "text": "将军"}, {"start": 904.62, "end": 907.46, "text": "将军 让我"}, {"start": 907.86, "end": 908.26, "text": "将军"}, {"start": 908.54, "end": 909.1, "text": "将军"}, {"start": 909.1, "end": 909.54, "text": "将军 将军"}, {"start": 909.54, "end": 910.18, "text": "将军 将军"}, {"start": 910.18, "end": 910.7, "text": "将军 将军"}, {"start": 910.7, "end": 911.34, "text": "将军 将军"}, {"start": 911.34, "end": 911.98, "text": "将军 将军"}, {"start": 911.98, "end": 912.5, "text": "将军 将军"}, {"start": 912.5, "end": 912.94, "text": "将军"}, {"start": 912.94, "end": 914.02, "text": "男子汉大丈夫"}, {"start": 914.7, "end": 916.14, "text": "岂能讨教求饶"}, {"start": 916.62, "end": 918.02, "text": "你应该说我打得好"}, {"start": 918.7, "end": 919.3, "text": "要不然"}, {"start": 919.54, "end": 920.94, "text": "我打死你这个贼女部"}, {"start": 921.5, "end": 922.62, "text": "你也打得好"}, {"start": 923.02, "end": 923.7, "text": "将军"}, {"start": 925.02, "end": 926.18, "text": "那就对了嘛"}, {"start": 927.26, "end": 927.66, "text": "说"}, {"start": 928.06, "end": 929.02, "text": "你还在打谁啊"}, {"start": 929.62, "end": 930.78, "text": "将军在打"}, {"start": 931.54, "end": 933.46, "text": "贼将草包"}, {"start": 933.46, "end": 933.98, "text": "放屁"}, {"start": 934.74, "end": 935.94, "text": "你还在打贼女部"}, {"start": 936.62, "end": 937.94, "text": "谁在打女部"}, {"start": 937.98, "end": 938.9, "text": "在打贼女部"}, {"start": 938.9, "end": 939.38, "text": "谁在打女部"}, {"start": 939.38, "end": 939.98, "text": "说呀"}, {"start": 942.3, "end": 942.78, "text": "错了"}, {"start": 943.42, "end": 944.1, "text": "不是女部"}, {"start": 944.74, "end": 945.94, "text": "是贼女部"}, {"start": 946.58, "end": 947.14, "text": "贼女部"}, {"start": 947.14, "end": 948.18, "text": "在打贼女部"}, {"start": 948.66, "end": 949.82, "text": "贼女部"}, {"start": 951.18, "end": 951.86, "text": "这就对了"}, {"start": 952.86, "end": 954.06, "text": "你打得好不好啊"}, {"start": 954.06, "end": 954.5, "text": "好"}, {"start": 958.1, "end": 958.66, "text": "上将军"}, {"start": 958.9, "end": 959.86, "text": "徐州城守曹报"}, {"start": 959.86, "end": 960.58, "text": "逮上来投"}, {"start": 961.42, "end": 962.06, "text": "曹报"}, {"start": 965.3, "end": 966.1, "text": "他是我表弟"}, {"start": 967.18, "end": 967.46, "text": "快"}, {"start": 967.86, "end": 968.42, "text": "快请进来"}, {"start": 978.02, "end": 978.7, "text": "表哥"}, {"start": 979.5, "end": 981.18, "text": "你要为我报仇啊"}, {"start": 982.14, "end": 982.58, "text": "兄弟"}, {"start": 983.34, "end": 983.94, "text": "出什么事了"}, {"start": 984.42, "end": 985.7, "text": "那批傅张飞"}, {"start": 986.66, "end": 987.7, "text": "解救发围"}, {"start": 987.7, "end": 989.5, "text": "把我打得死去活来"}, {"start": 990.86, "end": 991.66, "text": "我求他说"}, {"start": 991.66, "end": 993.06, "text": "看我表哥的面子上"}, {"start": 993.06, "end": 993.9, "text": "饶我一命"}, {"start": 994.82, "end": 996.22, "text": "他问我表哥是谁"}, {"start": 996.78, "end": 998.3, "text": "我说是上将军吕布"}, {"start": 998.7, "end": 1000.22, "text": "批傅顿时大怒"}, {"start": 1001.14, "end": 1002.9, "text": "说表哥你是贱贼"}, {"start": 1003.18, "end": 1004.54, "text": "是三姓家奴"}, {"start": 1004.82, "end": 1005.74, "text": "还说打我"}, {"start": 1005.74, "end": 1007.02, "text": "便是打贼女部"}, {"start": 1007.74, "end": 1010.74, "text": "只把我打得死去活来啊"}, {"start": 1015.3, "end": 1016.66, "text": "这张飞欺人太甚"}, {"start": 1018.02, "end": 1019.5, "text": "他误入过我好几回了"}, {"start": 1020.22, "end": 1021.18, "text": "这次我绝不饶他"}, {"start": 1022.06, "end": 1022.54, "text": "来人呐"}, {"start": 1022.9, "end": 1023.18, "text": "在"}, {"start": 1024.46, "end": 1025.86, "text": "快备马去我方天化祭"}, {"start": 1026.46, "end": 1026.74, "text": "诺"}, {"start": 1027.38, "end": 1027.78, "text": "先吧"}, {"start": 1029.8, "end": 1030.24, "text": "冯显"}, {"start": 1031.2, "end": 1031.92, "text": "先不要着急"}, {"start": 1035.19, "end": 1035.59, "text": "曹报"}, {"start": 1036.27, "end": 1036.55, "text": "来"}, {"start": 1040.18, "end": 1040.7, "text": "慢慢说"}, {"start": 1041.82, "end": 1042.98, "text": "张飞为什么要打你"}, {"start": 1043.62, "end": 1045.18, "text": "是不是你违反了什么军令"}, {"start": 1046.1, "end": 1047.86, "text": "张飞非要逼我喝酒"}, {"start": 1048.54, "end": 1050.06, "text": "莫叫平生寄酒"}, {"start": 1050.82, "end": 1052.54, "text": "不敢喝他便打我"}, {"start": 1052.98, "end": 1053.78, "text": "我没有听明白"}, {"start": 1054.66, "end": 1056.14, "text": "张飞为什么要逼你喝酒"}, {"start": 1057.14, "end": 1058.38, "text": "因为刘备给张飞"}, {"start": 1058.38, "end": 1059.5, "text": "下了三道军令"}, {"start": 1059.98, "end": 1061.66, "text": "头一条便是不能饮酒"}, {"start": 1062.14, "end": 1062.7, "text": "你说什么"}, {"start": 1063.66, "end": 1065.78, "text": "刘备给张飞下了禁酒令"}, {"start": 1067.02, "end": 1067.34, "text": "为什么"}, {"start": 1068.14, "end": 1068.9, "text": "因为刘备"}, {"start": 1069.22, "end": 1070.7, "text": "率军去征讨袁术"}, {"start": 1071.66, "end": 1073.02, "text": "城里就剩下张飞"}, {"start": 1073.5, "end": 1075.26, "text": "刘备怕张飞饮酒误事"}, {"start": 1075.98, "end": 1077.46, "text": "所以才给他下了禁酒令"}, {"start": 1077.78, "end": 1079.02, "text": "刘备率军出征了"}, {"start": 1080.22, "end": 1080.78, "text": "此事当真"}, {"start": 1081.5, "end": 1082.34, "text": "千指万确"}, {"start": 1082.74, "end": 1083.58, "text": "昨天出发的"}, {"start": 1084.5, "end": 1085.66, "text": "关于赵云同行"}, {"start": 1089.74, "end": 1091.3, "text": "那为什么寻旧城上"}, {"start": 1091.3, "end": 1093.06, "text": "关照二将的将棋还在"}, {"start": 1093.74, "end": 1094.9, "text": "那是虚张声势"}, {"start": 1095.74, "end": 1097.7, "text": "其实现在城里只有五六千"}, {"start": 1097.7, "end": 1098.5, "text": "老弱守军"}, {"start": 1099.3, "end": 1100.82, "text": "外带一个匹夫张飞"}, {"start": 1109.25, "end": 1109.61, "text": "冯显"}, {"start": 1110.73, "end": 1111.33, "text": "时机到了"}, {"start": 1112.17, "end": 1113.89, "text": "上天赐徐州城于你"}, {"start": 1114.53, "end": 1115.53, "text": "如若我们不去"}, {"start": 1116.17, "end": 1117.73, "text": "那真是有负苍天哪"}, {"start": 1119.98, "end": 1120.38, "text": "好"}, {"start": 1121.74, "end": 1122.66, "text": "我亲自领军"}, {"start": 1123.18, "end": 1124.02, "text": "直取徐州"}, {"start": 1124.46, "end": 1124.66, "text": "不"}, {"start": 1125.7, "end": 1126.98, "text": "徐州城坚固无比"}, {"start": 1127.46, "end": 1128.38, "text": "如果没有内应"}, {"start": 1128.82, "end": 1129.58, "text": "断难攻去"}, {"start": 1131.62, "end": 1131.94, "text": "蔡宝"}, {"start": 1132.5, "end": 1133.74, "text": "你愿不愿意立一大功"}, {"start": 1135.1, "end": 1137.54, "text": "吕将军定会上奏朝廷"}, {"start": 1138.02, "end": 1140.02, "text": "代你为中郎将赐决封号"}, {"start": 1141.58, "end": 1142.18, "text": "末将愿意"}, {"start": 1142.78, "end": 1143.02, "text": "好"}, {"start": 1143.86, "end": 1144.58, "text": "你作为内应"}, {"start": 1144.9, "end": 1145.98, "text": "马上赶回徐州城"}, {"start": 1146.9, "end": 1147.78, "text": "今夜四更"}, {"start": 1148.3, "end": 1149.06, "text": "看到火起"}, {"start": 1149.74, "end": 1150.78, "text": "打开南城门"}, {"start": 1151.98, "end": 1152.58, "text": "末将遵命"}, {"start": 1152.86, "end": 1153.14, "text": "是吧"}, {"start": 1174.53, "end": 1175.89, "text": "的确是虚张声势啊"}, {"start": 1177.37, "end": 1179.49, "text": "徐州城已经近乎空城"}, {"start": 1182.76, "end": 1183.08, "text": "发令"}, {"start": 1214.14, "end": 1215.1, "text": "你快醒醒啊 将军"}, {"start": 1215.42, "end": 1216.34, "text": "将军 将军"}, {"start": 1216.82, "end": 1218.34, "text": "将军 敌军进城了 将军"}, {"start": 1219.42, "end": 1219.7, "text": "将军"}, {"start": 1220.22, "end": 1220.9, "text": "将军 来"}, {"start": 1221.42, "end": 1221.7, "text": "将军"}, {"start": 1222.94, "end": 1223.22, "text": "将军"}, {"start": 1223.42, "end": 1223.82, "text": "我没罪"}, {"start": 1223.82, "end": 1224.82, "text": "吕布偷袭徐州"}, {"start": 1225.1, "end": 1226.5, "text": "曹芳 曹芳打开南门"}, {"start": 1226.66, "end": 1227.78, "text": "迎吕布进城了"}, {"start": 1229.38, "end": 1229.74, "text": "什么"}, {"start": 1230.78, "end": 1231.9, "text": "曹芳打开南门"}, {"start": 1232.34, "end": 1233.5, "text": "迎吕布进城了"}, {"start": 1235.82, "end": 1236.14, "text": "将军"}, {"start": 1236.74, "end": 1237.06, "text": "将军"}, {"start": 1238.7, "end": 1239.7, "text": "吕布进城了"}, {"start": 1240.02, "end": 1240.66, "text": "是 将军"}, {"start": 1240.94, "end": 1241.34, "text": "这会儿"}, {"start": 1241.74, "end": 1243.5, "text": "吕布已经把城中各处要寨"}, {"start": 1243.62, "end": 1244.46, "text": "全都给占领了"}, {"start": 1245.26, "end": 1246.14, "text": "传令迎敌"}, {"start": 1246.82, "end": 1247.62, "text": "取我兵器来"}, {"start": 1248.1, "end": 1248.46, "text": "遵命"}, {"start": 1248.86, "end": 1300.41, "text": "吕王 请主来"}, {"start": 1300.41, "end": 1300.57, "text": "吕王 请主来"}, {"start": 1300.57, "end": 1300.65, "text": "吕王 请主来"}, {"start": 1300.65, "end": 1300.69, "text": "吕王 请主来"}, {"start": 1300.69, "end": 1300.73, "text": "吕王 请主来"}, {"start": 1300.73, "end": 1300.77, "text": "吕王 请主来"}, {"start": 1300.77, "end": 1302.66, "text": "吕王 请主来"}, {"start": 1302.66, "end": 1302.7, "text": "吕王 请主来"}, {"start": 1302.7, "end": 1302.74, "text": "吕王 请主来"}, {"start": 1302.74, "end": 1302.78, "text": "吕王 请主来"}, {"start": 1302.78, "end": 1302.86, "text": "吕王 请主来"}, {"start": 1302.86, "end": 1303.22, "text": "吕王 请主来"}, {"start": 1321.27, "end": 1321.83, "text": "军师"}, {"start": 1324.41, "end": 1324.85, "text": "军师"}, {"start": 1325.65, "end": 1326.41, "text": "我们的部下"}, {"start": 1326.57, "end": 1327.53, "text": "搜到刘备的住宅"}, {"start": 1328.09, "end": 1329.01, "text": "他的器械在里面"}, {"start": 1329.37, "end": 1330.01, "text": "如何处置"}, {"start": 1332.47, "end": 1332.79, "text": "听令"}, {"start": 1334.15, "end": 1335.63, "text": "你等一定要严加抗补"}, {"start": 1335.83, "end": 1336.71, "text": "任何人不得进入"}, {"start": 1337.19, "end": 1337.83, "text": "所有工资"}, {"start": 1338.11, "end": 1338.95, "text": "一概不得短缺"}, {"start": 1339.43, "end": 1340.47, "text": "围城立诈"}, {"start": 1341.43, "end": 1341.79, "text": "遵命"}, {"start": 1369.73, "end": 1370.21, "text": "少将军"}, {"start": 1371.25, "end": 1372.49, "text": "东屯粮仓的粮食"}, {"start": 1372.81, "end": 1373.49, "text": "颗粒不少"}, {"start": 1374.21, "end": 1376.05, "text": "刘备的两万余担军粮"}, {"start": 1376.61, "end": 1377.69, "text": "全都归我们了"}, {"start": 1378.73, "end": 1379.01, "text": "好"}, {"start": 1379.97, "end": 1380.45, "text": "少将军"}, {"start": 1380.97, "end": 1382.13, "text": "北大营不占自降"}, {"start": 1382.41, "end": 1383.77, "text": "获得战马五百余品"}, {"start": 1384.05, "end": 1384.33, "text": "好"}, {"start": 1384.93, "end": 1385.41, "text": "少将军"}, {"start": 1385.57, "end": 1386.25, "text": "陶天的儿子"}, {"start": 1386.33, "end": 1387.41, "text": "也率旧部归降了"}, {"start": 1387.85, "end": 1388.25, "text": "好"}, {"start": 1393.61, "end": 1395.09, "text": "一不可饮酒治罪"}, {"start": 1395.41, "end": 1397.05, "text": "二不可暴怒任性"}, {"start": 1397.45, "end": 1398.85, "text": "三不可打骂军事"}, {"start": 1401.41, "end": 1403.05, "text": "这个易德真是可爱呀"}, {"start": 1403.85, "end": 1404.77, "text": "可爱至极呀"}, {"start": 1405.41, "end": 1405.97, "text": "一碗酒"}, {"start": 1405.97, "end": 1407.05, "text": "就把三条军令"}, {"start": 1407.05, "end": 1407.85, "text": "全都违反了"}, {"start": 1408.17, "end": 1409.81, "text": "还外搭了一座徐州城啊"}, {"start": 1412.25, "end": 1412.61, "text": "先生"}, {"start": 1413.49, "end": 1414.17, "text": "徐州已经"}, {"start": 1414.17, "end": 1415.49, "text": "完全落入我们手里了"}, {"start": 1416.05, "end": 1417.25, "text": "各处守军都降了"}, {"start": 1418.97, "end": 1419.65, "text": "祝贺将军"}, {"start": 1423.14, "end": 1424.06, "text": "不过有件事情"}, {"start": 1424.3, "end": 1425.38, "text": "你可能已经忘记了吧"}, {"start": 1428.14, "end": 1428.5, "text": "何时"}, {"start": 1429.5, "end": 1431.26, "text": "现在可以立即通知袁硕"}, {"start": 1431.94, "end": 1433.02, "text": "按照先前的约定"}, {"start": 1433.66, "end": 1434.86, "text": "我们已经取下徐州"}, {"start": 1435.34, "end": 1436.5, "text": "他应该给我们送来"}, {"start": 1436.7, "end": 1437.66, "text": "万两黄金"}, {"start": 1437.66, "end": 1439.22, "text": "千批绸缎才对啊"}, {"start": 1441.63, "end": 1441.91, "text": "对"}, {"start": 1443.15, "end": 1444.71, "text": "我们可是双喜临门"}, {"start": 1444.99, "end": 1445.91, "text": "一剑双雕啊"}, {"start": 1450.07, "end": 1458.99, "text": "三弟不要再哭了"}, {"start": 1460.47, "end": 1462.03, "text": "徐州原本就不是我们的"}, {"start": 1462.83, "end": 1463.79, "text": "得何足喜"}, {"start": 1464.11, "end": 1465.15, "text": "是何足忧"}, {"start": 1465.67, "end": 1466.27, "text": "天意"}, {"start": 1469.06, "end": 1470.26, "text": "一切皆是天意"}, {"start": 1471.9, "end": 1472.42, "text": "三弟"}, {"start": 1473.38, "end": 1474.22, "text": "曹操何在"}, {"start": 1474.74, "end": 1479.59, "text": "都现在成立了"}, {"start": 1479.99, "end": 1486.14, "text": "当初你是怎么说的"}, {"start": 1486.7, "end": 1488.22, "text": "哥哥又是怎么吩咐你的"}, {"start": 1489.18, "end": 1489.9, "text": "现在"}, {"start": 1490.1, "end": 1491.42, "text": "丢了城池不说"}, {"start": 1492.1, "end": 1492.98, "text": "二位曹操"}, {"start": 1493.22, "end": 1494.94, "text": "也落入了贼兵之手"}, {"start": 1494.94, "end": 1496.26, "text": "你有何面不见了呀"}, {"start": 1498.66, "end": 1499.1, "text": "三弟"}, {"start": 1499.1, "end": 1499.86, "text": "父母活了"}, {"start": 1499.86, "end": 1500.34, "text": "三弟"}, {"start": 1500.34, "end": 1507.22, "text": "三弟"}, {"start": 1509.54, "end": 1510.86, "text": "江山已清复"}, {"start": 1524.41, "end": 1525.65, "text": "谁家不遭殃"}, {"start": 1526.21, "end": 1527.69, "text": "我们三人桃园节一时"}, {"start": 1527.93, "end": 1529.09, "text": "立下过誓言"}, {"start": 1530.13, "end": 1532.17, "text": "不求同年同月同日生"}, {"start": 1532.61, "end": 1534.49, "text": "但求同年同月同日死"}, {"start": 1534.81, "end": 1536.45, "text": "不过再有此等余局"}, {"start": 1537.01, "end": 1539.68, "text": "为兄绝不独生"}, {"start": 1540.2, "end": 1540.72, "text": "主公"}, {"start": 1541.12, "end": 1541.88, "text": "少纪来报"}, {"start": 1542.2, "end": 1561.48, "text": "袁叔派上将纪灵"}, {"start": 1561.8, "end": 1563.28, "text": "率十五万大军前来征讨"}, {"start": 1563.68, "end": 1564.84, "text": "据此不到十里了"}, {"start": 1565.16, "end": 1566.56, "text": "前有袁叔大军"}, {"start": 1567.44, "end": 1574.94, "text": "后有攀降吕布"}, {"start": 1575.34, "end": 1577.42, "text": "无处容身 进退两难"}, {"start": 1580.27, "end": 1581.31, "text": "难道上天"}, {"start": 1582.31, "end": 1583.63, "text": "真的要绝我吗"}, {"start": 1584.75, "end": 1585.27, "text": "大哥"}, {"start": 1585.63, "end": 1587.59, "text": "我率军迎战纪灵"}, {"start": 1588.67, "end": 1590.07, "text": "你固然勇猛无敌"}, {"start": 1591.27, "end": 1593.03, "text": "但是徐州失线的消息"}, {"start": 1593.51, "end": 1594.79, "text": "已经在军中弥漫"}, {"start": 1594.79, "end": 1595.71, "text": "兵无斗志"}, {"start": 1596.39, "end": 1597.39, "text": "不可再战了"}, {"start": 1597.87, "end": 1598.87, "text": "那主公准备怎么办"}, {"start": 1599.51, "end": 1600.11, "text": "回徐州"}, {"start": 1603.78, "end": 1610.59, "text": "徐州已落入了吕布手里"}, {"start": 1611.03, "end": 1614.74, "text": "大哥你还要他回来吗"}, {"start": 1616.26, "end": 1617.58, "text": "我没打算要回徐州"}, {"start": 1617.9, "end": 1618.66, "text": "也不可能"}, {"start": 1619.58, "end": 1620.1, "text": "不过"}, {"start": 1620.26, "end": 1622.1, "text": "我没有任何对不住吕布的地方"}, {"start": 1622.54, "end": 1623.22, "text": "相反"}, {"start": 1623.62, "end": 1625.3, "text": "吕布倒有对不住我的地方"}, {"start": 1625.62, "end": 1627.9, "text": "料想他不会去我手机吧"}, {"start": 1628.98, "end": 1630.82, "text": "我们回到徐州可以与吕布商量"}, {"start": 1631.3, "end": 1632.78, "text": "但我们必须先离开"}, {"start": 1632.78, "end": 1634.1, "text": "徐州可以与吕布商量"}, {"start": 1634.7, "end": 1635.78, "text": "徐州就归他了"}, {"start": 1636.42, "end": 1637.78, "text": "我们暂借小佩落足"}, {"start": 1638.5, "end": 1641.9, "text": "那小佩先前是讨钱借予我的"}, {"start": 1642.26, "end": 1643.58, "text": "后来我送给了她吕布"}, {"start": 1644.22, "end": 1645.46, "text": "我们现在重返小佩"}, {"start": 1646.1, "end": 1647.46, "text": "吕布为主 驻徐州"}, {"start": 1647.98, "end": 1649.7, "text": "我们为从 驻小佩"}, {"start": 1650.42, "end": 1651.94, "text": "两城互成计较之势"}, {"start": 1652.46, "end": 1653.82, "text": "共聚曹操和袁叔"}, {"start": 1654.78, "end": 1655.46, "text": "相来"}, {"start": 1656.74, "end": 1657.38, "text": "吕布"}, {"start": 1658.82, "end": 1660.22, "text": "不至于过于吝啬吧"}, {"start": 1665.44, "end": 1666.48, "text": "心太善了"}, {"start": 1668.48, "end": 1669.0, "text": "将军"}, {"start": 1670.89, "end": 1671.85, "text": "袁叔赖账"}, {"start": 1672.85, "end": 1673.37, "text": "怎么"}, {"start": 1675.09, "end": 1676.17, "text": "他在复信上说"}, {"start": 1676.37, "end": 1677.81, "text": "我们虽然攻下了徐州"}, {"start": 1677.81, "end": 1679.61, "text": "却没有取下刘备的首级"}, {"start": 1680.17, "end": 1681.93, "text": "所以不能给我们黄金绸缎"}, {"start": 1682.29, "end": 1690.35, "text": "自己言而无尽去怪我们失业"}, {"start": 1692.76, "end": 1694.76, "text": "争天下之事生死无睹"}, {"start": 1695.52, "end": 1696.6, "text": "还弹劾信义"}, {"start": 1697.56, "end": 1698.16, "text": "依我看"}, {"start": 1698.96, "end": 1700.68, "text": "即使你把刘备的脑袋砍下来"}, {"start": 1700.68, "end": 1701.36, "text": "给他送去"}, {"start": 1701.52, "end": 1703.36, "text": "他也未必会送来黄金绸缎"}, {"start": 1704.88, "end": 1706.2, "text": "他真正贪图的"}, {"start": 1707.2, "end": 1708.72, "text": "是这座徐州城啊"}, {"start": 1714.87, "end": 1715.59, "text": "禀上将军"}, {"start": 1715.67, "end": 1716.79, "text": "刘备领兵败官"}, {"start": 1719.66, "end": 1720.54, "text": "来了多少兵马"}, {"start": 1721.06, "end": 1722.22, "text": "只有刘馆长三计"}, {"start": 1723.26, "end": 1724.02, "text": "三计"}, {"start": 1724.02, "end": 1724.66, "text": "太大了"}, {"start": 1724.66, "end": 1725.18, "text": "是"}, {"start": 1728.18, "end": 1729.3, "text": "好大的胆子"}, {"start": 1731.52, "end": 1733.36, "text": "看来他们不是来攻城"}, {"start": 1733.72, "end": 1734.92, "text": "是有求于将军"}, {"start": 1743.67, "end": 1744.79, "text": "我如此待他"}, {"start": 1745.95, "end": 1747.15, "text": "他还敢来见我"}, {"start": 1749.4, "end": 1750.68, "text": "刘备到底是个君子"}, {"start": 1752.2, "end": 1753.32, "text": "我亲自出城相见"}, {"start": 1755.55, "end": 1756.03, "text": "亲们"}, {"start": 1757.35, "end": 1757.91, "text": "奉献哪"}, {"start": 1758.51, "end": 1759.47, "text": "我有话要说"}, {"start": 1801.23, "end": 1801.83, "text": "玄德"}, {"start": 1802.95, "end": 1803.79, "text": "别来无恙"}, {"start": 1812.33, "end": 1812.85, "text": "来来来"}, {"start": 1813.57, "end": 1814.21, "text": "赶快进去"}, {"start": 1814.57, "end": 1814.85, "text": "来"}, {"start": 1828.45, "end": 1828.97, "text": "玄德"}, {"start": 1830.13, "end": 1831.69, "text": "我不是要夺你的诚实"}, {"start": 1832.45, "end": 1833.73, "text": "都是因为张飞兄弟"}, {"start": 1834.25, "end": 1835.29, "text": "酒醉杀人"}, {"start": 1835.65, "end": 1836.73, "text": "导致军心混乱"}, {"start": 1838.61, "end": 1840.45, "text": "我怕他误了守城大事"}, {"start": 1841.09, "end": 1843.73, "text": "所以才引兵来这守几天徐州"}, {"start": 1849.94, "end": 1851.1, "text": "既然玄德回来了"}, {"start": 1852.1, "end": 1853.38, "text": "自然应该误归原主"}, {"start": 1855.22, "end": 1856.02, "text": "请玄德"}, {"start": 1856.74, "end": 1857.86, "text": "收下徐州官方"}, {"start": 1858.78, "end": 1859.42, "text": "吕将军"}, {"start": 1861.9, "end": 1863.9, "text": "你我初次在此相见时"}, {"start": 1864.62, "end": 1866.66, "text": "在下就想将徐州让给你了"}, {"start": 1867.1, "end": 1868.62, "text": "现在事实证明"}, {"start": 1869.18, "end": 1870.74, "text": "在下确实无才无德"}, {"start": 1871.22, "end": 1872.38, "text": "不配拥有徐州"}, {"start": 1873.38, "end": 1874.22, "text": "今日之变"}, {"start": 1874.78, "end": 1875.78, "text": "可以说是天意"}, {"start": 1876.54, "end": 1878.82, "text": "是上天将徐州授予你"}, {"start": 1879.5, "end": 1881.42, "text": "请将军万无生意"}, {"start": 1881.58, "end": 1883.3, "text": "还是请玄德收下官方吧"}, {"start": 1883.3, "end": 1884.02, "text": "不敢不敢"}, {"start": 1884.5, "end": 1885.86, "text": "天授徐州于你"}, {"start": 1886.18, "end": 1887.94, "text": "请将军不要再生疑了"}, {"start": 1888.26, "end": 1892.72, "text": "既然如此"}, {"start": 1893.8, "end": 1895.28, "text": "我就恭敬不如从命了"}, {"start": 1895.88, "end": 1898.04, "text": "全且替玄德把守徐州"}, {"start": 1898.84, "end": 1899.44, "text": "玄德"}, {"start": 1900.68, "end": 1902.16, "text": "你自此何去何从呢"}, {"start": 1902.64, "end": 1906.35, "text": "在下"}, {"start": 1907.43, "end": 1908.95, "text": "确实是无处可去"}, {"start": 1910.63, "end": 1912.19, "text": "如吕将军允许的话"}, {"start": 1912.91, "end": 1914.79, "text": "我想赞助于小配"}, {"start": 1915.67, "end": 1916.31, "text": "这样"}, {"start": 1916.67, "end": 1917.27, "text": "这样"}, {"start": 1918.23, "end": 1920.87, "text": "也可以与徐州互为计较之势"}, {"start": 1921.51, "end": 1923.39, "text": "共同抵抗曹操元术"}, {"start": 1925.43, "end": 1926.03, "text": "玄德兄"}, {"start": 1926.55, "end": 1927.59, "text": "那怎么可以呀"}, {"start": 1928.11, "end": 1929.91, "text": "这样太委屈你了"}, {"start": 1932.32, "end": 1933.16, "text": "如蒙允许"}, {"start": 1933.64, "end": 1935.16, "text": "刘备感恩不尽"}, {"start": 1939.29, "end": 1939.85, "text": "玄德"}, {"start": 1940.97, "end": 1941.85, "text": "小配就归你了"}, {"start": 1944.56, "end": 1945.76, "text": "还是你当初那句话"}, {"start": 1946.72, "end": 1947.4, "text": "所有粮饷"}, {"start": 1948.08, "end": 1948.72, "text": "由我提供"}, {"start": 1951.86, "end": 1953.3, "text": "在下拜谢了"}, {"start": 1958.25, "end": 1959.33, "text": "只要咱俩同心"}, {"start": 1960.05, "end": 1961.13, "text": "何愁大业不成"}, {"start": 1963.19, "end": 1964.79, "text": "我们可以徐州为根据"}, {"start": 1965.63, "end": 1966.47, "text": "立兵莫马"}, {"start": 1967.83, "end": 1968.71, "text": "先取元术"}, {"start": 1969.59, "end": 1970.55, "text": "次举曹操"}, {"start": 1971.59, "end": 1973.47, "text": "再征刘表和公孙瓒"}, {"start": 1974.39, "end": 1975.31, "text": "共图天下"}, {"start": 1998.98, "end": 2000.1, "text": "刘备是位真君子"}, {"start": 2001.34, "end": 2002.3, "text": "受如此大辱"}, {"start": 2003.22, "end": 2004.22, "text": "却平静如实"}, {"start": 2005.3, "end": 2006.3, "text": "可敬可佩"}, {"start": 2011.46, "end": 2012.26, "text": "我倒觉得"}, {"start": 2013.58, "end": 2014.58, "text": "有点对不住他了"}, {"start": 2015.1, "end": 2016.18, "text": "难道你不觉得"}, {"start": 2017.14, "end": 2019.02, "text": "刘备可敬可佩之外"}, {"start": 2020.1, "end": 2021.18, "text": "更有些可怕"}, {"start": 2023.42, "end": 2024.22, "text": "先生什么意思"}, {"start": 2025.06, "end": 2027.98, "text": "徐州城乃刘备的根基之地"}, {"start": 2028.34, "end": 2029.58, "text": "将军趁其不备"}, {"start": 2029.7, "end": 2030.5, "text": "战为己有"}, {"start": 2032.1, "end": 2034.06, "text": "任何人受到这种奇耻大辱"}, {"start": 2034.5, "end": 2035.66, "text": "都是万难忍受的"}, {"start": 2037.26, "end": 2038.06, "text": "可是刘备呢"}, {"start": 2039.02, "end": 2040.42, "text": "竟然没有一句怨言"}, {"start": 2040.7, "end": 2041.66, "text": "重归小配"}, {"start": 2042.34, "end": 2045.82, "text": "替将军去看守徐州的北大门群"}, {"start": 2046.62, "end": 2048.7, "text": "什么样的人才能够做到这种"}, {"start": 2049.06, "end": 2051.14, "text": "仁耻寒愤平静如水呢"}, {"start": 2053.41, "end": 2054.81, "text": "能够如此这般者"}, {"start": 2055.65, "end": 2057.77, "text": "是何等的心胸和志向"}, {"start": 2059.9, "end": 2061.14, "text": "这种人不可怕吗"}, {"start": 2068.73, "end": 2069.45, "text": "据报"}, {"start": 2070.13, "end": 2072.45, "text": "吕布与刘备再度和好了"}, {"start": 2073.29, "end": 2076.21, "text": "徐州小配二成互为鸡角"}, {"start": 2076.81, "end": 2078.09, "text": "联手共聚"}, {"start": 2080.17, "end": 2083.09, "text": "如此下去何日可得徐州啊"}, {"start": 2084.05, "end": 2086.49, "text": "如果主公想图徐州"}, {"start": 2086.69, "end": 2090.29, "text": "那就要将刘备和吕布分而治之"}, {"start": 2090.53, "end": 2092.13, "text": "先结交吕布"}, {"start": 2092.21, "end": 2093.57, "text": "使他不缘刘备"}, {"start": 2093.65, "end": 2096.77, "text": "之后攻下小配再图徐州"}, {"start": 2099.81, "end": 2102.13, "text": "我这不是把吕布得罪了吗"}, {"start": 2103.33, "end": 2105.45, "text": "我答应他的金银绸缎"}, {"start": 2106.17, "end": 2107.25, "text": "我没给他"}, {"start": 2108.93, "end": 2112.69, "text": "主公这么做"}, {"start": 2113.33, "end": 2115.33, "text": "在下实在不甘沟通啊"}, {"start": 2116.45, "end": 2119.21, "text": "成大事者不可失信啊"}, {"start": 2119.81, "end": 2122.33, "text": "尤其是对小人不可失信"}, {"start": 2123.17, "end": 2126.77, "text": "因为小人比君子更危险"}, {"start": 2128.99, "end": 2130.31, "text": "先生说得对啊"}, {"start": 2131.59, "end": 2133.39, "text": "可我该怎么办啊"}, {"start": 2134.11, "end": 2134.75, "text": "主公啊"}, {"start": 2136.07, "end": 2138.39, "text": "吕布现在最想要的是什么"}, {"start": 2140.19, "end": 2141.35, "text": "他能想要什么"}, {"start": 2142.07, "end": 2143.03, "text": "良想呗"}, {"start": 2145.25, "end": 2147.37, "text": "他现在到处招兵买马"}, {"start": 2148.13, "end": 2150.29, "text": "到处搜刮良想"}, {"start": 2151.69, "end": 2153.01, "text": "他问主公要多少"}, {"start": 2154.09, "end": 2155.61, "text": "这小子狮子大开口"}, {"start": 2155.85, "end": 2157.69, "text": "张口就管我要十万良想"}, {"start": 2157.89, "end": 2158.89, "text": "十万哪"}, {"start": 2161.73, "end": 2162.81, "text": "给他二十万"}, {"start": 2164.45, "end": 2165.21, "text": "二十万"}, {"start": 2165.37, "end": 2167.01, "text": "对 二十万"}, {"start": 2168.49, "end": 2170.97, "text": "能买到的都是便宜货"}, {"start": 2171.97, "end": 2175.37, "text": "成大事者合力于良想"}, {"start": 2179.97, "end": 2181.45, "text": "好 我给他"}, {"start": 2186.77, "end": 2188.01, "text": "用力 用力"}, {"start": 2188.25, "end": 2189.45, "text": "获胜者有赏"}, {"start": 2196.46, "end": 2198.98, "text": "这孩子又得意忘形了"}, {"start": 2201.42, "end": 2202.82, "text": "用力 用力"}, {"start": 2205.46, "end": 2206.38, "text": "起来起来起来"}, {"start": 2207.38, "end": 2208.26, "text": "孟仙啊"}, {"start": 2208.38, "end": 2209.78, "text": "你可真够开心的"}, {"start": 2211.18, "end": 2212.42, "text": "我当然开心了"}, {"start": 2213.26, "end": 2215.42, "text": "袁术遣人送良想来了"}, {"start": 2216.82, "end": 2217.62, "text": "送了多少"}, {"start": 2217.9, "end": 2221.3, "text": "给了我整整二十万"}, {"start": 2221.7, "end": 2222.5, "text": "二十万"}, {"start": 2223.66, "end": 2226.18, "text": "天哪 这太不像袁术所为了"}, {"start": 2227.46, "end": 2228.7, "text": "太不像了"}, {"start": 2229.74, "end": 2231.42, "text": "孟仙 你想过没有"}, {"start": 2231.62, "end": 2233.58, "text": "他给你送来这么多的良想"}, {"start": 2233.78, "end": 2235.58, "text": "到底要你为他做什么"}, {"start": 2237.75, "end": 2239.15, "text": "他想娶小佩"}, {"start": 2239.51, "end": 2240.75, "text": "大军来袭时"}, {"start": 2240.95, "end": 2242.39, "text": "他让我不要帮刘备"}, {"start": 2243.91, "end": 2245.79, "text": "离间之计啊"}, {"start": 2248.13, "end": 2248.61, "text": "什么"}, {"start": 2248.97, "end": 2249.77, "text": "你想一想"}, {"start": 2250.29, "end": 2252.33, "text": "小佩一旦落入袁术之手"}, {"start": 2253.05, "end": 2255.77, "text": "那么我们徐州城等于是唇亡齿汗"}, {"start": 2257.05, "end": 2259.93, "text": "下一步要收拾的可就是我们了"}, {"start": 2264.83, "end": 2266.95, "text": "可是我已经收了袁术的良想"}, {"start": 2267.51, "end": 2268.87, "text": "难道还能退回去不成"}, {"start": 2268.87, "end": 2270.15, "text": "当然要退回去"}, {"start": 2270.67, "end": 2271.51, "text": "否则的话"}, {"start": 2271.51, "end": 2273.43, "text": "你就等于结下了两个敌人"}, {"start": 2274.31, "end": 2275.67, "text": "袁术和刘备"}, {"start": 2276.99, "end": 2278.31, "text": "二十万良想"}, {"start": 2278.55, "end": 2280.07, "text": "这可是两年的开销"}, {"start": 2281.07, "end": 2282.79, "text": "这 这怎么能不要呢"}, {"start": 2283.71, "end": 2287.15, "text": "难道你想去助袁术娶下小佩"}, {"start": 2287.83, "end": 2289.67, "text": "走自取灭亡之路吗"}, {"start": 2289.79, "end": 2298.06, "text": "不助袁术"}, {"start": 2298.98, "end": 2299.86, "text": "也不助刘备"}, {"start": 2301.75, "end": 2302.71, "text": "开战之时"}, {"start": 2303.15, "end": 2305.23, "text": "我让他们两家罢兵联合"}, {"start": 2307.03, "end": 2307.99, "text": "我说你呀"}, {"start": 2308.59, "end": 2310.71, "text": "哪里会有这等的好事"}, {"start": 2311.03, "end": 2312.95, "text": "他们连天子的话都可以不听"}, {"start": 2313.23, "end": 2314.07, "text": "会听你的吗"}, {"start": 2315.63, "end": 2317.03, "text": "我们可以试一试嘛"}, {"start": 2317.39, "end": 2318.71, "text": "来 先生坐下来陪我喝酒"}, {"start": 2319.15, "end": 2319.67, "text": "调差"}, {"start": 2320.31, "end": 2321.59, "text": "给先生唱首曲子吧"}, {"start": 2323.51, "end": 2324.35, "text": "行了 行了"}, {"start": 2324.87, "end": 2325.43, "text": "凤相"}, {"start": 2325.83, "end": 2326.87, "text": "你就坐得起乐吧"}, {"start": 2327.19, "end": 2328.51, "text": "我还有些事要做"}, {"start": 2343.47, "end": 2344.39, "text": "来 继续再来"}, {"start": 2344.71, "end": 2345.35, "text": "接着跑"}, {"start": 2349.88, "end": 2359.18, "text": "真是个心智单纯的孩子"}, {"start": 2359.46, "end": 2361.14, "text": "吕布已赴我一封密信"}, {"start": 2361.94, "end": 2363.7, "text": "说发誓不助刘备"}, {"start": 2364.38, "end": 2365.34, "text": "我们现在"}, {"start": 2366.06, "end": 2367.9, "text": "可以放心地娶小佩了"}, {"start": 2375.03, "end": 2375.95, "text": "各位将军"}, {"start": 2377.39, "end": 2379.47, "text": "你们谁敢领兵攻刘备啊"}, {"start": 2381.5, "end": 2383.14, "text": "机灵愿率军出征"}, {"start": 2384.02, "end": 2384.42, "text": "好"}, {"start": 2386.37, "end": 2388.09, "text": "刘备刚刚受挫不久"}, {"start": 2388.53, "end": 2390.45, "text": "小佩守军不过两万"}, {"start": 2391.89, "end": 2393.17, "text": "我给你五万大军"}, {"start": 2393.25, "end": 2395.29, "text": "限你十日之内攻克刘备"}, {"start": 2396.09, "end": 2396.57, "text": "遵命"}, {"start": 2400.9, "end": 2401.46, "text": "听令"}, {"start": 2402.94, "end": 2404.7, "text": "我率大军作为后援"}, {"start": 2405.86, "end": 2407.66, "text": "吕布如果有所异动"}, {"start": 2408.78, "end": 2409.86, "text": "一并剿灭"}, {"start": 2411.02, "end": 2411.9, "text": "遵命"}, {"start": 2419.52, "end": 2419.92, "text": "子隆"}, {"start": 2420.96, "end": 2422.04, "text": "我把实情告诉你"}, {"start": 2422.8, "end": 2424.6, "text": "我们名义上有两万精兵"}, {"start": 2425.12, "end": 2426.52, "text": "实际上一万都不到"}, {"start": 2428.12, "end": 2428.56, "text": "这么少"}, {"start": 2428.72, "end": 2431.16, "text": "义德和云长已分兵聚首"}, {"start": 2433.0, "end": 2434.8, "text": "但是我心里有数"}, {"start": 2437.33, "end": 2438.81, "text": "小佩常吃浅漏"}, {"start": 2438.97, "end": 2440.09, "text": "他们断难应敌"}, {"start": 2447.47, "end": 2450.11, "text": "所以我们只能请吕布发兵相远了"}, {"start": 2451.03, "end": 2453.55, "text": "云长和义德都恨透了吕布"}, {"start": 2455.03, "end": 2456.27, "text": "只好你去跑一趟了"}, {"start": 2459.41, "end": 2459.93, "text": "我这就去"}, {"start": 2460.65, "end": 2461.21, "text": "但如果"}, {"start": 2461.69, "end": 2462.73, "text": "吕布他不肯发兵呢"}, {"start": 2464.21, "end": 2465.49, "text": "那你就去拜见陈公"}, {"start": 2466.65, "end": 2468.73, "text": "我并不是说陈公比吕布更友善"}, {"start": 2469.65, "end": 2471.61, "text": "而是陈公比吕布更聪明"}, {"start": 2472.65, "end": 2473.25, "text": "他知道"}, {"start": 2474.05, "end": 2475.25, "text": "小佩一旦有失"}, {"start": 2475.93, "end": 2476.97, "text": "徐州早晚不报"}, {"start": 2477.49, "end": 2477.85, "text": "快去吧"}, {"start": 2478.93, "end": 2479.17, "text": "命令"}]