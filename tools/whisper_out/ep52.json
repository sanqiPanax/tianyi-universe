[{"start": 4.88, "end": 9.23, "text": "此时的来意我已经知道了"}, {"start": 9.67, "end": 11.19, "text": "还请主公答应这门亲事"}, {"start": 11.47, "end": 13.75, "text": "此事为大叙喜"}, {"start": 16.08, "end": 20.44, "text": "明日我先派人前往江东"}, {"start": 20.76, "end": 24.75, "text": "拜谢孙权"}, {"start": 25.11, "end": 26.95, "text": "深深拜谢吴侯美意"}, {"start": 27.19, "end": 35.59, "text": "及愿娶吴侯之妹为妻"}, {"start": 35.79, "end": 37.95, "text": "数日之后便有聘礼送到"}, {"start": 37.95, "end": 40.91, "text": "孙柳两家不但是抗曹同盟"}, {"start": 41.43, "end": 42.55, "text": "也成因亲"}, {"start": 43.35, "end": 44.71, "text": "张藤结彩之日"}, {"start": 44.95, "end": 47.11, "text": "曹操定然胆狠"}, {"start": 47.39, "end": 49.47, "text": "草草定然胆狠"}, {"start": 51.75, "end": 53.15, "text": "吴侯说得极是"}, {"start": 54.23, "end": 56.03, "text": "我主命在下请示吴侯"}, {"start": 56.23, "end": 58.19, "text": "不知何时可以成亲呢"}, {"start": 59.23, "end": 60.75, "text": "刘备何时来建康"}, {"start": 61.07, "end": 62.91, "text": "何时便可成亲"}, {"start": 64.71, "end": 67.67, "text": "吴侯 我主为何要来建康"}, {"start": 67.99, "end": 69.63, "text": "小姐不是要出嫁荆州吗"}, {"start": 69.91, "end": 71.55, "text": "我主可以在江边迎亲呢"}, {"start": 73.95, "end": 74.87, "text": "五妹年幼"}, {"start": 75.35, "end": 77.55, "text": "家母不愿让小妹远嫁"}, {"start": 79.31, "end": 82.55, "text": "非要让刘备入赘东吴成亲"}, {"start": 84.83, "end": 87.59, "text": "原来是要我主入赘东吴啊"}, {"start": 89.15, "end": 90.03, "text": "告诉皇叔"}, {"start": 90.47, "end": 91.83, "text": "从建康到荆州"}, {"start": 92.15, "end": 93.27, "text": "不过两日水路"}, {"start": 94.07, "end": 94.99, "text": "成亲之后"}, {"start": 95.27, "end": 97.71, "text": "他愿意在此待多久就待多久"}, {"start": 98.59, "end": 99.55, "text": "如不愿意"}, {"start": 99.87, "end": 101.63, "text": "随时可带新婚妻子"}, {"start": 102.03, "end": 103.07, "text": "返回荆州去"}, {"start": 104.07, "end": 104.87, "text": "说什么"}, {"start": 105.51, "end": 107.23, "text": "要让主公去建康成亲"}, {"start": 107.63, "end": 108.23, "text": "是啊"}, {"start": 108.83, "end": 109.67, "text": "孙权说"}, {"start": 110.15, "end": 111.23, "text": "小妹年轻"}, {"start": 111.43, "end": 112.55, "text": "太夫人舍不得"}, {"start": 112.95, "end": 114.67, "text": "要找主公入赘东吴"}, {"start": 115.15, "end": 115.91, "text": "成亲后"}, {"start": 116.19, "end": 118.15, "text": "主公想住多久就住多久"}, {"start": 118.63, "end": 120.07, "text": "想把新婚妻子接回来"}, {"start": 120.23, "end": 121.03, "text": "就接回来"}, {"start": 122.59, "end": 124.55, "text": "昨夜我通宵未眠"}, {"start": 125.03, "end": 126.63, "text": "一直在考虑此事"}, {"start": 127.15, "end": 131.5, "text": "现在我想好了"}, {"start": 131.9, "end": 135.79, "text": "娶孙小妹为妻"}, {"start": 136.31, "end": 137.39, "text": "和东吴结亲"}, {"start": 137.71, "end": 138.35, "text": "大哥"}, {"start": 138.99, "end": 140.59, "text": "你真打算要这么亲事啊"}, {"start": 141.07, "end": 142.39, "text": "这不成啊"}, {"start": 143.27, "end": 143.95, "text": "为何"}, {"start": 144.55, "end": 145.11, "text": "大哥"}, {"start": 145.39, "end": 146.23, "text": "你想想看"}, {"start": 146.59, "end": 148.27, "text": "当年讨伐董卓的时候"}, {"start": 148.91, "end": 151.59, "text": "咱们就和吴侯他爹孙坚谋事"}, {"start": 152.23, "end": 153.31, "text": "照这么算来"}, {"start": 153.95, "end": 156.51, "text": "他吴侯应该是你的侄儿啊"}, {"start": 157.27, "end": 158.03, "text": "可现在"}, {"start": 158.15, "end": 158.63, "text": "这"}, {"start": 159.51, "end": 161.43, "text": "你却要去做上门女婿"}, {"start": 161.75, "end": 163.59, "text": "还要尊纳二十多岁的"}, {"start": 163.71, "end": 165.31, "text": "孜然小儿为舅兄"}, {"start": 165.39, "end": 165.75, "text": "这"}, {"start": 165.75, "end": 168.03, "text": "这 这岂不是自哀三分吗"}, {"start": 169.75, "end": 170.95, "text": "是啊 大哥"}, {"start": 171.95, "end": 173.51, "text": "此事过于屈辱"}, {"start": 174.27, "end": 175.91, "text": "会让天下人耻笑"}, {"start": 178.03, "end": 178.79, "text": "屈辱"}, {"start": 179.87, "end": 180.75, "text": "这么多年"}, {"start": 180.75, "end": 182.43, "text": "我们受过的屈辱少吗"}, {"start": 183.55, "end": 185.19, "text": "为了这历尽千辛万苦"}, {"start": 185.19, "end": 186.63, "text": "得来的江汉之地"}, {"start": 187.47, "end": 189.31, "text": "我做一回上门女婿"}, {"start": 190.71, "end": 192.43, "text": "称她孙全一声舅兄"}, {"start": 192.43, "end": 193.31, "text": "又如何"}, {"start": 193.75, "end": 194.87, "text": "又会怎么样"}, {"start": 196.79, "end": 197.43, "text": "主公"}, {"start": 198.59, "end": 200.03, "text": "我也觉得此事不妥"}, {"start": 202.08, "end": 203.36, "text": "你怎么也变卦了"}, {"start": 203.76, "end": 204.84, "text": "你不是一直主张"}, {"start": 204.84, "end": 206.32, "text": "我答应这门亲事吗"}, {"start": 207.2, "end": 208.28, "text": "我是没有料到"}, {"start": 208.56, "end": 210.76, "text": "孙全会让主公入赘东吴"}, {"start": 211.48, "end": 212.96, "text": "事情变化得太快了"}, {"start": 213.72, "end": 215.08, "text": "我担心其中有诈"}, {"start": 215.72, "end": 216.88, "text": "主公若是去了"}, {"start": 217.24, "end": 218.16, "text": "一旦不测"}, {"start": 218.4, "end": 219.4, "text": "安危谁顾"}, {"start": 221.8, "end": 223.0, "text": "军师说得没错"}, {"start": 223.36, "end": 224.04, "text": "此事"}, {"start": 224.52, "end": 226.0, "text": "一定是周瑜的主意"}, {"start": 226.32, "end": 228.28, "text": "那小子一直没安好心"}, {"start": 228.8, "end": 229.76, "text": "可不是吗"}, {"start": 230.72, "end": 231.28, "text": "大哥"}, {"start": 231.44, "end": 232.76, "text": "这就跟打仗一样"}, {"start": 233.56, "end": 235.24, "text": "他们已经埋下伏击了"}, {"start": 236.48, "end": 237.6, "text": "周郎那小子"}, {"start": 237.8, "end": 239.32, "text": "用吴侯的妹妹做儿"}, {"start": 239.96, "end": 241.68, "text": "是想诱大哥入瓮啊"}, {"start": 245.46, "end": 246.38, "text": "你们多虑了"}, {"start": 255.97, "end": 256.89, "text": "我想啊"}, {"start": 257.77, "end": 258.73, "text": "应该是"}, {"start": 259.57, "end": 261.17, "text": "孙全经合肥之败"}, {"start": 262.09, "end": 264.13, "text": "担心曹操会趁胜进军"}, {"start": 264.45, "end": 265.69, "text": "渴望和我们"}, {"start": 265.69, "end": 267.49, "text": "结成更紧密的联盟吧"}, {"start": 269.66, "end": 270.5, "text": "再说了"}, {"start": 270.82, "end": 272.06, "text": "人家刚刚准了我们"}, {"start": 272.06, "end": 273.18, "text": "借荆州为本"}, {"start": 274.18, "end": 276.14, "text": "我们要是回绝了这门亲事"}, {"start": 276.42, "end": 278.34, "text": "那岂不是让人家恼羞成怒"}, {"start": 280.64, "end": 281.72, "text": "为大局计"}, {"start": 282.36, "end": 283.32, "text": "也必须答应"}, {"start": 290.5, "end": 292.22, "text": "两难那两难"}, {"start": 293.38, "end": 294.38, "text": "何为两难"}, {"start": 296.44, "end": 297.36, "text": "去也难"}, {"start": 297.76, "end": 298.68, "text": "不去也难"}, {"start": 299.96, "end": 301.52, "text": "如果主公拒绝连樱"}, {"start": 301.8, "end": 302.68, "text": "不去建康"}, {"start": 303.4, "end": 305.08, "text": "那他就是羞辱了整个东吴"}, {"start": 305.52, "end": 306.28, "text": "那时候"}, {"start": 306.28, "end": 307.8, "text": "周瑜带兵攻荆州时"}, {"start": 308.28, "end": 310.04, "text": "东吴大军同仇敌忾"}, {"start": 310.04, "end": 311.0, "text": "两军交战"}, {"start": 311.0, "end": 312.64, "text": "孙刘就会两败俱伤"}, {"start": 312.84, "end": 313.92, "text": "从中得利的"}, {"start": 314.16, "end": 315.04, "text": "是曹操"}, {"start": 317.57, "end": 318.97, "text": "如果大哥要是去了呢"}, {"start": 319.41, "end": 320.85, "text": "那周瑜的如意算盘"}, {"start": 320.85, "end": 321.65, "text": "就得逞了"}, {"start": 322.93, "end": 323.73, "text": "前时"}, {"start": 324.09, "end": 326.01, "text": "他在南郡损兵折疆"}, {"start": 326.33, "end": 327.45, "text": "自己中了一箭"}, {"start": 327.45, "end": 328.73, "text": "也没有攻下荆州"}, {"start": 329.29, "end": 330.01, "text": "可现在"}, {"start": 331.01, "end": 332.41, "text": "他把主公捏在手里"}, {"start": 333.49, "end": 334.49, "text": "以主公"}, {"start": 334.89, "end": 335.73, "text": "要挟我们"}, {"start": 335.89, "end": 337.33, "text": "归还荆州主军"}, {"start": 337.89, "end": 338.57, "text": "对对对"}, {"start": 338.85, "end": 339.85, "text": "军师说得对"}, {"start": 340.41, "end": 341.01, "text": "大哥"}, {"start": 341.29, "end": 342.17, "text": "你不能去"}, {"start": 343.37, "end": 343.93, "text": "大哥"}, {"start": 344.57, "end": 346.13, "text": "咱们不能自投罗网啊"}, {"start": 347.17, "end": 354.66, "text": "我得去"}, {"start": 354.94, "end": 359.86, "text": "好"}, {"start": 359.86, "end": 360.34, "text": "大哥"}, {"start": 363.71, "end": 365.23, "text": "事情已经很明白了"}, {"start": 366.19, "end": 367.31, "text": "去就是庆节"}, {"start": 367.63, "end": 368.83, "text": "不去就是仇节"}, {"start": 369.95, "end": 371.59, "text": "我们不能跟东吴翻脸"}, {"start": 372.55, "end": 373.99, "text": "如果我不去成亲"}, {"start": 374.59, "end": 376.43, "text": "周瑜动兵率军袭荆"}, {"start": 376.83, "end": 377.87, "text": "荆乡必为"}, {"start": 377.87, "end": 378.95, "text": "大局崩坏"}, {"start": 379.39, "end": 380.39, "text": "如果我去了"}, {"start": 380.75, "end": 381.59, "text": "他周瑜就没有"}, {"start": 381.59, "end": 383.07, "text": "任何动兵的理由了"}, {"start": 385.13, "end": 386.25, "text": "二位贤弟啊"}, {"start": 387.17, "end": 388.97, "text": "我们打了十几年的仗了"}, {"start": 389.81, "end": 391.33, "text": "我们尝尽了颠沛流离"}, {"start": 391.33, "end": 392.77, "text": "寄人篱下的苦头"}, {"start": 394.21, "end": 394.93, "text": "今天"}, {"start": 395.33, "end": 397.21, "text": "总算有了这么一块地盘"}, {"start": 398.37, "end": 399.93, "text": "你们让我怎么能够"}, {"start": 399.93, "end": 401.21, "text": "舍得放弃呢"}, {"start": 402.94, "end": 403.46, "text": "大哥"}, {"start": 405.84, "end": 407.4, "text": "如果周瑜他叩见你"}, {"start": 408.16, "end": 409.28, "text": "管你要荆州"}, {"start": 410.36, "end": 411.96, "text": "那荆州一样是不薄啊"}, {"start": 412.36, "end": 413.0, "text": "是啊"}, {"start": 414.56, "end": 415.96, "text": "叩我一人何用"}, {"start": 418.08, "end": 419.72, "text": "有你们和军师都在这"}, {"start": 420.36, "end": 421.52, "text": "荆州无忧"}, {"start": 422.56, "end": 423.28, "text": "再说了"}, {"start": 423.64, "end": 424.56, "text": "我就不信他周瑜"}, {"start": 424.56, "end": 425.56, "text": "能把我怎么样"}, {"start": 426.72, "end": 427.72, "text": "我现在就跟你们"}, {"start": 427.72, "end": 428.64, "text": "立一条规矩"}, {"start": 429.72, "end": 430.92, "text": "我去江东以后"}, {"start": 431.76, "end": 433.36, "text": "荆乡一应大势"}, {"start": 433.64, "end": 434.88, "text": "军由军师做主"}, {"start": 435.32, "end": 436.32, "text": "凡是从江东"}, {"start": 436.32, "end": 437.28, "text": "传来我的号令"}, {"start": 437.28, "end": 438.72, "text": "你们可以一概不放"}, {"start": 447.38, "end": 449.06, "text": "他们要永远不放你回来呢"}, {"start": 450.89, "end": 452.01, "text": "你们不用担心"}, {"start": 452.73, "end": 454.57, "text": "你们只管一心整军精"}, {"start": 455.57, "end": 457.01, "text": "只要咱们在荆州"}, {"start": 457.01, "end": 458.45, "text": "把根基扎牢了"}, {"start": 458.65, "end": 459.97, "text": "只要兵强马壮"}, {"start": 460.49, "end": 461.77, "text": "由不得他不放人"}, {"start": 462.53, "end": 463.01, "text": "大哥"}, {"start": 463.01, "end": 463.57, "text": "大哥"}, {"start": 464.17, "end": 464.69, "text": "好了"}, {"start": 465.97, "end": 467.13, "text": "事情就这么定了"}, {"start": 467.85, "end": 469.05, "text": "你们谁也不必再劝了"}, {"start": 498.03, "end": 498.95, "text": "二弟 三弟"}, {"start": 499.63, "end": 500.99, "text": "明天我就要走了"}, {"start": 501.95, "end": 503.67, "text": "积下这些兵马不易啊"}, {"start": 504.35, "end": 506.95, "text": "你们可要把他们练好了"}, {"start": 508.51, "end": 509.55, "text": "大哥 你再想想"}, {"start": 510.11, "end": 511.15, "text": "这不去不行吗"}, {"start": 512.03, "end": 512.63, "text": "云彰"}, {"start": 513.51, "end": 514.63, "text": "我知你心思"}, {"start": 516.65, "end": 518.09, "text": "可是没有办法呀"}, {"start": 520.9, "end": 522.02, "text": "老天从来都"}, {"start": 522.02, "end": 523.42, "text": "不曾厚待过我们"}, {"start": 524.66, "end": 525.78, "text": "一切都要靠我们"}, {"start": 525.78, "end": 526.62, "text": "自己去争"}, {"start": 528.64, "end": 530.12, "text": "一丝求存的机会"}, {"start": 530.44, "end": 531.6, "text": "我都不敢放过"}, {"start": 534.64, "end": 535.2, "text": "大哥"}, {"start": 535.64, "end": 536.88, "text": "你执意要冒这个险"}, {"start": 537.6, "end": 538.28, "text": "做兄弟的"}, {"start": 539.12, "end": 539.96, "text": "也劝不住"}, {"start": 540.84, "end": 541.48, "text": "有句话"}, {"start": 543.0, "end": 543.8, "text": "我还是想说"}, {"start": 544.76, "end": 545.24, "text": "二弟"}, {"start": 546.04, "end": 547.12, "text": "在大哥面前"}, {"start": 547.24, "end": 548.6, "text": "没必要吞吞吐吐的"}, {"start": 549.08, "end": 550.32, "text": "有什么你直言无妨"}, {"start": 554.77, "end": 556.29, "text": "军师朱葛亮他"}, {"start": 560.22, "end": 560.7, "text": "说呀"}, {"start": 564.01, "end": 565.29, "text": "他在投降大哥之前"}, {"start": 566.57, "end": 567.69, "text": "以有卧龙之称"}, {"start": 568.57, "end": 569.01, "text": "龙"}, {"start": 570.13, "end": 571.53, "text": "可是帝王之生啊"}, {"start": 573.7, "end": 574.54, "text": "他执谋过人"}, {"start": 576.02, "end": 577.78, "text": "我等兄弟不是他的对手"}, {"start": 578.78, "end": 579.5, "text": "大哥走后"}, {"start": 580.5, "end": 582.7, "text": "如果把荆襄的军政"}, {"start": 583.42, "end": 584.86, "text": "全部委于他手"}, {"start": 585.9, "end": 587.06, "text": "就连我们兄弟"}, {"start": 587.5, "end": 588.62, "text": "也要听他的号令"}, {"start": 589.94, "end": 592.1, "text": "大哥你就不怕他趁机会"}, {"start": 592.82, "end": 594.22, "text": "做了荆襄之主吗"}, {"start": 597.04, "end": 598.08, "text": "二哥说得是啊"}, {"start": 598.92, "end": 601.04, "text": "那孔明一肚子花花肠子"}, {"start": 602.0, "end": 604.12, "text": "子龙 黄忠 魏妍"}, {"start": 604.48, "end": 605.32, "text": "他们这干人"}, {"start": 605.64, "end": 608.24, "text": "对他那简直是敬佩之极呀"}, {"start": 609.04, "end": 610.36, "text": "尤其是那个赵云"}, {"start": 611.4, "end": 613.12, "text": "最近他娶的一房妻子"}, {"start": 613.48, "end": 614.68, "text": "也是孔明做的美"}, {"start": 615.84, "end": 617.92, "text": "他对军师佩服的"}, {"start": 617.92, "end": 619.12, "text": "更是无体投地"}, {"start": 619.92, "end": 620.72, "text": "言听既足"}, {"start": 621.64, "end": 623.08, "text": "甚至比对大哥更敬了"}, {"start": 625.66, "end": 627.18, "text": "大哥你心怀坦荡"}, {"start": 627.78, "end": 629.3, "text": "我等兄弟不必多言"}, {"start": 629.78, "end": 630.78, "text": "只是你这一走"}, {"start": 631.18, "end": 632.26, "text": "不知何日能归"}, {"start": 633.3, "end": 634.14, "text": "时间长了"}, {"start": 635.3, "end": 636.54, "text": "人心都付了他"}, {"start": 637.18, "end": 638.58, "text": "恐怕这荆州之主"}, {"start": 639.5, "end": 640.5, "text": "就不姓刘了"}, {"start": 641.26, "end": 656.86, "text": "哥 大哥"}, {"start": 656.86, "end": 657.18, "text": "你"}, {"start": 663.3, "end": 664.14, "text": "二弟 三弟"}, {"start": 666.66, "end": 667.3, "text": "以后"}, {"start": 668.46, "end": 669.74, "text": "如果我再从你们嘴里"}, {"start": 669.74, "end": 670.78, "text": "听到这样的话"}, {"start": 671.7, "end": 673.9, "text": "我再听到你们议论孔明先生"}, {"start": 674.42, "end": 676.22, "text": "我就扎聋我自己的耳朵"}, {"start": 676.22, "end": 677.3, "text": "大哥 大哥"}, {"start": 677.3, "end": 677.74, "text": "别动"}, {"start": 678.02, "end": 689.01, "text": "你居然这样议论孔明先生"}, {"start": 689.01, "end": 692.39, "text": "我回头看看"}, {"start": 694.1, "end": 695.78, "text": "在先生出山辅助之前"}, {"start": 695.78, "end": 696.86, "text": "我们是什么样子"}, {"start": 698.8, "end": 700.36, "text": "被困在新野小县"}, {"start": 701.04, "end": 702.2, "text": "兵不稳两千"}, {"start": 702.6, "end": 703.84, "text": "粮不赢千户"}, {"start": 704.08, "end": 709.78, "text": "每个人手上都有上万精兵"}, {"start": 710.94, "end": 712.7, "text": "这不都是拜先生所赐"}, {"start": 713.02, "end": 717.81, "text": "我今天话说到这儿"}, {"start": 721.49, "end": 723.45, "text": "私事我们是兄弟"}, {"start": 724.49, "end": 726.29, "text": "公事我们是主臣"}, {"start": 726.97, "end": 728.45, "text": "我既然说了把荆襄之事"}, {"start": 728.45, "end": 729.65, "text": "全部托不给军事"}, {"start": 730.13, "end": 731.49, "text": "你们就必须照办"}, {"start": 732.73, "end": 733.89, "text": "如有什么违抗"}, {"start": 736.93, "end": 738.01, "text": "无论我在东宫"}, {"start": 738.37, "end": 739.49, "text": "还是回到荆襄"}, {"start": 739.69, "end": 743.04, "text": "它倒结果了我自己的性命"}, {"start": 743.8, "end": 745.2, "text": "大哥 大哥"}, {"start": 746.72, "end": 749.04, "text": "我们兄弟听你的就是了"}, {"start": 749.04, "end": 750.24, "text": "我们都听你的"}, {"start": 756.68, "end": 757.28, "text": "三弟"}, {"start": 757.92, "end": 759.2, "text": "这把刀我先留下"}, {"start": 788.85, "end": 789.45, "text": "先生"}, {"start": 789.73, "end": 790.01, "text": "主公"}, {"start": 790.01, "end": 791.01, "text": "来 先生快坐"}, {"start": 792.05, "end": 793.01, "text": "没打扰你吧"}, {"start": 794.37, "end": 794.97, "text": "主公"}, {"start": 795.33, "end": 796.25, "text": "瞧你说的"}, {"start": 801.22, "end": 802.54, "text": "我也没别的事"}, {"start": 803.54, "end": 804.46, "text": "就是"}, {"start": 805.22, "end": 806.7, "text": "明天要去建康了"}, {"start": 807.3, "end": 808.54, "text": "来和你画个别"}, {"start": 811.83, "end": 813.03, "text": "先生在补光"}, {"start": 813.79, "end": 814.47, "text": "是啊"}, {"start": 815.79, "end": 817.27, "text": "我已经补了三卦了"}, {"start": 819.97, "end": 821.05, "text": "倒是凶光"}, {"start": 833.3, "end": 834.54, "text": "我还是那句话"}, {"start": 836.06, "end": 837.66, "text": "你能不能改个主意啊"}, {"start": 837.86, "end": 842.78, "text": "孔明啊"}, {"start": 843.5, "end": 845.78, "text": "我这是别无选择了"}, {"start": 846.9, "end": 848.38, "text": "自卓俊起兵"}, {"start": 848.74, "end": 851.3, "text": "到今天二十多年了"}, {"start": 852.54, "end": 853.9, "text": "我还一事无成"}, {"start": 856.7, "end": 859.06, "text": "对于一个快五十岁的人来说"}, {"start": 860.02, "end": 862.46, "text": "上天还会留给他多少时间呢"}, {"start": 863.54, "end": 864.86, "text": "如果我不拼死"}, {"start": 865.26, "end": 867.42, "text": "保住这片来之不易的土地"}, {"start": 868.42, "end": 870.42, "text": "那中兴汉室的愿望"}, {"start": 870.86, "end": 873.18, "text": "就只能是水中之月了"}, {"start": 881.3, "end": 882.74, "text": "我已说句心里话"}, {"start": 883.02, "end": 886.2, "text": "虽然我口口声声"}, {"start": 886.6, "end": 887.72, "text": "不赞成你去"}, {"start": 889.08, "end": 890.16, "text": "但是我心里"}, {"start": 890.88, "end": 892.36, "text": "还是希望你能去"}, {"start": 899.64, "end": 901.8, "text": "不让主公去是出于情"}, {"start": 902.24, "end": 903.56, "text": "担心主公的安危"}, {"start": 904.56, "end": 906.68, "text": "让主公去是出于礼"}, {"start": 907.48, "end": 908.84, "text": "我知道这是大局"}, {"start": 909.2, "end": 912.02, "text": "请主公恕罪"}, {"start": 912.9, "end": 913.98, "text": "我也是两难难"}, {"start": 913.98, "end": 924.88, "text": "你把荆州之事竟托付于我"}, {"start": 926.16, "end": 927.48, "text": "我怕我自立尚浅"}, {"start": 927.68, "end": 928.56, "text": "不能服众"}, {"start": 929.56, "end": 931.16, "text": "负了主公的重托"}, {"start": 931.56, "end": 936.09, "text": "我知道你在担忧什么"}, {"start": 937.25, "end": 938.37, "text": "你在担忧"}, {"start": 940.05, "end": 941.45, "text": "我二弟和三弟"}, {"start": 943.47, "end": 945.47, "text": "他们与我桃园结义后"}, {"start": 946.11, "end": 947.27, "text": "纵横天下"}, {"start": 947.55, "end": 948.83, "text": "得了一些虚名"}, {"start": 949.51, "end": 951.19, "text": "自先生出山以来"}, {"start": 951.75, "end": 954.35, "text": "他们虽然被先生的才气所折服"}, {"start": 955.55, "end": 957.95, "text": "但毕竟与我的感情太深了"}, {"start": 958.99, "end": 959.79, "text": "我说过"}, {"start": 960.63, "end": 961.59, "text": "我走以后"}, {"start": 962.11, "end": 962.99, "text": "以我的名义"}, {"start": 962.99, "end": 965.11, "text": "从江东来的一切号令"}, {"start": 965.71, "end": 967.19, "text": "他们可以一概不遵"}, {"start": 968.03, "end": 970.23, "text": "但如果我真的遇到什么危险"}, {"start": 970.39, "end": 971.47, "text": "他们难免"}, {"start": 971.83, "end": 973.23, "text": "会不听你的差遣"}, {"start": 973.35, "end": 974.91, "text": "做出一些蠢事来"}, {"start": 976.51, "end": 978.31, "text": "主公连这个都想到了"}, {"start": 979.99, "end": 981.99, "text": "这确实是我忧虑之处啊"}, {"start": 981.99, "end": 991.98, "text": "不用不必担心"}, {"start": 998.02, "end": 998.82, "text": "我这就"}, {"start": 999.3, "end": 1000.58, "text": "留一道密令给你"}, {"start": 1000.62, "end": 1006.81, "text": "这两位兄弟"}, {"start": 1008.54, "end": 1010.02, "text": "不听你的号令"}, {"start": 1019.43, "end": 1020.83, "text": "你就把这道密令"}, {"start": 1021.47, "end": 1022.51, "text": "交给子龙"}, {"start": 1034.62, "end": 1035.7, "text": "这怎么能行呢"}, {"start": 1036.58, "end": 1037.38, "text": "云长与易德"}, {"start": 1037.38, "end": 1039.34, "text": "跟随主公出生入死几十年"}, {"start": 1039.54, "end": 1040.9, "text": "不管二位将军做什么"}, {"start": 1041.66, "end": 1043.02, "text": "都不该这么对他们的"}, {"start": 1054.06, "end": 1055.3, "text": "我漂泊一生"}, {"start": 1056.02, "end": 1057.22, "text": "逆境遁错"}, {"start": 1058.66, "end": 1060.06, "text": "只有遇到了你"}, {"start": 1061.3, "end": 1063.38, "text": "我才有了今天这个局面"}, {"start": 1064.42, "end": 1065.66, "text": "我心里清楚"}, {"start": 1067.53, "end": 1068.49, "text": "只有你"}, {"start": 1069.33, "end": 1070.29, "text": "能帮我完成"}, {"start": 1070.29, "end": 1072.01, "text": "中兴汉室的梦想"}, {"start": 1072.21, "end": 1076.9, "text": "如果我这次"}, {"start": 1077.58, "end": 1078.82, "text": "真的回不来"}, {"start": 1080.18, "end": 1082.18, "text": "荆州也只能交给你"}, {"start": 1082.58, "end": 1083.26, "text": "主公"}, {"start": 1087.64, "end": 1089.4, "text": "至于我这两个弟弟"}, {"start": 1089.4, "end": 1093.45, "text": "你能用"}, {"start": 1094.85, "end": 1095.85, "text": "则用着"}, {"start": 1096.77, "end": 1097.61, "text": "不能用"}, {"start": 1098.85, "end": 1099.97, "text": "就弃之"}, {"start": 1100.93, "end": 1102.57, "text": "不要有任何顾忌"}, {"start": 1103.49, "end": 1106.17, "text": "跟汉夜 中兴比起来"}, {"start": 1106.65, "end": 1108.41, "text": "我们兄弟间的情分"}, {"start": 1109.25, "end": 1110.09, "text": "不算什么"}, {"start": 1112.95, "end": 1113.55, "text": "主公"}, {"start": 1113.55, "end": 1114.31, "text": "孔明"}, {"start": 1115.07, "end": 1116.35, "text": "你对在下真是"}, {"start": 1116.55, "end": 1122.95, "text": "不攻就放行"}, {"start": 1122.95, "end": 1123.75, "text": "去吧"}, {"start": 1123.75, "end": 1127.49, "text": "主公是天人"}, {"start": 1128.05, "end": 1128.97, "text": "我这挂号"}, {"start": 1129.53, "end": 1131.01, "text": "能补人间生死"}, {"start": 1131.81, "end": 1133.13, "text": "但补不了天际"}, {"start": 1134.37, "end": 1135.01, "text": "我想主公"}, {"start": 1135.01, "end": 1136.53, "text": "定能平安回来的"}, {"start": 1136.65, "end": 1141.68, "text": "是老天不开眼"}, {"start": 1142.04, "end": 1143.2, "text": "出了什么意外"}, {"start": 1143.4, "end": 1146.58, "text": "定和云长易德"}, {"start": 1146.98, "end": 1148.78, "text": "尽心辅佐少主"}, {"start": 1149.54, "end": 1150.98, "text": "诛贼强悍"}, {"start": 1164.46, "end": 1166.9, "text": "我只知道先生的志"}, {"start": 1168.1, "end": 1168.94, "text": "今天"}, {"start": 1169.82, "end": 1172.66, "text": "我才知道先生的忠啊"}, {"start": 1177.48, "end": 1179.2, "text": "这我就放心了"}, {"start": 1179.32, "end": 1181.84, "text": "我可以放心地走了"}, {"start": 1181.84, "end": 1185.36, "text": "此去动物"}, {"start": 1186.08, "end": 1187.36, "text": "路途艰险"}, {"start": 1188.76, "end": 1190.56, "text": "主公还是带上子隆吧"}, {"start": 1191.2, "end": 1192.28, "text": "他公马贤手"}, {"start": 1192.28, "end": 1193.28, "text": "一身势难"}, {"start": 1193.28, "end": 1194.28, "text": "办事稳当"}, {"start": 1194.96, "end": 1196.44, "text": "有他在主公身边"}, {"start": 1197.32, "end": 1198.72, "text": "我也好安心一些"}, {"start": 1198.92, "end": 1202.63, "text": "至于这封密令"}, {"start": 1203.95, "end": 1204.71, "text": "在下"}, {"start": 1204.71, "end": 1238.19, "text": "孔明啊"}, {"start": 1240.21, "end": 1241.69, "text": "能给我弹一曲吗"}, {"start": 1242.85, "end": 1243.77, "text": "我已经很久"}, {"start": 1243.77, "end": 1245.25, "text": "没有听你弹琴了"}, {"start": 1250.39, "end": 1251.39, "text": "这张琴"}, {"start": 1252.67, "end": 1253.99, "text": "自赤壁之后"}, {"start": 1254.51, "end": 1255.79, "text": "我就没有弹过"}, {"start": 1258.61, "end": 1260.41, "text": "今夜我就弹上一曲"}, {"start": 1261.61, "end": 1263.53, "text": "算是为我主公送行"}, {"start": 1346.2, "end": 1347.76, "text": "好久没心情抚琴"}, {"start": 1348.6, "end": 1349.72, "text": "手都生了"}, {"start": 1352.14, "end": 1353.22, "text": "都督的琴声"}, {"start": 1353.38, "end": 1354.42, "text": "清越无比"}, {"start": 1354.98, "end": 1356.06, "text": "沁人心胸"}, {"start": 1357.3, "end": 1358.34, "text": "就如同是"}, {"start": 1358.74, "end": 1360.46, "text": "天上现象的月光一样"}, {"start": 1361.78, "end": 1362.5, "text": "是吗"}, {"start": 1364.02, "end": 1365.46, "text": "你也变得会说话了"}, {"start": 1369.74, "end": 1370.38, "text": "都督"}, {"start": 1371.14, "end": 1371.9, "text": "该服药了"}, {"start": 1381.78, "end": 1383.26, "text": "荆州那边的消息如何"}, {"start": 1384.1, "end": 1385.54, "text": "甘宁派回的细作说"}, {"start": 1386.02, "end": 1387.46, "text": "朱葛亮秘密调集"}, {"start": 1387.46, "end": 1389.06, "text": "关张 赵 黄 四路人马"}, {"start": 1389.46, "end": 1390.3, "text": "急于公安"}, {"start": 1390.98, "end": 1392.7, "text": "大约两万人马"}, {"start": 1396.2, "end": 1398.36, "text": "这朱葛亮到底是跟别人不同"}, {"start": 1400.36, "end": 1401.92, "text": "看出我招亲是假"}, {"start": 1402.6, "end": 1404.2, "text": "修复荆襄是真"}, {"start": 1408.0, "end": 1409.64, "text": "他点破了这桩事也好"}, {"start": 1410.6, "end": 1412.88, "text": "亮他刘备也不敢到建康成亲"}, {"start": 1413.76, "end": 1415.56, "text": "这样我们就可以起兵问罪了"}, {"start": 1417.04, "end": 1418.24, "text": "马上通知三军"}, {"start": 1419.0, "end": 1421.08, "text": "只要刘备拒婚的消息一传出"}, {"start": 1421.2, "end": 1422.68, "text": "立即向公安警发"}, {"start": 1424.4, "end": 1425.88, "text": "一举收复荆襄"}, {"start": 1427.0, "end": 1427.6, "text": "遵命"}, {"start": 1446.15, "end": 1447.27, "text": "你一身势淡"}, {"start": 1447.91, "end": 1449.39, "text": "主公就拜托给你了"}, {"start": 1451.53, "end": 1452.45, "text": "军师请放心"}, {"start": 1452.85, "end": 1454.41, "text": "有我在 主公无忧"}, {"start": 1457.76, "end": 1458.68, "text": "二弟 三弟"}, {"start": 1459.4, "end": 1460.44, "text": "就送到这儿了"}, {"start": 1461.08, "end": 1462.76, "text": "大哥千万要保重啊"}, {"start": 1474.07, "end": 1475.31, "text": "我这里有三个警囊"}, {"start": 1475.67, "end": 1477.07, "text": "分别装了三条计策"}, {"start": 1477.63, "end": 1478.51, "text": "你把它藏好"}, {"start": 1478.99, "end": 1481.23, "text": "按照红黄白的顺序依次打开"}, {"start": 1482.15, "end": 1483.55, "text": "待传开到东吴时"}, {"start": 1483.99, "end": 1484.91, "text": "打开第一个"}, {"start": 1485.51, "end": 1487.03, "text": "按照囊中计策行事"}, {"start": 1487.39, "end": 1489.15, "text": "如果你们能在东吴住到年底"}, {"start": 1489.15, "end": 1490.19, "text": "再打开第二个"}, {"start": 1490.59, "end": 1492.23, "text": "也按照囊中计策行事"}, {"start": 1493.31, "end": 1494.15, "text": "第三个"}, {"start": 1494.99, "end": 1496.51, "text": "待到危难时刻再打开"}, {"start": 1497.23, "end": 1498.27, "text": "切切谨记"}, {"start": 1502.63, "end": 1503.43, "text": "末将记住了"}, {"start": 1504.07, "end": 1505.39, "text": "但愿有助于你们"}, {"start": 1506.35, "end": 1507.19, "text": "军师都保重"}, {"start": 1522.96, "end": 1524.36, "text": "大都督有消息来"}, {"start": 1524.72, "end": 1526.2, "text": "刘备骑车往建康去了"}, {"start": 1526.84, "end": 1527.36, "text": "什么"}, {"start": 1531.62, "end": 1533.18, "text": "他们是走陆路还是水路"}, {"start": 1533.38, "end": 1535.3, "text": "水路乘坐三轨快船"}, {"start": 1535.62, "end": 1538.86, "text": "两真是狡诈"}, {"start": 1539.66, "end": 1541.06, "text": "他让刘备直下建康"}, {"start": 1541.9, "end": 1543.14, "text": "先去了小姐再说"}, {"start": 1544.02, "end": 1545.74, "text": "如果刘备真成了江东女婿"}, {"start": 1546.66, "end": 1547.74, "text": "我们就不好下手了"}, {"start": 1553.92, "end": 1554.32, "text": "都督"}, {"start": 1555.16, "end": 1556.48, "text": "末将请命率水师"}, {"start": 1556.84, "end": 1557.88, "text": "前去劫住刘备"}, {"start": 1560.5, "end": 1561.34, "text": "他们是顺风"}, {"start": 1564.88, "end": 1565.56, "text": "那怎么办"}, {"start": 1579.46, "end": 1580.3, "text": "末将明白"}, {"start": 1631.73, "end": 1632.69, "text": "前面是卢江镇"}, {"start": 1633.29, "end": 1634.65, "text": "江东一带繁华胜地"}, {"start": 1635.41, "end": 1636.25, "text": "咱们走得仓促"}, {"start": 1636.93, "end": 1637.77, "text": "也没带些聘礼"}, {"start": 1638.53, "end": 1639.77, "text": "应该上岸采购一些吧"}, {"start": 1642.26, "end": 1643.94, "text": "何不到建康在采购呢"}, {"start": 1644.14, "end": 1645.34, "text": "那里是江东首府"}, {"start": 1645.46, "end": 1646.78, "text": "物品会更丰富些"}, {"start": 1648.3, "end": 1648.74, "text": "这样"}, {"start": 1649.34, "end": 1650.58, "text": "孙全就会知道我们"}, {"start": 1651.38, "end": 1652.5, "text": "是临时抱佛脚"}, {"start": 1653.34, "end": 1654.22, "text": "与主人不公吧"}, {"start": 1656.42, "end": 1656.74, "text": "好"}, {"start": 1657.02, "end": 1658.7, "text": "那靠岸让人采买些吧"}, {"start": 1659.7, "end": 1660.06, "text": "遵命"}, {"start": 1680.98, "end": 1681.86, "text": "这五百士族"}, {"start": 1682.46, "end": 1683.38, "text": "分成十人一队"}, {"start": 1684.1, "end": 1685.5, "text": "每队带足黄金钱币"}, {"start": 1686.22, "end": 1687.66, "text": "热热闹闹去采购"}, {"start": 1688.66, "end": 1689.86, "text": "要让全镇的人都知道"}, {"start": 1690.74, "end": 1692.86, "text": "刘皇叔父母成亲了"}, {"start": 1693.3, "end": 1693.7, "text": "遵命"}, {"start": 1716.66, "end": 1717.22, "text": "店家"}, {"start": 1717.86, "end": 1719.46, "text": "我有上好的绸缎啊"}, {"start": 1721.34, "end": 1722.22, "text": "禀君爷"}, {"start": 1722.66, "end": 1723.7, "text": "本店经营的"}, {"start": 1723.7, "end": 1725.7, "text": "那都是上好的绸缎哪"}, {"start": 1726.26, "end": 1727.78, "text": "就连太夫人用的"}, {"start": 1727.78, "end": 1730.18, "text": "那都是本店送到侯府里去的"}, {"start": 1730.46, "end": 1731.58, "text": "这些绸缎我全要了"}, {"start": 1732.02, "end": 1732.7, "text": "立刻搁人"}, {"start": 1733.14, "end": 1734.1, "text": "把末将位子传上去"}, {"start": 1734.3, "end": 1735.82, "text": "这 这绸缎你都要了"}, {"start": 1736.54, "end": 1738.18, "text": "那可值三百斤哪"}, {"start": 1738.46, "end": 1739.54, "text": "三百斤算什么"}, {"start": 1740.34, "end": 1742.1, "text": "吴侯的妹子要嫁我家主公了"}, {"start": 1742.38, "end": 1743.74, "text": "那可是千金小姐"}, {"start": 1744.06, "end": 1745.94, "text": "那 那你家主子是谁啊"}, {"start": 1746.62, "end": 1747.5, "text": "刘皇叔"}, {"start": 1748.34, "end": 1748.78, "text": "师父"}, {"start": 1749.38, "end": 1751.1, "text": "我过来采购聘礼了吗"}, {"start": 1752.26, "end": 1754.18, "text": "那可是天大的喜事啊"}, {"start": 1754.94, "end": 1755.46, "text": "伙计们"}, {"start": 1755.7, "end": 1756.58, "text": "快点装会啊"}, {"start": 1756.66, "end": 1758.14, "text": "快点快点啊"}, {"start": 1771.45, "end": 1771.85, "text": "主公"}, {"start": 1772.45, "end": 1773.93, "text": "满街都是传言哪"}, {"start": 1774.69, "end": 1775.33, "text": "说刘备"}, {"start": 1775.49, "end": 1777.13, "text": "来我东吴成亲来了"}, {"start": 1778.01, "end": 1780.01, "text": "而且他们大肆采购聘礼"}, {"start": 1780.53, "end": 1783.65, "text": "昨天他们几乎把卢江镇都买空了"}, {"start": 1785.09, "end": 1786.25, "text": "估计明天一早"}, {"start": 1786.73, "end": 1788.05, "text": "就该到建康了"}, {"start": 1792.98, "end": 1793.94, "text": "怎么来得这么快"}, {"start": 1807.34, "end": 1807.74, "text": "不好"}, {"start": 1808.5, "end": 1809.7, "text": "刘备大肆购买聘礼"}, {"start": 1809.9, "end": 1810.9, "text": "闹得满城风雨"}, {"start": 1811.62, "end": 1812.22, "text": "这件事"}, {"start": 1812.62, "end": 1814.1, "text": "必然会传到母亲的耳朵里"}, {"start": 1814.94, "end": 1816.38, "text": "万一他老人家生气气来"}, {"start": 1816.66, "end": 1817.7, "text": "该如何是好啊"}, {"start": 1818.34, "end": 1819.06, "text": "这件事情"}, {"start": 1819.58, "end": 1821.1, "text": "他可是一无所知啊"}, {"start": 1821.5, "end": 1829.62, "text": "母亲"}, {"start": 1838.18, "end": 1838.58, "text": "子稷"}, {"start": 1838.94, "end": 1839.46, "text": "太夫人"}, {"start": 1839.9, "end": 1840.62, "text": "你下去"}, {"start": 1840.98, "end": 1841.3, "text": "诺"}, {"start": 1844.61, "end": 1845.13, "text": "母亲"}, {"start": 1847.37, "end": 1848.13, "text": "孩儿正要"}, {"start": 1848.13, "end": 1848.81, "text": "你住嘴"}, {"start": 1850.73, "end": 1852.41, "text": "你眼里还有我这个娘吗"}, {"start": 1853.25, "end": 1855.33, "text": "虽说男大当婚女大当嫁"}, {"start": 1855.73, "end": 1857.25, "text": "可我毕竟是你母亲"}, {"start": 1858.49, "end": 1859.85, "text": "你妹子是我女儿"}, {"start": 1860.61, "end": 1862.41, "text": "你做儿子的要嫁我女儿"}, {"start": 1862.85, "end": 1864.85, "text": "竟然不跟为娘的说一声"}, {"start": 1865.45, "end": 1866.77, "text": "你好大的胆啊"}, {"start": 1867.37, "end": 1868.25, "text": "你放肆"}, {"start": 1868.53, "end": 1868.85, "text": "我"}, {"start": 1869.85, "end": 1870.45, "text": "母亲"}, {"start": 1871.29, "end": 1872.25, "text": "孩儿知错了"}, {"start": 1873.33, "end": 1874.73, "text": "这都是朱公瑾的主意"}, {"start": 1875.57, "end": 1876.37, "text": "她想促成"}, {"start": 1876.85, "end": 1878.57, "text": "孙柳两家勤尽之好"}, {"start": 1879.05, "end": 1879.97, "text": "共抗曹军"}, {"start": 1882.23, "end": 1884.39, "text": "难道东吴的男人都死光了吗"}, {"start": 1884.95, "end": 1887.03, "text": "要用我这个女儿来做抵押"}, {"start": 1887.31, "end": 1889.55, "text": "去换取与刘备的联盟"}, {"start": 1890.55, "end": 1890.95, "text": "好"}, {"start": 1891.83, "end": 1892.87, "text": "我记得那刘备"}, {"start": 1893.15, "end": 1894.75, "text": "和你父亲是一辈人"}, {"start": 1895.27, "end": 1896.95, "text": "如今得多大岁数了"}, {"start": 1897.71, "end": 1899.99, "text": "你把自己的七妹妹嫁给他"}, {"start": 1900.83, "end": 1902.43, "text": "你忍得下这个心吗"}, {"start": 1903.03, "end": 1903.75, "text": "母亲 我"}, {"start": 1903.75, "end": 1904.23, "text": "你"}, {"start": 1905.87, "end": 1907.67, "text": "派人去把周瑜换来"}, {"start": 1908.35, "end": 1909.47, "text": "我要骂死他"}, {"start": 1914.18, "end": 1914.58, "text": "好"}, {"start": 1915.1, "end": 1915.86, "text": "还有你"}, {"start": 1916.78, "end": 1918.54, "text": "亏你还是祝国大夫"}, {"start": 1919.1, "end": 1920.42, "text": "看你主子办傻事"}, {"start": 1920.94, "end": 1922.94, "text": "怎么就不知道说句明白话"}, {"start": 1928.91, "end": 1929.71, "text": "叫周瑜来"}, {"start": 1930.15, "end": 1930.83, "text": "我等着"}, {"start": 1943.62, "end": 1944.06, "text": "紫荆"}, {"start": 1944.54, "end": 1945.38, "text": "快起来吧"}, {"start": 1945.82, "end": 1946.7, "text": "想想这戏"}, {"start": 1947.1, "end": 1948.34, "text": "该怎么收场啊"}, {"start": 1962.22, "end": 1962.82, "text": "朱公啊"}, {"start": 1963.06, "end": 1965.06, "text": "刘备现在既然已经来了"}, {"start": 1966.06, "end": 1967.82, "text": "不管这事以后成不成"}, {"start": 1968.54, "end": 1971.06, "text": "你总该先尽地主之谊吧"}, {"start": 1971.82, "end": 1974.34, "text": "这其他的事"}, {"start": 1975.5, "end": 1977.3, "text": "还是等公瑾回来以后"}, {"start": 1977.7, "end": 1978.9, "text": "咱们再议一把"}, {"start": 1979.1, "end": 1982.7, "text": "你先去码头迎接"}, {"start": 1983.94, "end": 1985.74, "text": "留他们在管驿住下"}, {"start": 1987.46, "end": 1987.98, "text": "遵命"}, {"start": 1988.34, "end": 1989.42, "text": "带我上前把他拿下"}, {"start": 2019.82, "end": 2020.3, "text": "慢着"}, {"start": 2020.62, "end": 2026.61, "text": "现在已经下不了手了"}, {"start": 2027.01, "end": 2027.65, "text": "赵将军"}, {"start": 2034.59, "end": 2035.63, "text": "赵云拜见"}, {"start": 2035.91, "end": 2036.91, "text": "赵云拜见大人"}, {"start": 2041.51, "end": 2042.23, "text": "刘皇叔"}, {"start": 2043.95, "end": 2045.59, "text": "刘皇叔一路辛苦了"}, {"start": 2047.56, "end": 2048.84, "text": "紫荆别来无恙啊"}, {"start": 2050.12, "end": 2052.4, "text": "没想到刘皇叔来得这么快啊"}, {"start": 2052.84, "end": 2054.32, "text": "也没事先知会一声"}, {"start": 2054.56, "end": 2054.92, "text": "你看"}, {"start": 2055.24, "end": 2057.2, "text": "我们连古月遗障都没有准备"}, {"start": 2057.44, "end": 2058.72, "text": "实在是抱歉哪"}, {"start": 2060.72, "end": 2062.08, "text": "我是成亲心切"}, {"start": 2062.72, "end": 2063.72, "text": "老天也相佑"}, {"start": 2064.16, "end": 2065.56, "text": "江上一帆风顺"}, {"start": 2065.88, "end": 2067.28, "text": "本来是五日的路程"}, {"start": 2067.4, "end": 2068.32, "text": "三日就到了"}, {"start": 2068.6, "end": 2069.2, "text": "好好好"}, {"start": 2069.8, "end": 2070.6, "text": "刘皇叔请"}, {"start": 2074.01, "end": 2076.09, "text": "我已经叫人洒扫过管驿了"}, {"start": 2076.49, "end": 2077.69, "text": "皇叔先去安歇"}, {"start": 2077.97, "end": 2080.01, "text": "我家主公随后就来拜见"}, {"start": 2083.81, "end": 2084.13, "text": "撤"}, {"start": 2089.25, "end": 2090.89, "text": "紫荆没有准备古月"}, {"start": 2091.25, "end": 2092.97, "text": "却准备了不少精兵战甲"}, {"start": 2095.85, "end": 2098.65, "text": "也许是皇叔驾到的消息传开了"}, {"start": 2099.09, "end": 2099.49, "text": "你看"}, {"start": 2100.17, "end": 2102.21, "text": "连刺史那里都带来了卫士"}, {"start": 2102.57, "end": 2104.29, "text": "来保护皇叔的安全"}, {"start": 2107.1, "end": 2108.82, "text": "东吴朋友想得真是周到"}, {"start": 2109.34, "end": 2110.5, "text": "刘备多谢了"}, {"start": 2111.06, "end": 2111.38, "text": "请"}, {"start": 2126.9, "end": 2127.98, "text": "来人可是大都督"}, {"start": 2135.54, "end": 2136.58, "text": "事情怎么样了"}, {"start": 2138.42, "end": 2139.06, "text": "禀大都督"}, {"start": 2139.82, "end": 2140.9, "text": "末将还是迟了一步"}, {"start": 2141.62, "end": 2143.94, "text": "刘备已经被鲁素迎入管驿"}, {"start": 2151.06, "end": 2152.78, "text": "怎么又让紫荆占了先"}, {"start": 2158.33, "end": 2158.81, "text": "你怎么样"}, {"start": 2160.87, "end": 2161.43, "text": "不安心"}, {"start": 2169.28, "end": 2169.52, "text": "诺"}, {"start": 2181.74, "end": 2182.74, "text": "主公请用膳"}, {"start": 2183.06, "end": 2183.42, "text": "放下吧"}, {"start": 2186.9, "end": 2187.74, "text": "鲁素回来了吗"}, {"start": 2191.41, "end": 2193.33, "text": "他在驿馆为刘备摆酒接风"}, {"start": 2206.09, "end": 2206.49, "text": "紫荆"}, {"start": 2208.13, "end": 2209.13, "text": "是紫荆回来了吗"}, {"start": 2213.42, "end": 2214.54, "text": "周瑜拜见主公"}, {"start": 2214.98, "end": 2215.62, "text": "公谨"}, {"start": 2217.14, "end": 2217.58, "text": "公谨"}, {"start": 2218.46, "end": 2219.26, "text": "身体如何"}, {"start": 2220.7, "end": 2221.02, "text": "还好"}, {"start": 2222.18, "end": 2222.62, "text": "公谨"}, {"start": 2223.22, "end": 2224.26, "text": "你来得正是时候"}, {"start": 2225.58, "end": 2226.74, "text": "刘备已来到建康"}, {"start": 2227.02, "end": 2228.22, "text": "弄得满城风雨"}, {"start": 2229.26, "end": 2231.42, "text": "招亲之事已成难局"}, {"start": 2232.06, "end": 2233.9, "text": "太夫人大发雷霆"}, {"start": 2235.18, "end": 2236.46, "text": "这些事我都已经知道了"}, {"start": 2237.7, "end": 2238.06, "text": "主公"}, {"start": 2238.78, "end": 2240.1, "text": "你是怎么向太夫人解释的"}, {"start": 2241.14, "end": 2241.78, "text": "我跟她说"}, {"start": 2242.5, "end": 2243.42, "text": "招刘备成亲"}, {"start": 2243.74, "end": 2244.86, "text": "是为了孙刘联盟"}, {"start": 2245.58, "end": 2246.38, "text": "可尚未开口"}, {"start": 2247.06, "end": 2248.18, "text": "已遭一头痛骂"}, {"start": 2248.62, "end": 2248.9, "text": "主公"}, {"start": 2249.78, "end": 2251.3, "text": "为今之计必须毫不相瞒"}, {"start": 2251.54, "end": 2252.5, "text": "直言禀报太夫人"}, {"start": 2253.14, "end": 2254.54, "text": "就说招刘备成亲是假"}, {"start": 2254.98, "end": 2255.62, "text": "拘押刘备"}, {"start": 2255.9, "end": 2256.9, "text": "逼还荆州市镇"}, {"start": 2258.46, "end": 2258.98, "text": "而且主公"}, {"start": 2259.38, "end": 2260.38, "text": "您可以将全部罪责"}, {"start": 2260.7, "end": 2261.46, "text": "推到我的身上"}, {"start": 2261.98, "end": 2263.26, "text": "就说是公谨一意为之"}, {"start": 2263.78, "end": 2264.46, "text": "你好不知情"}, {"start": 2267.3, "end": 2267.86, "text": "不妥吧"}, {"start": 2269.06, "end": 2270.06, "text": "如果太夫人觉得"}, {"start": 2270.74, "end": 2271.78, "text": "我们是在欺骗她"}, {"start": 2271.9, "end": 2272.5, "text": "岂不更怒"}, {"start": 2274.38, "end": 2276.22, "text": "江东文武也会大感突然"}, {"start": 2276.66, "end": 2277.78, "text": "只要能够取回荆州"}, {"start": 2279.02, "end": 2280.22, "text": "他们人人都会高兴的"}, {"start": 2282.53, "end": 2283.41, "text": "难道不是这样吗"}, {"start": 2291.79, "end": 2292.47, "text": "还有一件事"}, {"start": 2293.19, "end": 2294.47, "text": "我必须向主公禀报"}, {"start": 2295.43, "end": 2295.75, "text": "公谨"}, {"start": 2296.15, "end": 2296.67, "text": "这是为何"}, {"start": 2297.03, "end": 2297.63, "text": "起来说话"}, {"start": 2300.15, "end": 2301.03, "text": "刘备起刑时"}, {"start": 2301.43, "end": 2302.67, "text": "我已经密令六万大军"}, {"start": 2302.79, "end": 2303.71, "text": "向荆州开拔"}, {"start": 2306.34, "end": 2307.58, "text": "你要动兵袭取荆州"}, {"start": 2308.18, "end": 2309.14, "text": "朱国良早有准备"}, {"start": 2309.38, "end": 2311.06, "text": "你不怕记忆孙刘两家大战吗"}, {"start": 2311.3, "end": 2311.62, "text": "主公"}, {"start": 2312.38, "end": 2313.42, "text": "此战早晚不免"}, {"start": 2313.9, "end": 2315.58, "text": "现在这个时机恰恰对我们有利"}, {"start": 2316.66, "end": 2317.62, "text": "刘备已到建康"}, {"start": 2318.34, "end": 2319.38, "text": "他是差池难飞"}, {"start": 2320.26, "end": 2321.66, "text": "荆州现在群龙无首"}, {"start": 2322.3, "end": 2323.86, "text": "我已经做好了万全的准备"}, {"start": 2324.26, "end": 2325.06, "text": "此战必胜"}, {"start": 2326.26, "end": 2327.78, "text": "主公如果担心天下人非议"}, {"start": 2328.22, "end": 2328.7, "text": "那好办"}, {"start": 2329.1, "end": 2331.47, "text": "等荆州之后"}, {"start": 2331.71, "end": 2334.79, "text": "主公可将全部罪责"}, {"start": 2334.79, "end": 2335.67, "text": "推到我的身上"}, {"start": 2336.51, "end": 2337.19, "text": "除以军法"}, {"start": 2338.11, "end": 2339.27, "text": "如果我向上人头"}, {"start": 2340.23, "end": 2341.51, "text": "堵得了天下人的嘴"}, {"start": 2344.17, "end": 2345.25, "text": "我也含笑九泉了"}, {"start": 2356.35, "end": 2357.31, "text": "既然主公同意"}, {"start": 2358.03, "end": 2359.27, "text": "我这就去觐见太夫人"}, {"start": 2360.91, "end": 2361.35, "text": "公谨"}, {"start": 2386.66, "end": 2387.9, "text": "我觉得这个事情"}, {"start": 2390.9, "end": 2394.86, "text": "不能这么办"}, {"start": 2395.14, "end": 2396.82, "text": "若太夫人不知此事"}, {"start": 2398.46, "end": 2400.38, "text": "还可以公谨之计行事"}, {"start": 2401.18, "end": 2403.3, "text": "但现在太夫人已经知道了"}, {"start": 2403.74, "end": 2405.58, "text": "刘备来建康招亲的事"}, {"start": 2407.69, "end": 2410.05, "text": "她老人家从小交给我们兄弟俩"}, {"start": 2410.81, "end": 2411.81, "text": "忠孝仁义"}, {"start": 2412.93, "end": 2413.69, "text": "她若知道"}, {"start": 2414.61, "end": 2416.09, "text": "我嫁小妹转刘备"}, {"start": 2417.05, "end": 2418.65, "text": "是为了换荆州的话"}, {"start": 2420.13, "end": 2421.97, "text": "她一定不会宽恕我的"}, {"start": 2424.12, "end": 2425.2, "text": "主公你真的是因为"}, {"start": 2425.2, "end": 2426.12, "text": "担心太夫人吗"}, {"start": 2428.98, "end": 2429.5, "text": "就算"}, {"start": 2431.5, "end": 2432.5, "text": "不完全是吧"}]