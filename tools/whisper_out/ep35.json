[{"start": 8.18, "end": 10.18, "text": "来,二哥,过酒。"}, {"start": 10.18, "end": 11.18, "text": "关将军,张..."}, {"start": 12.18, "end": 15.18, "text": "二位将军,二位将军,主公让你们赶紧过去啊。"}, {"start": 18.42, "end": 19.42, "text": "什么事?"}, {"start": 20.42, "end": 23.42, "text": "夏侯敦轻率大军朝新野城杀过来了。"}, {"start": 23.42, "end": 27.42, "text": "来了好啊,总算把他们给盼来了。"}, {"start": 29.42, "end": 32.42, "text": "你去告诉大哥,叫那孔明去迎敌啊。"}, {"start": 33.42, "end": 36.42, "text": "这大敌当前,你们这是为何呀?"}, {"start": 36.42, "end": 37.42, "text": "快去啊。"}, {"start": 37.42, "end": 44.18, "text": "三弟,来。"}, {"start": 45.18, "end": 55.82, "text": "二弟三弟,"}, {"start": 56.82, "end": 59.82, "text": "曹军已经逼近樊城了,你们还在吃喝。"}, {"start": 59.82, "end": 61.82, "text": "快快整军,准备迎敌。"}, {"start": 65.09, "end": 66.09, "text": "哥啊,"}, {"start": 66.09, "end": 68.09, "text": "我有一计,定可退敌。"}, {"start": 70.66, "end": 71.66, "text": "你也有计?"}, {"start": 71.66, "end": 73.66, "text": "有啊,有啊。"}, {"start": 74.66, "end": 76.66, "text": "只是大哥从不问计,"}, {"start": 77.66, "end": 78.66, "text": "我面子薄,"}, {"start": 79.66, "end": 81.66, "text": "又不好意思说。"}, {"start": 81.66, "end": 85.15, "text": "你且说来。"}, {"start": 87.69, "end": 88.69, "text": "大哥使水去啊。"}, {"start": 88.69, "end": 89.69, "text": "水?"}, {"start": 90.69, "end": 93.29, "text": "什么意思?"}, {"start": 94.29, "end": 97.29, "text": "大哥是鱼,那孔明是水啊。"}, {"start": 98.29, "end": 101.29, "text": "现在曹军来了,你快快使水出战,"}, {"start": 102.29, "end": 103.29, "text": "让他水淹三军啊。"}, {"start": 107.29, "end": 109.29, "text": "大哥,哥,大哥。"}, {"start": 111.29, "end": 113.29, "text": "志赖孔明,永虚二弟。"}, {"start": 114.29, "end": 116.29, "text": "我没工夫跟你们开玩笑,快快整军。"}, {"start": 117.29, "end": 120.29, "text": "三弟,扒他扒他,快取兵器。"}, {"start": 123.57, "end": 125.57, "text": "命苦啊,命苦啊。"}, {"start": 125.57, "end": 127.57, "text": "这大敌当前,"}, {"start": 127.57, "end": 129.57, "text": "兄长才想起还有俩兄弟。"}, {"start": 132.57, "end": 148.09, "text": "云长和易得都是傲视天下的汉将。"}, {"start": 149.09, "end": 152.09, "text": "你须在此战中建立威望,"}, {"start": 152.09, "end": 154.09, "text": "方能够镇住他们。"}, {"start": 155.09, "end": 156.09, "text": "明白。"}, {"start": 157.09, "end": 158.09, "text": "我有一事,"}, {"start": 159.09, "end": 162.09, "text": "请主公将佩剑兵符借我十日,"}, {"start": 162.09, "end": 164.09, "text": "否则我可使不动两位将军。"}, {"start": 165.09, "end": 176.2, "text": "十日够吗?"}, {"start": 176.2, "end": 177.2, "text": "足够。"}, {"start": 177.2, "end": 183.29, "text": "你须谨记,"}, {"start": 184.29, "end": 186.29, "text": "兵符剑印都在你手上,"}, {"start": 186.29, "end": 188.63, "text": "也得听命。"}, {"start": 189.63, "end": 190.63, "text": "主公放心。"}, {"start": 191.63, "end": 204.06, "text": "王将军,"}, {"start": 205.06, "end": 208.06, "text": "张将军,军师传众将登堂听令了。"}, {"start": 210.06, "end": 212.06, "text": "这孔明真是要指挥我们作战了。"}, {"start": 213.06, "end": 215.06, "text": "不在那儿,我们自个儿率军杀敌就是了。"}, {"start": 216.06, "end": 218.06, "text": "那可不行,军令如山,"}, {"start": 218.06, "end": 220.06, "text": "我们还是前去听听他胡说些什么。"}, {"start": 221.06, "end": 222.06, "text": "走。"}, {"start": 223.06, "end": 239.48, "text": "谢主公。"}, {"start": 239.48, "end": 244.8, "text": "曹军来犯,"}, {"start": 245.8, "end": 246.8, "text": "大战将至,"}, {"start": 247.8, "end": 250.8, "text": "诸将定要遵奉军师军令,"}, {"start": 251.8, "end": 252.8, "text": "违者"}, {"start": 253.8, "end": 254.8, "text": "依法从事。"}, {"start": 254.8, "end": 255.8, "text": "遵命。"}, {"start": 256.8, "end": 259.27, "text": "曹兵进军,"}, {"start": 260.27, "end": 262.27, "text": "必须路经博望坡,"}, {"start": 263.27, "end": 265.27, "text": "博望其左有山,"}, {"start": 265.27, "end": 266.27, "text": "名曰玉山,"}, {"start": 266.27, "end": 267.27, "text": "其右有陵,"}, {"start": 267.27, "end": 268.27, "text": "名曰安陵,"}, {"start": 269.27, "end": 272.27, "text": "山洼与陵间皆可伏兵。"}, {"start": 273.27, "end": 274.27, "text": "关羽听令。"}, {"start": 275.27, "end": 276.27, "text": "你引一千径旅,"}, {"start": 276.27, "end": 282.3, "text": "前往玉山埋伏,"}, {"start": 283.3, "end": 284.3, "text": "待曹军治,"}, {"start": 284.3, "end": 285.3, "text": "必须放他们过,"}, {"start": 285.3, "end": 287.3, "text": "其粮草资重定在军后,"}, {"start": 288.3, "end": 289.3, "text": "但见南面火起,"}, {"start": 289.3, "end": 290.3, "text": "你即率军杀出,"}, {"start": 291.3, "end": 292.3, "text": "交战之时,"}, {"start": 292.3, "end": 293.3, "text": "不可贪恋斩获。"}, {"start": 294.3, "end": 296.3, "text": "首先焚烧尽粮草,"}, {"start": 296.3, "end": 297.3, "text": "熄火"}, {"start": 297.3, "end": 299.3, "text": "也可阻断曹军的退伍。"}, {"start": 299.3, "end": 300.3, "text": "知道了。"}, {"start": 300.3, "end": 301.3, "text": "张飞听令。"}, {"start": 304.54, "end": 308.19, "text": "卓尼,"}, {"start": 308.19, "end": 309.19, "text": "引一千径旅,"}, {"start": 309.19, "end": 316.18, "text": "在安陵之后埋伏,"}, {"start": 316.18, "end": 317.18, "text": "但见南面火起,"}, {"start": 317.18, "end": 318.18, "text": "即率军杀出,"}, {"start": 318.18, "end": 319.18, "text": "直奔博望城。"}, {"start": 320.18, "end": 321.18, "text": "你才不是说过"}, {"start": 321.18, "end": 323.18, "text": "曹军在博望坡吗?"}, {"start": 324.18, "end": 325.18, "text": "你叫我进城干什么?"}, {"start": 325.18, "end": 327.18, "text": "这是谦言不达厚语。"}, {"start": 328.18, "end": 330.18, "text": "博望坡是曹军进军之地,"}, {"start": 330.18, "end": 331.18, "text": "博望城"}, {"start": 331.18, "end": 333.18, "text": "则是曹军驻军之所,"}, {"start": 333.18, "end": 334.18, "text": "其粮草军械"}, {"start": 334.18, "end": 336.18, "text": "避屯于城中,"}, {"start": 336.18, "end": 337.18, "text": "令以纵火"}, {"start": 337.18, "end": 338.18, "text": "焚烧。"}, {"start": 339.18, "end": 340.18, "text": "官平听令。"}, {"start": 342.94, "end": 343.94, "text": "末将在。"}, {"start": 344.94, "end": 345.94, "text": "你率五百将士"}, {"start": 345.94, "end": 346.94, "text": "携带萤火之物,"}, {"start": 346.94, "end": 348.94, "text": "在博望城后等候,"}, {"start": 348.94, "end": 349.94, "text": "待张飞军至,"}, {"start": 349.94, "end": 351.94, "text": "即可纵火。"}, {"start": 351.94, "end": 352.94, "text": "领命。"}, {"start": 352.94, "end": 353.94, "text": "弥方听令。"}, {"start": 354.94, "end": 355.94, "text": "在。"}, {"start": 355.94, "end": 357.94, "text": "你速去樊城召回赵云,"}, {"start": 357.94, "end": 359.94, "text": "令其率军为前步,"}, {"start": 359.94, "end": 361.94, "text": "与曹军交战之时,"}, {"start": 361.94, "end": 362.94, "text": "只可败,"}, {"start": 362.94, "end": 363.94, "text": "不许胜。"}, {"start": 363.94, "end": 364.94, "text": "遵命。"}, {"start": 364.94, "end": 365.94, "text": "主公。"}, {"start": 365.94, "end": 366.94, "text": "刘公。"}, {"start": 366.94, "end": 369.35, "text": "主公。"}, {"start": 369.35, "end": 374.77, "text": "刘备在。"}, {"start": 375.77, "end": 378.77, "text": "请主公率三千铁骑督战,"}, {"start": 378.77, "end": 379.77, "text": "并担任后援。"}, {"start": 379.77, "end": 380.77, "text": "遵命。"}, {"start": 381.77, "end": 395.12, "text": "请问军师,"}, {"start": 395.12, "end": 398.12, "text": "我们大家都出去杀敌了,"}, {"start": 398.12, "end": 399.12, "text": "你做什么?"}, {"start": 400.12, "end": 401.12, "text": "我嘛。"}, {"start": 402.12, "end": 404.12, "text": "镇守城关。"}, {"start": 406.12, "end": 408.12, "text": "我们在外面拼命,"}, {"start": 408.12, "end": 410.12, "text": "你却在这里坐地喝茶?"}, {"start": 411.12, "end": 412.12, "text": "好自在啊。"}, {"start": 412.12, "end": 416.53, "text": "主公建议接负于我,"}, {"start": 416.53, "end": 418.53, "text": "抗命者,"}, {"start": 418.53, "end": 419.53, "text": "斩。"}, {"start": 419.53, "end": 422.87, "text": "运筹帷幄之中,"}, {"start": 422.87, "end": 424.87, "text": "绝胜千里之外,"}, {"start": 424.87, "end": 426.87, "text": "抗命者,"}, {"start": 426.87, "end": 427.87, "text": "斩。"}, {"start": 427.87, "end": 433.97, "text": "众位将军,"}, {"start": 433.97, "end": 434.97, "text": "按我刚才的分派,"}, {"start": 434.97, "end": 436.97, "text": "速速行事。"}, {"start": 436.97, "end": 437.97, "text": "遵命。"}, {"start": 437.97, "end": 443.23, "text": "别照他说的做,"}, {"start": 443.23, "end": 444.23, "text": "我不应言,"}, {"start": 444.23, "end": 445.23, "text": "回来再算账。"}, {"start": 445.23, "end": 446.23, "text": "也罢。"}, {"start": 446.23, "end": 454.59, "text": "主公。"}, {"start": 454.59, "end": 461.42, "text": "请主公放心。"}, {"start": 462.42, "end": 465.42, "text": "主公今日便可去博王山下屯军,"}, {"start": 465.42, "end": 467.42, "text": "明日黄昏曹军必到,"}, {"start": 467.42, "end": 470.42, "text": "到那时主公就要弃婴而逃,"}, {"start": 470.42, "end": 472.42, "text": "逃得越狼狈越好,"}, {"start": 472.42, "end": 473.42, "text": "但见难免火起,"}, {"start": 473.42, "end": 475.42, "text": "回军眼杀。"}, {"start": 475.42, "end": 478.31, "text": "好。"}, {"start": 479.31, "end": 481.31, "text": "忘了告诉简庸孙乾了,"}, {"start": 481.31, "end": 483.31, "text": "让他们提前准备好庆功酒宴,"}, {"start": 483.31, "end": 485.31, "text": "并安排功劳部侍候着。"}, {"start": 486.31, "end": 487.31, "text": "军师啊,"}, {"start": 487.31, "end": 489.31, "text": "尚未开战,"}, {"start": 489.31, "end": 491.31, "text": "就准备庆功宴。"}, {"start": 493.31, "end": 494.31, "text": "提前准备嘛,"}, {"start": 494.31, "end": 496.31, "text": "免得到时不及。"}, {"start": 496.31, "end": 500.13, "text": "好。"}, {"start": 500.13, "end": 523.4, "text": "侯叔。"}, {"start": 523.4, "end": 525.4, "text": "公子,"}, {"start": 525.4, "end": 526.4, "text": "公子,"}, {"start": 526.4, "end": 528.4, "text": "荆州出什么事了?"}, {"start": 529.4, "end": 531.4, "text": "母亲病情越来越严重,"}, {"start": 531.4, "end": 534.4, "text": "我几次探望都被蔡师挡架,"}, {"start": 534.4, "end": 537.68, "text": "我已经十几天见不到父亲面了。"}, {"start": 537.68, "end": 545.32, "text": "这个蔡报究竟想干什么?"}, {"start": 545.32, "end": 548.32, "text": "蔡报和亲母整日关起门来密谋,"}, {"start": 548.32, "end": 551.32, "text": "蔡师主兄弟也全部到了荆州,"}, {"start": 551.32, "end": 553.32, "text": "他们必有不轨之举啊。"}, {"start": 553.32, "end": 554.32, "text": "侯叔,"}, {"start": 554.32, "end": 556.32, "text": "行事堪威,"}, {"start": 556.32, "end": 558.32, "text": "我在城中孤独无靠,"}, {"start": 558.32, "end": 559.32, "text": "无兵无勇,"}, {"start": 559.32, "end": 562.82, "text": "听侯叔设法救我。"}, {"start": 562.82, "end": 563.82, "text": "起来。"}, {"start": 563.82, "end": 564.82, "text": "贤侄啊,"}, {"start": 570.82, "end": 571.82, "text": "曹军将至,"}, {"start": 571.82, "end": 573.82, "text": "我这就要前去迎敌。"}, {"start": 573.82, "end": 574.82, "text": "再说,"}, {"start": 574.82, "end": 575.82, "text": "论制谋,"}, {"start": 575.82, "end": 576.82, "text": "我也远不及孔明。"}, {"start": 576.82, "end": 577.82, "text": "这样,"}, {"start": 577.82, "end": 578.82, "text": "你马上去找孔明,"}, {"start": 578.82, "end": 580.82, "text": "他定有妙计相救。"}, {"start": 581.82, "end": 587.14, "text": "我已经找过他了,"}, {"start": 587.14, "end": 588.14, "text": "可他说,"}, {"start": 588.14, "end": 590.14, "text": "我们是客居荆州,"}, {"start": 591.14, "end": 593.14, "text": "绝不介入荆州内部之争。"}, {"start": 593.14, "end": 594.14, "text": "如不愿设计,"}, {"start": 594.14, "end": 603.85, "text": "你也可以逼他出主意啊。"}, {"start": 603.85, "end": 604.85, "text": "这,"}, {"start": 604.85, "end": 607.19, "text": "如何逼?"}, {"start": 607.19, "end": 608.19, "text": "刘公子,"}, {"start": 608.19, "end": 629.97, "text": "先生大驾光临,"}, {"start": 629.97, "end": 633.5, "text": "寒舍蓬璧升辉。"}, {"start": 633.5, "end": 635.5, "text": "公子府绝非寒舍,"}, {"start": 635.5, "end": 636.5, "text": "区区在下,"}, {"start": 636.5, "end": 638.5, "text": "也没法令其升辉。"}, {"start": 638.5, "end": 639.5, "text": "无论如何,"}, {"start": 639.5, "end": 641.5, "text": "先生能到碧府来,"}, {"start": 641.5, "end": 642.5, "text": "在下莫大欣慰。"}, {"start": 642.5, "end": 643.5, "text": "公子招在下来,"}, {"start": 643.5, "end": 645.5, "text": "在下不敢不来。"}, {"start": 645.5, "end": 647.5, "text": "只是在下有言在先,"}, {"start": 647.5, "end": 649.5, "text": "如若谈及令尊病况,"}, {"start": 649.5, "end": 651.5, "text": "或者荆州争处夺位之事,"}, {"start": 651.5, "end": 652.5, "text": "在下不敢善意,"}, {"start": 652.5, "end": 653.5, "text": "只能立刻就走。"}, {"start": 653.5, "end": 655.5, "text": "请公子多多见谅。"}, {"start": 655.5, "end": 656.5, "text": "不谈不谈,"}, {"start": 656.5, "end": 657.5, "text": "我请先生来,"}, {"start": 657.5, "end": 658.5, "text": "只是想让先生"}, {"start": 658.5, "end": 660.5, "text": "观看一部上古兵书,"}, {"start": 660.5, "end": 662.5, "text": "并请教其中不解之处。"}, {"start": 662.5, "end": 663.5, "text": "如此便好说了。"}, {"start": 663.5, "end": 664.5, "text": "先生请。"}, {"start": 664.5, "end": 665.5, "text": "好。"}, {"start": 665.5, "end": 666.5, "text": "请问公子,"}, {"start": 666.5, "end": 671.38, "text": "是哪部兵书啊?"}, {"start": 672.38, "end": 673.38, "text": "六合阵法。"}, {"start": 673.38, "end": 675.38, "text": "六合阵法?"}, {"start": 675.38, "end": 677.38, "text": "不可能吧?"}, {"start": 677.38, "end": 678.38, "text": "这部兵书"}, {"start": 678.38, "end": 681.38, "text": "早在世上绝迹五百多年。"}, {"start": 681.38, "end": 682.38, "text": "封闻,"}, {"start": 682.38, "end": 684.38, "text": "他被楚香王埋于坟中,"}, {"start": 684.38, "end": 686.38, "text": "为他的父亲殉葬了。"}, {"start": 686.38, "end": 688.38, "text": "真是可惜啊。"}, {"start": 688.38, "end": 689.38, "text": "公子,"}, {"start": 689.38, "end": 690.38, "text": "你莫要夸我啊。"}, {"start": 690.38, "end": 691.38, "text": "不错。"}, {"start": 691.38, "end": 692.38, "text": "六合阵法"}, {"start": 692.38, "end": 694.38, "text": "确实埋进楚王墓里了。"}, {"start": 694.38, "end": 696.38, "text": "但这几百年下来,"}, {"start": 696.38, "end": 698.38, "text": "会不会被盗墓人挖出,"}, {"start": 698.38, "end": 701.38, "text": "又会不会流落在街巷书寺,"}, {"start": 701.38, "end": 703.38, "text": "更会不会被某位贵公子"}, {"start": 703.38, "end": 704.38, "text": "以千金购得,"}, {"start": 704.38, "end": 708.38, "text": "之后珍藏于高楼威阁啊?"}, {"start": 708.38, "end": 709.38, "text": "公子,"}, {"start": 709.38, "end": 711.38, "text": "你真有这本书吗?"}, {"start": 711.38, "end": 712.38, "text": "六合阵法"}, {"start": 712.38, "end": 714.38, "text": "就藏于此楼中。"}, {"start": 714.38, "end": 716.38, "text": "我一直觅不识人,"}, {"start": 716.38, "end": 717.38, "text": "但我读来读去,"}, {"start": 717.38, "end": 720.5, "text": "如读天书。"}, {"start": 720.5, "end": 721.5, "text": "无奈"}, {"start": 721.5, "end": 723.5, "text": "只好问先生一声,"}, {"start": 723.5, "end": 725.5, "text": "愿意赐教访。"}, {"start": 725.5, "end": 727.5, "text": "愿意,愿意。"}, {"start": 727.5, "end": 728.5, "text": "我还以为这辈子"}, {"start": 728.5, "end": 730.5, "text": "再也看不见这本书了呢。"}, {"start": 730.5, "end": 732.5, "text": "快请公子带我前去。"}, {"start": 732.5, "end": 734.5, "text": "请上楼。"}, {"start": 734.5, "end": 735.5, "text": "上楼?"}, {"start": 735.5, "end": 737.5, "text": "在下不才,"}, {"start": 737.5, "end": 738.5, "text": "却有缘分。"}, {"start": 738.5, "end": 740.5, "text": "今日就要大饱眼福了。"}, {"start": 740.5, "end": 742.5, "text": "先生慢行。"}, {"start": 742.5, "end": 743.5, "text": "先生,"}, {"start": 743.5, "end": 744.5, "text": "这边请。"}, {"start": 744.5, "end": 745.5, "text": "好。"}, {"start": 745.5, "end": 760.17, "text": "这便是六合阵法。"}, {"start": 760.17, "end": 766.33, "text": "精妙精妙。"}, {"start": 766.33, "end": 792.26, "text": "非一所思啊。"}, {"start": 792.26, "end": 793.26, "text": "先生。"}, {"start": 793.26, "end": 794.26, "text": "公子,"}, {"start": 794.26, "end": 798.76, "text": "你这是。"}, {"start": 798.76, "end": 806.14, "text": "才冒于金木河谋想害我。"}, {"start": 806.14, "end": 808.14, "text": "请先生设法救我。"}, {"start": 808.14, "end": 810.14, "text": "在下有言在先。"}, {"start": 810.14, "end": 814.22, "text": "若谈金木河谋,"}, {"start": 814.22, "end": 816.22, "text": "在下善不敢意。"}, {"start": 816.22, "end": 818.22, "text": "只会即刻离去。"}, {"start": 818.22, "end": 820.22, "text": "不敢设计相救。"}, {"start": 820.22, "end": 822.22, "text": "我只有思路一条了。"}, {"start": 822.22, "end": 823.22, "text": "公子,"}, {"start": 823.22, "end": 836.9, "text": "你听我言。"}, {"start": 836.9, "end": 840.66, "text": "我主公承刘鼎升厚恩,"}, {"start": 840.66, "end": 842.66, "text": "方能赞助兴隐。"}, {"start": 842.66, "end": 847.42, "text": "我若干涉金州敌数之争,"}, {"start": 847.42, "end": 849.42, "text": "不是给我主公惹祸吗?"}, {"start": 849.42, "end": 850.42, "text": "不敢,"}, {"start": 850.42, "end": 851.42, "text": "断断不敢啊。"}, {"start": 851.42, "end": 852.42, "text": "此处上不着天,"}, {"start": 852.42, "end": 853.42, "text": "下不着地。"}, {"start": 853.42, "end": 854.42, "text": "也不敢,"}, {"start": 854.42, "end": 855.42, "text": "也不敢,"}, {"start": 855.42, "end": 856.42, "text": "也不敢,"}, {"start": 856.42, "end": 857.42, "text": "也不敢,"}, {"start": 857.42, "end": 858.42, "text": "也不敢,"}, {"start": 858.42, "end": 859.42, "text": "此处上不着天,"}, {"start": 859.42, "end": 860.42, "text": "下不着地。"}, {"start": 860.42, "end": 861.42, "text": "有话,"}, {"start": 861.42, "end": 862.42, "text": "出先生之口,"}, {"start": 862.42, "end": 863.42, "text": "乳流其至耳。"}, {"start": 863.42, "end": 865.42, "text": "史上再无一人知道。"}, {"start": 865.42, "end": 866.42, "text": "非也。"}, {"start": 866.42, "end": 869.42, "text": "人世间没有任何事能够永久期满。"}, {"start": 869.42, "end": 870.42, "text": "若要人不知,"}, {"start": 870.42, "end": 872.42, "text": "除非己莫为。"}, {"start": 872.42, "end": 875.66, "text": "先生,"}, {"start": 875.66, "end": 883.02, "text": "我情愿坠楼生死,"}, {"start": 883.02, "end": 885.02, "text": "也胜过被才茂所杀。"}, {"start": 885.02, "end": 901.8, "text": "这部六合阵法,"}, {"start": 901.8, "end": 903.8, "text": "奉送给先生了。"}, {"start": 903.8, "end": 907.56, "text": "多谢公子。"}, {"start": 907.56, "end": 909.56, "text": "我已经不需要它了。"}, {"start": 909.56, "end": 912.56, "text": "六合阵法全篇三千二百余字。"}, {"start": 912.56, "end": 914.56, "text": "我早已滥熟于心。"}, {"start": 915.56, "end": 917.56, "text": "我可以背给你听听。"}, {"start": 917.56, "end": 918.56, "text": "第一阵,"}, {"start": 918.56, "end": 920.56, "text": "心阵。"}, {"start": 920.56, "end": 921.56, "text": "开篇便是,"}, {"start": 921.56, "end": 923.56, "text": "阵法源于心法,"}, {"start": 923.56, "end": 925.56, "text": "以心法御阵法,"}, {"start": 925.56, "end": 927.56, "text": "以无形御有形,"}, {"start": 927.56, "end": 930.56, "text": "犹如蛟龙御凤鸣。"}, {"start": 930.56, "end": 932.56, "text": "先生救我!"}, {"start": 934.56, "end": 943.56, "text": "我且问你,"}, {"start": 943.56, "end": 946.56, "text": "刘景生已不能亲政。"}, {"start": 946.56, "end": 947.56, "text": "荆州军政大权"}, {"start": 947.56, "end": 950.56, "text": "早已进我蔡茂手中是吗?"}, {"start": 950.56, "end": 951.56, "text": "是。"}, {"start": 951.56, "end": 952.56, "text": "蔡茂名为上将,"}, {"start": 952.56, "end": 954.56, "text": "其实蠢如屠夫。"}, {"start": 954.56, "end": 955.56, "text": "你想要在她手中"}, {"start": 955.56, "end": 956.56, "text": "找一条活路,"}, {"start": 956.56, "end": 958.56, "text": "其实简单得很。"}, {"start": 958.56, "end": 959.56, "text": "七先生指教。"}, {"start": 959.56, "end": 963.32, "text": "公子切记,"}, {"start": 963.32, "end": 965.32, "text": "但凡你要对付某个人,"}, {"start": 965.32, "end": 967.32, "text": "首先要弄清楚"}, {"start": 967.32, "end": 969.32, "text": "她最要得到什么。"}, {"start": 969.32, "end": 971.32, "text": "蔡茂想独霸荆州。"}, {"start": 971.32, "end": 973.32, "text": "这是自然。"}, {"start": 973.32, "end": 974.32, "text": "还有呢?"}, {"start": 974.32, "end": 976.32, "text": "她想杀我。"}, {"start": 976.32, "end": 977.32, "text": "心里是想,"}, {"start": 977.32, "end": 979.32, "text": "但是还没有做。"}, {"start": 979.32, "end": 980.32, "text": "因为你是"}, {"start": 980.32, "end": 982.32, "text": "刘景生的长世子。"}, {"start": 982.32, "end": 983.32, "text": "杀了你"}, {"start": 983.32, "end": 985.32, "text": "会引起刘表旧部的反抗。"}, {"start": 985.32, "end": 987.32, "text": "所以不到万不得已,"}, {"start": 987.32, "end": 989.32, "text": "她不会动手杀你。"}, {"start": 989.32, "end": 992.18, "text": "除此之外,"}, {"start": 992.18, "end": 994.18, "text": "我就不知道了。"}, {"start": 994.18, "end": 996.18, "text": "蔡茂最希望的"}, {"start": 996.18, "end": 997.18, "text": "并不是杀你。"}, {"start": 997.18, "end": 998.18, "text": "她首先要把你"}, {"start": 998.18, "end": 1000.18, "text": "逼离荆州,"}, {"start": 1000.18, "end": 1002.18, "text": "然后再寻机杀你。"}, {"start": 1002.18, "end": 1003.18, "text": "因为你是她的"}, {"start": 1003.18, "end": 1004.18, "text": "眼中钉,"}, {"start": 1004.18, "end": 1005.18, "text": "肉中刺。"}, {"start": 1005.18, "end": 1006.18, "text": "虽然公子在荆州"}, {"start": 1006.18, "end": 1007.18, "text": "日夜不安,"}, {"start": 1007.18, "end": 1008.18, "text": "可蔡茂她,"}, {"start": 1008.18, "end": 1010.18, "text": "她更不安。"}, {"start": 1010.18, "end": 1011.18, "text": "特别是刘表"}, {"start": 1011.18, "end": 1012.18, "text": "临终脱孤时,"}, {"start": 1012.18, "end": 1014.18, "text": "她最希望公子能不在场。"}, {"start": 1014.18, "end": 1015.18, "text": "如此,"}, {"start": 1015.18, "end": 1017.18, "text": "她便能发布狡诏。"}, {"start": 1017.18, "end": 1018.18, "text": "皇城主公下令"}, {"start": 1018.18, "end": 1021.18, "text": "让次子刘从承继大位。"}, {"start": 1021.18, "end": 1022.18, "text": "公子啊,"}, {"start": 1022.18, "end": 1024.18, "text": "如果你想活命,"}, {"start": 1024.18, "end": 1026.18, "text": "那便随了蔡茂所愿吧。"}, {"start": 1026.18, "end": 1027.18, "text": "离开荆州,"}, {"start": 1027.18, "end": 1030.18, "text": "请命助守江厦。"}, {"start": 1030.18, "end": 1031.18, "text": "我,"}, {"start": 1031.18, "end": 1033.18, "text": "我岂能做事蔡茂篡意啊?"}, {"start": 1033.18, "end": 1035.18, "text": "公子留在荆州"}, {"start": 1035.18, "end": 1036.18, "text": "对大局毫无相助,"}, {"start": 1036.18, "end": 1038.18, "text": "只会是束手待毙。"}, {"start": 1038.18, "end": 1039.18, "text": "江厦,"}, {"start": 1039.18, "end": 1041.18, "text": "是荆乡的重镇,"}, {"start": 1041.18, "end": 1042.18, "text": "那里驻军八万,"}, {"start": 1042.18, "end": 1043.18, "text": "粮草军械"}, {"start": 1043.18, "end": 1045.18, "text": "更是多得不以胜计。"}, {"start": 1045.18, "end": 1046.18, "text": "你助守江厦,"}, {"start": 1046.18, "end": 1048.18, "text": "反可以虎视荆州。"}, {"start": 1048.18, "end": 1050.18, "text": "蔡茂若敢妄动,"}, {"start": 1050.18, "end": 1052.18, "text": "她便要有所顾忌。"}, {"start": 1052.18, "end": 1054.18, "text": "这便是摇乡挥印,"}, {"start": 1054.18, "end": 1056.18, "text": "以远至近之策。"}, {"start": 1056.18, "end": 1063.72, "text": "谢先生之教。"}, {"start": 1063.72, "end": 1064.72, "text": "好了公子,"}, {"start": 1064.72, "end": 1066.72, "text": "请起吧。"}, {"start": 1066.72, "end": 1070.1, "text": "公子啊,"}, {"start": 1070.1, "end": 1073.1, "text": "现在能否把云梯拿来,"}, {"start": 1073.1, "end": 1075.1, "text": "我也该回去了。"}, {"start": 1075.1, "end": 1077.1, "text": "伯旺坡的战事,"}, {"start": 1077.1, "end": 1079.1, "text": "我估计,"}, {"start": 1079.1, "end": 1081.1, "text": "打得差不多了。"}, {"start": 1081.1, "end": 1083.1, "text": "先生这边请。"}, {"start": 1083.1, "end": 1095.78, "text": "先生。"}, {"start": 1095.78, "end": 1096.78, "text": "真是啊。"}, {"start": 1096.78, "end": 1098.78, "text": "二位将军辛苦了。"}, {"start": 1098.78, "end": 1099.78, "text": "先生,"}, {"start": 1099.78, "end": 1100.78, "text": "这乃天人啊,"}, {"start": 1100.78, "end": 1102.78, "text": "用兵如神。"}, {"start": 1102.78, "end": 1104.78, "text": "官某此次出战,"}, {"start": 1104.78, "end": 1105.78, "text": "所到之处,"}, {"start": 1105.78, "end": 1106.78, "text": "曹兵,"}, {"start": 1106.78, "end": 1108.78, "text": "正像先生所料的那样,"}, {"start": 1108.78, "end": 1111.78, "text": "就连出入也分毫不差。"}, {"start": 1111.78, "end": 1112.78, "text": "先生,"}, {"start": 1112.78, "end": 1113.78, "text": "俺张飞在这里,"}, {"start": 1113.78, "end": 1115.78, "text": "嫌要向你赔个不是啊。"}, {"start": 1115.78, "end": 1117.78, "text": "我这回是杀敌两箭,"}, {"start": 1117.78, "end": 1118.78, "text": "破敌上万的。"}, {"start": 1118.78, "end": 1120.78, "text": "这都要拜先生之功啊。"}, {"start": 1120.78, "end": 1121.78, "text": "在下,"}, {"start": 1121.78, "end": 1123.78, "text": "为了让二位将军听令,"}, {"start": 1123.78, "end": 1124.78, "text": "不得不借用主攻硬箭,"}, {"start": 1124.78, "end": 1126.78, "text": "来震慑二位将军的虎威。"}, {"start": 1126.78, "end": 1127.78, "text": "得罪,"}, {"start": 1127.78, "end": 1128.78, "text": "得罪。"}, {"start": 1128.78, "end": 1129.78, "text": "情感,情感。"}, {"start": 1129.78, "end": 1131.78, "text": "在下虽箭为军师,"}, {"start": 1131.78, "end": 1132.78, "text": "却才博至弱。"}, {"start": 1132.78, "end": 1133.78, "text": "今后,"}, {"start": 1133.78, "end": 1136.78, "text": "还盼二位将军多多照应。"}, {"start": 1136.78, "end": 1137.78, "text": "先生放心,"}, {"start": 1137.78, "end": 1139.78, "text": "以后军师但有军令,"}, {"start": 1139.78, "end": 1141.78, "text": "俺张飞是无忧不尊的。"}, {"start": 1141.78, "end": 1142.78, "text": "将军如此说,"}, {"start": 1142.78, "end": 1144.78, "text": "在下心里甚为感激。"}, {"start": 1144.78, "end": 1146.78, "text": "孙前已备好庆功酒宴,"}, {"start": 1146.78, "end": 1147.78, "text": "二位将军请。"}, {"start": 1147.78, "end": 1148.78, "text": "好,"}, {"start": 1148.78, "end": 1149.78, "text": "走。"}, {"start": 1149.78, "end": 1150.78, "text": "请。"}, {"start": 1150.78, "end": 1151.78, "text": "要随我们一块去,"}, {"start": 1151.78, "end": 1153.78, "text": "俺张飞要好好敬军师几碗酒。"}, {"start": 1153.78, "end": 1155.78, "text": "好好好。"}, {"start": 1155.78, "end": 1166.7, "text": "主攻啊,"}, {"start": 1166.7, "end": 1168.7, "text": "下侯蹲兵败之后,"}, {"start": 1168.7, "end": 1171.7, "text": "曹操必会轻率大军前来征讨。"}, {"start": 1171.7, "end": 1173.7, "text": "兴野小城,"}, {"start": 1173.7, "end": 1175.7, "text": "终是难以抵抗强敌啊。"}, {"start": 1175.7, "end": 1179.85, "text": "军师有何善策啊?"}, {"start": 1179.85, "end": 1181.85, "text": "有是有,"}, {"start": 1181.85, "end": 1183.85, "text": "就怕主攻不用。"}, {"start": 1184.85, "end": 1185.85, "text": "你且说。"}, {"start": 1185.85, "end": 1189.42, "text": "刘表病重,"}, {"start": 1189.42, "end": 1190.42, "text": "荆州淡西之时,"}, {"start": 1190.42, "end": 1192.42, "text": "定会发生天大变连。"}, {"start": 1192.42, "end": 1194.42, "text": "主攻如果能娶荆州立足,"}, {"start": 1194.42, "end": 1196.42, "text": "那就不惧草参。"}, {"start": 1196.42, "end": 1211.13, "text": "我什么都可以听你的,"}, {"start": 1211.13, "end": 1213.13, "text": "就是让我娶荆州。"}, {"start": 1213.13, "end": 1218.4, "text": "刘景升是我皇兄啊,"}, {"start": 1218.4, "end": 1220.4, "text": "我受他厚恩,"}, {"start": 1220.4, "end": 1223.68, "text": "岂能趁他危难时,"}, {"start": 1223.68, "end": 1224.68, "text": "夺了他的基业。"}, {"start": 1224.68, "end": 1226.68, "text": "在下早就说过,"}, {"start": 1226.68, "end": 1228.68, "text": "主攻若不娶,"}, {"start": 1228.68, "end": 1230.68, "text": "曹操就会娶。"}, {"start": 1230.68, "end": 1231.68, "text": "荆香久居,"}, {"start": 1231.68, "end": 1233.68, "text": "关须到主攻盛衰,"}, {"start": 1233.68, "end": 1235.68, "text": "甚至存亡。"}, {"start": 1235.68, "end": 1237.68, "text": "请主攻三思。"}, {"start": 1237.68, "end": 1238.68, "text": "孔明,"}, {"start": 1238.68, "end": 1243.79, "text": "我一生以仁义为本,"}, {"start": 1243.79, "end": 1245.79, "text": "这就是我与曹操最大的区别。"}, {"start": 1245.79, "end": 1248.26, "text": "不义之举,"}, {"start": 1248.26, "end": 1250.26, "text": "我是宁死不为的。"}, {"start": 1250.26, "end": 1258.88, "text": "主攻,"}, {"start": 1258.88, "end": 1260.88, "text": "荆州来使求见。"}, {"start": 1260.88, "end": 1261.88, "text": "快招进来。"}, {"start": 1261.88, "end": 1266.66, "text": "诺。"}, {"start": 1266.66, "end": 1267.66, "text": "刘皇叔,"}, {"start": 1267.66, "end": 1268.66, "text": "刘皇叔,"}, {"start": 1268.66, "end": 1269.66, "text": "我家主攻沾起,"}, {"start": 1269.66, "end": 1270.66, "text": "就吐血不止。"}, {"start": 1270.66, "end": 1271.66, "text": "时而清醒,"}, {"start": 1271.66, "end": 1272.66, "text": "时而昏迷。"}, {"start": 1272.66, "end": 1274.66, "text": "主攻请你去一趟。"}, {"start": 1274.66, "end": 1275.66, "text": "我马上就去。"}, {"start": 1275.66, "end": 1277.66, "text": "等等。"}, {"start": 1277.66, "end": 1278.66, "text": "你先去吃杯茶,"}, {"start": 1278.66, "end": 1280.66, "text": "容我主攻更衣。"}, {"start": 1280.66, "end": 1285.82, "text": "谢皇叔。"}, {"start": 1285.82, "end": 1286.82, "text": "主攻,"}, {"start": 1286.82, "end": 1288.82, "text": "此去荆州有危险。"}, {"start": 1288.82, "end": 1290.82, "text": "景升兄病重,"}, {"start": 1290.82, "end": 1291.82, "text": "纵然有天大的危险,"}, {"start": 1291.82, "end": 1292.82, "text": "我也得去啊。"}, {"start": 1292.82, "end": 1293.82, "text": "那就带上赵云,"}, {"start": 1293.82, "end": 1294.82, "text": "率三百甲师护驾,"}, {"start": 1294.82, "end": 1295.82, "text": "令赵云片刻不离左右。"}, {"start": 1295.82, "end": 1296.82, "text": "好,"}, {"start": 1296.82, "end": 1297.82, "text": "我知道了。"}, {"start": 1298.82, "end": 1300.82, "text": "我估计刘表可能会临终脱固。"}, {"start": 1300.82, "end": 1302.82, "text": "如果他把荆州托付于你,"}, {"start": 1302.82, "end": 1303.82, "text": "请主攻万无推辞,"}, {"start": 1303.82, "end": 1304.82, "text": "务必揭晓。"}, {"start": 1304.82, "end": 1305.82, "text": "不。"}, {"start": 1305.82, "end": 1306.82, "text": "刘表如果死了,"}, {"start": 1306.82, "end": 1307.82, "text": "主攻为何还不去荆州?"}, {"start": 1307.82, "end": 1308.82, "text": "刘表不在,"}, {"start": 1308.82, "end": 1309.82, "text": "刘齐还在。"}, {"start": 1309.82, "end": 1310.82, "text": "子承父也,"}, {"start": 1310.82, "end": 1311.82, "text": "他应该是荆州之主。"}, {"start": 1311.82, "end": 1330.74, "text": "景升兄啊。"}, {"start": 1331.74, "end": 1332.74, "text": "景升兄。"}, {"start": 1332.74, "end": 1338.23, "text": "贤弟来了。"}, {"start": 1338.23, "end": 1339.23, "text": "景升兄。"}, {"start": 1340.23, "end": 1342.7, "text": "刘齐呢?"}, {"start": 1344.7, "end": 1345.7, "text": "刘齐,"}, {"start": 1345.7, "end": 1347.7, "text": "为何还不来啊?"}, {"start": 1348.7, "end": 1350.95, "text": "禀主攻,"}, {"start": 1350.95, "end": 1353.95, "text": "在下已派人飞马传命,"}, {"start": 1353.95, "end": 1355.95, "text": "江下路远,"}, {"start": 1355.95, "end": 1357.95, "text": "到此总得数日啊。"}, {"start": 1357.95, "end": 1362.78, "text": "你们先下去吧。"}, {"start": 1362.78, "end": 1365.12, "text": "遵命。"}, {"start": 1365.12, "end": 1370.6, "text": "都下去。"}, {"start": 1370.6, "end": 1396.85, "text": "贤弟我已病入膏肓,"}, {"start": 1396.85, "end": 1399.85, "text": "将不久于诊施。"}, {"start": 1400.85, "end": 1402.85, "text": "令公万万不可这么说,"}, {"start": 1402.85, "end": 1406.85, "text": "待到明年春暖花开时,"}, {"start": 1406.85, "end": 1408.85, "text": "定会好起来。"}, {"start": 1408.85, "end": 1410.85, "text": "我好不到那时候。"}, {"start": 1410.85, "end": 1422.83, "text": "你听着,"}, {"start": 1422.83, "end": 1426.83, "text": "在我养病的日子中,"}, {"start": 1426.83, "end": 1429.83, "text": "死来相知,"}, {"start": 1429.83, "end": 1435.74, "text": "如今,"}, {"start": 1435.74, "end": 1437.74, "text": "刘从良,"}, {"start": 1437.74, "end": 1441.3, "text": "都无声大财。"}, {"start": 1441.3, "end": 1444.78, "text": "臣夫妻,"}, {"start": 1444.78, "end": 1447.78, "text": "倾乡久居,"}, {"start": 1447.78, "end": 1450.78, "text": "这么大的天下。"}, {"start": 1450.78, "end": 1455.05, "text": "我死后,"}, {"start": 1455.05, "end": 1457.05, "text": "贤弟,"}, {"start": 1457.05, "end": 1463.05, "text": "你可自领金周?"}, {"start": 1463.05, "end": 1465.05, "text": "万万不可,"}, {"start": 1465.05, "end": 1468.05, "text": "在下万万不敢聪明。"}, {"start": 1468.05, "end": 1469.05, "text": "这,"}, {"start": 1469.05, "end": 1477.0, "text": "为什么不让我进城?"}, {"start": 1477.0, "end": 1478.0, "text": "主公有令,"}, {"start": 1478.0, "end": 1480.0, "text": "要公子助守江下,"}, {"start": 1480.0, "end": 1482.0, "text": "公子不应该擅立之手。"}, {"start": 1482.0, "end": 1483.0, "text": "我得报,"}, {"start": 1483.0, "end": 1484.0, "text": "父亲病重,"}, {"start": 1484.0, "end": 1485.0, "text": "快快开城,"}, {"start": 1485.0, "end": 1487.0, "text": "让我探望父亲。"}, {"start": 1488.0, "end": 1489.0, "text": "这是谣传,"}, {"start": 1489.0, "end": 1490.0, "text": "公子怎能轻信?"}, {"start": 1490.0, "end": 1492.0, "text": "如果主公病危,"}, {"start": 1492.0, "end": 1494.0, "text": "我们更应该封城戒严。"}, {"start": 1494.0, "end": 1495.0, "text": "公子,"}, {"start": 1495.0, "end": 1496.0, "text": "快回江下去。"}, {"start": 1496.0, "end": 1498.0, "text": "如果有什么问题,"}, {"start": 1498.0, "end": 1500.0, "text": "我们不能担当。"}, {"start": 1500.0, "end": 1502.0, "text": "蔡氏家族心怀不轨,"}, {"start": 1502.0, "end": 1504.0, "text": "想奪我父亲金周。"}, {"start": 1504.0, "end": 1505.0, "text": "公子这么说,"}, {"start": 1505.0, "end": 1507.0, "text": "就是在侮辱我们蔡氏。"}, {"start": 1507.0, "end": 1509.0, "text": "如果你再不走,"}, {"start": 1509.0, "end": 1511.0, "text": "别怪我们不客气。"}, {"start": 1511.0, "end": 1513.0, "text": "快快离开。"}, {"start": 1513.0, "end": 1541.09, "text": "我把金周,"}, {"start": 1541.09, "end": 1542.09, "text": "都不给你。"}, {"start": 1542.09, "end": 1546.69, "text": "我只是为了你,"}, {"start": 1546.69, "end": 1550.69, "text": "我只是为了上班班。"}, {"start": 1550.69, "end": 1559.38, "text": "我不想让他们,"}, {"start": 1559.38, "end": 1563.38, "text": "落在曹操的手里。"}, {"start": 1563.38, "end": 1572.26, "text": "李公子刘齐为金周之主,"}, {"start": 1572.26, "end": 1574.26, "text": "在下定会,"}, {"start": 1574.26, "end": 1576.26, "text": "尽忠业长,"}, {"start": 1576.26, "end": 1578.26, "text": "辅佐刘齐。"}, {"start": 1578.26, "end": 1580.26, "text": "这我早就想,"}, {"start": 1580.26, "end": 1587.52, "text": "即使刘齐,"}, {"start": 1587.52, "end": 1589.52, "text": "做了金周之主,"}, {"start": 1589.52, "end": 1593.63, "text": "他也是,"}, {"start": 1593.63, "end": 1601.43, "text": "独有大业。"}, {"start": 1601.43, "end": 1605.9, "text": "别想,"}, {"start": 1605.9, "end": 1609.5, "text": "一个弱主,"}, {"start": 1609.5, "end": 1613.5, "text": "做出弱大的金周,"}, {"start": 1613.5, "end": 1616.5, "text": "会引来什么?"}, {"start": 1616.5, "end": 1619.48, "text": "也来,"}, {"start": 1619.48, "end": 1623.48, "text": "虎狼吹弦,"}, {"start": 1623.48, "end": 1624.48, "text": "也来,"}, {"start": 1624.48, "end": 1629.48, "text": "强举规则呀。"}, {"start": 1629.48, "end": 1630.48, "text": "别人不说,"}, {"start": 1630.48, "end": 1636.92, "text": "他就会强先下手。"}, {"start": 1636.92, "end": 1639.92, "text": "以先帝的胸才大,"}, {"start": 1639.92, "end": 1643.9, "text": "没有请你,"}, {"start": 1643.9, "end": 1646.9, "text": "接下金周,"}, {"start": 1646.9, "end": 1649.9, "text": "一日强敌。"}, {"start": 1649.9, "end": 1655.11, "text": "先帝,"}, {"start": 1655.11, "end": 1658.11, "text": "日后善待我的,"}, {"start": 1658.11, "end": 1661.11, "text": "妻儿老乡。"}, {"start": 1661.11, "end": 1662.11, "text": "如此,"}, {"start": 1662.11, "end": 1667.39, "text": "不仅是金周之幸,"}, {"start": 1667.39, "end": 1671.18, "text": "也是我,"}, {"start": 1671.18, "end": 1675.18, "text": "刘氏之幸。"}, {"start": 1675.18, "end": 1682.05, "text": "在下,"}, {"start": 1682.05, "end": 1684.05, "text": "无论身在何处,"}, {"start": 1684.05, "end": 1686.05, "text": "都会视两位公子,"}, {"start": 1686.05, "end": 1687.05, "text": "如骨肉的。"}, {"start": 1687.05, "end": 1691.16, "text": "只是刘辈,"}, {"start": 1691.16, "end": 1694.66, "text": "断不敢趁君之危,"}, {"start": 1694.66, "end": 1698.07, "text": "去金周自带。"}, {"start": 1698.07, "end": 1699.07, "text": "你,"}, {"start": 1699.07, "end": 1700.07, "text": "主公,"}, {"start": 1700.07, "end": 1707.83, "text": "少记谈报,"}, {"start": 1707.83, "end": 1709.83, "text": "曹操亲自率领五十万大军,"}, {"start": 1709.83, "end": 1711.83, "text": "向金周开来。"}, {"start": 1711.83, "end": 1712.83, "text": "现在,"}, {"start": 1712.83, "end": 1716.3, "text": "距新野已不足八十里。"}, {"start": 1716.3, "end": 1717.3, "text": "主公,"}, {"start": 1717.3, "end": 1718.3, "text": "赶紧回新野吧。"}, {"start": 1718.3, "end": 1720.94, "text": "明公,"}, {"start": 1720.94, "end": 1721.94, "text": "曹操来返,"}, {"start": 1721.94, "end": 1723.94, "text": "在下,"}, {"start": 1723.94, "end": 1725.94, "text": "必须告辞了。"}, {"start": 1725.94, "end": 1726.94, "text": "先帝,"}, {"start": 1726.94, "end": 1733.18, "text": "切记我说的话。"}, {"start": 1733.18, "end": 1766.5, "text": "在下谨记。"}, {"start": 1766.5, "end": 1767.5, "text": "你平安回来记好。"}, {"start": 1767.5, "end": 1768.5, "text": "两个时辰前,"}, {"start": 1768.5, "end": 1770.5, "text": "曹操攻下了樊城。"}, {"start": 1770.5, "end": 1772.5, "text": "拜军将士已被关张二将,"}, {"start": 1772.5, "end": 1773.5, "text": "收入新野。"}, {"start": 1773.5, "end": 1774.5, "text": "我估计,"}, {"start": 1774.5, "end": 1777.5, "text": "曹操明日便会向新野发兵。"}, {"start": 1777.5, "end": 1778.5, "text": "这么快,"}, {"start": 1778.5, "end": 1780.5, "text": "竟连樊城都失了。"}, {"start": 1780.5, "end": 1781.5, "text": "是快。"}, {"start": 1781.5, "end": 1783.5, "text": "曹操率五十万大军出征,"}, {"start": 1783.5, "end": 1785.5, "text": "还能有这么快的进军速度,"}, {"start": 1785.5, "end": 1786.5, "text": "足见曹操其志,"}, {"start": 1786.5, "end": 1788.5, "text": "就是要精吞精香。"}, {"start": 1788.5, "end": 1789.5, "text": "据拜兵所报,"}, {"start": 1789.5, "end": 1791.5, "text": "曹操此次带来了很多新型的攻城兵器。"}, {"start": 1791.5, "end": 1793.5, "text": "以我军的力量,"}, {"start": 1793.5, "end": 1796.5, "text": "新野估计是保不住了。"}, {"start": 1796.5, "end": 1798.5, "text": "你意如何?"}, {"start": 1798.5, "end": 1799.5, "text": "主公,"}, {"start": 1799.5, "end": 1800.5, "text": "刘表"}, {"start": 1800.5, "end": 1802.5, "text": "有没有把金周托付给你?"}, {"start": 1802.5, "end": 1807.42, "text": "他确实想让我提令金周,"}, {"start": 1807.42, "end": 1809.42, "text": "但是我拒绝了。"}, {"start": 1809.42, "end": 1811.42, "text": "我请刘表理刘齐为金周之主,"}, {"start": 1811.42, "end": 1813.42, "text": "我会忠心辅助。"}, {"start": 1813.42, "end": 1817.11, "text": "果然不出我所料。"}, {"start": 1817.11, "end": 1819.55, "text": "快走吧,"}, {"start": 1821.55, "end": 1825.3, "text": "主公,"}, {"start": 1825.3, "end": 1828.3, "text": "我们急切需要一座尖城立足。"}, {"start": 1828.3, "end": 1830.3, "text": "需要是需要,"}, {"start": 1830.3, "end": 1832.3, "text": "但不必再惦记金周了。"}, {"start": 1832.3, "end": 1835.3, "text": "军师既然料到我会聚领金周,"}, {"start": 1835.3, "end": 1837.3, "text": "总该想好下一步方律了吧。"}, {"start": 1837.3, "end": 1839.3, "text": "当然,"}, {"start": 1839.3, "end": 1841.3, "text": "放弃新野,"}, {"start": 1841.3, "end": 1847.78, "text": "退守江夏。"}, {"start": 1847.78, "end": 1848.78, "text": "启程?"}, {"start": 1848.78, "end": 1849.78, "text": "除此之外,"}, {"start": 1849.78, "end": 1850.78, "text": "别无他途。"}, {"start": 1850.78, "end": 1852.78, "text": "刘齐驻军江夏,"}, {"start": 1852.78, "end": 1853.78, "text": "那里城防坚实,"}, {"start": 1853.78, "end": 1854.78, "text": "粮草兵器充足。"}, {"start": 1854.78, "end": 1856.78, "text": "刘公子又对我们感情深厚。"}, {"start": 1856.78, "end": 1858.78, "text": "我们只有立足江夏,"}, {"start": 1858.78, "end": 1859.78, "text": "与刘齐合兵,"}, {"start": 1859.78, "end": 1860.78, "text": "才能与曹操周旋,"}, {"start": 1860.78, "end": 1865.72, "text": "以待时变。"}, {"start": 1865.72, "end": 1866.72, "text": "好吧,"}, {"start": 1866.72, "end": 1867.72, "text": "放弃新野,"}, {"start": 1867.72, "end": 1868.72, "text": "移军江夏。"}, {"start": 1868.72, "end": 1871.1, "text": "不过军师,"}, {"start": 1871.1, "end": 1874.1, "text": "你难道不想与曹操一战吗?"}, {"start": 1874.1, "end": 1875.1, "text": "就这么走了吗?"}, {"start": 1875.1, "end": 1878.54, "text": "这个请主公放心。"}, {"start": 1879.54, "end": 1880.54, "text": "我上次一把大火,"}, {"start": 1880.54, "end": 1882.54, "text": "烧了夏侯敦大阪兵马。"}, {"start": 1882.54, "end": 1885.54, "text": "曹操必然会将夏侯敦痛骂一顿。"}, {"start": 1885.54, "end": 1887.54, "text": "但曹操至此亲自来了,"}, {"start": 1887.54, "end": 1890.54, "text": "我也要让他再吃一把火烧。"}, {"start": 1890.54, "end": 1891.54, "text": "好,"}, {"start": 1891.54, "end": 1893.54, "text": "那就请军师即刻用兵吧。"}, {"start": 1893.54, "end": 1894.54, "text": "遵命。"}, {"start": 1894.54, "end": 1898.03, "text": "关将军,"}, {"start": 1898.03, "end": 1901.03, "text": "你引三千军士到白河上游埋伏。"}, {"start": 1901.03, "end": 1902.03, "text": "每位将士必须带一条布带,"}, {"start": 1902.03, "end": 1903.03, "text": "装入沙土,"}, {"start": 1903.03, "end": 1904.03, "text": "遏制白河水。"}, {"start": 1904.03, "end": 1905.03, "text": "明日三更,"}, {"start": 1905.03, "end": 1907.03, "text": "听见下游人喊马斯,"}, {"start": 1907.03, "end": 1908.03, "text": "便取出沙袋放水,"}, {"start": 1908.03, "end": 1910.03, "text": "是时你顺水追杀。"}, {"start": 1910.03, "end": 1911.03, "text": "遵命。"}, {"start": 1911.03, "end": 1912.03, "text": "不过,军师,"}, {"start": 1912.03, "end": 1913.03, "text": "苍粗之间,"}, {"start": 1913.03, "end": 1917.03, "text": "你让我上哪儿去找这三千条布带?"}, {"start": 1917.03, "end": 1918.03, "text": "关将军,"}, {"start": 1918.03, "end": 1919.03, "text": "五天前,"}, {"start": 1919.03, "end": 1922.03, "text": "军师已经让我准备好了三千布带。"}, {"start": 1922.03, "end": 1925.03, "text": "全部堆放在南城门前了。"}, {"start": 1925.03, "end": 1927.03, "text": "你领兵出城时,"}, {"start": 1927.03, "end": 1929.03, "text": "顺手可得。"}, {"start": 1929.03, "end": 1930.03, "text": "遵命。"}, {"start": 1930.03, "end": 1932.31, "text": "张将军。"}, {"start": 1932.31, "end": 1933.31, "text": "在。"}, {"start": 1933.31, "end": 1935.31, "text": "你引三千军士到柏林渡口埋伏。"}, {"start": 1935.31, "end": 1936.31, "text": "那里水势最缓,"}, {"start": 1936.31, "end": 1937.31, "text": "曹军被淹之后,"}, {"start": 1937.31, "end": 1938.31, "text": "必从柏林渡讨难。"}, {"start": 1938.31, "end": 1939.31, "text": "是时,"}, {"start": 1939.31, "end": 1940.31, "text": "你趁势攻杀。"}, {"start": 1940.31, "end": 1941.31, "text": "遵命。"}, {"start": 1941.31, "end": 1942.31, "text": "子龙。"}, {"start": 1943.31, "end": 1946.2, "text": "你也引三千军士,"}, {"start": 1946.2, "end": 1947.2, "text": "分为四队。"}, {"start": 1947.2, "end": 1948.2, "text": "你亲自领一队,"}, {"start": 1948.2, "end": 1949.2, "text": "埋伏于新叶东门。"}, {"start": 1949.2, "end": 1950.2, "text": "其一三队,"}, {"start": 1950.2, "end": 1952.2, "text": "分别布于西南北三门。"}, {"start": 1952.2, "end": 1953.2, "text": "曹军入城后,"}, {"start": 1953.2, "end": 1955.2, "text": "必会入民居安歇。"}, {"start": 1955.2, "end": 1957.2, "text": "我已令弥方,"}, {"start": 1957.2, "end": 1959.2, "text": "在防粮上布满了硫磺消炭。"}, {"start": 1959.2, "end": 1960.2, "text": "明日黄昏,"}, {"start": 1960.2, "end": 1961.2, "text": "曹军造饭时,"}, {"start": 1961.2, "end": 1962.2, "text": "会起大风。"}, {"start": 1962.2, "end": 1963.2, "text": "你旦见风起,"}, {"start": 1963.2, "end": 1964.2, "text": "就命四门将士,"}, {"start": 1964.2, "end": 1966.2, "text": "一同往城内射入火箭。"}, {"start": 1966.2, "end": 1967.2, "text": "见到城中大火冲天时,"}, {"start": 1967.2, "end": 1968.2, "text": "西南北三门将士,"}, {"start": 1968.2, "end": 1969.2, "text": "摇旗呐喊,"}, {"start": 1969.2, "end": 1970.2, "text": "作围攻声势,"}, {"start": 1970.2, "end": 1971.2, "text": "只留东门,"}, {"start": 1971.2, "end": 1972.2, "text": "放曹军出走。"}, {"start": 1973.2, "end": 1974.2, "text": "遵命。"}, {"start": 1975.2, "end": 1976.2, "text": "官平刘丰听令。"}, {"start": 1976.2, "end": 1977.2, "text": "在。"}, {"start": 1977.2, "end": 1978.2, "text": "你二人率两千军士,"}, {"start": 1978.2, "end": 1979.2, "text": "一半直红旗,"}, {"start": 1979.2, "end": 1980.2, "text": "一半直青旗,"}, {"start": 1980.2, "end": 1981.2, "text": "埋伏于新野城外,"}, {"start": 1981.2, "end": 1982.2, "text": "却尾坡。"}, {"start": 1983.2, "end": 1984.2, "text": "曹军拜军奔来时,"}, {"start": 1984.2, "end": 1985.2, "text": "红旗军在左,"}, {"start": 1985.2, "end": 1986.2, "text": "青旗军在右,"}, {"start": 1986.2, "end": 1988.2, "text": "摇旗鼓噪。"}, {"start": 1988.2, "end": 1989.2, "text": "曹军必生疑惑,"}, {"start": 1989.2, "end": 1990.2, "text": "不敢出兵,"}, {"start": 1990.2, "end": 1992.2, "text": "必会向白河方向撤军。"}, {"start": 1992.2, "end": 1993.2, "text": "是时,"}, {"start": 1993.2, "end": 1994.2, "text": "你们率军追杀,"}, {"start": 1994.2, "end": 1996.2, "text": "把曹军赶往柏林渡。"}, {"start": 1996.2, "end": 1997.2, "text": "遵命。"}, {"start": 1997.2, "end": 1999.2, "text": "听军师用兵布阵,"}, {"start": 1999.2, "end": 2001.2, "text": "如同听一场大戏,"}, {"start": 2001.2, "end": 2012.61, "text": "明日定然会有好戏可看。"}, {"start": 2013.61, "end": 2014.61, "text": "主公啊,"}, {"start": 2015.61, "end": 2016.61, "text": "明日之战,"}, {"start": 2016.61, "end": 2017.61, "text": "曹军必败,"}, {"start": 2018.61, "end": 2019.61, "text": "但也只是为我们"}, {"start": 2019.61, "end": 2020.61, "text": "争取撤军的时间,"}, {"start": 2021.61, "end": 2022.61, "text": "并不能将曹操"}, {"start": 2022.61, "end": 2024.61, "text": "五十万大军击溃。"}, {"start": 2024.61, "end": 2025.61, "text": "所以,"}, {"start": 2026.61, "end": 2027.61, "text": "新野还在。"}, {"start": 2027.61, "end": 2028.61, "text": "这一截我明白。"}, {"start": 2028.61, "end": 2029.61, "text": "有见没难事。"}, {"start": 2030.61, "end": 2032.61, "text": "明天大战之后,"}, {"start": 2032.61, "end": 2037.39, "text": "新野就是一片废墟了。"}, {"start": 2037.39, "end": 2038.39, "text": "城里的十八万百姓"}, {"start": 2038.39, "end": 2042.11, "text": "怎么办啊?"}, {"start": 2043.11, "end": 2044.11, "text": "对啊,"}, {"start": 2044.11, "end": 2045.11, "text": "对啊。"}, {"start": 2045.11, "end": 2047.11, "text": "我们把民房都烧了,"}, {"start": 2047.11, "end": 2049.11, "text": "百姓们无处容身啊。"}, {"start": 2049.11, "end": 2050.11, "text": "因此,"}, {"start": 2050.11, "end": 2053.87, "text": "军师决定,"}, {"start": 2053.87, "end": 2057.95, "text": "把我们的粮草、金钱"}, {"start": 2057.95, "end": 2058.95, "text": "全部分发给百姓。"}, {"start": 2059.95, "end": 2060.95, "text": "这一截"}, {"start": 2060.95, "end": 2061.95, "text": "我们必须尽力。"}, {"start": 2062.95, "end": 2063.95, "text": "这一截"}, {"start": 2063.95, "end": 2064.95, "text": "我们的粮草、金钱"}, {"start": 2064.95, "end": 2066.95, "text": "全部分发给百姓,"}, {"start": 2066.95, "end": 2068.95, "text": "让他们迁到别的郡县去。"}, {"start": 2069.95, "end": 2070.95, "text": "该当如此,"}, {"start": 2070.95, "end": 2071.95, "text": "顺好,"}, {"start": 2072.95, "end": 2073.95, "text": "该当如此啊。"}, {"start": 2074.95, "end": 2075.95, "text": "可百姓不愿意。"}, {"start": 2076.95, "end": 2077.95, "text": "百姓说了,"}, {"start": 2077.95, "end": 2078.95, "text": "刘皇叔到哪儿,"}, {"start": 2078.95, "end": 2079.95, "text": "我们就跟到哪儿。"}, {"start": 2080.95, "end": 2081.95, "text": "只要跟定刘皇叔,"}, {"start": 2081.95, "end": 2083.95, "text": "我们就有好日子过。"}, {"start": 2083.95, "end": 2095.0, "text": "民心可疑啊。"}, {"start": 2096.0, "end": 2097.0, "text": "赶紧张出告示,"}, {"start": 2097.0, "end": 2098.0, "text": "城中所有百姓"}, {"start": 2098.0, "end": 2099.0, "text": "跟我一起迁往江夏。"}, {"start": 2100.0, "end": 2102.25, "text": "这,"}, {"start": 2102.25, "end": 2103.25, "text": "主公恕我直言,"}, {"start": 2103.25, "end": 2104.25, "text": "写百姓远征"}, {"start": 2104.25, "end": 2105.25, "text": "是万万不可的。"}, {"start": 2106.25, "end": 2107.25, "text": "此去江夏"}, {"start": 2107.25, "end": 2108.25, "text": "二百八十多里,"}, {"start": 2108.25, "end": 2109.25, "text": "十八万百姓"}, {"start": 2109.25, "end": 2110.25, "text": "福老邪幼,"}, {"start": 2110.25, "end": 2111.25, "text": "每日能行多少,"}, {"start": 2111.25, "end": 2112.25, "text": "不到三十里。"}, {"start": 2113.25, "end": 2114.25, "text": "假如曹军铁骑追杀,"}, {"start": 2114.25, "end": 2115.25, "text": "那我们与百姓"}, {"start": 2116.25, "end": 2117.25, "text": "都会玉石俱焚。"}, {"start": 2118.25, "end": 2122.86, "text": "听令,"}, {"start": 2122.86, "end": 2125.34, "text": "带上百姓一块走。"}, {"start": 2126.34, "end": 2127.34, "text": "如玉战时,"}, {"start": 2128.34, "end": 2129.34, "text": "百姓可以弃我而走。"}, {"start": 2130.34, "end": 2131.34, "text": "我绝不会抛弃百姓。"}, {"start": 2132.34, "end": 2133.34, "text": "主公。"}, {"start": 2133.34, "end": 2134.34, "text": "我已经决定了,"}, {"start": 2134.34, "end": 2135.34, "text": "军师不必再劝。"}, {"start": 2136.34, "end": 2138.34, "text": "宁可百姓弃我,"}, {"start": 2139.34, "end": 2140.34, "text": "我绝不起百姓。"}, {"start": 2141.34, "end": 2143.34, "text": "主公果然是非常之主啊。"}, {"start": 2156.6, "end": 2160.54, "text": "爹。"}, {"start": 2160.54, "end": 2161.54, "text": "爹。"}, {"start": 2162.54, "end": 2170.04, "text": "我等商议已定,"}, {"start": 2171.04, "end": 2172.04, "text": "奉主公一命,"}, {"start": 2173.04, "end": 2174.04, "text": "拜公子刘从"}, {"start": 2174.04, "end": 2175.04, "text": "为荆州之主。"}, {"start": 2176.04, "end": 2179.47, "text": "拜见少主公。"}, {"start": 2180.47, "end": 2188.1, "text": "父亲刚刚去世,"}, {"start": 2189.1, "end": 2190.1, "text": "曹操大军押井,"}, {"start": 2191.1, "end": 2192.1, "text": "我们该怎么办?"}, {"start": 2196.1, "end": 2197.1, "text": "少主公,"}, {"start": 2197.1, "end": 2199.1, "text": "你觉得自己的恩威才智"}, {"start": 2200.1, "end": 2201.1, "text": "比曹操如何呢?"}, {"start": 2202.1, "end": 2203.1, "text": "万万不如也。"}, {"start": 2204.1, "end": 2205.1, "text": "那我荆州的兵马"}, {"start": 2205.1, "end": 2206.1, "text": "又比曹操如何呢?"}, {"start": 2207.1, "end": 2212.17, "text": "少主公明鉴啊,"}, {"start": 2213.17, "end": 2214.17, "text": "当下之计"}, {"start": 2214.17, "end": 2215.17, "text": "唯有归降曹操,"}, {"start": 2216.17, "end": 2217.17, "text": "方能保得京乡平安。"}, {"start": 2218.17, "end": 2219.17, "text": "否则,"}, {"start": 2219.17, "end": 2220.17, "text": "战断一开,"}, {"start": 2220.17, "end": 2221.17, "text": "山河俱碎,"}, {"start": 2221.17, "end": 2222.17, "text": "玉石俱焚,"}, {"start": 2222.17, "end": 2223.17, "text": "不但祖业难保,"}, {"start": 2224.17, "end": 2226.17, "text": "就连少主公的性命"}, {"start": 2228.48, "end": 2231.72, "text": "莫将换。"}, {"start": 2231.72, "end": 2232.72, "text": "我流逝的百年七夜,"}, {"start": 2233.72, "end": 2235.72, "text": "就要这样攻守让给曹操吗?"}, {"start": 2236.72, "end": 2237.72, "text": "不是让给曹操,"}, {"start": 2237.72, "end": 2238.72, "text": "而是回归朝廷。"}, {"start": 2239.72, "end": 2241.72, "text": "大汉难道不是流氏天下吗?"}, {"start": 2242.72, "end": 2244.72, "text": "曹操只不过是朝廷一个丞相,"}, {"start": 2245.72, "end": 2247.72, "text": "而那位与少主公同宗的"}, {"start": 2247.72, "end": 2248.72, "text": "流氏天子"}, {"start": 2249.72, "end": 2250.72, "text": "才是大汉之主啊。"}, {"start": 2251.72, "end": 2261.36, "text": "蔡茂,"}, {"start": 2261.36, "end": 2263.83, "text": "我有一个要求,"}, {"start": 2263.83, "end": 2264.83, "text": "归顺朝廷以后,"}, {"start": 2268.5, "end": 2270.5, "text": "刘从仍做荆州刺史,"}, {"start": 2271.5, "end": 2273.74, "text": "让我儿世世代代"}, {"start": 2274.74, "end": 2275.74, "text": "提领京乡九郡。"}, {"start": 2276.74, "end": 2279.54, "text": "禀少主公夫人,"}, {"start": 2280.54, "end": 2281.54, "text": "半个月前"}, {"start": 2281.54, "end": 2283.54, "text": "我已将此意通报给曹丞相了。"}, {"start": 2284.54, "end": 2285.54, "text": "如何?"}, {"start": 2286.54, "end": 2288.54, "text": "曹丞相当着我的面对天立誓,"}, {"start": 2289.54, "end": 2290.54, "text": "他完全同意,"}, {"start": 2291.54, "end": 2292.54, "text": "永不食言。"}, {"start": 2292.54, "end": 2298.53, "text": "丛儿,"}, {"start": 2298.53, "end": 2301.03, "text": "那我们就归顺朝廷吧。"}, {"start": 2302.03, "end": 2370.68, "text": "刘从,"}, {"start": 2370.68, "end": 2371.68, "text": "率京乡九郡"}, {"start": 2371.68, "end": 2373.68, "text": "所有文武官民归顺朝廷。"}, {"start": 2375.68, "end": 2376.68, "text": "请丞相接应。"}, {"start": 2377.68, "end": 2392.79, "text": "本相,"}, {"start": 2392.79, "end": 2393.79, "text": "奉天子诏,"}, {"start": 2394.79, "end": 2395.79, "text": "斥封刘从,"}, {"start": 2396.79, "end": 2398.79, "text": "为荆州刺史襄阳侯。"}, {"start": 2399.79, "end": 2400.79, "text": "施习罔替,"}, {"start": 2401.79, "end": 2403.79, "text": "永远提领京乡九郡。"}, {"start": 2404.79, "end": 2408.79, "text": "万岁万岁万岁万岁万岁。"}, {"start": 2411.62, "end": 2412.62, "text": "好了,"}, {"start": 2413.62, "end": 2414.62, "text": "刘从接应。"}]