[{"start": 81.14, "end": 82.38, "text": "好像是一座空城。"}, {"start": 84.22, "end": 87.9, "text": "传令,后军便前军撤军。"}, {"start": 89.3, "end": 91.42, "text": "粮草都在城中,为何撤军?"}, {"start": 99.39, "end": 101.39, "text": "诸葛亮在城中设了埋伏。"}, {"start": 101.79, "end": 109.3, "text": "如此大万小城,即使有伏兵也并不多。"}, {"start": 110.34, "end": 112.86, "text": "请都督下令,末将领兵杀进城去。"}, {"start": 113.62, "end": 120.17, "text": "城中伏兵事不多,城中之外的山上哪里?"}, {"start": 121.33, "end": 123.89, "text": "诸葛亮平生谨慎,从不走险。"}, {"start": 124.21, "end": 126.05, "text": "城中伏兵伏地出现在城中。"}, {"start": 126.97, "end": 163.5, "text": "快撤,撤兵完了,山中伏兵就杀出来了。"}, {"start": 163.5, "end": 190.04, "text": "撤!"}, {"start": 190.04, "end": 191.16, "text": "你退军了?"}, {"start": 191.16, "end": 200.21, "text": "为何你轻弹一首琴曲,竟能下退司马仪十几万大军?"}, {"start": 200.21, "end": 208.53, "text": "平生谨慎,从不行邪,见城门四开,我抚琴独坐。"}, {"start": 208.53, "end": 216.9, "text": "他便深信,城中必有伏兵。"}, {"start": 216.9, "end": 219.5, "text": "天呐,城下要是弹错一个音符,"}, {"start": 219.5, "end": 221.5, "text": "把此城踏为平地啊"}, {"start": 221.5, "end": 230.72, "text": "知音"}, {"start": 230.72, "end": 245.18, "text": "我若是死马 尽快离开"}, {"start": 245.18, "end": 258.63, "text": "遵命"}, {"start": 258.63, "end": 259.63, "text": "禀大都督"}, {"start": 259.63, "end": 262.63, "text": "城外拿到一个打柴的百姓"}, {"start": 262.63, "end": 264.63, "text": "末将沈温后得知"}, {"start": 264.63, "end": 266.63, "text": "得知"}, {"start": 266.63, "end": 298.64, "text": "西城中"}, {"start": 298.64, "end": 300.64, "text": "只有祝国亮和一两千老弱残兵"}, {"start": 300.64, "end": 302.64, "text": "我们上他的当了"}, {"start": 302.64, "end": 314.43, "text": "我军退后"}, {"start": 314.43, "end": 316.43, "text": "祝国亮匆匆撤走了"}, {"start": 316.43, "end": 326.56, "text": "你妙算"}, {"start": 326.56, "end": 327.56, "text": "父亲不"}, {"start": 327.56, "end": 337.3, "text": "父亲不要难过"}, {"start": 337.3, "end": 339.3, "text": "这都是天恕我"}, {"start": 339.3, "end": 341.3, "text": "我难过的就是天恕"}, {"start": 341.3, "end": 345.26, "text": "天为何不助我"}, {"start": 346.26, "end": 348.26, "text": "丞相真是料敌如神"}, {"start": 349.26, "end": 350.26, "text": "我刚命将士们"}, {"start": 350.26, "end": 352.26, "text": "备好了滚木雷石"}, {"start": 352.26, "end": 354.26, "text": "徐晃就带着三万轻骑沙岛"}, {"start": 354.26, "end": 356.26, "text": "我军万箭七发"}, {"start": 356.26, "end": 358.26, "text": "当场就射翻上千地区"}, {"start": 359.26, "end": 361.26, "text": "据说徐晃身重书鉴"}, {"start": 361.26, "end": 363.26, "text": "八成是死了"}, {"start": 364.26, "end": 366.26, "text": "文昌辛苦了"}, {"start": 367.26, "end": 370.26, "text": "若不是你守住了杨平关"}, {"start": 370.26, "end": 372.26, "text": "我大军何以能平安"}, {"start": 372.26, "end": 374.26, "text": "退回蜀中"}, {"start": 374.26, "end": 377.98, "text": "只是不知道子隆"}, {"start": 377.98, "end": 378.98, "text": "怎么样了"}, {"start": 378.98, "end": 380.98, "text": "赵将军归营"}, {"start": 380.98, "end": 384.86, "text": "丞相"}, {"start": 384.86, "end": 385.86, "text": "我回来了"}, {"start": 385.86, "end": 386.86, "text": "子隆"}, {"start": 387.86, "end": 389.86, "text": "你受伤了"}, {"start": 389.86, "end": 390.86, "text": "我的身上"}, {"start": 390.86, "end": 392.86, "text": "都是魏军的血"}, {"start": 392.86, "end": 393.86, "text": "丞相有所不知"}, {"start": 393.86, "end": 395.86, "text": "子隆将军让我在前"}, {"start": 395.86, "end": 396.86, "text": "领军撤退"}, {"start": 396.86, "end": 397.86, "text": "他自己断后"}, {"start": 397.86, "end": 398.86, "text": "一连斩杀了"}, {"start": 398.86, "end": 400.86, "text": "一连斩杀了魏军三员战将"}, {"start": 400.86, "end": 402.86, "text": "才吓得追军不敢靠前"}, {"start": 403.86, "end": 404.86, "text": "丞相"}, {"start": 404.86, "end": 406.86, "text": "我军未曾短少一人一骑"}, {"start": 406.86, "end": 409.86, "text": "连兵器也未曾缺少一件"}, {"start": 409.86, "end": 410.86, "text": "你子隆"}, {"start": 413.58, "end": 414.58, "text": "丞相"}, {"start": 415.58, "end": 416.58, "text": "来"}, {"start": 417.58, "end": 419.58, "text": "赏子隆金五百"}, {"start": 419.58, "end": 421.58, "text": "金一万匹"}, {"start": 421.58, "end": 422.58, "text": "丞相"}, {"start": 423.58, "end": 424.58, "text": "三军无功"}, {"start": 425.58, "end": 427.58, "text": "我有何脸面受伤"}, {"start": 427.58, "end": 432.22, "text": "如丞相非要赏在下的话"}, {"start": 433.22, "end": 435.22, "text": "那则是赏罚不明"}, {"start": 438.17, "end": 440.17, "text": "且把金银丝帛存于库中"}, {"start": 441.17, "end": 443.17, "text": "以后赏给其他奖势吧"}, {"start": 443.17, "end": 446.58, "text": "你再试试"}, {"start": 446.58, "end": 450.14, "text": "长暂子隆忠勇"}, {"start": 451.14, "end": 453.14, "text": "今日我看"}, {"start": 453.14, "end": 458.57, "text": "而且一帛云天啊"}, {"start": 458.57, "end": 465.88, "text": "赴王平归营"}, {"start": 465.88, "end": 471.4, "text": "召王平来见"}, {"start": 471.4, "end": 472.4, "text": "诺"}, {"start": 472.4, "end": 475.29, "text": "丞相有令"}, {"start": 475.29, "end": 477.29, "text": "召王平觐见"}, {"start": 477.29, "end": 496.5, "text": "拿根绳子来"}, {"start": 496.5, "end": 498.5, "text": "保护父上"}, {"start": 498.5, "end": 501.86, "text": "拜见丞相"}, {"start": 502.86, "end": 506.78, "text": "王平"}, {"start": 508.78, "end": 510.78, "text": "你生性谨慎"}, {"start": 511.78, "end": 514.78, "text": "因此我才命你相助阿肃"}, {"start": 516.78, "end": 518.78, "text": "但扎营一时"}, {"start": 518.78, "end": 520.78, "text": "你为何不见哪"}, {"start": 521.78, "end": 522.78, "text": "回禀丞相"}, {"start": 522.78, "end": 524.78, "text": "在下再三劝见参军"}, {"start": 524.78, "end": 527.78, "text": "让他在五路总口出安营下寨"}, {"start": 527.78, "end": 529.78, "text": "但他大怒不从"}, {"start": 530.78, "end": 531.78, "text": "后来"}, {"start": 531.78, "end": 532.78, "text": "为君为善"}, {"start": 532.78, "end": 535.78, "text": "在下也曾十多次引军冲杀"}, {"start": 535.78, "end": 536.78, "text": "怎奈"}, {"start": 536.78, "end": 540.06, "text": "夸不敌众"}, {"start": 540.06, "end": 543.43, "text": "在下齐请丞相"}, {"start": 543.43, "end": 544.43, "text": "讲罪"}, {"start": 545.43, "end": 552.0, "text": "赵马素"}, {"start": 552.0, "end": 586.97, "text": "你自小暴毒病术"}, {"start": 586.97, "end": 588.97, "text": "精术战法"}, {"start": 588.97, "end": 592.31, "text": "我也屡次告诫你"}, {"start": 593.31, "end": 595.31, "text": "接廷"}, {"start": 595.31, "end": 598.31, "text": "乃我军根本之敌"}, {"start": 598.31, "end": 601.31, "text": "可你到了阵前"}, {"start": 601.31, "end": 603.31, "text": "目空一切"}, {"start": 603.31, "end": 605.31, "text": "厚大喜功"}, {"start": 605.31, "end": 607.31, "text": "不听王平之见"}, {"start": 607.31, "end": 609.31, "text": "失守阶厅"}, {"start": 609.31, "end": 610.31, "text": "几乎令我大军"}, {"start": 610.31, "end": 613.31, "text": "陷入万劫不复之境"}, {"start": 614.31, "end": 616.31, "text": "你自己说"}, {"start": 616.31, "end": 618.31, "text": "该当何罪"}, {"start": 619.31, "end": 633.31, "text": "这是唯一人的罪责"}, {"start": 633.31, "end": 636.17, "text": "立故军令状"}, {"start": 636.17, "end": 638.67, "text": "敢当军法"}, {"start": 646.14, "end": 648.8, "text": "丞相"}, {"start": 648.8, "end": 650.8, "text": "这马素虽有过失"}, {"start": 650.8, "end": 652.8, "text": "可念在其"}, {"start": 652.8, "end": 655.8, "text": "跟随先帝和丞相二十多年"}, {"start": 655.8, "end": 657.8, "text": "我看念其旧薰"}, {"start": 657.8, "end": 659.8, "text": "罪免其死"}, {"start": 659.8, "end": 662.8, "text": "以后让他将功赎罪"}, {"start": 662.8, "end": 663.8, "text": "丞相"}, {"start": 663.8, "end": 665.8, "text": "马素不可轻饶"}, {"start": 665.8, "end": 669.37, "text": "我几十万大军"}, {"start": 669.37, "end": 671.37, "text": "靠什么凝聚军心"}, {"start": 671.37, "end": 673.37, "text": "靠的就是赏罚分明"}, {"start": 673.37, "end": 675.37, "text": "言必信行必果"}, {"start": 675.37, "end": 677.37, "text": "如果立了军令状"}, {"start": 677.37, "end": 678.37, "text": "而不执行"}, {"start": 678.37, "end": 680.37, "text": "那么今后还会有谁"}, {"start": 680.37, "end": 682.37, "text": "严守军令"}, {"start": 683.37, "end": 684.37, "text": "丞相"}, {"start": 684.37, "end": 686.37, "text": "如果你宽纵于他"}, {"start": 686.37, "end": 688.37, "text": "君威何在"}, {"start": 688.37, "end": 689.37, "text": "丞相"}, {"start": 692.38, "end": 693.38, "text": "天下未定"}, {"start": 693.38, "end": 695.38, "text": "数岸地下人少"}, {"start": 695.38, "end": 697.38, "text": "谋略之事本就不多"}, {"start": 697.38, "end": 699.38, "text": "马素平日做事勤勉"}, {"start": 699.38, "end": 701.38, "text": "又熟知兵略"}, {"start": 701.38, "end": 702.38, "text": "此次接听之败"}, {"start": 702.38, "end": 703.38, "text": "皆因敌军态度"}, {"start": 703.38, "end": 705.38, "text": "并非马素一人之过"}, {"start": 705.38, "end": 706.38, "text": "丞相"}, {"start": 706.38, "end": 707.38, "text": "丞相"}, {"start": 707.38, "end": 708.38, "text": "承让"}, {"start": 709.38, "end": 732.12, "text": "胆死的两万弟兄"}, {"start": 732.12, "end": 737.35, "text": "往复先生教诲"}, {"start": 737.35, "end": 739.35, "text": "不堪重任"}, {"start": 739.35, "end": 742.76, "text": "同时接听"}, {"start": 743.76, "end": 745.76, "text": "总有万死"}, {"start": 745.76, "end": 750.17, "text": "也不足以行罪"}, {"start": 750.17, "end": 760.84, "text": "请丞相执行军法"}, {"start": 760.84, "end": 762.84, "text": "杀我士重"}, {"start": 762.84, "end": 764.84, "text": "以名正典型"}, {"start": 764.84, "end": 795.35, "text": "我出去"}, {"start": 795.35, "end": 798.92, "text": "勿施行刑"}, {"start": 798.92, "end": 799.92, "text": "丞相"}, {"start": 799.92, "end": 800.92, "text": "丞相"}, {"start": 800.92, "end": 801.92, "text": "谢丞相"}, {"start": 801.92, "end": 807.09, "text": "将培育大安"}, {"start": 807.09, "end": 811.42, "text": "马素只有来生再报偿了"}, {"start": 811.42, "end": 862.42, "text": "用肠留步"}, {"start": 862.42, "end": 882.27, "text": "用肠喝了这碗酒"}, {"start": 882.27, "end": 883.27, "text": "多谢文昌"}, {"start": 883.27, "end": 902.54, "text": "马素"}, {"start": 902.54, "end": 906.14, "text": "生不能随诸位将军"}, {"start": 906.14, "end": 908.14, "text": "征伐讨逆"}, {"start": 908.14, "end": 912.54, "text": "当诱我属中将士"}, {"start": 912.54, "end": 913.54, "text": "披荆斩棘"}, {"start": 913.54, "end": 915.54, "text": "巫王不胜"}, {"start": 915.54, "end": 916.54, "text": "待诸位将军"}, {"start": 916.54, "end": 918.54, "text": "北伐建功"}, {"start": 918.54, "end": 921.54, "text": "成就大业之日"}, {"start": 921.54, "end": 922.54, "text": "九泉之下"}, {"start": 922.54, "end": 927.68, "text": "也定当开怀"}, {"start": 927.68, "end": 938.51, "text": "丞相"}, {"start": 938.51, "end": 940.51, "text": "马素告辞了"}, {"start": 940.51, "end": 982.9, "text": "用肠明法"}, {"start": 982.9, "end": 984.9, "text": "临世而聚"}, {"start": 984.9, "end": 987.9, "text": "只有街庭之事"}, {"start": 987.9, "end": 989.9, "text": "就街在臣"}, {"start": 989.9, "end": 992.9, "text": "臣受任无方"}, {"start": 992.9, "end": 994.9, "text": "知人不明"}, {"start": 994.9, "end": 996.9, "text": "律事多案"}, {"start": 996.9, "end": 998.9, "text": "罪何难逃"}, {"start": 998.9, "end": 1001.9, "text": "请陛下罢免臣职"}, {"start": 1001.9, "end": 1003.9, "text": "以正皇位"}, {"start": 1003.9, "end": 1006.9, "text": "臣跪地俯首"}, {"start": 1006.9, "end": 1008.9, "text": "死待天命"}, {"start": 1008.9, "end": 1010.9, "text": "礼安来了吗"}, {"start": 1010.9, "end": 1016.0, "text": "尚书令已在外面候旨"}, {"start": 1016.0, "end": 1017.0, "text": "快传他进来"}, {"start": 1017.0, "end": 1018.0, "text": "遵命"}, {"start": 1018.0, "end": 1019.0, "text": "请"}, {"start": 1019.0, "end": 1030.35, "text": "臣奉旨见驾"}, {"start": 1030.35, "end": 1032.35, "text": "艾京"}, {"start": 1032.35, "end": 1033.35, "text": "你来得正好"}, {"start": 1033.35, "end": 1034.35, "text": "乖乖免礼免礼"}, {"start": 1034.35, "end": 1035.35, "text": "谢陛下"}, {"start": 1035.35, "end": 1036.35, "text": "朕拿到了"}, {"start": 1036.35, "end": 1038.35, "text": "丞相的请罪奏折"}, {"start": 1038.35, "end": 1040.35, "text": "他让朕罢免他的职权"}, {"start": 1040.35, "end": 1042.35, "text": "礼安啊"}, {"start": 1042.35, "end": 1043.35, "text": "依你看"}, {"start": 1043.35, "end": 1045.35, "text": "这事应该怎么办啊"}, {"start": 1045.35, "end": 1047.35, "text": "不知陛下"}, {"start": 1047.35, "end": 1049.35, "text": "心意如何呀"}, {"start": 1049.35, "end": 1051.35, "text": "朕是左右为难啊"}, {"start": 1051.35, "end": 1052.35, "text": "你说"}, {"start": 1052.35, "end": 1054.35, "text": "我如果罢免了他的职权"}, {"start": 1054.35, "end": 1055.35, "text": "国中有谁能够"}, {"start": 1055.35, "end": 1057.35, "text": "担当如此之重任"}, {"start": 1057.35, "end": 1059.35, "text": "如果朕不罢免他"}, {"start": 1059.35, "end": 1061.35, "text": "如何又能够明正典型"}, {"start": 1061.35, "end": 1063.35, "text": "须知这些新法"}, {"start": 1063.35, "end": 1065.35, "text": "都是丞相自己立下的"}, {"start": 1065.35, "end": 1067.35, "text": "这次北伐失败"}, {"start": 1067.35, "end": 1069.35, "text": "国中之大臣"}, {"start": 1069.35, "end": 1071.35, "text": "个个惊慌失措"}, {"start": 1071.35, "end": 1072.35, "text": "你说"}, {"start": 1072.35, "end": 1074.35, "text": "这让朕如何是好啊"}, {"start": 1074.35, "end": 1076.35, "text": "臣以为"}, {"start": 1076.35, "end": 1078.35, "text": "诸葛亮的权位"}, {"start": 1078.35, "end": 1080.35, "text": "是万万不可罢成"}, {"start": 1080.35, "end": 1083.35, "text": "是万万不可罢彻的"}, {"start": 1083.35, "end": 1086.35, "text": "因为朝中无人可以替代"}, {"start": 1086.35, "end": 1088.35, "text": "但北伐失败"}, {"start": 1088.35, "end": 1090.35, "text": "又不得不降罪"}, {"start": 1091.35, "end": 1092.35, "text": "陛下"}, {"start": 1092.35, "end": 1095.35, "text": "何不取个折中的法子呢"}, {"start": 1095.35, "end": 1096.35, "text": "什么折中的法子"}, {"start": 1097.35, "end": 1100.35, "text": "将他为右将军"}, {"start": 1100.35, "end": 1102.35, "text": "兴丞相式"}, {"start": 1103.35, "end": 1106.35, "text": "执掌国中兵权"}, {"start": 1107.35, "end": 1109.35, "text": "执掌军政"}, {"start": 1111.35, "end": 1112.35, "text": "好啊"}, {"start": 1114.95, "end": 1116.95, "text": "还是您想得周到啊"}, {"start": 1116.95, "end": 1117.95, "text": "谢陛下"}, {"start": 1117.95, "end": 1120.62, "text": "爱卿啊"}, {"start": 1120.62, "end": 1123.62, "text": "此次大劫你功高卓著啊"}, {"start": 1123.62, "end": 1124.62, "text": "辛苦"}, {"start": 1124.62, "end": 1125.62, "text": "太辛苦了"}, {"start": 1125.62, "end": 1126.62, "text": "瞧"}, {"start": 1126.62, "end": 1127.62, "text": "人都瘦了"}, {"start": 1127.62, "end": 1132.24, "text": "谢陛下"}, {"start": 1133.24, "end": 1135.24, "text": "太祖和先帝都曾说过"}, {"start": 1135.24, "end": 1136.24, "text": "群臣中"}, {"start": 1136.24, "end": 1139.24, "text": "唯有爱卿最知兵略"}, {"start": 1139.24, "end": 1140.24, "text": "此次大劫"}, {"start": 1140.24, "end": 1143.24, "text": "足见先帝有识人之名啊"}, {"start": 1143.24, "end": 1145.24, "text": "先帝何等圣明"}, {"start": 1145.24, "end": 1147.24, "text": "臣如无先帝教诲"}, {"start": 1148.24, "end": 1150.24, "text": "和陛下恩威"}, {"start": 1150.24, "end": 1152.24, "text": "断没有今日之声"}, {"start": 1152.24, "end": 1153.24, "text": "你看看这个"}, {"start": 1153.24, "end": 1157.66, "text": "你也看到了"}, {"start": 1157.66, "end": 1182.29, "text": "这是朕三日之前"}, {"start": 1182.29, "end": 1184.73, "text": "写的圣旨"}, {"start": 1184.73, "end": 1186.73, "text": "要加封你为大司马"}, {"start": 1186.73, "end": 1188.73, "text": "领标记大将军"}, {"start": 1189.73, "end": 1190.73, "text": "可是"}, {"start": 1191.73, "end": 1192.73, "text": "你猜怎么成"}, {"start": 1192.73, "end": 1193.73, "text": "臣猜不着"}, {"start": 1193.73, "end": 1195.73, "text": "百官纷纷上标"}, {"start": 1195.73, "end": 1199.48, "text": "说你"}, {"start": 1199.48, "end": 1201.48, "text": "曾以十五万大军"}, {"start": 1201.48, "end": 1202.48, "text": "进击西城"}, {"start": 1202.48, "end": 1203.48, "text": "然而城内"}, {"start": 1203.48, "end": 1205.48, "text": "只有诸葛亮和一千数兵"}, {"start": 1207.48, "end": 1209.48, "text": "而你却在琴声中"}, {"start": 1209.48, "end": 1210.48, "text": "放走了诸葛亮"}, {"start": 1210.48, "end": 1212.48, "text": "为魏国留下后患"}, {"start": 1212.48, "end": 1213.48, "text": "臣误以为"}, {"start": 1213.48, "end": 1215.48, "text": "城中有福君"}, {"start": 1215.48, "end": 1217.48, "text": "此乃臣之罪"}, {"start": 1217.48, "end": 1218.48, "text": "还有"}, {"start": 1218.48, "end": 1220.48, "text": "有大臣说"}, {"start": 1220.48, "end": 1222.48, "text": "你之所以放走诸葛亮"}, {"start": 1222.48, "end": 1224.48, "text": "是为了养寇自重"}, {"start": 1224.48, "end": 1225.48, "text": "因为"}, {"start": 1225.48, "end": 1227.48, "text": "没有诸葛亮为患"}, {"start": 1227.48, "end": 1228.48, "text": "你司马仪"}, {"start": 1228.48, "end": 1229.48, "text": "也就不可能"}, {"start": 1229.48, "end": 1230.48, "text": "被大用了"}, {"start": 1232.48, "end": 1233.48, "text": "禀陛下"}, {"start": 1233.48, "end": 1238.04, "text": "断无此事"}, {"start": 1238.04, "end": 1239.04, "text": "还有呢"}, {"start": 1240.04, "end": 1242.04, "text": "有人上奏弹劾"}, {"start": 1242.04, "end": 1244.04, "text": "说孟达起兵之前"}, {"start": 1244.04, "end": 1246.04, "text": "深仪曾经劝过你"}, {"start": 1247.04, "end": 1249.04, "text": "要你坐视朕被擒"}, {"start": 1250.04, "end": 1252.04, "text": "听任曹魏灭亡"}, {"start": 1252.04, "end": 1253.04, "text": "然后你则可以"}, {"start": 1253.04, "end": 1255.04, "text": "拥重兵拘王位"}, {"start": 1255.04, "end": 1256.04, "text": "角逐天下"}, {"start": 1258.04, "end": 1260.04, "text": "万万没有此事"}, {"start": 1260.04, "end": 1262.04, "text": "万万没有此事"}, {"start": 1262.04, "end": 1267.76, "text": "万万没有此事啊"}, {"start": 1270.76, "end": 1277.02, "text": "臣恳请陛下明察呀"}, {"start": 1278.02, "end": 1279.02, "text": "爱卿"}, {"start": 1280.02, "end": 1281.02, "text": "这些胡言乱语"}, {"start": 1282.02, "end": 1283.02, "text": "朕"}, {"start": 1283.02, "end": 1284.02, "text": "断断不信"}, {"start": 1284.02, "end": 1286.02, "text": "宁死也不信啊"}, {"start": 1286.02, "end": 1287.02, "text": "陛下英明"}, {"start": 1287.02, "end": 1288.02, "text": "陛下英明"}, {"start": 1288.02, "end": 1290.02, "text": "陛下英明"}, {"start": 1292.02, "end": 1293.02, "text": "可是"}, {"start": 1293.02, "end": 1294.02, "text": "他们让朕"}, {"start": 1294.02, "end": 1295.02, "text": "治你西城之罪"}, {"start": 1296.02, "end": 1297.02, "text": "你看"}, {"start": 1298.02, "end": 1300.02, "text": "这么多弹劾壮子堆在这"}, {"start": 1301.02, "end": 1302.02, "text": "朕"}, {"start": 1302.02, "end": 1304.02, "text": "一时也不敢加上你了"}, {"start": 1304.02, "end": 1309.92, "text": "请陛下罢免"}, {"start": 1309.92, "end": 1311.92, "text": "臣所有兵权"}, {"start": 1312.92, "end": 1315.92, "text": "罢彻臣所有知觉"}, {"start": 1316.92, "end": 1317.92, "text": "朕为了爱惜你"}, {"start": 1318.92, "end": 1319.92, "text": "保护你"}, {"start": 1320.92, "end": 1321.92, "text": "只能暂时"}, {"start": 1321.92, "end": 1322.92, "text": "解除你的兵权"}, {"start": 1322.92, "end": 1324.92, "text": "你也好生休息休息"}, {"start": 1324.92, "end": 1326.92, "text": "暂且不要长兵了"}, {"start": 1326.92, "end": 1328.92, "text": "陛下不杀臣"}, {"start": 1328.92, "end": 1330.92, "text": "一是天恩浩荡"}, {"start": 1330.92, "end": 1344.98, "text": "与山林之相"}, {"start": 1344.98, "end": 1345.98, "text": "哪儿都别去"}, {"start": 1350.95, "end": 1351.95, "text": "就在京都洛阳"}, {"start": 1352.95, "end": 1353.95, "text": "朕"}, {"start": 1354.95, "end": 1357.95, "text": "要赏你一座大的府宅"}, {"start": 1357.95, "end": 1359.95, "text": "比你的晚城旧宅"}, {"start": 1359.95, "end": 1360.95, "text": "大多了"}, {"start": 1361.95, "end": 1372.07, "text": "罪臣遵旨"}, {"start": 1372.07, "end": 1413.43, "text": "父亲父亲"}, {"start": 1416.06, "end": 1418.06, "text": "外面全是虎贲卫士"}, {"start": 1418.06, "end": 1422.59, "text": "我们被软禁了"}, {"start": 1422.59, "end": 1423.59, "text": "我不喝"}, {"start": 1435.57, "end": 1436.57, "text": "父亲"}, {"start": 1436.57, "end": 1437.57, "text": "没想到"}, {"start": 1437.57, "end": 1439.57, "text": "没想到陛下如此待你"}, {"start": 1440.57, "end": 1441.57, "text": "你知道吗"}, {"start": 1441.57, "end": 1444.23, "text": "你知道吗"}, {"start": 1445.23, "end": 1446.23, "text": "诸葛亮兵败汉中"}, {"start": 1446.23, "end": 1448.23, "text": "如善只是割了他的职"}, {"start": 1448.23, "end": 1450.23, "text": "并没夺他的权"}, {"start": 1450.23, "end": 1452.23, "text": "而是让他继续执掌军政"}, {"start": 1452.23, "end": 1453.23, "text": "可你呢"}, {"start": 1454.23, "end": 1456.23, "text": "打了胜仗回朝"}, {"start": 1456.23, "end": 1457.23, "text": "却什么都没有了"}, {"start": 1457.23, "end": 1458.23, "text": "还如处牢狱"}, {"start": 1459.23, "end": 1469.84, "text": "霓裳放走了诸葛亮"}, {"start": 1469.84, "end": 1471.84, "text": "曹真丧失辱国"}, {"start": 1472.84, "end": 1473.84, "text": "连吃败仗"}, {"start": 1474.84, "end": 1475.84, "text": "照样当大将军"}, {"start": 1475.84, "end": 1477.84, "text": "曹修丢了龙骑三郡"}, {"start": 1477.84, "end": 1479.84, "text": "刺杀了十几万将士"}, {"start": 1479.84, "end": 1480.84, "text": "却毫无处分"}, {"start": 1481.84, "end": 1482.84, "text": "还被炮到扬州"}, {"start": 1482.84, "end": 1484.84, "text": "当大都督去了"}, {"start": 1485.84, "end": 1487.84, "text": "你一点小小的过失"}, {"start": 1487.84, "end": 1489.84, "text": "陛下就揪住不放"}, {"start": 1489.84, "end": 1491.84, "text": "他到底想干什么呀"}, {"start": 1491.84, "end": 1492.84, "text": "住口"}, {"start": 1492.84, "end": 1494.84, "text": "天子昏庸"}, {"start": 1494.84, "end": 1496.84, "text": "朝中满食解腻"}, {"start": 1497.84, "end": 1498.84, "text": "你"}, {"start": 1498.84, "end": 1500.84, "text": "你如果再这么忍受下去"}, {"start": 1500.84, "end": 1502.84, "text": "恐怕会死无葬身之地的"}, {"start": 1502.84, "end": 1503.84, "text": "父亲"}, {"start": 1505.84, "end": 1506.84, "text": "逆子"}, {"start": 1506.84, "end": 1513.51, "text": "有一句被逆之言"}, {"start": 1513.51, "end": 1515.51, "text": "我就把你交给陛下处置"}, {"start": 1515.51, "end": 1516.51, "text": "父亲"}, {"start": 1517.51, "end": 1519.51, "text": "你还从来没打过我"}, {"start": 1519.51, "end": 1525.5, "text": "公子"}, {"start": 1525.5, "end": 1526.5, "text": "走开"}, {"start": 1527.5, "end": 1530.97, "text": "荆叔"}, {"start": 1530.97, "end": 1546.3, "text": "荆叔"}, {"start": 1546.3, "end": 1549.42, "text": "奴婢没事"}, {"start": 1549.42, "end": 1551.42, "text": "老爷心里的伤痛才重"}, {"start": 1551.42, "end": 1556.26, "text": "公子你不知道吧"}, {"start": 1557.26, "end": 1560.26, "text": "老爷已经三日没出门了"}, {"start": 1560.26, "end": 1562.26, "text": "整日干坐着"}, {"start": 1563.26, "end": 1564.26, "text": "今日"}, {"start": 1564.26, "end": 1566.26, "text": "才准奴婢来送一碗鸽"}, {"start": 1566.26, "end": 1567.26, "text": "无所依"}, {"start": 1588.04, "end": 1590.04, "text": "夫惜祸所福"}, {"start": 1590.04, "end": 1591.04, "text": "没惊我"}, {"start": 1591.04, "end": 1601.8, "text": "日子吧"}, {"start": 1601.8, "end": 1608.59, "text": "你等着"}, {"start": 1614.74, "end": 1615.74, "text": "终有一天"}, {"start": 1615.74, "end": 1617.74, "text": "朝廷还会找来的"}, {"start": 1617.74, "end": 1634.02, "text": "司马仪的预言"}, {"start": 1634.02, "end": 1635.02, "text": "很快验证"}, {"start": 1636.02, "end": 1638.02, "text": "大都督曹修"}, {"start": 1638.02, "end": 1639.02, "text": "中了濮阳太守"}, {"start": 1639.02, "end": 1640.02, "text": "中房"}, {"start": 1640.02, "end": 1641.02, "text": "炸响之际"}, {"start": 1641.02, "end": 1643.02, "text": "被陆迅"}, {"start": 1643.02, "end": 1645.02, "text": "大破语实情"}, {"start": 1645.02, "end": 1646.02, "text": "曹修"}, {"start": 1646.02, "end": 1648.02, "text": "兵败身亡"}, {"start": 1648.02, "end": 1649.02, "text": "停停停"}, {"start": 1649.02, "end": 1650.02, "text": "来"}, {"start": 1650.02, "end": 1651.02, "text": "搬过来搬过来"}, {"start": 1653.02, "end": 1655.02, "text": "司马大人"}, {"start": 1655.02, "end": 1656.02, "text": "司马大人"}, {"start": 1656.02, "end": 1658.02, "text": "你可算来了"}, {"start": 1659.02, "end": 1660.02, "text": "来来来"}, {"start": 1660.02, "end": 1661.02, "text": "大人"}, {"start": 1661.02, "end": 1662.02, "text": "你下车"}, {"start": 1667.02, "end": 1671.95, "text": "大人"}, {"start": 1671.95, "end": 1674.95, "text": "皇上候你多时了"}, {"start": 1675.95, "end": 1680.28, "text": "请"}, {"start": 1680.28, "end": 1681.28, "text": "请"}, {"start": 1683.28, "end": 1684.28, "text": "自从五弟爷"}, {"start": 1684.28, "end": 1686.28, "text": "就没有任何大臣"}, {"start": 1686.28, "end": 1689.28, "text": "能乘车直驰御街"}, {"start": 1690.28, "end": 1691.28, "text": "这份恩宠"}, {"start": 1692.28, "end": 1694.28, "text": "只有你司马大人"}, {"start": 1694.28, "end": 1695.28, "text": "享受着了"}, {"start": 1698.28, "end": 1705.39, "text": "大人"}, {"start": 1705.39, "end": 1706.39, "text": "你呢"}, {"start": 1708.96, "end": 1709.96, "text": "是老当益壮"}, {"start": 1711.96, "end": 1712.96, "text": "来来来"}, {"start": 1712.96, "end": 1713.96, "text": "慢点慢点"}, {"start": 1714.96, "end": 1715.96, "text": "慢点"}, {"start": 1716.96, "end": 1732.89, "text": "御街都快爬不动了"}, {"start": 1732.89, "end": 1733.89, "text": "司马大人"}, {"start": 1733.89, "end": 1736.89, "text": "你这是偶感风寒"}, {"start": 1736.89, "end": 1738.89, "text": "不必担心"}, {"start": 1739.89, "end": 1740.89, "text": "大人"}, {"start": 1740.89, "end": 1741.89, "text": "那咱走啊"}, {"start": 1742.89, "end": 1743.89, "text": "走"}, {"start": 1743.89, "end": 1744.89, "text": "走"}, {"start": 1745.89, "end": 1746.89, "text": "司马爷"}, {"start": 1746.89, "end": 1747.89, "text": "老爱卿"}, {"start": 1747.89, "end": 1749.89, "text": "请坐请坐"}, {"start": 1773.48, "end": 1776.21, "text": "臣谢座"}, {"start": 1777.21, "end": 1778.21, "text": "爱卿啊"}, {"start": 1778.21, "end": 1780.21, "text": "曹修战败身亡"}, {"start": 1780.21, "end": 1790.62, "text": "国中水失"}, {"start": 1790.62, "end": 1795.58, "text": "损失过半"}, {"start": 1796.58, "end": 1797.58, "text": "朕想"}, {"start": 1797.58, "end": 1798.58, "text": "率領五十万大军"}, {"start": 1798.58, "end": 1799.58, "text": "伐吾啊"}, {"start": 1800.58, "end": 1803.58, "text": "陛下真的要伐吾吗"}, {"start": 1803.58, "end": 1804.58, "text": "朕只是"}, {"start": 1804.58, "end": 1805.58, "text": "说来听听"}, {"start": 1805.58, "end": 1807.58, "text": "征求一下你的意见"}, {"start": 1807.58, "end": 1808.58, "text": "说给臣"}, {"start": 1808.58, "end": 1811.57, "text": "听听"}, {"start": 1811.57, "end": 1812.57, "text": "陛下"}, {"start": 1812.57, "end": 1814.57, "text": "不打算伐吾了"}, {"start": 1814.57, "end": 1825.38, "text": "凡事都得从长计议嘛"}, {"start": 1825.38, "end": 1826.38, "text": "陛下"}, {"start": 1826.38, "end": 1831.51, "text": "这话说得好"}, {"start": 1831.51, "end": 1833.51, "text": "应该从长计议"}, {"start": 1833.51, "end": 1835.51, "text": "陆迅不是大人"}, {"start": 1835.51, "end": 1837.51, "text": "他应该从长计议"}, {"start": 1837.51, "end": 1845.05, "text": "应该从长计议"}, {"start": 1845.05, "end": 1847.05, "text": "陆迅不是大患"}, {"start": 1848.05, "end": 1850.05, "text": "我朝大患"}, {"start": 1850.05, "end": 1852.05, "text": "仍是蜀汉朱各亮"}, {"start": 1852.05, "end": 1854.05, "text": "爱卿言之有理"}, {"start": 1854.05, "end": 1856.05, "text": "据报"}, {"start": 1856.05, "end": 1858.05, "text": "朱各亮退回汉中"}, {"start": 1858.05, "end": 1860.05, "text": "大力整顿兵马"}, {"start": 1860.05, "end": 1862.05, "text": "积攒潜梁兵器"}, {"start": 1862.05, "end": 1863.05, "text": "你看看"}, {"start": 1864.05, "end": 1867.05, "text": "他还是伐吾之心不死"}, {"start": 1867.05, "end": 1870.74, "text": "早晚还会来的"}, {"start": 1870.74, "end": 1873.25, "text": "爱卿"}, {"start": 1873.25, "end": 1875.25, "text": "蜀吾两国"}, {"start": 1875.25, "end": 1878.25, "text": "朕要以谁为首要之地"}, {"start": 1878.25, "end": 1880.25, "text": "应该以核战守之策"}, {"start": 1880.25, "end": 1882.25, "text": "盼先生赐教"}, {"start": 1882.25, "end": 1885.25, "text": "臣断不敢言教"}, {"start": 1885.25, "end": 1888.25, "text": "只能举实而论"}, {"start": 1888.25, "end": 1890.25, "text": "臣刚才说了"}, {"start": 1890.25, "end": 1893.25, "text": "蜀汉是天敌"}, {"start": 1893.25, "end": 1897.62, "text": "朝廷应该让"}, {"start": 1897.62, "end": 1899.62, "text": "东南故事"}, {"start": 1899.62, "end": 1904.26, "text": "将众军步往中原"}, {"start": 1904.26, "end": 1907.26, "text": "随时准备迎战朱各亮"}, {"start": 1907.26, "end": 1911.76, "text": "中原两千余里"}, {"start": 1911.76, "end": 1914.76, "text": "要紧之处便是陈仓"}, {"start": 1914.76, "end": 1916.76, "text": "更要有重兵把守"}, {"start": 1916.76, "end": 1918.76, "text": "为何陈仓这么紧要"}, {"start": 1918.76, "end": 1920.76, "text": "因为他恶中原燕侯"}, {"start": 1920.76, "end": 1925.04, "text": "是敌我双逢必争之地"}, {"start": 1925.04, "end": 1928.96, "text": "四百多年前"}, {"start": 1928.96, "end": 1931.96, "text": "韩信明修战道"}, {"start": 1931.96, "end": 1932.96, "text": "暗渡陈仓"}, {"start": 1932.96, "end": 1935.96, "text": "就是从那儿出兵的"}, {"start": 1935.96, "end": 1938.37, "text": "爱卿"}, {"start": 1938.37, "end": 1941.37, "text": "朕想赋你二十万兵马"}, {"start": 1941.37, "end": 1942.37, "text": "再次请你担任"}, {"start": 1942.37, "end": 1944.37, "text": "雍粮大督徒"}, {"start": 1944.37, "end": 1946.37, "text": "兼领陈仓防务"}, {"start": 1948.37, "end": 1976.6, "text": "五粮之后"}, {"start": 1976.6, "end": 1978.6, "text": "臣又换了废机"}, {"start": 1978.6, "end": 1982.58, "text": "咳血不止"}, {"start": 1982.58, "end": 1986.25, "text": "方才尚余结识"}, {"start": 1986.25, "end": 1989.25, "text": "要不是内侍扶着"}, {"start": 1989.25, "end": 1991.25, "text": "早就跌下去了"}, {"start": 1991.25, "end": 1999.29, "text": "既然如此"}, {"start": 1999.29, "end": 2004.62, "text": "那就为朕举荐一位吧"}, {"start": 2004.62, "end": 2006.62, "text": "大将军曹真"}, {"start": 2006.62, "end": 2010.64, "text": "三叔理正上课"}, {"start": 2010.64, "end": 2012.64, "text": "至于长兵征战"}, {"start": 2012.64, "end": 2015.11, "text": "朕也不必愁了"}, {"start": 2015.11, "end": 2017.11, "text": "他是败将一个"}, {"start": 2017.11, "end": 2019.11, "text": "绝非助个量之敌"}, {"start": 2019.11, "end": 2020.11, "text": "爱卿"}, {"start": 2020.11, "end": 2022.11, "text": "再为朕举荐一个吧"}, {"start": 2022.11, "end": 2024.11, "text": "大将军长子"}, {"start": 2024.11, "end": 2026.11, "text": "后将军曹爽啊"}, {"start": 2026.11, "end": 2029.36, "text": "嫩了嫩了"}, {"start": 2029.36, "end": 2030.36, "text": "乳嗅未干"}, {"start": 2030.36, "end": 2031.36, "text": "不怕"}, {"start": 2031.36, "end": 2033.36, "text": "历练历练"}, {"start": 2033.36, "end": 2034.36, "text": "就和他爹曹真"}, {"start": 2034.36, "end": 2036.36, "text": "一样老辣了"}, {"start": 2036.36, "end": 2038.99, "text": "不话讲"}, {"start": 2038.99, "end": 2040.99, "text": "清除于蓝胜于蓝吗"}, {"start": 2040.99, "end": 2047.82, "text": "仲达"}, {"start": 2047.82, "end": 2049.82, "text": "你长兵多年"}, {"start": 2049.82, "end": 2051.82, "text": "莫非心目中"}, {"start": 2051.82, "end": 2052.82, "text": "就别无能争"}, {"start": 2052.82, "end": 2054.82, "text": "善战之将吗"}, {"start": 2054.82, "end": 2056.82, "text": "陛下言过了"}, {"start": 2056.82, "end": 2060.65, "text": "臣有生之年"}, {"start": 2060.65, "end": 2063.65, "text": "仗军不足两年"}, {"start": 2063.65, "end": 2065.65, "text": "前后负贤加在一起"}, {"start": 2065.65, "end": 2071.56, "text": "倒有二十多年"}, {"start": 2071.56, "end": 2074.56, "text": "可是你人贤心不贤哪"}, {"start": 2074.56, "end": 2075.56, "text": "更何况"}, {"start": 2075.56, "end": 2078.56, "text": "你有变才之名"}, {"start": 2078.56, "end": 2079.56, "text": "你的门身故隶"}, {"start": 2079.56, "end": 2081.56, "text": "便于朝野"}, {"start": 2081.56, "end": 2082.56, "text": "你出征的时候"}, {"start": 2082.56, "end": 2083.56, "text": "婚下的战将"}, {"start": 2083.56, "end": 2085.56, "text": "为你拼死效力"}, {"start": 2085.56, "end": 2087.56, "text": "你百战百胜啊"}, {"start": 2087.56, "end": 2091.7, "text": "陛下又言过了"}, {"start": 2091.7, "end": 2092.7, "text": "将士们"}, {"start": 2092.7, "end": 2095.7, "text": "不是为臣拼死相战"}, {"start": 2095.7, "end": 2098.7, "text": "而是为陛下拼死相战"}, {"start": 2098.7, "end": 2099.7, "text": "再者"}, {"start": 2099.7, "end": 2103.7, "text": "臣也不是百战百胜"}, {"start": 2103.7, "end": 2105.7, "text": "西城那一战"}, {"start": 2105.7, "end": 2107.7, "text": "臣就中了"}, {"start": 2107.7, "end": 2109.7, "text": "诸葛亮的空城计"}, {"start": 2109.7, "end": 2112.7, "text": "现在想起来"}, {"start": 2112.7, "end": 2114.7, "text": "我都汗颜哪"}, {"start": 2114.7, "end": 2116.7, "text": "区区小事"}, {"start": 2116.7, "end": 2121.27, "text": "爱卿为何不这么想"}, {"start": 2121.27, "end": 2122.27, "text": "天下有谁能够"}, {"start": 2122.27, "end": 2123.27, "text": "把诸葛亮打得"}, {"start": 2123.27, "end": 2125.27, "text": "如此落花流水"}, {"start": 2125.27, "end": 2127.27, "text": "逼得他携带千余老幼"}, {"start": 2127.27, "end": 2129.27, "text": "逃往西城"}, {"start": 2129.27, "end": 2135.94, "text": "爱卿"}, {"start": 2135.94, "end": 2136.94, "text": "此事与你的"}, {"start": 2136.94, "end": 2138.94, "text": "累累功勋相比"}, {"start": 2138.94, "end": 2140.94, "text": "实在是九牛一毛啊"}, {"start": 2140.94, "end": 2146.5, "text": "九牛一毛"}, {"start": 2146.5, "end": 2148.5, "text": "朕永不计较此事"}, {"start": 2148.5, "end": 2167.39, "text": "有这资格"}, {"start": 2167.39, "end": 2180.07, "text": "众达"}, {"start": 2180.07, "end": 2182.07, "text": "大兵当前"}, {"start": 2182.07, "end": 2183.07, "text": "你为何不为朝廷"}, {"start": 2183.07, "end": 2184.07, "text": "举荐贤良"}, {"start": 2184.07, "end": 2195.8, "text": "将军好招可当"}, {"start": 2195.8, "end": 2198.85, "text": "好招"}, {"start": 2198.85, "end": 2202.85, "text": "此人自幼便身负沙场"}, {"start": 2202.85, "end": 2204.85, "text": "身经百战"}, {"start": 2204.85, "end": 2206.85, "text": "迫之兵发"}, {"start": 2206.85, "end": 2208.85, "text": "与世不荒"}, {"start": 2208.85, "end": 2210.85, "text": "更有一种好处"}, {"start": 2210.85, "end": 2211.85, "text": "什么好处"}, {"start": 2211.85, "end": 2218.4, "text": "他和清贵曹真相反"}, {"start": 2218.4, "end": 2220.4, "text": "从不口出大言"}, {"start": 2220.4, "end": 2225.54, "text": "好大喜功"}, {"start": 2225.54, "end": 2226.54, "text": "好"}, {"start": 2226.54, "end": 2230.64, "text": "朕命好招"}, {"start": 2230.64, "end": 2232.64, "text": "为征西大将军"}, {"start": 2232.64, "end": 2235.64, "text": "领兵进入陈仓房屋"}, {"start": 2235.64, "end": 2237.64, "text": "陛下圣断"}, {"start": 2237.64, "end": 2249.55, "text": "有话就说"}, {"start": 2249.55, "end": 2250.55, "text": "说完就走"}, {"start": 2250.55, "end": 2252.55, "text": "别惊肉欲"}, {"start": 2252.55, "end": 2253.55, "text": "父亲"}, {"start": 2253.55, "end": 2255.55, "text": "朝中传言"}, {"start": 2255.55, "end": 2256.55, "text": "说陛下给你"}, {"start": 2256.55, "end": 2257.55, "text": "二十万精兵"}, {"start": 2257.55, "end": 2258.55, "text": "请你出赈雍粮"}, {"start": 2258.55, "end": 2261.55, "text": "可你是臣病推辞"}, {"start": 2261.55, "end": 2263.55, "text": "不错"}, {"start": 2263.55, "end": 2265.55, "text": "你不想出山了"}, {"start": 2265.55, "end": 2267.55, "text": "时机未到"}, {"start": 2267.55, "end": 2269.55, "text": "做赈雍粮的事"}, {"start": 2269.55, "end": 2271.55, "text": "里面暗藏玄机"}, {"start": 2271.55, "end": 2278.35, "text": "暗藏什么玄机"}, {"start": 2278.35, "end": 2281.35, "text": "陛下让我做雍粮的大都督"}, {"start": 2281.35, "end": 2283.35, "text": "同时让曹真"}, {"start": 2283.35, "end": 2285.35, "text": "总领天下兵马"}, {"start": 2285.35, "end": 2287.35, "text": "做大将军"}, {"start": 2287.35, "end": 2289.35, "text": "也就是说"}, {"start": 2289.35, "end": 2291.35, "text": "他是我的顶头上司"}, {"start": 2291.35, "end": 2299.6, "text": "陛下让父亲对付诸葛亮"}, {"start": 2299.6, "end": 2302.6, "text": "又让曹真对付父亲"}, {"start": 2302.6, "end": 2303.6, "text": "如果胜了"}, {"start": 2303.6, "end": 2305.6, "text": "功劳全是曹真的"}, {"start": 2305.6, "end": 2306.6, "text": "如果败了"}, {"start": 2306.6, "end": 2308.6, "text": "罪过全是父亲"}, {"start": 2308.6, "end": 2319.04, "text": "半年下来"}, {"start": 2319.04, "end": 2322.04, "text": "府中已增部新兵十五万"}, {"start": 2322.04, "end": 2324.04, "text": "汉中已扩军十二万"}, {"start": 2324.04, "end": 2325.04, "text": "另外"}, {"start": 2325.04, "end": 2326.04, "text": "又添购了两万匹战马"}, {"start": 2326.04, "end": 2328.04, "text": "军械和兵器等物"}, {"start": 2328.04, "end": 2331.04, "text": "各营都在补充当中"}, {"start": 2331.04, "end": 2333.04, "text": "凡新增战技"}, {"start": 2333.04, "end": 2335.04, "text": "都归你未严执着"}, {"start": 2335.04, "end": 2337.04, "text": "粮草军械"}, {"start": 2337.04, "end": 2340.61, "text": "也由你部先行补足"}, {"start": 2340.61, "end": 2342.61, "text": "谢丞相"}, {"start": 2343.61, "end": 2345.92, "text": "你忘了"}, {"start": 2345.92, "end": 2347.92, "text": "我已不是丞相"}, {"start": 2347.92, "end": 2348.92, "text": "丞相"}, {"start": 2348.92, "end": 2350.92, "text": "待丞相试耳"}, {"start": 2353.92, "end": 2354.92, "text": "一样一样"}, {"start": 2354.92, "end": 2359.52, "text": "今秋蜀中各地大熟"}, {"start": 2359.52, "end": 2360.52, "text": "所得粮谷"}, {"start": 2360.52, "end": 2362.52, "text": "比往年多出了两三成"}, {"start": 2363.52, "end": 2364.52, "text": "尚书令李延下令"}, {"start": 2364.52, "end": 2366.52, "text": "让臣把五十万袋粮谷"}, {"start": 2366.52, "end": 2368.52, "text": "送到邪谷那儿屯放"}, {"start": 2368.52, "end": 2370.52, "text": "以备不时之需"}, {"start": 2371.52, "end": 2373.52, "text": "有何不时之需"}, {"start": 2374.52, "end": 2376.52, "text": "丞相如果北伐的话"}, {"start": 2376.52, "end": 2378.52, "text": "粮草不得先行吗"}, {"start": 2379.52, "end": 2380.52, "text": "不错"}, {"start": 2381.52, "end": 2383.52, "text": "朝中文武能如此勤勉"}, {"start": 2383.52, "end": 2389.78, "text": "真乃疏汉之福啊"}, {"start": 2389.78, "end": 2390.78, "text": "对了"}, {"start": 2390.78, "end": 2393.78, "text": "卫武两军交战情况如何"}, {"start": 2393.78, "end": 2395.78, "text": "竟有何军报"}, {"start": 2395.78, "end": 2397.78, "text": "藩城传来消息"}, {"start": 2397.78, "end": 2399.78, "text": "卫国大都督曹修"}, {"start": 2399.78, "end": 2401.78, "text": "中了炸响之际"}, {"start": 2401.78, "end": 2402.78, "text": "被陆迅大败于"}, {"start": 2402.78, "end": 2404.78, "text": "江北实体一带"}, {"start": 2404.78, "end": 2407.78, "text": "卫国水师丧失殆尽"}, {"start": 2407.78, "end": 2410.78, "text": "曹修是羞愤而死啊"}, {"start": 2410.78, "end": 2414.1, "text": "果真如此的话"}, {"start": 2414.1, "end": 2417.1, "text": "对蜀汉倒也是一桩幸事"}, {"start": 2418.1, "end": 2420.1, "text": "知不知怯与不怯"}, {"start": 2421.1, "end": 2425.1, "text": "我看这事千真万确"}, {"start": 2426.1, "end": 2427.1, "text": "为何呀"}, {"start": 2428.1, "end": 2430.1, "text": "因为我也接到军报"}, {"start": 2430.1, "end": 2432.1, "text": "说卫国在中原调兵遣将"}, {"start": 2432.1, "end": 2433.1, "text": "加紧布防"}, {"start": 2434.1, "end": 2435.1, "text": "丞相请讲"}, {"start": 2435.1, "end": 2438.1, "text": "这曹芮为何要调兵遣将"}, {"start": 2438.1, "end": 2439.1, "text": "加紧布防啊"}, {"start": 2439.1, "end": 2440.1, "text": "因为他怕"}, {"start": 2440.1, "end": 2442.1, "text": "他怕丞相成卫国兵败"}, {"start": 2442.1, "end": 2443.1, "text": "发军北伐"}, {"start": 2445.1, "end": 2448.1, "text": "如今还是曹真管理"}, {"start": 2448.1, "end": 2449.1, "text": "雍粮防务"}, {"start": 2449.1, "end": 2450.1, "text": "正是"}, {"start": 2451.1, "end": 2453.1, "text": "但是还有一员被将"}, {"start": 2453.1, "end": 2454.1, "text": "叫郝昭"}, {"start": 2454.1, "end": 2456.1, "text": "曹芮现在已命他为"}, {"start": 2456.1, "end": 2458.1, "text": "镇西将军镇守陈仓了"}, {"start": 2460.1, "end": 2461.1, "text": "郝昭"}, {"start": 2461.1, "end": 2462.1, "text": "自国道"}, {"start": 2462.1, "end": 2464.1, "text": "太原人士三十上下"}, {"start": 2464.1, "end": 2466.1, "text": "早年是徐皇不下"}, {"start": 2466.1, "end": 2468.1, "text": "后从征于司马仪"}, {"start": 2468.1, "end": 2469.1, "text": "丞相啊"}, {"start": 2470.1, "end": 2472.1, "text": "如果要是二次北伐"}, {"start": 2472.1, "end": 2473.1, "text": "你是不是"}, {"start": 2474.1, "end": 2476.1, "text": "打算从陈仓进军啊"}]