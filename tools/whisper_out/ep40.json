[{"start": 129.26, "end": 131.62, "text": "这是谁啊?怎么睡到我踏上来了?"}, {"start": 133.18, "end": 136.06, "text": "大都督,请故人蒋干同踏而面。"}, {"start": 136.06, "end": 152.01, "text": "果然是子宜。"}, {"start": 154.84, "end": 155.92, "text": "喝醉了喝醉了。"}, {"start": 157.73, "end": 159.53, "text": "万万不该喝醉啊。"}, {"start": 159.53, "end": 163.79, "text": "也不知道说什么梦话没有。"}, {"start": 170.94, "end": 172.82, "text": "你神经半夜的唤我何事啊?"}, {"start": 173.78, "end": 175.02, "text": "江北有人到此。"}, {"start": 303.76, "end": 304.28, "text": "夫人。"}, {"start": 304.28, "end": 305.76, "text": "先生,上哪儿去啊?"}, {"start": 306.4, "end": 308.0, "text": "在下正准备回江北。"}, {"start": 308.8, "end": 309.88, "text": "大都督知道吗?"}, {"start": 311.52, "end": 314.48, "text": "大都督酒醉未醒,在下不忍惊动他。"}, {"start": 315.24, "end": 317.92, "text": "那怎么成?先生是大都督的旧友。"}, {"start": 318.2, "end": 320.0, "text": "他应该亲自相送才是啊。"}, {"start": 320.8, "end": 323.08, "text": "先生稍后带我回禀大都督去。"}, {"start": 323.68, "end": 324.48, "text": "夫人且慢。"}, {"start": 327.61, "end": 328.17, "text": "夫人啊。"}, {"start": 329.37, "end": 331.69, "text": "恭敬好意,待在下疾后。"}, {"start": 332.73, "end": 335.65, "text": "昨夜,在下平生未有如此大罪。"}, {"start": 337.45, "end": 340.69, "text": "如果恭敬得知我走,定然会强行挽留。"}, {"start": 341.65, "end": 343.93, "text": "那岂不是又要醉得天崩地裂吗?"}, {"start": 344.85, "end": 348.09, "text": "所以在下寻思,除了不辞而别,"}, {"start": 348.41, "end": 349.85, "text": "实在是没有别的办法。"}, {"start": 350.53, "end": 351.57, "text": "还请夫人见谅。"}, {"start": 353.29, "end": 356.09, "text": "既然如此,那我就不禀报大都督了。"}, {"start": 357.85, "end": 359.65, "text": "多谢夫人,在下告辞。"}, {"start": 361.88, "end": 366.03, "text": "先生且慢。先生你是客,"}, {"start": 366.63, "end": 368.43, "text": "岂能让你自行驾舟。"}, {"start": 369.35, "end": 371.91, "text": "带我回去叫两位军士送你回江北。"}, {"start": 372.55, "end": 373.15, "text": "万万不可。"}, {"start": 374.99, "end": 375.55, "text": "为何呢?"}, {"start": 378.48, "end": 378.84, "text": "夫人,"}, {"start": 380.44, "end": 384.8, "text": "时下,东吴玉曹丞相正处于交战状态。"}, {"start": 385.76, "end": 388.52, "text": "我是担心这江东的军士到了江北"}, {"start": 388.8, "end": 389.92, "text": "只怕多有不便呢。"}, {"start": 392.42, "end": 395.94, "text": "先生说得是,那我就只好不送了。"}, {"start": 397.54, "end": 398.26, "text": "夫人告辞。"}, {"start": 399.02, "end": 399.7, "text": "日后再来啊。"}, {"start": 412.79, "end": 413.19, "text": "走了。"}, {"start": 415.16, "end": 415.48, "text": "走了。"}, {"start": 418.04, "end": 418.84, "text": "多谢你啊,小巧。"}, {"start": 419.2, "end": 433.74, "text": "你看太阳快升起来了。"}, {"start": 435.1, "end": 436.86, "text": "好像专为你我而升起来了。"}, {"start": 451.4, "end": 452.76, "text": "禀丞相,参见蒋干回来了。"}, {"start": 453.56, "end": 454.52, "text": "回来,回来,回来。"}, {"start": 457.57, "end": 458.01, "text": "丞相。"}, {"start": 458.61, "end": 458.85, "text": "来。"}, {"start": 461.65, "end": 463.89, "text": "蒋干,事情办得如何?"}, {"start": 465.01, "end": 467.05, "text": "在下惭愧,没能说动周瑜。"}, {"start": 471.65, "end": 474.33, "text": "看来我根本就不应该叫你去做这个说客。"}, {"start": 475.29, "end": 478.57, "text": "此事不成,反遭周瑜耻笑。"}, {"start": 480.37, "end": 483.21, "text": "不过丞相,在下虽然没能说动周瑜,"}, {"start": 483.85, "end": 486.01, "text": "却为丞相取得了一件天大的机密。"}, {"start": 486.97, "end": 487.73, "text": "什么机密?"}, {"start": 488.25, "end": 493.22, "text": "丞相请看,请不要动怒。"}, {"start": 493.94, "end": 503.83, "text": "凯尔纳。"}, {"start": 504.11, "end": 504.43, "text": "在。"}, {"start": 505.59, "end": 507.83, "text": "你各叫蔡茂张云来见我。"}, {"start": 508.15, "end": 508.47, "text": "诺。"}, {"start": 509.15, "end": 523.47, "text": "丞相,末将奉命呈见。"}, {"start": 524.43, "end": 529.55, "text": "蔡茂,我让你调练水军,你调练得如何了?"}, {"start": 531.03, "end": 534.19, "text": "禀丞相,各营上下正在日夜苦练,"}, {"start": 534.87, "end": 537.59, "text": "骑号、弓弩、巨弦书。"}, {"start": 537.59, "end": 543.19, "text": "但船阵之间的互相协调及其水面战法还不熟练,仍需时日。"}, {"start": 543.19, "end": 546.71, "text": "等你熟练了,我的头颅也就挂到江东了吧。"}, {"start": 548.39, "end": 549.27, "text": "末将不明大事。"}, {"start": 549.27, "end": 552.65, "text": "天谕他听。"}, {"start": 553.37, "end": 559.16, "text": "禀大都督,茂等降曹,实属无奈。"}, {"start": 559.52, "end": 563.32, "text": "今日得知,曹操攻去江东之后,吐死狗烹。"}, {"start": 563.68, "end": 566.32, "text": "罢免茂等荆州降临,永不再用。"}, {"start": 566.64, "end": 569.44, "text": "茂等既恨且愧,痛不可当。"}, {"start": 569.48, "end": 572.72, "text": "茂等已决定将功折罪,投效江东吴侯。"}, {"start": 572.72, "end": 575.8, "text": "如今,曹操水军已在我掌握之中,"}, {"start": 575.8, "end": 578.04, "text": "水上银寨未已暗流破绽。"}, {"start": 578.04, "end": 581.64, "text": "交战时,大都督只需从西北方击入船阵,"}, {"start": 581.64, "end": 584.24, "text": "那江北营寨便会随之崩坏。"}, {"start": 584.24, "end": 588.44, "text": "事实,茂碧驱使取下曹操首级,陷于吴侯。"}, {"start": 589.44, "end": 590.04, "text": "不!"}, {"start": 590.04, "end": 591.64, "text": "带出去!斩了!"}, {"start": 591.64, "end": 592.64, "text": "诺!"}, {"start": 592.64, "end": 595.64, "text": "若不,丞相,丞相,丞相!"}, {"start": 595.64, "end": 597.44, "text": "这是奸计!"}, {"start": 597.44, "end": 598.44, "text": "丞相!"}, {"start": 598.44, "end": 600.44, "text": "这是奸计啊,丞相!"}, {"start": 600.44, "end": 601.44, "text": "丞相!"}, {"start": 601.44, "end": 602.44, "text": "丞相!"}, {"start": 602.44, "end": 603.44, "text": "冤枉啊!"}, {"start": 603.44, "end": 611.85, "text": "我忠心耿耿为丞相灭兵!"}, {"start": 611.85, "end": 613.85, "text": "你听信小人缠言!"}, {"start": 613.85, "end": 617.85, "text": "那是小人使出的奸计啊!"}, {"start": 617.85, "end": 624.99, "text": "丞相!"}, {"start": 624.99, "end": 626.99, "text": "禀丞相,蔡茂张云已被斩首。"}, {"start": 626.99, "end": 639.56, "text": "将蔡茂张云的首级"}, {"start": 640.56, "end": 646.56, "text": "传递水军各营,并宣布其通敌大罪。"}, {"start": 646.56, "end": 647.56, "text": "遵命!"}, {"start": 647.56, "end": 662.3, "text": "于晋、老介。"}, {"start": 662.3, "end": 664.64, "text": "末将在!"}, {"start": 664.64, "end": 665.64, "text": "末将在!"}, {"start": 665.64, "end": 672.5, "text": "你二人曾经提领过新许水军,"}, {"start": 672.5, "end": 676.5, "text": "说你二人担任正副都督,"}, {"start": 676.5, "end": 680.5, "text": "重整船阵,重新布防。"}, {"start": 680.5, "end": 681.5, "text": "领命!"}, {"start": 681.5, "end": 688.38, "text": "领命!"}, {"start": 688.38, "end": 690.38, "text": "启禀丞相,末将有一建议。"}, {"start": 691.38, "end": 693.38, "text": "你说!"}, {"start": 694.38, "end": 698.38, "text": "将我北军将士大刀善于弓马刀剑,"}, {"start": 698.38, "end": 700.38, "text": "却不善于周击。"}, {"start": 700.38, "end": 703.38, "text": "他们登船之后烧于风浪,便会晕船,"}, {"start": 703.38, "end": 704.38, "text": "不利于交战。"}, {"start": 705.38, "end": 710.38, "text": "末将建议将所有战船用铁索连为一体,"}, {"start": 710.38, "end": 715.38, "text": "使船体困入陆地,既抗风浪,又稳如城池。"}, {"start": 715.38, "end": 719.38, "text": "军士登船交战,便可大战神威。"}, {"start": 719.38, "end": 720.38, "text": "好主意!"}, {"start": 720.38, "end": 727.98, "text": "你们看,蔡茂她就偏偏不肯这么做。"}, {"start": 727.98, "end": 732.98, "text": "现在你们明白了吧,她确实是个奸贼。"}, {"start": 733.98, "end": 739.98, "text": "于敬,你即刻上任,改舰船阵。"}, {"start": 740.98, "end": 741.98, "text": "遵命!"}, {"start": 741.98, "end": 769.08, "text": "通敌被丞相处死,公子这是为何?"}, {"start": 769.08, "end": 777.36, "text": "不,蔡茂将军无罪,是被周虞害死的。"}, {"start": 777.36, "end": 782.25, "text": "蔡将军为国捐躯,功垂古今。"}, {"start": 782.25, "end": 792.26, "text": "二位叔伯啊,我实话相告,"}, {"start": 793.26, "end": 796.26, "text": "丞相为此正悲痛万分。"}, {"start": 796.26, "end": 805.22, "text": "他虽然不便亲治,却特令我以子之身份前来拜祭守灵,"}, {"start": 806.22, "end": 809.22, "text": "以消除丞相内心之悲痛。"}, {"start": 809.22, "end": 813.94, "text": "公子,这到底是怎么回事?"}, {"start": 813.94, "end": 822.35, "text": "那封密信是周虞伪造的。"}, {"start": 822.35, "end": 828.98, "text": "丞相已是失察,挫斩了蔡茂将军。"}, {"start": 829.98, "end": 835.98, "text": "此刻丞相的心里,真是追悔莫及,痛不可挡啊。"}, {"start": 835.98, "end": 842.66, "text": "现在,他已经秘密地除斩了蒋干。"}, {"start": 842.66, "end": 848.9, "text": "一位蔡茂将军,深冤。"}, {"start": 851.5, "end": 861.25, "text": "我还要恭喜二位叔伯。"}, {"start": 861.25, "end": 867.22, "text": "恭喜我们。"}, {"start": 872.66, "end": 875.66, "text": "丞相已尚造天子。"}, {"start": 875.66, "end": 882.1, "text": "赤峰蔡中为湘中侯,"}, {"start": 882.1, "end": 886.1, "text": "赤峰蔡和为新野侯。"}, {"start": 886.1, "end": 890.1, "text": "并拜两位叔伯为中军将军,"}, {"start": 890.1, "end": 894.1, "text": "各赏黄金一万两。"}, {"start": 894.1, "end": 897.1, "text": "谢丞相大恩。"}, {"start": 897.1, "end": 899.1, "text": "丞相还说了,"}, {"start": 900.1, "end": 903.1, "text": "如果二位可为朝廷建功的话,"}, {"start": 903.1, "end": 906.1, "text": "丞相还会重重地升上二位。"}, {"start": 906.1, "end": 911.3, "text": "请公子吩咐,"}, {"start": 911.3, "end": 914.3, "text": "我等如何才能建功?"}, {"start": 914.3, "end": 918.96, "text": "炸降。"}, {"start": 919.96, "end": 920.96, "text": "炸降?"}, {"start": 920.96, "end": 921.96, "text": "正是。"}, {"start": 921.96, "end": 925.3, "text": "如果你们现在投往江东,"}, {"start": 925.3, "end": 927.3, "text": "必定能够得到周虞的信任。"}, {"start": 927.3, "end": 928.3, "text": "为何?"}, {"start": 928.3, "end": 932.3, "text": "因为丞相斩了你们的亲哥哥蔡茂。"}, {"start": 932.3, "end": 936.38, "text": "你们对丞相恨之入骨。"}, {"start": 936.38, "end": 939.79, "text": "你们投往江东,"}, {"start": 939.79, "end": 943.79, "text": "也是为亲哥哥复仇吗?"}, {"start": 943.79, "end": 951.84, "text": "你们应该明白,"}, {"start": 951.84, "end": 954.84, "text": "真正杀害蔡茂将军的,"}, {"start": 954.84, "end": 957.84, "text": "并不是丞相,"}, {"start": 957.84, "end": 959.84, "text": "而是周虞。"}, {"start": 959.84, "end": 963.89, "text": "你们炸降过去之后,"}, {"start": 963.89, "end": 964.89, "text": "趁肩行事,"}, {"start": 964.89, "end": 966.89, "text": "助丞相除掉周虞。"}, {"start": 966.89, "end": 967.89, "text": "同时,"}, {"start": 967.89, "end": 969.89, "text": "二位叔伯,"}, {"start": 969.89, "end": 972.89, "text": "也为自己的哥哥报仇雪恨。"}, {"start": 972.89, "end": 973.89, "text": "请问,"}, {"start": 973.89, "end": 980.26, "text": "我都愿意。"}, {"start": 980.26, "end": 981.26, "text": "好。"}, {"start": 981.26, "end": 983.26, "text": "我这就回禀丞相,"}, {"start": 983.26, "end": 986.26, "text": "以消除丞相之心头悲痛。"}, {"start": 986.26, "end": 987.26, "text": "丞相大恩。"}, {"start": 987.26, "end": 1063.25, "text": "高山流水,"}, {"start": 1063.25, "end": 1065.25, "text": "一身情长。"}, {"start": 1065.25, "end": 1068.25, "text": "琴宵相伴,"}, {"start": 1068.25, "end": 1071.25, "text": "如闻天籁。"}, {"start": 1071.25, "end": 1072.25, "text": "我紫荆,"}, {"start": 1072.25, "end": 1075.25, "text": "真是要醉了。"}, {"start": 1076.25, "end": 1078.25, "text": "先生取笑了。"}, {"start": 1078.25, "end": 1079.25, "text": "紫荆,"}, {"start": 1079.25, "end": 1080.25, "text": "何事?"}, {"start": 1080.25, "end": 1084.01, "text": "恭喜大都督啊。"}, {"start": 1084.01, "end": 1087.01, "text": "反奸计大功告成了。"}, {"start": 1087.01, "end": 1089.01, "text": "刚才接到谈报,"}, {"start": 1089.01, "end": 1092.01, "text": "说江北曹营市一片哗然。"}, {"start": 1092.01, "end": 1095.01, "text": "蔡茂已经被曹操斩首了。"}, {"start": 1095.01, "end": 1097.01, "text": "又伤将军余金,"}, {"start": 1097.01, "end": 1099.01, "text": "前军赴江茅界,"}, {"start": 1099.01, "end": 1101.01, "text": "既然水势正负都督。"}, {"start": 1101.01, "end": 1103.67, "text": "好啊。"}, {"start": 1103.67, "end": 1107.34, "text": "没想到我这区区一道反奸计,"}, {"start": 1107.34, "end": 1109.34, "text": "借蒋干为使,"}, {"start": 1109.34, "end": 1111.34, "text": "竟然有这等奇效啊。"}, {"start": 1112.34, "end": 1113.34, "text": "是啊。"}, {"start": 1113.34, "end": 1114.34, "text": "大都督的谋略,"}, {"start": 1114.34, "end": 1116.34, "text": "真是神鬼莫测啊。"}, {"start": 1116.34, "end": 1120.34, "text": "蔡茂本是我江东水势的大患。"}, {"start": 1120.34, "end": 1121.34, "text": "她这一死,"}, {"start": 1121.34, "end": 1123.34, "text": "曹操水势的调炼和指挥,"}, {"start": 1123.34, "end": 1125.34, "text": "必定是大打折扣。"}, {"start": 1126.34, "end": 1127.34, "text": "如此,"}, {"start": 1127.34, "end": 1129.34, "text": "曹军必败。"}, {"start": 1129.34, "end": 1131.34, "text": "我知道计谋,"}, {"start": 1137.94, "end": 1139.94, "text": "估计他人看不出奥妙。"}, {"start": 1139.94, "end": 1144.95, "text": "却不知聪明绝顶的朱可亮,"}, {"start": 1144.95, "end": 1146.95, "text": "能否闻出她的味来。"}, {"start": 1146.95, "end": 1147.95, "text": "紫荆,"}, {"start": 1147.95, "end": 1154.94, "text": "劳你替我去探探她的口风。"}, {"start": 1154.94, "end": 1162.17, "text": "空明也不过是凡人而已。"}, {"start": 1162.17, "end": 1165.17, "text": "恐怕未必看得出其中的奥妙。"}, {"start": 1165.17, "end": 1167.17, "text": "我前去一探。"}, {"start": 1167.17, "end": 1170.86, "text": "紫荆,"}, {"start": 1170.86, "end": 1173.17, "text": "恭喜恭喜。"}, {"start": 1174.17, "end": 1176.17, "text": "喜从何来啊?"}, {"start": 1176.17, "end": 1179.17, "text": "恭景时反奸计杀了蔡茂,"}, {"start": 1179.17, "end": 1181.17, "text": "猜紫荆来探我口风,"}, {"start": 1181.17, "end": 1182.17, "text": "看我知与不知,"}, {"start": 1182.17, "end": 1184.17, "text": "便是这事可喜啊。"}, {"start": 1185.17, "end": 1186.17, "text": "空明,"}, {"start": 1186.17, "end": 1188.17, "text": "你是如何知道的?"}, {"start": 1188.17, "end": 1190.17, "text": "蔡茂的死讯一传来,"}, {"start": 1190.17, "end": 1192.17, "text": "我便猜出定是恭景所为。"}, {"start": 1192.17, "end": 1193.17, "text": "不过,"}, {"start": 1194.17, "end": 1197.17, "text": "这等计谋只能瞒得过奖干之流。"}, {"start": 1197.17, "end": 1199.17, "text": "曹操虽然一时不查,"}, {"start": 1199.17, "end": 1201.17, "text": "但早晚都会看破的。"}, {"start": 1201.17, "end": 1204.17, "text": "只不过曹操不肯认错罢了。"}, {"start": 1204.17, "end": 1208.17, "text": "有道是曹阿满知错改错,"}, {"start": 1208.17, "end": 1209.17, "text": "不认错。"}, {"start": 1210.17, "end": 1211.17, "text": "空明啊,"}, {"start": 1211.17, "end": 1212.17, "text": "还有一事。"}, {"start": 1212.17, "end": 1214.17, "text": "你知道蔡茂死后,"}, {"start": 1214.17, "end": 1216.17, "text": "是谁继任了水市都督吗?"}, {"start": 1218.17, "end": 1220.17, "text": "我刚才不是说了两个恭喜吗?"}, {"start": 1220.17, "end": 1222.17, "text": "这第一次恭喜是为蔡茂。"}, {"start": 1222.17, "end": 1224.17, "text": "这第二次恭喜,"}, {"start": 1224.17, "end": 1227.17, "text": "就是为于敬毛介接任水市都督。"}, {"start": 1227.17, "end": 1229.17, "text": "在这两个莽夫手里,"}, {"start": 1229.17, "end": 1231.17, "text": "必送了曹操水市的信。"}, {"start": 1233.17, "end": 1234.17, "text": "紫禁啊,"}, {"start": 1234.17, "end": 1245.64, "text": "待会儿回见恭景时,"}, {"start": 1245.64, "end": 1247.64, "text": "千万别说我看破了他的妙计啊。"}, {"start": 1247.64, "end": 1250.64, "text": "你一定要说我一无所知。"}, {"start": 1250.64, "end": 1251.64, "text": "拜托,"}, {"start": 1251.64, "end": 1252.64, "text": "拜托了。"}, {"start": 1253.64, "end": 1255.64, "text": "越是聪明无比之人,"}, {"start": 1255.64, "end": 1257.64, "text": "越要假装愚昧啊。"}, {"start": 1257.64, "end": 1259.64, "text": "如此,"}, {"start": 1259.64, "end": 1262.89, "text": "能让恭景快乐一些,"}, {"start": 1262.89, "end": 1263.89, "text": "自豪一些。"}, {"start": 1264.89, "end": 1266.89, "text": "恭景心情好了,"}, {"start": 1266.89, "end": 1268.89, "text": "对孙柳联手才大有助矣。"}, {"start": 1268.89, "end": 1270.89, "text": "若是他心情不好,"}, {"start": 1270.89, "end": 1272.89, "text": "我就要跟着倒霉了。"}, {"start": 1272.89, "end": 1274.89, "text": "紫禁切记,"}, {"start": 1274.89, "end": 1276.89, "text": "切切不可直言。"}, {"start": 1276.89, "end": 1277.89, "text": "明白。"}, {"start": 1277.89, "end": 1280.52, "text": "紫禁,"}, {"start": 1280.52, "end": 1302.16, "text": "大都督,"}, {"start": 1302.16, "end": 1305.66, "text": "见过孔明了。"}, {"start": 1316.26, "end": 1318.26, "text": "他看出我的反间计谋。"}, {"start": 1318.26, "end": 1323.4, "text": "我很想说,"}, {"start": 1323.4, "end": 1325.4, "text": "他没看出来。"}, {"start": 1325.4, "end": 1326.4, "text": "可是,"}, {"start": 1326.4, "end": 1331.03, "text": "可是孔明把一切都看出来了。"}, {"start": 1331.03, "end": 1333.03, "text": "而且在我刚进门的时候,"}, {"start": 1333.03, "end": 1334.03, "text": "他就看出,"}, {"start": 1334.03, "end": 1337.03, "text": "我此行是去探他的口风。"}, {"start": 1337.03, "end": 1338.03, "text": "此人绝不可留,"}, {"start": 1338.03, "end": 1347.01, "text": "必须展示一出后患。"}, {"start": 1347.01, "end": 1351.4, "text": "恭景呢,"}, {"start": 1351.4, "end": 1354.4, "text": "还帮你以抗曹大局为重,"}, {"start": 1354.4, "end": 1356.4, "text": "万不可一意孤行啊。"}, {"start": 1356.4, "end": 1357.4, "text": "放心,"}, {"start": 1357.4, "end": 1361.67, "text": "我自然会依法办事。"}, {"start": 1362.67, "end": 1364.67, "text": "叫孔明死而无怨。"}, {"start": 1365.67, "end": 1367.67, "text": "依法办事,"}, {"start": 1367.67, "end": 1368.67, "text": "敢问,"}, {"start": 1368.67, "end": 1370.67, "text": "你所依何法呀?"}, {"start": 1370.67, "end": 1371.67, "text": "军法。"}, {"start": 1371.67, "end": 1373.67, "text": "主公立下七禁令五十四斩,"}, {"start": 1373.67, "end": 1378.42, "text": "任何人都必须遵行。"}, {"start": 1378.42, "end": 1380.42, "text": "违法者自我以下,"}, {"start": 1380.42, "end": 1381.42, "text": "也包括我,"}, {"start": 1381.42, "end": 1382.42, "text": "都可以政府。"}, {"start": 1382.42, "end": 1389.77, "text": "自家的嬴泪梨,"}, {"start": 1389.77, "end": 1409.95, "text": "竟也是杀鸡四伏啊。"}, {"start": 1409.95, "end": 1411.95, "text": "我既不能让周瑜杀了孔明,"}, {"start": 1411.95, "end": 1413.95, "text": "因而毁了孙刘联盟,"}, {"start": 1413.95, "end": 1416.95, "text": "也不能逆着公金保护孔明,"}, {"start": 1416.95, "end": 1419.95, "text": "因而激怒镇前主帅。"}, {"start": 1420.95, "end": 1425.7, "text": "几何孔明之间的争斗,"}, {"start": 1425.7, "end": 1429.7, "text": "只怕比这江上之战更加激烈。"}, {"start": 1429.7, "end": 1435.58, "text": "我夹在这两个绝世英才中间,"}, {"start": 1435.58, "end": 1438.58, "text": "如何行事做人呢?"}, {"start": 1438.58, "end": 1455.68, "text": "孔明啊,"}, {"start": 1455.68, "end": 1457.68, "text": "这天时转暖,"}, {"start": 1457.68, "end": 1458.68, "text": "春水泛滥,"}, {"start": 1458.68, "end": 1460.68, "text": "我料不日即将开战,"}, {"start": 1460.68, "end": 1463.68, "text": "到时你定要助我啊。"}, {"start": 1463.68, "end": 1465.68, "text": "大都督不必客气,"}, {"start": 1465.68, "end": 1467.68, "text": "你我孙刘两家,"}, {"start": 1467.68, "end": 1468.68, "text": "早已生死与共,"}, {"start": 1468.68, "end": 1469.68, "text": "荣辱同舟。"}, {"start": 1469.68, "end": 1470.68, "text": "主公吩咐过我,"}, {"start": 1470.68, "end": 1472.68, "text": "军中任何事,"}, {"start": 1472.68, "end": 1475.68, "text": "在下都要遵奉大都督军令。"}, {"start": 1475.68, "end": 1478.68, "text": "好,好。"}, {"start": 1478.68, "end": 1479.68, "text": "你看,"}, {"start": 1479.68, "end": 1481.68, "text": "这水上交战,"}, {"start": 1481.68, "end": 1484.68, "text": "当以何种兵器为先呢?"}, {"start": 1484.68, "end": 1486.68, "text": "大都督乃天下名将,"}, {"start": 1486.68, "end": 1487.68, "text": "游善水战,"}, {"start": 1487.68, "end": 1489.68, "text": "何必询问在下呢?"}, {"start": 1489.68, "end": 1493.54, "text": "你且说来。"}, {"start": 1493.54, "end": 1496.68, "text": "禀大都督,"}, {"start": 1496.68, "end": 1497.68, "text": "水上交战,"}, {"start": 1497.68, "end": 1500.68, "text": "双方当以弓箭为先。"}, {"start": 1500.68, "end": 1501.68, "text": "先生所言,"}, {"start": 1501.68, "end": 1507.36, "text": "圣和兵法呀,"}, {"start": 1507.36, "end": 1509.36, "text": "可如今,"}, {"start": 1509.36, "end": 1512.36, "text": "我军中缺少箭弩,"}, {"start": 1512.36, "end": 1513.36, "text": "我想劳请先生"}, {"start": 1513.36, "end": 1514.36, "text": "兼造弓箭十万支,"}, {"start": 1514.36, "end": 1516.36, "text": "用于水上制敌,"}, {"start": 1516.36, "end": 1519.36, "text": "盼先生不要推辞才好。"}, {"start": 1519.36, "end": 1520.36, "text": "大都督军令,"}, {"start": 1520.36, "end": 1523.36, "text": "在下自当遵奉,"}, {"start": 1523.36, "end": 1525.36, "text": "只不知这十万支箭,"}, {"start": 1525.36, "end": 1527.36, "text": "大都督何时要用呢?"}, {"start": 1527.36, "end": 1532.78, "text": "先生十日之内,"}, {"start": 1532.78, "end": 1534.78, "text": "可以办完吗?"}, {"start": 1534.78, "end": 1539.15, "text": "大战已迫在眉睫,"}, {"start": 1539.15, "end": 1542.15, "text": "也随时可能交兵,"}, {"start": 1542.15, "end": 1544.15, "text": "如再拖延十日,"}, {"start": 1544.15, "end": 1551.56, "text": "岂不一物战机吗?"}, {"start": 1551.56, "end": 1553.56, "text": "那先生估计几日可以办完?"}, {"start": 1553.56, "end": 1560.01, "text": "只需三日。"}, {"start": 1560.01, "end": 1562.01, "text": "军中无戏言。"}, {"start": 1562.01, "end": 1565.01, "text": "在下怎敢戏弄大都督,"}, {"start": 1565.01, "end": 1569.01, "text": "诸葛亮愿当众立下军令状,"}, {"start": 1569.01, "end": 1571.01, "text": "如三日之后,"}, {"start": 1571.01, "end": 1573.01, "text": "造不出十万支箭,"}, {"start": 1573.01, "end": 1575.01, "text": "军法受处。"}, {"start": 1575.01, "end": 1576.01, "text": "取文书来,"}, {"start": 1576.01, "end": 1577.01, "text": "让孔明画押。"}, {"start": 1577.01, "end": 1578.01, "text": "不过,"}, {"start": 1578.01, "end": 1580.01, "text": "今日已经来不及了。"}, {"start": 1580.01, "end": 1582.01, "text": "明日算是第一日。"}, {"start": 1582.01, "end": 1583.01, "text": "待三日后半晚,"}, {"start": 1583.01, "end": 1584.01, "text": "有事证。"}, {"start": 1584.01, "end": 1586.01, "text": "请大都督着五百军士,"}, {"start": 1586.01, "end": 1588.01, "text": "来江边搬箭。"}, {"start": 1588.01, "end": 1592.66, "text": "好。"}, {"start": 1592.66, "end": 1593.66, "text": "孔明啊,"}, {"start": 1593.66, "end": 1595.66, "text": "我讨杯茶吃吃啊。"}, {"start": 1595.66, "end": 1596.66, "text": "子敬啊,"}, {"start": 1596.66, "end": 1597.66, "text": "你害死我也,"}, {"start": 1597.66, "end": 1599.66, "text": "害死我也。"}, {"start": 1599.66, "end": 1600.66, "text": "这倒怪了。"}, {"start": 1600.66, "end": 1601.66, "text": "这第一,"}, {"start": 1601.66, "end": 1603.66, "text": "不是我令你造箭。"}, {"start": 1603.66, "end": 1604.66, "text": "第二,"}, {"start": 1604.66, "end": 1605.66, "text": "不是我逼你画押。"}, {"start": 1605.66, "end": 1607.66, "text": "我怎生害你了?"}, {"start": 1607.66, "end": 1608.66, "text": "再说,"}, {"start": 1608.66, "end": 1609.66, "text": "在下区区俗物,"}, {"start": 1609.66, "end": 1613.66, "text": "怎生害得动神机妙算的卧龙先生啊?"}, {"start": 1613.66, "end": 1614.66, "text": "子敬不必挖苦。"}, {"start": 1614.66, "end": 1616.66, "text": "你害我不是今日,"}, {"start": 1616.66, "end": 1618.66, "text": "而是在三天前就把我害了。"}, {"start": 1618.66, "end": 1621.66, "text": "三天前我怎生害你了?"}, {"start": 1621.66, "end": 1622.66, "text": "三天前,"}, {"start": 1622.66, "end": 1624.66, "text": "恭井社反奸计杀了蔡茂,"}, {"start": 1624.66, "end": 1626.66, "text": "差你来探我的口风。"}, {"start": 1626.66, "end": 1628.66, "text": "我再三叮嘱你,"}, {"start": 1628.66, "end": 1629.66, "text": "千万不要告诉恭井,"}, {"start": 1629.66, "end": 1631.66, "text": "我看破了他的计谋。"}, {"start": 1631.66, "end": 1632.66, "text": "而你,"}, {"start": 1632.66, "end": 1633.66, "text": "肯定告诉周瑜,"}, {"start": 1633.66, "end": 1635.66, "text": "我看破了他的计谋。"}, {"start": 1635.66, "end": 1637.66, "text": "是也不是。"}, {"start": 1638.66, "end": 1642.61, "text": "恭井当面问我,"}, {"start": 1642.61, "end": 1646.18, "text": "我,"}, {"start": 1646.18, "end": 1649.18, "text": "你知道我这辈子是从无谎言的。"}, {"start": 1649.18, "end": 1650.18, "text": "我就,"}, {"start": 1650.18, "end": 1652.18, "text": "早知说了实情。"}, {"start": 1652.18, "end": 1653.18, "text": "你看看,"}, {"start": 1653.18, "end": 1655.18, "text": "祸有此生。"}, {"start": 1655.18, "end": 1658.18, "text": "恭井嫉妒我才是过人,"}, {"start": 1658.18, "end": 1660.18, "text": "担心日后成为东吴大害,"}, {"start": 1660.18, "end": 1661.18, "text": "今日,"}, {"start": 1661.18, "end": 1663.18, "text": "当着众将的面逼我造箭。"}, {"start": 1663.18, "end": 1665.18, "text": "我不接令吧,"}, {"start": 1665.18, "end": 1666.18, "text": "有失体面,"}, {"start": 1666.18, "end": 1668.18, "text": "日后无颜在此立足。"}, {"start": 1668.18, "end": 1670.18, "text": "可我如果接令吧,"}, {"start": 1670.18, "end": 1672.18, "text": "又会落入他的陷阱。"}, {"start": 1672.18, "end": 1674.18, "text": "子敬啊,"}, {"start": 1674.18, "end": 1676.18, "text": "你做的孽呀。"}, {"start": 1677.18, "end": 1680.18, "text": "你们二人斗法弄得是水火不容,"}, {"start": 1680.18, "end": 1682.18, "text": "把我鲁素夹在中间,"}, {"start": 1682.18, "end": 1684.18, "text": "我是好不难过呀。"}, {"start": 1684.18, "end": 1685.18, "text": "好好好,"}, {"start": 1685.18, "end": 1687.18, "text": "废话不说了,"}, {"start": 1687.18, "end": 1688.18, "text": "你做下事来,"}, {"start": 1688.18, "end": 1690.18, "text": "你也得救我一救。"}, {"start": 1690.18, "end": 1691.18, "text": "否则,"}, {"start": 1691.18, "end": 1692.18, "text": "我如果死了,"}, {"start": 1692.18, "end": 1694.18, "text": "孙柳联盟也就崩溃了,"}, {"start": 1694.18, "end": 1695.18, "text": "曹操必娶东吴,"}, {"start": 1695.18, "end": 1697.18, "text": "独成罢野。"}, {"start": 1697.18, "end": 1699.49, "text": "这一劫,"}, {"start": 1699.49, "end": 1701.49, "text": "我自然是明白的。"}, {"start": 1701.49, "end": 1702.49, "text": "但不知,"}, {"start": 1702.49, "end": 1705.49, "text": "我现在如何能救得动你呀?"}, {"start": 1705.49, "end": 1712.83, "text": "借我二十条快船,"}, {"start": 1712.83, "end": 1713.83, "text": "每船三十军士,"}, {"start": 1713.83, "end": 1715.83, "text": "船上以轻步为漫,"}, {"start": 1715.83, "end": 1717.83, "text": "各速草人千余个,"}, {"start": 1717.83, "end": 1718.83, "text": "立于船险两侧,"}, {"start": 1718.83, "end": 1720.83, "text": "我自有妙用。"}, {"start": 1723.83, "end": 1724.83, "text": "敢问,"}, {"start": 1724.83, "end": 1725.83, "text": "有何用处啊?"}, {"start": 1726.83, "end": 1727.83, "text": "子敬,"}, {"start": 1727.83, "end": 1729.83, "text": "恕我现在不能告诉你,"}, {"start": 1729.83, "end": 1732.83, "text": "免得你在公警面前又为难了。"}, {"start": 1732.83, "end": 1733.83, "text": "日后,"}, {"start": 1733.83, "end": 1735.83, "text": "我一定重重相信。"}, {"start": 1735.83, "end": 1737.83, "text": "不必言谢,"}, {"start": 1737.83, "end": 1738.83, "text": "也罢,"}, {"start": 1738.83, "end": 1739.83, "text": "快船与军士,"}, {"start": 1739.83, "end": 1741.83, "text": "我替你准备好了就是了。"}, {"start": 1741.83, "end": 1742.83, "text": "茶,"}, {"start": 1742.83, "end": 1744.83, "text": "也等你准备好了再喝。"}, {"start": 1745.83, "end": 1746.83, "text": "这么急,"}, {"start": 1746.83, "end": 1747.83, "text": "那就,"}, {"start": 1747.83, "end": 1749.83, "text": "公警不如从命了。"}, {"start": 1749.83, "end": 1750.83, "text": "好。"}, {"start": 1750.83, "end": 1756.6, "text": "子敬,"}, {"start": 1756.6, "end": 1757.6, "text": "借船之事,"}, {"start": 1757.6, "end": 1759.6, "text": "万万不能让周瑜知道,"}, {"start": 1759.6, "end": 1761.6, "text": "否则我必死无疑,"}, {"start": 1761.6, "end": 1762.6, "text": "而且,"}, {"start": 1762.6, "end": 1763.6, "text": "生生是被你害死。"}, {"start": 1763.6, "end": 1764.6, "text": "好了好了,"}, {"start": 1764.6, "end": 1766.6, "text": "放心放心,"}, {"start": 1766.6, "end": 1768.6, "text": "这回我是万万不敢再说了。"}, {"start": 1768.6, "end": 1769.6, "text": "那就好,"}, {"start": 1769.6, "end": 1771.6, "text": "第三天某时出客,"}, {"start": 1771.6, "end": 1772.6, "text": "你到我这儿来,"}, {"start": 1772.6, "end": 1774.6, "text": "我们俩一起去取剑。"}, {"start": 1775.6, "end": 1776.6, "text": "遵命。"}, {"start": 1777.6, "end": 1803.05, "text": "夫君,"}, {"start": 1803.05, "end": 1804.05, "text": "才三今天,"}, {"start": 1804.05, "end": 1806.05, "text": "你为何就起身了?"}, {"start": 1806.05, "end": 1810.57, "text": "不瞒你说,"}, {"start": 1810.57, "end": 1814.39, "text": "今天是第三天了,"}, {"start": 1815.39, "end": 1817.39, "text": "正是诸葛亮应该复命,"}, {"start": 1817.39, "end": 1819.39, "text": "交纳那十万支剑的日子。"}, {"start": 1819.39, "end": 1822.18, "text": "我苦思冥想,"}, {"start": 1822.18, "end": 1826.72, "text": "也想不出来他如何能打造出十万支剑。"}, {"start": 1827.72, "end": 1830.38, "text": "你管他做甚,"}, {"start": 1830.38, "end": 1831.38, "text": "他若交不出,"}, {"start": 1831.38, "end": 1833.38, "text": "自有军阀处置。"}, {"start": 1833.38, "end": 1837.05, "text": "莫非还斟斟了他,"}, {"start": 1837.05, "end": 1840.05, "text": "他即使交不出来我也未必杀他,"}, {"start": 1840.05, "end": 1844.54, "text": "我只想折辱他一下而已。"}, {"start": 1844.54, "end": 1847.24, "text": "既然如此,"}, {"start": 1847.24, "end": 1850.24, "text": "夫君为何这么苦恼啊?"}, {"start": 1850.24, "end": 1851.24, "text": "我是在想啊,"}, {"start": 1851.24, "end": 1856.27, "text": "小乔,"}, {"start": 1857.27, "end": 1860.27, "text": "诸葛亮既然硬撑下十万支剑,"}, {"start": 1860.27, "end": 1861.27, "text": "他必是有恃无恐,"}, {"start": 1861.27, "end": 1862.27, "text": "别有用心,"}, {"start": 1862.27, "end": 1865.27, "text": "但他究竟有何用心,"}, {"start": 1865.27, "end": 1868.27, "text": "又只被如何弄到那十万支剑。"}, {"start": 1869.27, "end": 1871.27, "text": "我却是怎么也想不出来,"}, {"start": 1871.27, "end": 1878.1, "text": "我身为江东大都督,"}, {"start": 1878.1, "end": 1880.1, "text": "统领江东半边天下,"}, {"start": 1880.1, "end": 1884.7, "text": "如果连诸葛亮的用心我的财不破坏,"}, {"start": 1884.7, "end": 1886.7, "text": "有何脸面统掌大军,"}, {"start": 1886.7, "end": 1891.07, "text": "真是枉为我咒语啊。"}, {"start": 1891.07, "end": 1914.98, "text": "空明啊,"}, {"start": 1914.98, "end": 1919.65, "text": "你这是要带我到哪里去啊?"}, {"start": 1920.65, "end": 1921.65, "text": "去取剑哪,"}, {"start": 1922.65, "end": 1923.65, "text": "子定兄,"}, {"start": 1924.65, "end": 1925.65, "text": "切吃杯茶。"}, {"start": 1948.82, "end": 1949.82, "text": "据曹丁水代,"}, {"start": 1949.82, "end": 1950.82, "text": "一步足一箭之遥啊。"}, {"start": 1950.82, "end": 1951.82, "text": "好,"}, {"start": 1951.82, "end": 1952.82, "text": "夏毛,"}, {"start": 1952.82, "end": 1954.82, "text": "将船一字排开,"}, {"start": 1954.82, "end": 1955.82, "text": "面向曹军大营,"}, {"start": 1955.82, "end": 1957.82, "text": "雷鼓挑战。"}, {"start": 1957.82, "end": 1958.82, "text": "诺。"}, {"start": 1958.82, "end": 1978.32, "text": "丞相,"}, {"start": 1979.32, "end": 1980.32, "text": "将命有敌船来袭。"}, {"start": 1980.32, "end": 1985.65, "text": "大务弥漫,"}, {"start": 1985.65, "end": 1987.65, "text": "武军误众来袭,"}, {"start": 1987.65, "end": 1988.65, "text": "是想把我船引出水寨,"}, {"start": 1988.65, "end": 1990.65, "text": "拒而坚持。"}, {"start": 1990.65, "end": 1992.65, "text": "船命不可营地,"}, {"start": 1992.65, "end": 1994.65, "text": "指令工弩手乱剑设置即可。"}, {"start": 1994.65, "end": 1995.65, "text": "遵命。"}, {"start": 1995.65, "end": 1996.65, "text": "里外,"}, {"start": 1996.65, "end": 2001.28, "text": "从孤军营里调三千工弩手,"}, {"start": 2001.28, "end": 2003.28, "text": "到岸边一起放箭。"}, {"start": 2003.28, "end": 2004.28, "text": "遵命。"}, {"start": 2005.28, "end": 2022.02, "text": "我说,"}, {"start": 2022.02, "end": 2024.02, "text": "离曹军的水寨太近了,"}, {"start": 2024.02, "end": 2025.02, "text": "曹军要冲出来,"}, {"start": 2025.02, "end": 2027.02, "text": "你如何应对啊?"}, {"start": 2029.02, "end": 2030.02, "text": "子敬放心,"}, {"start": 2030.02, "end": 2032.02, "text": "无敌可应。"}, {"start": 2032.02, "end": 2033.02, "text": "曹操的战船,"}, {"start": 2033.02, "end": 2035.02, "text": "根本就不会出来。"}, {"start": 2035.02, "end": 2078.98, "text": "真是剑飞如雨啊。"}, {"start": 2078.98, "end": 2083.93, "text": "草漫上的箭支已经密如蜂巢,"}, {"start": 2083.93, "end": 2084.93, "text": "扎不下了。"}, {"start": 2085.93, "end": 2086.93, "text": "将船调头,"}, {"start": 2086.93, "end": 2087.93, "text": "逼向曹军大寨,"}, {"start": 2087.93, "end": 2089.93, "text": "用船的另一面受箭。"}, {"start": 2089.93, "end": 2090.93, "text": "诺。"}, {"start": 2090.93, "end": 2118.33, "text": "领军师,"}, {"start": 2118.33, "end": 2119.33, "text": "每条船上收到五六千只箭,"}, {"start": 2119.33, "end": 2120.33, "text": "三十条船,"}, {"start": 2120.33, "end": 2122.33, "text": "不下于十二三万只。"}, {"start": 2122.33, "end": 2123.33, "text": "下去吧。"}, {"start": 2123.33, "end": 2126.09, "text": "诺。"}, {"start": 2126.09, "end": 2127.09, "text": "子敬,"}, {"start": 2127.09, "end": 2129.09, "text": "十万只箭交纳给公主,"}, {"start": 2129.09, "end": 2131.09, "text": "另外二三万只,"}, {"start": 2131.09, "end": 2133.09, "text": "算是我额外敬送。"}, {"start": 2134.09, "end": 2135.09, "text": "孔明啊,"}, {"start": 2135.09, "end": 2136.09, "text": "你是如何知道,"}, {"start": 2136.09, "end": 2138.09, "text": "今日会有误啊?"}, {"start": 2138.09, "end": 2140.09, "text": "为将者,"}, {"start": 2140.09, "end": 2141.09, "text": "如不通天文,"}, {"start": 2141.09, "end": 2142.09, "text": "不识地理,"}, {"start": 2142.09, "end": 2143.09, "text": "不知阴阳,"}, {"start": 2143.09, "end": 2144.09, "text": "不晓齐门,"}, {"start": 2144.09, "end": 2145.09, "text": "不观正途,"}, {"start": 2145.09, "end": 2146.09, "text": "不长兵士,"}, {"start": 2146.09, "end": 2147.09, "text": "阴彩。"}, {"start": 2147.09, "end": 2148.09, "text": "三天前,"}, {"start": 2148.09, "end": 2149.09, "text": "我就判定,"}, {"start": 2149.09, "end": 2150.09, "text": "今日会起大误,"}, {"start": 2150.09, "end": 2152.09, "text": "所以才敢接公警的军令。"}, {"start": 2153.09, "end": 2159.18, "text": "孔明啊,"}, {"start": 2160.18, "end": 2162.18, "text": "孔明真乃神人哪。"}, {"start": 2167.18, "end": 2168.18, "text": "拜,"}, {"start": 2168.18, "end": 2169.18, "text": "在下拜。"}, {"start": 2169.18, "end": 2170.18, "text": "不敢,"}, {"start": 2170.18, "end": 2172.18, "text": "真真切切是不敢当了。"}, {"start": 2181.18, "end": 2212.1, "text": "误众补生一想,"}, {"start": 2212.1, "end": 2213.1, "text": "我已猜破断想。"}, {"start": 2215.54, "end": 2216.54, "text": "孔明草船借箭,"}, {"start": 2216.54, "end": 2223.34, "text": "是也不是。"}, {"start": 2223.34, "end": 2224.34, "text": "正是。"}, {"start": 2224.34, "end": 2237.73, "text": "孔明神机妙算,"}, {"start": 2237.73, "end": 2238.73, "text": "我不如他。"}, {"start": 2238.73, "end": 2242.51, "text": "公主啊,"}, {"start": 2246.71, "end": 2249.71, "text": "也是你把他逼的这个份上,"}, {"start": 2249.71, "end": 2250.71, "text": "他才不得不,"}, {"start": 2250.71, "end": 2252.71, "text": "贸然行险啊。"}, {"start": 2253.71, "end": 2254.71, "text": "是想,"}, {"start": 2255.71, "end": 2257.71, "text": "假如今日无误,"}, {"start": 2258.71, "end": 2259.71, "text": "假如,"}, {"start": 2259.71, "end": 2261.71, "text": "曹兵大胆出击,"}, {"start": 2262.71, "end": 2264.71, "text": "他不是死无葬身之地吗?"}, {"start": 2264.71, "end": 2265.71, "text": "公主,"}, {"start": 2265.71, "end": 2269.92, "text": "在下希望你们二人,"}, {"start": 2270.92, "end": 2272.92, "text": "还是同心同德,"}, {"start": 2272.92, "end": 2273.92, "text": "共灭曹飞。"}, {"start": 2274.92, "end": 2276.92, "text": "不要再相争相斗了,"}, {"start": 2277.92, "end": 2278.92, "text": "好吗?"}, {"start": 2278.92, "end": 2279.92, "text": "我应当,"}, {"start": 2279.92, "end": 2287.94, "text": "亲自前去拜谢孔明。"}, {"start": 2287.94, "end": 2293.04, "text": "先生草船借箭,"}, {"start": 2293.04, "end": 2298.81, "text": "堪称千古神算,"}, {"start": 2298.81, "end": 2299.81, "text": "周于敬佩。"}, {"start": 2300.81, "end": 2302.81, "text": "雕虫小技,"}, {"start": 2302.81, "end": 2303.81, "text": "何劳大都督相谢,"}, {"start": 2303.81, "end": 2304.81, "text": "快请。"}, {"start": 2305.81, "end": 2306.81, "text": "军士,"}, {"start": 2306.81, "end": 2307.81, "text": "摆查。"}, {"start": 2307.81, "end": 2322.22, "text": "诺。"}, {"start": 2322.22, "end": 2323.22, "text": "这大战在即,"}, {"start": 2323.22, "end": 2337.57, "text": "此衣最为要紧的,"}, {"start": 2337.57, "end": 2339.57, "text": "仍是水战决胜负。"}, {"start": 2339.57, "end": 2340.57, "text": "是。"}, {"start": 2340.57, "end": 2342.57, "text": "我多次探看曹操水军,"}, {"start": 2344.88, "end": 2345.88, "text": "急势严整,"}, {"start": 2345.88, "end": 2346.88, "text": "绝不可轻视。"}, {"start": 2348.88, "end": 2350.88, "text": "这江东水师虽然精悍,"}, {"start": 2350.88, "end": 2352.88, "text": "数量却不及曹操战船的一半,"}, {"start": 2352.88, "end": 2354.88, "text": "大小也不如他。"}, {"start": 2354.88, "end": 2355.88, "text": "却如何以少胜多,"}, {"start": 2355.88, "end": 2357.88, "text": "以弱胜强,"}, {"start": 2357.88, "end": 2359.88, "text": "击破曹操水军战船。"}, {"start": 2360.88, "end": 2361.88, "text": "还望先生教我。"}, {"start": 2362.88, "end": 2364.88, "text": "大都督过目,"}, {"start": 2364.88, "end": 2366.88, "text": "在下陆路之辈,"}, {"start": 2366.88, "end": 2367.88, "text": "岂敢言教。"}, {"start": 2368.88, "end": 2370.88, "text": "昨夜我苦思良久,"}, {"start": 2370.88, "end": 2375.31, "text": "终于思得一破敌之计,"}, {"start": 2375.31, "end": 2377.31, "text": "却不知可行否。"}, {"start": 2378.31, "end": 2379.31, "text": "巧了,"}, {"start": 2379.31, "end": 2381.31, "text": "我今天早起也思得一计。"}, {"start": 2382.31, "end": 2385.31, "text": "我这计肯定比大都督之计"}, {"start": 2385.31, "end": 2386.31, "text": "晚了几个时辰。"}, {"start": 2386.31, "end": 2388.31, "text": "请问先生所思何计?"}, {"start": 2389.31, "end": 2392.42, "text": "敢问,"}, {"start": 2392.42, "end": 2393.42, "text": "都督所思何计?"}, {"start": 2394.42, "end": 2395.42, "text": "也罢。"}, {"start": 2396.42, "end": 2403.31, "text": "你我都不知"}, {"start": 2404.31, "end": 2405.31, "text": "你我都不必说,"}, {"start": 2405.31, "end": 2406.31, "text": "且写在掌中,"}, {"start": 2406.31, "end": 2407.31, "text": "看同是不同。"}, {"start": 2408.31, "end": 2409.31, "text": "好,"}, {"start": 2409.31, "end": 2410.31, "text": "左右,"}, {"start": 2410.31, "end": 2411.31, "text": "取笔墨来。"}, {"start": 2411.31, "end": 2412.31, "text": "诺。"}, {"start": 2438.41, "end": 2440.41, "text": "真是英雄所见略同啊。"}, {"start": 2442.41, "end": 2446.8, "text": "大都督,"}, {"start": 2447.8, "end": 2449.8, "text": "蔡茂之弟蔡和蔡忠,"}, {"start": 2449.8, "end": 2450.8, "text": "前来投降。"}, {"start": 2451.8, "end": 2452.8, "text": "好,"}, {"start": 2452.8, "end": 2453.8, "text": "我且去瞧瞧,"}, {"start": 2453.8, "end": 2462.35, "text": "这破敌之计,"}, {"start": 2462.35, "end": 2464.35, "text": "请葬物谢了。"}, {"start": 2465.35, "end": 2466.35, "text": "告辞。"}, {"start": 2466.35, "end": 2467.35, "text": "遵命。"}, {"start": 2467.35, "end": 2468.35, "text": "大都督慢走。"}]