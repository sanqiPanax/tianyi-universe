[{"start": 20.69, "end": 25.21, "text": "洪城将军吴庆率部军三万五千前来听命"}, {"start": 27.69, "end": 30.57, "text": "卫军将军苏丽武率马军两万报到"}, {"start": 31.01, "end": 31.81, "text": "好 好"}, {"start": 31.81, "end": 33.77, "text": "完成太守申仪"}, {"start": 33.77, "end": 37.09, "text": "预送仲达兄大功一键"}, {"start": 37.61, "end": 41.01, "text": "不知足下纳否"}, {"start": 43.69, "end": 44.69, "text": "兄台"}, {"start": 45.21, "end": 46.17, "text": "何时到的"}, {"start": 50.33, "end": 50.97, "text": "都退下"}, {"start": 52.41, "end": 53.05, "text": "诺"}, {"start": 53.37, "end": 75.0, "text": "崇拜启用"}, {"start": 75.52, "end": 77.6, "text": "可喜可贺呀"}, {"start": 78.76, "end": 79.48, "text": "敢问"}, {"start": 79.84, "end": 80.88, "text": "功成之后"}, {"start": 81.6, "end": 84.44, "text": "你就不怕再度被贬吗"}, {"start": 89.98, "end": 91.02, "text": "岂能不怕"}, {"start": 92.34, "end": 94.58, "text": "那您为何还要煮膳呢"}, {"start": 96.22, "end": 101.56, "text": "贪哪"}, {"start": 101.76, "end": 102.8, "text": "兄台知道"}, {"start": 103.8, "end": 105.68, "text": "我司马以贪功名"}, {"start": 105.68, "end": 106.72, "text": "贪大业"}, {"start": 107.12, "end": 108.8, "text": "整日心痒难熬"}, {"start": 109.28, "end": 112.28, "text": "梦中都想和诸葛亮斗一高下"}, {"start": 114.16, "end": 119.35, "text": "卫国生死存亡尽掌于你手"}, {"start": 119.75, "end": 121.47, "text": "此时此刻"}, {"start": 121.47, "end": 124.27, "text": "你有两个选择"}, {"start": 124.27, "end": 125.31, "text": "本位吉祥"}, {"start": 130.29, "end": 135.24, "text": "一者你可拥兵自守"}, {"start": 135.96, "end": 138.6, "text": "坐视天子曹芮背秦"}, {"start": 139.64, "end": 142.6, "text": "听其卫国灭亡"}, {"start": 142.6, "end": 143.56, "text": "而你呢"}, {"start": 143.8, "end": 146.0, "text": "日后可军王位"}, {"start": 146.32, "end": 148.44, "text": "会事绝逐天下"}, {"start": 148.44, "end": 149.52, "text": "逐天下"}, {"start": 150.4, "end": 152.92, "text": "屠城霸业"}, {"start": 152.92, "end": 153.52, "text": "且慢"}, {"start": 154.48, "end": 155.2, "text": "你说什么"}, {"start": 156.0, "end": 157.2, "text": "天子背秦"}, {"start": 161.22, "end": 163.02, "text": "兄台快说其二"}, {"start": 164.71, "end": 167.55, "text": "其二便是旧天子"}, {"start": 167.99, "end": 168.91, "text": "护朝廷"}, {"start": 168.91, "end": 170.03, "text": "占蜀军"}, {"start": 170.03, "end": 171.23, "text": "晋忠勇"}, {"start": 171.23, "end": 176.81, "text": "功成之后嘛"}, {"start": 176.81, "end": 182.89, "text": "你再遭到曹真等亲贵的诋毁"}, {"start": 182.89, "end": 184.33, "text": "陷害"}, {"start": 190.21, "end": 191.21, "text": "我选其二"}, {"start": 194.9, "end": 196.82, "text": "兄台要送我何等大功"}, {"start": 197.34, "end": 197.94, "text": "请讲"}, {"start": 203.83, "end": 204.71, "text": "孟达"}, {"start": 204.71, "end": 207.75, "text": "五日之后"}, {"start": 207.75, "end": 210.67, "text": "他竟要起新城十二万大军"}, {"start": 211.19, "end": 212.63, "text": "进取洛阳"}, {"start": 212.63, "end": 215.11, "text": "生秦天子献给诸葛亮"}, {"start": 215.91, "end": 218.75, "text": "新城之洛阳路途不远"}, {"start": 219.91, "end": 224.79, "text": "孟达可轻易得手啊"}, {"start": 224.79, "end": 237.46, "text": "兄台是如何得知此事的"}, {"start": 237.9, "end": 239.82, "text": "孟达谋士李楠"}, {"start": 239.82, "end": 241.02, "text": "是我的旧友"}, {"start": 241.86, "end": 242.74, "text": "他抄写了"}, {"start": 242.74, "end": 245.02, "text": "孟达写给诸葛亮的密信"}, {"start": 245.98, "end": 247.66, "text": "交给了我"}, {"start": 247.66, "end": 283.53, "text": "亮曲长安如飞足下报信"}, {"start": 284.49, "end": 287.29, "text": "曹魏真是要亡国灭种了"}, {"start": 288.13, "end": 288.93, "text": "中达"}, {"start": 289.49, "end": 291.13, "text": "赶紧发兵洛阳"}, {"start": 291.13, "end": 293.65, "text": "前去救驾呀"}, {"start": 293.65, "end": 297.2, "text": "赶去来不及了"}, {"start": 297.2, "end": 298.32, "text": "那你怎么办"}, {"start": 299.12, "end": 300.32, "text": "只有一个办法"}, {"start": 301.16, "end": 302.52, "text": "不向朝廷示警"}, {"start": 303.48, "end": 304.8, "text": "免得惊动孟达"}, {"start": 305.96, "end": 307.88, "text": "我秦帅一支铁锦"}, {"start": 307.88, "end": 309.08, "text": "行夜禁军"}, {"start": 309.08, "end": 310.56, "text": "直扑新城"}, {"start": 310.56, "end": 312.2, "text": "请那叛将孟达"}, {"start": 314.32, "end": 315.32, "text": "中达呀"}, {"start": 315.32, "end": 318.04, "text": "你这是要以天子为儿"}, {"start": 318.04, "end": 320.52, "text": "秦贼建功啊"}, {"start": 343.64, "end": 347.05, "text": "离新城还有多远"}, {"start": 347.05, "end": 347.81, "text": "你看"}, {"start": 348.81, "end": 349.77, "text": "好"}, {"start": 349.77, "end": 351.81, "text": "看来孟达并无防备"}, {"start": 351.81, "end": 353.37, "text": "我们来得正是时候"}, {"start": 353.93, "end": 354.97, "text": "父亲"}, {"start": 355.73, "end": 356.53, "text": "父亲"}, {"start": 356.53, "end": 358.37, "text": "前军转换孟达新使"}, {"start": 358.37, "end": 372.9, "text": "押过来"}, {"start": 372.9, "end": 373.98, "text": "认得我吗"}, {"start": 373.98, "end": 376.71, "text": "不认得"}, {"start": 377.67, "end": 380.43, "text": "我是镖记大将军司马一"}, {"start": 380.43, "end": 381.11, "text": "天哪"}, {"start": 381.11, "end": 382.03, "text": "你"}, {"start": 382.03, "end": 384.23, "text": "你不是在五百里外的晚城吗"}, {"start": 384.23, "end": 388.27, "text": "我自从天降也"}, {"start": 388.27, "end": 390.9, "text": "听着"}, {"start": 390.9, "end": 392.66, "text": "只要你肯说实话"}, {"start": 392.66, "end": 394.18, "text": "我非但不杀你"}, {"start": 394.18, "end": 396.26, "text": "反而会保你功名富贵"}, {"start": 396.26, "end": 397.34, "text": "是"}, {"start": 397.34, "end": 398.1, "text": "诸葛亮"}, {"start": 398.1, "end": 399.1, "text": "派下官"}, {"start": 399.1, "end": 401.7, "text": "去给孟大将军送一封信"}, {"start": 401.74, "end": 402.82, "text": "不了"}, {"start": 402.82, "end": 404.54, "text": "中農归部军中"}, {"start": 404.54, "end": 406.1, "text": "书心何在"}, {"start": 406.1, "end": 410.78, "text": "信"}, {"start": 410.78, "end": 411.78, "text": "大都督"}, {"start": 412.66, "end": 419.46, "text": "将军"}, {"start": 419.46, "end": 421.46, "text": "孟达将军如勿"}, {"start": 421.46, "end": 422.5, "text": "禁报"}, {"start": 422.5, "end": 425.3, "text": "魏廷已再度启用司马一"}, {"start": 425.3, "end": 426.98, "text": "此人奸诈多智"}, {"start": 426.98, "end": 428.5, "text": "用兵起轨"}, {"start": 428.5, "end": 430.06, "text": "如果走漏消息"}, {"start": 430.06, "end": 432.7, "text": "他必引大军星夜争剿"}, {"start": 432.7, "end": 434.7, "text": "请将军提前举兵"}, {"start": 434.7, "end": 436.14, "text": "脱离新城"}, {"start": 436.14, "end": 437.5, "text": "与我会事后"}, {"start": 437.5, "end": 439.5, "text": "共取洛阳"}, {"start": 439.5, "end": 441.34, "text": "看来这个诸葛亮"}, {"start": 441.34, "end": 442.66, "text": "早有预见呢"}, {"start": 442.66, "end": 447.54, "text": "本来半个时辰"}, {"start": 447.54, "end": 451.15, "text": "万事皆休啊"}, {"start": 451.15, "end": 452.27, "text": "押下去"}, {"start": 452.27, "end": 453.39, "text": "待我查试"}, {"start": 453.39, "end": 462.49, "text": "诺"}, {"start": 462.49, "end": 464.85, "text": "亲贼先秦王"}, {"start": 464.85, "end": 466.09, "text": "我易"}, {"start": 466.09, "end": 468.77, "text": "派以胆大心细之人为使"}, {"start": 468.77, "end": 471.45, "text": "进城拜见孟大"}, {"start": 471.45, "end": 473.89, "text": "就说司马一奉命前往洛阳"}, {"start": 473.89, "end": 475.29, "text": "觐见天子"}, {"start": 475.29, "end": 477.29, "text": "路经此地"}, {"start": 477.29, "end": 479.33, "text": "随行只有二子"}, {"start": 479.33, "end": 480.85, "text": "协护卫侍从"}, {"start": 480.85, "end": 482.77, "text": "恕人"}, {"start": 482.77, "end": 484.61, "text": "有达出城相见"}, {"start": 484.61, "end": 488.02, "text": "在下愿望"}, {"start": 488.02, "end": 546.31, "text": "平息大都"}, {"start": 546.31, "end": 548.19, "text": "臣司马一拜见陛下"}, {"start": 548.19, "end": 549.43, "text": "仲达呀"}, {"start": 549.43, "end": 551.03, "text": "爱卿"}, {"start": 551.03, "end": 552.39, "text": "快快起身"}, {"start": 552.39, "end": 553.11, "text": "朕怕你"}, {"start": 553.11, "end": 562.23, "text": "如大汉望甘林哪"}, {"start": 562.23, "end": 563.99, "text": "那是何物"}, {"start": 563.99, "end": 568.25, "text": "叛将孟达扫击"}, {"start": 568.25, "end": 577.36, "text": "出什么事了"}, {"start": 577.36, "end": 578.56, "text": "孟达"}, {"start": 578.56, "end": 580.6, "text": "与诸葛亮暗通"}, {"start": 580.6, "end": 582.32, "text": "准备举新城兵十二万"}, {"start": 582.32, "end": 583.96, "text": "共取洛阳"}, {"start": 583.96, "end": 585.16, "text": "声请陛下"}, {"start": 585.16, "end": 588.47, "text": "臣得知身疑密报后"}, {"start": 588.47, "end": 590.79, "text": "星夜兼程赶往新城"}, {"start": 590.79, "end": 596.24, "text": "请拿叛将孟达"}, {"start": 596.24, "end": 598.64, "text": "陛下请看"}, {"start": 598.64, "end": 608.27, "text": "这是诸葛亮与孟达的来往书信"}, {"start": 608.27, "end": 610.63, "text": "如非爱卿相救"}, {"start": 610.63, "end": 613.63, "text": "朕恐早丧于他命了"}, {"start": 613.63, "end": 615.31, "text": "爱卿"}, {"start": 615.31, "end": 616.39, "text": "你刚刚上任"}, {"start": 616.39, "end": 618.23, "text": "便见此其功"}, {"start": 618.23, "end": 622.43, "text": "你是天朝的功臣哪"}, {"start": 622.43, "end": 624.75, "text": "恭喜陛下 贺喜陛下"}, {"start": 624.75, "end": 625.95, "text": "有众达在"}, {"start": 625.99, "end": 628.91, "text": "诸葛亮他这必败无疑呀"}, {"start": 628.91, "end": 631.31, "text": "众达不但用兵如神"}, {"start": 631.31, "end": 634.39, "text": "其耿耿忠心可照日月"}, {"start": 634.39, "end": 636.35, "text": "名垂青史"}, {"start": 636.35, "end": 639.15, "text": "草修佩服吴帝呀"}, {"start": 639.15, "end": 640.75, "text": "大三马过奖了"}, {"start": 642.51, "end": 645.55, "text": "请拿叛将孟达"}, {"start": 645.55, "end": 659.69, "text": "接晚成太守身疑之功"}, {"start": 659.69, "end": 663.42, "text": "听旨"}, {"start": 663.42, "end": 667.02, "text": "授身疑为济州刺史"}, {"start": 667.02, "end": 669.94, "text": "赐晚成侯"}, {"start": 669.94, "end": 672.54, "text": "臣领旨谢恩"}, {"start": 672.54, "end": 677.34, "text": "见"}, {"start": 677.34, "end": 678.78, "text": "爱卿"}, {"start": 678.78, "end": 680.78, "text": "朕将两经全部兵马"}, {"start": 680.78, "end": 682.3, "text": "交付于你"}, {"start": 682.3, "end": 684.42, "text": "朕令你带领全部军马"}, {"start": 684.42, "end": 686.18, "text": "出战诸葛亮"}, {"start": 686.18, "end": 688.74, "text": "日后如果有任何机密"}, {"start": 688.74, "end": 690.74, "text": "你不必上报于朕"}, {"start": 690.74, "end": 692.22, "text": "你可当机立断"}, {"start": 692.22, "end": 693.5, "text": "先斩后奏"}, {"start": 693.5, "end": 733.92, "text": "吴军犯境以来"}, {"start": 733.92, "end": 737.88, "text": "夏侯驸马初败"}, {"start": 737.88, "end": 740.4, "text": "大司马曹修再败"}, {"start": 740.4, "end": 742.84, "text": "大将军曹真三败"}, {"start": 742.84, "end": 745.04, "text": "此三番败阵下来"}, {"start": 745.04, "end": 752.3, "text": "朝廷已损失了几十万兵马"}, {"start": 752.3, "end": 755.7, "text": "丢失城池十七八座"}, {"start": 755.7, "end": 758.5, "text": "更要紧的是"}, {"start": 758.5, "end": 761.62, "text": "京城人心动摇"}, {"start": 761.62, "end": 766.54, "text": "百官未敌"}, {"start": 766.54, "end": 770.74, "text": "朝廷已有前都之意了"}, {"start": 770.74, "end": 775.14, "text": "不过我可以证告各位"}, {"start": 775.14, "end": 778.14, "text": "魏军之败到此为止"}, {"start": 778.14, "end": 781.5, "text": "蜀军之败"}, {"start": 781.5, "end": 782.78, "text": "由此开始"}, {"start": 782.78, "end": 784.82, "text": "如果大都督早些挂帅"}, {"start": 784.82, "end": 786.54, "text": "朱葛亮何以猖狂"}, {"start": 786.54, "end": 788.58, "text": "我军定能胜他"}, {"start": 788.58, "end": 792.22, "text": "将军此言差矣"}, {"start": 792.22, "end": 795.86, "text": "如果没有曹修等三人的战败"}, {"start": 795.86, "end": 798.94, "text": "我们就不会有今后的胜利"}, {"start": 798.94, "end": 800.38, "text": "曹修等人的战败"}, {"start": 800.38, "end": 802.02, "text": "消耗了朱葛亮"}, {"start": 802.02, "end": 804.94, "text": "大量的前梁军马"}, {"start": 804.94, "end": 807.58, "text": "特别是时间"}, {"start": 807.58, "end": 810.06, "text": "他们深入我魏境"}, {"start": 810.06, "end": 811.78, "text": "五岳有余"}, {"start": 811.78, "end": 813.86, "text": "兵风已挫"}, {"start": 813.86, "end": 816.78, "text": "已成强弩之末"}, {"start": 816.78, "end": 818.42, "text": "朱葛亮的粮草"}, {"start": 818.42, "end": 819.78, "text": "军械的供给"}, {"start": 819.78, "end": 821.78, "text": "已经供应不足"}, {"start": 821.78, "end": 825.18, "text": "而他们入我魏境作战"}, {"start": 825.18, "end": 828.46, "text": "每一粮一箭"}, {"start": 828.46, "end": 832.1, "text": "都要从汉中运出"}, {"start": 832.1, "end": 833.18, "text": "这样"}, {"start": 833.18, "end": 837.66, "text": "我们就占尽了天时和地利"}, {"start": 837.66, "end": 839.34, "text": "这就是我们"}, {"start": 839.34, "end": 842.98, "text": "决定胜利的先计"}, {"start": 843.02, "end": 853.54, "text": "就出一道骑兵"}, {"start": 853.54, "end": 854.7, "text": "入资无辜"}, {"start": 854.7, "end": 855.86, "text": "穿秦岭"}, {"start": 855.86, "end": 859.99, "text": "进去长安"}, {"start": 859.99, "end": 863.23, "text": "这朱葛亮要这样供兵的话"}, {"start": 863.23, "end": 866.03, "text": "中原一半就是他的了"}, {"start": 866.03, "end": 868.47, "text": "可惜啊"}, {"start": 868.47, "end": 871.87, "text": "朱葛亮平生谨慎"}, {"start": 871.87, "end": 874.27, "text": "所以啊"}, {"start": 874.27, "end": 876.95, "text": "他只有稳扎稳打"}, {"start": 876.95, "end": 879.11, "text": "步步为营"}, {"start": 879.11, "end": 880.87, "text": "不求速胜"}, {"start": 880.87, "end": 882.79, "text": "只求百战不怠而"}, {"start": 882.79, "end": 884.15, "text": "大都督"}, {"start": 884.15, "end": 885.79, "text": "我们该如何用兵啊"}, {"start": 885.79, "end": 898.62, "text": "军侧移"}, {"start": 898.62, "end": 905.78, "text": "一个地名叫"}, {"start": 905.78, "end": 908.4, "text": "街庭"}, {"start": 908.4, "end": 910.72, "text": "它恶守汉中咽喉"}, {"start": 910.72, "end": 913.64, "text": "是蜀军的良道所在"}, {"start": 913.64, "end": 916.36, "text": "只要我们能够抢占街庭"}, {"start": 916.36, "end": 919.24, "text": "就遏制住了蜀军的良道"}, {"start": 919.24, "end": 921.8, "text": "时日内"}, {"start": 921.8, "end": 923.72, "text": "蜀军必会撤兵"}, {"start": 923.72, "end": 928.89, "text": "如果朱葛亮还不撤兵"}, {"start": 928.89, "end": 931.05, "text": "那我军就分布在"}, {"start": 931.05, "end": 932.65, "text": "各处险要口"}, {"start": 932.65, "end": 935.38, "text": "坚守不战"}, {"start": 935.42, "end": 938.52, "text": "在五个月之内"}, {"start": 938.52, "end": 940.92, "text": "笼袭的几十万蜀兵"}, {"start": 940.92, "end": 942.52, "text": "就会饿死"}, {"start": 944.88, "end": 946.84, "text": "贤弟"}, {"start": 946.84, "end": 949.56, "text": "若是早用重达的话"}, {"start": 949.56, "end": 952.68, "text": "天下早就大定了"}, {"start": 952.68, "end": 954.04, "text": "大都督"}, {"start": 954.04, "end": 956.12, "text": "我愿率领两万军马"}, {"start": 956.12, "end": 958.24, "text": "袭取街庭"}, {"start": 958.24, "end": 960.88, "text": "此意非将军不可"}, {"start": 960.88, "end": 963.52, "text": "请将军率两万士兵"}, {"start": 963.52, "end": 965.0, "text": "前往"}, {"start": 965.04, "end": 966.64, "text": "自引大军随后"}, {"start": 968.0, "end": 968.88, "text": "遵命"}, {"start": 968.88, "end": 971.74, "text": "报"}, {"start": 971.74, "end": 972.46, "text": "禀长相"}, {"start": 972.46, "end": 973.74, "text": "曹睿重新启用司马一"}, {"start": 973.74, "end": 974.82, "text": "拜为西征大都督"}, {"start": 974.82, "end": 975.86, "text": "中原各部卫军"}, {"start": 975.86, "end": 976.98, "text": "全由司马一掌握"}, {"start": 976.98, "end": 978.96, "text": "报"}, {"start": 978.96, "end": 979.64, "text": "丞相"}, {"start": 979.64, "end": 980.28, "text": "不好了"}, {"start": 980.28, "end": 981.6, "text": "尚庸拜兵来报"}, {"start": 981.6, "end": 982.76, "text": "司马一已经知道了"}, {"start": 982.76, "end": 984.04, "text": "梦达叛乱的事情"}, {"start": 984.04, "end": 985.36, "text": "现已将其斩首"}, {"start": 985.36, "end": 986.6, "text": "梦达所有的部下"}, {"start": 986.6, "end": 988.28, "text": "已经归降司马一了"}, {"start": 988.28, "end": 989.2, "text": "禀长相"}, {"start": 989.2, "end": 990.36, "text": "司马一拜张合合"}, {"start": 990.36, "end": 991.8, "text": "举凰为左右大将军"}, {"start": 991.8, "end": 993.44, "text": "及各路大军四十八万"}, {"start": 993.44, "end": 1009.9, "text": "现已挥师袭击"}, {"start": 1009.9, "end": 1012.38, "text": "梦达起势不灭"}, {"start": 1012.38, "end": 1013.94, "text": "反应迟钝"}, {"start": 1014.58, "end": 1018.63, "text": "才招致此祸"}, {"start": 1018.63, "end": 1020.63, "text": "司马一奸诈多智"}, {"start": 1020.63, "end": 1022.03, "text": "极善勇逼"}, {"start": 1022.79, "end": 1027.77, "text": "他才是我的大敌"}, {"start": 1027.77, "end": 1030.84, "text": "我为判断一下"}, {"start": 1030.84, "end": 1032.96, "text": "司马一进军之后"}, {"start": 1033.68, "end": 1048.74, "text": "会攻去哪里呀"}, {"start": 1048.74, "end": 1050.58, "text": "定会攻去街亭"}, {"start": 1050.58, "end": 1055.94, "text": "断我燕侯要斗"}, {"start": 1055.94, "end": 1056.7, "text": "种家"}, {"start": 1057.86, "end": 1059.98, "text": "你们谁能迎军"}, {"start": 1059.98, "end": 1061.54, "text": "拒守街亭啊"}, {"start": 1062.58, "end": 1063.22, "text": "丞相"}, {"start": 1063.9, "end": 1070.99, "text": "在下愿守街亭"}, {"start": 1071.03, "end": 1072.15, "text": "有常"}, {"start": 1073.95, "end": 1075.31, "text": "街亭虽小"}, {"start": 1075.95, "end": 1077.63, "text": "却干系极大"}, {"start": 1077.63, "end": 1078.79, "text": "一旦失手"}, {"start": 1078.79, "end": 1080.99, "text": "我军大势皆去了"}, {"start": 1080.99, "end": 1082.75, "text": "马夙愿立军令状"}, {"start": 1083.27, "end": 1085.15, "text": "如果街亭失手"}, {"start": 1085.15, "end": 1086.55, "text": "请斩我头"}, {"start": 1086.55, "end": 1093.59, "text": "你知道吗"}, {"start": 1094.39, "end": 1096.43, "text": "街亭没有城池"}, {"start": 1096.43, "end": 1098.15, "text": "那里易攻难守"}, {"start": 1099.35, "end": 1101.15, "text": "我自幼饱读兵书"}, {"start": 1101.15, "end": 1102.31, "text": "颇通兵法"}, {"start": 1103.31, "end": 1104.47, "text": "右盟"}, {"start": 1104.47, "end": 1106.27, "text": "献上教诲多年"}, {"start": 1106.87, "end": 1109.59, "text": "岂能守不住一个小小的街亭"}, {"start": 1109.59, "end": 1112.43, "text": "司马一职才不下于曹操"}, {"start": 1112.43, "end": 1114.63, "text": "张合又是天下名将"}, {"start": 1114.63, "end": 1115.11, "text": "你"}, {"start": 1115.99, "end": 1118.27, "text": "你恐怕不是他的对手"}, {"start": 1119.51, "end": 1122.07, "text": "修道司马一张合"}, {"start": 1122.07, "end": 1123.79, "text": "就是曹操从坟墓里爬出来"}, {"start": 1123.79, "end": 1125.15, "text": "我也不惧"}, {"start": 1125.15, "end": 1126.07, "text": "丞相"}, {"start": 1126.07, "end": 1138.74, "text": "请收命吧"}, {"start": 1138.74, "end": 1140.3, "text": "我马氏祖贤"}, {"start": 1140.3, "end": 1141.7, "text": "皆汉是忠臣"}, {"start": 1142.54, "end": 1144.22, "text": "术法入沙场"}, {"start": 1144.22, "end": 1145.74, "text": "马歌果施缓"}, {"start": 1145.74, "end": 1147.3, "text": "壮烈千秋"}, {"start": 1148.06, "end": 1149.02, "text": "禀丞相"}, {"start": 1150.02, "end": 1152.5, "text": "在下早就想领兵征战了"}, {"start": 1153.42, "end": 1154.98, "text": "请丞相赐给我一个"}, {"start": 1154.98, "end": 1159.06, "text": "告慰先祖的机会"}, {"start": 1159.06, "end": 1160.14, "text": "丞相"}, {"start": 1160.14, "end": 1161.58, "text": "我看马素"}, {"start": 1161.58, "end": 1163.86, "text": "报国之心急壮"}, {"start": 1163.86, "end": 1164.9, "text": "丞相"}, {"start": 1164.9, "end": 1180.62, "text": "你就允了他吧"}, {"start": 1180.62, "end": 1182.9, "text": "我给你两万五千精兵"}, {"start": 1182.9, "end": 1184.58, "text": "再加上将一员"}, {"start": 1184.58, "end": 1188.53, "text": "助你前去"}, {"start": 1188.53, "end": 1191.77, "text": "谢丞相"}, {"start": 1191.77, "end": 1193.09, "text": "王平"}, {"start": 1193.09, "end": 1194.09, "text": "在"}, {"start": 1194.09, "end": 1196.65, "text": "我命你为副将"}, {"start": 1196.65, "end": 1197.97, "text": "助马素"}, {"start": 1197.97, "end": 1199.73, "text": "镇守街庭"}, {"start": 1199.73, "end": 1201.53, "text": "末将领命"}, {"start": 1201.53, "end": 1202.61, "text": "王平"}, {"start": 1203.85, "end": 1205.73, "text": "马素多智"}, {"start": 1205.73, "end": 1207.69, "text": "你生平谨慎"}, {"start": 1207.69, "end": 1209.49, "text": "你二人相互辅佐"}, {"start": 1209.49, "end": 1211.29, "text": "定能建功"}, {"start": 1211.29, "end": 1212.41, "text": "记住"}, {"start": 1212.41, "end": 1213.89, "text": "到街庭之后"}, {"start": 1213.89, "end": 1215.17, "text": "当在五鹿总口"}, {"start": 1215.17, "end": 1216.37, "text": "当道下斋"}, {"start": 1216.37, "end": 1218.97, "text": "令卫君急切不能偷过"}, {"start": 1218.97, "end": 1220.09, "text": "扎营之后"}, {"start": 1220.09, "end": 1222.09, "text": "立即画四之八道刑事图"}, {"start": 1222.09, "end": 1223.89, "text": "送与我看"}, {"start": 1223.89, "end": 1225.25, "text": "你二人"}, {"start": 1225.29, "end": 1228.21, "text": "如果能保街庭一月无余"}, {"start": 1228.21, "end": 1233.07, "text": "便是取长安的第一贡"}, {"start": 1233.07, "end": 1234.07, "text": "遵命"}, {"start": 1235.07, "end": 1249.09, "text": "请"}, {"start": 1249.09, "end": 1249.97, "text": "高祥"}, {"start": 1249.97, "end": 1251.09, "text": "在"}, {"start": 1251.09, "end": 1253.45, "text": "街庭东北有一座城池"}, {"start": 1253.45, "end": 1255.73, "text": "名叫裂柳城"}, {"start": 1255.73, "end": 1258.65, "text": "你引军一万前去驻扎"}, {"start": 1258.65, "end": 1260.93, "text": "如果街庭有任何危急"}, {"start": 1260.93, "end": 1262.57, "text": "你可引兵相救"}, {"start": 1262.57, "end": 1271.56, "text": "诺"}, {"start": 1271.56, "end": 1273.04, "text": "在"}, {"start": 1273.04, "end": 1274.4, "text": "你领本部兵马"}, {"start": 1274.4, "end": 1276.48, "text": "前去街庭之后驻扎"}, {"start": 1276.48, "end": 1277.76, "text": "如街庭有难"}, {"start": 1277.76, "end": 1279.64, "text": "你即可接应"}, {"start": 1279.64, "end": 1281.36, "text": "丞相"}, {"start": 1281.36, "end": 1283.32, "text": "我是先锋将军"}, {"start": 1283.32, "end": 1286.0, "text": "为何不让我率军攻去长安"}, {"start": 1286.0, "end": 1289.52, "text": "却让我干些接应的闲差呀"}, {"start": 1289.52, "end": 1292.6, "text": "你知道街庭之后是什么地方吗"}, {"start": 1292.6, "end": 1294.28, "text": "杨平关"}, {"start": 1294.28, "end": 1297.0, "text": "街庭恶我军咽喉"}, {"start": 1297.0, "end": 1300.0, "text": "杨平关恶汗中咽喉"}, {"start": 1300.0, "end": 1302.76, "text": "那里是北伐胜败的关键所在"}, {"start": 1302.76, "end": 1304.48, "text": "你岂能小试啊"}, {"start": 1304.48, "end": 1309.06, "text": "能保杨平关一月"}, {"start": 1309.06, "end": 1312.02, "text": "此功便在马素之上"}, {"start": 1312.02, "end": 1315.38, "text": "日后我定让你引领大军"}, {"start": 1315.38, "end": 1318.18, "text": "攻去长安"}, {"start": 1318.18, "end": 1318.94, "text": "遵命"}, {"start": 1318.94, "end": 1326.55, "text": "子隆啊"}, {"start": 1326.55, "end": 1326.99, "text": "在"}, {"start": 1326.99, "end": 1330.43, "text": "我还是有些不放心了"}, {"start": 1330.43, "end": 1332.23, "text": "丞相"}, {"start": 1332.23, "end": 1336.95, "text": "你今日为何如此多虑呀"}, {"start": 1336.95, "end": 1340.31, "text": "我也跟你征战二十几年了"}, {"start": 1340.31, "end": 1342.83, "text": "从来没见过你像今天这样"}, {"start": 1342.87, "end": 1346.51, "text": "我从未与司马仪交战过"}, {"start": 1346.51, "end": 1348.55, "text": "可是长久以来"}, {"start": 1348.55, "end": 1350.15, "text": "他藏于暗处"}, {"start": 1350.15, "end": 1352.43, "text": "我高居明处"}, {"start": 1352.43, "end": 1353.95, "text": "他对我"}, {"start": 1353.95, "end": 1356.23, "text": "可谓是了如指掌"}, {"start": 1356.23, "end": 1361.58, "text": "而我对他却是一知半解"}, {"start": 1361.58, "end": 1362.94, "text": "子隆啊"}, {"start": 1362.94, "end": 1364.78, "text": "你和邓骘各应义军"}, {"start": 1364.78, "end": 1366.7, "text": "出旗鼓做义兵"}, {"start": 1366.7, "end": 1368.58, "text": "如与司马仪大军"}, {"start": 1368.58, "end": 1369.86, "text": "战或不战"}, {"start": 1369.86, "end": 1371.42, "text": "皆由你定"}, {"start": 1371.42, "end": 1373.02, "text": "你只要让司马仪"}, {"start": 1373.02, "end": 1376.83, "text": "胆战心惊就行了"}, {"start": 1376.83, "end": 1377.59, "text": "领命"}, {"start": 1398.87, "end": 1399.79, "text": "小军"}, {"start": 1399.79, "end": 1400.59, "text": "你看"}, {"start": 1400.59, "end": 1406.21, "text": "前面就是街亭了"}, {"start": 1406.21, "end": 1408.33, "text": "丞相过于谨慎了"}, {"start": 1408.33, "end": 1409.97, "text": "一小小关爱"}, {"start": 1409.97, "end": 1411.49, "text": "区区街亭"}, {"start": 1411.49, "end": 1412.69, "text": "守他一月"}, {"start": 1412.69, "end": 1413.93, "text": "有何难在"}, {"start": 1415.33, "end": 1416.61, "text": "不管怎么样"}, {"start": 1416.61, "end": 1417.69, "text": "在下余见"}, {"start": 1417.69, "end": 1420.09, "text": "我们还是谨遵丞相之命"}, {"start": 1420.09, "end": 1422.09, "text": "在五路总口处下寨"}, {"start": 1422.09, "end": 1424.25, "text": "多派军士伐木扎营"}, {"start": 1424.25, "end": 1426.37, "text": "以图长久之计"}, {"start": 1426.37, "end": 1427.45, "text": "不然"}, {"start": 1427.45, "end": 1428.93, "text": "路口下寨"}, {"start": 1428.93, "end": 1430.09, "text": "无嫌可疑"}, {"start": 1431.09, "end": 1433.05, "text": "倘若卫兵抢占山头"}, {"start": 1433.05, "end": 1434.65, "text": "居高临下"}, {"start": 1434.65, "end": 1436.25, "text": "我军岂不危在"}, {"start": 1436.25, "end": 1438.25, "text": "那参军的意思是"}, {"start": 1438.25, "end": 1439.77, "text": "你看"}, {"start": 1439.77, "end": 1441.73, "text": "那儿就坐山头"}, {"start": 1441.73, "end": 1443.53, "text": "山上林木极果"}, {"start": 1443.53, "end": 1445.37, "text": "乃天赐之险"}, {"start": 1445.37, "end": 1447.65, "text": "不如就在山上屯军"}, {"start": 1448.97, "end": 1450.89, "text": "那是一座孤山哪"}, {"start": 1450.89, "end": 1453.17, "text": "四面皆无山岭相连"}, {"start": 1453.17, "end": 1454.49, "text": "倘若卫军驻至"}, {"start": 1454.49, "end": 1455.65, "text": "四面围攻"}, {"start": 1455.69, "end": 1457.53, "text": "我军可就没有退路了"}, {"start": 1459.49, "end": 1461.77, "text": "将军此言差矣"}, {"start": 1461.77, "end": 1463.73, "text": "孙子兵法云"}, {"start": 1463.73, "end": 1464.93, "text": "平高势下"}, {"start": 1464.93, "end": 1467.05, "text": "势如破竹"}, {"start": 1467.05, "end": 1468.45, "text": "我军居山上"}, {"start": 1468.45, "end": 1471.29, "text": "卫军居下"}, {"start": 1471.29, "end": 1472.89, "text": "他们胆敢来攻"}, {"start": 1472.89, "end": 1474.09, "text": "我只需万箭齐发"}, {"start": 1474.09, "end": 1475.13, "text": "木石滚下"}, {"start": 1475.13, "end": 1476.05, "text": "定叫卫兵"}, {"start": 1476.05, "end": 1477.09, "text": "片甲无悔"}, {"start": 1477.09, "end": 1478.57, "text": "但如果卫军为而不攻"}, {"start": 1478.57, "end": 1480.29, "text": "怎么办"}, {"start": 1480.29, "end": 1481.45, "text": "数日之后"}, {"start": 1481.45, "end": 1482.77, "text": "我军粮草断绝"}, {"start": 1482.77, "end": 1484.97, "text": "将会不战自乱哪"}, {"start": 1484.97, "end": 1486.45, "text": "孙子兵法云"}, {"start": 1486.45, "end": 1488.25, "text": "至之死地而后生"}, {"start": 1489.61, "end": 1492.25, "text": "将军领兵征战多年"}, {"start": 1492.25, "end": 1494.69, "text": "不会不明白这个道理吧"}, {"start": 1494.69, "end": 1496.41, "text": "我军一旦粮草断绝"}, {"start": 1496.41, "end": 1498.41, "text": "将士们必将奋起死战"}, {"start": 1498.41, "end": 1499.65, "text": "以当百"}, {"start": 1499.65, "end": 1500.61, "text": "安能不胜"}, {"start": 1500.61, "end": 1501.65, "text": "参军"}, {"start": 1501.65, "end": 1502.77, "text": "这兵法所言"}, {"start": 1502.77, "end": 1503.93, "text": "并非都对啊"}, {"start": 1503.93, "end": 1507.15, "text": "王将军"}, {"start": 1507.15, "end": 1509.35, "text": "丞相每次统兵征战"}, {"start": 1509.35, "end": 1510.39, "text": "都带着我"}, {"start": 1511.35, "end": 1513.23, "text": "丞相御师不绝时"}, {"start": 1513.23, "end": 1514.75, "text": "常吹熏于我"}, {"start": 1514.75, "end": 1516.15, "text": "莫非将军想要抗命"}, {"start": 1516.15, "end": 1519.9, "text": "我"}, {"start": 1519.94, "end": 1522.02, "text": "在下奉命"}, {"start": 1522.98, "end": 1524.42, "text": "这就对了"}, {"start": 1524.42, "end": 1526.42, "text": "大军即刻上山扎营"}, {"start": 1527.3, "end": 1527.98, "text": "参军"}, {"start": 1528.98, "end": 1530.62, "text": "在下的意思是说"}, {"start": 1530.62, "end": 1533.02, "text": "你带两万大军在山上扎营"}, {"start": 1533.02, "end": 1535.34, "text": "我用五千军士在山下立寨"}, {"start": 1535.34, "end": 1537.78, "text": "你我之间形成计较之势"}, {"start": 1537.78, "end": 1539.18, "text": "倘若卫兵来袭"}, {"start": 1539.18, "end": 1542.87, "text": "也好有个照应"}, {"start": 1542.87, "end": 1544.55, "text": "那你就带着本部兵马"}, {"start": 1544.55, "end": 1548.13, "text": "下山立寨吧"}, {"start": 1548.13, "end": 1549.61, "text": "我急退卫军"}, {"start": 1549.61, "end": 1551.25, "text": "丞相面前"}, {"start": 1551.25, "end": 1552.61, "text": "你可分不得功"}, {"start": 1552.61, "end": 1569.89, "text": "我"}, {"start": 1569.93, "end": 1572.33, "text": "蜀军已经占领了阶梯要道"}, {"start": 1572.33, "end": 1573.53, "text": "将军"}, {"start": 1573.53, "end": 1575.09, "text": "此处离蜀军太近"}, {"start": 1575.09, "end": 1576.85, "text": "强武都可以射倒了"}, {"start": 1576.85, "end": 1578.37, "text": "还是请将军回营吧"}, {"start": 1579.73, "end": 1580.57, "text": "临阵交战"}, {"start": 1580.57, "end": 1581.85, "text": "跪在知己知彼"}, {"start": 1581.85, "end": 1583.13, "text": "不深入谈营"}, {"start": 1583.13, "end": 1588.15, "text": "如何看清蜀军阵势"}, {"start": 1588.15, "end": 1589.75, "text": "我们已经被蜀军发现了"}, {"start": 1589.75, "end": 1591.23, "text": "不必慌张"}, {"start": 1591.23, "end": 1592.47, "text": "敌军不多"}, {"start": 1592.47, "end": 1593.27, "text": "你们先回去"}, {"start": 1593.27, "end": 1594.15, "text": "把蜀军引开"}, {"start": 1594.15, "end": 1594.71, "text": "喏"}, {"start": 1594.71, "end": 1596.31, "text": "我再观察片刻"}, {"start": 1596.31, "end": 1605.46, "text": "走"}, {"start": 1605.46, "end": 1606.22, "text": "父亲"}, {"start": 1606.86, "end": 1607.74, "text": "父亲"}, {"start": 1607.74, "end": 1610.61, "text": "退下"}, {"start": 1610.61, "end": 1611.85, "text": "军中只有将士"}, {"start": 1611.85, "end": 1612.69, "text": "吴父子"}, {"start": 1614.01, "end": 1615.73, "text": "禀大都督"}, {"start": 1615.73, "end": 1618.17, "text": "末将奉命前往阶梯打探"}, {"start": 1618.17, "end": 1619.09, "text": "发现蜀军"}, {"start": 1619.09, "end": 1621.01, "text": "已经占领了阶梯要道"}, {"start": 1622.97, "end": 1628.59, "text": "两真是神级妙算"}, {"start": 1628.59, "end": 1630.07, "text": "高我一头啊"}, {"start": 1631.43, "end": 1632.43, "text": "看来上天"}, {"start": 1632.43, "end": 1637.62, "text": "不予我建功的机会啊"}, {"start": 1637.62, "end": 1639.94, "text": "大都督为何自博自叹"}, {"start": 1639.94, "end": 1640.82, "text": "末将认为"}, {"start": 1640.82, "end": 1646.22, "text": "阶梯唾首可得"}, {"start": 1646.22, "end": 1647.74, "text": "司马昭"}, {"start": 1647.74, "end": 1649.02, "text": "你从军不久"}, {"start": 1649.02, "end": 1651.06, "text": "为何出此大言"}, {"start": 1651.06, "end": 1652.1, "text": "禀大都督"}, {"start": 1652.74, "end": 1655.42, "text": "末将曾逼近敌营仔细看过"}, {"start": 1655.42, "end": 1656.78, "text": "阶梯吴国当到处"}, {"start": 1656.78, "end": 1657.78, "text": "只有一座军营"}, {"start": 1657.78, "end": 1659.02, "text": "兵不过五千"}, {"start": 1659.02, "end": 1660.1, "text": "而蜀军大营"}, {"start": 1660.1, "end": 1660.86, "text": "全扎在"}, {"start": 1660.86, "end": 1662.38, "text": "阶梯东面的石山上"}, {"start": 1662.38, "end": 1663.54, "text": "只要我大军围攻"}, {"start": 1663.54, "end": 1664.66, "text": "必能夺取"}, {"start": 1664.66, "end": 1666.62, "text": "蜀军居高临下"}, {"start": 1666.62, "end": 1667.86, "text": "府市四面"}, {"start": 1667.86, "end": 1669.78, "text": "我军只能仰攻"}, {"start": 1669.78, "end": 1671.06, "text": "事倍功半"}, {"start": 1671.06, "end": 1673.26, "text": "取它怎能不难"}, {"start": 1673.26, "end": 1675.62, "text": "末将曾绕山一周"}, {"start": 1675.62, "end": 1677.26, "text": "发现那是一座孤山"}, {"start": 1677.26, "end": 1678.9, "text": "山随高却孤立无援"}, {"start": 1678.9, "end": 1679.7, "text": "一旦被围"}, {"start": 1679.7, "end": 1681.14, "text": "便无路可逃了"}, {"start": 1681.22, "end": 1682.54, "text": "更要紧的是"}, {"start": 1682.54, "end": 1683.82, "text": "那山离河流很远"}, {"start": 1683.82, "end": 1684.74, "text": "屈水不易"}, {"start": 1685.66, "end": 1687.18, "text": "就算山上有泉水"}, {"start": 1687.18, "end": 1688.34, "text": "也不足大军引用"}, {"start": 1689.06, "end": 1690.42, "text": "大都督请想"}, {"start": 1690.42, "end": 1692.66, "text": "一旦断了他们的水源"}, {"start": 1692.66, "end": 1693.66, "text": "他们能支撑几日"}, {"start": 1694.78, "end": 1696.26, "text": "司马昭"}, {"start": 1696.26, "end": 1697.46, "text": "带我前去观察"}, {"start": 1699.14, "end": 1700.74, "text": "不行"}, {"start": 1700.74, "end": 1701.34, "text": "大都督"}, {"start": 1702.86, "end": 1704.54, "text": "难道你连我都信不过吗"}, {"start": 1704.54, "end": 1709.57, "text": "不是信不过你"}, {"start": 1710.69, "end": 1719.5, "text": "我更相信自己的眼睛"}, {"start": 1719.5, "end": 1720.26, "text": "司马昭"}, {"start": 1721.74, "end": 1723.9, "text": "这情形你可仔细探查过"}, {"start": 1725.5, "end": 1726.78, "text": "而当时离蜀军后队"}, {"start": 1726.78, "end": 1728.18, "text": "只有一箭之地"}, {"start": 1728.18, "end": 1729.46, "text": "看得一清二楚"}, {"start": 1729.46, "end": 1734.78, "text": "全军立即八营袭击"}, {"start": 1734.78, "end": 1736.66, "text": "以迅雷不及掩耳之势"}, {"start": 1736.66, "end": 1737.58, "text": "为主截停蜀军"}, {"start": 1738.42, "end": 1739.34, "text": "遵命"}, {"start": 1772.66, "end": 1773.94, "text": "此我见功了"}, {"start": 1773.94, "end": 1778.22, "text": "统领将军是谁"}, {"start": 1779.3, "end": 1780.18, "text": "马良之弟"}, {"start": 1780.18, "end": 1781.66, "text": "蜀参军马肃"}, {"start": 1781.66, "end": 1782.42, "text": "传言说"}, {"start": 1782.42, "end": 1783.74, "text": "他跟随朱国亮多年"}, {"start": 1783.74, "end": 1784.62, "text": "深知兵法套律"}, {"start": 1786.14, "end": 1787.58, "text": "我不信任何人"}, {"start": 1787.58, "end": 1793.26, "text": "看他如何行事"}, {"start": 1793.26, "end": 1794.7, "text": "我朕来看"}, {"start": 1794.7, "end": 1796.62, "text": "徒有虚面"}, {"start": 1796.62, "end": 1801.25, "text": "朱国亮敢用此人为将"}, {"start": 1801.25, "end": 1804.18, "text": "岂有不败"}, {"start": 1804.18, "end": 1806.54, "text": "看来朱国亮半是英明"}, {"start": 1806.54, "end": 1811.07, "text": "也要会以此人了"}, {"start": 1811.07, "end": 1811.99, "text": "街庭左右"}, {"start": 1811.99, "end": 1813.39, "text": "还有蜀军吗"}, {"start": 1814.59, "end": 1815.83, "text": "十里开外"}, {"start": 1815.83, "end": 1817.23, "text": "是王平的营寨"}, {"start": 1817.23, "end": 1818.43, "text": "兵不过五千"}, {"start": 1818.43, "end": 1822.29, "text": "本都谢你了"}, {"start": 1822.29, "end": 1827.9, "text": "司马昭"}, {"start": 1827.9, "end": 1828.34, "text": "传命"}, {"start": 1829.94, "end": 1831.34, "text": "张河领军一万"}, {"start": 1831.34, "end": 1833.22, "text": "攻打王平营寨"}, {"start": 1833.22, "end": 1835.78, "text": "我自统大军围山"}, {"start": 1835.78, "end": 1836.98, "text": "告诉诸位将军"}, {"start": 1838.38, "end": 1840.1, "text": "只需维尔不攻"}, {"start": 1840.1, "end": 1841.62, "text": "只要断骑水稻"}, {"start": 1841.62, "end": 1842.82, "text": "击鼓呐喊"}, {"start": 1842.82, "end": 1846.38, "text": "扰敌军心即可"}, {"start": 1846.38, "end": 1847.46, "text": "遵命"}, {"start": 1847.46, "end": 1848.66, "text": "三五日后"}, {"start": 1848.66, "end": 1849.86, "text": "马肃军乱"}, {"start": 1849.86, "end": 1850.86, "text": "清历攻山"}, {"start": 1857.14, "end": 1858.18, "text": "参军"}, {"start": 1858.18, "end": 1860.06, "text": "我们已经被魏军团团围困"}, {"start": 1860.06, "end": 1860.78, "text": "看上去魏军"}, {"start": 1860.78, "end": 1864.68, "text": "大约有十万兵马"}, {"start": 1864.68, "end": 1865.92, "text": "区区十万的敌军"}, {"start": 1865.92, "end": 1867.96, "text": "就把你吓成这个样子了"}, {"start": 1867.96, "end": 1870.28, "text": "当年我随丞相赤壁大战"}, {"start": 1870.28, "end": 1871.72, "text": "曹操八十三万大军"}, {"start": 1871.72, "end": 1872.8, "text": "还不是不堪一击"}, {"start": 1874.2, "end": 1875.28, "text": "且让他们在山下"}, {"start": 1875.28, "end": 1876.04, "text": "鼓噪吧"}, {"start": 1876.76, "end": 1878.0, "text": "待证谋过后"}, {"start": 1878.0, "end": 1879.2, "text": "敌军露出脾态"}, {"start": 1879.96, "end": 1882.24, "text": "我军再一鼓作气冲下山去"}, {"start": 1882.24, "end": 1883.28, "text": "鼓泰山击厉"}, {"start": 1883.96, "end": 1885.28, "text": "定叫敌军"}, {"start": 1885.28, "end": 1886.64, "text": "骗假无为"}, {"start": 1886.64, "end": 1890.65, "text": "敌军主帅是谁"}, {"start": 1891.77, "end": 1892.93, "text": "从喊声听来"}, {"start": 1892.93, "end": 1894.21, "text": "是大都督司马仪"}, {"start": 1894.21, "end": 1903.38, "text": "已不会轻声道辞"}, {"start": 1903.38, "end": 1905.1, "text": "定是敌军假借其名"}, {"start": 1905.1, "end": 1906.34, "text": "虚张声势罢了"}, {"start": 1907.54, "end": 1908.34, "text": "坚守不战"}, {"start": 1908.94, "end": 1909.46, "text": "诺"}, {"start": 1918.05, "end": 1918.81, "text": "姜维尔"}, {"start": 1919.41, "end": 1920.93, "text": "魏炎到杨平关没有啊"}, {"start": 1921.77, "end": 1923.25, "text": "快马来信说是到了"}, {"start": 1924.61, "end": 1925.45, "text": "这街亭那边"}, {"start": 1925.45, "end": 1927.61, "text": "为何迟迟没有马肃的消息啊"}, {"start": 1928.61, "end": 1930.13, "text": "街亭本无营寨"}, {"start": 1930.13, "end": 1931.41, "text": "王平和马肃到了以后"}, {"start": 1931.41, "end": 1933.01, "text": "需要现扎营寨"}, {"start": 1933.01, "end": 1934.41, "text": "这需要时间"}, {"start": 1934.41, "end": 1935.57, "text": "可是末将认为"}, {"start": 1935.57, "end": 1937.21, "text": "他们扎完营寨以后"}, {"start": 1937.21, "end": 1939.01, "text": "一定会派人向丞相禀报的"}, {"start": 1941.81, "end": 1942.29, "text": "报"}, {"start": 1943.85, "end": 1944.41, "text": "禀丞相"}, {"start": 1944.41, "end": 1945.81, "text": "王平将军派人送进来了"}, {"start": 1945.81, "end": 1946.29, "text": "信呢"}, {"start": 1947.09, "end": 1948.61, "text": "这是王平将军绘制的地图"}, {"start": 1948.61, "end": 1949.85, "text": "请丞相过目"}, {"start": 1949.85, "end": 1950.73, "text": "搜哪来我看"}, {"start": 1950.73, "end": 1951.01, "text": "诺"}, {"start": 1966.58, "end": 1969.02, "text": "陷我大军入绝境啊"}, {"start": 1969.02, "end": 1969.86, "text": "丞相怎么了"}, {"start": 1971.06, "end": 1972.78, "text": "马肃竟然把大寨"}, {"start": 1972.78, "end": 1974.14, "text": "安在孤山之上"}, {"start": 1974.14, "end": 1976.94, "text": "向居高陵下击破来犯之敌"}, {"start": 1976.94, "end": 1977.62, "text": "你看"}, {"start": 1977.62, "end": 1979.14, "text": "这是王平所绘之图"}, {"start": 1979.74, "end": 1981.98, "text": "此山离河流甚远"}, {"start": 1981.98, "end": 1983.18, "text": "魏军如果来袭"}, {"start": 1983.18, "end": 1984.26, "text": "只需为而不攻"}, {"start": 1984.26, "end": 1985.18, "text": "断我水源"}, {"start": 1985.18, "end": 1987.5, "text": "两日之内我军必乱哪"}, {"start": 1987.5, "end": 1988.5, "text": "丞相"}, {"start": 1988.5, "end": 1989.86, "text": "末将愿出手街亭"}, {"start": 1989.86, "end": 1990.58, "text": "替回马肃"}, {"start": 1991.42, "end": 1992.14, "text": "来不及了"}, {"start": 1992.9, "end": 1997.4, "text": "此处离街亭至少有三百多里路"}, {"start": 1997.4, "end": 1998.4, "text": "姜维"}, {"start": 1998.4, "end": 2000.24, "text": "立刻传我三道军令"}, {"start": 2000.24, "end": 2000.92, "text": "第一"}, {"start": 2000.92, "end": 2003.08, "text": "令官兴张包各引军三千"}, {"start": 2003.08, "end": 2004.68, "text": "沿武功小路而行"}, {"start": 2004.68, "end": 2006.32, "text": "如与敌军不可立战"}, {"start": 2006.32, "end": 2007.72, "text": "只需击鼓呐喊"}, {"start": 2007.72, "end": 2009.16, "text": "待敌军撤退之后"}, {"start": 2009.16, "end": 2011.04, "text": "直往杨平关接营魏延"}, {"start": 2011.84, "end": 2012.76, "text": "第二"}, {"start": 2012.76, "end": 2015.0, "text": "让张义率军修理剑阁道"}, {"start": 2015.0, "end": 2016.76, "text": "准备三军撤回汉中"}, {"start": 2017.64, "end": 2018.52, "text": "第三"}, {"start": 2018.52, "end": 2020.36, "text": "让子龙将军速速回营"}, {"start": 2020.36, "end": 2022.32, "text": "他现在的处境危险至极"}, {"start": 2023.04, "end": 2023.72, "text": "诺"}, {"start": 2023.72, "end": 2024.12, "text": "慢"}, {"start": 2027.81, "end": 2029.93, "text": "令官兴张包各引三千人"}, {"start": 2029.93, "end": 2031.53, "text": "沿武功小路直上"}, {"start": 2031.53, "end": 2033.33, "text": "如与敌军不可立战"}, {"start": 2033.37, "end": 2034.73, "text": "等敌军退后"}, {"start": 2034.73, "end": 2036.89, "text": "前往杨平关接营魏延将军"}, {"start": 2037.45, "end": 2039.97, "text": "令张义修理剑阁道"}, {"start": 2039.97, "end": 2042.21, "text": "等待三军撤回汉中"}, {"start": 2042.21, "end": 2044.25, "text": "令子龙将军速速回营"}, {"start": 2045.01, "end": 2048.93, "text": "去吧"}, {"start": 2048.93, "end": 2050.21, "text": "丞相"}, {"start": 2050.21, "end": 2052.37, "text": "事情真的有这么严重吗"}, {"start": 2052.37, "end": 2054.61, "text": "如果我们的大军一旦撤退"}, {"start": 2054.61, "end": 2056.45, "text": "那北伐可就功亏一篑了"}, {"start": 2057.25, "end": 2060.93, "text": "只怕会更严重"}, {"start": 2060.93, "end": 2062.93, "text": "我各出兵马"}, {"start": 2062.93, "end": 2064.33, "text": "如果能安然撤退"}, {"start": 2064.33, "end": 2066.41, "text": "就已经不错了"}, {"start": 2066.45, "end": 2067.81, "text": "速去传令吧"}, {"start": 2069.01, "end": 2069.65, "text": "诺"}, {"start": 2084.62, "end": 2086.98, "text": "我识人不明"}, {"start": 2086.98, "end": 2095.85, "text": "主成大错呀"}, {"start": 2095.85, "end": 2096.77, "text": "都怎么了"}, {"start": 2096.77, "end": 2097.37, "text": "起来"}, {"start": 2097.93, "end": 2098.85, "text": "起来"}, {"start": 2098.85, "end": 2099.61, "text": "快起来"}, {"start": 2100.37, "end": 2101.57, "text": "给我起来"}, {"start": 2101.57, "end": 2102.17, "text": "起来"}, {"start": 2102.77, "end": 2103.89, "text": "起来 快起来"}, {"start": 2103.89, "end": 2105.13, "text": "快起来"}, {"start": 2105.13, "end": 2106.33, "text": "快起来"}, {"start": 2106.33, "end": 2107.57, "text": "起来"}, {"start": 2107.57, "end": 2108.29, "text": "起来"}, {"start": 2109.69, "end": 2111.09, "text": "这是怎么回事"}, {"start": 2111.09, "end": 2112.17, "text": "将军"}, {"start": 2112.17, "end": 2113.41, "text": "山上没有水源"}, {"start": 2113.41, "end": 2116.74, "text": "各营都断水了"}, {"start": 2116.74, "end": 2117.9, "text": "怎么可能"}, {"start": 2117.9, "end": 2119.98, "text": "山有多高水就有多高"}, {"start": 2119.98, "end": 2121.42, "text": "那是在南方"}, {"start": 2121.42, "end": 2122.98, "text": "北方本来少雨"}, {"start": 2122.98, "end": 2124.86, "text": "此山有乱石居多"}, {"start": 2124.86, "end": 2128.42, "text": "哪有水源呀"}, {"start": 2128.42, "end": 2130.06, "text": "立即组织人马"}, {"start": 2130.06, "end": 2131.42, "text": "冲下山取水"}, {"start": 2131.42, "end": 2132.58, "text": "试过了"}, {"start": 2132.58, "end": 2134.18, "text": "驾驶们冲到山腰"}, {"start": 2134.18, "end": 2135.9, "text": "便被乱箭射回"}, {"start": 2135.9, "end": 2136.74, "text": "再冲"}, {"start": 2189.17, "end": 2192.71, "text": "说吧"}, {"start": 2192.71, "end": 2195.31, "text": "事情果然不出丞相所料"}, {"start": 2195.31, "end": 2196.99, "text": "司马已亲自带了十五万人"}, {"start": 2196.99, "end": 2198.23, "text": "到达了街亭"}, {"start": 2198.23, "end": 2199.83, "text": "兵分三路"}, {"start": 2199.83, "end": 2201.27, "text": "张河围攻街亭"}, {"start": 2201.27, "end": 2202.91, "text": "徐皇蒙攻杨平关"}, {"start": 2202.91, "end": 2205.11, "text": "司马照围着赵云打"}, {"start": 2205.11, "end": 2206.79, "text": "目前双方正在激战"}, {"start": 2206.79, "end": 2209.95, "text": "胜负不明"}, {"start": 2209.95, "end": 2214.87, "text": "胜负已明了"}, {"start": 2214.87, "end": 2217.03, "text": "你派人传命"}, {"start": 2217.03, "end": 2219.19, "text": "令南安 天水"}, {"start": 2219.19, "end": 2221.59, "text": "安定三军的军民官吏"}, {"start": 2221.59, "end": 2224.07, "text": "兴野迁往汉中"}, {"start": 2224.07, "end": 2225.63, "text": "再点五千精兵"}, {"start": 2225.63, "end": 2227.43, "text": "黎民随我出发"}, {"start": 2227.43, "end": 2228.75, "text": "丞相"}, {"start": 2228.75, "end": 2229.63, "text": "大营里的士兵"}, {"start": 2229.63, "end": 2231.63, "text": "都已经奉命派出去了"}, {"start": 2231.63, "end": 2233.55, "text": "所剩的"}, {"start": 2233.55, "end": 2234.71, "text": "不到五千人"}, {"start": 2234.71, "end": 2236.55, "text": "还剩多少啊"}, {"start": 2236.55, "end": 2239.15, "text": "除了三百甲师以外"}, {"start": 2239.15, "end": 2242.27, "text": "老弱病残加在一起"}, {"start": 2242.27, "end": 2243.31, "text": "两千总有八"}, {"start": 2243.31, "end": 2250.99, "text": "全部召集起来"}, {"start": 2250.99, "end": 2252.59, "text": "随我去往西城"}, {"start": 2252.59, "end": 2254.11, "text": "什么"}, {"start": 2254.11, "end": 2256.39, "text": "西城"}, {"start": 2256.39, "end": 2257.67, "text": "丞相"}, {"start": 2257.67, "end": 2259.35, "text": "西城是个小县"}, {"start": 2259.35, "end": 2261.79, "text": "你干吗要去那儿啊"}, {"start": 2261.79, "end": 2263.59, "text": "街亭失械后"}, {"start": 2263.59, "end": 2265.71, "text": "我军粮稻已断"}, {"start": 2265.71, "end": 2267.07, "text": "南归之前"}, {"start": 2267.07, "end": 2269.39, "text": "汉中的粮草又接济不上"}, {"start": 2269.39, "end": 2271.71, "text": "只剩西城十万但军粮"}, {"start": 2271.75, "end": 2273.75, "text": "无论如何要抢运出来"}, {"start": 2273.75, "end": 2274.67, "text": "可是丞相"}, {"start": 2274.67, "end": 2276.07, "text": "西城矮小残破"}, {"start": 2276.07, "end": 2277.31, "text": "如果卫军追过来的话"}, {"start": 2277.31, "end": 2278.91, "text": "断难把守"}, {"start": 2278.91, "end": 2280.59, "text": "你身系属汉安卫"}, {"start": 2280.59, "end": 2282.51, "text": "怎么能身陷险境呢"}, {"start": 2282.51, "end": 2284.39, "text": "不如你先撤回到汉中去"}, {"start": 2284.39, "end": 2285.59, "text": "由末将"}, {"start": 2285.59, "end": 2288.42, "text": "去西城"}, {"start": 2288.42, "end": 2289.94, "text": "陛下把举国大军"}, {"start": 2289.94, "end": 2291.46, "text": "交付于我"}, {"start": 2291.46, "end": 2293.26, "text": "如今大军未还"}, {"start": 2293.26, "end": 2294.74, "text": "我作为统帅"}, {"start": 2294.74, "end": 2297.1, "text": "怎能抽身先退呢"}, {"start": 2297.1, "end": 2297.9, "text": "不成"}, {"start": 2297.9, "end": 2298.98, "text": "丞相"}, {"start": 2298.98, "end": 2307.82, "text": "按我军令行事"}, {"start": 2307.82, "end": 2323.96, "text": "诺"}, {"start": 2324.0, "end": 2326.4, "text": "你把城中百姓都征集起来"}, {"start": 2326.4, "end": 2327.68, "text": "如果在天黑之前"}, {"start": 2327.68, "end": 2329.44, "text": "不能把粮食运出城"}, {"start": 2329.44, "end": 2331.4, "text": "北伐大军就回不得顺处"}, {"start": 2331.4, "end": 2332.0, "text": "闪开"}, {"start": 2332.0, "end": 2332.64, "text": "诺"}, {"start": 2332.64, "end": 2334.56, "text": "都给我闪开"}, {"start": 2334.56, "end": 2337.52, "text": "云奕"}, {"start": 2337.52, "end": 2338.4, "text": "丞相不好了"}, {"start": 2338.4, "end": 2339.16, "text": "卫军来袭"}, {"start": 2339.16, "end": 2341.0, "text": "已到城东二十里处了"}, {"start": 2341.0, "end": 2342.56, "text": "有多少兵马"}, {"start": 2342.56, "end": 2344.2, "text": "同兵将军是谁"}, {"start": 2344.2, "end": 2346.88, "text": "烟尘连绵一眼望不到尽头啊"}, {"start": 2346.88, "end": 2348.56, "text": "至少有几万兵马"}, {"start": 2348.56, "end": 2349.72, "text": "齐千军在大道上"}, {"start": 2349.72, "end": 2371.5, "text": "应有四马二字"}, {"start": 2371.5, "end": 2374.14, "text": "城中现在还有多少兵马"}, {"start": 2374.14, "end": 2375.66, "text": "我们带来了两千兵"}, {"start": 2375.66, "end": 2376.58, "text": "可是其中大部分"}, {"start": 2376.58, "end": 2378.22, "text": "都出城运粮了"}, {"start": 2378.22, "end": 2380.34, "text": "此刻兵部足迁"}, {"start": 2380.34, "end": 2381.74, "text": "丞相"}, {"start": 2381.74, "end": 2382.98, "text": "我们赶紧撤退吧"}, {"start": 2382.98, "end": 2387.79, "text": "你毕帅铁记"}, {"start": 2387.79, "end": 2390.47, "text": "我们如何能快得过他呀"}, {"start": 2390.47, "end": 2392.35, "text": "丞相"}, {"start": 2392.35, "end": 2394.11, "text": "西城城环高不过三尺"}, {"start": 2394.11, "end": 2395.35, "text": "我们兵部足迁"}, {"start": 2395.35, "end": 2404.58, "text": "如何守得住啊"}, {"start": 2404.58, "end": 2406.3, "text": "传命"}, {"start": 2406.3, "end": 2408.62, "text": "把所有旌旗都逆藏起来"}, {"start": 2408.62, "end": 2410.38, "text": "隔出城门大开"}, {"start": 2410.38, "end": 2411.66, "text": "每门用三五士兵"}, {"start": 2411.66, "end": 2413.34, "text": "扮成百姓打扫街道"}, {"start": 2413.34, "end": 2414.7, "text": "不得随便出入"}, {"start": 2414.7, "end": 2416.5, "text": "更不得大声喧哗"}, {"start": 2416.5, "end": 2418.3, "text": "为令折斩"}, {"start": 2418.3, "end": 2419.26, "text": "丞相"}, {"start": 2419.26, "end": 2421.86, "text": "我的古琴啊"}, {"start": 2421.86, "end": 2423.02, "text": "在车上"}, {"start": 2423.02, "end": 2425.18, "text": "立刻驱来"}, {"start": 2425.18, "end": 2425.86, "text": "诺"}]