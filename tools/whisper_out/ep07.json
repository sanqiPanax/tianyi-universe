[{"start": 7.63, "end": 13.5, "text": "我们以前真是错待他了。"}, {"start": 13.5, "end": 14.5, "text": "是啊 父亲。"}, {"start": 14.5, "end": 185.34, "text": "我也没有想到刘表竟然这么讲义气。"}, {"start": 185.34, "end": 190.42, "text": "刘表今日之恩"}, {"start": 190.42, "end": 195.21, "text": "将来我们必当加倍回报。"}, {"start": 195.21, "end": 200.63, "text": "待回江东后"}, {"start": 200.63, "end": 203.63, "text": "你立刻把我们以前缴获荆州的所有兵马"}, {"start": 203.63, "end": 205.63, "text": "全部送还给他。"}, {"start": 205.63, "end": 207.63, "text": "再送他两千袋粮食"}, {"start": 207.63, "end": 209.63, "text": "不该比起仇断。"}, {"start": 209.63, "end": 210.63, "text": "以后"}, {"start": 210.63, "end": 213.94, "text": "你再送他两千袋粮食。"}, {"start": 213.94, "end": 215.94, "text": "再送他两千袋粮食。"}, {"start": 215.94, "end": 217.94, "text": "再送他两千袋粮食。"}, {"start": 217.94, "end": 218.94, "text": "以后"}, {"start": 218.94, "end": 219.94, "text": "逢年过节"}, {"start": 219.94, "end": 220.94, "text": "婚嫁寿诞"}, {"start": 220.94, "end": 224.86, "text": "不要以礼相合。"}, {"start": 224.86, "end": 288.17, "text": "主公"}, {"start": 288.17, "end": 289.17, "text": "是荆州兵袭击了我们。"}, {"start": 289.17, "end": 290.17, "text": "爹"}, {"start": 290.17, "end": 291.17, "text": "主公"}, {"start": 291.17, "end": 293.99, "text": "华奖"}, {"start": 293.99, "end": 297.2, "text": "主公"}, {"start": 297.2, "end": 298.2, "text": "你坚持住啊"}, {"start": 298.2, "end": 299.2, "text": "大家用力华奖"}, {"start": 299.2, "end": 300.2, "text": "主公"}, {"start": 300.2, "end": 302.2, "text": "冲出航道"}, {"start": 302.2, "end": 312.1, "text": "肯定在水下设下了巨石"}, {"start": 312.1, "end": 313.1, "text": "阻塞了航道"}, {"start": 313.1, "end": 314.1, "text": "我们冲不出去了。"}, {"start": 314.1, "end": 320.94, "text": "要拼了。"}, {"start": 320.94, "end": 331.64, "text": "江东战船都已陷入绝境"}, {"start": 331.64, "end": 333.64, "text": "他们是上天无路入地无门啊"}, {"start": 333.64, "end": 335.64, "text": "这可是千载难逢的良机啊"}, {"start": 335.64, "end": 337.64, "text": "我们必须把孙剑父子彻底消灭"}, {"start": 337.64, "end": 339.64, "text": "绝不能留后患啊"}, {"start": 339.64, "end": 442.46, "text": "你说得对"}, {"start": 442.46, "end": 447.5, "text": "带来了灾难了"}, {"start": 447.5, "end": 453.56, "text": "凶险"}, {"start": 458.27, "end": 462.89, "text": "爹"}, {"start": 462.89, "end": 467.6, "text": "快快登岸吧"}, {"start": 468.6, "end": 469.6, "text": "爹"}, {"start": 469.6, "end": 470.6, "text": "儿扶你上岸"}, {"start": 474.17, "end": 475.17, "text": "爹"}, {"start": 475.17, "end": 479.08, "text": "今天"}, {"start": 479.08, "end": 481.08, "text": "就不陪你上岸了"}, {"start": 481.08, "end": 486.37, "text": "我的娟儿啊"}, {"start": 487.37, "end": 490.74, "text": "你才将来"}, {"start": 491.74, "end": 492.74, "text": "一定要"}, {"start": 492.74, "end": 498.77, "text": "爹你放心"}, {"start": 498.77, "end": 500.77, "text": "孩儿以后"}, {"start": 500.77, "end": 502.77, "text": "会好好负责哥哥的"}, {"start": 502.77, "end": 514.52, "text": "他出生入死"}, {"start": 514.52, "end": 516.52, "text": "履历战功"}, {"start": 516.52, "end": 517.52, "text": "转眼间"}, {"start": 517.52, "end": 518.52, "text": "他就"}, {"start": 519.52, "end": 520.52, "text": "坐视"}, {"start": 520.52, "end": 521.52, "text": "留表"}, {"start": 521.52, "end": 532.45, "text": "还有那个穿过鱼席"}, {"start": 532.45, "end": 533.45, "text": "咱们不要了"}, {"start": 534.45, "end": 535.45, "text": "咱们不要了"}, {"start": 535.45, "end": 537.45, "text": "不要了"}, {"start": 537.45, "end": 538.45, "text": "改日"}, {"start": 539.45, "end": 540.45, "text": "把他转家"}, {"start": 540.45, "end": 543.27, "text": "转交给袁叔"}, {"start": 544.27, "end": 545.27, "text": "让他们袁氏兄弟"}, {"start": 546.27, "end": 547.27, "text": "相争去吧"}, {"start": 548.27, "end": 549.27, "text": "爹"}, {"start": 549.27, "end": 550.27, "text": "还记住了"}, {"start": 550.27, "end": 551.27, "text": "爹舍不得你"}, {"start": 564.82, "end": 566.82, "text": "爹舍不得你啊"}, {"start": 567.82, "end": 568.82, "text": "主公"}, {"start": 568.82, "end": 569.82, "text": "你放心吧"}, {"start": 569.82, "end": 570.82, "text": "爹"}, {"start": 570.82, "end": 571.82, "text": "主公"}, {"start": 571.82, "end": 572.82, "text": "我该"}, {"start": 572.82, "end": 573.82, "text": "再"}, {"start": 573.82, "end": 575.82, "text": "把娟儿带走"}, {"start": 575.82, "end": 576.82, "text": "爹不要了"}, {"start": 576.82, "end": 577.82, "text": "爹"}, {"start": 577.82, "end": 578.82, "text": "主公"}, {"start": 578.82, "end": 579.82, "text": "那你的主公"}, {"start": 579.82, "end": 580.82, "text": "只要现在还没有找"}, {"start": 825.49, "end": 833.82, "text": "我如何向我母亲交代"}, {"start": 833.82, "end": 837.36, "text": "我有何脸面"}, {"start": 837.36, "end": 838.36, "text": "回去见江东父老"}, {"start": 839.36, "end": 842.06, "text": "至于这次"}, {"start": 842.06, "end": 844.06, "text": "我们只能先回江东了"}, {"start": 844.06, "end": 845.06, "text": "待日后"}, {"start": 845.06, "end": 846.06, "text": "再找留表算账"}, {"start": 847.06, "end": 856.45, "text": "我誓死不回江东"}, {"start": 856.45, "end": 857.45, "text": "公子"}, {"start": 857.45, "end": 858.45, "text": "我有一策"}, {"start": 858.45, "end": 859.45, "text": "不知可行否"}, {"start": 860.45, "end": 863.27, "text": "荆州上将"}, {"start": 863.27, "end": 864.27, "text": "皇祖被你擒获"}, {"start": 864.27, "end": 865.27, "text": "我们"}, {"start": 865.27, "end": 866.27, "text": "何不用他"}, {"start": 866.27, "end": 867.27, "text": "换回主公的尸首"}, {"start": 867.27, "end": 868.27, "text": "不过"}, {"start": 868.27, "end": 871.19, "text": "须有一人为使"}, {"start": 872.19, "end": 873.19, "text": "携皇祖前去"}, {"start": 873.19, "end": 874.19, "text": "向留表议和"}, {"start": 875.19, "end": 876.19, "text": "如此才有可能成功"}, {"start": 877.19, "end": 880.4, "text": "我去"}, {"start": 880.4, "end": 881.4, "text": "公子"}, {"start": 881.4, "end": 882.4, "text": "公子"}, {"start": 882.4, "end": 883.4, "text": "你现在已经是"}, {"start": 883.4, "end": 884.4, "text": "江东之主"}, {"start": 884.4, "end": 885.4, "text": "绝不能再陷于险地"}, {"start": 886.4, "end": 889.48, "text": "还是我去吧"}, {"start": 889.48, "end": 890.48, "text": "我是父亲的长子"}, {"start": 890.48, "end": 891.48, "text": "如果我不去"}, {"start": 892.48, "end": 893.48, "text": "留表怎么能相信"}, {"start": 893.48, "end": 894.48, "text": "我们议和的诚意"}, {"start": 894.48, "end": 895.48, "text": "闪开"}, {"start": 895.48, "end": 896.48, "text": "他们杀了你怎么办"}, {"start": 897.48, "end": 898.48, "text": "他们已经害死了主公"}, {"start": 899.48, "end": 900.48, "text": "正盼望着"}, {"start": 900.48, "end": 901.48, "text": "斩草除根"}, {"start": 901.48, "end": 902.48, "text": "以绝后患"}, {"start": 903.48, "end": 912.22, "text": "我去"}, {"start": 912.22, "end": 914.95, "text": "我也是父亲的儿子"}, {"start": 915.95, "end": 916.95, "text": "我去个留表议和"}, {"start": 917.95, "end": 918.95, "text": "他们"}, {"start": 918.95, "end": 919.95, "text": "总该相信我们的诚意了吧"}, {"start": 920.95, "end": 921.95, "text": "不行"}, {"start": 921.95, "end": 922.95, "text": "这种事"}, {"start": 922.95, "end": 923.95, "text": "怎么能让你"}, {"start": 923.95, "end": 924.95, "text": "一个小孩子去"}, {"start": 924.95, "end": 928.16, "text": "末将觉得"}, {"start": 929.16, "end": 930.16, "text": "全公子的话"}, {"start": 930.16, "end": 931.16, "text": "有道理"}, {"start": 932.16, "end": 933.16, "text": "首先"}, {"start": 933.16, "end": 934.16, "text": "他是主公之子"}, {"start": 934.16, "end": 935.16, "text": "足见江东诚意"}, {"start": 936.16, "end": 937.16, "text": "此外"}, {"start": 937.16, "end": 938.16, "text": "只要大公子在"}, {"start": 938.16, "end": 939.16, "text": "留表断不敢"}, {"start": 939.16, "end": 940.16, "text": "加害二公子"}, {"start": 940.16, "end": 941.16, "text": "因为"}, {"start": 941.16, "end": 942.16, "text": "他们既害怕公子"}, {"start": 942.16, "end": 943.16, "text": "你复仇"}, {"start": 943.16, "end": 944.16, "text": "也担心"}, {"start": 944.16, "end": 945.16, "text": "激起天下诸侯的共怒"}, {"start": 946.16, "end": 947.16, "text": "所以"}, {"start": 947.16, "end": 948.16, "text": "以全公子为使"}, {"start": 948.16, "end": 949.16, "text": "反而会安全"}, {"start": 949.16, "end": 957.33, "text": "可"}, {"start": 957.33, "end": 958.33, "text": "那个老头"}, {"start": 958.33, "end": 959.33, "text": "见了我这个九岁的娃"}, {"start": 959.33, "end": 960.33, "text": "难道不惊讶吗"}, {"start": 961.33, "end": 962.33, "text": "难道不感动吗"}, {"start": 963.33, "end": 964.33, "text": "难道"}, {"start": 964.33, "end": 965.33, "text": "害怕他杀了我不成"}, {"start": 966.33, "end": 967.33, "text": "全公子真了不起"}, {"start": 968.33, "end": 969.33, "text": "句句说在点子上"}, {"start": 970.33, "end": 971.33, "text": "我看"}, {"start": 971.33, "end": 972.33, "text": "以全公子这样的才智"}, {"start": 972.33, "end": 973.33, "text": "此行"}, {"start": 973.33, "end": 974.33, "text": "必能成功"}, {"start": 1017.98, "end": 1018.98, "text": "成谱黄盖"}, {"start": 1018.98, "end": 1019.98, "text": "末将在"}, {"start": 1020.98, "end": 1021.98, "text": "带领所有的将士"}, {"start": 1022.98, "end": 1023.98, "text": "埋伏在"}, {"start": 1023.98, "end": 1024.98, "text": "荆州大营附近"}, {"start": 1024.98, "end": 1025.98, "text": "接应孙全"}, {"start": 1026.98, "end": 1027.98, "text": "遵命"}, {"start": 1036.22, "end": 1037.22, "text": "我们和江东之仇"}, {"start": 1038.22, "end": 1039.22, "text": "永世不可解了"}, {"start": 1040.22, "end": 1041.22, "text": "各地的诸侯听说"}, {"start": 1043.22, "end": 1044.22, "text": "也会谴责我留表"}, {"start": 1045.22, "end": 1046.22, "text": "不仁不义"}, {"start": 1048.22, "end": 1049.22, "text": "主公"}, {"start": 1049.22, "end": 1050.22, "text": "事情已经做下"}, {"start": 1050.22, "end": 1051.22, "text": "就不必后悔"}, {"start": 1052.22, "end": 1053.22, "text": "再说了"}, {"start": 1053.22, "end": 1054.22, "text": "乱世之中强者为尊"}, {"start": 1055.22, "end": 1056.22, "text": "江东恨我们怕什么"}, {"start": 1057.22, "end": 1058.22, "text": "他们竞此大败"}, {"start": 1058.22, "end": 1059.22, "text": "已经不是我们"}, {"start": 1059.22, "end": 1060.22, "text": "荆州的对手了"}, {"start": 1060.22, "end": 1065.66, "text": "禀主公"}, {"start": 1065.66, "end": 1066.66, "text": "江东派来使者请和"}, {"start": 1067.66, "end": 1068.66, "text": "并送回皇祖将军"}, {"start": 1071.58, "end": 1072.58, "text": "什么"}, {"start": 1072.58, "end": 1073.58, "text": "使者"}, {"start": 1073.58, "end": 1074.58, "text": "是"}, {"start": 1074.58, "end": 1075.58, "text": "让他们进来"}, {"start": 1075.58, "end": 1078.98, "text": "诺"}, {"start": 1078.98, "end": 1079.98, "text": "主公"}, {"start": 1079.98, "end": 1080.98, "text": "末将"}, {"start": 1081.98, "end": 1082.98, "text": "末将回来了"}, {"start": 1082.98, "end": 1087.25, "text": "江东的使者呢"}, {"start": 1094.01, "end": 1095.01, "text": "江东之子孙全"}, {"start": 1096.01, "end": 1097.01, "text": "拜见刘伯伯"}, {"start": 1098.01, "end": 1099.01, "text": "你就是使者"}, {"start": 1100.01, "end": 1102.83, "text": "是"}, {"start": 1102.83, "end": 1103.83, "text": "多大了"}, {"start": 1104.83, "end": 1105.83, "text": "禀刘伯伯"}, {"start": 1105.83, "end": 1106.83, "text": "孙全今年九岁"}, {"start": 1107.83, "end": 1108.83, "text": "九岁就来为使"}, {"start": 1109.83, "end": 1110.83, "text": "真是可笑"}, {"start": 1115.83, "end": 1116.83, "text": "禀刘伯伯"}, {"start": 1117.83, "end": 1118.83, "text": "高祖皇帝九岁时"}, {"start": 1119.83, "end": 1120.83, "text": "射死过一头金鹅猛虎"}, {"start": 1121.83, "end": 1122.83, "text": "吴帝爷九岁时"}, {"start": 1122.83, "end": 1123.83, "text": "反攻杀敌"}, {"start": 1124.83, "end": 1125.83, "text": "我孙全无用"}, {"start": 1125.83, "end": 1127.83, "text": "九岁时只能向刘伯伯请和"}, {"start": 1128.83, "end": 1129.83, "text": "请伯伯赐还我弟弟的尸首"}, {"start": 1130.83, "end": 1131.83, "text": "从今以后"}, {"start": 1131.83, "end": 1133.83, "text": "江东永远不向荆州复仇"}, {"start": 1134.83, "end": 1135.83, "text": "这"}, {"start": 1135.83, "end": 1145.95, "text": "主公"}, {"start": 1145.95, "end": 1146.95, "text": "我们干脆斩草除根"}, {"start": 1146.95, "end": 1147.95, "text": "彻底灭掉孙氏家族"}, {"start": 1148.95, "end": 1149.95, "text": "然后趁其不备"}, {"start": 1150.95, "end": 1151.95, "text": "发兵直去江东"}, {"start": 1152.95, "end": 1153.95, "text": "以成王后大业"}, {"start": 1153.95, "end": 1154.95, "text": "刘伯伯"}, {"start": 1157.26, "end": 1158.26, "text": "我哥哥孙策已经继承复位"}, {"start": 1159.26, "end": 1160.26, "text": "领长沙太守"}, {"start": 1160.26, "end": 1161.26, "text": "现在他不在三京渡"}, {"start": 1161.26, "end": 1162.26, "text": "早已返回江东"}, {"start": 1163.26, "end": 1164.26, "text": "掌军御敌"}, {"start": 1165.26, "end": 1166.26, "text": "我明白你的意思"}, {"start": 1167.26, "end": 1168.26, "text": "孙全啊"}, {"start": 1168.26, "end": 1169.26, "text": "我要问你"}, {"start": 1170.26, "end": 1172.26, "text": "你父亲死在我的手里"}, {"start": 1173.26, "end": 1174.26, "text": "你江东军为何不来杀我"}, {"start": 1175.26, "end": 1176.26, "text": "报仇啊"}, {"start": 1176.26, "end": 1178.26, "text": "反而要来求和"}, {"start": 1179.26, "end": 1180.26, "text": "禀刘伯伯"}, {"start": 1180.26, "end": 1181.26, "text": "弟弟临终前"}, {"start": 1181.26, "end": 1182.26, "text": "交代过我一句话"}, {"start": 1184.26, "end": 1185.26, "text": "什么话"}, {"start": 1185.26, "end": 1188.47, "text": "弟弟说"}, {"start": 1188.47, "end": 1189.47, "text": "刘伯伯有皇室之风"}, {"start": 1190.47, "end": 1191.47, "text": "忠义厚当"}, {"start": 1191.47, "end": 1192.47, "text": "是袁绍逼使他们"}, {"start": 1192.47, "end": 1193.47, "text": "伏击我们的"}, {"start": 1193.47, "end": 1194.47, "text": "要复仇"}, {"start": 1194.47, "end": 1195.47, "text": "应该找袁绍复仇"}, {"start": 1196.47, "end": 1197.47, "text": "江东与袁绍势不两立"}, {"start": 1198.47, "end": 1199.47, "text": "弟弟还说"}, {"start": 1199.47, "end": 1200.47, "text": "为了江东的安危"}, {"start": 1201.47, "end": 1202.47, "text": "我们应该与刘伯伯"}, {"start": 1202.47, "end": 1203.47, "text": "化干戈为玉帛"}, {"start": 1204.47, "end": 1205.47, "text": "两家修好"}, {"start": 1205.47, "end": 1206.47, "text": "和睦相处"}, {"start": 1207.47, "end": 1208.47, "text": "你父亲"}, {"start": 1208.47, "end": 1209.47, "text": "真是这么说的"}, {"start": 1210.47, "end": 1211.47, "text": "是"}, {"start": 1211.47, "end": 1214.33, "text": "孩子"}, {"start": 1215.33, "end": 1216.33, "text": "孩子"}, {"start": 1216.33, "end": 1217.33, "text": "快起来"}, {"start": 1219.33, "end": 1220.33, "text": "你父亲的尸骨"}, {"start": 1220.33, "end": 1221.33, "text": "我已经装练"}, {"start": 1221.33, "end": 1222.33, "text": "你可以带回江东"}, {"start": 1224.33, "end": 1226.33, "text": "我还要在江边设计"}, {"start": 1226.33, "end": 1228.33, "text": "送别你父亲的英灵"}, {"start": 1229.33, "end": 1230.33, "text": "谢"}, {"start": 1230.33, "end": 1231.33, "text": "谢刘伯伯"}, {"start": 1243.56, "end": 1244.56, "text": "相国"}, {"start": 1244.56, "end": 1245.56, "text": "相国"}, {"start": 1246.56, "end": 1247.56, "text": "相国"}, {"start": 1247.56, "end": 1248.56, "text": "相国"}, {"start": 1248.56, "end": 1249.56, "text": "大喜啊"}, {"start": 1249.56, "end": 1250.56, "text": "大喜啊"}, {"start": 1253.56, "end": 1254.56, "text": "相国的禁敌孙坚"}, {"start": 1255.56, "end": 1256.56, "text": "在归乡的路上"}, {"start": 1256.56, "end": 1257.56, "text": "途径三千度"}, {"start": 1257.56, "end": 1258.56, "text": "中了金州军的埋伏"}, {"start": 1258.56, "end": 1259.56, "text": "被刘表"}, {"start": 1260.56, "end": 1261.56, "text": "杀死了"}, {"start": 1266.59, "end": 1269.77, "text": "孙坚死了"}, {"start": 1269.77, "end": 1270.77, "text": "真的死了"}, {"start": 1271.77, "end": 1272.77, "text": "当真死了"}, {"start": 1276.77, "end": 1277.77, "text": "苍天有眼"}, {"start": 1279.77, "end": 1280.77, "text": "弃掉了咱家一块"}, {"start": 1281.77, "end": 1282.77, "text": "心腹大患"}, {"start": 1285.77, "end": 1287.77, "text": "在各路诸侯当中"}, {"start": 1287.77, "end": 1288.77, "text": "孙坚是个英雄"}, {"start": 1289.77, "end": 1290.77, "text": "只要他一死"}, {"start": 1292.77, "end": 1293.77, "text": "中原的诸侯"}, {"start": 1293.77, "end": 1295.77, "text": "都是猪狗鸡啊"}, {"start": 1295.77, "end": 1297.77, "text": "我看他哪一个敢出来"}, {"start": 1297.77, "end": 1298.77, "text": "跟咱家作对"}, {"start": 1299.77, "end": 1300.77, "text": "这回咱家"}, {"start": 1300.77, "end": 1302.77, "text": "一定是一个太平叫了"}, {"start": 1304.77, "end": 1307.72, "text": "禀相国"}, {"start": 1308.72, "end": 1309.72, "text": "在下有一言"}, {"start": 1310.72, "end": 1311.72, "text": "鸦印日久"}, {"start": 1312.72, "end": 1313.72, "text": "如梗在喉"}, {"start": 1313.72, "end": 1314.72, "text": "已经是"}, {"start": 1316.72, "end": 1317.72, "text": "不吐不快"}, {"start": 1318.72, "end": 1319.72, "text": "说"}, {"start": 1319.72, "end": 1320.72, "text": "敬请相国"}, {"start": 1320.72, "end": 1321.72, "text": "敬九五之尊"}, {"start": 1322.72, "end": 1324.72, "text": "及天子大位"}, {"start": 1326.72, "end": 1327.72, "text": "等等"}, {"start": 1331.22, "end": 1332.22, "text": "你是说"}, {"start": 1332.22, "end": 1335.22, "text": "想让咱家做皇帝"}, {"start": 1336.22, "end": 1337.22, "text": "是吧"}, {"start": 1338.22, "end": 1339.22, "text": "那能成吗"}, {"start": 1340.22, "end": 1341.22, "text": "又何不成啊"}, {"start": 1342.22, "end": 1343.22, "text": "自宪国进京后"}, {"start": 1344.22, "end": 1346.22, "text": "先是扫除宫为奸党"}, {"start": 1346.22, "end": 1348.22, "text": "成清朝纲福利新军"}, {"start": 1348.22, "end": 1349.22, "text": "继而又剿灭"}, {"start": 1349.22, "end": 1351.22, "text": "袁绍士八戮贼军"}, {"start": 1351.22, "end": 1354.22, "text": "君臣是无不额首称庆"}, {"start": 1354.22, "end": 1357.22, "text": "百姓无不望天送养"}, {"start": 1357.22, "end": 1358.22, "text": "正所谓"}, {"start": 1358.22, "end": 1359.22, "text": "唯唯此功"}, {"start": 1359.22, "end": 1360.22, "text": "功垂千古"}, {"start": 1360.22, "end": 1361.22, "text": "强强英明"}, {"start": 1361.22, "end": 1362.22, "text": "流芳万世"}, {"start": 1363.22, "end": 1364.22, "text": "如果"}, {"start": 1364.22, "end": 1365.22, "text": "如果相国"}, {"start": 1365.22, "end": 1366.22, "text": "不及天子位"}, {"start": 1366.22, "end": 1368.22, "text": "岂不有负臣民"}, {"start": 1368.22, "end": 1370.22, "text": "九乱而妄至之心吗"}, {"start": 1371.22, "end": 1372.22, "text": "汉言免四百年"}, {"start": 1372.22, "end": 1373.22, "text": "期数已尽"}, {"start": 1373.22, "end": 1375.22, "text": "早就应该改朝换代吧"}, {"start": 1375.22, "end": 1376.22, "text": "望眼天下"}, {"start": 1377.22, "end": 1379.86, "text": "还有谁"}, {"start": 1379.86, "end": 1380.86, "text": "还有谁比相国你"}, {"start": 1380.86, "end": 1382.86, "text": "更配成天即位"}, {"start": 1382.86, "end": 1384.86, "text": "做皇帝呀"}, {"start": 1384.86, "end": 1388.9, "text": "李兄弟的这份心"}, {"start": 1388.9, "end": 1389.9, "text": "咱家是"}, {"start": 1389.9, "end": 1391.9, "text": "极为感动"}, {"start": 1391.9, "end": 1392.9, "text": "只是"}, {"start": 1392.9, "end": 1398.19, "text": "各路诸侯"}, {"start": 1398.19, "end": 1399.19, "text": "如是听说"}, {"start": 1399.19, "end": 1402.86, "text": "咱家是做了皇帝"}, {"start": 1403.86, "end": 1404.86, "text": "他们会不会"}, {"start": 1404.86, "end": 1405.86, "text": "记恨咱家"}, {"start": 1405.86, "end": 1407.86, "text": "会不会起兵闹事"}, {"start": 1407.86, "end": 1408.86, "text": "还有"}, {"start": 1408.86, "end": 1411.86, "text": "满朝百官会不会"}, {"start": 1411.86, "end": 1413.86, "text": "认咱们是天子"}, {"start": 1414.86, "end": 1415.86, "text": "门"}, {"start": 1415.86, "end": 1416.86, "text": "相国"}, {"start": 1416.86, "end": 1419.65, "text": "相国你多虑吧"}, {"start": 1420.65, "end": 1421.65, "text": "自古以来"}, {"start": 1421.65, "end": 1422.65, "text": "都是为帝者"}, {"start": 1422.65, "end": 1424.65, "text": "先坐上龙椅之后"}, {"start": 1424.65, "end": 1425.65, "text": "再迫使那些"}, {"start": 1425.65, "end": 1427.65, "text": "不遵奉者"}, {"start": 1427.65, "end": 1428.65, "text": "那些不遵奉者"}, {"start": 1428.65, "end": 1429.65, "text": "为遵奉"}, {"start": 1429.65, "end": 1430.65, "text": "不服气者"}, {"start": 1430.65, "end": 1431.65, "text": "为服气"}, {"start": 1432.65, "end": 1433.65, "text": "如果"}, {"start": 1433.65, "end": 1435.65, "text": "相国想慎重从事的话"}, {"start": 1436.65, "end": 1438.65, "text": "也可以分两步走"}, {"start": 1439.65, "end": 1440.65, "text": "这第一"}, {"start": 1440.65, "end": 1442.65, "text": "先遵奉为上奉"}, {"start": 1443.65, "end": 1445.65, "text": "进出用天子一仗"}, {"start": 1446.65, "end": 1447.65, "text": "第二"}, {"start": 1447.65, "end": 1448.65, "text": "斥令以圣旨办法"}, {"start": 1449.65, "end": 1450.65, "text": "这样一来"}, {"start": 1450.65, "end": 1451.65, "text": "也可以看看"}, {"start": 1451.65, "end": 1452.65, "text": "各路诸侯"}, {"start": 1452.65, "end": 1454.65, "text": "与朝中百官"}, {"start": 1454.65, "end": 1455.65, "text": "作何反应"}, {"start": 1455.65, "end": 1456.65, "text": "之后"}, {"start": 1456.65, "end": 1458.65, "text": "再更进一步"}, {"start": 1458.65, "end": 1461.65, "text": "及皇帝大位"}, {"start": 1462.65, "end": 1463.65, "text": "这"}, {"start": 1463.65, "end": 1465.65, "text": "上父是什么意思"}, {"start": 1468.65, "end": 1469.65, "text": "就如同"}, {"start": 1469.65, "end": 1472.65, "text": "当今天子的爹"}, {"start": 1476.65, "end": 1478.65, "text": "那李兄弟的意思是说"}, {"start": 1478.65, "end": 1480.65, "text": "让咱家先坐一下"}, {"start": 1480.65, "end": 1481.65, "text": "太上皇"}, {"start": 1481.65, "end": 1483.65, "text": "然后再坐皇上"}, {"start": 1483.65, "end": 1484.65, "text": "是吧"}, {"start": 1485.65, "end": 1486.65, "text": "正是"}, {"start": 1488.65, "end": 1489.65, "text": "好"}, {"start": 1489.65, "end": 1490.65, "text": "好啊"}, {"start": 1490.65, "end": 1492.65, "text": "这个名目好啊"}, {"start": 1497.65, "end": 1498.65, "text": "李兄弟"}, {"start": 1499.65, "end": 1500.65, "text": "看来"}, {"start": 1500.65, "end": 1503.65, "text": "你真是个好兄弟"}, {"start": 1504.65, "end": 1505.65, "text": "那就有劳你"}, {"start": 1505.65, "end": 1507.65, "text": "来传达一下咱"}, {"start": 1508.65, "end": 1509.65, "text": "不"}, {"start": 1509.65, "end": 1510.65, "text": "要传一下"}, {"start": 1510.65, "end": 1512.65, "text": "上父的旨意"}, {"start": 1512.65, "end": 1513.65, "text": "你说"}, {"start": 1513.65, "end": 1515.65, "text": "咱家明日正午"}, {"start": 1515.65, "end": 1518.65, "text": "要宴请各位百官"}, {"start": 1518.65, "end": 1520.65, "text": "并给他们加官进爵"}, {"start": 1521.65, "end": 1522.65, "text": "请各位百官"}, {"start": 1522.65, "end": 1524.65, "text": "统统赴宴"}, {"start": 1524.65, "end": 1526.65, "text": "臣遵旨"}, {"start": 1528.65, "end": 1529.65, "text": "还有"}, {"start": 1529.65, "end": 1531.65, "text": "李如廷旨"}, {"start": 1531.65, "end": 1532.65, "text": "臣在"}, {"start": 1533.65, "end": 1534.65, "text": "咱家即刻拜你"}, {"start": 1534.65, "end": 1537.65, "text": "为朝廷大司空"}, {"start": 1537.65, "end": 1538.65, "text": "为举三功"}, {"start": 1539.65, "end": 1541.65, "text": "臣谢恩"}, {"start": 1544.65, "end": 1565.68, "text": "杨大人"}, {"start": 1565.68, "end": 1566.68, "text": "王大人"}, {"start": 1566.68, "end": 1567.68, "text": "王大人"}, {"start": 1567.68, "end": 1568.68, "text": "刘大人"}, {"start": 1568.68, "end": 1569.68, "text": "来了"}, {"start": 1569.68, "end": 1570.68, "text": "王大人"}, {"start": 1570.68, "end": 1571.68, "text": "李将军"}, {"start": 1571.68, "end": 1572.68, "text": "请"}, {"start": 1572.68, "end": 1575.54, "text": "李将军"}, {"start": 1575.54, "end": 1576.54, "text": "请"}, {"start": 1576.54, "end": 1578.91, "text": "李将军"}, {"start": 1578.91, "end": 1582.86, "text": "真是好地方"}, {"start": 1582.86, "end": 1583.86, "text": "好地方"}, {"start": 1583.86, "end": 1584.86, "text": "真是"}, {"start": 1584.86, "end": 1585.86, "text": "你看看"}, {"start": 1585.86, "end": 1586.86, "text": "是啊"}, {"start": 1586.86, "end": 1587.86, "text": "你看看"}, {"start": 1587.86, "end": 1588.86, "text": "这情况啊"}, {"start": 1588.86, "end": 1589.86, "text": "真是"}, {"start": 1592.86, "end": 1593.86, "text": "真是"}, {"start": 1593.86, "end": 1594.86, "text": "如意先驾"}, {"start": 1594.86, "end": 1596.86, "text": "这门宫巧相不错"}, {"start": 1599.86, "end": 1600.86, "text": "好啊"}, {"start": 1600.86, "end": 1601.86, "text": "好气派"}, {"start": 1602.86, "end": 1604.86, "text": "你看这门宫啊"}, {"start": 1604.86, "end": 1606.86, "text": "真是不错"}, {"start": 1610.86, "end": 1611.86, "text": "看看"}, {"start": 1611.86, "end": 1613.86, "text": "董相伯这片私宅"}, {"start": 1614.86, "end": 1615.86, "text": "一大片宫廷"}, {"start": 1615.86, "end": 1617.86, "text": "都要壮丽十倍"}, {"start": 1618.86, "end": 1619.86, "text": "董相他"}, {"start": 1619.86, "end": 1621.86, "text": "为了造这座梅雾"}, {"start": 1621.86, "end": 1623.86, "text": "调集了三十万民族"}, {"start": 1623.86, "end": 1625.86, "text": "耗尽了朝廷库人"}, {"start": 1626.86, "end": 1627.86, "text": "他还把宫女和嫔妃"}, {"start": 1627.86, "end": 1628.86, "text": "都调到这里"}, {"start": 1628.86, "end": 1630.86, "text": "供他迎乐"}, {"start": 1630.86, "end": 1631.86, "text": "此外"}, {"start": 1631.86, "end": 1632.86, "text": "他还在梅雾"}, {"start": 1632.86, "end": 1633.86, "text": "囤积了足够"}, {"start": 1633.86, "end": 1635.86, "text": "食用二十年的粮谷"}, {"start": 1635.86, "end": 1637.86, "text": "助生有八万金币"}, {"start": 1637.86, "end": 1638.86, "text": "王大人"}, {"start": 1638.86, "end": 1639.86, "text": "这梅雾"}, {"start": 1639.86, "end": 1642.86, "text": "虽说是风花雪月之地"}, {"start": 1642.86, "end": 1644.86, "text": "可以是天下第一重镇"}, {"start": 1644.86, "end": 1645.86, "text": "是啊"}, {"start": 1647.86, "end": 1649.86, "text": "看来董相伯"}, {"start": 1649.86, "end": 1653.86, "text": "是要在这安享人生极乐"}, {"start": 1653.86, "end": 1655.86, "text": "他董贼不死"}, {"start": 1655.86, "end": 1656.86, "text": "必胜"}, {"start": 1656.86, "end": 1657.86, "text": "必胜"}, {"start": 1657.86, "end": 1658.86, "text": "大汗必亡啊"}, {"start": 1659.86, "end": 1660.86, "text": "必胜"}, {"start": 1660.86, "end": 1661.86, "text": "请请"}, {"start": 1661.86, "end": 1662.86, "text": "请"}, {"start": 1662.86, "end": 1663.86, "text": "各位爱卿"}, {"start": 1663.86, "end": 1666.86, "text": "袁绍的十八路贼军"}, {"start": 1666.86, "end": 1669.86, "text": "被咱家是通通打垮了"}, {"start": 1669.86, "end": 1671.86, "text": "贼将孙坚"}, {"start": 1671.86, "end": 1675.86, "text": "也被咱西粮将士给斩杀了"}, {"start": 1675.86, "end": 1677.86, "text": "各州的刺史太守们"}, {"start": 1677.86, "end": 1680.86, "text": "纷纷上表称贺"}, {"start": 1680.86, "end": 1684.86, "text": "中原大地是一片平安"}, {"start": 1684.86, "end": 1687.53, "text": "恭喜相国"}, {"start": 1687.53, "end": 1688.53, "text": "恭喜尚父"}, {"start": 1688.53, "end": 1690.53, "text": "恭喜相国"}, {"start": 1690.53, "end": 1692.53, "text": "恭喜尚父"}, {"start": 1694.53, "end": 1696.53, "text": "尚父平叛护国"}, {"start": 1696.53, "end": 1698.53, "text": "臣氏古机罕见"}, {"start": 1698.53, "end": 1700.53, "text": "堪与日月同辉"}, {"start": 1700.53, "end": 1704.53, "text": "臣张温敬送尚父万寿无疆"}, {"start": 1704.53, "end": 1706.53, "text": "哪里哪里啊"}, {"start": 1706.53, "end": 1708.53, "text": "寡人只是和各位爱卿"}, {"start": 1708.53, "end": 1710.53, "text": "同福同喜"}, {"start": 1710.53, "end": 1711.53, "text": "寡人"}, {"start": 1713.53, "end": 1715.53, "text": "尚父为国建此书勋"}, {"start": 1715.53, "end": 1717.53, "text": "足见天意所归"}, {"start": 1717.53, "end": 1718.53, "text": "大势所趋"}, {"start": 1718.53, "end": 1720.53, "text": "臣请求尚父"}, {"start": 1720.53, "end": 1722.53, "text": "承天意顺民心"}, {"start": 1722.53, "end": 1725.53, "text": "改缘开国及天子位"}, {"start": 1725.53, "end": 1726.53, "text": "张爱卿"}, {"start": 1726.53, "end": 1731.53, "text": "你觉得咱家做皇上合适吗"}, {"start": 1731.53, "end": 1733.53, "text": "合适合适啊"}, {"start": 1733.53, "end": 1735.53, "text": "如果尚父不肯做皇上"}, {"start": 1735.53, "end": 1737.53, "text": "反而是上武天意"}, {"start": 1737.53, "end": 1738.53, "text": "下富民心"}, {"start": 1738.53, "end": 1740.53, "text": "那就不合适了"}, {"start": 1740.53, "end": 1741.53, "text": "臣请求尚父"}, {"start": 1741.53, "end": 1743.53, "text": "为国为民着想"}, {"start": 1743.53, "end": 1745.53, "text": "及大魏创新朝啊"}, {"start": 1748.53, "end": 1749.53, "text": "张爱卿"}, {"start": 1749.53, "end": 1751.53, "text": "你对咱家可真是"}, {"start": 1751.53, "end": 1754.53, "text": "一片忠肝义胆哪"}, {"start": 1755.53, "end": 1756.53, "text": "那么这个事"}, {"start": 1756.53, "end": 1761.53, "text": "各位爱卿是怎么看的"}, {"start": 1787.75, "end": 1792.75, "text": "张爱卿劝咱家做皇帝"}, {"start": 1792.75, "end": 1796.75, "text": "真可谓是一片忠肝义胆"}, {"start": 1796.75, "end": 1798.75, "text": "忠肝义胆哪"}, {"start": 1798.75, "end": 1800.75, "text": "臣只是不必容辱"}, {"start": 1800.75, "end": 1802.75, "text": "直言尽忠而已啊"}, {"start": 1802.75, "end": 1810.34, "text": "可不知道你这副忠肝义胆"}, {"start": 1810.34, "end": 1814.34, "text": "取出来下酒如何呀"}, {"start": 1815.34, "end": 1820.89, "text": "拿下"}, {"start": 1820.89, "end": 1821.89, "text": "诺"}, {"start": 1821.89, "end": 1822.89, "text": "尚父"}, {"start": 1822.89, "end": 1824.89, "text": "臣无罪啊"}, {"start": 1824.89, "end": 1825.89, "text": "尚父"}, {"start": 1825.89, "end": 1827.89, "text": "臣忠心肝肝啊尚父"}, {"start": 1827.89, "end": 1828.89, "text": "尚父"}, {"start": 1828.89, "end": 1830.89, "text": "臣无罪啊"}, {"start": 1830.89, "end": 1831.89, "text": "尚父"}, {"start": 1831.89, "end": 1832.89, "text": "这位爱卿"}, {"start": 1832.89, "end": 1833.89, "text": "尚父"}, {"start": 1833.89, "end": 1837.36, "text": "请不要惊慌"}, {"start": 1837.36, "end": 1839.36, "text": "张温这死"}, {"start": 1839.36, "end": 1842.36, "text": "表面上劝咱家做皇帝"}, {"start": 1842.36, "end": 1847.36, "text": "可暗地里却勾结袁氏兄弟"}, {"start": 1847.36, "end": 1849.36, "text": "想取咱手机"}, {"start": 1850.36, "end": 1851.36, "text": "尚父"}, {"start": 1851.36, "end": 1854.36, "text": "刚刚袁氏有密信来"}, {"start": 1854.36, "end": 1856.36, "text": "被咱邵记截住"}, {"start": 1859.36, "end": 1861.36, "text": "不知道在座的宗爱卿当中"}, {"start": 1861.36, "end": 1863.36, "text": "还有谁像张温那样"}, {"start": 1863.36, "end": 1865.36, "text": "表面上忠顺"}, {"start": 1865.36, "end": 1868.36, "text": "背地里却勾结叛逆"}, {"start": 1868.36, "end": 1870.36, "text": "图谋取咱手机"}, {"start": 1870.36, "end": 1872.36, "text": "有没有啊"}, {"start": 1873.36, "end": 1874.36, "text": "有没有"}, {"start": 1875.36, "end": 1877.36, "text": "有没有"}, {"start": 1880.14, "end": 1882.14, "text": "要是有的话"}, {"start": 1882.14, "end": 1889.14, "text": "咱家可是一眼就能看出来啊"}, {"start": 1889.14, "end": 1901.31, "text": "上酒"}, {"start": 1901.31, "end": 1934.62, "text": "按照咱凉州将士的规矩"}, {"start": 1934.62, "end": 1936.62, "text": "对待那些叛逆者"}, {"start": 1936.62, "end": 1938.62, "text": "要削其手"}, {"start": 1939.62, "end": 1940.62, "text": "擒其皮"}, {"start": 1940.62, "end": 1941.62, "text": "食其肉"}, {"start": 1941.62, "end": 1943.62, "text": "饮其血"}, {"start": 1944.62, "end": 1947.62, "text": "列位爱卿都是高雅之事"}, {"start": 1947.62, "end": 1950.62, "text": "这食肉擒皮之事吗"}, {"start": 1950.62, "end": 1953.62, "text": "咱家就提列位免了"}, {"start": 1953.62, "end": 1958.62, "text": "那么各位只要是请稍用此酒"}, {"start": 1958.62, "end": 1961.62, "text": "便可表明心意"}, {"start": 1961.62, "end": 1962.62, "text": "请"}, {"start": 1962.62, "end": 1979.34, "text": "真是甜美无比"}, {"start": 1979.34, "end": 1982.34, "text": "回味无穷啊"}, {"start": 1982.34, "end": 1983.34, "text": "好"}, {"start": 1983.34, "end": 1985.34, "text": "好酒啊"}, {"start": 1987.34, "end": 1988.34, "text": "你们"}, {"start": 1988.34, "end": 1993.38, "text": "请啊"}, {"start": 2013.28, "end": 2015.28, "text": "王司徒大人"}, {"start": 2015.28, "end": 2018.28, "text": "这酒的味道如何呀"}, {"start": 2018.28, "end": 2019.28, "text": "好"}, {"start": 2019.28, "end": 2025.18, "text": "真好吗"}, {"start": 2025.18, "end": 2026.18, "text": "真好"}, {"start": 2026.18, "end": 2027.18, "text": "算不算"}, {"start": 2030.87, "end": 2033.15, "text": "来啊"}, {"start": 2033.15, "end": 2040.1, "text": "让司徒大人再饮三杯"}, {"start": 2040.1, "end": 2042.1, "text": "一醉方休"}, {"start": 2042.1, "end": 2043.1, "text": "请"}, {"start": 2043.1, "end": 2044.1, "text": "主公回来了"}, {"start": 2076.97, "end": 2077.97, "text": "主公"}, {"start": 2077.97, "end": 2078.97, "text": "这是怎么了"}, {"start": 2079.97, "end": 2080.97, "text": "小姐"}, {"start": 2080.97, "end": 2081.97, "text": "貂蝉小姐"}, {"start": 2083.97, "end": 2084.97, "text": "义父"}, {"start": 2084.97, "end": 2085.97, "text": "平手"}, {"start": 2086.97, "end": 2087.97, "text": "我不是"}, {"start": 2087.97, "end": 2091.46, "text": "平手"}, {"start": 2092.46, "end": 2094.46, "text": "我不是人"}, {"start": 2095.46, "end": 2097.46, "text": "亲手"}, {"start": 2097.46, "end": 2098.46, "text": "义父小心"}, {"start": 2100.46, "end": 2101.46, "text": "我不是人"}, {"start": 2102.46, "end": 2104.46, "text": "我不是人啊"}, {"start": 2111.46, "end": 2112.46, "text": "我与亲手"}, {"start": 2113.46, "end": 2115.46, "text": "我与亲手绝不"}, {"start": 2116.46, "end": 2118.46, "text": "绝不两立"}, {"start": 2120.46, "end": 2124.5, "text": "义父"}, {"start": 2125.5, "end": 2128.5, "text": "我生不能杀你"}, {"start": 2128.5, "end": 2132.5, "text": "我死也要向你索命"}, {"start": 2133.5, "end": 2134.5, "text": "义父"}, {"start": 2134.5, "end": 2137.5, "text": "是在诅咒董卓那个老贼吗"}, {"start": 2137.5, "end": 2140.5, "text": "他不但是个亲手"}, {"start": 2140.5, "end": 2142.5, "text": "他把公卿搭着"}, {"start": 2142.5, "end": 2147.5, "text": "把我也逼成亲手了"}, {"start": 2147.5, "end": 2150.88, "text": "貂蝉啊"}, {"start": 2150.88, "end": 2154.88, "text": "我王云本是书香门第"}, {"start": 2154.88, "end": 2156.88, "text": "三代为臣"}, {"start": 2156.88, "end": 2158.88, "text": "忠义一世"}, {"start": 2158.88, "end": 2160.88, "text": "清白平胜"}, {"start": 2161.88, "end": 2162.88, "text": "可是今天"}, {"start": 2163.88, "end": 2166.16, "text": "今天"}, {"start": 2166.16, "end": 2171.66, "text": "今天我却满嘴血腥"}, {"start": 2172.66, "end": 2177.26, "text": "身为臣子"}, {"start": 2178.26, "end": 2180.26, "text": "受秦寿之辱"}, {"start": 2181.26, "end": 2183.26, "text": "却不能反抗"}, {"start": 2183.26, "end": 2185.26, "text": "是天子蒙尘"}, {"start": 2186.26, "end": 2191.02, "text": "我却苟且投生"}, {"start": 2192.02, "end": 2195.02, "text": "我王云连亲手都不如我"}, {"start": 2198.02, "end": 2202.02, "text": "我生不如死"}, {"start": 2203.02, "end": 2204.02, "text": "义父"}, {"start": 2204.02, "end": 2206.02, "text": "你担当着新国新邦的大业"}, {"start": 2206.02, "end": 2208.02, "text": "万万不可有亲生的念头啊"}, {"start": 2208.02, "end": 2210.02, "text": "你看天子"}, {"start": 2210.02, "end": 2212.26, "text": "他小小年纪"}, {"start": 2212.26, "end": 2214.26, "text": "受了那么多的苦难"}, {"start": 2214.26, "end": 2215.26, "text": "容辱不禁"}, {"start": 2216.26, "end": 2217.26, "text": "如果你撇下他"}, {"start": 2217.26, "end": 2218.26, "text": "一走了之"}, {"start": 2218.26, "end": 2220.26, "text": "你在九泉之下"}, {"start": 2220.26, "end": 2222.26, "text": "如何面对先帝啊"}, {"start": 2222.26, "end": 2224.26, "text": "先帝啊"}, {"start": 2224.26, "end": 2234.2, "text": "先帝啊"}, {"start": 2236.51, "end": 2239.51, "text": "老臣向你请罪"}, {"start": 2240.51, "end": 2241.51, "text": "老臣向你"}, {"start": 2241.51, "end": 2242.51, "text": "义父"}, {"start": 2242.51, "end": 2243.51, "text": "主公"}, {"start": 2243.51, "end": 2244.51, "text": "主公这是怎么了"}, {"start": 2245.51, "end": 2246.51, "text": "无妨"}, {"start": 2250.43, "end": 2251.43, "text": "主公"}, {"start": 2251.43, "end": 2252.43, "text": "何事"}, {"start": 2252.43, "end": 2257.15, "text": "吕布前来拜见"}, {"start": 2259.15, "end": 2260.15, "text": "定是董卓"}, {"start": 2267.78, "end": 2269.78, "text": "派他前来拿我了"}, {"start": 2270.78, "end": 2271.78, "text": "扶我起来"}, {"start": 2272.78, "end": 2275.25, "text": "更衣"}, {"start": 2276.25, "end": 2282.06, "text": "我要堂堂正正的"}, {"start": 2283.06, "end": 2284.06, "text": "赴死"}, {"start": 2285.06, "end": 2286.06, "text": "不"}, {"start": 2286.06, "end": 2287.06, "text": "主公"}, {"start": 2287.06, "end": 2289.06, "text": "吕布是来送礼的"}, {"start": 2291.06, "end": 2292.06, "text": "送礼"}, {"start": 2293.06, "end": 2294.06, "text": "是给弟弟"}, {"start": 2294.06, "end": 2295.06, "text": "送礼"}, {"start": 2296.06, "end": 2298.06, "text": "是给貂蝉小姐"}, {"start": 2298.06, "end": 2299.06, "text": "送生日礼物的"}, {"start": 2306.36, "end": 2307.36, "text": "那就大堂"}, {"start": 2307.36, "end": 2308.36, "text": "拜茶"}, {"start": 2310.36, "end": 2311.36, "text": "遵命"}, {"start": 2311.36, "end": 2322.47, "text": "今日"}, {"start": 2322.47, "end": 2324.47, "text": "是你的生日吗"}, {"start": 2324.47, "end": 2327.2, "text": "是"}, {"start": 2327.2, "end": 2328.2, "text": "今天"}, {"start": 2328.2, "end": 2330.2, "text": "是奴婢的生日"}, {"start": 2332.2, "end": 2333.2, "text": "这事"}, {"start": 2333.2, "end": 2334.2, "text": "连我都忘了"}, {"start": 2336.2, "end": 2338.2, "text": "他吕布怎么会知道"}, {"start": 2338.2, "end": 2345.67, "text": "是你告诉他的"}, {"start": 2346.67, "end": 2347.67, "text": "说"}, {"start": 2347.67, "end": 2351.05, "text": "你们有何苟且之事"}, {"start": 2353.05, "end": 2354.05, "text": "义父"}, {"start": 2354.05, "end": 2373.99, "text": "吕将军"}, {"start": 2374.99, "end": 2377.99, "text": "我家主公请将军稍候"}, {"start": 2377.99, "end": 2378.99, "text": "他这就出来了"}, {"start": 2378.99, "end": 2382.65, "text": "貂蝉小姐在吗"}, {"start": 2382.65, "end": 2383.65, "text": "在"}, {"start": 2383.65, "end": 2384.65, "text": "在"}, {"start": 2384.65, "end": 2385.65, "text": "来人哪"}, {"start": 2385.65, "end": 2387.65, "text": "给将军拜茶"}, {"start": 2387.65, "end": 2388.65, "text": "义父恕罪"}, {"start": 2389.65, "end": 2390.65, "text": "奴婢"}, {"start": 2390.65, "end": 2391.65, "text": "奴婢与吕将军"}, {"start": 2391.65, "end": 2393.65, "text": "绝无苟且之事"}, {"start": 2394.65, "end": 2395.65, "text": "那"}, {"start": 2396.65, "end": 2398.65, "text": "他为何如此待你"}, {"start": 2400.65, "end": 2401.65, "text": "便义父"}, {"start": 2402.65, "end": 2403.65, "text": "您没在家的时候"}, {"start": 2404.65, "end": 2405.65, "text": "吕将军"}, {"start": 2405.65, "end": 2407.65, "text": "已经来过好几次了"}, {"start": 2407.65, "end": 2410.28, "text": "什么"}, {"start": 2412.28, "end": 2414.28, "text": "我怎么一点都不知道"}, {"start": 2415.28, "end": 2416.28, "text": "他为何而来"}, {"start": 2418.56, "end": 2419.56, "text": "上次"}, {"start": 2419.56, "end": 2420.56, "text": "在千都的路上"}, {"start": 2420.56, "end": 2421.56, "text": "吕将军"}, {"start": 2421.56, "end": 2423.56, "text": "救了奴婢之后"}, {"start": 2423.56, "end": 2425.56, "text": "就经常脱固而来"}, {"start": 2426.56, "end": 2427.56, "text": "每次"}, {"start": 2427.56, "end": 2428.56, "text": "都带些米面"}, {"start": 2428.56, "end": 2429.56, "text": "酒水"}, {"start": 2430.56, "end": 2431.56, "text": "和琳珞绸缎"}, {"start": 2434.56, "end": 2436.56, "text": "我说最近家里"}, {"start": 2436.56, "end": 2437.56, "text": "不缺吃穿"}, {"start": 2438.56, "end": 2440.56, "text": "原来是他送的"}, {"start": 2443.56, "end": 2445.56, "text": "百官眼眼待闭"}, {"start": 2446.56, "end": 2447.56, "text": "他吕布"}, {"start": 2447.56, "end": 2449.56, "text": "为何独独送我呢"}, {"start": 2457.56, "end": 2458.56, "text": "我明白了"}, {"start": 2459.56, "end": 2460.56, "text": "原来你"}, {"start": 2460.56, "end": 2475.48, "text": "女儿"}, {"start": 2475.48, "end": 2477.48, "text": "请受老夫一拜"}, {"start": 2477.48, "end": 2480.5, "text": "你这是干什么呀"}, {"start": 2480.5, "end": 2481.5, "text": "万万使不得"}, {"start": 2481.5, "end": 2482.5, "text": "请起请起"}, {"start": 2483.5, "end": 2484.5, "text": "女儿"}, {"start": 2484.5, "end": 2486.5, "text": "你要不答应我一件事"}, {"start": 2486.5, "end": 2489.5, "text": "老夫就常归不起"}, {"start": 2489.5, "end": 2490.5, "text": "义父"}, {"start": 2490.5, "end": 2491.5, "text": "我答应"}, {"start": 2491.5, "end": 2492.5, "text": "什么事情"}, {"start": 2492.5, "end": 2493.5, "text": "我全都答应"}, {"start": 2493.5, "end": 2494.5, "text": "粉身碎骨"}, {"start": 2494.5, "end": 2495.5, "text": "绝不退辞"}, {"start": 2496.5, "end": 2497.5, "text": "求女儿"}, {"start": 2497.5, "end": 2499.5, "text": "救救大汉"}, {"start": 2499.5, "end": 2502.5, "text": "救救天下苍生吧"}, {"start": 2502.5, "end": 2503.5, "text": "我一个弱女子"}, {"start": 2503.5, "end": 2505.5, "text": "如何救得了大汉"}, {"start": 2505.5, "end": 2507.5, "text": "和天下苍生啊"}, {"start": 2508.5, "end": 2509.5, "text": "女儿"}, {"start": 2509.5, "end": 2511.5, "text": "你只要答应一个救"}, {"start": 2511.5, "end": 2512.5, "text": "就成了"}, {"start": 2513.5, "end": 2515.9, "text": "要不然老夫"}, {"start": 2515.9, "end": 2517.9, "text": "宁肯跪死"}, {"start": 2517.9, "end": 2518.9, "text": "也绝不起身"}, {"start": 2519.9, "end": 2520.9, "text": "我答应"}, {"start": 2520.9, "end": 2521.9, "text": "我答应"}, {"start": 2521.9, "end": 2522.9, "text": "义父"}, {"start": 2522.9, "end": 2523.9, "text": "快快请起"}, {"start": 2530.22, "end": 2532.47, "text": "女儿"}, {"start": 2533.47, "end": 2534.47, "text": "老夫"}, {"start": 2534.47, "end": 2538.06, "text": "想让你"}, {"start": 2539.06, "end": 2541.06, "text": "喜欢上吕布"}, {"start": 2542.06, "end": 2543.06, "text": "成了"}, {"start": 2543.06, "end": 2545.79, "text": "成不成啊"}, {"start": 2548.79, "end": 2549.79, "text": "你说呀"}, {"start": 2549.79, "end": 2550.79, "text": "成不成啊"}, {"start": 2550.79, "end": 2551.79, "text": "配不上吕将军"}, {"start": 2563.34, "end": 2564.34, "text": "我糊涂了"}, {"start": 2564.34, "end": 2566.34, "text": "我老糊涂了"}, {"start": 2568.34, "end": 2569.34, "text": "好"}, {"start": 2569.34, "end": 2570.34, "text": "好真是"}, {"start": 2570.34, "end": 2572.34, "text": "天作之合呀"}, {"start": 2573.34, "end": 2574.34, "text": "可是"}, {"start": 2575.34, "end": 2576.34, "text": "这跟救大汉"}, {"start": 2576.34, "end": 2578.34, "text": "有什么关系呢"}, {"start": 2579.34, "end": 2580.34, "text": "这个"}, {"start": 2582.34, "end": 2583.34, "text": "老夫"}, {"start": 2583.34, "end": 2585.34, "text": "日后会和你说的"}, {"start": 2586.34, "end": 2587.34, "text": "这会"}, {"start": 2587.34, "end": 2588.34, "text": "这会"}, {"start": 2589.34, "end": 2590.34, "text": "我得去会客"}, {"start": 2592.34, "end": 2593.34, "text": "好"}, {"start": 2593.34, "end": 2594.34, "text": "好"}]