[{"start": 9.26, "end": 21.67, "text": "袁绍不是拒捕发兵吗"}, {"start": 22.67, "end": 24.67, "text": "还打了你二十军场"}, {"start": 24.67, "end": 28.95, "text": "不错 确有此事"}, {"start": 28.95, "end": 31.95, "text": "那你怎么又到这里来了"}, {"start": 31.95, "end": 35.95, "text": "宣德 说来你也许不信"}, {"start": 36.95, "end": 39.95, "text": "我那二十军棍刚刚打完"}, {"start": 39.95, "end": 42.95, "text": "不曾想主公那宝贝儿子"}, {"start": 42.95, "end": 44.95, "text": "忽然哭出声来了"}, {"start": 44.95, "end": 45.95, "text": "醒了"}, {"start": 45.95, "end": 47.95, "text": "这下可把我们家主公"}, {"start": 47.95, "end": 48.95, "text": "给乐坏了"}, {"start": 48.95, "end": 50.95, "text": "他抱起儿子跑出帐来"}, {"start": 50.95, "end": 52.95, "text": "连连向我道歉"}, {"start": 52.95, "end": 55.95, "text": "还赏了我二百两金子"}, {"start": 55.95, "end": 57.95, "text": "一丈十两"}, {"start": 57.95, "end": 69.32, "text": "值啊"}, {"start": 69.32, "end": 83.08, "text": "宣德 不瞒你说"}, {"start": 83.08, "end": 86.08, "text": "我家主公就是这样的人"}, {"start": 86.08, "end": 88.08, "text": "小儿病情一旦好转"}, {"start": 88.08, "end": 91.08, "text": "他也变得心明眼亮起来了"}, {"start": 91.08, "end": 93.08, "text": "立刻接受了我的建议"}, {"start": 93.08, "end": 96.08, "text": "令那严良亲统十万大军"}, {"start": 96.08, "end": 97.08, "text": "攻伐徐昌"}, {"start": 97.08, "end": 100.08, "text": "我呢 领兵五千先行一步"}, {"start": 100.08, "end": 104.08, "text": "特地来此打探徐州战局"}, {"start": 104.08, "end": 115.13, "text": "天意 天意助曹不助刘啊"}, {"start": 115.13, "end": 116.13, "text": "怎么"}, {"start": 116.13, "end": 124.43, "text": "你们不必攻打徐昌了"}, {"start": 124.43, "end": 129.64, "text": "徐州已经失险了"}, {"start": 129.64, "end": 133.64, "text": "曹操把大军调回徐昌不防了"}, {"start": 133.64, "end": 140.33, "text": "刘备 你说什么"}, {"start": 140.33, "end": 145.33, "text": "难道你的兵马全都丧失了"}, {"start": 145.33, "end": 147.33, "text": "那可足足有八万人啊"}, {"start": 147.33, "end": 153.8, "text": "兄弟离散兵马丧失"}, {"start": 153.8, "end": 155.8, "text": "实话跟你说"}, {"start": 155.8, "end": 162.3, "text": "我连配件都失落"}, {"start": 162.3, "end": 175.18, "text": "这个曹孟德"}, {"start": 175.18, "end": 178.18, "text": "居然有这么厉害"}, {"start": 178.18, "end": 188.48, "text": "我刘备只要一心上存"}, {"start": 188.48, "end": 191.48, "text": "就事与曹操为敌"}, {"start": 191.48, "end": 203.51, "text": "好 你乃当世真英雄"}, {"start": 203.51, "end": 212.18, "text": "不知你眼下有何打算"}, {"start": 212.18, "end": 214.18, "text": "欲往何处啊"}, {"start": 214.18, "end": 221.37, "text": "宣德 倒有个主意"}, {"start": 221.37, "end": 228.43, "text": "莫不如你随我"}, {"start": 228.43, "end": 231.43, "text": "逃奔我家主公袁绍"}, {"start": 231.43, "end": 234.43, "text": "以图日后再举 意下如何"}, {"start": 234.43, "end": 241.94, "text": "我还要继续继任李下吧"}, {"start": 241.94, "end": 250.58, "text": "宣德 你不妨平心静气地想一想"}, {"start": 250.58, "end": 254.58, "text": "当今天下虽然是群雄纷争"}, {"start": 254.58, "end": 258.58, "text": "但真正能够剿灭曹贼"}, {"start": 258.58, "end": 260.58, "text": "并匡扶汉氏者"}, {"start": 260.58, "end": 264.58, "text": "眼下除了我家主公袁本初之外"}, {"start": 264.58, "end": 266.58, "text": "多谢先生指教"}, {"start": 266.58, "end": 284.75, "text": "在下愿投袁弓"}, {"start": 284.75, "end": 290.89, "text": "好 好"}, {"start": 290.89, "end": 291.89, "text": "徐先生"}, {"start": 291.89, "end": 292.89, "text": "好"}, {"start": 292.89, "end": 306.24, "text": "徐先生"}, {"start": 306.24, "end": 307.24, "text": "主公则至刘备前来"}, {"start": 307.24, "end": 309.24, "text": "立刻出营十里相迎"}, {"start": 309.24, "end": 310.24, "text": "主公何在"}, {"start": 310.24, "end": 311.24, "text": "就在前面"}, {"start": 311.24, "end": 318.89, "text": "皇叔啊 我曾经跟你说过"}, {"start": 318.89, "end": 322.89, "text": "我家这个主公啊 庸弱时啊"}, {"start": 322.89, "end": 325.89, "text": "庸弱得确实让人惊讶"}, {"start": 325.89, "end": 327.89, "text": "可是一旦盛名起来"}, {"start": 327.89, "end": 329.89, "text": "那也盛名地让人惊讶啊"}, {"start": 329.89, "end": 331.89, "text": "驾 驾"}, {"start": 331.89, "end": 353.56, "text": "刘皇叔到了"}, {"start": 353.56, "end": 358.57, "text": "拜君之将刘备"}, {"start": 358.57, "end": 360.57, "text": "拜见袁大将军"}, {"start": 360.57, "end": 363.85, "text": "刘皇叔快快请起"}, {"start": 364.85, "end": 370.83, "text": "你啊 是个仁义之君"}, {"start": 370.83, "end": 372.83, "text": "贤民满天下"}, {"start": 372.83, "end": 376.83, "text": "我早就想与你共同大业了"}, {"start": 376.83, "end": 383.69, "text": "今日相逢 袁某深感喜"}, {"start": 383.69, "end": 387.69, "text": "刘备 只有一个心愿"}, {"start": 387.69, "end": 390.69, "text": "助袁弓剿灭曹贼"}, {"start": 390.69, "end": 391.69, "text": "匡扶大汉"}, {"start": 391.69, "end": 394.69, "text": "这是你我共同的心愿"}, {"start": 394.69, "end": 398.5, "text": "妾自我回应"}, {"start": 398.5, "end": 401.5, "text": "容我为你白酒洗尘"}, {"start": 401.5, "end": 404.5, "text": "然后共上灭曹大稚 走"}, {"start": 404.5, "end": 405.5, "text": "皇叔请"}, {"start": 414.6, "end": 415.6, "text": "主公"}, {"start": 415.6, "end": 417.6, "text": "刘备大部分兵马被奸"}, {"start": 417.6, "end": 419.6, "text": "响者三万多"}, {"start": 419.6, "end": 423.94, "text": "都是我军旧部"}, {"start": 423.94, "end": 424.94, "text": "丞相"}, {"start": 424.94, "end": 425.94, "text": "袁绍的援军"}, {"start": 425.94, "end": 427.94, "text": "进行到距徐州三十里处"}, {"start": 427.94, "end": 429.94, "text": "哼 不战而退"}, {"start": 429.94, "end": 433.37, "text": "禀丞相"}, {"start": 433.37, "end": 436.37, "text": "现在小辈也已经被末将拿下"}, {"start": 436.37, "end": 437.37, "text": "没有下笔"}, {"start": 437.37, "end": 439.37, "text": "还在关羽手中"}, {"start": 439.37, "end": 440.37, "text": "主公"}, {"start": 440.37, "end": 442.37, "text": "下笔已是一座孤城"}, {"start": 442.37, "end": 444.37, "text": "肯定是兵无斗志"}, {"start": 444.37, "end": 447.37, "text": "末将愿领一支精兵"}, {"start": 447.37, "end": 449.37, "text": "五日之内把他拿下"}, {"start": 449.37, "end": 493.87, "text": "下笔由关羽把守"}, {"start": 493.87, "end": 497.47, "text": "我若强攻他必战死"}, {"start": 497.47, "end": 501.9, "text": "那就太可惜了"}, {"start": 501.9, "end": 507.17, "text": "不瞒你们说"}, {"start": 508.17, "end": 511.17, "text": "刘备所有部将当中"}, {"start": 511.17, "end": 513.17, "text": "我最喜爱关羽"}, {"start": 513.17, "end": 516.54, "text": "此人无疑高强"}, {"start": 516.54, "end": 518.54, "text": "又极为忠义"}, {"start": 518.54, "end": 525.16, "text": "只能归降我十万雄兵"}, {"start": 525.16, "end": 532.4, "text": "主公"}, {"start": 532.4, "end": 535.4, "text": "臣有一计或许可行"}, {"start": 535.4, "end": 541.14, "text": "听听"}, {"start": 543.14, "end": 545.14, "text": "既然关羽是忠义之士"}, {"start": 545.14, "end": 549.14, "text": "对付这样的人不可立战"}, {"start": 549.14, "end": 553.14, "text": "莫不如将他引入走投无路之地"}, {"start": 553.14, "end": 555.14, "text": "再以忠义相佑"}, {"start": 555.14, "end": 566.83, "text": "已经十几天没消息了"}, {"start": 566.83, "end": 569.83, "text": "我也不知道战况如何"}, {"start": 569.83, "end": 571.83, "text": "如果今日再无消息"}, {"start": 571.83, "end": 573.83, "text": "我一定要出城打探"}, {"start": 573.83, "end": 575.83, "text": "将军莫要心急"}, {"start": 575.83, "end": 577.83, "text": "其实这没有消息就是好消息"}, {"start": 577.83, "end": 579.83, "text": "这说明城池还在主公手中"}, {"start": 579.83, "end": 584.49, "text": "曹军撤了"}, {"start": 584.49, "end": 589.65, "text": "这是为何"}, {"start": 589.65, "end": 592.09, "text": "还是祸"}, {"start": 592.09, "end": 594.09, "text": "将军请看"}, {"start": 594.09, "end": 595.09, "text": "那里有几个残兵"}, {"start": 595.09, "end": 599.49, "text": "好像是咱们的军士"}, {"start": 599.49, "end": 600.49, "text": "开城"}, {"start": 600.49, "end": 601.49, "text": "叫他们进来"}, {"start": 601.49, "end": 616.06, "text": "将军"}, {"start": 616.06, "end": 618.06, "text": "你们是哪一部的"}, {"start": 618.06, "end": 619.06, "text": "将军"}, {"start": 619.06, "end": 620.06, "text": "关将军"}, {"start": 620.06, "end": 622.06, "text": "我们是张以德将军的部下"}, {"start": 622.06, "end": 624.06, "text": "随主公驻防徐州"}, {"start": 624.06, "end": 625.06, "text": "主公太平吧"}, {"start": 626.06, "end": 627.06, "text": "驻州怎么样"}, {"start": 627.06, "end": 628.06, "text": "禀将军"}, {"start": 628.06, "end": 629.06, "text": "主公和张将军"}, {"start": 629.06, "end": 632.06, "text": "都被围困在了盲荡山上"}, {"start": 632.06, "end": 634.06, "text": "血战待远"}, {"start": 636.06, "end": 637.06, "text": "将军"}, {"start": 637.06, "end": 639.06, "text": "前天晚上主公代命夜袭曹英"}, {"start": 639.06, "end": 642.06, "text": "为了要中了那曹贼的奸计"}, {"start": 642.06, "end": 644.06, "text": "被围困在盲荡山上"}, {"start": 644.06, "end": 646.06, "text": "召集所有骑兵"}, {"start": 646.06, "end": 648.06, "text": "随我杀往盲荡山"}, {"start": 648.06, "end": 649.06, "text": "诺"}, {"start": 649.06, "end": 650.06, "text": "佩玛"}, {"start": 650.06, "end": 651.06, "text": "起我兵起来"}, {"start": 651.06, "end": 653.06, "text": "慢 将军"}, {"start": 653.06, "end": 654.06, "text": "将军莫要心急"}, {"start": 654.06, "end": 655.06, "text": "可否先派数计"}, {"start": 655.06, "end": 657.06, "text": "出城打探虚实再说"}, {"start": 657.06, "end": 658.06, "text": "主公有难"}, {"start": 658.06, "end": 661.06, "text": "上次不明我早到一刻是一刻"}, {"start": 662.06, "end": 664.06, "text": "荡山巨厮三十多地"}, {"start": 664.06, "end": 665.06, "text": "札尔也便到了"}, {"start": 665.06, "end": 666.06, "text": "将军"}, {"start": 667.06, "end": 668.06, "text": "将军"}, {"start": 668.06, "end": 670.06, "text": "如果主公真的被困于盲荡山"}, {"start": 670.06, "end": 671.06, "text": "那么山下肯定布满了"}, {"start": 671.06, "end": 672.06, "text": "草头的重兵"}, {"start": 672.06, "end": 674.06, "text": "将军只有两千铁骑"}, {"start": 674.06, "end": 676.06, "text": "如何解得了主公之危啊"}, {"start": 676.06, "end": 678.06, "text": "主公和三弟在那血战"}, {"start": 678.06, "end": 681.06, "text": "你难道让我置他们于死地而不顾啊"}, {"start": 681.06, "end": 682.06, "text": "不不不"}, {"start": 682.06, "end": 683.06, "text": "我不是这个意思"}, {"start": 683.06, "end": 684.06, "text": "我是说"}, {"start": 684.06, "end": 685.06, "text": "曹贼兵多咱们见过"}, {"start": 685.06, "end": 687.06, "text": "一旦出击咱们"}, {"start": 687.06, "end": 688.06, "text": "任他千军万马"}, {"start": 689.06, "end": 691.06, "text": "我也要救出主公和三弟"}, {"start": 692.06, "end": 693.06, "text": "如果救不出来"}, {"start": 694.06, "end": 696.06, "text": "我就和他们同死"}, {"start": 696.06, "end": 697.06, "text": "将军"}, {"start": 697.06, "end": 752.85, "text": "看来这里确实发生过击战"}, {"start": 752.85, "end": 755.85, "text": "主公恐怕是凶多吉少啊"}, {"start": 755.85, "end": 762.74, "text": "将军"}, {"start": 763.74, "end": 764.74, "text": "山上都已经寻遍了"}, {"start": 764.74, "end": 766.74, "text": "仍不见主公的踪迹啊"}, {"start": 766.74, "end": 771.0, "text": "不好了 将军"}, {"start": 771.0, "end": 772.0, "text": "我们被曹军包围了"}, {"start": 772.0, "end": 773.0, "text": "随我杀下山去"}, {"start": 773.0, "end": 780.12, "text": "突围都被我们万箭射回"}, {"start": 780.12, "end": 781.12, "text": "他们死伤不少"}, {"start": 781.12, "end": 808.53, "text": "看来是无力再冲了"}, {"start": 808.53, "end": 810.53, "text": "山上又没有水源"}, {"start": 810.53, "end": 818.84, "text": "料想关羽他们难以咎持啊"}, {"start": 819.84, "end": 820.84, "text": "张梁"}, {"start": 820.84, "end": 821.84, "text": "末将在"}, {"start": 822.84, "end": 824.84, "text": "我听说你和关羽交情不错"}, {"start": 824.84, "end": 825.84, "text": "是吗"}, {"start": 825.84, "end": 826.84, "text": "是"}, {"start": 826.84, "end": 828.84, "text": "关羽他为人忠义"}, {"start": 828.84, "end": 829.84, "text": "武艺高强"}, {"start": 829.84, "end": 830.84, "text": "末将与他是旧友"}, {"start": 831.84, "end": 833.84, "text": "我想劳你上山"}, {"start": 833.84, "end": 834.84, "text": "劝响关羽"}, {"start": 834.84, "end": 835.84, "text": "主公"}, {"start": 835.84, "end": 838.84, "text": "末将断断不敢奉命啊"}, {"start": 839.84, "end": 840.84, "text": "为何呢"}, {"start": 840.84, "end": 842.84, "text": "我了解他的性子"}, {"start": 842.84, "end": 843.84, "text": "关羽他是"}, {"start": 843.84, "end": 844.84, "text": "宁可战死"}, {"start": 844.84, "end": 845.84, "text": "也不肯归降的那种人"}, {"start": 845.84, "end": 847.84, "text": "我就是浑身是嘴"}, {"start": 847.84, "end": 848.84, "text": "也说不动他啊"}, {"start": 850.84, "end": 851.84, "text": "文远将军啊"}, {"start": 851.84, "end": 852.84, "text": "请听我言"}, {"start": 853.84, "end": 858.27, "text": "假如关羽真要战死"}, {"start": 859.27, "end": 861.27, "text": "你就指责他说"}, {"start": 862.27, "end": 863.27, "text": "你死了"}, {"start": 863.27, "end": 865.27, "text": "则有三项罪过"}, {"start": 866.27, "end": 867.27, "text": "如果不死"}, {"start": 867.27, "end": 869.27, "text": "则有三种方便"}, {"start": 871.27, "end": 872.27, "text": "将军请看"}, {"start": 873.27, "end": 874.27, "text": "山下有人上来"}, {"start": 875.27, "end": 876.27, "text": "好像是曹军将领"}, {"start": 895.74, "end": 896.74, "text": "文远兄"}, {"start": 897.74, "end": 898.74, "text": "你是来争斗的呢"}, {"start": 898.74, "end": 899.74, "text": "还是来相助的"}, {"start": 899.74, "end": 908.38, "text": "都不是"}, {"start": 909.38, "end": 910.38, "text": "在下来和云长兄"}, {"start": 910.38, "end": 912.38, "text": "共谋一罪啊"}, {"start": 921.74, "end": 922.74, "text": "我说"}, {"start": 923.74, "end": 924.74, "text": "我说"}, {"start": 925.74, "end": 928.82, "text": "我正渴着呢"}, {"start": 929.82, "end": 946.31, "text": "这酒啊"}, {"start": 947.31, "end": 948.31, "text": "是曹丞相"}, {"start": 948.31, "end": 949.31, "text": "特意送给关将军的"}, {"start": 958.54, "end": 959.54, "text": "云长"}, {"start": 959.54, "end": 960.54, "text": "你一出城"}, {"start": 960.54, "end": 961.54, "text": "丞相就收服了下批"}, {"start": 962.54, "end": 963.54, "text": "什么"}, {"start": 963.54, "end": 964.54, "text": "你们"}, {"start": 964.54, "end": 965.54, "text": "云长不必担心"}, {"start": 966.54, "end": 967.54, "text": "我军进城以后"}, {"start": 967.54, "end": 968.54, "text": "七无好无犯"}, {"start": 969.54, "end": 971.54, "text": "特别是刘玄德的宅府"}, {"start": 971.54, "end": 972.54, "text": "更是太平无事"}, {"start": 973.54, "end": 975.54, "text": "丞相早就下了言令"}, {"start": 975.54, "end": 976.54, "text": "各级将士"}, {"start": 976.54, "end": 978.54, "text": "只准在刘府外守护"}, {"start": 978.54, "end": 979.54, "text": "不得擅入"}, {"start": 979.54, "end": 980.54, "text": "谁要是胆敢"}, {"start": 980.54, "end": 981.54, "text": "擅入刘府一步"}, {"start": 982.54, "end": 983.54, "text": "立战"}, {"start": 983.54, "end": 984.54, "text": "失了下批"}, {"start": 987.04, "end": 988.04, "text": "是我惯罗至尊"}, {"start": 988.04, "end": 989.04, "text": "文远兄"}, {"start": 992.31, "end": 993.31, "text": "请你看在"}, {"start": 993.31, "end": 995.31, "text": "你我多年相交的份上"}, {"start": 996.31, "end": 997.31, "text": "请直言相告"}, {"start": 998.31, "end": 999.31, "text": "我兄长"}, {"start": 1000.31, "end": 1001.31, "text": "他们究竟怎么样了"}, {"start": 1002.31, "end": 1003.31, "text": "刘备早已大败"}, {"start": 1004.31, "end": 1005.31, "text": "残余将士都归顺了"}, {"start": 1005.31, "end": 1006.31, "text": "曹丞相"}, {"start": 1007.31, "end": 1008.31, "text": "有人看见"}, {"start": 1008.31, "end": 1010.31, "text": "刘备单计逃进了深山"}, {"start": 1010.31, "end": 1011.31, "text": "至今不知生死"}, {"start": 1012.31, "end": 1013.31, "text": "云长"}, {"start": 1014.31, "end": 1019.22, "text": "也容我问你一句"}, {"start": 1019.22, "end": 1021.22, "text": "以你现在的情况来看"}, {"start": 1021.22, "end": 1022.22, "text": "如果丞相"}, {"start": 1022.22, "end": 1024.22, "text": "号令山下的五万铁骑"}, {"start": 1024.22, "end": 1025.22, "text": "冲锋的话"}, {"start": 1025.22, "end": 1027.22, "text": "你能破围而出吗"}, {"start": 1027.22, "end": 1028.22, "text": "官某不能"}, {"start": 1028.22, "end": 1029.22, "text": "那你准备怎么办"}, {"start": 1033.19, "end": 1037.75, "text": "请你转告曹操"}, {"start": 1039.75, "end": 1040.75, "text": "喝下这壶酒"}, {"start": 1041.75, "end": 1043.75, "text": "我官某便提刀下山"}, {"start": 1043.75, "end": 1044.75, "text": "先斩他三百将士"}, {"start": 1044.75, "end": 1045.75, "text": "他也可"}, {"start": 1046.75, "end": 1047.75, "text": "来取我的头"}, {"start": 1047.75, "end": 1048.75, "text": "此时此刻"}, {"start": 1048.75, "end": 1049.75, "text": "死是一世"}, {"start": 1049.75, "end": 1056.99, "text": "活着才有"}, {"start": 1057.99, "end": 1059.99, "text": "你要是一死了之的话"}, {"start": 1059.99, "end": 1064.3, "text": "则死也三罪"}, {"start": 1064.3, "end": 1065.3, "text": "哪三罪"}, {"start": 1066.3, "end": 1067.3, "text": "第一罪"}, {"start": 1069.96, "end": 1071.96, "text": "你们刘官璋三结义"}, {"start": 1071.96, "end": 1072.96, "text": "当年在桃园的时候"}, {"start": 1072.96, "end": 1074.96, "text": "曾立下誓言"}, {"start": 1074.96, "end": 1076.96, "text": "同年同月同日死"}, {"start": 1076.96, "end": 1077.96, "text": "刘备虽然兵败"}, {"start": 1077.96, "end": 1079.96, "text": "但生死未知"}, {"start": 1080.96, "end": 1081.96, "text": "将军事想"}, {"start": 1081.96, "end": 1083.96, "text": "如果你的兄长还活着"}, {"start": 1083.96, "end": 1084.96, "text": "你却先死了"}, {"start": 1084.96, "end": 1085.96, "text": "请你先死"}, {"start": 1085.96, "end": 1086.96, "text": "当年的誓约"}, {"start": 1086.96, "end": 1087.96, "text": "第二罪"}, {"start": 1089.96, "end": 1090.96, "text": "刘备将二位夫人"}, {"start": 1090.96, "end": 1091.96, "text": "托付于你"}, {"start": 1092.96, "end": 1093.96, "text": "你快一死"}, {"start": 1093.96, "end": 1095.96, "text": "抛下二位夫人怎么办"}, {"start": 1095.96, "end": 1096.96, "text": "难道把他们"}, {"start": 1097.96, "end": 1099.96, "text": "交到乱兵手中"}, {"start": 1099.96, "end": 1100.96, "text": "玷污真操吗"}, {"start": 1101.96, "end": 1102.96, "text": "你不是说"}, {"start": 1103.96, "end": 1104.96, "text": "曹操有令"}, {"start": 1104.96, "end": 1105.96, "text": "不能踏入刘府一步"}, {"start": 1105.96, "end": 1106.96, "text": "为者斩吗"}, {"start": 1108.96, "end": 1109.96, "text": "那是因为"}, {"start": 1109.96, "end": 1111.96, "text": "有你官云长健在啊"}, {"start": 1111.96, "end": 1112.96, "text": "如果你死了"}, {"start": 1112.96, "end": 1114.96, "text": "只怕没有人能管得住"}, {"start": 1114.96, "end": 1116.96, "text": "那些骄兵汉匠"}, {"start": 1117.96, "end": 1118.96, "text": "你先不要着急"}, {"start": 1118.96, "end": 1119.96, "text": "听我把话说完"}, {"start": 1120.96, "end": 1121.96, "text": "第三罪"}, {"start": 1122.96, "end": 1123.96, "text": "你们兄弟三人"}, {"start": 1123.96, "end": 1125.96, "text": "立志要匡扶汉室"}, {"start": 1125.96, "end": 1127.96, "text": "可如今萧雄未除"}, {"start": 1127.96, "end": 1128.96, "text": "天下未定"}, {"start": 1128.96, "end": 1129.96, "text": "你却先死了"}, {"start": 1129.96, "end": 1130.96, "text": "试问"}, {"start": 1130.96, "end": 1132.96, "text": "你在九泉之下"}, {"start": 1132.96, "end": 1133.96, "text": "如何去见天子"}, {"start": 1133.96, "end": 1135.96, "text": "如何去见兄弟"}, {"start": 1136.96, "end": 1137.96, "text": "你先死"}, {"start": 1137.96, "end": 1138.96, "text": "在九泉之下"}, {"start": 1138.96, "end": 1139.96, "text": "如何去见天子"}, {"start": 1139.96, "end": 1141.96, "text": "如何去见兄长"}, {"start": 1142.96, "end": 1143.96, "text": "云长啊"}, {"start": 1144.96, "end": 1145.96, "text": "这死后三罪"}, {"start": 1146.96, "end": 1148.96, "text": "在下不得不说啊"}, {"start": 1149.96, "end": 1150.96, "text": "我不能求死"}, {"start": 1151.96, "end": 1156.35, "text": "听我说"}, {"start": 1157.35, "end": 1158.35, "text": "这死有三罪"}, {"start": 1158.35, "end": 1160.35, "text": "生却有三变"}, {"start": 1160.35, "end": 1163.02, "text": "哪三变"}, {"start": 1164.02, "end": 1165.02, "text": "你现在是"}, {"start": 1165.02, "end": 1166.02, "text": "身陷重围"}, {"start": 1166.02, "end": 1167.02, "text": "走投无路"}, {"start": 1168.02, "end": 1169.02, "text": "不如暂时先"}, {"start": 1169.02, "end": 1170.02, "text": "归顺曹省下"}, {"start": 1171.02, "end": 1172.02, "text": "待日后打听到"}, {"start": 1172.02, "end": 1173.02, "text": "刘备的下落"}, {"start": 1173.02, "end": 1175.02, "text": "再去投奔他不迟"}, {"start": 1175.02, "end": 1177.02, "text": "如此生有三变"}, {"start": 1178.02, "end": 1179.02, "text": "第一"}, {"start": 1179.02, "end": 1180.02, "text": "可以保证"}, {"start": 1180.02, "end": 1182.02, "text": "二位嫂夫人的安全"}, {"start": 1182.02, "end": 1183.02, "text": "第二"}, {"start": 1183.02, "end": 1185.02, "text": "不负当年桃园之事"}, {"start": 1186.02, "end": 1187.02, "text": "第三"}, {"start": 1187.02, "end": 1189.02, "text": "留得英雄之躯"}, {"start": 1189.02, "end": 1191.02, "text": "待来日匡扶大汉"}, {"start": 1191.02, "end": 1215.34, "text": "我也有三约"}, {"start": 1217.34, "end": 1218.34, "text": "如果他同意"}, {"start": 1218.34, "end": 1220.34, "text": "我立刻卸甲"}, {"start": 1220.34, "end": 1221.34, "text": "如果他不同意"}, {"start": 1222.34, "end": 1223.34, "text": "我宁可"}, {"start": 1223.34, "end": 1225.34, "text": "负三罪而死"}, {"start": 1225.34, "end": 1228.84, "text": "云长秦长"}, {"start": 1229.84, "end": 1230.84, "text": "第一"}, {"start": 1230.84, "end": 1232.84, "text": "我只属汉地不属草草"}, {"start": 1232.84, "end": 1233.84, "text": "第二"}, {"start": 1234.84, "end": 1235.84, "text": "请丞相"}, {"start": 1235.84, "end": 1237.84, "text": "善待我那二位嫂嫂"}, {"start": 1239.84, "end": 1240.84, "text": "第三"}, {"start": 1241.84, "end": 1242.84, "text": "一旦有我兄长下落"}, {"start": 1242.84, "end": 1243.84, "text": "无论天涯海角"}, {"start": 1243.84, "end": 1245.84, "text": "我都要寻他而去"}, {"start": 1245.84, "end": 1246.84, "text": "以上三约"}, {"start": 1247.84, "end": 1248.84, "text": "缺了任何一条"}, {"start": 1249.84, "end": 1251.84, "text": "我是万万不祥"}, {"start": 1252.84, "end": 1264.43, "text": "闻远"}, {"start": 1264.43, "end": 1265.43, "text": "情况如何"}, {"start": 1267.43, "end": 1268.43, "text": "丞相"}, {"start": 1269.43, "end": 1270.43, "text": "关羽说了"}, {"start": 1270.43, "end": 1271.43, "text": "要他归降"}, {"start": 1271.43, "end": 1272.43, "text": "他有三约"}, {"start": 1274.43, "end": 1275.43, "text": "说我听听"}, {"start": 1275.43, "end": 1276.43, "text": "第一"}, {"start": 1276.43, "end": 1278.43, "text": "他只属汉地不属主宫"}, {"start": 1279.43, "end": 1281.43, "text": "我是朝廷丞相"}, {"start": 1281.43, "end": 1282.43, "text": "属汉就是属我"}, {"start": 1282.43, "end": 1283.43, "text": "准了"}, {"start": 1283.43, "end": 1284.43, "text": "第二"}, {"start": 1284.43, "end": 1286.43, "text": "善待他的二位嫂夫人"}, {"start": 1286.43, "end": 1287.43, "text": "各级军士"}, {"start": 1287.43, "end": 1289.43, "text": "不得擅自入门"}, {"start": 1289.43, "end": 1290.43, "text": "我岂只会"}, {"start": 1290.43, "end": 1291.43, "text": "善待两位刘夫人"}, {"start": 1291.43, "end": 1292.43, "text": "我还会加倍地"}, {"start": 1292.43, "end": 1293.43, "text": "奉养他们呢"}, {"start": 1293.43, "end": 1294.43, "text": "准"}, {"start": 1296.43, "end": 1297.43, "text": "关羽的第三条"}, {"start": 1297.43, "end": 1299.43, "text": "是他一旦知道了"}, {"start": 1299.43, "end": 1300.43, "text": "刘备的下落"}, {"start": 1300.43, "end": 1302.43, "text": "纵然是天涯海角"}, {"start": 1302.43, "end": 1303.43, "text": "也要投他而去"}, {"start": 1306.43, "end": 1308.43, "text": "既然如此"}, {"start": 1308.43, "end": 1310.43, "text": "我要关羽何用"}, {"start": 1310.43, "end": 1313.43, "text": "这个却难以答应"}, {"start": 1313.43, "end": 1319.04, "text": "丞相"}, {"start": 1320.04, "end": 1321.04, "text": "末将想"}, {"start": 1321.04, "end": 1323.04, "text": "刘备对关羽"}, {"start": 1323.04, "end": 1325.04, "text": "无非是厚恩而已"}, {"start": 1325.04, "end": 1327.04, "text": "如果丞相对关羽"}, {"start": 1327.04, "end": 1328.04, "text": "恩典更厚"}, {"start": 1328.04, "end": 1330.04, "text": "时间久了"}, {"start": 1330.04, "end": 1332.04, "text": "关羽必备改化"}, {"start": 1332.04, "end": 1333.04, "text": "再说"}, {"start": 1333.04, "end": 1335.04, "text": "刘备生死不明"}, {"start": 1335.04, "end": 1337.04, "text": "不一定还在人间啊"}, {"start": 1339.04, "end": 1341.04, "text": "此话有理"}, {"start": 1341.04, "end": 1344.48, "text": "世人只知道"}, {"start": 1344.48, "end": 1345.48, "text": "曹某之危"}, {"start": 1345.48, "end": 1347.48, "text": "不知道曹某的恩典"}, {"start": 1347.48, "end": 1349.48, "text": "更重于威严"}, {"start": 1349.48, "end": 1351.48, "text": "这第三约"}, {"start": 1351.48, "end": 1352.48, "text": "准了"}, {"start": 1352.48, "end": 1354.48, "text": "谢丞相"}, {"start": 1354.48, "end": 1355.48, "text": "好"}, {"start": 1356.48, "end": 1357.48, "text": "传命"}, {"start": 1357.48, "end": 1358.48, "text": "退军十里"}, {"start": 1358.48, "end": 1360.48, "text": "让关羽下山回城"}, {"start": 1360.48, "end": 1361.48, "text": "丞相"}, {"start": 1361.48, "end": 1364.48, "text": "这事倒令人担心"}, {"start": 1364.48, "end": 1366.48, "text": "关羽他要降便降"}, {"start": 1366.48, "end": 1368.48, "text": "丞相不可放他回城"}, {"start": 1368.48, "end": 1369.48, "text": "为何"}, {"start": 1370.48, "end": 1373.48, "text": "如果关羽乘机脱逃了"}, {"start": 1373.48, "end": 1375.48, "text": "那可是龙入大海"}, {"start": 1376.48, "end": 1379.48, "text": "这就是我给他的第一道恩典"}, {"start": 1379.48, "end": 1380.48, "text": "让他回城"}, {"start": 1380.48, "end": 1381.48, "text": "我相信"}, {"start": 1381.48, "end": 1384.48, "text": "关羽绝不会被约逃生的"}, {"start": 1384.48, "end": 1385.48, "text": "对吗"}, {"start": 1385.48, "end": 1428.11, "text": "末将关羽"}, {"start": 1428.11, "end": 1430.11, "text": "拜见丞相"}, {"start": 1431.11, "end": 1441.02, "text": "我得关羽偿"}, {"start": 1441.02, "end": 1443.02, "text": "胜过十万兄兵"}, {"start": 1443.02, "end": 1445.52, "text": "禀丞相"}, {"start": 1446.52, "end": 1448.52, "text": "末将的归乡三约"}, {"start": 1448.52, "end": 1451.02, "text": "当然"}, {"start": 1451.02, "end": 1452.02, "text": "曹某一言"}, {"start": 1452.02, "end": 1454.02, "text": "司马难追"}, {"start": 1454.02, "end": 1456.43, "text": "日后"}, {"start": 1456.43, "end": 1457.43, "text": "如有兄长下落"}, {"start": 1457.43, "end": 1459.43, "text": "无论天涯海角"}, {"start": 1459.43, "end": 1463.43, "text": "我定当前去相会"}, {"start": 1464.43, "end": 1465.43, "text": "羽偿"}, {"start": 1465.43, "end": 1467.43, "text": "你就放心吧"}, {"start": 1468.43, "end": 1570.4, "text": "公瑾觉得"}, {"start": 1571.4, "end": 1573.4, "text": "这首曲子弹奏得如何"}, {"start": 1573.4, "end": 1577.93, "text": "琴曲漫妙传神"}, {"start": 1577.93, "end": 1578.93, "text": "让人讨罪"}, {"start": 1578.93, "end": 1582.34, "text": "真是可惜"}, {"start": 1582.34, "end": 1585.34, "text": "这曲中间弹错了一个音调"}, {"start": 1587.34, "end": 1590.34, "text": "公瑾真是精通音律"}, {"start": 1590.34, "end": 1592.34, "text": "区区的一个音调"}, {"start": 1592.34, "end": 1594.34, "text": "都逃不过你的耳朵"}, {"start": 1595.34, "end": 1597.34, "text": "我只是略等一二而已"}, {"start": 1598.34, "end": 1600.34, "text": "只是不知"}, {"start": 1600.34, "end": 1603.34, "text": "是何人在弹奏这首曲子"}, {"start": 1603.34, "end": 1605.34, "text": "我与主公一同前往"}, {"start": 1605.34, "end": 1606.34, "text": "一看便知"}, {"start": 1606.34, "end": 1607.34, "text": "好"}, {"start": 1607.34, "end": 1608.34, "text": "随我看看"}, {"start": 1611.34, "end": 1642.38, "text": "二位将军"}, {"start": 1642.38, "end": 1644.38, "text": "今日造访小宅"}, {"start": 1644.38, "end": 1646.38, "text": "不知有何事"}, {"start": 1647.38, "end": 1648.38, "text": "前些时日"}, {"start": 1648.38, "end": 1649.38, "text": "我与主公在竹林中"}, {"start": 1649.38, "end": 1651.38, "text": "听到有人在弹奏琴曲"}, {"start": 1651.38, "end": 1653.38, "text": "琴声漫妙让人讨罪"}, {"start": 1654.38, "end": 1656.38, "text": "后来得知是乔家女儿在弹奏"}, {"start": 1656.38, "end": 1659.38, "text": "所以今日特意前来拜访"}, {"start": 1659.38, "end": 1660.38, "text": "不错"}, {"start": 1660.38, "end": 1662.38, "text": "那日我与公瑾"}, {"start": 1662.38, "end": 1664.38, "text": "被竹林当中的琴声所吸引"}, {"start": 1665.38, "end": 1667.38, "text": "今日想见一见弹奏琴曲的人"}, {"start": 1668.38, "end": 1670.38, "text": "烦请乔公满足我们的心愿"}, {"start": 1672.38, "end": 1673.38, "text": "原来是这样"}, {"start": 1674.38, "end": 1675.38, "text": "不过不瞒将军"}, {"start": 1676.38, "end": 1677.38, "text": "老朽家有两女"}, {"start": 1677.38, "end": 1679.38, "text": "都同些音律"}, {"start": 1679.38, "end": 1682.38, "text": "不知道将军说的是哪一个"}, {"start": 1682.38, "end": 1688.48, "text": "乔公有两个女儿"}, {"start": 1688.48, "end": 1689.48, "text": "对"}, {"start": 1689.48, "end": 1691.48, "text": "长女叫大乔"}, {"start": 1691.48, "end": 1693.48, "text": "二女叫小乔"}, {"start": 1693.48, "end": 1695.48, "text": "他们都喜欢在竹林里"}, {"start": 1695.48, "end": 1696.48, "text": "练习琴曲"}, {"start": 1697.48, "end": 1701.42, "text": "我们只是听到了琴曲"}, {"start": 1702.42, "end": 1704.42, "text": "并未见到弹奏琴曲之人"}, {"start": 1705.42, "end": 1707.42, "text": "只是听到那日弹奏的古曲江南"}, {"start": 1708.42, "end": 1709.42, "text": "错了一个音调"}, {"start": 1710.42, "end": 1711.42, "text": "既然这样"}, {"start": 1711.42, "end": 1712.42, "text": "我让大乔小乔"}, {"start": 1712.42, "end": 1713.42, "text": "出来见过二位将军"}, {"start": 1714.42, "end": 1715.42, "text": "一问便知"}, {"start": 1715.42, "end": 1716.42, "text": "乔公且慢"}, {"start": 1719.89, "end": 1720.89, "text": "公瑾"}, {"start": 1720.89, "end": 1722.89, "text": "世人都说你精通音律"}, {"start": 1723.89, "end": 1724.89, "text": "我看这样好不好"}, {"start": 1725.89, "end": 1726.89, "text": "让大乔和小乔"}, {"start": 1726.89, "end": 1727.89, "text": "同时弹奏一支曲子"}, {"start": 1728.89, "end": 1729.89, "text": "由你来听辨"}, {"start": 1730.89, "end": 1732.89, "text": "看看那天在竹林当中"}, {"start": 1732.89, "end": 1733.89, "text": "弹奏的到底是谁"}, {"start": 1734.89, "end": 1735.89, "text": "公瑾意下如何"}, {"start": 1736.89, "end": 1742.89, "text": "这我倒愿意一试"}, {"start": 1743.89, "end": 1745.89, "text": "但不知乔公的二位小姐"}, {"start": 1745.89, "end": 1746.89, "text": "是否愿意"}, {"start": 1814.22, "end": 1815.22, "text": "如何"}, {"start": 1816.22, "end": 1817.22, "text": "此曲堪称绝伦"}, {"start": 1820.08, "end": 1821.08, "text": "大乔小乔"}, {"start": 1821.08, "end": 1822.08, "text": "快出来见过二位将军"}, {"start": 1833.45, "end": 1834.45, "text": "二位将军"}, {"start": 1835.45, "end": 1836.45, "text": "没想到"}, {"start": 1837.45, "end": 1839.45, "text": "世上竟有如此美妙的女子"}, {"start": 1857.79, "end": 1858.79, "text": "袁叔那个门客"}, {"start": 1858.79, "end": 1859.79, "text": "还是从轻发落吧"}, {"start": 1861.79, "end": 1862.79, "text": "此事公瑾不用多言"}, {"start": 1864.79, "end": 1865.79, "text": "来来来"}, {"start": 1865.79, "end": 1866.79, "text": "看看我收集的这些琴谱"}, {"start": 1867.79, "end": 1878.94, "text": "主公何时开始"}, {"start": 1878.94, "end": 1879.94, "text": "喜欢收集琴谱"}, {"start": 1880.94, "end": 1882.94, "text": "我也想像公瑾一样"}, {"start": 1883.94, "end": 1884.94, "text": "学习一些音律"}, {"start": 1888.24, "end": 1889.24, "text": "我看伯服"}, {"start": 1890.24, "end": 1891.24, "text": "不是真心要学习音律吧"}, {"start": 1900.18, "end": 1903.18, "text": "看来知我者莫如公瑾也"}, {"start": 1903.18, "end": 1906.18, "text": "那日你我一同去乔家"}, {"start": 1907.18, "end": 1909.18, "text": "你觉得乔公的"}, {"start": 1909.18, "end": 1912.18, "text": "大乔小乔如何呀"}, {"start": 1913.18, "end": 1915.18, "text": "两个人都有博雅子气之才"}, {"start": 1915.18, "end": 1916.18, "text": "清国清成之荣"}, {"start": 1918.18, "end": 1919.18, "text": "称得上一代佳人"}, {"start": 1921.18, "end": 1924.18, "text": "那公瑾以为"}, {"start": 1925.18, "end": 1927.18, "text": "如果你我兄弟二人"}, {"start": 1927.18, "end": 1929.18, "text": "能娶大乔小乔为妻"}, {"start": 1929.18, "end": 1930.18, "text": "如何"}, {"start": 1930.18, "end": 1932.18, "text": "那可为英雄佳人添作之何"}, {"start": 1933.18, "end": 1935.18, "text": "这些琴谱就是聘礼"}, {"start": 1938.84, "end": 1943.37, "text": "我要给你我兄弟二人求亲"}, {"start": 1944.37, "end": 1947.37, "text": "今日端午节特赠关将军"}, {"start": 1947.37, "end": 1948.37, "text": "金五十"}, {"start": 1948.37, "end": 1949.37, "text": "每玉三件"}, {"start": 1949.37, "end": 1970.85, "text": "钱三千"}, {"start": 1971.85, "end": 1972.85, "text": "绸缎二十匹"}, {"start": 1973.85, "end": 1975.85, "text": "关于拜谢丞相"}, {"start": 1976.85, "end": 1977.85, "text": "丞相口谕"}, {"start": 1977.85, "end": 1978.85, "text": "关于拜谢丞相"}, {"start": 1978.85, "end": 1979.85, "text": "丞相口谕"}, {"start": 1979.85, "end": 1980.85, "text": "关于征战多年"}, {"start": 1980.85, "end": 1981.85, "text": "安马屠牢"}, {"start": 1981.85, "end": 1982.85, "text": "应稍时休息"}, {"start": 1983.85, "end": 1984.85, "text": "特赠江南美女实名"}, {"start": 1985.85, "end": 1986.85, "text": "早晚事后"}, {"start": 1986.85, "end": 1987.85, "text": "替我转告丞相"}, {"start": 1987.85, "end": 1988.85, "text": "美女万万使不得"}, {"start": 1989.85, "end": 1992.99, "text": "使不得"}, {"start": 1992.99, "end": 1993.99, "text": "丞相另有口谕"}, {"start": 1994.99, "end": 1995.99, "text": "关于如果说使不得"}, {"start": 1995.99, "end": 1997.99, "text": "那就留下让他自行安排吧"}, {"start": 1998.99, "end": 1999.99, "text": "将军"}, {"start": 1999.99, "end": 2001.99, "text": "丞相口谕在下已传达完毕"}, {"start": 2001.99, "end": 2002.99, "text": "谨告辞"}, {"start": 2003.99, "end": 2004.99, "text": "曹丞相"}, {"start": 2004.99, "end": 2005.99, "text": "三日一小宴"}, {"start": 2005.99, "end": 2006.99, "text": "五日一大宴"}, {"start": 2006.99, "end": 2012.79, "text": "金银绸缎"}, {"start": 2012.79, "end": 2013.79, "text": "玉器豪宅"}, {"start": 2014.79, "end": 2015.79, "text": "更是赏赐不断"}, {"start": 2016.79, "end": 2017.79, "text": "今日"}, {"start": 2017.79, "end": 2019.79, "text": "竟然又送来了一群美女"}, {"start": 2020.79, "end": 2021.79, "text": "这上午"}, {"start": 2021.79, "end": 2022.79, "text": "如何收受得了"}, {"start": 2023.79, "end": 2024.79, "text": "在下从军这么多年了"}, {"start": 2024.79, "end": 2026.79, "text": "也没见过这么多的赏赐"}, {"start": 2026.79, "end": 2028.79, "text": "这也是将军的福气"}, {"start": 2028.79, "end": 2029.79, "text": "收下吧"}, {"start": 2029.79, "end": 2031.79, "text": "东西也就罢了"}, {"start": 2031.79, "end": 2033.79, "text": "美女万万使不得"}, {"start": 2034.79, "end": 2035.79, "text": "送他们回去"}, {"start": 2036.79, "end": 2037.79, "text": "丞相"}, {"start": 2038.79, "end": 2039.79, "text": "丞相"}, {"start": 2039.79, "end": 2040.79, "text": "送他们回去"}, {"start": 2042.79, "end": 2043.79, "text": "曹操把话都说到前头了"}, {"start": 2044.79, "end": 2045.79, "text": "将军要是不收下呢"}, {"start": 2045.79, "end": 2046.79, "text": "也不合适"}, {"start": 2047.79, "end": 2048.79, "text": "不过在下想"}, {"start": 2049.79, "end": 2051.79, "text": "如果把这些美女安排在后堂"}, {"start": 2051.79, "end": 2052.79, "text": "专门伺候主公的夫人"}, {"start": 2054.79, "end": 2055.79, "text": "甚好"}, {"start": 2055.79, "end": 2056.79, "text": "甚好"}, {"start": 2057.79, "end": 2058.79, "text": "带他们去吧"}, {"start": 2058.79, "end": 2059.79, "text": "遵命"}, {"start": 2059.79, "end": 2060.79, "text": "来 跟我来吧"}, {"start": 2060.79, "end": 2076.49, "text": "这个肉鲜美无比"}, {"start": 2076.49, "end": 2077.49, "text": "怎么做出来的"}, {"start": 2077.49, "end": 2078.49, "text": "禀丞相"}, {"start": 2079.49, "end": 2080.49, "text": "这是半碎的小鹿肉"}, {"start": 2081.49, "end": 2082.49, "text": "郝厨门用了九种佐料"}, {"start": 2082.49, "end": 2083.49, "text": "闻火烹出来的"}, {"start": 2084.49, "end": 2085.49, "text": "还有吗"}, {"start": 2085.49, "end": 2086.49, "text": "还有大半罐"}, {"start": 2087.49, "end": 2088.49, "text": "给云昌送去"}, {"start": 2089.49, "end": 2090.49, "text": "告诉他"}, {"start": 2090.49, "end": 2091.49, "text": "这是半碎的小鹿肉"}, {"start": 2091.49, "end": 2092.49, "text": "鲜美无比"}, {"start": 2092.49, "end": 2093.49, "text": "不可不尝"}, {"start": 2093.49, "end": 2096.44, "text": "遵命"}, {"start": 2098.44, "end": 2099.44, "text": "连炉子一块儿端走"}, {"start": 2099.44, "end": 2100.44, "text": "不可在半道上凉了"}, {"start": 2101.44, "end": 2102.44, "text": "遵命"}, {"start": 2102.44, "end": 2108.88, "text": "闪开闪开 别烫着了"}, {"start": 2109.88, "end": 2110.88, "text": "丞相赏关将军鹿肉"}, {"start": 2115.85, "end": 2116.85, "text": "禀丞相"}, {"start": 2116.85, "end": 2117.85, "text": "奴才已把鹿肉给关将军送去"}, {"start": 2118.85, "end": 2119.85, "text": "关将军拜谢丞相"}, {"start": 2120.85, "end": 2121.85, "text": "我刚想起来"}, {"start": 2121.85, "end": 2122.85, "text": "食肉断断不可无酒"}, {"start": 2123.85, "end": 2124.85, "text": "此酒香醇清烈"}, {"start": 2125.85, "end": 2126.85, "text": "正好可以用来佐食鹿肉"}, {"start": 2127.85, "end": 2128.85, "text": "快给云昌送去"}, {"start": 2129.85, "end": 2130.85, "text": "务必要在"}, {"start": 2130.85, "end": 2133.26, "text": "他吃完鹿肉之前送到"}, {"start": 2134.26, "end": 2135.26, "text": "遵命"}, {"start": 2135.26, "end": 2140.68, "text": "丞相赏关将军美酒"}, {"start": 2141.68, "end": 2143.68, "text": "要在鹿肉食完前送到"}, {"start": 2145.68, "end": 2147.68, "text": "丞相赏关将军美酒"}, {"start": 2148.68, "end": 2150.68, "text": "要在鹿肉食完前送到"}, {"start": 2151.68, "end": 2152.68, "text": "听到了没有"}, {"start": 2152.68, "end": 2153.68, "text": "丞相衣食冷暖"}, {"start": 2154.68, "end": 2155.68, "text": "皆惦记这关语"}, {"start": 2156.68, "end": 2158.68, "text": "我等出生入死多年"}, {"start": 2161.96, "end": 2163.96, "text": "还不如一个祥将呢"}, {"start": 2165.96, "end": 2166.96, "text": "恭喜关将军"}, {"start": 2167.96, "end": 2186.69, "text": "关某何其之犹"}, {"start": 2187.69, "end": 2195.32, "text": "丞相在一餐之间"}, {"start": 2195.32, "end": 2197.32, "text": "两次赠将军鹿肉美酒"}, {"start": 2198.32, "end": 2200.32, "text": "相府上下无不为之惊叹"}, {"start": 2202.32, "end": 2203.32, "text": "云昌"}, {"start": 2204.32, "end": 2205.32, "text": "丞相"}, {"start": 2205.32, "end": 2207.32, "text": "对你可是求贤若渴"}, {"start": 2207.32, "end": 2208.32, "text": "丞相"}, {"start": 2209.32, "end": 2215.38, "text": "待我的确恩助如山"}, {"start": 2216.38, "end": 2217.38, "text": "正是这座山"}, {"start": 2217.38, "end": 2218.38, "text": "压得我喘不过气"}, {"start": 2222.3, "end": 2223.3, "text": "云昌为何这样讲"}, {"start": 2224.3, "end": 2225.3, "text": "关某"}, {"start": 2225.3, "end": 2229.22, "text": "自顺曹以来"}, {"start": 2230.22, "end": 2232.22, "text": "丞相三日一小宴"}, {"start": 2232.22, "end": 2233.22, "text": "五日一大宴"}, {"start": 2234.22, "end": 2235.22, "text": "金银珠宝"}, {"start": 2235.22, "end": 2236.22, "text": "玉器豪宅"}, {"start": 2236.22, "end": 2238.22, "text": "更是赏赐不断"}, {"start": 2239.22, "end": 2240.22, "text": "而我"}, {"start": 2240.22, "end": 2242.22, "text": "身无尺寸之功却有"}, {"start": 2243.22, "end": 2244.22, "text": "我何以回报"}, {"start": 2245.22, "end": 2249.98, "text": "丞相这善意般的大恩呢"}, {"start": 2250.98, "end": 2252.98, "text": "越是美味佳酿越是"}, {"start": 2256.42, "end": 2258.42, "text": "这么说我就明白了"}, {"start": 2260.95, "end": 2261.95, "text": "难怪你每天"}, {"start": 2261.95, "end": 2264.95, "text": "酒肉美食不但没有吃胖"}, {"start": 2264.95, "end": 2266.95, "text": "反而日渐憔悴啊"}, {"start": 2267.95, "end": 2269.95, "text": "更让我担心的是"}, {"start": 2270.95, "end": 2272.95, "text": "兄长和三弟至今"}, {"start": 2272.95, "end": 2273.95, "text": "驾落不明"}, {"start": 2274.95, "end": 2275.95, "text": "生死不吃"}, {"start": 2276.95, "end": 2277.95, "text": "云昌不必焦虑"}, {"start": 2278.95, "end": 2279.95, "text": "有道事"}, {"start": 2280.95, "end": 2281.95, "text": "富贵有命"}, {"start": 2281.95, "end": 2282.95, "text": "生死在天啊"}, {"start": 2283.95, "end": 2285.95, "text": "丞相待你如此恩宠"}, {"start": 2285.95, "end": 2290.48, "text": "羡慕死我了"}, {"start": 2291.48, "end": 2292.48, "text": "云昌"}, {"start": 2292.48, "end": 2293.48, "text": "我俩共饮几杯"}, {"start": 2293.48, "end": 2295.48, "text": "这么好的酒肉美食"}, {"start": 2295.48, "end": 2297.48, "text": "不吃的话太可惜了"}, {"start": 2297.48, "end": 2298.48, "text": "云昌"}, {"start": 2298.48, "end": 2299.48, "text": "快来啊"}, {"start": 2299.48, "end": 2303.27, "text": "关宇被丞相的大恩"}, {"start": 2303.27, "end": 2304.27, "text": "压得是喘过气"}, {"start": 2306.8, "end": 2307.8, "text": "整日在心里忐忑"}, {"start": 2308.8, "end": 2309.8, "text": "他发愁的是"}, {"start": 2309.8, "end": 2311.8, "text": "自己身无尺寸之功"}, {"start": 2311.8, "end": 2312.8, "text": "却有折腰之骨"}, {"start": 2313.8, "end": 2315.8, "text": "将来如何能报答丞相"}, {"start": 2315.8, "end": 2317.8, "text": "向善意般厚重的大恩"}, {"start": 2318.8, "end": 2321.8, "text": "关宇他为此十分发愁啊"}, {"start": 2321.8, "end": 2323.8, "text": "愁得好啊"}, {"start": 2324.8, "end": 2326.8, "text": "这正是我所希望的效果"}, {"start": 2327.8, "end": 2329.8, "text": "我要先让关宇感动"}, {"start": 2330.8, "end": 2331.8, "text": "不安"}, {"start": 2331.8, "end": 2332.8, "text": "内疚"}, {"start": 2332.8, "end": 2333.8, "text": "最后倾心拜福"}, {"start": 2334.8, "end": 2335.8, "text": "丞相的恩威"}, {"start": 2336.8, "end": 2337.8, "text": "天下之怪"}, {"start": 2337.8, "end": 2339.8, "text": "可以说世上无人能比"}, {"start": 2340.8, "end": 2341.8, "text": "不过"}, {"start": 2341.8, "end": 2342.8, "text": "叔"}, {"start": 2343.8, "end": 2344.8, "text": "关宇他仍然"}, {"start": 2344.8, "end": 2346.8, "text": "还牵挂着刘备和张飞"}, {"start": 2347.8, "end": 2349.8, "text": "可以说是日夜悬心啊"}, {"start": 2349.8, "end": 2350.8, "text": "我觉得"}, {"start": 2351.8, "end": 2353.8, "text": "关宇对刘备的忠义之心"}, {"start": 2353.8, "end": 2354.8, "text": "并没有改变"}, {"start": 2355.8, "end": 2356.8, "text": "但是"}, {"start": 2357.8, "end": 2358.8, "text": "关宇"}, {"start": 2358.8, "end": 2360.8, "text": "关宇对刘备的忠义之心"}, {"start": 2360.8, "end": 2361.8, "text": "并没有改变"}, {"start": 2362.8, "end": 2364.8, "text": "忠义有何不好呢"}, {"start": 2365.8, "end": 2366.8, "text": "好得很"}, {"start": 2367.8, "end": 2368.8, "text": "没有忠肝义胆"}, {"start": 2368.8, "end": 2370.8, "text": "弹劾英雄壮士"}, {"start": 2371.8, "end": 2372.8, "text": "但是我要把"}, {"start": 2372.8, "end": 2374.8, "text": "他对刘备的忠肝义胆"}, {"start": 2374.8, "end": 2376.8, "text": "变成对我的忠肝义胆"}, {"start": 2377.8, "end": 2378.8, "text": "文远啊"}, {"start": 2378.8, "end": 2379.8, "text": "你瞧着"}, {"start": 2380.8, "end": 2382.8, "text": "明日我要送他一样宝物"}, {"start": 2382.8, "end": 2383.8, "text": "他见了"}, {"start": 2383.8, "end": 2385.8, "text": "肯定感动的给我跪下"}, {"start": 2386.8, "end": 2387.8, "text": "真的呀"}, {"start": 2388.8, "end": 2389.8, "text": "你拭目以待吧"}, {"start": 2391.8, "end": 2406.18, "text": "我令关宇随我行猎"}, {"start": 2406.18, "end": 2407.18, "text": "此刻时辰已到"}, {"start": 2408.18, "end": 2409.18, "text": "他怎么还不来啊"}, {"start": 2410.18, "end": 2411.18, "text": "丞相放心"}, {"start": 2411.18, "end": 2412.18, "text": "关宇他早已领命"}, {"start": 2413.18, "end": 2414.18, "text": "一定会到"}, {"start": 2414.18, "end": 2440.66, "text": "拜见丞相"}, {"start": 2441.66, "end": 2443.66, "text": "云长为何遲误啊"}, {"start": 2444.66, "end": 2448.25, "text": "在下的战马"}, {"start": 2449.25, "end": 2450.25, "text": "过于瘦弱"}, {"start": 2451.25, "end": 2452.25, "text": "马速缓慢"}, {"start": 2452.25, "end": 2453.25, "text": "所以来迟"}, {"start": 2453.25, "end": 2455.25, "text": "请丞相收费"}, {"start": 2457.25, "end": 2458.25, "text": "战马"}, {"start": 2458.25, "end": 2460.25, "text": "如同将军的性命"}, {"start": 2461.25, "end": 2462.25, "text": "你"}, {"start": 2462.25, "end": 2464.25, "text": "驰骋沙场多年"}, {"start": 2464.25, "end": 2465.25, "text": "怎么会"}, {"start": 2465.25, "end": 2467.25, "text": "连一匹军马都没有呢"}, {"start": 2468.25, "end": 2469.25, "text": "丞相"}, {"start": 2469.25, "end": 2470.25, "text": "所言极是"}, {"start": 2470.25, "end": 2471.25, "text": "战马如同"}, {"start": 2471.25, "end": 2473.25, "text": "将士的生命"}, {"start": 2473.25, "end": 2475.25, "text": "如意作计可御"}, {"start": 2477.59, "end": 2478.59, "text": "说得好"}, {"start": 2478.59, "end": 2479.59, "text": "说得真好"}]