[{"start": 4.75, "end": 9.75, "text": "父亲不守规矩,儿子也不守规矩。"}, {"start": 9.75, "end": 12.75, "text": "这天下成何体细?"}, {"start": 12.75, "end": 17.38, "text": "徐大人,那你想让我怎么办?"}, {"start": 18.38, "end": 20.38, "text": "请公子给我退回去。"}, {"start": 20.38, "end": 28.42, "text": "定仪"}, {"start": 28.42, "end": 29.42, "text": "在"}, {"start": 29.42, "end": 30.42, "text": "出"}, {"start": 30.42, "end": 31.42, "text": "诺"}, {"start": 33.42, "end": 34.42, "text": "父王"}, {"start": 34.42, "end": 35.42, "text": "卫王"}, {"start": 35.42, "end": 61.17, "text": "白马门谁当值啊?"}, {"start": 61.17, "end": 63.17, "text": "回卫王,是在下"}, {"start": 64.17, "end": 65.17, "text": "徐楚"}, {"start": 65.17, "end": 66.17, "text": "在"}, {"start": 67.17, "end": 68.17, "text": "诺"}, {"start": 68.17, "end": 69.17, "text": "卫王,饶命啊"}, {"start": 69.17, "end": 70.17, "text": "饶命啊,卫王"}, {"start": 70.17, "end": 71.17, "text": "卫王,饶命啊"}, {"start": 71.17, "end": 72.17, "text": "丞相"}, {"start": 72.17, "end": 73.17, "text": "饶命啊,卫王"}, {"start": 73.17, "end": 74.17, "text": "我是卫王"}, {"start": 75.17, "end": 76.17, "text": "禀丞相"}, {"start": 76.17, "end": 79.17, "text": "坏规矩的是公子"}, {"start": 79.17, "end": 82.17, "text": "为什么要杀死门吏?"}, {"start": 83.17, "end": 84.17, "text": "门吏如果不开门"}, {"start": 84.17, "end": 86.17, "text": "公子岂能坏规矩"}, {"start": 86.17, "end": 88.17, "text": "这就是我的规矩"}, {"start": 88.17, "end": 93.6, "text": "门吏尚开白马门盖上"}, {"start": 93.6, "end": 96.6, "text": "那朝廷尚未丞相"}, {"start": 96.6, "end": 99.6, "text": "大开封王之门的百官"}, {"start": 121.51, "end": 123.51, "text": "寻玉寻玉"}, {"start": 124.51, "end": 126.51, "text": "你跟了我三十年"}, {"start": 127.51, "end": 129.51, "text": "没想到你竟敢这么忤逆"}, {"start": 130.51, "end": 131.51, "text": "来人哪"}, {"start": 131.51, "end": 132.51, "text": "在"}, {"start": 132.51, "end": 136.51, "text": "丞相想杀在下吗?"}, {"start": 139.82, "end": 141.82, "text": "族下尽管放心"}, {"start": 141.82, "end": 143.82, "text": "我曹操从来不杀有功之臣"}, {"start": 144.82, "end": 145.82, "text": "徐楚"}, {"start": 146.82, "end": 148.82, "text": "即刻拆除白马门"}, {"start": 148.82, "end": 149.82, "text": "遵命"}, {"start": 151.82, "end": 152.82, "text": "寻玉"}, {"start": 152.82, "end": 154.82, "text": "我要你好好看看"}, {"start": 154.82, "end": 156.82, "text": "一会儿连门都没了"}, {"start": 156.82, "end": 159.82, "text": "大陆朝天人人可走"}, {"start": 159.82, "end": 161.82, "text": "你所谈的规矩"}, {"start": 162.82, "end": 167.63, "text": "有何在呢?"}, {"start": 168.63, "end": 196.86, "text": "寻大人"}, {"start": 196.86, "end": 197.86, "text": "寻大人"}, {"start": 198.86, "end": 199.86, "text": "寻大人"}, {"start": 201.86, "end": 202.86, "text": "寻大人"}, {"start": 202.86, "end": 205.88, "text": "寻大人"}, {"start": 205.88, "end": 210.11, "text": "寻大人"}, {"start": 210.11, "end": 218.12, "text": "少府耿尽"}, {"start": 228.42, "end": 229.42, "text": "没死决"}, {"start": 229.42, "end": 246.42, "text": "白马门拆除了没有?"}, {"start": 246.42, "end": 248.42, "text": "全部拆完了"}, {"start": 248.42, "end": 249.42, "text": "那寻玉"}, {"start": 251.42, "end": 252.42, "text": "有没有来闹过?"}, {"start": 252.42, "end": 256.86, "text": "那天时候"}, {"start": 256.86, "end": 257.86, "text": "他回去"}, {"start": 258.86, "end": 259.86, "text": "回去就病了"}, {"start": 260.86, "end": 262.86, "text": "三天没进食了"}, {"start": 263.86, "end": 267.87, "text": "不吃东西怎么能吃"}, {"start": 267.87, "end": 274.26, "text": "我这儿有点儿果品"}, {"start": 274.26, "end": 277.14, "text": "你拿着"}, {"start": 277.14, "end": 280.97, "text": "带我到他府上去"}, {"start": 280.97, "end": 283.63, "text": "盼望一下"}, {"start": 284.63, "end": 285.63, "text": "遵命"}, {"start": 285.63, "end": 404.34, "text": "给你烧了一盒果品"}, {"start": 404.34, "end": 692.63, "text": "没有你徇门弱"}, {"start": 692.63, "end": 698.76, "text": "性平缘年"}, {"start": 699.76, "end": 700.76, "text": "我正讨欠"}, {"start": 700.76, "end": 704.97, "text": "你以周司马"}, {"start": 704.97, "end": 706.97, "text": "留守延州"}, {"start": 706.97, "end": 710.57, "text": "费尽心机"}, {"start": 711.57, "end": 713.57, "text": "把我两相共计"}, {"start": 714.57, "end": 716.57, "text": "掌描反叛时"}, {"start": 716.57, "end": 719.57, "text": "各军线纷纷响应"}, {"start": 719.57, "end": 720.57, "text": "又是你"}, {"start": 721.57, "end": 723.57, "text": "率军坚守"}, {"start": 724.57, "end": 726.91, "text": "并不是"}, {"start": 726.91, "end": 732.38, "text": "建安五年关渡之战"}, {"start": 733.38, "end": 735.38, "text": "我大军粮进"}, {"start": 735.38, "end": 737.38, "text": "军心大乱"}, {"start": 737.38, "end": 742.14, "text": "所有将领都要让我退去"}, {"start": 742.14, "end": 746.86, "text": "只有你坚守待变"}, {"start": 747.86, "end": 749.86, "text": "连夜给我送来了"}, {"start": 749.86, "end": 751.86, "text": "粮草军械"}, {"start": 752.86, "end": 753.86, "text": "我才能"}, {"start": 753.86, "end": 755.86, "text": "最后出其之声"}, {"start": 755.86, "end": 757.86, "text": "大败元少"}, {"start": 757.86, "end": 762.2, "text": "你就是我的张粮"}, {"start": 762.2, "end": 764.2, "text": "张梁 张子芳"}, {"start": 765.2, "end": 768.2, "text": "你就是我的左膀右背"}, {"start": 768.2, "end": 798.9, "text": "就是我的兄弟"}, {"start": 798.9, "end": 799.9, "text": "是"}, {"start": 799.9, "end": 800.9, "text": "孩儿明白"}, {"start": 800.9, "end": 806.91, "text": "杀了一个不想杀"}, {"start": 806.91, "end": 810.96, "text": "又不得不杀的老友"}, {"start": 810.96, "end": 812.96, "text": "况且这位老友"}, {"start": 812.96, "end": 816.82, "text": "还是父亲的知心人"}, {"start": 816.82, "end": 820.58, "text": "你听见了吧"}, {"start": 820.58, "end": 822.58, "text": "皮儿说得对"}, {"start": 822.58, "end": 826.58, "text": "你是我的知心老友"}, {"start": 827.58, "end": 828.58, "text": "可是你"}, {"start": 828.58, "end": 830.58, "text": "跟世人一样"}, {"start": 830.58, "end": 836.12, "text": "你等着"}, {"start": 836.12, "end": 839.4, "text": "时间会证明"}, {"start": 839.4, "end": 842.4, "text": "你离我而去是错的"}, {"start": 842.4, "end": 874.13, "text": "大错特错"}, {"start": 874.13, "end": 875.13, "text": "曹贼大逆无道"}, {"start": 875.13, "end": 877.13, "text": "破天子立他为位王"}, {"start": 877.13, "end": 878.13, "text": "逼杀巡大府"}, {"start": 878.13, "end": 880.13, "text": "出境入壁"}, {"start": 880.13, "end": 881.13, "text": "吾等汉臣"}, {"start": 881.13, "end": 882.13, "text": "当杀死逆贼"}, {"start": 882.13, "end": 883.13, "text": "匡扶朝廷"}, {"start": 883.13, "end": 884.13, "text": "杀死逆贼"}, {"start": 884.13, "end": 885.13, "text": "匡扶朝廷"}, {"start": 885.13, "end": 886.13, "text": "吾等半死不死"}, {"start": 886.13, "end": 887.13, "text": "好"}, {"start": 887.13, "end": 888.13, "text": "列伪弟兄"}, {"start": 888.13, "end": 889.13, "text": "静听我说"}, {"start": 889.13, "end": 890.13, "text": "曹操今夜"}, {"start": 890.13, "end": 892.13, "text": "仍夙在五凤楼"}, {"start": 892.13, "end": 894.13, "text": "此楼由御林军执守"}, {"start": 894.13, "end": 895.13, "text": "我已经在御林军中"}, {"start": 895.13, "end": 896.13, "text": "联络多位义士"}, {"start": 896.13, "end": 897.13, "text": "三晚时分"}, {"start": 897.13, "end": 899.13, "text": "他们会在马料厂放火"}, {"start": 899.13, "end": 900.13, "text": "以此吸引城中守卫"}, {"start": 900.13, "end": 901.13, "text": "前去救火"}, {"start": 901.13, "end": 903.13, "text": "我则率兵杀入五凤楼"}, {"start": 903.13, "end": 904.13, "text": "斩杀曹操"}, {"start": 904.13, "end": 906.13, "text": "再请天子当楼"}, {"start": 906.13, "end": 907.13, "text": "招百官灭狱逃贼"}, {"start": 907.13, "end": 909.13, "text": "招安御林军"}, {"start": 911.13, "end": 912.13, "text": "如此便大局已定"}, {"start": 912.13, "end": 915.13, "text": "我等皆是汉室功勋之臣"}, {"start": 915.13, "end": 919.58, "text": "快去救火"}, {"start": 919.58, "end": 920.58, "text": "着火了"}, {"start": 920.58, "end": 921.58, "text": "快去救火"}, {"start": 921.58, "end": 922.58, "text": "快"}, {"start": 922.58, "end": 938.47, "text": "攻下五凤楼"}, {"start": 938.47, "end": 939.47, "text": "杀"}, {"start": 939.47, "end": 970.84, "text": "徐主"}, {"start": 970.84, "end": 971.84, "text": "卫王"}, {"start": 971.84, "end": 972.84, "text": "出什么事了"}, {"start": 972.84, "end": 973.84, "text": "卫王"}, {"start": 973.84, "end": 975.84, "text": "御林军营起了大祸"}, {"start": 975.84, "end": 976.84, "text": "好像还有乱兵"}, {"start": 976.84, "end": 977.84, "text": "卫王"}, {"start": 977.84, "end": 978.84, "text": "你快回上马"}, {"start": 978.84, "end": 979.84, "text": "末将护送你"}, {"start": 979.84, "end": 980.84, "text": "冲杀出城去"}, {"start": 980.84, "end": 981.84, "text": "不要慌"}, {"start": 982.84, "end": 983.84, "text": "你听"}, {"start": 984.84, "end": 985.84, "text": "现在这四面八方"}, {"start": 985.84, "end": 986.84, "text": "都是呐喊声"}, {"start": 987.84, "end": 988.84, "text": "你怎么知道"}, {"start": 988.84, "end": 989.84, "text": "哪条路才能走得通"}, {"start": 990.84, "end": 992.84, "text": "你只要护住五凤楼"}, {"start": 993.84, "end": 994.84, "text": "如果有叛贼赶来"}, {"start": 995.84, "end": 996.84, "text": "杀无赦"}, {"start": 996.84, "end": 997.84, "text": "诺"}, {"start": 998.84, "end": 1011.39, "text": "公子 不好了 公子"}, {"start": 1013.39, "end": 1014.39, "text": "公子 不好了"}, {"start": 1014.39, "end": 1015.39, "text": "攻城火起"}, {"start": 1015.39, "end": 1016.39, "text": "四面到处都是杀声"}, {"start": 1016.39, "end": 1017.39, "text": "满城人都在喊"}, {"start": 1019.99, "end": 1020.99, "text": "喊什么"}, {"start": 1020.99, "end": 1021.99, "text": "杀"}, {"start": 1021.99, "end": 1022.99, "text": "杀尽曹贼"}, {"start": 1022.99, "end": 1023.99, "text": "匡扶汉室"}, {"start": 1024.99, "end": 1025.99, "text": "父王在哪"}, {"start": 1025.99, "end": 1026.99, "text": "昨夜留宿五凤楼"}, {"start": 1026.99, "end": 1027.99, "text": "火就要烧到那儿了"}, {"start": 1028.99, "end": 1031.37, "text": "马上叫齐所有家兵"}, {"start": 1031.37, "end": 1032.37, "text": "随我去五凤楼"}, {"start": 1032.37, "end": 1033.37, "text": "遵命"}, {"start": 1033.37, "end": 1045.6, "text": "驾"}, {"start": 1045.6, "end": 1046.6, "text": "这是续网合作"}, {"start": 1046.6, "end": 1047.6, "text": "军营有人放火"}, {"start": 1047.6, "end": 1048.6, "text": "乱兵起事"}, {"start": 1048.6, "end": 1049.6, "text": "往前去杀贼"}, {"start": 1049.6, "end": 1050.6, "text": "那是叛贼的奸计"}, {"start": 1050.6, "end": 1051.6, "text": "附近在五凤楼"}, {"start": 1051.6, "end": 1052.6, "text": "快随我去护驾"}, {"start": 1052.6, "end": 1053.6, "text": "只要父亲安全"}, {"start": 1053.6, "end": 1054.6, "text": "他把整栋徐城城"}, {"start": 1054.6, "end": 1055.6, "text": "杀了都无妨"}, {"start": 1055.6, "end": 1056.6, "text": "好 我送你去"}, {"start": 1056.6, "end": 1057.6, "text": "快"}, {"start": 1058.6, "end": 1059.6, "text": "你为何造反"}, {"start": 1148.5, "end": 1149.5, "text": "造反的人不是我"}, {"start": 1149.5, "end": 1152.14, "text": "是你"}, {"start": 1153.14, "end": 1154.14, "text": "我是为大汉诛贼"}, {"start": 1155.14, "end": 1156.14, "text": "口气不小啊"}, {"start": 1158.14, "end": 1159.14, "text": "知道吗"}, {"start": 1159.14, "end": 1160.14, "text": "我会灭你九族"}, {"start": 1162.14, "end": 1163.14, "text": "即便断子绝孙"}, {"start": 1163.14, "end": 1164.14, "text": "我也要杀你"}, {"start": 1165.14, "end": 1166.14, "text": "把这叛贼的死路"}, {"start": 1166.14, "end": 1167.14, "text": "割下来"}, {"start": 1167.14, "end": 1168.14, "text": "不"}, {"start": 1168.14, "end": 1169.14, "text": "让他骂"}, {"start": 1170.14, "end": 1172.14, "text": "让他痛痛快快地"}, {"start": 1172.14, "end": 1173.14, "text": "骂几句"}, {"start": 1174.14, "end": 1175.14, "text": "我好久没听人骂了"}, {"start": 1175.14, "end": 1176.14, "text": "你"}, {"start": 1176.14, "end": 1183.76, "text": "耿少卿"}, {"start": 1184.76, "end": 1188.39, "text": "有件事我想请教祖俠"}, {"start": 1189.39, "end": 1194.01, "text": "自从临地以后"}, {"start": 1195.01, "end": 1198.01, "text": "汉庭日渐衰微"}, {"start": 1198.01, "end": 1199.01, "text": "腐败"}, {"start": 1200.01, "end": 1202.01, "text": "皇帝百官玉厥"}, {"start": 1203.01, "end": 1205.01, "text": "官吏横征暴敛"}, {"start": 1206.01, "end": 1207.01, "text": "豪强风起"}, {"start": 1207.01, "end": 1208.01, "text": "为祸四方"}, {"start": 1209.01, "end": 1210.01, "text": "整个汉市"}, {"start": 1211.01, "end": 1212.01, "text": "就像我脚下这片"}, {"start": 1212.01, "end": 1213.01, "text": "废墟一样"}, {"start": 1214.01, "end": 1215.01, "text": "是我"}, {"start": 1216.01, "end": 1218.01, "text": "藕心沥血重整河山"}, {"start": 1219.01, "end": 1221.01, "text": "才让老百姓有了饭吃"}, {"start": 1222.01, "end": 1223.01, "text": "让那些贪官无力"}, {"start": 1224.01, "end": 1225.01, "text": "没有了作恶的地方"}, {"start": 1226.01, "end": 1227.01, "text": "我自认为"}, {"start": 1228.01, "end": 1230.01, "text": "还是有些微薄之功的"}, {"start": 1231.01, "end": 1233.01, "text": "可是为什么你们这么恨我"}, {"start": 1233.01, "end": 1234.01, "text": "还要杀我"}, {"start": 1235.01, "end": 1237.01, "text": "难道你们想让汉市"}, {"start": 1238.01, "end": 1240.01, "text": "再变成一片废墟吗"}, {"start": 1241.01, "end": 1243.8, "text": "终为百德之首"}, {"start": 1243.8, "end": 1245.8, "text": "我生而读圣人之书"}, {"start": 1245.8, "end": 1247.8, "text": "死而进圣人之道"}, {"start": 1247.8, "end": 1249.8, "text": "圣人之道要是管用的话"}, {"start": 1249.8, "end": 1251.8, "text": "圣人早就自个儿一统天下了"}, {"start": 1252.8, "end": 1253.8, "text": "你知道吗"}, {"start": 1253.8, "end": 1254.8, "text": "你这叫愚忠"}, {"start": 1255.8, "end": 1259.04, "text": "贪官无力可恨"}, {"start": 1260.04, "end": 1262.04, "text": "混用的君主可恨"}, {"start": 1262.04, "end": 1265.04, "text": "你这种愚忠不化的人"}, {"start": 1265.04, "end": 1266.04, "text": "更可恨"}, {"start": 1266.04, "end": 1267.04, "text": "曹阿蛮"}, {"start": 1268.04, "end": 1269.04, "text": "我生不能杀你"}, {"start": 1269.04, "end": 1271.04, "text": "死也要作厉鬼杀你"}, {"start": 1271.04, "end": 1272.04, "text": "是吗"}, {"start": 1273.04, "end": 1275.04, "text": "那你就看清楚点"}, {"start": 1276.04, "end": 1278.04, "text": "记清楚我这张脸"}, {"start": 1278.04, "end": 1280.04, "text": "别到了阴间记不住"}, {"start": 1281.04, "end": 1283.04, "text": "你们这些鼠辈"}, {"start": 1283.04, "end": 1285.04, "text": "在阳间不是我的对手"}, {"start": 1285.04, "end": 1286.04, "text": "到了阴间"}, {"start": 1286.04, "end": 1288.04, "text": "就能放过神来吗"}, {"start": 1289.04, "end": 1290.04, "text": "老实说"}, {"start": 1290.04, "end": 1291.04, "text": "曹阿蛮"}, {"start": 1291.04, "end": 1293.04, "text": "我死也不会放过你的"}, {"start": 1293.04, "end": 1307.24, "text": "我死也不会放过你的"}, {"start": 1307.24, "end": 1308.24, "text": "公子"}, {"start": 1309.24, "end": 1310.24, "text": "先生"}, {"start": 1311.24, "end": 1312.24, "text": "先生"}, {"start": 1313.24, "end": 1314.24, "text": "先生无碍吧"}, {"start": 1315.24, "end": 1316.24, "text": "公子没有危险吧"}, {"start": 1316.24, "end": 1318.24, "text": "我甚为公子担心"}, {"start": 1319.24, "end": 1320.24, "text": "这都是别人的"}, {"start": 1321.65, "end": 1322.65, "text": "不是我的"}, {"start": 1322.65, "end": 1323.65, "text": "先生"}, {"start": 1323.65, "end": 1325.65, "text": "昨天傅王被围在五凤楼"}, {"start": 1325.65, "end": 1328.65, "text": "是我第一个带着家谱杀进营去"}, {"start": 1328.65, "end": 1330.65, "text": "公子去五凤楼了"}, {"start": 1332.65, "end": 1333.65, "text": "是啊"}, {"start": 1334.65, "end": 1335.65, "text": "曹芝去了没有"}, {"start": 1336.65, "end": 1337.65, "text": "没有"}, {"start": 1337.65, "end": 1340.65, "text": "她昨天和她的一群室友痛饮"}, {"start": 1340.65, "end": 1341.65, "text": "喝醉了"}, {"start": 1341.65, "end": 1342.65, "text": "部长都输了"}, {"start": 1342.65, "end": 1351.58, "text": "曹芝赢了"}, {"start": 1351.58, "end": 1364.75, "text": "丞相心智过人"}, {"start": 1364.75, "end": 1365.75, "text": "他会猜疑"}, {"start": 1366.75, "end": 1368.75, "text": "这么多的人去攻五凤楼"}, {"start": 1368.75, "end": 1370.75, "text": "又有这么多的人去救五凤楼"}, {"start": 1370.75, "end": 1372.75, "text": "连御林军里都有岗级内应"}, {"start": 1372.75, "end": 1375.75, "text": "谁知道旧军里头有没有奸贼呢"}, {"start": 1375.75, "end": 1377.75, "text": "尤其是你们二位公子"}, {"start": 1377.75, "end": 1379.75, "text": "来杀贼还是来助贼"}, {"start": 1380.75, "end": 1382.75, "text": "丞相甚至怀疑你们二位公子"}, {"start": 1382.75, "end": 1384.75, "text": "策划了这场兵变"}, {"start": 1384.75, "end": 1385.75, "text": "曹芝没去"}, {"start": 1389.98, "end": 1391.98, "text": "虽然丞相看不出他的忠勇"}, {"start": 1391.98, "end": 1394.98, "text": "却至少知道他没有反应"}, {"start": 1404.86, "end": 1405.86, "text": "魏王"}, {"start": 1405.86, "end": 1408.86, "text": "乱贼都被捕杀"}, {"start": 1408.86, "end": 1409.86, "text": "除耿季外"}, {"start": 1409.86, "end": 1411.86, "text": "还有司马维黄"}, {"start": 1411.86, "end": 1413.86, "text": "太医吉平的儿子"}, {"start": 1413.86, "end": 1415.86, "text": "吉渺吉木"}, {"start": 1415.86, "end": 1419.86, "text": "和大祖子弟金维等五十余人"}, {"start": 1419.86, "end": 1423.23, "text": "这些都是被捕获的"}, {"start": 1423.23, "end": 1426.64, "text": "还有没被捕获的"}, {"start": 1426.64, "end": 1432.42, "text": "此事务必深挖严查"}, {"start": 1432.42, "end": 1434.42, "text": "一定要挖出余党"}, {"start": 1435.42, "end": 1436.42, "text": "遵命"}, {"start": 1436.42, "end": 1438.42, "text": "为什么没有见到曹芝呢"}, {"start": 1440.42, "end": 1442.42, "text": "魏王危难之际"}, {"start": 1442.42, "end": 1444.42, "text": "四公子未来就驾"}, {"start": 1444.42, "end": 1447.42, "text": "为此心中惶恐"}, {"start": 1448.42, "end": 1450.42, "text": "不敢来见魏王"}, {"start": 1451.42, "end": 1452.42, "text": "传王命"}, {"start": 1454.42, "end": 1456.42, "text": "让曹芝统领御陵军"}, {"start": 1456.42, "end": 1458.42, "text": "为蜀夜城"}, {"start": 1475.23, "end": 1476.23, "text": "启禀魏王"}, {"start": 1476.23, "end": 1493.37, "text": "百官已押到"}, {"start": 1493.37, "end": 1518.57, "text": "耿季 维黄等造反"}, {"start": 1518.57, "end": 1520.57, "text": "与放火焚烧五凤楼"}, {"start": 1521.57, "end": 1522.57, "text": "你们中间"}, {"start": 1522.57, "end": 1525.57, "text": "有人曾经救火击贼"}, {"start": 1525.57, "end": 1527.57, "text": "也有人闭门不出"}, {"start": 1528.57, "end": 1529.57, "text": "救火击贼的"}, {"start": 1529.57, "end": 1531.57, "text": "可立于洪旗下"}, {"start": 1533.57, "end": 1534.57, "text": "闭门不出的"}, {"start": 1534.57, "end": 1536.57, "text": "可立于白旗下"}, {"start": 1536.57, "end": 1537.57, "text": "你们"}, {"start": 1538.57, "end": 1567.93, "text": "各赏金二十两"}, {"start": 1567.93, "end": 1568.93, "text": "回归本职"}, {"start": 1569.93, "end": 1571.93, "text": "谢白王"}, {"start": 1571.93, "end": 1572.93, "text": "统统拿下"}, {"start": 1572.93, "end": 1573.93, "text": "诺"}, {"start": 1573.93, "end": 1587.47, "text": "你们以为我不知道吗"}, {"start": 1588.47, "end": 1598.14, "text": "尔等文官"}, {"start": 1598.14, "end": 1599.14, "text": "手无缚鸡之力"}, {"start": 1601.39, "end": 1602.39, "text": "救什么火"}, {"start": 1603.39, "end": 1604.39, "text": "击什么贼"}, {"start": 1605.39, "end": 1607.39, "text": "你们跑到五凤楼"}, {"start": 1608.39, "end": 1609.39, "text": "拾住贼儿"}, {"start": 1609.39, "end": 1611.39, "text": "都给我牵到张河边"}, {"start": 1613.83, "end": 1614.83, "text": "一起斩了"}, {"start": 1614.83, "end": 1615.83, "text": "诺"}, {"start": 1617.83, "end": 1618.83, "text": "希儿"}, {"start": 1619.83, "end": 1635.55, "text": "随我来"}, {"start": 1635.55, "end": 1636.55, "text": "你为何不安呢"}, {"start": 1637.55, "end": 1661.75, "text": "父王刚刚"}, {"start": 1661.75, "end": 1665.16, "text": "杀了三百多口毒"}, {"start": 1665.16, "end": 1666.16, "text": "赫赫王威"}, {"start": 1667.16, "end": 1668.16, "text": "令孩儿"}, {"start": 1669.16, "end": 1670.16, "text": "惊心动魄"}, {"start": 1670.16, "end": 1671.16, "text": "知道我为什么"}, {"start": 1671.16, "end": 1672.16, "text": "要杀他们吗"}, {"start": 1672.16, "end": 1676.37, "text": "洪旗下的人"}, {"start": 1676.37, "end": 1678.37, "text": "多为皇宫内侍"}, {"start": 1681.1, "end": 1682.1, "text": "他们跑到五凤楼下"}, {"start": 1683.1, "end": 1684.1, "text": "齐心不轨"}, {"start": 1685.1, "end": 1686.1, "text": "既知道如此"}, {"start": 1688.54, "end": 1689.54, "text": "那你为何"}, {"start": 1689.54, "end": 1690.54, "text": "要去五凤楼下"}, {"start": 1691.54, "end": 1692.54, "text": "父王"}, {"start": 1692.54, "end": 1694.54, "text": "孩儿宁肯被父王怀疑"}, {"start": 1694.54, "end": 1697.42, "text": "也绝不能"}, {"start": 1697.42, "end": 1698.42, "text": "间谍害了父王"}, {"start": 1698.42, "end": 1699.42, "text": "平安"}, {"start": 1699.42, "end": 1701.42, "text": "你昨夜的一举一动"}, {"start": 1701.42, "end": 1709.24, "text": "我都看见了"}, {"start": 1711.62, "end": 1713.62, "text": "你本不是习武之人"}, {"start": 1713.62, "end": 1715.62, "text": "剑法拙劣不堪"}, {"start": 1716.62, "end": 1717.62, "text": "但是在与逆贼"}, {"start": 1717.62, "end": 1718.62, "text": "殊死相搏时"}, {"start": 1718.62, "end": 1720.62, "text": "却像个疯子一样"}, {"start": 1720.62, "end": 1721.62, "text": "毫不顾及"}, {"start": 1721.62, "end": 1722.62, "text": "自己的性命"}, {"start": 1722.62, "end": 1724.62, "text": "我要立你为世子"}, {"start": 1725.62, "end": 1726.62, "text": "成王嗣"}, {"start": 1726.62, "end": 1746.72, "text": "今日"}, {"start": 1746.72, "end": 1748.72, "text": "我就会让董昭"}, {"start": 1748.72, "end": 1749.72, "text": "昭告天下"}, {"start": 1750.72, "end": 1751.72, "text": "父王"}, {"start": 1752.72, "end": 1753.72, "text": "你要杀人"}, {"start": 1753.72, "end": 1756.99, "text": "父王"}, {"start": 1757.99, "end": 1758.99, "text": "你要尽快地"}, {"start": 1758.99, "end": 1759.99, "text": "搬到丞相府来"}, {"start": 1760.99, "end": 1761.99, "text": "日后我不在"}, {"start": 1761.99, "end": 1762.99, "text": "徐昌的时候"}, {"start": 1763.99, "end": 1765.99, "text": "都城里的军政要务"}, {"start": 1765.99, "end": 1767.99, "text": "文武三军"}, {"start": 1767.99, "end": 1769.99, "text": "包括皇宫里的事务"}, {"start": 1769.99, "end": 1770.99, "text": "都归你职场"}, {"start": 1771.99, "end": 1776.22, "text": "儿臣"}, {"start": 1777.22, "end": 1778.22, "text": "听令"}, {"start": 1778.22, "end": 1781.14, "text": "去叫司马一来"}, {"start": 1782.14, "end": 1805.99, "text": "仲大"}, {"start": 1806.99, "end": 1807.99, "text": "我已经立"}, {"start": 1807.99, "end": 1809.99, "text": "曹匹为世子了"}, {"start": 1809.99, "end": 1815.18, "text": "臣看见匹公子"}, {"start": 1815.18, "end": 1816.18, "text": "满面是泪"}, {"start": 1816.18, "end": 1817.18, "text": "族下的才华"}, {"start": 1817.18, "end": 1819.18, "text": "不亚于孔明周瑜"}, {"start": 1820.18, "end": 1821.18, "text": "日后"}, {"start": 1821.18, "end": 1822.18, "text": "我还盼你"}, {"start": 1822.18, "end": 1824.18, "text": "忠心辅佐曹匹"}, {"start": 1824.18, "end": 1825.18, "text": "臣领命"}, {"start": 1825.18, "end": 1832.2, "text": "卫王"}, {"start": 1836.46, "end": 1840.41, "text": "卫王"}, {"start": 1840.41, "end": 1842.41, "text": "曹弘从汉中"}, {"start": 1842.41, "end": 1843.41, "text": "发来告急文书"}, {"start": 1843.41, "end": 1844.41, "text": "皇中率两万军"}, {"start": 1844.41, "end": 1845.41, "text": "连破三寨"}, {"start": 1845.41, "end": 1847.41, "text": "并攻破了我军要害"}, {"start": 1847.41, "end": 1849.41, "text": "我军将士皆伤亡惨重"}, {"start": 1849.41, "end": 1851.41, "text": "汉中关爱已洞开"}, {"start": 1851.41, "end": 1852.41, "text": "曹将军请卫王"}, {"start": 1852.41, "end": 1853.41, "text": "快发救兵"}, {"start": 1856.41, "end": 1857.41, "text": "刘备"}, {"start": 1857.41, "end": 1859.41, "text": "去川蜀不到一年"}, {"start": 1860.41, "end": 1863.41, "text": "就要攻取汉中之地"}, {"start": 1864.41, "end": 1865.41, "text": "汉中一失"}, {"start": 1866.41, "end": 1869.41, "text": "刘备就可以居高临下"}, {"start": 1869.41, "end": 1872.41, "text": "像刘邦一样出兵中原"}, {"start": 1872.41, "end": 1874.41, "text": "攻许昌"}, {"start": 1874.41, "end": 1876.41, "text": "与我一决此行"}, {"start": 1877.41, "end": 1878.41, "text": "卫王"}, {"start": 1878.41, "end": 1879.41, "text": "汉中断不可失啊"}, {"start": 1879.41, "end": 1881.41, "text": "赶紧发兵救援曹弘吧"}, {"start": 1882.41, "end": 1883.41, "text": "你说呢"}, {"start": 1883.41, "end": 1888.82, "text": "刘备帝王之心"}, {"start": 1888.82, "end": 1892.71, "text": "已经暗奈不住了"}, {"start": 1892.71, "end": 1894.71, "text": "他坐拥于川蜀京乡"}, {"start": 1894.71, "end": 1896.71, "text": "其兵马不下于百万"}, {"start": 1896.71, "end": 1898.71, "text": "战将不下于千元"}, {"start": 1898.71, "end": 1900.71, "text": "两相军械取之不尽"}, {"start": 1900.71, "end": 1903.41, "text": "用之不竭"}, {"start": 1905.41, "end": 1908.41, "text": "此时刘备大军斗之震撼"}, {"start": 1908.41, "end": 1910.41, "text": "丞相不必与之争讽"}, {"start": 1911.41, "end": 1913.41, "text": "难道你想让我放弃汉中"}, {"start": 1914.41, "end": 1915.41, "text": "臣以为"}, {"start": 1915.41, "end": 1917.41, "text": "还有一处比汉中"}, {"start": 1917.41, "end": 1919.98, "text": "更要紧的地方"}, {"start": 1919.98, "end": 1921.98, "text": "那就是天下之父"}, {"start": 1921.98, "end": 1925.57, "text": "荆州"}, {"start": 1925.57, "end": 1927.57, "text": "丞相可让曹仁率十万军"}, {"start": 1928.57, "end": 1929.57, "text": "在汉中扬动"}, {"start": 1930.57, "end": 1932.57, "text": "丞相新率三十万大军"}, {"start": 1933.57, "end": 1934.57, "text": "挥施南下"}, {"start": 1934.57, "end": 1935.57, "text": "攻取荆乡"}, {"start": 1936.57, "end": 1937.57, "text": "如此"}, {"start": 1937.57, "end": 1938.57, "text": "刘备必乱"}, {"start": 1939.57, "end": 1940.57, "text": "汉中之危也可立即"}, {"start": 1941.57, "end": 1942.57, "text": "好方略"}, {"start": 1942.57, "end": 1948.82, "text": "不过我想稍作修改"}, {"start": 1948.82, "end": 1953.23, "text": "叫曹仁率十万军南下"}, {"start": 1953.23, "end": 1955.23, "text": "进驻凡城"}, {"start": 1955.23, "end": 1956.23, "text": "择机攻去荆州"}, {"start": 1957.23, "end": 1959.23, "text": "我亲率三十万大军"}, {"start": 1959.23, "end": 1961.23, "text": "往汉中迎战刘备"}, {"start": 1962.23, "end": 1963.23, "text": "你"}, {"start": 1963.23, "end": 1964.23, "text": "随我出征"}, {"start": 1966.9, "end": 1967.9, "text": "遵命"}, {"start": 1968.9, "end": 1969.9, "text": "禀丞相"}, {"start": 1970.9, "end": 1971.9, "text": "如果丞相"}, {"start": 1971.9, "end": 1973.9, "text": "非要和刘备决战"}, {"start": 1973.9, "end": 1974.9, "text": "臣还有一个建议"}, {"start": 1975.9, "end": 1976.9, "text": "说"}, {"start": 1976.9, "end": 1977.9, "text": "置书孙权"}, {"start": 1978.9, "end": 1979.9, "text": "让他发兵过疆"}, {"start": 1979.9, "end": 1981.9, "text": "以我军联合行动"}, {"start": 1981.9, "end": 1982.9, "text": "攻取荆乡"}, {"start": 1982.9, "end": 1983.9, "text": "事成后"}, {"start": 1983.9, "end": 1984.9, "text": "平分其地"}, {"start": 1985.9, "end": 1987.9, "text": "孙权在河北屡败于我"}, {"start": 1987.9, "end": 1988.9, "text": "他还会与我联手吗"}, {"start": 1988.9, "end": 1989.9, "text": "肯定会"}, {"start": 1990.9, "end": 1991.9, "text": "为何"}, {"start": 1991.9, "end": 1992.9, "text": "一者"}, {"start": 1993.9, "end": 1994.9, "text": "孙权朝思暮想"}, {"start": 1994.9, "end": 1995.9, "text": "贪图荆州"}, {"start": 1996.9, "end": 1997.9, "text": "二者"}, {"start": 1997.9, "end": 1998.9, "text": "他此时的心思"}, {"start": 1998.9, "end": 2000.9, "text": "与丞相不谋而合"}, {"start": 2000.9, "end": 2001.9, "text": "他也不想看到"}, {"start": 2001.9, "end": 2002.9, "text": "刘备吞定天下"}, {"start": 2003.9, "end": 2004.9, "text": "列位"}, {"start": 2005.9, "end": 2027.61, "text": "今天我们是双喜临门的"}, {"start": 2028.61, "end": 2029.61, "text": "其一"}, {"start": 2029.61, "end": 2030.61, "text": "皇中炎炎"}, {"start": 2031.61, "end": 2032.61, "text": "率偏军"}, {"start": 2032.61, "end": 2034.61, "text": "便清取了我军的要害关"}, {"start": 2034.61, "end": 2035.61, "text": "使汉中门户洞开"}, {"start": 2036.61, "end": 2037.61, "text": "其二"}, {"start": 2038.61, "end": 2039.61, "text": "曹操刚刚在许昌"}, {"start": 2039.61, "end": 2040.61, "text": "建立称王"}, {"start": 2040.61, "end": 2042.61, "text": "便激起了兵变"}, {"start": 2042.61, "end": 2043.61, "text": "差点杀了他"}, {"start": 2045.61, "end": 2046.61, "text": "大哥"}, {"start": 2046.61, "end": 2048.61, "text": "我看我们要抓紧时机"}, {"start": 2048.61, "end": 2049.61, "text": "进起三军"}, {"start": 2049.61, "end": 2050.61, "text": "夺了汉中吧"}, {"start": 2050.61, "end": 2051.61, "text": "汉中"}, {"start": 2051.61, "end": 2052.61, "text": "自古以来就是"}, {"start": 2052.61, "end": 2053.61, "text": "兵家必争之地"}, {"start": 2054.61, "end": 2055.61, "text": "我们若占取汉中"}, {"start": 2055.61, "end": 2057.61, "text": "就可以居高临下"}, {"start": 2057.61, "end": 2058.61, "text": "威胁中原"}, {"start": 2058.61, "end": 2060.61, "text": "若让曹操占取汉中"}, {"start": 2060.61, "end": 2061.61, "text": "我们就能够"}, {"start": 2061.61, "end": 2062.61, "text": "对"}, {"start": 2062.61, "end": 2063.61, "text": "一定要拿下汉中"}, {"start": 2063.61, "end": 2064.61, "text": "拿下汉中"}, {"start": 2064.61, "end": 2065.61, "text": "拿下汉中"}, {"start": 2066.61, "end": 2067.61, "text": "孔明"}, {"start": 2067.61, "end": 2068.61, "text": "你何意"}, {"start": 2069.61, "end": 2070.61, "text": "我有些忧虑"}, {"start": 2071.61, "end": 2073.61, "text": "如果禁起蜀中三军"}, {"start": 2073.61, "end": 2079.22, "text": "万一荆州有事"}, {"start": 2079.22, "end": 2084.83, "text": "如何应对"}, {"start": 2086.83, "end": 2087.83, "text": "先生"}, {"start": 2087.83, "end": 2088.83, "text": "你这人"}, {"start": 2088.83, "end": 2089.83, "text": "是样样都好"}, {"start": 2089.83, "end": 2091.83, "text": "就是太过谨慎了"}, {"start": 2091.83, "end": 2092.83, "text": "你杀了他"}, {"start": 2093.83, "end": 2094.83, "text": "你杀了他"}, {"start": 2095.83, "end": 2096.83, "text": "你杀了他"}, {"start": 2096.83, "end": 2097.83, "text": "我杀了他"}, {"start": 2097.83, "end": 2098.83, "text": "你太过谨慎了"}, {"start": 2099.83, "end": 2100.83, "text": "你想想"}, {"start": 2100.83, "end": 2102.83, "text": "如果我们禁起三军"}, {"start": 2102.83, "end": 2103.83, "text": "进攻汉中"}, {"start": 2103.83, "end": 2104.83, "text": "那曹操"}, {"start": 2104.83, "end": 2106.83, "text": "哪还有力量难顾啊"}, {"start": 2106.83, "end": 2107.83, "text": "除了曹操"}, {"start": 2107.83, "end": 2108.83, "text": "还有孙全呢"}, {"start": 2110.83, "end": 2111.83, "text": "这江东蜀碑"}, {"start": 2111.83, "end": 2112.83, "text": "却是云城之地啊"}, {"start": 2112.83, "end": 2118.16, "text": "我还是心存忧虑"}, {"start": 2118.16, "end": 2130.53, "text": "我决定了"}, {"start": 2130.53, "end": 2132.53, "text": "徽军攻取汉中"}, {"start": 2132.53, "end": 2135.53, "text": "与曹操一决刺凶"}, {"start": 2135.53, "end": 2136.53, "text": "遵命"}, {"start": 2136.53, "end": 2141.27, "text": "孔明"}, {"start": 2142.27, "end": 2144.27, "text": "机不可失"}, {"start": 2144.27, "end": 2145.27, "text": "只不再来"}, {"start": 2146.27, "end": 2147.27, "text": "我想"}, {"start": 2147.27, "end": 2149.27, "text": "我们越快攻取汉中"}, {"start": 2149.27, "end": 2150.27, "text": "荆州就越安全"}, {"start": 2164.2, "end": 2165.2, "text": "主公"}, {"start": 2166.2, "end": 2167.2, "text": "那里就是主公"}, {"start": 2167.2, "end": 2168.2, "text": "昔日插剑的地方"}, {"start": 2169.2, "end": 2172.09, "text": "青龙门"}, {"start": 2172.09, "end": 2174.09, "text": "真是龙盘虎拒"}, {"start": 2174.09, "end": 2175.09, "text": "气象万千哪"}, {"start": 2176.09, "end": 2177.09, "text": "主公啊"}, {"start": 2178.09, "end": 2179.09, "text": "曹操来信"}, {"start": 2179.09, "end": 2182.09, "text": "想让主公去攻打荆州"}, {"start": 2183.09, "end": 2184.09, "text": "刘备也来信"}, {"start": 2184.09, "end": 2186.09, "text": "想让主公去攻打曹操"}, {"start": 2186.09, "end": 2187.09, "text": "这二人"}, {"start": 2187.09, "end": 2189.09, "text": "都是折腰降尊"}, {"start": 2189.09, "end": 2190.09, "text": "有求于主公"}, {"start": 2191.09, "end": 2193.09, "text": "这是东吴的大好时机啊"}, {"start": 2193.09, "end": 2195.09, "text": "不知主公如何决断"}, {"start": 2196.09, "end": 2198.34, "text": "你看"}, {"start": 2199.34, "end": 2201.34, "text": "我是应该答应曹操呢"}, {"start": 2202.34, "end": 2204.34, "text": "还是应该答应刘备呢"}, {"start": 2204.34, "end": 2206.34, "text": "在下建议主公"}, {"start": 2206.34, "end": 2208.34, "text": "两边都答应着"}, {"start": 2209.34, "end": 2210.34, "text": "但是"}, {"start": 2210.34, "end": 2212.34, "text": "都不发明"}, {"start": 2213.34, "end": 2214.34, "text": "目前"}, {"start": 2214.34, "end": 2216.34, "text": "曹刘都是孤注一掷"}, {"start": 2216.34, "end": 2217.34, "text": "血拼汉中"}, {"start": 2218.34, "end": 2220.34, "text": "主公可以静观其变"}, {"start": 2221.34, "end": 2223.34, "text": "看看到底是谁胜谁负"}, {"start": 2224.34, "end": 2225.34, "text": "到时候再决定"}, {"start": 2225.34, "end": 2227.34, "text": "是攻曹还是攻刘"}, {"start": 2229.34, "end": 2230.34, "text": "至于荆州"}, {"start": 2230.34, "end": 2231.34, "text": "放在那里"}, {"start": 2231.34, "end": 2232.34, "text": "他也跑不掉"}, {"start": 2233.34, "end": 2234.34, "text": "如果曹操胜"}, {"start": 2235.34, "end": 2236.34, "text": "荆州自然是主公的"}, {"start": 2238.34, "end": 2239.34, "text": "如果刘备胜了"}, {"start": 2240.34, "end": 2241.34, "text": "就算主公现在"}, {"start": 2241.34, "end": 2242.34, "text": "拿下了荆州"}, {"start": 2242.34, "end": 2243.34, "text": "只怕到时候"}, {"start": 2243.34, "end": 2245.34, "text": "也会引来刘备的大军的"}, {"start": 2247.34, "end": 2248.34, "text": "好主意"}, {"start": 2248.34, "end": 2250.34, "text": "我两边都答应"}, {"start": 2251.34, "end": 2253.58, "text": "但却都不出兵"}, {"start": 2254.58, "end": 2255.58, "text": "不过"}, {"start": 2255.58, "end": 2257.58, "text": "我还想更进一步"}, {"start": 2258.58, "end": 2260.58, "text": "立刻书信给曹操"}, {"start": 2261.58, "end": 2263.58, "text": "向他索要十万粮草"}, {"start": 2264.58, "end": 2265.58, "text": "以备攻刘所用"}, {"start": 2266.58, "end": 2268.58, "text": "再向刘备索要十万粮草"}, {"start": 2269.58, "end": 2270.58, "text": "以备"}, {"start": 2270.58, "end": 2271.58, "text": "攻曹所用"}, {"start": 2272.58, "end": 2273.58, "text": "你看如何"}, {"start": 2274.58, "end": 2276.86, "text": "主公英明"}, {"start": 2277.86, "end": 2278.86, "text": "依眼下的情况"}, {"start": 2279.86, "end": 2280.86, "text": "主公向他们要什么"}, {"start": 2281.86, "end": 2282.86, "text": "他们都会给的"}, {"start": 2282.86, "end": 2283.86, "text": "不过"}, {"start": 2284.86, "end": 2288.69, "text": "我现在还在想一件事"}, {"start": 2290.69, "end": 2291.69, "text": "如果此时此刻"}, {"start": 2292.69, "end": 2294.69, "text": "在汉中击占的不是曹刘"}, {"start": 2295.69, "end": 2296.69, "text": "而是我们"}, {"start": 2297.69, "end": 2298.69, "text": "你看"}, {"start": 2298.69, "end": 2302.03, "text": "我们能够取胜吗"}, {"start": 2302.03, "end": 2303.03, "text": "只怕不能"}, {"start": 2304.03, "end": 2308.14, "text": "为何"}, {"start": 2309.14, "end": 2310.14, "text": "远野作战"}, {"start": 2311.14, "end": 2313.14, "text": "仰仗的是铁技和战甲"}, {"start": 2314.14, "end": 2316.14, "text": "我江东的水师天下无比"}, {"start": 2317.14, "end": 2318.14, "text": "可是布技"}, {"start": 2318.14, "end": 2319.14, "text": "皆不如曹刘"}, {"start": 2321.14, "end": 2322.14, "text": "这也是我们"}, {"start": 2322.14, "end": 2324.14, "text": "多年拒守江东"}, {"start": 2324.14, "end": 2325.14, "text": "无法远途的原因之一"}, {"start": 2327.14, "end": 2328.14, "text": "主公"}, {"start": 2328.14, "end": 2330.14, "text": "我们自保有余"}, {"start": 2330.14, "end": 2332.14, "text": "可想要夺取天下"}, {"start": 2332.14, "end": 2333.14, "text": "就必须要有一支"}, {"start": 2333.14, "end": 2335.14, "text": "装备精良的铁技"}, {"start": 2335.14, "end": 2336.14, "text": "陆迅"}, {"start": 2337.14, "end": 2338.14, "text": "我为何要找你来"}, {"start": 2338.14, "end": 2342.91, "text": "明白吗"}, {"start": 2343.91, "end": 2344.91, "text": "明白"}, {"start": 2345.91, "end": 2346.91, "text": "主公是要我"}, {"start": 2350.54, "end": 2351.54, "text": "抓住时机"}, {"start": 2352.54, "end": 2353.54, "text": "训练铁技"}, {"start": 2353.54, "end": 2354.54, "text": "没错"}, {"start": 2355.54, "end": 2356.54, "text": "命你为东吴副董"}, {"start": 2357.54, "end": 2359.54, "text": "立即招募壮士"}, {"start": 2359.54, "end": 2360.54, "text": "训练出一万铁技"}, {"start": 2360.54, "end": 2361.54, "text": "和一万战甲"}, {"start": 2362.54, "end": 2363.54, "text": "以备将来所用"}, {"start": 2364.54, "end": 2365.54, "text": "从此以后"}, {"start": 2365.54, "end": 2366.54, "text": "以备将来所用"}, {"start": 2367.54, "end": 2368.54, "text": "遵命"}, {"start": 2373.28, "end": 2375.28, "text": "我从刘备和曹操那儿"}, {"start": 2375.28, "end": 2376.28, "text": "拿来的二十万粮草"}, {"start": 2377.28, "end": 2378.28, "text": "就都交给你了"}, {"start": 2380.28, "end": 2381.28, "text": "谢主公"}, {"start": 2389.86, "end": 2425.02, "text": "全面发起冲杀"}, {"start": 2425.02, "end": 2426.02, "text": "不留任何后备"}, {"start": 2427.02, "end": 2428.02, "text": "有切斩者"}, {"start": 2428.02, "end": 2429.02, "text": "格查无论"}, {"start": 2430.02, "end": 2431.02, "text": "可在之后"}, {"start": 2431.02, "end": 2432.02, "text": "定要斩杀夏侯渊"}, {"start": 2433.02, "end": 2434.02, "text": "他是曹操的上将"}, {"start": 2435.02, "end": 2436.02, "text": "他一死"}, {"start": 2436.02, "end": 2438.02, "text": "曹军就会全线动摇"}, {"start": 2438.02, "end": 2439.02, "text": "奴隶"}]