[{"start": 18.19, "end": 19.19, "text": "国家"}, {"start": 19.69, "end": 20.19, "text": "在"}, {"start": 20.19, "end": 24.72, "text": "徐州情况如何"}, {"start": 24.72, "end": 27.72, "text": "刚刚收到陈规陈登父子二人书信"}, {"start": 27.72, "end": 29.72, "text": "其二人深得吕布信任"}, {"start": 29.72, "end": 31.72, "text": "已被请入徐州将军府了"}, {"start": 32.72, "end": 33.72, "text": "好"}, {"start": 34.72, "end": 35.72, "text": "告诉他们"}, {"start": 36.72, "end": 37.72, "text": "务必"}, {"start": 37.72, "end": 39.72, "text": "要离间吕布"}, {"start": 40.72, "end": 41.72, "text": "和陈公的关系"}, {"start": 42.72, "end": 44.72, "text": "使陈公丧失信任"}, {"start": 44.72, "end": 45.72, "text": "逐步被变"}, {"start": 46.72, "end": 47.72, "text": "同时"}, {"start": 48.72, "end": 51.72, "text": "要设法击驶吕布和刘备交恶"}, {"start": 52.72, "end": 54.72, "text": "待徐州城中大乱"}, {"start": 54.72, "end": 56.72, "text": "咱们就可以趁乱"}, {"start": 56.72, "end": 57.72, "text": "拿下徐州"}, {"start": 58.72, "end": 59.72, "text": "待事成之后"}, {"start": 60.72, "end": 62.72, "text": "我就会表奏天子"}, {"start": 62.72, "end": 64.72, "text": "册封陈规为"}, {"start": 64.72, "end": 65.72, "text": "徐州太守"}, {"start": 66.72, "end": 67.72, "text": "请主公放心"}, {"start": 67.72, "end": 68.72, "text": "陈氏父子"}, {"start": 68.72, "end": 69.72, "text": "足智多谋"}, {"start": 69.72, "end": 71.72, "text": "定不负主公众望"}, {"start": 72.72, "end": 76.44, "text": "好"}, {"start": 77.44, "end": 78.44, "text": "走吧"}, {"start": 78.44, "end": 83.44, "text": "继续"}, {"start": 83.44, "end": 101.02, "text": "上将军"}, {"start": 101.02, "end": 102.02, "text": "方金大事"}, {"start": 102.02, "end": 104.02, "text": "谁能得到上将军相助"}, {"start": 104.02, "end": 106.02, "text": "谁便能主掌天下"}, {"start": 106.02, "end": 108.02, "text": "元树就是因为没有得到"}, {"start": 108.02, "end": 109.02, "text": "上将军相助"}, {"start": 109.02, "end": 111.02, "text": "这才兵败寿春"}, {"start": 111.02, "end": 113.02, "text": "成千古遗恨"}, {"start": 114.02, "end": 116.02, "text": "我儿此话不然"}, {"start": 116.02, "end": 118.02, "text": "凭上将军之勇略"}, {"start": 118.02, "end": 120.02, "text": "足可以助守徐州"}, {"start": 120.02, "end": 121.02, "text": "而得中原"}, {"start": 122.02, "end": 125.02, "text": "之后得中原而得天下"}, {"start": 125.02, "end": 128.02, "text": "为何辅助元树等辈"}, {"start": 128.02, "end": 129.02, "text": "父亲说得对"}, {"start": 129.02, "end": 131.02, "text": "上将军统领的骁勇骑兵"}, {"start": 131.02, "end": 133.02, "text": "无人能与之争锋"}, {"start": 133.02, "end": 135.02, "text": "上将军的胯下赤兔马"}, {"start": 135.02, "end": 136.02, "text": "手中的方天锦"}, {"start": 136.02, "end": 138.02, "text": "更是天下无敌"}, {"start": 138.02, "end": 140.02, "text": "上将军应该独领风骚"}, {"start": 140.02, "end": 142.02, "text": "自成罢业"}, {"start": 142.02, "end": 143.02, "text": "这个当然"}, {"start": 145.94, "end": 146.94, "text": "不过"}, {"start": 146.94, "end": 148.94, "text": "仍需你们贤父子"}, {"start": 148.94, "end": 150.94, "text": "好生辅佐我才行"}, {"start": 150.94, "end": 152.94, "text": "不宜选儿"}, {"start": 152.94, "end": 154.94, "text": "备受上将军的宠爱"}, {"start": 154.94, "end": 156.94, "text": "更应赤诚报答"}, {"start": 156.94, "end": 157.94, "text": "家父与我"}, {"start": 157.94, "end": 159.94, "text": "也只有辅佐上将军"}, {"start": 159.94, "end": 160.94, "text": "成就功名霸业"}, {"start": 160.94, "end": 162.94, "text": "方能不屈此生啊"}, {"start": 164.94, "end": 165.94, "text": "好 好"}, {"start": 165.94, "end": 166.94, "text": "来来来"}, {"start": 166.94, "end": 168.94, "text": "跟我共敬一杯"}, {"start": 168.94, "end": 169.94, "text": "公台先生来了"}, {"start": 169.94, "end": 176.28, "text": "快请入席"}, {"start": 177.28, "end": 179.28, "text": "你们父子二人退下"}, {"start": 179.28, "end": 181.28, "text": "我跟奉贤有话要说"}, {"start": 181.28, "end": 182.28, "text": "不必走远"}, {"start": 188.02, "end": 189.02, "text": "就在庭外候着"}, {"start": 189.02, "end": 190.02, "text": "奉贤哪"}, {"start": 191.02, "end": 202.07, "text": "我听说你把他们父子二人"}, {"start": 202.07, "end": 204.07, "text": "请到内府来居住了"}, {"start": 204.07, "end": 205.07, "text": "是啊"}, {"start": 205.07, "end": 208.07, "text": "还拜了他们为左右参加"}, {"start": 208.07, "end": 209.07, "text": "没错"}, {"start": 210.07, "end": 211.07, "text": "奉贤哪"}, {"start": 211.07, "end": 212.07, "text": "他们父子二人"}, {"start": 212.07, "end": 215.07, "text": "那可是卑躬屈膝的小人"}, {"start": 216.07, "end": 218.07, "text": "当初在陶谦仗下"}, {"start": 218.07, "end": 220.07, "text": "他们就暗通袁绍"}, {"start": 220.07, "end": 222.07, "text": "去偷鸡去零"}, {"start": 222.07, "end": 223.07, "text": "背主求荣"}, {"start": 223.07, "end": 225.07, "text": "后来被陶谦察觉之后"}, {"start": 225.07, "end": 226.07, "text": "差点被杀"}, {"start": 226.07, "end": 227.07, "text": "只是因为陶谦"}, {"start": 227.07, "end": 228.07, "text": "一时心软"}, {"start": 228.07, "end": 230.07, "text": "才免他们一死"}, {"start": 230.07, "end": 231.07, "text": "霸之不用"}, {"start": 231.07, "end": 232.07, "text": "今天怎么"}, {"start": 232.07, "end": 234.07, "text": "怎么跑到你的面前来了"}, {"start": 234.07, "end": 235.07, "text": "还跟他们搞得"}, {"start": 235.07, "end": 236.07, "text": "如此的情投意识"}, {"start": 236.07, "end": 237.07, "text": "弓台"}, {"start": 237.07, "end": 242.89, "text": "陈规陈登对我忠心耿耿"}, {"start": 242.89, "end": 243.89, "text": "你何必妒忌他们呢"}, {"start": 244.89, "end": 245.89, "text": "什么"}, {"start": 245.89, "end": 247.89, "text": "我妒忌他们这对小人"}, {"start": 249.89, "end": 250.89, "text": "奉贤哪"}, {"start": 250.89, "end": 256.67, "text": "杀肠征战是你所成"}, {"start": 256.67, "end": 257.67, "text": "可是查人官事"}, {"start": 257.67, "end": 259.67, "text": "是你所短"}, {"start": 259.67, "end": 260.67, "text": "今天他们对你"}, {"start": 260.67, "end": 261.67, "text": "如此的奉承"}, {"start": 261.67, "end": 262.67, "text": "是必有所图"}, {"start": 262.67, "end": 264.67, "text": "你万万不要被他们的"}, {"start": 264.67, "end": 266.67, "text": "甜言蜜语所迷惑了呀"}, {"start": 266.67, "end": 267.67, "text": "成功"}, {"start": 267.67, "end": 268.67, "text": "你无端金蝉"}, {"start": 268.67, "end": 269.67, "text": "想陷害好人吗"}, {"start": 269.67, "end": 270.67, "text": "好人"}, {"start": 270.67, "end": 272.67, "text": "他们是一对奸贼"}, {"start": 272.67, "end": 274.67, "text": "绝对不是什么好人"}, {"start": 274.67, "end": 275.67, "text": "是中世间"}, {"start": 275.67, "end": 276.67, "text": "我自有明察"}, {"start": 276.67, "end": 278.67, "text": "用不着你说三道四"}, {"start": 278.67, "end": 279.67, "text": "你别忘了"}, {"start": 280.67, "end": 281.67, "text": "在徐州城内"}, {"start": 281.67, "end": 282.67, "text": "我做主"}, {"start": 283.67, "end": 289.1, "text": "上将军有了陈氏父子"}, {"start": 290.1, "end": 292.1, "text": "用不着我成功了"}, {"start": 292.1, "end": 303.98, "text": "先生如果觉得委屈"}, {"start": 304.98, "end": 305.98, "text": "就让我做主"}, {"start": 305.98, "end": 306.98, "text": "我做主"}, {"start": 311.09, "end": 313.09, "text": "先生如果觉得委屈"}, {"start": 314.09, "end": 315.09, "text": "就请自便吧"}, {"start": 315.09, "end": 323.29, "text": "我走"}, {"start": 323.29, "end": 325.29, "text": "徐州城大火不远了"}, {"start": 325.29, "end": 327.29, "text": "是你待"}, {"start": 328.29, "end": 329.29, "text": "沈便"}, {"start": 329.29, "end": 340.13, "text": "替我请两位参军进来喝酒"}, {"start": 340.13, "end": 341.13, "text": "为人臣者"}, {"start": 341.13, "end": 344.13, "text": "岂可对主公耳提面命"}, {"start": 344.13, "end": 346.13, "text": "非但耳提面命"}, {"start": 346.13, "end": 348.13, "text": "还想将主公置于掌中"}, {"start": 348.13, "end": 351.13, "text": "这可是不识时务"}, {"start": 356.83, "end": 357.83, "text": "父子二人"}, {"start": 357.83, "end": 360.83, "text": "这酒里边到底放了什么毒药"}, {"start": 360.83, "end": 362.83, "text": "先生不是说过吗"}, {"start": 362.83, "end": 364.83, "text": "拭目以待"}, {"start": 368.21, "end": 370.21, "text": "公台先生走好"}, {"start": 370.21, "end": 380.66, "text": "小小得知"}, {"start": 381.66, "end": 382.66, "text": "如此下去"}, {"start": 382.66, "end": 384.66, "text": "非但徐州不保"}, {"start": 384.66, "end": 387.66, "text": "连我也会大祸临头的"}, {"start": 387.66, "end": 401.78, "text": "明主何在"}, {"start": 402.78, "end": 404.78, "text": "何处是我立身之地"}, {"start": 404.78, "end": 410.18, "text": "吕布虽然愚蠢"}, {"start": 410.18, "end": 414.93, "text": "此人心性之爽"}, {"start": 414.93, "end": 415.93, "text": "来人哪"}, {"start": 415.93, "end": 428.16, "text": "先生"}, {"start": 428.16, "end": 435.92, "text": "备马"}, {"start": 435.92, "end": 437.92, "text": "我要出城设令"}, {"start": 437.92, "end": 438.92, "text": "诺"}, {"start": 438.92, "end": 465.36, "text": "快快拿下"}, {"start": 465.36, "end": 466.36, "text": "诺"}, {"start": 466.36, "end": 481.54, "text": "按通曹操"}, {"start": 481.54, "end": 483.54, "text": "图谋我徐州"}, {"start": 483.54, "end": 485.89, "text": "上将军"}, {"start": 485.89, "end": 486.89, "text": "刘备一直记恨你"}, {"start": 486.89, "end": 487.89, "text": "夺了他的徐州"}, {"start": 487.89, "end": 490.89, "text": "却又无法同上将军相争"}, {"start": 490.89, "end": 491.89, "text": "怎么办呢"}, {"start": 491.89, "end": 492.89, "text": "他只好按通曹操"}, {"start": 492.89, "end": 493.89, "text": "以便借曹军之力"}, {"start": 493.89, "end": 495.89, "text": "夺回徐州"}, {"start": 495.89, "end": 497.89, "text": "在下早就看出来了"}, {"start": 497.89, "end": 500.89, "text": "刘备大奸四中大伪四真"}, {"start": 500.89, "end": 502.89, "text": "表面上道貌黯然"}, {"start": 502.89, "end": 504.89, "text": "实际上却暗藏祸心"}, {"start": 504.89, "end": 507.89, "text": "是个百年罕见的伪君子"}, {"start": 508.89, "end": 509.89, "text": "说得好啊"}, {"start": 510.89, "end": 513.68, "text": "太好了"}, {"start": 514.68, "end": 515.68, "text": "尤其是"}, {"start": 515.68, "end": 519.68, "text": "大奸四中大伪四真的妙语"}, {"start": 519.68, "end": 521.68, "text": "堪称精辟啊"}, {"start": 522.68, "end": 524.68, "text": "不过中间真伪者"}, {"start": 524.68, "end": 526.68, "text": "难道仅仅是刘备一人"}, {"start": 526.68, "end": 528.68, "text": "在我们徐州城里"}, {"start": 528.68, "end": 530.68, "text": "就没有其他的奸贼了吗"}, {"start": 530.68, "end": 533.92, "text": "还有奸贼"}, {"start": 534.92, "end": 535.92, "text": "是谁"}, {"start": 535.92, "end": 541.27, "text": "禀上将军"}, {"start": 541.27, "end": 544.27, "text": "公台先生是在说我"}, {"start": 545.27, "end": 546.27, "text": "没错"}, {"start": 547.27, "end": 549.27, "text": "我说的就是你们父子二人"}, {"start": 550.27, "end": 552.27, "text": "如果我成功没有看错的话"}, {"start": 552.27, "end": 554.27, "text": "你父子二人就真正是"}, {"start": 554.27, "end": 556.27, "text": "道貌黯然 满腹祸心"}, {"start": 556.27, "end": 557.27, "text": "先生何出此言"}, {"start": 557.27, "end": 558.27, "text": "何出此言"}, {"start": 558.27, "end": 559.27, "text": "在你父子二人"}, {"start": 559.27, "end": 561.27, "text": "没有进入将军府之前"}, {"start": 561.27, "end": 564.27, "text": "徐州城里太平无事"}, {"start": 564.27, "end": 566.27, "text": "在你父子进入将军府之后"}, {"start": 566.27, "end": 568.27, "text": "徐州城里是非不断"}, {"start": 569.27, "end": 572.27, "text": "先是曹操赐奉将军为徐州牧"}, {"start": 573.27, "end": 574.27, "text": "再是徐州城里出现了"}, {"start": 574.27, "end": 577.27, "text": "大量刑纪可疑的眼中伤犯"}, {"start": 577.27, "end": 579.27, "text": "今天又有了这封密信"}, {"start": 580.27, "end": 581.27, "text": "说"}, {"start": 581.27, "end": 583.27, "text": "你父子二人是曹操的奸细"}, {"start": 583.27, "end": 584.27, "text": "还是刘备的奸细"}, {"start": 584.27, "end": 587.27, "text": "或者同是曹操刘备的奸细吗"}, {"start": 587.27, "end": 604.19, "text": "将军斩下我的头颅"}, {"start": 604.19, "end": 607.19, "text": "已是成功之矣"}, {"start": 607.19, "end": 612.48, "text": "成功"}, {"start": 613.48, "end": 615.48, "text": "你说陈登是奸贼"}, {"start": 615.48, "end": 616.48, "text": "可有屏障"}, {"start": 617.48, "end": 618.48, "text": "虽无屏障"}, {"start": 619.48, "end": 621.48, "text": "但是我相信我陈功的眼睛"}, {"start": 622.48, "end": 624.48, "text": "上将军都听见了吧"}, {"start": 624.48, "end": 628.48, "text": "御驾之罪何患无辞啊"}, {"start": 629.48, "end": 634.61, "text": "陈功"}, {"start": 635.61, "end": 637.61, "text": "我多次劝你不要嫉贺人家"}, {"start": 637.61, "end": 638.61, "text": "可你呢"}, {"start": 638.61, "end": 640.61, "text": "总是疑心生暗鬼"}, {"start": 640.61, "end": 641.61, "text": "蛊惑人心"}, {"start": 641.61, "end": 642.61, "text": "我告诉你"}, {"start": 642.61, "end": 643.61, "text": "陈登自入府以来"}, {"start": 643.61, "end": 645.61, "text": "屡屡说你的好话"}, {"start": 645.61, "end": 647.61, "text": "承赞你学府武车"}, {"start": 647.61, "end": 648.61, "text": "志谋过人"}, {"start": 649.61, "end": 651.61, "text": "还赞为当今第一谋士"}, {"start": 651.61, "end": 652.61, "text": "而你呢"}, {"start": 653.61, "end": 654.61, "text": "是吗"}, {"start": 654.61, "end": 655.61, "text": "他们当然会在你面前"}, {"start": 655.61, "end": 658.91, "text": "称赞我"}, {"start": 658.91, "end": 660.91, "text": "要不哪儿来的大奸似中"}, {"start": 660.91, "end": 662.91, "text": "大伟似真呢"}, {"start": 662.91, "end": 663.91, "text": "陈功"}, {"start": 664.91, "end": 668.61, "text": "快向陈登赔罪"}, {"start": 668.61, "end": 669.61, "text": "小除误会"}, {"start": 669.61, "end": 671.61, "text": "尽是前嫌"}, {"start": 671.61, "end": 672.61, "text": "绝对不"}, {"start": 673.61, "end": 674.61, "text": "听着"}, {"start": 675.61, "end": 676.61, "text": "听着"}, {"start": 676.61, "end": 682.0, "text": "我令你向他赔罪"}, {"start": 683.0, "end": 684.0, "text": "将军"}, {"start": 684.0, "end": 686.0, "text": "陈登刚才已经把配件"}, {"start": 686.0, "end": 687.0, "text": "呈予你"}, {"start": 687.0, "end": 688.0, "text": "你何不拿着配件"}, {"start": 688.0, "end": 690.0, "text": "就把我给杀了"}, {"start": 690.0, "end": 693.5, "text": "向奸贼赔罪"}, {"start": 693.5, "end": 694.5, "text": "休想"}, {"start": 695.5, "end": 696.5, "text": "你"}, {"start": 696.5, "end": 697.5, "text": "上将军"}, {"start": 697.5, "end": 699.5, "text": "在下岂敢让公台先生"}, {"start": 699.5, "end": 700.5, "text": "给我赔罪"}, {"start": 700.5, "end": 703.5, "text": "还是我向公台先生赔罪了"}, {"start": 703.5, "end": 707.77, "text": "公台先生"}, {"start": 707.77, "end": 708.77, "text": "尽管放心"}, {"start": 709.77, "end": 710.77, "text": "在下与家父"}, {"start": 710.77, "end": 712.77, "text": "虽然节程辅佐上将军"}, {"start": 712.77, "end": 713.77, "text": "但我们永远也不敢"}, {"start": 713.77, "end": 715.77, "text": "取代先生的军师大位"}, {"start": 715.77, "end": 716.77, "text": "在下与家父"}, {"start": 716.77, "end": 718.77, "text": "定会奉先生为师"}, {"start": 718.77, "end": 721.77, "text": "共同为上将军效命"}, {"start": 721.77, "end": 727.35, "text": "先生听见了吧"}, {"start": 727.35, "end": 729.35, "text": "人家是何等胸怀"}, {"start": 729.35, "end": 730.35, "text": "何等气度"}, {"start": 730.35, "end": 737.69, "text": "是奸"}, {"start": 738.69, "end": 739.69, "text": "走着瞧"}, {"start": 739.69, "end": 747.7, "text": "刘备暗通曹操"}, {"start": 747.7, "end": 748.7, "text": "图谋徐州"}, {"start": 749.7, "end": 750.7, "text": "本将决定"}, {"start": 751.7, "end": 752.7, "text": "出兵剿灭刘备"}, {"start": 752.7, "end": 756.3, "text": "以灭后患"}, {"start": 756.3, "end": 757.3, "text": "众将听着"}, {"start": 759.3, "end": 760.3, "text": "令张梁高顺"}, {"start": 761.3, "end": 762.3, "text": "令一万骑兵"}, {"start": 763.3, "end": 764.3, "text": "夜袭关羽营寨"}, {"start": 765.3, "end": 766.3, "text": "令宋县魏旭"}, {"start": 767.3, "end": 768.3, "text": "引军一万"}, {"start": 768.3, "end": 769.3, "text": "断其后路"}, {"start": 770.3, "end": 772.3, "text": "本将自捅大军"}, {"start": 772.3, "end": 773.3, "text": "攻取小配"}, {"start": 774.3, "end": 775.3, "text": "由我亲手"}, {"start": 775.3, "end": 777.3, "text": "斩杀张飞那死"}, {"start": 778.3, "end": 779.3, "text": "等大军出城之后"}, {"start": 780.3, "end": 781.3, "text": "令陈归陈登"}, {"start": 781.3, "end": 782.3, "text": "守备徐州"}, {"start": 784.3, "end": 786.3, "text": "众将不得有误"}, {"start": 786.3, "end": 787.3, "text": "遵命"}, {"start": 787.3, "end": 792.98, "text": "各位即刻整军"}, {"start": 793.98, "end": 794.98, "text": "等天黑之后"}, {"start": 794.98, "end": 795.98, "text": "到南关集结"}, {"start": 796.98, "end": 797.98, "text": "待命出发"}, {"start": 798.98, "end": 799.98, "text": "诺"}, {"start": 799.98, "end": 812.79, "text": "奉宪达"}, {"start": 813.79, "end": 815.79, "text": "还是让我来留守徐州"}, {"start": 815.79, "end": 816.79, "text": "不成"}, {"start": 817.79, "end": 818.79, "text": "你神之兵法"}, {"start": 819.79, "end": 820.79, "text": "临敌之时"}, {"start": 820.79, "end": 821.79, "text": "还需要你出谋划策呢"}, {"start": 822.79, "end": 823.79, "text": "可是你把一家老小"}, {"start": 823.79, "end": 824.79, "text": "整座城池"}, {"start": 825.79, "end": 827.79, "text": "都交到那对父子手里"}, {"start": 827.79, "end": 828.79, "text": "一旦有失"}, {"start": 828.79, "end": 829.79, "text": "如何是好"}, {"start": 829.79, "end": 842.34, "text": "先生"}, {"start": 842.34, "end": 844.72, "text": "你还是信不过他们"}, {"start": 844.72, "end": 845.72, "text": "是不信"}, {"start": 846.72, "end": 849.58, "text": "先生"}, {"start": 849.58, "end": 850.58, "text": "你姓陈"}, {"start": 850.58, "end": 851.58, "text": "他们也姓陈"}, {"start": 852.58, "end": 853.58, "text": "为何诸臣之间"}, {"start": 853.58, "end": 855.58, "text": "总是水火不容"}, {"start": 856.58, "end": 859.46, "text": "我从没听过他们攻击你"}, {"start": 860.46, "end": 861.46, "text": "却老是听你在背后"}, {"start": 861.46, "end": 862.46, "text": "重伤他们"}, {"start": 863.46, "end": 864.46, "text": "奉宪啊"}, {"start": 864.46, "end": 866.46, "text": "我现在暂且不论"}, {"start": 866.46, "end": 868.46, "text": "陈家父子的中和间"}, {"start": 868.46, "end": 869.46, "text": "我只说徐州"}, {"start": 870.46, "end": 871.46, "text": "徐州是我们的根据"}, {"start": 872.46, "end": 873.46, "text": "命脉之所在"}, {"start": 873.46, "end": 874.46, "text": "绝不如是"}, {"start": 874.46, "end": 875.46, "text": "所以无论如何"}, {"start": 875.46, "end": 876.46, "text": "要交到我们"}, {"start": 876.46, "end": 877.46, "text": "值得信任的将军"}, {"start": 877.46, "end": 878.46, "text": "手里来驻防"}, {"start": 879.46, "end": 880.46, "text": "依我看"}, {"start": 881.46, "end": 883.46, "text": "不如在张廖和高顺之间"}, {"start": 884.46, "end": 885.46, "text": "选一人留守"}, {"start": 886.46, "end": 888.94, "text": "不"}, {"start": 888.94, "end": 892.69, "text": "刘备兵虽少"}, {"start": 892.69, "end": 893.69, "text": "但他有关羽"}, {"start": 893.69, "end": 897.03, "text": "张飞 赵云这几员猛将"}, {"start": 898.03, "end": 899.03, "text": "而我又不能一一抵三"}, {"start": 900.03, "end": 901.03, "text": "所以张廖 高顺"}, {"start": 903.63, "end": 904.63, "text": "必须随我临敌"}, {"start": 905.63, "end": 906.63, "text": "但是无论如何"}, {"start": 906.63, "end": 908.63, "text": "也要把那对父子分开"}, {"start": 908.63, "end": 909.63, "text": "一人留守"}, {"start": 909.63, "end": 910.63, "text": "另一人随军"}, {"start": 910.63, "end": 911.63, "text": "也好"}, {"start": 911.63, "end": 917.15, "text": "那我让其父 陈归"}, {"start": 917.15, "end": 918.15, "text": "守城"}, {"start": 919.15, "end": 920.15, "text": "我让其子 陈登"}, {"start": 920.15, "end": 921.15, "text": "随军"}, {"start": 921.15, "end": 922.15, "text": "先生"}, {"start": 922.15, "end": 925.66, "text": "你不是最讨厌陈登吗"}, {"start": 926.66, "end": 927.66, "text": "那我带着他出发"}, {"start": 927.66, "end": 929.66, "text": "陈公虽然已经生疑"}, {"start": 929.66, "end": 964.38, "text": "但吕不信任我们"}, {"start": 964.38, "end": 965.38, "text": "无妨"}, {"start": 966.38, "end": 967.38, "text": "出城之后"}, {"start": 967.38, "end": 968.38, "text": "城外的事"}, {"start": 968.38, "end": 969.38, "text": "尽由我办理"}, {"start": 969.38, "end": 970.38, "text": "城内的事"}, {"start": 970.38, "end": 971.38, "text": "六守的两位将佐"}, {"start": 971.38, "end": 975.78, "text": "和六位校尉啊"}, {"start": 975.78, "end": 976.78, "text": "都已经被我收买了"}, {"start": 976.78, "end": 978.78, "text": "他们都愿意归顺朝廷"}, {"start": 978.78, "end": 979.78, "text": "不择守朝的位置啊"}, {"start": 979.78, "end": 981.78, "text": "也都是我亲自选定的"}, {"start": 993.12, "end": 994.12, "text": "父亲珍重"}, {"start": 995.12, "end": 996.12, "text": "我儿珍重啊"}, {"start": 996.12, "end": 997.12, "text": "带着三千铁锡"}, {"start": 997.12, "end": 998.12, "text": "去盗斗战司"}, {"start": 998.12, "end": 999.12, "text": "别动"}, {"start": 999.12, "end": 1000.12, "text": "不可接战"}, {"start": 1000.12, "end": 1073.47, "text": "秘方何在"}, {"start": 1074.47, "end": 1075.47, "text": "主公"}, {"start": 1075.47, "end": 1081.37, "text": "估计不到一炷香的功夫"}, {"start": 1081.37, "end": 1082.37, "text": "整个城池"}, {"start": 1082.37, "end": 1083.37, "text": "就个被吕不韦的"}, {"start": 1083.37, "end": 1086.42, "text": "水泄不通"}, {"start": 1087.42, "end": 1088.42, "text": "我现在写书信"}, {"start": 1088.42, "end": 1089.42, "text": "已经来不及了"}, {"start": 1089.42, "end": 1091.42, "text": "我召你火速出城"}, {"start": 1091.42, "end": 1092.42, "text": "前去向曹操求援"}, {"start": 1093.42, "end": 1094.42, "text": "令陆不韦"}, {"start": 1094.42, "end": 1095.42, "text": "和陈登"}, {"start": 1095.42, "end": 1096.42, "text": "前去向曹操求援"}, {"start": 1097.42, "end": 1099.42, "text": "令陆不韦关于大营时"}, {"start": 1099.42, "end": 1100.42, "text": "告诉他坚守待命"}, {"start": 1101.42, "end": 1102.42, "text": "在曹军到来之前"}, {"start": 1103.42, "end": 1105.42, "text": "万不可发兵圆佩城"}, {"start": 1105.42, "end": 1106.42, "text": "切记"}, {"start": 1106.42, "end": 1107.42, "text": "诺"}, {"start": 1108.42, "end": 1109.42, "text": "三弟"}, {"start": 1109.42, "end": 1110.42, "text": "在"}, {"start": 1110.42, "end": 1111.42, "text": "关闭各处城关"}, {"start": 1111.42, "end": 1113.42, "text": "令将士们上城拘敌"}, {"start": 1115.42, "end": 1116.42, "text": "这个贼律部"}, {"start": 1116.42, "end": 1129.22, "text": "只会偷袭"}, {"start": 1129.22, "end": 1130.22, "text": "大尔在何在"}, {"start": 1131.22, "end": 1132.22, "text": "刘备在此"}, {"start": 1133.22, "end": 1134.22, "text": "敢问奉先将军"}, {"start": 1134.22, "end": 1136.22, "text": "为何引军前来"}, {"start": 1136.22, "end": 1137.22, "text": "你勾结曹操"}, {"start": 1137.22, "end": 1139.22, "text": "涂抹我徐州"}, {"start": 1139.22, "end": 1143.5, "text": "将军定然是误会了"}, {"start": 1144.5, "end": 1145.5, "text": "在下"}, {"start": 1145.5, "end": 1147.5, "text": "只会与将军同心协力"}, {"start": 1147.5, "end": 1148.5, "text": "共保徐州"}, {"start": 1148.5, "end": 1150.5, "text": "绝不会勾结曹操"}, {"start": 1150.5, "end": 1151.5, "text": "谋取徐州"}, {"start": 1151.5, "end": 1153.5, "text": "因为徐州一师"}, {"start": 1153.5, "end": 1154.5, "text": "佩城也不保"}, {"start": 1155.5, "end": 1157.5, "text": "在下岂能做这等蠢事"}, {"start": 1159.5, "end": 1166.0, "text": "看见了吗"}, {"start": 1167.0, "end": 1169.0, "text": "这是曹操给你的密信"}, {"start": 1169.0, "end": 1171.0, "text": "被陈公缴获"}, {"start": 1171.0, "end": 1172.0, "text": "罪证确凿"}, {"start": 1172.0, "end": 1173.0, "text": "大尔在"}, {"start": 1174.0, "end": 1175.0, "text": "我待你不保"}, {"start": 1175.0, "end": 1176.0, "text": "为何怕我"}, {"start": 1177.0, "end": 1178.0, "text": "你外表忠厚"}, {"start": 1178.0, "end": 1180.0, "text": "内心却奸诈无比"}, {"start": 1181.0, "end": 1182.0, "text": "快开城门"}, {"start": 1182.0, "end": 1184.0, "text": "我可饶你不死"}, {"start": 1185.0, "end": 1186.0, "text": "否则的话"}, {"start": 1187.0, "end": 1188.0, "text": "我攻陷城池"}, {"start": 1189.0, "end": 1190.0, "text": "老受不留"}, {"start": 1190.0, "end": 1193.94, "text": "不是曹操的奸计"}, {"start": 1194.94, "end": 1195.94, "text": "就是陈公的奸计"}, {"start": 1195.94, "end": 1196.94, "text": "我就是曹操"}, {"start": 1196.94, "end": 1232.28, "text": "你是何人呢"}, {"start": 1233.28, "end": 1234.28, "text": "在下陈归侍从"}, {"start": 1234.28, "end": 1236.28, "text": "主公令我给曹将军禀报"}, {"start": 1236.28, "end": 1237.28, "text": "旅部已经中计"}, {"start": 1237.28, "end": 1238.28, "text": "率大军攻取古城"}, {"start": 1239.28, "end": 1240.28, "text": "配成去了"}, {"start": 1241.28, "end": 1242.28, "text": "太好了 太好了"}, {"start": 1243.28, "end": 1244.28, "text": "你马上回去告诉陈归"}, {"start": 1245.28, "end": 1246.28, "text": "让他仔细把守城池"}, {"start": 1246.28, "end": 1247.28, "text": "万不可放"}, {"start": 1247.28, "end": 1248.28, "text": "旅部回城"}, {"start": 1248.28, "end": 1250.28, "text": "我三天之内必到"}, {"start": 1250.28, "end": 1252.28, "text": "另外你告诉他们父子"}, {"start": 1253.28, "end": 1254.28, "text": "攻城之后"}, {"start": 1254.28, "end": 1256.28, "text": "朝廷必有重赏"}, {"start": 1256.28, "end": 1257.28, "text": "还有你"}, {"start": 1257.28, "end": 1258.28, "text": "在下遵命"}, {"start": 1259.28, "end": 1260.28, "text": "曹人"}, {"start": 1260.28, "end": 1261.28, "text": "在"}, {"start": 1261.28, "end": 1262.28, "text": "他的马不行了"}, {"start": 1262.28, "end": 1263.28, "text": "给他换匹马"}, {"start": 1263.28, "end": 1264.28, "text": "好"}, {"start": 1264.28, "end": 1265.28, "text": "另外"}, {"start": 1265.28, "end": 1266.28, "text": "传命前进"}, {"start": 1266.28, "end": 1267.28, "text": "加速前进"}, {"start": 1267.28, "end": 1287.16, "text": "诺"}, {"start": 1287.16, "end": 1288.16, "text": "你是何人呢"}, {"start": 1288.16, "end": 1290.16, "text": "旅部率大军攻打配城"}, {"start": 1290.16, "end": 1291.16, "text": "我家主公万吉"}, {"start": 1291.16, "end": 1293.16, "text": "令我向曹公求援呢"}, {"start": 1293.16, "end": 1294.16, "text": "知道了 知道了"}, {"start": 1294.16, "end": 1295.16, "text": "你没看到"}, {"start": 1295.16, "end": 1297.16, "text": "我现在正往徐州去吗"}, {"start": 1297.16, "end": 1298.16, "text": "曹公"}, {"start": 1298.16, "end": 1299.16, "text": "你怎么会预先知道"}, {"start": 1299.16, "end": 1301.16, "text": "旅部会攻打配城"}, {"start": 1301.16, "end": 1302.16, "text": "是啊 是啊"}, {"start": 1302.16, "end": 1304.16, "text": "我怎么会预先知道"}, {"start": 1304.16, "end": 1306.16, "text": "因为我能掐会算"}, {"start": 1306.16, "end": 1307.16, "text": "料敌于先"}, {"start": 1329.47, "end": 1330.47, "text": "先生"}, {"start": 1330.47, "end": 1331.47, "text": "已经三天了"}, {"start": 1332.47, "end": 1333.47, "text": "不管我们军事"}, {"start": 1333.47, "end": 1335.47, "text": "在城下怎么辱骂"}, {"start": 1335.47, "end": 1336.47, "text": "他刘备"}, {"start": 1336.47, "end": 1337.47, "text": "就是坚守不出"}, {"start": 1338.47, "end": 1341.68, "text": "而配城一定被加高"}, {"start": 1341.68, "end": 1342.68, "text": "无耻有余"}, {"start": 1342.68, "end": 1343.68, "text": "一时难以攻陷"}, {"start": 1345.68, "end": 1346.68, "text": "你看"}, {"start": 1346.68, "end": 1347.68, "text": "我们如何是好"}, {"start": 1348.68, "end": 1351.31, "text": "刘备"}, {"start": 1351.31, "end": 1353.31, "text": "这是在等救兵啊"}, {"start": 1354.31, "end": 1355.31, "text": "救兵"}, {"start": 1356.31, "end": 1357.31, "text": "谁会来救他"}, {"start": 1357.31, "end": 1359.94, "text": "难道你忘了"}, {"start": 1360.94, "end": 1362.94, "text": "刘备暗通曹操的事了"}, {"start": 1362.94, "end": 1372.75, "text": "如果曹操率大军前来"}, {"start": 1372.75, "end": 1373.75, "text": "我们暂且翻身"}, {"start": 1384.58, "end": 1389.93, "text": "开始的时候"}, {"start": 1389.93, "end": 1391.93, "text": "我并不主张对刘备用兵"}, {"start": 1391.93, "end": 1393.93, "text": "只是你坚持要攻去配城"}, {"start": 1393.93, "end": 1395.93, "text": "现在咱们既然已经来了"}, {"start": 1395.93, "end": 1398.53, "text": "就等于和刘备"}, {"start": 1398.53, "end": 1400.53, "text": "撕破脸皮 樊目成仇"}, {"start": 1401.53, "end": 1402.53, "text": "岂能够在他城下"}, {"start": 1402.53, "end": 1404.53, "text": "辱骂一番就退军"}, {"start": 1404.53, "end": 1405.53, "text": "另外"}, {"start": 1405.53, "end": 1408.06, "text": "我也算了一下"}, {"start": 1410.06, "end": 1411.06, "text": "曹操即使现在"}, {"start": 1411.06, "end": 1413.06, "text": "从衍州出发"}, {"start": 1413.06, "end": 1415.06, "text": "至少也得五天时间"}, {"start": 1415.06, "end": 1416.06, "text": "才能赶到这里"}, {"start": 1416.06, "end": 1417.06, "text": "也就是说"}, {"start": 1417.06, "end": 1419.06, "text": "咱们还有四天时间"}, {"start": 1419.06, "end": 1420.06, "text": "如果在四天之内"}, {"start": 1420.06, "end": 1422.06, "text": "咱们要能攻陷配城"}, {"start": 1422.06, "end": 1423.06, "text": "即使曹操"}, {"start": 1423.06, "end": 1424.06, "text": "率大军赶到"}, {"start": 1424.06, "end": 1426.06, "text": "也只能忘关心态了"}, {"start": 1427.06, "end": 1428.06, "text": "好"}, {"start": 1428.06, "end": 1431.72, "text": "先生"}, {"start": 1432.72, "end": 1434.72, "text": "那我们要如何攻去配城"}, {"start": 1434.72, "end": 1436.72, "text": "配城易守难攻"}, {"start": 1439.1, "end": 1442.1, "text": "只能诱留被出城会战"}, {"start": 1442.1, "end": 1443.1, "text": "好"}, {"start": 1443.1, "end": 1448.75, "text": "那我们要如何诱留被出城呢"}, {"start": 1450.75, "end": 1451.75, "text": "我的上将军"}, {"start": 1451.75, "end": 1454.75, "text": "为什么事事都要问我呢"}, {"start": 1454.75, "end": 1455.75, "text": "你可以去问问"}, {"start": 1455.75, "end": 1456.75, "text": "你的左右参军嘛"}, {"start": 1456.75, "end": 1457.75, "text": "万金时刻"}, {"start": 1458.75, "end": 1459.75, "text": "还得仰仗先生"}, {"start": 1480.02, "end": 1481.02, "text": "先生教我"}, {"start": 1482.02, "end": 1484.02, "text": "请先生教我"}, {"start": 1489.28, "end": 1490.28, "text": "冯县长"}, {"start": 1491.28, "end": 1492.28, "text": "你看这样如何"}, {"start": 1492.28, "end": 1493.28, "text": "将军"}, {"start": 1493.28, "end": 1497.77, "text": "有什么情况"}, {"start": 1497.77, "end": 1498.77, "text": "没有"}, {"start": 1499.77, "end": 1518.27, "text": "你们要小心管我"}, {"start": 1518.27, "end": 1519.27, "text": "诺"}, {"start": 1519.27, "end": 1532.44, "text": "玄德先帝如我"}, {"start": 1532.44, "end": 1534.44, "text": "我已率三万精兵来源"}, {"start": 1534.44, "end": 1549.65, "text": "无日可留"}, {"start": 1549.65, "end": 1550.65, "text": "三弟"}, {"start": 1550.65, "end": 1551.65, "text": "是"}, {"start": 1551.65, "end": 1552.65, "text": "曹操大军已到"}, {"start": 1552.65, "end": 1553.65, "text": "好"}, {"start": 1553.65, "end": 1556.28, "text": "他约我礼应外合"}, {"start": 1556.28, "end": 1557.28, "text": "夹击吕布"}, {"start": 1557.28, "end": 1558.28, "text": "好啊"}, {"start": 1558.28, "end": 1560.28, "text": "这家伙来得真快啊"}, {"start": 1561.28, "end": 1563.28, "text": "我又可以大开杀戒了"}, {"start": 1563.28, "end": 1565.28, "text": "这几天可把我变坏了"}, {"start": 1565.28, "end": 1566.28, "text": "十二日到"}, {"start": 1567.28, "end": 1569.28, "text": "明日不就是十二日吗"}, {"start": 1569.28, "end": 1574.54, "text": "曹操用兵如此神速"}, {"start": 1574.54, "end": 1575.54, "text": "难道"}, {"start": 1575.54, "end": 1577.54, "text": "他在吕布攻我之前"}, {"start": 1577.54, "end": 1581.17, "text": "就已经发兵了吗"}, {"start": 1586.56, "end": 1587.56, "text": "大军"}, {"start": 1587.56, "end": 1588.56, "text": "我已经发兵了"}, {"start": 1588.56, "end": 1589.56, "text": "我已经发兵了"}, {"start": 1590.56, "end": 1591.56, "text": "大哥"}, {"start": 1591.56, "end": 1592.56, "text": "再有两个时辰"}, {"start": 1592.56, "end": 1594.56, "text": "这天可就亮了"}, {"start": 1594.56, "end": 1596.56, "text": "你赶快调兵遣将吧"}, {"start": 1596.56, "end": 1597.56, "text": "传中将"}, {"start": 1597.56, "end": 1610.66, "text": "大唐听令"}, {"start": 1610.66, "end": 1620.88, "text": "出来受死"}, {"start": 1620.88, "end": 1622.88, "text": "不要做缩头乌龟了"}, {"start": 1622.88, "end": 1623.88, "text": "快出城"}, {"start": 1623.88, "end": 1625.88, "text": "出城受死"}, {"start": 1625.88, "end": 1626.88, "text": "快快出城"}, {"start": 1626.88, "end": 1627.88, "text": "找死吧"}, {"start": 1627.88, "end": 1628.88, "text": "曹军到了"}, {"start": 1628.88, "end": 1641.59, "text": "吕布的大军"}, {"start": 1641.59, "end": 1642.59, "text": "已经开始乱了"}, {"start": 1642.59, "end": 1643.59, "text": "三弟切记"}, {"start": 1643.59, "end": 1645.59, "text": "不可练战"}, {"start": 1645.59, "end": 1647.59, "text": "将部军引直配合弯即可"}, {"start": 1647.59, "end": 1648.59, "text": "知道了"}, {"start": 1648.59, "end": 1649.59, "text": "三军听令"}, {"start": 1649.59, "end": 1655.21, "text": "开城计敌"}, {"start": 1655.21, "end": 1656.21, "text": "遵命"}, {"start": 1656.21, "end": 1657.21, "text": "大哥 三弟"}, {"start": 1657.21, "end": 1658.21, "text": "云昌"}, {"start": 1658.21, "end": 1690.57, "text": "为何到此"}, {"start": 1691.57, "end": 1692.57, "text": "昨晚"}, {"start": 1692.57, "end": 1693.57, "text": "曹操设来密信"}, {"start": 1693.57, "end": 1695.57, "text": "约我在此拒监吕布"}, {"start": 1695.57, "end": 1696.57, "text": "坏了"}, {"start": 1696.57, "end": 1697.57, "text": "我们中了奸计了"}, {"start": 1697.57, "end": 1699.57, "text": "定是成功诱我们出城"}, {"start": 1699.57, "end": 1700.57, "text": "云昌"}, {"start": 1700.57, "end": 1702.57, "text": "快撤"}, {"start": 1702.57, "end": 1703.57, "text": "大耳贼"}, {"start": 1703.57, "end": 1714.62, "text": "你跑不了了"}, {"start": 1714.62, "end": 1715.62, "text": "赶快下马受死"}, {"start": 1716.62, "end": 1717.62, "text": "那些贼 吕布"}, {"start": 1717.62, "end": 1718.62, "text": "你三爷爷来了"}, {"start": 1720.62, "end": 1721.62, "text": "主公"}, {"start": 1760.74, "end": 1781.54, "text": "主公"}, {"start": 1781.54, "end": 1782.54, "text": "小的亲眼看见"}, {"start": 1782.54, "end": 1783.54, "text": "张将军被吕布"}, {"start": 1783.54, "end": 1784.54, "text": "刺到马下"}, {"start": 1784.54, "end": 1785.54, "text": "生死不明"}, {"start": 1785.54, "end": 1786.54, "text": "杀回去"}, {"start": 1786.54, "end": 1787.54, "text": "主公"}, {"start": 1787.54, "end": 1788.54, "text": "主公不能回去"}, {"start": 1788.54, "end": 1789.54, "text": "主公不能回去"}, {"start": 1789.54, "end": 1790.54, "text": "主公不能回去"}, {"start": 1790.54, "end": 1791.54, "text": "主公不能回去"}, {"start": 1791.54, "end": 1792.54, "text": "杀回去"}, {"start": 1793.54, "end": 1794.54, "text": "我兄弟如果死了"}, {"start": 1794.54, "end": 1795.54, "text": "我绝不渡伤"}, {"start": 1795.54, "end": 1796.54, "text": "主公"}, {"start": 1796.54, "end": 1797.54, "text": "使不得呀"}, {"start": 1797.54, "end": 1798.54, "text": "万万使不得呀"}, {"start": 1798.54, "end": 1799.54, "text": "使不得呀 主公"}, {"start": 1799.54, "end": 1800.54, "text": "让开"}, {"start": 1801.54, "end": 1802.54, "text": "主公"}, {"start": 1802.54, "end": 1803.54, "text": "主公"}, {"start": 1803.54, "end": 1804.54, "text": "使不得呀"}, {"start": 1804.54, "end": 1805.54, "text": "杀回去"}, {"start": 1805.54, "end": 1806.54, "text": "主公"}, {"start": 1806.54, "end": 1808.54, "text": "使不得呀 主公"}, {"start": 1808.54, "end": 1809.54, "text": "主公"}, {"start": 1809.54, "end": 1810.54, "text": "你快看"}, {"start": 1810.54, "end": 1811.54, "text": "救兵来了"}, {"start": 1811.54, "end": 1812.54, "text": "救兵来了"}, {"start": 1812.54, "end": 1813.54, "text": "救兵"}, {"start": 1813.54, "end": 1821.23, "text": "救兵"}, {"start": 1821.23, "end": 1833.02, "text": "总算是来了"}, {"start": 1833.02, "end": 1834.02, "text": "山大"}, {"start": 1834.02, "end": 1841.38, "text": "惭愧呀"}, {"start": 1841.38, "end": 1842.38, "text": "于兄来迟了一步"}, {"start": 1842.38, "end": 1843.38, "text": "连累贤弟"}, {"start": 1843.38, "end": 1844.38, "text": "沦落到如此地步"}, {"start": 1848.68, "end": 1849.68, "text": "请问曹公"}, {"start": 1850.68, "end": 1851.68, "text": "数日前"}, {"start": 1851.68, "end": 1852.68, "text": "你是不是遣人"}, {"start": 1853.68, "end": 1854.68, "text": "带给我一封密信"}, {"start": 1855.68, "end": 1856.68, "text": "结果被成功截火了"}, {"start": 1856.68, "end": 1857.68, "text": "是有这么回事"}, {"start": 1857.68, "end": 1858.68, "text": "不过这封信"}, {"start": 1858.68, "end": 1859.68, "text": "不是给你的"}, {"start": 1859.68, "end": 1861.68, "text": "它原本就是写给成功看的"}, {"start": 1862.68, "end": 1863.68, "text": "什么"}, {"start": 1864.68, "end": 1865.68, "text": "你故意让它截火的"}, {"start": 1867.68, "end": 1868.68, "text": "当然"}, {"start": 1868.68, "end": 1869.68, "text": "否则"}, {"start": 1869.68, "end": 1871.68, "text": "吕布怎么会向你用兵"}, {"start": 1871.68, "end": 1873.68, "text": "徐州又怎么可能会空许"}, {"start": 1875.68, "end": 1876.68, "text": "可惜"}, {"start": 1876.68, "end": 1877.68, "text": "为此"}, {"start": 1877.68, "end": 1878.68, "text": "我一个中仆的性命"}, {"start": 1878.68, "end": 1888.1, "text": "都丢了"}, {"start": 1888.1, "end": 1890.7, "text": "曹操"}, {"start": 1890.7, "end": 1891.7, "text": "你知道你有多狠吗"}, {"start": 1892.7, "end": 1893.7, "text": "你使这道奸计"}, {"start": 1894.7, "end": 1895.7, "text": "不但使我丢了城池"}, {"start": 1896.7, "end": 1897.7, "text": "还害得我两个兄弟"}, {"start": 1897.7, "end": 1899.7, "text": "陷入城北生死破严"}, {"start": 1899.7, "end": 1902.9, "text": "我知道"}, {"start": 1902.9, "end": 1905.82, "text": "知道"}, {"start": 1905.82, "end": 1906.82, "text": "贤弟不必悲伤"}, {"start": 1906.82, "end": 1907.82, "text": "城池"}, {"start": 1908.82, "end": 1909.82, "text": "我可以替你去取"}, {"start": 1910.82, "end": 1911.82, "text": "关张若有不幸"}, {"start": 1911.82, "end": 1913.82, "text": "你不是还有我曹操吗"}, {"start": 1913.82, "end": 1914.82, "text": "咱们联手"}, {"start": 1914.82, "end": 1915.82, "text": "何时不成"}, {"start": 1920.31, "end": 1921.31, "text": "且看我如何收拾联合"}, {"start": 1922.31, "end": 1940.37, "text": "将军"}, {"start": 1940.37, "end": 1942.9, "text": "将军"}, {"start": 1942.9, "end": 1943.9, "text": "邵琪探报"}, {"start": 1943.9, "end": 1944.9, "text": "曹操的大军到了"}, {"start": 1945.9, "end": 1948.41, "text": "你不是说"}, {"start": 1948.41, "end": 1949.41, "text": "至少五天才能到吗"}, {"start": 1949.41, "end": 1950.41, "text": "今天才第三天"}, {"start": 1951.41, "end": 1952.41, "text": "曹操真是巨奸"}, {"start": 1953.41, "end": 1955.41, "text": "他一定是提前动兵了"}, {"start": 1955.41, "end": 1958.87, "text": "曹军在哪"}, {"start": 1958.87, "end": 1959.87, "text": "我没看到"}, {"start": 1959.87, "end": 1961.87, "text": "你当然看不到了"}, {"start": 1961.87, "end": 1962.87, "text": "我料想"}, {"start": 1962.87, "end": 1964.87, "text": "他一定是奔徐州去了"}, {"start": 1964.87, "end": 1967.41, "text": "徐州"}, {"start": 1967.41, "end": 1968.41, "text": "对"}, {"start": 1969.41, "end": 1970.41, "text": "他要娶我徐州"}, {"start": 1970.41, "end": 1972.98, "text": "快回去"}, {"start": 1972.98, "end": 1973.98, "text": "快"}, {"start": 1973.98, "end": 2005.86, "text": "快开城门"}, {"start": 2005.86, "end": 2006.86, "text": "放下吊桥"}, {"start": 2007.86, "end": 2008.86, "text": "吕布"}, {"start": 2008.86, "end": 2010.86, "text": "徐州城原本就不属于你"}, {"start": 2010.86, "end": 2012.86, "text": "是你抢弹留备的"}, {"start": 2012.86, "end": 2013.86, "text": "今天"}, {"start": 2013.86, "end": 2015.86, "text": "我要把它献给朝廷"}, {"start": 2018.2, "end": 2019.2, "text": "你这奸贼"}, {"start": 2020.2, "end": 2021.2, "text": "卖主求荣"}, {"start": 2023.2, "end": 2024.2, "text": "这对贼父子"}, {"start": 2024.2, "end": 2025.2, "text": "卖主求荣"}, {"start": 2025.2, "end": 2026.2, "text": "又不是第一回了"}, {"start": 2027.2, "end": 2028.2, "text": "匹夫"}, {"start": 2028.2, "end": 2030.2, "text": "曹操大军将日"}, {"start": 2030.2, "end": 2032.2, "text": "你赶快逃命吧"}, {"start": 2032.2, "end": 2035.2, "text": "否则将成瓮中之变"}, {"start": 2035.2, "end": 2039.46, "text": "陈登在哪"}, {"start": 2039.46, "end": 2040.46, "text": "把他抓起来"}, {"start": 2041.46, "end": 2042.46, "text": "我要用他的头颅"}, {"start": 2042.46, "end": 2043.46, "text": "逼陈归开城"}, {"start": 2043.46, "end": 2045.46, "text": "到现在你还执迷不悟"}, {"start": 2045.46, "end": 2047.46, "text": "陈登早就不知去向"}, {"start": 2047.46, "end": 2060.37, "text": "先生"}, {"start": 2060.37, "end": 2063.7, "text": "我们该怎么办"}, {"start": 2064.7, "end": 2065.7, "text": "看来"}, {"start": 2065.7, "end": 2066.7, "text": "徐州各军"}, {"start": 2066.7, "end": 2067.7, "text": "都已经落入曹操手中了"}, {"start": 2068.7, "end": 2070.7, "text": "这时下批应该还没有陷入"}, {"start": 2070.7, "end": 2071.7, "text": "那里可以坚守一时"}, {"start": 2072.7, "end": 2078.76, "text": "退守下批"}, {"start": 2079.76, "end": 2080.76, "text": "走"}, {"start": 2080.76, "end": 2115.55, "text": "去下批"}, {"start": 2115.55, "end": 2116.55, "text": "二弟 三弟"}, {"start": 2116.55, "end": 2117.55, "text": "你们安然无恙"}, {"start": 2118.55, "end": 2119.55, "text": "谢天谢地"}, {"start": 2119.55, "end": 2120.55, "text": "陈哥"}, {"start": 2120.55, "end": 2121.55, "text": "我和三弟杀出重围"}, {"start": 2121.55, "end": 2122.55, "text": "到处找你"}, {"start": 2122.55, "end": 2123.55, "text": "急死人了"}, {"start": 2125.55, "end": 2126.55, "text": "我早就跟二哥说了嘛"}, {"start": 2126.55, "end": 2127.55, "text": "怕个甚"}, {"start": 2127.55, "end": 2128.55, "text": "咱大哥"}, {"start": 2128.55, "end": 2129.55, "text": "那是上天脱身的"}, {"start": 2130.55, "end": 2131.55, "text": "逢凶化吉"}, {"start": 2131.55, "end": 2132.55, "text": "欲奈成祥啊"}, {"start": 2133.55, "end": 2134.55, "text": "二弟 三弟"}, {"start": 2134.55, "end": 2135.55, "text": "真豪杰"}, {"start": 2136.55, "end": 2137.55, "text": "二爷"}, {"start": 2137.55, "end": 2138.55, "text": "陈哥"}, {"start": 2138.55, "end": 2139.55, "text": "我所言不虚罢"}, {"start": 2139.55, "end": 2141.55, "text": "你现在兄弟有了"}, {"start": 2141.55, "end": 2142.55, "text": "城池也有了"}, {"start": 2149.15, "end": 2150.15, "text": "我有兄弟足矣"}, {"start": 2152.15, "end": 2153.15, "text": "至于城池嘛"}, {"start": 2154.15, "end": 2155.15, "text": "当然要归属曹公了"}, {"start": 2156.15, "end": 2158.15, "text": "这话说得透彻"}, {"start": 2159.15, "end": 2163.93, "text": "大哥"}, {"start": 2163.93, "end": 2164.93, "text": "我们走"}, {"start": 2164.93, "end": 2165.93, "text": "走"}, {"start": 2165.93, "end": 2173.1, "text": "在下陈登"}, {"start": 2173.1, "end": 2175.1, "text": "恭迎曹公进城"}, {"start": 2176.1, "end": 2177.1, "text": "快快请起"}, {"start": 2179.86, "end": 2180.86, "text": "你们二人"}, {"start": 2180.86, "end": 2181.86, "text": "为朝廷立了大功"}, {"start": 2182.86, "end": 2184.86, "text": "我会裱奏天子"}, {"start": 2184.86, "end": 2185.86, "text": "为你们"}, {"start": 2185.86, "end": 2186.86, "text": "拜官进爵"}, {"start": 2187.86, "end": 2188.86, "text": "谢曹公"}, {"start": 2188.86, "end": 2191.53, "text": "主公"}, {"start": 2191.53, "end": 2192.53, "text": "吕布已经带兵"}, {"start": 2192.53, "end": 2193.53, "text": "投奔下坯去了"}, {"start": 2194.53, "end": 2195.53, "text": "曹仁"}, {"start": 2195.53, "end": 2196.53, "text": "在"}, {"start": 2196.53, "end": 2197.53, "text": "立刻靠军"}, {"start": 2197.53, "end": 2198.53, "text": "传命各部"}, {"start": 2198.53, "end": 2199.53, "text": "歇息三日"}, {"start": 2199.53, "end": 2200.53, "text": "准备"}, {"start": 2201.53, "end": 2202.53, "text": "不"}, {"start": 2202.53, "end": 2203.53, "text": "只准歇息一日"}, {"start": 2204.53, "end": 2206.53, "text": "明日即攻打下坯"}, {"start": 2206.53, "end": 2207.53, "text": "主公"}, {"start": 2207.53, "end": 2208.53, "text": "将士们已经奔袭了"}, {"start": 2208.53, "end": 2209.53, "text": "六百多里"}, {"start": 2209.53, "end": 2210.53, "text": "即使人扛得住"}, {"start": 2210.53, "end": 2211.53, "text": "战马也扛不住啊"}, {"start": 2211.53, "end": 2212.53, "text": "只歇一天"}, {"start": 2212.53, "end": 2213.53, "text": "恐怕"}, {"start": 2214.53, "end": 2215.53, "text": "吕布如同惊弓之鸟"}, {"start": 2215.53, "end": 2216.53, "text": "如不乘胜除之"}, {"start": 2216.53, "end": 2218.53, "text": "很有可能投奔袁绍"}, {"start": 2218.53, "end": 2219.53, "text": "如此一来"}, {"start": 2219.53, "end": 2220.53, "text": "袁绍的势力就变大了"}, {"start": 2220.53, "end": 2221.53, "text": "明白了吗"}, {"start": 2221.53, "end": 2222.53, "text": "末将明白了"}, {"start": 2223.53, "end": 2258.06, "text": "奉先哪"}, {"start": 2258.06, "end": 2259.06, "text": "我们刚刚大败"}, {"start": 2259.06, "end": 2260.06, "text": "死里逃生"}, {"start": 2260.06, "end": 2261.06, "text": "这才来到下坯"}, {"start": 2262.06, "end": 2263.06, "text": "你看你"}, {"start": 2263.06, "end": 2264.06, "text": "转眼间"}, {"start": 2264.06, "end": 2266.06, "text": "你又快活得像神仙似的"}, {"start": 2266.06, "end": 2267.06, "text": "仙上我累了"}, {"start": 2268.06, "end": 2269.06, "text": "小心一些"}, {"start": 2270.06, "end": 2271.06, "text": "知道吗"}, {"start": 2271.06, "end": 2273.06, "text": "现在外面是军心摇动"}, {"start": 2273.06, "end": 2274.06, "text": "生兵满营啊"}, {"start": 2274.06, "end": 2276.06, "text": "你作为义军统帅"}, {"start": 2276.06, "end": 2278.06, "text": "你应该到将士们中间去啊"}, {"start": 2279.06, "end": 2280.06, "text": "我去过了"}, {"start": 2281.06, "end": 2282.06, "text": "我刚刚视察过城防"}, {"start": 2282.06, "end": 2283.06, "text": "情况怎么样"}, {"start": 2283.06, "end": 2285.06, "text": "下批城防坚实无比"}, {"start": 2290.45, "end": 2291.45, "text": "城中粮食充足"}, {"start": 2292.45, "end": 2293.45, "text": "足够食用百日"}, {"start": 2294.45, "end": 2296.45, "text": "城外又有道似水之险"}, {"start": 2297.45, "end": 2298.45, "text": "水流湍急"}, {"start": 2299.45, "end": 2301.45, "text": "曹操大军如果来"}, {"start": 2301.45, "end": 2303.45, "text": "我军聚成而守"}, {"start": 2303.45, "end": 2304.45, "text": "无忧"}, {"start": 2304.45, "end": 2305.45, "text": "先生只管放心"}, {"start": 2306.45, "end": 2307.45, "text": "报"}, {"start": 2307.45, "end": 2308.45, "text": "上将军"}, {"start": 2308.45, "end": 2309.45, "text": "曹操率军叩关"}, {"start": 2312.88, "end": 2313.88, "text": "听到了吧"}, {"start": 2313.88, "end": 2315.88, "text": "曹操大军又到了"}, {"start": 2315.88, "end": 2316.88, "text": "你在哪儿啊"}, {"start": 2316.88, "end": 2317.88, "text": "曹操大军又到了"}, {"start": 2317.88, "end": 2319.88, "text": "你在这里对酒当歌"}, {"start": 2319.88, "end": 2321.88, "text": "人家可是没有片刻的信息啊"}, {"start": 2324.35, "end": 2325.35, "text": "毕城坚守"}, {"start": 2325.35, "end": 2326.35, "text": "不可应战"}, {"start": 2326.35, "end": 2327.35, "text": "诺"}, {"start": 2327.35, "end": 2331.04, "text": "报"}, {"start": 2331.04, "end": 2332.04, "text": "上将军"}, {"start": 2332.04, "end": 2333.04, "text": "曹操匹马来到调调钱"}, {"start": 2333.04, "end": 2334.04, "text": "呼唤将军出城相见"}, {"start": 2335.04, "end": 2336.04, "text": "他想见我"}, {"start": 2337.04, "end": 2338.04, "text": "冯县长"}, {"start": 2338.04, "end": 2340.04, "text": "曹孟德诡计多端"}, {"start": 2340.04, "end": 2342.04, "text": "你可千万不要理睬他"}, {"start": 2343.04, "end": 2344.04, "text": "见见又有何妨"}, {"start": 2345.04, "end": 2346.04, "text": "说不定"}, {"start": 2347.04, "end": 2349.04, "text": "说不定他是来跟我求和的呢"}, {"start": 2350.04, "end": 2351.04, "text": "你"}, {"start": 2351.04, "end": 2353.04, "text": "你怎么如此的天真呢"}, {"start": 2354.04, "end": 2357.09, "text": "先生请上城"}, {"start": 2358.09, "end": 2359.09, "text": "待我劈脚后就来"}, {"start": 2365.69, "end": 2366.69, "text": "快去我方天化吉"}, {"start": 2366.69, "end": 2367.69, "text": "诺"}, {"start": 2367.69, "end": 2372.82, "text": "将军"}, {"start": 2372.82, "end": 2374.82, "text": "公台先生对你忠心耿耿"}, {"start": 2374.82, "end": 2376.82, "text": "你真应该听听他的劝呀"}, {"start": 2377.82, "end": 2378.82, "text": "臣公虽然忠诚"}, {"start": 2379.82, "end": 2380.82, "text": "但他太过傲慢"}, {"start": 2381.82, "end": 2382.82, "text": "那你呢"}, {"start": 2382.82, "end": 2383.82, "text": "你就不傲慢了吗"}, {"start": 2385.82, "end": 2386.82, "text": "奴婢倒觉得"}, {"start": 2386.82, "end": 2388.82, "text": "这全天下最傲慢的"}, {"start": 2388.82, "end": 2389.82, "text": "就当书将军你了"}, {"start": 2391.82, "end": 2392.82, "text": "将军"}, {"start": 2392.82, "end": 2393.82, "text": "你想"}, {"start": 2394.82, "end": 2395.82, "text": "那成归父子"}, {"start": 2395.82, "end": 2396.82, "text": "倒是最为悲谦"}, {"start": 2397.82, "end": 2398.82, "text": "可是悲谦之下"}, {"start": 2399.82, "end": 2400.82, "text": "暗藏奸险呀"}, {"start": 2400.82, "end": 2401.82, "text": "爱妻说得是"}, {"start": 2409.09, "end": 2410.09, "text": "我愧对成功了"}, {"start": 2410.09, "end": 2412.46, "text": "论英勇"}, {"start": 2412.46, "end": 2417.44, "text": "将军是天下无双"}, {"start": 2418.44, "end": 2419.44, "text": "可是论计谋"}, {"start": 2420.44, "end": 2422.44, "text": "跟公台先生比起来"}, {"start": 2422.44, "end": 2424.44, "text": "将军倒像是个孩子"}, {"start": 2425.44, "end": 2426.44, "text": "好了"}, {"start": 2426.44, "end": 2427.44, "text": "快去和公台先生"}, {"start": 2427.44, "end": 2428.44, "text": "商量一下该怎么办吧"}, {"start": 2429.44, "end": 2430.44, "text": "去呀"}]