[{"start": 3.82, "end": 5.82, "text": "在下若要隐瞒真相,"}, {"start": 6.82, "end": 8.82, "text": "也不敢在牙书里含睡了。"}, {"start": 9.82, "end": 11.82, "text": "此话何意?"}, {"start": 12.82, "end": 13.82, "text": "三年前,"}, {"start": 14.82, "end": 16.82, "text": "丞相派人来在下寒舍,"}, {"start": 16.82, "end": 18.82, "text": "正逢关渡大捷。"}, {"start": 18.82, "end": 20.82, "text": "丞相在拜董卓斩吕布,"}, {"start": 20.82, "end": 22.82, "text": "灭袁树之后,"}, {"start": 22.82, "end": 24.82, "text": "又消灭了大敌袁绍。"}, {"start": 24.82, "end": 28.2, "text": "那时的丞相,"}, {"start": 28.2, "end": 30.2, "text": "辟邪天子,口贤天仙,"}, {"start": 30.2, "end": 32.2, "text": "雍兵百万,猛将如云。"}, {"start": 32.2, "end": 33.2, "text": "四方才是,"}, {"start": 33.2, "end": 35.2, "text": "无不争先恐后投报。"}, {"start": 37.2, "end": 39.2, "text": "丞相自己也是天下如掌中,"}, {"start": 39.2, "end": 41.2, "text": "早晚必得。"}, {"start": 42.2, "end": 43.2, "text": "我若出山,"}, {"start": 43.2, "end": 45.2, "text": "丞相最多为我一线令。"}, {"start": 46.2, "end": 48.2, "text": "如此岂不负了我一腔报复。"}, {"start": 48.2, "end": 49.2, "text": "大胆!"}, {"start": 49.2, "end": 54.12, "text": "竟敢在我面前待假而辜。"}, {"start": 55.12, "end": 56.12, "text": "丞相恕罪。"}, {"start": 57.12, "end": 59.12, "text": "在下只是实话实说。"}, {"start": 60.12, "end": 62.12, "text": "司马仪不想在他人声音上"}, {"start": 62.12, "end": 63.12, "text": "讨一杯羹。"}, {"start": 63.12, "end": 65.12, "text": "只想在他人积极时"}, {"start": 65.12, "end": 67.12, "text": "送去一斗米。"}, {"start": 67.12, "end": 68.12, "text": "时下,"}, {"start": 68.12, "end": 70.12, "text": "丞相兵败赤壁,"}, {"start": 70.12, "end": 71.12, "text": "危机四伏。"}, {"start": 71.12, "end": 73.12, "text": "这便又到了用人之际。"}, {"start": 73.12, "end": 75.12, "text": "狂傲之徒。"}, {"start": 75.12, "end": 82.53, "text": "据在下所知,"}, {"start": 82.53, "end": 83.53, "text": "丞相回家,"}, {"start": 83.53, "end": 85.53, "text": "有不少狂傲之徒,"}, {"start": 85.53, "end": 87.53, "text": "也有不少奸盗之辈。"}, {"start": 87.53, "end": 89.53, "text": "但丞相遇下有方,"}, {"start": 89.53, "end": 91.53, "text": "能够物尽其用,"}, {"start": 91.53, "end": 92.53, "text": "人尽其才。"}, {"start": 92.53, "end": 94.53, "text": "不管他是奸盗之辈,"}, {"start": 94.53, "end": 95.53, "text": "还是狂傲之徒,"}, {"start": 95.53, "end": 96.53, "text": "都能心甘情愿地"}, {"start": 96.53, "end": 98.53, "text": "为丞相立下功勋。"}, {"start": 99.53, "end": 100.53, "text": "由此,"}, {"start": 100.53, "end": 102.53, "text": "也意见丞相之圣明。"}, {"start": 102.53, "end": 106.16, "text": "司马仪啊,"}, {"start": 106.16, "end": 108.16, "text": "司马。"}, {"start": 108.16, "end": 114.26, "text": "明日跟我回许昌。"}, {"start": 114.26, "end": 118.5, "text": "恕在下斗胆,"}, {"start": 118.5, "end": 120.5, "text": "敢问丞相打算为我何职啊?"}, {"start": 120.5, "end": 122.5, "text": "宪令,"}, {"start": 122.5, "end": 124.5, "text": "有你这么要官的吗?"}, {"start": 124.5, "end": 126.5, "text": "问一下心里踏实。"}, {"start": 126.5, "end": 130.48, "text": "我心中"}, {"start": 130.48, "end": 131.48, "text": "有一个"}, {"start": 131.48, "end": 133.48, "text": "极其重要的职务,"}, {"start": 133.48, "end": 135.48, "text": "酒肆无人。"}, {"start": 136.48, "end": 138.48, "text": "想请你去救。"}, {"start": 138.48, "end": 145.34, "text": "请丞相示下。"}, {"start": 145.34, "end": 147.34, "text": "东府内侍,"}, {"start": 147.34, "end": 148.34, "text": "也就是"}, {"start": 148.34, "end": 150.34, "text": "给我儿曹冲做"}, {"start": 150.34, "end": 152.34, "text": "慕宾师父教他读书。"}, {"start": 152.34, "end": 154.34, "text": "在我的儿子当中,"}, {"start": 154.34, "end": 156.34, "text": "冲儿最为出息。"}, {"start": 157.34, "end": 158.34, "text": "丞相,"}, {"start": 158.34, "end": 160.34, "text": "公子曹冲年方十岁,"}, {"start": 160.34, "end": 162.34, "text": "我能教他什么?"}, {"start": 163.34, "end": 165.34, "text": "他是只有十岁,"}, {"start": 165.34, "end": 167.34, "text": "可他会长大。"}, {"start": 167.34, "end": 171.36, "text": "丞相还是为我宪令吧。"}, {"start": 171.36, "end": 173.36, "text": "你若不从,"}, {"start": 173.36, "end": 175.36, "text": "我必杀你。"}, {"start": 175.36, "end": 186.42, "text": "省得让你去投奔孙柳。"}, {"start": 187.42, "end": 204.34, "text": "赤壁之败,"}, {"start": 204.34, "end": 206.34, "text": "让我痛定思痛。"}, {"start": 206.34, "end": 210.1, "text": "统天下的大业,"}, {"start": 210.1, "end": 212.1, "text": "何止需要十年,"}, {"start": 213.1, "end": 215.1, "text": "也需要两三代人,"}, {"start": 215.1, "end": 217.1, "text": "才能完成。"}, {"start": 218.1, "end": 219.1, "text": "我活着,"}, {"start": 219.1, "end": 221.1, "text": "凭我的文才武略,"}, {"start": 221.1, "end": 223.1, "text": "无惧任何敌手。"}, {"start": 223.1, "end": 226.5, "text": "我死了以后怎么办?"}, {"start": 226.5, "end": 228.5, "text": "曹氏的子嗣,"}, {"start": 228.5, "end": 230.5, "text": "需要一个像你这样的"}, {"start": 230.5, "end": 232.5, "text": "智者副总,"}, {"start": 232.5, "end": 234.5, "text": "才能在乱世当中"}, {"start": 234.5, "end": 235.5, "text": "生存,"}, {"start": 235.5, "end": 236.5, "text": "图霸。"}, {"start": 236.5, "end": 253.18, "text": "在下遵命。"}, {"start": 253.18, "end": 261.52, "text": "曹任,"}, {"start": 261.52, "end": 263.52, "text": "探报回来了没有?"}, {"start": 263.52, "end": 266.52, "text": "刘备和孙权有什么动静?"}, {"start": 266.52, "end": 267.52, "text": "探报说,"}, {"start": 267.52, "end": 269.52, "text": "周瑜现在屯兵于油江,"}, {"start": 269.52, "end": 271.52, "text": "刘备屯兵于下口。"}, {"start": 271.52, "end": 272.52, "text": "双方各自"}, {"start": 272.52, "end": 274.52, "text": "在营中整顿兵马,"}, {"start": 274.52, "end": 275.52, "text": "暂无大的动静。"}, {"start": 275.52, "end": 277.52, "text": "一屯兵于下口,"}, {"start": 278.52, "end": 280.52, "text": "一屯兵于油江,"}, {"start": 281.52, "end": 282.52, "text": "隔着三百里,"}, {"start": 282.52, "end": 284.52, "text": "我都能闻出味儿来。"}, {"start": 284.52, "end": 286.52, "text": "剑锋所向,"}, {"start": 286.52, "end": 288.52, "text": "直指南郡。"}, {"start": 289.52, "end": 290.52, "text": "曹任,"}, {"start": 290.52, "end": 291.52, "text": "在。"}, {"start": 291.52, "end": 292.52, "text": "孙柳两家,"}, {"start": 292.52, "end": 293.52, "text": "对京乡九郡"}, {"start": 293.52, "end": 295.52, "text": "早就垂涎三尺,"}, {"start": 295.52, "end": 297.52, "text": "早晚会发兵来返。"}, {"start": 298.52, "end": 300.52, "text": "而玉曲京乡,"}, {"start": 300.52, "end": 302.52, "text": "必先下南郡。"}, {"start": 302.52, "end": 303.52, "text": "你这儿,"}, {"start": 303.52, "end": 304.52, "text": "首当其冲。"}, {"start": 305.52, "end": 306.52, "text": "孙柳一旦来犯,"}, {"start": 306.52, "end": 308.52, "text": "末将只能舍命恶战。"}, {"start": 308.52, "end": 309.52, "text": "这里太危险了。"}, {"start": 309.52, "end": 311.52, "text": "你还是回许昌吧。"}, {"start": 311.52, "end": 312.52, "text": "曹任,"}, {"start": 312.52, "end": 323.51, "text": "南郡虽然兵手,"}, {"start": 323.51, "end": 325.51, "text": "但是城墙坚实,"}, {"start": 325.51, "end": 327.51, "text": "易守难攻。"}, {"start": 327.51, "end": 329.51, "text": "我回许昌后,"}, {"start": 329.51, "end": 331.51, "text": "也会发兵增援你。"}, {"start": 331.51, "end": 332.51, "text": "记住,"}, {"start": 332.51, "end": 334.51, "text": "不管发生什么事,"}, {"start": 334.51, "end": 336.51, "text": "要坚守南郡,"}, {"start": 336.51, "end": 338.51, "text": "万不容失。"}, {"start": 339.51, "end": 340.51, "text": "遵命!"}, {"start": 340.51, "end": 341.51, "text": "丞相!"}, {"start": 341.51, "end": 342.51, "text": "丞相!"}, {"start": 342.51, "end": 343.51, "text": "丞相,"}, {"start": 343.51, "end": 349.86, "text": "须诚起报。"}, {"start": 349.86, "end": 351.86, "text": "谁发来的?"}, {"start": 351.86, "end": 352.86, "text": "寻玉。"}, {"start": 352.86, "end": 353.86, "text": "丞相,"}, {"start": 353.86, "end": 378.2, "text": "出了什么事?"}, {"start": 379.2, "end": 386.32, "text": "寻玉真是啰嗦。"}, {"start": 386.32, "end": 388.32, "text": "我的寒鸡要生孩子了。"}, {"start": 388.32, "end": 393.17, "text": "区区小事,"}, {"start": 393.17, "end": 397.5, "text": "他居然发快报给我。"}, {"start": 397.5, "end": 398.5, "text": "恭喜丞相!"}, {"start": 398.5, "end": 400.82, "text": "恭喜丞相!"}, {"start": 400.82, "end": 401.82, "text": "早不生晚不生,"}, {"start": 401.82, "end": 408.68, "text": "偏偏这个时候生。"}, {"start": 409.68, "end": 410.68, "text": "罢了,"}, {"start": 410.68, "end": 413.68, "text": "我明天一早就回许昌。"}, {"start": 415.68, "end": 416.68, "text": "曹仁、曹洪,"}, {"start": 416.68, "end": 419.68, "text": "你们快去安排一下。"}, {"start": 419.68, "end": 420.68, "text": "遵命!"}, {"start": 420.68, "end": 421.68, "text": "沉玉。"}, {"start": 421.68, "end": 422.68, "text": "在。"}, {"start": 422.68, "end": 428.22, "text": "许楚。"}, {"start": 428.22, "end": 429.22, "text": "在。"}, {"start": 430.22, "end": 432.22, "text": "你们二人领军"}, {"start": 432.22, "end": 434.22, "text": "三日之后启程。"}, {"start": 435.22, "end": 436.22, "text": "去吧。"}, {"start": 436.22, "end": 437.22, "text": "遵命。"}, {"start": 437.22, "end": 438.22, "text": "丞相!"}, {"start": 438.22, "end": 440.86, "text": "丞相!"}, {"start": 440.86, "end": 453.86, "text": "那鸡包,"}, {"start": 453.86, "end": 463.9, "text": "一辆马腾寒碎。"}, {"start": 463.9, "end": 465.9, "text": "发大军八万,"}, {"start": 465.9, "end": 469.9, "text": "星夜突袭许昌了。"}, {"start": 469.9, "end": 470.9, "text": "什么?"}, {"start": 470.9, "end": 472.9, "text": "二贼这是趁火打劫。"}, {"start": 472.9, "end": 474.9, "text": "我们刚刚遭受了赤壁之痛。"}, {"start": 474.9, "end": 475.9, "text": "他们,"}, {"start": 475.9, "end": 477.9, "text": "他们就奔袭了我们的后方根基了。"}, {"start": 477.9, "end": 478.9, "text": "丞相,"}, {"start": 478.9, "end": 479.9, "text": "万一许昌有事,"}, {"start": 479.9, "end": 481.9, "text": "刘备孙全必然趁势禁闭。"}, {"start": 481.9, "end": 482.9, "text": "到那时,"}, {"start": 482.9, "end": 483.9, "text": "大军就不堪收拾了。"}, {"start": 483.9, "end": 484.9, "text": "听着。"}, {"start": 485.9, "end": 487.9, "text": "万万不可。"}, {"start": 487.9, "end": 489.9, "text": "让南军的军营,"}, {"start": 489.9, "end": 491.9, "text": "知道了萧綦佛策军队。"}, {"start": 491.9, "end": 494.9, "text": "知道了萧綦佛策军情一乱曲面,"}, {"start": 494.9, "end": 496.9, "text": "就更加难测了。"}, {"start": 498.9, "end": 500.9, "text": "我已无法启程。"}, {"start": 500.9, "end": 502.9, "text": "承玉,"}, {"start": 502.9, "end": 504.9, "text": "准备车驾,"}, {"start": 504.9, "end": 507.9, "text": "连夜送我回徐城。"}, {"start": 507.9, "end": 508.9, "text": "徐竹。"}, {"start": 508.9, "end": 509.9, "text": "在。"}, {"start": 509.9, "end": 510.9, "text": "你现在,"}, {"start": 510.9, "end": 511.9, "text": "马上,"}, {"start": 511.9, "end": 513.9, "text": "飞起回徐城。"}, {"start": 513.9, "end": 515.9, "text": "告诉寻玉,"}, {"start": 515.9, "end": 528.78, "text": "大战起伏的,"}, {"start": 528.78, "end": 530.78, "text": "因我办事。"}, {"start": 530.78, "end": 539.01, "text": "驾。"}, {"start": 539.01, "end": 573.06, "text": "你睡着了吗?"}, {"start": 573.06, "end": 581.27, "text": "我在听风声。"}, {"start": 581.27, "end": 583.27, "text": "这外面没有风啊。"}, {"start": 583.27, "end": 586.27, "text": "风起于清平之梦。"}, {"start": 586.27, "end": 592.03, "text": "耳朵只能听三里以外的风。"}, {"start": 592.03, "end": 594.03, "text": "要想听三十里外的风,"}, {"start": 594.03, "end": 598.28, "text": "就只能平心,"}, {"start": 598.28, "end": 600.28, "text": "去感受。"}, {"start": 600.28, "end": 608.32, "text": "寻大人,"}, {"start": 608.32, "end": 610.32, "text": "军情送达了。"}, {"start": 610.32, "end": 611.32, "text": "说。"}, {"start": 611.32, "end": 612.32, "text": "马滕寒随,"}, {"start": 612.32, "end": 613.32, "text": "兵分两路,"}, {"start": 613.32, "end": 614.32, "text": "直奔我徐昌二来。"}, {"start": 614.32, "end": 616.32, "text": "尤其是马滕所部,"}, {"start": 616.32, "end": 617.32, "text": "日行三百里。"}, {"start": 617.32, "end": 619.32, "text": "其前锋已过巫师寨。"}, {"start": 619.32, "end": 625.51, "text": "为何兵分两路?"}, {"start": 625.51, "end": 632.54, "text": "为何不走着要越过巫师寨呢?"}, {"start": 632.54, "end": 649.97, "text": "是了啊。"}, {"start": 650.97, "end": 655.22, "text": "他们表面上看来凶猛。"}, {"start": 655.22, "end": 656.22, "text": "其实,"}, {"start": 656.22, "end": 659.22, "text": "他们心里头是害怕丞相的。"}, {"start": 660.22, "end": 661.22, "text": "西凉的城骑,"}, {"start": 661.22, "end": 662.22, "text": "多于良计。"}, {"start": 662.22, "end": 664.22, "text": "照此速度进军,"}, {"start": 664.22, "end": 667.22, "text": "数日即可到达许昌城下。"}, {"start": 667.22, "end": 669.22, "text": "大军要等数日,"}, {"start": 670.22, "end": 672.22, "text": "但是他们的细作探报,"}, {"start": 672.22, "end": 675.22, "text": "只怕早就进了许昌城里来了。"}, {"start": 675.22, "end": 676.22, "text": "不好。"}, {"start": 676.22, "end": 678.22, "text": "城中守军只有六线。"}, {"start": 678.22, "end": 679.22, "text": "我赶紧关闭所有城门,"}, {"start": 679.22, "end": 681.22, "text": "严厉禁止任何人出入。"}, {"start": 681.22, "end": 683.22, "text": "万万不能关城门。"}, {"start": 683.22, "end": 684.22, "text": "一旦关了城门,"}, {"start": 684.22, "end": 689.22, "text": "马滕寒随就猜数我城中兵力不足。"}, {"start": 689.22, "end": 694.01, "text": "反而更加助长他们的贼士。"}, {"start": 694.01, "end": 697.47, "text": "传下去。"}, {"start": 697.47, "end": 698.47, "text": "军民人当,"}, {"start": 698.47, "end": 699.47, "text": "一切入国。"}, {"start": 699.47, "end": 700.47, "text": "诺。"}, {"start": 700.47, "end": 711.15, "text": "主公从南郡发回来的信上说,"}, {"start": 711.15, "end": 712.15, "text": "初九一早,"}, {"start": 712.15, "end": 713.15, "text": "必到许昌。"}, {"start": 715.15, "end": 716.15, "text": "不过。"}, {"start": 717.15, "end": 718.15, "text": "不过什么?"}, {"start": 718.15, "end": 719.15, "text": "按常理,"}, {"start": 719.15, "end": 720.15, "text": "丞相到了襄阳,"}, {"start": 720.15, "end": 721.15, "text": "就该歇息一夜。"}, {"start": 721.15, "end": 723.15, "text": "管一就会派快马来报。"}, {"start": 723.15, "end": 724.15, "text": "因此,"}, {"start": 724.15, "end": 726.15, "text": "这送信的快马,"}, {"start": 726.15, "end": 728.15, "text": "总该比丞相早到三日才是。"}, {"start": 728.15, "end": 729.15, "text": "可直到现在,"}, {"start": 729.15, "end": 732.15, "text": "还没有见到襄阳的快马来报。"}, {"start": 733.15, "end": 734.15, "text": "由此可见,"}, {"start": 734.15, "end": 736.15, "text": "丞相怕是耽误了行程。"}, {"start": 736.15, "end": 738.15, "text": "初九根本到不了许昌。"}, {"start": 739.15, "end": 744.22, "text": "明日便是初九,"}, {"start": 744.22, "end": 745.22, "text": "对吗?"}, {"start": 745.22, "end": 746.22, "text": "是。"}, {"start": 746.22, "end": 750.23, "text": "即刻安排人手,"}, {"start": 750.23, "end": 751.23, "text": "打扫南门,"}, {"start": 752.23, "end": 755.23, "text": "布置迎接丞相的古月遗诏。"}, {"start": 756.23, "end": 757.23, "text": "传命,"}, {"start": 757.23, "end": 759.23, "text": "城中所有的文武官员,"}, {"start": 759.23, "end": 761.23, "text": "明日晨时出客,"}, {"start": 762.23, "end": 763.23, "text": "带南门列队,"}, {"start": 764.23, "end": 765.23, "text": "迎接丞相,"}, {"start": 766.23, "end": 767.23, "text": "班师回城。"}, {"start": 769.23, "end": 770.23, "text": "公子爷,"}, {"start": 770.23, "end": 773.31, "text": "前些日子,"}, {"start": 773.31, "end": 774.31, "text": "中家的大公子,"}, {"start": 774.31, "end": 776.31, "text": "拿他们家的黑帅和我们的金辈比。"}, {"start": 777.31, "end": 778.31, "text": "你猜怎么着?"}, {"start": 778.31, "end": 780.31, "text": "金辈嗖的一声跳到黑帅的背上,"}, {"start": 780.31, "end": 781.31, "text": "咔嚓一口,"}, {"start": 781.31, "end": 782.31, "text": "咬成两半了。"}, {"start": 784.31, "end": 785.31, "text": "好,"}, {"start": 785.31, "end": 786.31, "text": "给我长志气了,"}, {"start": 787.31, "end": 789.59, "text": "好生试一下。"}, {"start": 792.59, "end": 795.59, "text": "中家不是还有一只银帅吗?"}, {"start": 796.59, "end": 798.59, "text": "明天让金辈跟银帅道道。"}, {"start": 798.59, "end": 799.59, "text": "遵命,"}, {"start": 799.59, "end": 800.59, "text": "公子爷请。"}, {"start": 800.59, "end": 801.59, "text": "蛇!"}, {"start": 801.59, "end": 802.59, "text": "公子爷,"}, {"start": 802.59, "end": 803.59, "text": "有蛇!"}, {"start": 803.59, "end": 804.59, "text": "公子爷,"}, {"start": 804.59, "end": 805.59, "text": "蛇!"}, {"start": 805.59, "end": 807.59, "text": "相夫怎么会有蛇呢?"}, {"start": 807.59, "end": 822.22, "text": "相夫有蛇?"}, {"start": 822.22, "end": 823.22, "text": "公子爷,"}, {"start": 824.22, "end": 825.22, "text": "剧毒的五部蛇呀。"}, {"start": 826.22, "end": 828.22, "text": "公子爷你还不知道吧?"}, {"start": 828.22, "end": 829.22, "text": "前些日子,"}, {"start": 829.22, "end": 830.22, "text": "徐大人的战马,"}, {"start": 830.22, "end": 831.22, "text": "突然间死了。"}, {"start": 832.22, "end": 834.22, "text": "怎么查都查不出缘由。"}, {"start": 834.22, "end": 835.22, "text": "小人知道啊,"}, {"start": 835.22, "end": 837.22, "text": "就是这五部蛇给咬的。"}, {"start": 838.22, "end": 840.22, "text": "可小人说出来又没人信。"}, {"start": 840.22, "end": 841.22, "text": "公子爷,"}, {"start": 841.22, "end": 843.22, "text": "五部蛇,"}, {"start": 843.22, "end": 845.22, "text": "五部蛇是剧毒蛇。"}, {"start": 845.22, "end": 846.22, "text": "公子爷,"}, {"start": 846.22, "end": 847.22, "text": "你可得当心。"}, {"start": 847.22, "end": 855.14, "text": "马腾含水叫沙来,"}, {"start": 855.14, "end": 858.46, "text": "徐长已经是兵弱剑狂,"}, {"start": 858.46, "end": 860.46, "text": "几乎是座空城。"}, {"start": 861.46, "end": 863.46, "text": "我们拿什么去抵御他们?"}, {"start": 863.46, "end": 868.11, "text": "其实丞相已经是无奈了,"}, {"start": 869.11, "end": 871.11, "text": "所以他叫我虚张声势,"}, {"start": 871.11, "end": 873.11, "text": "热热闹闹地摆他一副"}, {"start": 873.11, "end": 875.11, "text": "大军搬石回城的场面。"}, {"start": 877.11, "end": 879.11, "text": "以求震慑敌军,"}, {"start": 879.11, "end": 881.11, "text": "延缓他们的进军速度。"}, {"start": 883.11, "end": 884.11, "text": "同时,"}, {"start": 884.11, "end": 886.11, "text": "也安抚城中军民,"}, {"start": 887.11, "end": 889.11, "text": "叫他们不要慌张。"}, {"start": 889.11, "end": 891.11, "text": "末将明白了,"}, {"start": 891.11, "end": 893.11, "text": "兵不厌诈,"}, {"start": 893.11, "end": 895.11, "text": "丞相用兵如神啊。"}, {"start": 895.11, "end": 897.11, "text": "城门旗帜招展,"}, {"start": 897.11, "end": 899.11, "text": "场面一定要搞得浩大。"}, {"start": 900.11, "end": 902.11, "text": "把老百姓也动员起来去接驾,"}, {"start": 902.11, "end": 905.39, "text": "再用两千军士,"}, {"start": 906.39, "end": 908.39, "text": "一直迎接到十里之外。"}, {"start": 909.39, "end": 911.39, "text": "要用两千人马出城相迎,"}, {"start": 911.39, "end": 913.39, "text": "那样一来,"}, {"start": 913.39, "end": 915.39, "text": "城中的守军就更不足了。"}, {"start": 916.39, "end": 918.39, "text": "依现在的情势,"}, {"start": 918.39, "end": 920.39, "text": "这两千军士,"}, {"start": 920.39, "end": 922.39, "text": "已经无助于城防了。"}, {"start": 923.39, "end": 925.39, "text": "容他来虚张声势,"}, {"start": 925.39, "end": 928.39, "text": "却可是马腾、韩遂等八万大军。"}, {"start": 928.39, "end": 930.39, "text": "迟疑不尽。"}, {"start": 930.39, "end": 938.3, "text": "除以此。"}, {"start": 938.3, "end": 944.36, "text": "外头何人?"}, {"start": 944.36, "end": 948.06, "text": "城中随有奸细,"}, {"start": 948.06, "end": 952.32, "text": "赶入相府来吧。"}, {"start": 952.32, "end": 953.32, "text": "大人,"}, {"start": 953.32, "end": 954.32, "text": "我出去看看。"}, {"start": 954.32, "end": 960.28, "text": "公子?"}, {"start": 960.28, "end": 963.85, "text": "拜见公子。"}, {"start": 968.11, "end": 969.11, "text": "公子,"}, {"start": 969.11, "end": 970.11, "text": "徐大人,"}, {"start": 970.11, "end": 972.11, "text": "公子伤情未愈,"}, {"start": 972.11, "end": 973.11, "text": "请多多保重。"}, {"start": 974.11, "end": 975.11, "text": "无妨。"}, {"start": 975.11, "end": 977.11, "text": "徐大人,"}, {"start": 977.11, "end": 979.11, "text": "我父亲有消息吗?"}, {"start": 979.11, "end": 981.11, "text": "他何时回虚张啊?"}, {"start": 982.11, "end": 984.11, "text": "在下正要向公子禀报。"}, {"start": 984.11, "end": 987.11, "text": "傍晚接丞相快马传命,"}, {"start": 988.11, "end": 989.11, "text": "说他出寺,"}, {"start": 989.11, "end": 990.11, "text": "就从南郡出来了。"}, {"start": 990.11, "end": 992.11, "text": "明天一早,"}, {"start": 992.11, "end": 993.11, "text": "就班师归来。"}, {"start": 993.11, "end": 997.13, "text": "那我领着众兄弟,"}, {"start": 997.13, "end": 998.13, "text": "一起出城迎驾。"}, {"start": 998.13, "end": 999.13, "text": "慢。"}, {"start": 999.13, "end": 1003.87, "text": "公子伤情未愈啊。"}, {"start": 1004.87, "end": 1005.87, "text": "父亲班师,"}, {"start": 1005.87, "end": 1007.87, "text": "我岂能不出城迎驾?"}, {"start": 1008.87, "end": 1009.87, "text": "再说,"}, {"start": 1009.87, "end": 1012.87, "text": "我竟刚刚遭受赤壁挫败,"}, {"start": 1012.87, "end": 1014.87, "text": "更应该大张旗鼓,"}, {"start": 1014.87, "end": 1015.87, "text": "迎接父亲归来。"}, {"start": 1016.87, "end": 1024.21, "text": "为何呀?"}, {"start": 1025.21, "end": 1028.21, "text": "在下向公子禀报实情。"}, {"start": 1029.21, "end": 1031.21, "text": "丞相再过几日,"}, {"start": 1031.21, "end": 1032.21, "text": "也不会回来。"}, {"start": 1033.21, "end": 1035.21, "text": "许昌成迎驾之举,"}, {"start": 1035.21, "end": 1037.21, "text": "完全是虚张声势,"}, {"start": 1037.21, "end": 1038.21, "text": "震盛。"}, {"start": 1039.21, "end": 1040.21, "text": "这马腾寒衰,"}, {"start": 1040.21, "end": 1041.21, "text": "因此,"}, {"start": 1042.21, "end": 1055.7, "text": "公子真的不必去。"}, {"start": 1055.7, "end": 1076.73, "text": "公子慢走。"}, {"start": 1076.73, "end": 1082.82, "text": "慢点。"}, {"start": 1082.82, "end": 1083.82, "text": "公子爷。"}, {"start": 1084.82, "end": 1086.82, "text": "你出城告诉曹张弟、曹直立,"}, {"start": 1086.82, "end": 1087.82, "text": "还有曹冲弟。"}, {"start": 1088.82, "end": 1089.82, "text": "就说,"}, {"start": 1089.82, "end": 1090.82, "text": "徐大人说了,"}, {"start": 1090.82, "end": 1092.82, "text": "傅相这几天不能回城,"}, {"start": 1092.82, "end": 1095.82, "text": "叫他们明天都不必出城迎驾了。"}, {"start": 1096.82, "end": 1097.82, "text": "遵命。"}, {"start": 1098.82, "end": 1099.82, "text": "我家公子说了,"}, {"start": 1099.82, "end": 1101.82, "text": "命三公子、四公子、少公子,"}, {"start": 1101.82, "end": 1104.82, "text": "三位公子明日不必出城迎驾。"}, {"start": 1104.82, "end": 1108.54, "text": "公子爷。"}, {"start": 1108.54, "end": 1115.26, "text": "你听清楚了。"}, {"start": 1116.26, "end": 1118.26, "text": "不是我不让他们出城迎驾,"}, {"start": 1118.26, "end": 1121.26, "text": "是徐玉不让他们出城迎驾。"}, {"start": 1121.26, "end": 1123.74, "text": "遵命。"}, {"start": 1124.74, "end": 1127.74, "text": "徐大人命三公子、四公子、少公子,"}, {"start": 1127.74, "end": 1129.74, "text": "明日不必出城迎驾。"}, {"start": 1130.74, "end": 1135.35, "text": "那呢?"}, {"start": 1135.35, "end": 1138.05, "text": "公子爷,"}, {"start": 1138.05, "end": 1140.05, "text": "既然丞相明天不能回来,"}, {"start": 1140.05, "end": 1141.05, "text": "那咱们趁此机会,"}, {"start": 1141.05, "end": 1143.05, "text": "把中府的大少爷约出来,"}, {"start": 1143.05, "end": 1145.05, "text": "让他们家的银帅,"}, {"start": 1145.05, "end": 1147.05, "text": "跟咱们家的金辈斗上一斗,"}, {"start": 1147.05, "end": 1148.05, "text": "看谁更厉害。"}, {"start": 1150.05, "end": 1151.05, "text": "把鞠躬给我。"}, {"start": 1152.05, "end": 1167.81, "text": "果然是气势不凡,"}, {"start": 1167.81, "end": 1169.81, "text": "极为难得呀。"}, {"start": 1172.81, "end": 1173.81, "text": "公子爷,"}, {"start": 1173.81, "end": 1174.81, "text": "不是五指吹牛,"}, {"start": 1174.81, "end": 1176.81, "text": "咱家这只金辈,"}, {"start": 1176.81, "end": 1177.81, "text": "那普天之下,"}, {"start": 1177.81, "end": 1178.81, "text": "那是找不出第二个。"}, {"start": 1179.81, "end": 1189.1, "text": "以后,"}, {"start": 1189.1, "end": 1191.1, "text": "我不准你再弄这些玩意儿。"}, {"start": 1191.1, "end": 1199.59, "text": "明天辰时出客,"}, {"start": 1199.59, "end": 1204.92, "text": "随我到城门接驾。"}, {"start": 1204.92, "end": 1205.92, "text": "公子爷,"}, {"start": 1205.92, "end": 1208.92, "text": "明天丞相不是回不来?"}, {"start": 1211.36, "end": 1212.36, "text": "所以呀,"}, {"start": 1212.36, "end": 1214.36, "text": "我公子的就更应该去接驾了。"}, {"start": 1214.36, "end": 1218.5, "text": "谁让我是兄长呢?"}, {"start": 1218.5, "end": 1246.26, "text": "众位文武,"}, {"start": 1246.26, "end": 1248.26, "text": "丞相发来诏令,"}, {"start": 1248.26, "end": 1250.26, "text": "说他三天前,"}, {"start": 1250.26, "end": 1253.26, "text": "已从南郡班师起驾。"}, {"start": 1253.26, "end": 1255.26, "text": "今日必到许昌。"}, {"start": 1256.26, "end": 1258.26, "text": "他这次回来,"}, {"start": 1258.26, "end": 1260.26, "text": "带回步兵八万,"}, {"start": 1261.26, "end": 1263.26, "text": "骑兵三万,"}, {"start": 1263.26, "end": 1266.26, "text": "共计兵马十一万。"}, {"start": 1267.26, "end": 1269.26, "text": "近日,"}, {"start": 1269.26, "end": 1271.26, "text": "城中有些谣言,"}, {"start": 1271.26, "end": 1274.26, "text": "说丞相犯了头疾。"}, {"start": 1275.26, "end": 1276.26, "text": "我告诉你们,"}, {"start": 1277.26, "end": 1279.26, "text": "丞相精神抖擞,"}, {"start": 1279.26, "end": 1281.26, "text": "安康无恙。"}, {"start": 1282.26, "end": 1283.26, "text": "稍后,"}, {"start": 1283.26, "end": 1286.26, "text": "你们就可以亲眼拜见他了。"}, {"start": 1286.26, "end": 1289.64, "text": "还有一件事,"}, {"start": 1289.64, "end": 1295.08, "text": "请诸位千万千万不可泄露。"}, {"start": 1296.08, "end": 1299.08, "text": "丞相除了带十一万大军外,"}, {"start": 1299.08, "end": 1302.08, "text": "还命令青州五万铁骑,"}, {"start": 1302.08, "end": 1305.08, "text": "星夜驰罔无实战,"}, {"start": 1306.08, "end": 1310.08, "text": "袭击西梁马腾寒随的贼军。"}, {"start": 1310.08, "end": 1333.1, "text": "请你不必来吗?"}, {"start": 1333.1, "end": 1335.1, "text": "副相班师,"}, {"start": 1335.1, "end": 1337.1, "text": "我岂能不来接驾?"}, {"start": 1337.1, "end": 1341.57, "text": "我不是跟您说过,"}, {"start": 1341.57, "end": 1346.8, "text": "丞相他是诸公子之长。"}, {"start": 1346.8, "end": 1348.8, "text": "我亲自来接驾,"}, {"start": 1348.8, "end": 1351.8, "text": "百官们才更会信以为真。"}, {"start": 1351.8, "end": 1352.8, "text": "多谢公子。"}, {"start": 1352.8, "end": 1360.56, "text": "那其他几位公子来不来?"}, {"start": 1360.56, "end": 1363.56, "text": "其他几位公子知道父亲不会来,"}, {"start": 1363.56, "end": 1365.56, "text": "为何还要来接驾?"}, {"start": 1365.56, "end": 1366.56, "text": "我猜你就在这儿,"}, {"start": 1366.56, "end": 1390.45, "text": "果然。"}, {"start": 1390.45, "end": 1391.45, "text": "兄弟,"}, {"start": 1391.45, "end": 1393.45, "text": "你怎么来了?"}, {"start": 1393.45, "end": 1395.45, "text": "徐大人不是说..."}, {"start": 1395.45, "end": 1397.45, "text": "我知道,"}, {"start": 1397.45, "end": 1400.45, "text": "但我想二哥肯定会来接驾,"}, {"start": 1400.45, "end": 1404.02, "text": "因为这样才能让百官们相信。"}, {"start": 1404.02, "end": 1407.02, "text": "所以我就来陪二哥了。"}, {"start": 1407.02, "end": 1408.02, "text": "好好好,"}, {"start": 1408.02, "end": 1409.02, "text": "来,"}, {"start": 1409.02, "end": 1410.02, "text": "兄弟,"}, {"start": 1410.02, "end": 1413.02, "text": "咱们一起来恭候副相。"}, {"start": 1413.02, "end": 1416.3, "text": "二位公子"}, {"start": 1416.3, "end": 1418.3, "text": "忠诚、智慧,"}, {"start": 1418.3, "end": 1419.3, "text": "在下"}, {"start": 1419.3, "end": 1421.3, "text": "甚为敬佩。"}, {"start": 1421.3, "end": 1422.3, "text": "兄弟啊,"}, {"start": 1422.3, "end": 1429.99, "text": "也有你来陪这二哥,"}, {"start": 1429.99, "end": 1431.99, "text": "那真是太好不过了。"}, {"start": 1431.99, "end": 1433.99, "text": "谁?"}, {"start": 1433.99, "end": 1482.45, "text": "丞相,"}, {"start": 1482.45, "end": 1484.45, "text": "我不是司马一。"}, {"start": 1484.45, "end": 1485.45, "text": "忠大,"}, {"start": 1485.45, "end": 1494.42, "text": "我们到哪儿了?"}, {"start": 1494.42, "end": 1495.42, "text": "五孤零,"}, {"start": 1495.42, "end": 1497.42, "text": "据许长还有三百多里。"}, {"start": 1497.42, "end": 1499.42, "text": "也不行了,"}, {"start": 1499.42, "end": 1513.74, "text": "我要死了。"}, {"start": 1513.74, "end": 1515.74, "text": "丞相绝不会死。"}, {"start": 1515.74, "end": 1519.73, "text": "我问你,"}, {"start": 1519.73, "end": 1521.73, "text": "我死之后,"}, {"start": 1521.73, "end": 1526.07, "text": "你会不会继续扶托冲儿?"}, {"start": 1526.07, "end": 1528.07, "text": "丞相大业未尽,"}, {"start": 1528.07, "end": 1530.07, "text": "绝不会死。"}, {"start": 1530.07, "end": 1532.07, "text": "我问你,"}, {"start": 1532.07, "end": 1535.07, "text": "会不会继续做冲儿的师父?"}, {"start": 1535.07, "end": 1545.21, "text": "在下绝不负丞相所托。"}, {"start": 1545.21, "end": 1589.73, "text": "停车!"}, {"start": 1589.73, "end": 1620.11, "text": "丞相!"}, {"start": 1620.11, "end": 1622.11, "text": "曹操!"}, {"start": 1622.11, "end": 1626.63, "text": "喊什么喊?"}, {"start": 1626.63, "end": 1627.63, "text": "我在这儿呢!"}, {"start": 1627.63, "end": 1639.99, "text": "丞相知罪,"}, {"start": 1639.99, "end": 1641.99, "text": "丞相知罪,"}, {"start": 1641.99, "end": 1653.53, "text": "丞相知罪。"}, {"start": 1653.53, "end": 1654.53, "text": "痛快,"}, {"start": 1654.53, "end": 1656.53, "text": "这方教撒的痛快。"}, {"start": 1656.53, "end": 1660.92, "text": "丞相刚才这是。"}, {"start": 1660.92, "end": 1662.92, "text": "刚才?"}, {"start": 1662.92, "end": 1664.92, "text": "刚才我怎么了?"}, {"start": 1666.92, "end": 1668.92, "text": "刚才我有点头痛。"}, {"start": 1668.92, "end": 1669.92, "text": "准确地说,"}, {"start": 1669.92, "end": 1671.92, "text": "是头痛欲裂。"}, {"start": 1671.92, "end": 1673.92, "text": "不过现在已经好了。"}, {"start": 1673.92, "end": 1677.62, "text": "丞相怎么会这样?"}, {"start": 1677.62, "end": 1679.62, "text": "我投风犯的时候就是这样。"}, {"start": 1679.62, "end": 1680.62, "text": "一旦疼起来,"}, {"start": 1680.62, "end": 1682.62, "text": "就如山呼海啸,"}, {"start": 1682.62, "end": 1683.62, "text": "刀砍斧劈。"}, {"start": 1683.62, "end": 1685.62, "text": "但是一旦好了,"}, {"start": 1685.62, "end": 1687.62, "text": "即如平常。"}, {"start": 1687.62, "end": 1690.62, "text": "我记得有一回关渡大战吧?"}, {"start": 1690.62, "end": 1691.62, "text": "也是。"}, {"start": 1691.62, "end": 1694.62, "text": "几天几夜疼得我睡不着觉。"}, {"start": 1694.62, "end": 1696.62, "text": "你知道最后怎么好的吗?"}, {"start": 1696.62, "end": 1698.62, "text": "在下不知。"}, {"start": 1698.62, "end": 1702.62, "text": "是陈琳的一篇讨贼新闻给我骂好的。"}, {"start": 1702.62, "end": 1704.62, "text": "在那篇文章里,"}, {"start": 1704.62, "end": 1706.62, "text": "她痛骂我的祖宗三代,"}, {"start": 1706.62, "end": 1708.62, "text": "给我骂得狗血喷头。"}, {"start": 1708.62, "end": 1709.62, "text": "结果呢?"}, {"start": 1709.62, "end": 1711.62, "text": "把我骂得气血流转,"}, {"start": 1711.62, "end": 1712.62, "text": "经脉舒畅,"}, {"start": 1712.62, "end": 1714.62, "text": "头痛也好了。"}, {"start": 1714.62, "end": 1715.62, "text": "众大,"}, {"start": 1715.62, "end": 1718.62, "text": "你刚才说治罪,治什么罪?"}, {"start": 1718.62, "end": 1720.62, "text": "在下知乎丞相大名,"}, {"start": 1720.62, "end": 1722.62, "text": "请丞相治罪。"}, {"start": 1722.62, "end": 1724.62, "text": "我的名字什么不能知乎的,"}, {"start": 1724.62, "end": 1726.62, "text": "不就是个人名吗?"}, {"start": 1731.17, "end": 1733.17, "text": "我问你,"}, {"start": 1733.17, "end": 1735.17, "text": "你说这人的脚,"}, {"start": 1735.17, "end": 1739.17, "text": "为什么比脸和手都要白呢?"}, {"start": 1739.17, "end": 1746.74, "text": "因为他老藏着。"}, {"start": 1746.74, "end": 1788.0, "text": "走吧!"}, {"start": 1788.0, "end": 1838.46, "text": "丞相刚才派快马传信,"}, {"start": 1838.46, "end": 1842.93, "text": "说他今天要在襄阳休息一宿,"}, {"start": 1842.93, "end": 1845.93, "text": "今日就不到许昌了。"}, {"start": 1845.93, "end": 1847.93, "text": "大家都很辛苦,"}, {"start": 1847.93, "end": 1850.93, "text": "今天就回家休息吧。"}, {"start": 1850.93, "end": 1853.93, "text": "明日晨时出客,"}, {"start": 1853.93, "end": 1857.93, "text": "还请大家按时到此聚集,"}, {"start": 1857.93, "end": 1860.93, "text": "继续迎候丞相归来,"}, {"start": 1860.93, "end": 1864.93, "text": "明日丞相必到许昌。"}, {"start": 1864.93, "end": 1866.93, "text": "遵命!"}, {"start": 1866.93, "end": 1882.2, "text": "二位公子,"}, {"start": 1882.2, "end": 1883.2, "text": "请回吧。"}, {"start": 1883.2, "end": 1884.2, "text": "二哥,"}, {"start": 1884.2, "end": 1885.2, "text": "回府吧。"}, {"start": 1885.2, "end": 1889.08, "text": "那冲帝先回,"}, {"start": 1889.08, "end": 1891.08, "text": "我继来。"}, {"start": 1891.08, "end": 1896.24, "text": "你也请回吧。"}, {"start": 1896.24, "end": 1900.0, "text": "我想多等候一会儿,"}, {"start": 1900.0, "end": 1903.0, "text": "兴许傅相能连夜赶回来呢。"}, {"start": 1903.0, "end": 1906.66, "text": "绝对不可能,"}, {"start": 1906.66, "end": 1912.33, "text": "丞相生性谨慎也行。"}, {"start": 1912.33, "end": 1915.33, "text": "我父亲虽然谨慎,"}, {"start": 1915.33, "end": 1917.33, "text": "但却多变,"}, {"start": 1917.33, "end": 1919.33, "text": "徐大人又如何能预知"}, {"start": 1919.33, "end": 1921.33, "text": "我父亲的行踪呢?"}, {"start": 1921.33, "end": 1925.69, "text": "大人请回吧,"}, {"start": 1925.69, "end": 1926.69, "text": "不必管我。"}, {"start": 1926.69, "end": 1927.69, "text": "徐大人,"}, {"start": 1927.69, "end": 1949.2, "text": "徐大人,"}, {"start": 1949.2, "end": 1953.98, "text": "探报回来了。"}, {"start": 1953.98, "end": 1955.98, "text": "派出去的三波哨迹"}, {"start": 1955.98, "end": 1957.98, "text": "已经回来两波了。"}, {"start": 1957.98, "end": 1959.98, "text": "报说马腾的西梁兵"}, {"start": 1959.98, "end": 1960.98, "text": "已行至巫石寨,"}, {"start": 1960.98, "end": 1964.98, "text": "几个扎营不防停止前进了。"}, {"start": 1964.98, "end": 1965.98, "text": "好,"}, {"start": 1965.98, "end": 1967.98, "text": "再探。"}, {"start": 1967.98, "end": 1969.98, "text": "每隔两个时辰"}, {"start": 1969.98, "end": 1971.98, "text": "就派出一波哨迹"}, {"start": 1971.98, "end": 1973.98, "text": "继续寻探。"}, {"start": 1973.98, "end": 1974.98, "text": "诺。"}, {"start": 1974.98, "end": 1975.98, "text": "慢,"}, {"start": 1975.98, "end": 1982.92, "text": "曹匹公子回府了吗?"}, {"start": 1982.92, "end": 1983.92, "text": "大人,"}, {"start": 1983.92, "end": 1986.92, "text": "这事我觉得有些奇怪。"}, {"start": 1987.92, "end": 1988.92, "text": "怎么?"}, {"start": 1988.92, "end": 1992.71, "text": "丞相明摆着回不来,"}, {"start": 1992.71, "end": 1993.71, "text": "可是匹公子"}, {"start": 1993.71, "end": 1995.71, "text": "还独自在南城门口鼓手"}, {"start": 1995.71, "end": 1996.71, "text": "等候丞相。"}, {"start": 1996.71, "end": 2008.1, "text": "真是至诚至孝之人哪。"}, {"start": 2008.1, "end": 2010.1, "text": "可匹公子这份孝心"}, {"start": 2010.1, "end": 2012.1, "text": "丞相也看不见哪。"}, {"start": 2014.1, "end": 2018.46, "text": "但是百官看得见,"}, {"start": 2018.46, "end": 2020.46, "text": "上天看得见,"}, {"start": 2020.46, "end": 2022.46, "text": "只要上天看得见,"}, {"start": 2022.46, "end": 2025.46, "text": "丞相早晚有一天也会看得见。"}, {"start": 2025.46, "end": 2032.17, "text": "匹公子这份成孝"}, {"start": 2032.17, "end": 2034.17, "text": "城里却有些传言。"}, {"start": 2034.17, "end": 2037.34, "text": "说。"}, {"start": 2038.34, "end": 2039.34, "text": "有人私下议论"}, {"start": 2039.34, "end": 2041.34, "text": "说匹公子如此做派"}, {"start": 2041.34, "end": 2043.34, "text": "是为了向丞相"}, {"start": 2043.34, "end": 2044.34, "text": "始终忧宠,"}, {"start": 2044.34, "end": 2047.34, "text": "其意在世子大位。"}, {"start": 2047.34, "end": 2054.97, "text": "宋将军,"}, {"start": 2054.97, "end": 2055.97, "text": "只要你今后"}, {"start": 2055.97, "end": 2058.97, "text": "想太太平平地过上一辈子,"}, {"start": 2058.97, "end": 2059.97, "text": "你记住,"}, {"start": 2059.97, "end": 2065.22, "text": "就永远不要听信别人的传言。"}, {"start": 2066.22, "end": 2067.22, "text": "末将誓言,"}, {"start": 2067.22, "end": 2068.22, "text": "末将誓言,"}, {"start": 2068.22, "end": 2070.22, "text": "末将谨记大人的教诲。"}, {"start": 2070.22, "end": 2072.66, "text": "去吧。"}, {"start": 2072.66, "end": 2101.18, "text": "少公子今天怎么没有来?"}, {"start": 2101.18, "end": 2102.18, "text": "冲帝年幼,"}, {"start": 2102.18, "end": 2106.23, "text": "兴许是累了。"}, {"start": 2106.23, "end": 2109.96, "text": "他今天应该来啊。"}, {"start": 2109.96, "end": 2110.96, "text": "为何?"}, {"start": 2113.75, "end": 2115.75, "text": "丞相今天正午必到,"}, {"start": 2115.75, "end": 2117.75, "text": "他都等了三天了,"}, {"start": 2117.75, "end": 2120.75, "text": "可是偏偏今日却没有来。"}, {"start": 2120.75, "end": 2121.75, "text": "荀大人,"}, {"start": 2121.75, "end": 2125.15, "text": "丞相到了,"}, {"start": 2125.15, "end": 2130.32, "text": "末将已看见车架了。"}, {"start": 2130.32, "end": 2134.08, "text": "造谷月,"}, {"start": 2134.08, "end": 2135.08, "text": "接驾!"}, {"start": 2135.08, "end": 2245.27, "text": "你怎么会知道"}, {"start": 2245.27, "end": 2247.27, "text": "父亲会在今日回城呢?"}, {"start": 2247.27, "end": 2248.27, "text": "连续三天,"}, {"start": 2248.27, "end": 2250.27, "text": "荀大人都令百官"}, {"start": 2250.27, "end": 2251.27, "text": "在南门迎接父亲,"}, {"start": 2251.27, "end": 2253.27, "text": "而父亲却总是不来。"}, {"start": 2253.27, "end": 2254.27, "text": "我就想,"}, {"start": 2254.27, "end": 2256.27, "text": "肯定是父亲"}, {"start": 2256.27, "end": 2257.27, "text": "让荀大人"}, {"start": 2257.27, "end": 2258.27, "text": "在南门大张旗鼓的"}, {"start": 2258.27, "end": 2260.27, "text": "下午西凉军呢。"}, {"start": 2260.27, "end": 2262.27, "text": "不过凡事不过三,"}, {"start": 2262.27, "end": 2263.27, "text": "到了今天,"}, {"start": 2263.27, "end": 2265.27, "text": "父亲就该回来了。"}, {"start": 2265.27, "end": 2268.27, "text": "可是百官都在南门接驾,"}, {"start": 2268.27, "end": 2270.27, "text": "你却为何去了西门迎我?"}, {"start": 2270.27, "end": 2272.27, "text": "仪仗在南门列阵三天,"}, {"start": 2272.27, "end": 2274.27, "text": "全许昌的人都知道了,"}, {"start": 2274.27, "end": 2275.27, "text": "西凉的贼人们"}, {"start": 2275.27, "end": 2276.27, "text": "还能不知道吗?"}, {"start": 2276.27, "end": 2279.27, "text": "如果父亲再从南门进城,"}, {"start": 2279.27, "end": 2281.27, "text": "贼子们定会行刺。"}, {"start": 2281.27, "end": 2283.27, "text": "父亲足智多谋,"}, {"start": 2283.27, "end": 2285.27, "text": "肯定不会从南门进城了。"}, {"start": 2285.27, "end": 2287.27, "text": "那你又怎么知道"}, {"start": 2287.27, "end": 2288.27, "text": "我会从西门进来呢?"}, {"start": 2288.27, "end": 2290.27, "text": "须知我也可能走东门"}, {"start": 2290.27, "end": 2291.27, "text": "或者是北门呢?"}, {"start": 2291.27, "end": 2292.27, "text": "儿子才想,"}, {"start": 2292.27, "end": 2294.27, "text": "西凉军如果攻许昌,"}, {"start": 2294.27, "end": 2296.27, "text": "必从西门来,"}, {"start": 2296.27, "end": 2297.27, "text": "因为西门面山,"}, {"start": 2297.27, "end": 2299.27, "text": "城墙损害得多些。"}, {"start": 2299.27, "end": 2300.27, "text": "父亲不是一直担心"}, {"start": 2300.27, "end": 2302.27, "text": "西门的城防吗?"}, {"start": 2302.27, "end": 2304.27, "text": "父亲进城八成会走西门,"}, {"start": 2304.27, "end": 2306.27, "text": "因为这样可以顺道"}, {"start": 2306.27, "end": 2308.27, "text": "巡视西门的城防。"}, {"start": 2310.27, "end": 2311.27, "text": "正达,"}, {"start": 2311.27, "end": 2314.62, "text": "你觉得我这儿子怎么样?"}, {"start": 2314.62, "end": 2317.62, "text": "聪慧无比,人间罕见。"}, {"start": 2317.62, "end": 2321.18, "text": "不瞒你说,"}, {"start": 2321.18, "end": 2323.18, "text": "我这四个儿子当中"}, {"start": 2323.18, "end": 2326.18, "text": "就属冲儿的资质最佳。"}, {"start": 2327.18, "end": 2330.18, "text": "就那接驾这件事情来说吧,"}, {"start": 2330.18, "end": 2331.18, "text": "皮尔他们几个"}, {"start": 2331.18, "end": 2334.18, "text": "就只知道在南门傻等。"}, {"start": 2334.18, "end": 2336.18, "text": "冲儿年纪虽巧,"}, {"start": 2336.18, "end": 2339.18, "text": "却一眼就看破了玄机,"}, {"start": 2339.18, "end": 2342.18, "text": "比他的几个兄长都强多了。"}, {"start": 2343.18, "end": 2346.58, "text": "丞相所言极是。"}, {"start": 2346.58, "end": 2350.18, "text": "冲儿,"}, {"start": 2351.18, "end": 2354.18, "text": "这个人叫司马怡,"}, {"start": 2354.18, "end": 2356.18, "text": "字重达。"}, {"start": 2356.18, "end": 2359.18, "text": "从现在起他就是你的夜师了。"}, {"start": 2359.18, "end": 2361.18, "text": "去见过师父。"}, {"start": 2361.18, "end": 2364.18, "text": "学生曹中拜见师父。"}, {"start": 2364.18, "end": 2368.51, "text": "在下断断不敢逞时,"}, {"start": 2368.51, "end": 2370.51, "text": "能为公子效力一二,"}, {"start": 2370.51, "end": 2372.51, "text": "在下不胜荣幸。"}, {"start": 2372.51, "end": 2377.81, "text": "拜见副相。"}, {"start": 2377.81, "end": 2378.81, "text": "拜见副相。"}, {"start": 2378.81, "end": 2380.81, "text": "拜见丞相。"}, {"start": 2382.81, "end": 2383.81, "text": "秦玉。"}, {"start": 2384.81, "end": 2385.81, "text": "在。"}, {"start": 2385.81, "end": 2386.81, "text": "劳你们几个在城南"}, {"start": 2386.81, "end": 2388.81, "text": "干等数日,辛苦了。"}, {"start": 2388.81, "end": 2391.81, "text": "丞相能平安归来,"}, {"start": 2391.81, "end": 2393.81, "text": "在下深感欣慰。"}, {"start": 2397.12, "end": 2399.12, "text": "禀丞相,"}, {"start": 2399.12, "end": 2401.12, "text": "这四天里公子曹皮"}, {"start": 2401.12, "end": 2404.12, "text": "每日晨时急到南门等候,"}, {"start": 2404.12, "end": 2406.12, "text": "一直等到深夜才归。"}, {"start": 2407.12, "end": 2411.12, "text": "白官们对皮公子的成效之举"}, {"start": 2411.12, "end": 2413.12, "text": "深为感。"}, {"start": 2413.12, "end": 2417.85, "text": "身为长兄,该当如此。"}, {"start": 2417.85, "end": 2419.85, "text": "刺客拿住了吗?"}, {"start": 2419.85, "end": 2421.85, "text": "儿杀死一个,"}, {"start": 2421.85, "end": 2422.85, "text": "其余的"}, {"start": 2423.85, "end": 2425.85, "text": "尚未捉到。"}, {"start": 2425.85, "end": 2427.85, "text": "他们是哪儿来的?"}, {"start": 2427.85, "end": 2428.85, "text": "刺客用的是"}, {"start": 2428.85, "end": 2430.85, "text": "西梁雕零常见,"}, {"start": 2430.85, "end": 2432.85, "text": "必定是马腾的部下。"}, {"start": 2432.85, "end": 2433.85, "text": "他们发完箭后"}, {"start": 2433.85, "end": 2434.85, "text": "随即混入了"}, {"start": 2434.85, "end": 2436.85, "text": "百姓人群当中。"}, {"start": 2436.85, "end": 2438.85, "text": "儿臣没有捉到,"}, {"start": 2438.85, "end": 2440.85, "text": "是儿臣的失职。"}, {"start": 2440.85, "end": 2441.85, "text": "这个不怪你。"}, {"start": 2441.85, "end": 2443.85, "text": "来,正好"}, {"start": 2443.85, "end": 2454.04, "text": "你们几个都在。"}, {"start": 2454.04, "end": 2457.38, "text": "今日我顺便出个题目"}, {"start": 2457.38, "end": 2458.38, "text": "考考你们。"}, {"start": 2458.38, "end": 2460.38, "text": "请父亲示下。"}, {"start": 2460.38, "end": 2462.38, "text": "眼下刺客肯定"}, {"start": 2462.38, "end": 2464.38, "text": "还在许昌城中。"}, {"start": 2464.38, "end": 2466.38, "text": "你们说说,"}, {"start": 2466.38, "end": 2469.38, "text": "我该如何应对这些刺客。"}, {"start": 2469.38, "end": 2470.38, "text": "你们想如何应对这些刺客?"}]