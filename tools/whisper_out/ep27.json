[{"start": 53.97, "end": 56.97, "text": "济州大将军袁绍禁告苍雄,"}, {"start": 56.97, "end": 58.97, "text": "曹贼逆天篡汉,"}, {"start": 58.97, "end": 60.97, "text": "徒徒生灵,祸乱天下。"}, {"start": 60.97, "end": 63.97, "text": "陈绍,成天道领王师,"}, {"start": 63.97, "end": 65.97, "text": "率大军七十万,"}, {"start": 65.97, "end": 67.97, "text": "征曹灭贼,"}, {"start": 67.97, "end": 69.97, "text": "扩清环宇。"}, {"start": 69.97, "end": 71.97, "text": "望天生护佑,"}, {"start": 71.97, "end": 73.97, "text": "助绍早奏开宣。"}, {"start": 73.97, "end": 75.97, "text": "陈绍,"}, {"start": 75.97, "end": 77.97, "text": "杀雪祭拜。"}, {"start": 90.24, "end": 92.24, "text": "济州大将军袁绍禁告帝母,"}, {"start": 94.24, "end": 96.24, "text": "曹贼逆天篡汉,"}, {"start": 96.24, "end": 98.24, "text": "徒徒天下,"}, {"start": 98.24, "end": 100.24, "text": "只是万物枯锁,"}, {"start": 100.24, "end": 102.24, "text": "民不聊生。"}, {"start": 102.24, "end": 104.24, "text": "陈绍,扶地而拜,"}, {"start": 104.24, "end": 106.24, "text": "依徒我生,"}, {"start": 106.24, "end": 108.24, "text": "为万物治表,"}, {"start": 108.24, "end": 110.24, "text": "取生灵之际,"}, {"start": 110.24, "end": 112.24, "text": "誓灭曹贼,"}, {"start": 112.24, "end": 114.24, "text": "还大地昌荣。"}, {"start": 114.24, "end": 116.24, "text": "陈绍,"}, {"start": 116.24, "end": 118.24, "text": "杀雪祭拜。"}, {"start": 127.57, "end": 129.57, "text": "绍,"}, {"start": 129.57, "end": 131.57, "text": "禁告列祖列宗,"}, {"start": 131.57, "end": 134.88, "text": "曹贼逆天篡汉,"}, {"start": 134.88, "end": 136.88, "text": "徒徒祖宗神灵,"}, {"start": 136.88, "end": 138.88, "text": "只是宗庙崩坏,"}, {"start": 138.88, "end": 140.88, "text": "刚长静悔,"}, {"start": 140.88, "end": 142.88, "text": "神灵不安。"}, {"start": 142.88, "end": 144.88, "text": "袁绍,"}, {"start": 144.88, "end": 146.88, "text": "弃血隐恨,"}, {"start": 146.88, "end": 148.88, "text": "誓灭妖孽,"}, {"start": 148.88, "end": 150.88, "text": "取曹贼首级。"}, {"start": 150.88, "end": 152.88, "text": "居于祖宗灵前,"}, {"start": 152.88, "end": 154.88, "text": "望祖宗的天灵护佑,"}, {"start": 154.88, "end": 156.88, "text": "助绍大盛全归。"}, {"start": 156.88, "end": 158.88, "text": "袁绍,"}, {"start": 158.88, "end": 160.88, "text": "杀雪祭拜。"}, {"start": 185.81, "end": 187.81, "text": "外面为何有鼓吼之声?"}, {"start": 187.81, "end": 189.81, "text": "主公正在举行"}, {"start": 189.81, "end": 191.81, "text": "征曹试试大会,"}, {"start": 191.81, "end": 193.81, "text": "祭天祭地祭祖封之灵。"}, {"start": 193.81, "end": 195.81, "text": "主公又要出使?"}, {"start": 195.81, "end": 197.81, "text": "是,听说"}, {"start": 197.81, "end": 199.81, "text": "主公祖宗有七十万大军。"}, {"start": 199.81, "end": 201.81, "text": "徒有虚名罢了。"}, {"start": 201.81, "end": 203.81, "text": "快,去禀报,"}, {"start": 203.81, "end": 205.81, "text": "我要给主公上书觐见。"}, {"start": 205.81, "end": 207.81, "text": "大人,罢了罢了,"}, {"start": 207.81, "end": 209.81, "text": "你就是因为禁键才进了这牢房啊。"}, {"start": 209.81, "end": 211.81, "text": "我宁可因箭而死,"}, {"start": 211.81, "end": 213.81, "text": "也绝不会言,"}, {"start": 213.81, "end": 215.81, "text": "曲彼默。"}, {"start": 215.81, "end": 250.06, "text": "三军将士,"}, {"start": 250.06, "end": 252.06, "text": "敬听我言,"}, {"start": 252.06, "end": 255.5, "text": "此战,"}, {"start": 255.5, "end": 257.5, "text": "不仅决定着"}, {"start": 257.5, "end": 259.5, "text": "元氏一族的生死存亡,"}, {"start": 261.74, "end": 263.74, "text": "也决定着列位将士的"}, {"start": 263.74, "end": 265.74, "text": "获复荣辱。"}, {"start": 265.74, "end": 267.74, "text": "此战,"}, {"start": 267.74, "end": 269.74, "text": "决定着未来五百年的历史,"}, {"start": 269.74, "end": 271.74, "text": "决定着皇朝天下的"}, {"start": 271.74, "end": 273.74, "text": "最后归属。"}, {"start": 273.74, "end": 278.43, "text": "生死存亡,"}, {"start": 278.43, "end": 280.43, "text": "获复荣辱,"}, {"start": 280.43, "end": 282.43, "text": "皇朝天下,"}, {"start": 282.43, "end": 334.77, "text": "坚决于此战。"}, {"start": 334.77, "end": 336.77, "text": "冯丰又在辱我,"}, {"start": 336.77, "end": 338.77, "text": "他上书让我休兵停战,"}, {"start": 338.77, "end": 340.77, "text": "一时大战前夕了,"}, {"start": 340.77, "end": 342.77, "text": "他竟敢还大发安隐,"}, {"start": 342.77, "end": 344.77, "text": "乱我军心。"}, {"start": 344.77, "end": 350.42, "text": "禀副帅,"}, {"start": 350.42, "end": 354.08, "text": "祭天,祭地,"}, {"start": 354.08, "end": 356.08, "text": "祭祖之后,"}, {"start": 356.08, "end": 358.08, "text": "尚缺遗物祭旗,"}, {"start": 358.08, "end": 360.08, "text": "禀副帅用填封手机祭旗,"}, {"start": 360.08, "end": 362.08, "text": "以壮军威。"}, {"start": 362.08, "end": 364.08, "text": "不可不可,主公,"}, {"start": 364.08, "end": 366.08, "text": "万万不可呀,"}, {"start": 366.08, "end": 368.08, "text": "眼下这战端"}, {"start": 368.08, "end": 370.08, "text": "尚未开启,"}, {"start": 370.08, "end": 373.42, "text": "我们却先斩臣下,"}, {"start": 373.42, "end": 375.42, "text": "这对我们此次出师远征,"}, {"start": 375.42, "end": 377.42, "text": "剿灭那曹贼,"}, {"start": 377.42, "end": 379.42, "text": "空飞吉兆。"}, {"start": 379.42, "end": 384.5, "text": "意你之间呢?"}, {"start": 384.5, "end": 389.38, "text": "依在下愚笨之见,"}, {"start": 389.38, "end": 391.38, "text": "倒不如"}, {"start": 391.38, "end": 393.38, "text": "等我们大获全胜,"}, {"start": 393.38, "end": 395.38, "text": "凯旋归来之后,"}, {"start": 397.38, "end": 399.38, "text": "也好让那个,"}, {"start": 399.38, "end": 401.38, "text": "平时只会夸夸其谈,"}, {"start": 401.38, "end": 403.38, "text": "实为迂腐短剑,"}, {"start": 403.38, "end": 405.38, "text": "鼠目寸光的小人田凤,"}, {"start": 405.38, "end": 407.38, "text": "亲自看到主公,"}, {"start": 407.38, "end": 409.38, "text": "你辉煌的战绩,"}, {"start": 409.38, "end": 411.38, "text": "丰功伟业。"}, {"start": 411.38, "end": 413.38, "text": "到那时,"}, {"start": 413.38, "end": 415.38, "text": "到那时主公,"}, {"start": 415.38, "end": 417.38, "text": "你再赐他自尽,"}, {"start": 417.38, "end": 421.23, "text": "也不为耻啊。"}, {"start": 421.23, "end": 424.61, "text": "好,等我取了他的手机,"}, {"start": 424.61, "end": 426.61, "text": "和曹贼的手机放在一起,"}, {"start": 426.61, "end": 428.61, "text": "一把火烧干净。"}, {"start": 430.61, "end": 432.61, "text": "如此极好,"}, {"start": 432.61, "end": 434.61, "text": "如此极妙。"}, {"start": 434.61, "end": 438.69, "text": "徐游。在。"}, {"start": 438.69, "end": 440.69, "text": "传令。明谷。"}, {"start": 440.69, "end": 461.92, "text": "主公有令。"}, {"start": 461.92, "end": 463.92, "text": "我先头大军与陈师上路,"}, {"start": 463.92, "end": 465.92, "text": "天已过正午,"}, {"start": 465.92, "end": 467.92, "text": "后军才刚刚出城,"}, {"start": 467.92, "end": 469.92, "text": "前后相连近百里啊。"}, {"start": 469.92, "end": 473.58, "text": "主公啊,"}, {"start": 473.58, "end": 475.58, "text": "像今天这般,"}, {"start": 475.58, "end": 477.58, "text": "在那儿处的大军,"}, {"start": 477.58, "end": 479.58, "text": "似潮水般涌动,"}, {"start": 479.58, "end": 481.58, "text": "真乃金骨罕见,"}, {"start": 481.58, "end": 483.58, "text": "海内奇观啊。"}, {"start": 485.58, "end": 487.58, "text": "国相曹操,"}, {"start": 487.58, "end": 489.58, "text": "已知我军所向,"}, {"start": 489.58, "end": 491.58, "text": "但愿他,"}, {"start": 491.58, "end": 493.58, "text": "只为风丧感才好。"}, {"start": 495.58, "end": 497.58, "text": "主公,"}, {"start": 497.58, "end": 499.58, "text": "此处据那曹操首府许昌,"}, {"start": 499.58, "end": 501.58, "text": "一百三十里,"}, {"start": 501.58, "end": 503.58, "text": "据关渡八十里,"}, {"start": 503.58, "end": 505.58, "text": "少记探报,"}, {"start": 505.58, "end": 507.58, "text": "曹操将沿途的车站、兵马、资众,"}, {"start": 507.58, "end": 509.58, "text": "全部收入了许昌,"}, {"start": 509.58, "end": 511.58, "text": "由此可见,"}, {"start": 511.58, "end": 517.68, "text": "他已有所准备啊。"}, {"start": 517.68, "end": 519.68, "text": "传令。"}, {"start": 519.68, "end": 521.68, "text": "军至关渡下寨,"}, {"start": 521.68, "end": 523.68, "text": "分炸三座大营,"}, {"start": 523.68, "end": 525.68, "text": "形成相互侧应之势。"}, {"start": 525.68, "end": 527.68, "text": "招令。"}, {"start": 527.68, "end": 535.7, "text": "元兆于济州实施,"}, {"start": 535.7, "end": 537.7, "text": "沙雪济天,济地济祖,"}, {"start": 537.7, "end": 539.7, "text": "其水路大军七十万,"}, {"start": 539.7, "end": 541.7, "text": "于三日前向许昌而来。"}, {"start": 541.7, "end": 543.7, "text": "元兆的三位公子"}, {"start": 543.7, "end": 545.7, "text": "都率军驻战,并征作先锋。"}, {"start": 545.7, "end": 547.7, "text": "元军拥有"}, {"start": 547.7, "end": 549.7, "text": "萧綦镇、公鲁镇、"}, {"start": 549.7, "end": 551.7, "text": "铁甲镇、战车镇。"}, {"start": 551.7, "end": 553.7, "text": "他们粮草充足,"}, {"start": 553.7, "end": 555.7, "text": "工程期限无数。"}, {"start": 555.7, "end": 557.7, "text": "少记探报,元军陆路绵延百里,"}, {"start": 557.7, "end": 559.7, "text": "水路绵延五十里。"}, {"start": 559.7, "end": 561.7, "text": "其先锋已今日抵达关渡前线。"}, {"start": 561.7, "end": 567.73, "text": "列位可能"}, {"start": 567.73, "end": 569.73, "text": "没见过这么多的兵马,"}, {"start": 569.73, "end": 571.73, "text": "也没听过"}, {"start": 571.73, "end": 573.73, "text": "这么大的阵势。"}, {"start": 573.73, "end": 575.73, "text": "元兆有一句话说得不错,"}, {"start": 575.73, "end": 577.73, "text": "此战"}, {"start": 577.73, "end": 579.73, "text": "将决定今后"}, {"start": 579.73, "end": 581.73, "text": "五百年的历史,"}, {"start": 581.73, "end": 583.73, "text": "决定皇朝天下"}, {"start": 583.73, "end": 585.73, "text": "归于水手。"}, {"start": 585.73, "end": 590.48, "text": "大伙说说吧,"}, {"start": 590.48, "end": 592.48, "text": "是战"}, {"start": 592.48, "end": 594.48, "text": "是和,"}, {"start": 594.48, "end": 596.48, "text": "如战,"}, {"start": 596.48, "end": 598.48, "text": "那么是"}, {"start": 598.48, "end": 600.48, "text": "急战呢,还是缓战?"}, {"start": 600.48, "end": 602.48, "text": "如和,"}, {"start": 602.48, "end": 604.48, "text": "那么是"}, {"start": 604.48, "end": 606.48, "text": "议和呢,还是求和?"}, {"start": 606.48, "end": 610.18, "text": "列位竟可直言?"}, {"start": 610.18, "end": 615.38, "text": "丞相,"}, {"start": 615.38, "end": 617.38, "text": "元兆势大,"}, {"start": 617.38, "end": 619.38, "text": "其兵风也正劲,"}, {"start": 619.38, "end": 621.38, "text": "在下建议,"}, {"start": 621.38, "end": 623.38, "text": "必战而言和,"}, {"start": 623.38, "end": 625.38, "text": "先言时日,观其待变,"}, {"start": 625.38, "end": 627.38, "text": "以谋后发之人。"}, {"start": 627.38, "end": 629.38, "text": "在下"}, {"start": 629.38, "end": 631.38, "text": "不议!"}, {"start": 631.38, "end": 633.38, "text": "在下不议!"}, {"start": 633.38, "end": 639.22, "text": "臣主战,"}, {"start": 639.22, "end": 641.22, "text": "丞相非战不可,"}, {"start": 641.22, "end": 643.22, "text": "却是立战,急战。"}, {"start": 643.22, "end": 645.22, "text": "为何呢?"}, {"start": 645.22, "end": 649.1, "text": "我不懂兵,"}, {"start": 649.1, "end": 651.1, "text": "但我痛切知道"}, {"start": 651.1, "end": 653.1, "text": "元兆的心理,"}, {"start": 653.1, "end": 655.1, "text": "他此次进京是非取喜昌不可,"}, {"start": 655.1, "end": 657.1, "text": "丞相要和,"}, {"start": 657.1, "end": 659.1, "text": "他也不会和。"}, {"start": 659.1, "end": 661.1, "text": "此外,元兆军势随大,"}, {"start": 661.1, "end": 663.1, "text": "那也是徒有虚名。"}, {"start": 663.1, "end": 665.1, "text": "请问各位将军,"}, {"start": 665.1, "end": 667.1, "text": "区区一个官允,"}, {"start": 667.1, "end": 669.1, "text": "就敢在三日之内"}, {"start": 669.1, "end": 671.1, "text": "连斩严良和文丑?"}, {"start": 671.1, "end": 673.1, "text": "难道你们这些"}, {"start": 673.1, "end": 675.1, "text": "身经百战的虎将,"}, {"start": 675.1, "end": 677.1, "text": "连一个官允都不如吗?"}, {"start": 677.1, "end": 683.52, "text": "是!"}, {"start": 683.52, "end": 686.86, "text": "愿为先锋!"}, {"start": 686.86, "end": 688.86, "text": "末将只需两万精兵,"}, {"start": 688.86, "end": 702.0, "text": "定能大破敌军!"}, {"start": 702.0, "end": 704.0, "text": "我在二十岁左右的时候,"}, {"start": 704.0, "end": 706.0, "text": "还是相当地"}, {"start": 706.0, "end": 708.0, "text": "崇拜元兆老兄的。"}, {"start": 708.0, "end": 710.0, "text": "为何呢?"}, {"start": 710.0, "end": 712.0, "text": "因为他祖上"}, {"start": 712.0, "end": 714.0, "text": "私事三功,"}, {"start": 714.0, "end": 716.0, "text": "门身故立,遍天下。"}, {"start": 716.0, "end": 718.0, "text": "而我的祖父是个宦管,"}, {"start": 718.0, "end": 720.0, "text": "我自愧不辱,"}, {"start": 720.0, "end": 722.0, "text": "活受元兆取笑。"}, {"start": 724.0, "end": 726.0, "text": "三十岁上下呢,"}, {"start": 726.0, "end": 728.0, "text": "我和他同朝称臣,"}, {"start": 728.0, "end": 730.0, "text": "我外表尊敬他,"}, {"start": 730.0, "end": 732.0, "text": "内心里"}, {"start": 732.0, "end": 734.0, "text": "已经瞧不上他了。"}, {"start": 734.0, "end": 736.0, "text": "为何呢?"}, {"start": 736.0, "end": 738.0, "text": "因为正是他"}, {"start": 738.0, "end": 740.0, "text": "请董卓引军入京,"}, {"start": 740.0, "end": 742.0, "text": "造成了天下大乱。"}, {"start": 742.0, "end": 744.0, "text": "而我"}, {"start": 744.0, "end": 746.0, "text": "早就告诉过他,"}, {"start": 746.0, "end": 748.0, "text": "这样做"}, {"start": 748.0, "end": 750.0, "text": "只能引狼入室,"}, {"start": 750.0, "end": 752.0, "text": "必将自取其祸。"}, {"start": 752.0, "end": 759.22, "text": "四十岁左右,"}, {"start": 761.22, "end": 763.22, "text": "我与他各霸一方,"}, {"start": 763.22, "end": 765.22, "text": "我简直开始蔑视他。"}, {"start": 765.22, "end": 769.2, "text": "为何呢?"}, {"start": 769.2, "end": 771.2, "text": "因为他身为人主,"}, {"start": 773.2, "end": 775.2, "text": "却心胸狭隘,"}, {"start": 775.2, "end": 777.2, "text": "气势浅薄,"}, {"start": 777.2, "end": 780.9, "text": "外宽内济,"}, {"start": 780.9, "end": 782.9, "text": "刚必夺一。"}, {"start": 782.9, "end": 784.9, "text": "身为统帅,"}, {"start": 784.9, "end": 786.9, "text": "却有谋而无断,"}, {"start": 786.9, "end": 788.9, "text": "色利而胆薄,"}, {"start": 788.9, "end": 790.9, "text": "兵多,"}, {"start": 790.9, "end": 792.9, "text": "而指挥不宜,"}, {"start": 792.9, "end": 794.9, "text": "将交,"}, {"start": 794.9, "end": 796.9, "text": "而政令不明。"}, {"start": 796.9, "end": 798.9, "text": "身为人妇,"}, {"start": 798.9, "end": 800.9, "text": "却听任几个儿子,"}, {"start": 800.9, "end": 802.9, "text": "拥兵自重,"}, {"start": 802.9, "end": 804.9, "text": "争夺世子大位,"}, {"start": 804.9, "end": 806.9, "text": "用亲,"}, {"start": 806.9, "end": 811.52, "text": "不用嫌。"}, {"start": 811.52, "end": 813.52, "text": "我可见,"}, {"start": 813.52, "end": 815.52, "text": "我这位"}, {"start": 815.52, "end": 817.52, "text": "袁绍老兄,"}, {"start": 817.52, "end": 819.52, "text": "无论是为人主,"}, {"start": 819.52, "end": 821.52, "text": "为人妇,"}, {"start": 821.52, "end": 823.52, "text": "还是为统帅,"}, {"start": 823.52, "end": 825.52, "text": "都是外表庄严,"}, {"start": 825.52, "end": 828.93, "text": "内力平庸。"}, {"start": 828.93, "end": 830.93, "text": "这场战役,"}, {"start": 830.93, "end": 832.93, "text": "其实八年前我就预料到了。"}, {"start": 832.93, "end": 834.93, "text": "我们相继,"}, {"start": 834.93, "end": 836.93, "text": "破袁术,"}, {"start": 836.93, "end": 838.93, "text": "灭吕布,"}, {"start": 838.93, "end": 840.93, "text": "迎天子,"}, {"start": 840.93, "end": 842.93, "text": "拥据中原,"}, {"start": 842.93, "end": 844.93, "text": "早晚,"}, {"start": 844.93, "end": 846.93, "text": "必将和袁绍"}, {"start": 846.93, "end": 848.93, "text": "有一场最终的决战。"}, {"start": 848.93, "end": 850.93, "text": "所以八年来,"}, {"start": 850.93, "end": 852.93, "text": "我无日无夜地"}, {"start": 852.93, "end": 854.93, "text": "不为此战做着准备。"}, {"start": 854.93, "end": 856.93, "text": "今日我且直言,"}, {"start": 856.93, "end": 858.93, "text": "八年前,"}, {"start": 858.93, "end": 860.93, "text": "袁绍拥兵三十万,"}, {"start": 860.93, "end": 862.93, "text": "我想,"}, {"start": 862.93, "end": 864.93, "text": "我怎么也得有二十万兵马"}, {"start": 864.93, "end": 866.93, "text": "才能战胜他。"}, {"start": 866.93, "end": 868.93, "text": "三年前,"}, {"start": 868.93, "end": 870.93, "text": "袁绍已经拥兵五十万。"}, {"start": 870.93, "end": 872.93, "text": "我想,"}, {"start": 872.93, "end": 874.93, "text": "我怎么也得有十万兵马"}, {"start": 874.93, "end": 876.93, "text": "才能战胜他。"}, {"start": 876.93, "end": 878.93, "text": "现如今,"}, {"start": 878.93, "end": 880.93, "text": "袁绍已经拥兵七十万了。"}, {"start": 880.93, "end": 882.93, "text": "天下周军,"}, {"start": 882.93, "end": 884.93, "text": "他一个人独占了四个,"}, {"start": 884.93, "end": 886.93, "text": "可谓声势滔天了吧!"}, {"start": 886.93, "end": 890.21, "text": "可是我现在想,"}, {"start": 890.21, "end": 892.21, "text": "如要战胜袁绍,"}, {"start": 894.21, "end": 896.21, "text": "我只要精兵七万即可。"}, {"start": 896.21, "end": 898.21, "text": "为何袁绍拥兵越来越少?"}, {"start": 898.21, "end": 900.21, "text": "反而丞相拥兵越来越少?"}, {"start": 900.21, "end": 902.21, "text": "因为兵不再多,"}, {"start": 902.21, "end": 904.21, "text": "再精,"}, {"start": 904.21, "end": 906.21, "text": "将不再勇,"}, {"start": 906.21, "end": 908.21, "text": "再谋。"}, {"start": 908.21, "end": 910.21, "text": "如果要比将士多寡,"}, {"start": 910.21, "end": 912.21, "text": "我永远也比不上袁绍。"}, {"start": 912.21, "end": 914.21, "text": "可是要比起精悍和志谋,"}, {"start": 914.21, "end": 916.21, "text": "三个原本出绑一块,"}, {"start": 916.21, "end": 918.21, "text": "也比不上我一个曹总。"}, {"start": 918.21, "end": 926.74, "text": "曹仁,"}, {"start": 926.74, "end": 928.74, "text": "把我为袁绍准备的兵马"}, {"start": 928.74, "end": 930.74, "text": "说给大伙听听。"}, {"start": 930.74, "end": 932.74, "text": "诺。"}, {"start": 932.74, "end": 937.62, "text": "练卫,"}, {"start": 937.62, "end": 939.62, "text": "在八年前,"}, {"start": 939.62, "end": 941.62, "text": "袁绍拥兵,"}, {"start": 941.62, "end": 943.62, "text": "把各部的轻壮猛士"}, {"start": 943.62, "end": 945.62, "text": "抽掉于衍州境内,"}, {"start": 945.62, "end": 947.62, "text": "在那里日夜练兵。"}, {"start": 947.62, "end": 949.62, "text": "现在,"}, {"start": 949.62, "end": 951.62, "text": "袁绍拥兵已练出七万精甲。"}, {"start": 951.62, "end": 953.62, "text": "他们全部都是"}, {"start": 953.62, "end": 955.62, "text": "身经百战的猛士。"}, {"start": 955.62, "end": 957.62, "text": "全部都是勇中之勇,"}, {"start": 957.62, "end": 959.62, "text": "精中之精。"}, {"start": 959.62, "end": 961.62, "text": "其中,"}, {"start": 961.62, "end": 963.62, "text": "四万铁骑,"}, {"start": 963.62, "end": 965.62, "text": "一万长枪壮士,"}, {"start": 965.62, "end": 967.62, "text": "八千重装甲步军。"}, {"start": 967.62, "end": 969.62, "text": "其他的,"}, {"start": 969.62, "end": 971.62, "text": "全部都是弓弩手,"}, {"start": 971.62, "end": 981.49, "text": "与皮里车。"}, {"start": 981.49, "end": 983.49, "text": "这七万精甲,"}, {"start": 983.49, "end": 985.49, "text": "就是我们的剑手,毛头。"}, {"start": 985.49, "end": 987.49, "text": "他一击之下,"}, {"start": 987.49, "end": 989.49, "text": "定能刺穿袁绍的三军。"}, {"start": 991.49, "end": 993.49, "text": "大伙可能会问,"}, {"start": 993.49, "end": 995.49, "text": "我们不是还有二十万人马吗?"}, {"start": 995.49, "end": 997.49, "text": "他们干什么?"}, {"start": 997.49, "end": 999.49, "text": "我告诉你们,"}, {"start": 999.49, "end": 1001.49, "text": "这二十万人马,"}, {"start": 1001.49, "end": 1003.49, "text": "只有一个任务,"}, {"start": 1003.49, "end": 1005.49, "text": "那就是带援军溃败之时,"}, {"start": 1005.49, "end": 1007.49, "text": "放手让他们追杀,"}, {"start": 1007.49, "end": 1009.49, "text": "直到把援军"}, {"start": 1009.49, "end": 1011.49, "text": "斩尽,杀绝。"}, {"start": 1011.49, "end": 1013.49, "text": "遵命!"}, {"start": 1013.49, "end": 1016.9, "text": "这场战役,"}, {"start": 1016.9, "end": 1020.46, "text": "实际上只有一战,"}, {"start": 1020.46, "end": 1027.04, "text": "首战胜,"}, {"start": 1027.04, "end": 1029.04, "text": "袁绍兵败如山倒,"}, {"start": 1029.04, "end": 1031.04, "text": "天下归伍,"}, {"start": 1031.04, "end": 1033.04, "text": "首战不胜,"}, {"start": 1033.04, "end": 1035.04, "text": "我们藏家失所,"}, {"start": 1035.04, "end": 1037.04, "text": "死无葬身之地,"}, {"start": 1037.04, "end": 1039.04, "text": "所以,"}, {"start": 1039.04, "end": 1041.04, "text": "七万精甲,"}, {"start": 1041.04, "end": 1043.04, "text": "全部入首战,"}, {"start": 1043.04, "end": 1045.04, "text": "一战,"}, {"start": 1045.04, "end": 1047.04, "text": "定乾坤。"}, {"start": 1047.04, "end": 1052.62, "text": "诺!"}, {"start": 1052.62, "end": 1054.62, "text": "皮儿啊,"}, {"start": 1054.62, "end": 1056.62, "text": "我只留给你八千老弱"}, {"start": 1056.62, "end": 1058.62, "text": "驻守徐昌礼,守得住吗?"}, {"start": 1058.62, "end": 1060.62, "text": "父亲放心,"}, {"start": 1060.62, "end": 1062.62, "text": "儿定能守得住,"}, {"start": 1062.62, "end": 1064.62, "text": "或许这八千兵勇都还多了。"}, {"start": 1064.62, "end": 1066.62, "text": "为什么呢?"}, {"start": 1066.62, "end": 1068.62, "text": "徐大夫说过,主公精兵所向,"}, {"start": 1068.62, "end": 1070.62, "text": "袁绍无暇踏步。"}, {"start": 1070.62, "end": 1075.06, "text": "好,"}, {"start": 1075.06, "end": 1077.06, "text": "你要多向巡弋学习,"}, {"start": 1077.06, "end": 1086.61, "text": "方能成大旗。"}, {"start": 1086.61, "end": 1091.3, "text": "还是明白。"}, {"start": 1091.3, "end": 1093.3, "text": "丞相,在下认为,"}, {"start": 1093.3, "end": 1095.3, "text": "袁绍兵多并不可怕,"}, {"start": 1095.3, "end": 1097.3, "text": "可怕的是他粮毒。"}, {"start": 1097.3, "end": 1099.3, "text": "闻听袁绍为此战准备了"}, {"start": 1099.3, "end": 1101.3, "text": "两百多万袋粮草,"}, {"start": 1101.3, "end": 1103.3, "text": "而主公只有十五日之粮,"}, {"start": 1103.3, "end": 1105.3, "text": "此战断然不可言诺。"}, {"start": 1105.3, "end": 1107.3, "text": "回回征战我都是为粮草操心,"}, {"start": 1107.3, "end": 1109.3, "text": "这回又是。"}, {"start": 1109.3, "end": 1115.68, "text": "十五日之内,"}, {"start": 1115.68, "end": 1117.68, "text": "必须结束战事。"}, {"start": 1117.68, "end": 1137.18, "text": "丞相,"}, {"start": 1137.18, "end": 1139.18, "text": "大军距关渡,还有二十里,"}, {"start": 1139.18, "end": 1141.18, "text": "袁军已在山坡下,"}, {"start": 1141.18, "end": 1143.18, "text": "扎住阵脚。"}, {"start": 1143.18, "end": 1147.26, "text": "袁绍大军面朝何方?"}, {"start": 1147.26, "end": 1154.64, "text": "北东朝西。"}, {"start": 1154.64, "end": 1156.64, "text": "好,待会儿我要请袁绍"}, {"start": 1156.64, "end": 1158.64, "text": "吃杯茶,"}, {"start": 1158.64, "end": 1160.64, "text": "扶阵吧。"}, {"start": 1160.64, "end": 1162.64, "text": "诺,徐楚张流!"}, {"start": 1162.64, "end": 1164.64, "text": "你们速率四万铁骑,"}, {"start": 1164.64, "end": 1166.64, "text": "绕袭袁军后路。"}, {"start": 1166.64, "end": 1168.64, "text": "在!"}, {"start": 1168.64, "end": 1170.64, "text": "下侯蹲下侯冤!"}, {"start": 1170.64, "end": 1172.64, "text": "在!"}, {"start": 1172.64, "end": 1174.64, "text": "你们率霹雳战阵,守护中军!"}, {"start": 1174.64, "end": 1176.64, "text": "在!"}, {"start": 1176.64, "end": 1178.64, "text": "你们率长江战为前军!"}, {"start": 1178.64, "end": 1180.64, "text": "在!"}, {"start": 1180.64, "end": 1182.64, "text": "你们率弓弩手,射住袁军阵脚!"}, {"start": 1182.64, "end": 1184.64, "text": "在!"}, {"start": 1184.64, "end": 1258.16, "text": "那曹贼一向诡计多端,"}, {"start": 1258.16, "end": 1260.16, "text": "主公不必踩他。"}, {"start": 1260.16, "end": 1262.16, "text": "即刻传令,令三军眼杀过去便是。"}, {"start": 1264.16, "end": 1266.16, "text": "不,"}, {"start": 1266.16, "end": 1268.16, "text": "今日之议,"}, {"start": 1268.16, "end": 1270.16, "text": "必为清时所宰,"}, {"start": 1270.16, "end": 1272.16, "text": "传于后事。"}, {"start": 1272.16, "end": 1274.16, "text": "我军天威浩大,"}, {"start": 1274.16, "end": 1276.16, "text": "胜券在握。"}, {"start": 1278.16, "end": 1280.16, "text": "我可以堂堂正正取曹操的首级,"}, {"start": 1280.16, "end": 1282.16, "text": "又何必要偷袭呢?"}, {"start": 1284.16, "end": 1286.16, "text": "令三军待命,"}, {"start": 1286.16, "end": 1288.16, "text": "弓弩迎而不发。"}, {"start": 1290.16, "end": 1292.16, "text": "我倒想要听听"}, {"start": 1292.16, "end": 1294.16, "text": "他都死到临头了,"}, {"start": 1294.16, "end": 1297.41, "text": "有何话说?"}, {"start": 1297.41, "end": 1299.41, "text": "主公,"}, {"start": 1299.41, "end": 1301.41, "text": "不可大意。"}, {"start": 1301.41, "end": 1303.41, "text": "看我如何戏他。"}, {"start": 1327.3, "end": 1329.3, "text": "本主兄,"}, {"start": 1329.3, "end": 1331.3, "text": "别来无恙了。"}, {"start": 1331.3, "end": 1333.3, "text": "多谢孟德挂怀。"}, {"start": 1333.3, "end": 1335.3, "text": "本人一日好过一日,"}, {"start": 1335.3, "end": 1337.3, "text": "一年"}, {"start": 1337.3, "end": 1339.3, "text": "胜死一年。"}, {"start": 1339.3, "end": 1345.42, "text": "本主兄,"}, {"start": 1345.42, "end": 1350.37, "text": "你不是朝廷的"}, {"start": 1350.37, "end": 1354.0, "text": "成相吗?"}, {"start": 1354.0, "end": 1356.0, "text": "何必信呢?"}, {"start": 1356.0, "end": 1358.0, "text": "人家说我名为汉相,"}, {"start": 1358.0, "end": 1360.0, "text": "实为汉贼。"}, {"start": 1360.0, "end": 1362.0, "text": "本主兄,"}, {"start": 1362.0, "end": 1364.0, "text": "年长,"}, {"start": 1364.0, "end": 1367.5, "text": "自当为尊。"}, {"start": 1367.5, "end": 1390.24, "text": "多谢了。"}, {"start": 1390.24, "end": 1392.24, "text": "咱们俩的交情,"}, {"start": 1392.24, "end": 1396.29, "text": "说起来话长。"}, {"start": 1396.29, "end": 1398.29, "text": "从小咱们就是亲密无间。"}, {"start": 1398.29, "end": 1400.29, "text": "我记得想当年,"}, {"start": 1400.29, "end": 1402.29, "text": "兄台领着我们是"}, {"start": 1402.29, "end": 1404.29, "text": "玩遍了洛阳城。"}, {"start": 1404.29, "end": 1406.29, "text": "那天,"}, {"start": 1406.29, "end": 1408.29, "text": "驾鹰打猎,"}, {"start": 1408.29, "end": 1410.29, "text": "晚上,"}, {"start": 1410.29, "end": 1412.29, "text": "循环作乐。"}, {"start": 1412.29, "end": 1414.29, "text": "那日子真是痛快。"}, {"start": 1414.29, "end": 1416.29, "text": "我有时候想,"}, {"start": 1416.29, "end": 1418.29, "text": "你说这人,"}, {"start": 1418.29, "end": 1420.29, "text": "要是永远不长大,"}, {"start": 1420.29, "end": 1422.29, "text": "那该多好。"}, {"start": 1422.29, "end": 1424.29, "text": "那些丑事,"}, {"start": 1424.29, "end": 1426.29, "text": "孟德还好意思说。"}, {"start": 1426.29, "end": 1428.29, "text": "人不能够忘本啊。"}, {"start": 1428.29, "end": 1430.29, "text": "不能因为,"}, {"start": 1430.29, "end": 1432.29, "text": "你我现在是朝廷重臣,"}, {"start": 1432.29, "end": 1434.29, "text": "国家动量,"}, {"start": 1434.29, "end": 1436.29, "text": "就毁颜以前的丑心。"}, {"start": 1436.29, "end": 1438.29, "text": "常言道,"}, {"start": 1438.29, "end": 1440.29, "text": "人非圣贤,"}, {"start": 1440.29, "end": 1442.29, "text": "殊能无果。"}, {"start": 1442.29, "end": 1444.29, "text": "孟德,"}, {"start": 1444.29, "end": 1446.29, "text": "我不是来和你怀旧的。"}, {"start": 1446.29, "end": 1449.82, "text": "你有什么话赶紧说。"}, {"start": 1449.82, "end": 1451.82, "text": "我那三军将士,"}, {"start": 1451.82, "end": 1453.82, "text": "已经不耐烦了。"}, {"start": 1458.7, "end": 1464.96, "text": "怎么说呢?"}, {"start": 1464.96, "end": 1466.96, "text": "你此次举七十万大军,"}, {"start": 1466.96, "end": 1470.37, "text": "罚我,"}, {"start": 1470.37, "end": 1476.18, "text": "我只支持。"}, {"start": 1476.18, "end": 1478.18, "text": "此话怎讲?"}, {"start": 1478.18, "end": 1480.18, "text": "因为此战,"}, {"start": 1480.18, "end": 1482.18, "text": "如果再推迟五年,"}, {"start": 1482.18, "end": 1485.78, "text": "军必败,我必胜。"}, {"start": 1485.78, "end": 1489.31, "text": "可是现在,"}, {"start": 1489.31, "end": 1492.59, "text": "我不是你的对手。"}, {"start": 1492.59, "end": 1496.54, "text": "我早就料到了,"}, {"start": 1496.54, "end": 1500.05, "text": "我岂能等你五年。"}, {"start": 1500.05, "end": 1505.7, "text": "孟德,"}, {"start": 1505.7, "end": 1509.33, "text": "既然你已经知道了,"}, {"start": 1509.33, "end": 1511.33, "text": "胜负已定,"}, {"start": 1511.33, "end": 1513.33, "text": "不如,"}, {"start": 1513.33, "end": 1516.61, "text": "干脆归乡与我。"}, {"start": 1516.61, "end": 1518.61, "text": "那你那万千将士,"}, {"start": 1518.61, "end": 1520.61, "text": "跟着你送死。"}, {"start": 1520.61, "end": 1522.61, "text": "可是你知道我的性子,"}, {"start": 1522.61, "end": 1524.61, "text": "我是宁四爷不愿意投降的。"}, {"start": 1524.61, "end": 1526.61, "text": "那你我还废话干吗?"}, {"start": 1526.61, "end": 1530.59, "text": "兄弟,"}, {"start": 1530.59, "end": 1532.59, "text": "我虽然不愿意投降,"}, {"start": 1532.59, "end": 1534.59, "text": "却愿意和兄弟请和。"}, {"start": 1534.59, "end": 1538.67, "text": "请和?"}, {"start": 1538.67, "end": 1540.67, "text": "或者说是,"}, {"start": 1540.67, "end": 1542.67, "text": "启和,求和。"}, {"start": 1542.67, "end": 1544.67, "text": "都成,"}, {"start": 1544.67, "end": 1553.14, "text": "随你高兴。"}, {"start": 1553.14, "end": 1557.63, "text": "曹安门啊,曹安门。"}, {"start": 1557.63, "end": 1559.63, "text": "三寸雕蛇,"}, {"start": 1559.63, "end": 1561.63, "text": "就想骗我撤军?"}, {"start": 1561.63, "end": 1563.63, "text": "不敢,不敢骗你。"}, {"start": 1563.63, "end": 1565.63, "text": "乃是,"}, {"start": 1565.63, "end": 1567.63, "text": "请和。"}, {"start": 1567.63, "end": 1572.7, "text": "如果你此刻愿意退兵的话,"}, {"start": 1572.7, "end": 1576.08, "text": "我愿意,"}, {"start": 1576.08, "end": 1578.08, "text": "让出徐州六军,"}, {"start": 1578.08, "end": 1580.08, "text": "只保留"}, {"start": 1580.08, "end": 1582.08, "text": "眼州一地。"}, {"start": 1582.08, "end": 1584.08, "text": "而且我发誓,"}, {"start": 1584.08, "end": 1586.08, "text": "永远,"}, {"start": 1586.08, "end": 1588.08, "text": "不和兄台争天下。"}, {"start": 1588.08, "end": 1596.74, "text": "此话当真?"}, {"start": 1596.74, "end": 1598.74, "text": "为了表示我的真心,"}, {"start": 1598.74, "end": 1600.74, "text": "我此番特意带来了"}, {"start": 1600.74, "end": 1604.75, "text": "请和之物。"}, {"start": 1604.75, "end": 1617.02, "text": "请看。"}, {"start": 1617.02, "end": 1619.02, "text": "你所说的请和之物,"}, {"start": 1619.02, "end": 1621.02, "text": "竟然是,"}, {"start": 1621.02, "end": 1623.02, "text": "大汉天子。"}, {"start": 1623.02, "end": 1625.02, "text": "他不配吗?"}, {"start": 1625.02, "end": 1627.02, "text": "难道他不是兄台,"}, {"start": 1627.02, "end": 1629.02, "text": "朝思暮想之物?"}, {"start": 1629.02, "end": 1631.02, "text": "兄台如果此刻退兵,"}, {"start": 1631.02, "end": 1633.02, "text": "就请把天子带走。"}, {"start": 1633.02, "end": 1635.02, "text": "此后,"}, {"start": 1635.02, "end": 1637.02, "text": "朝廷就安在"}, {"start": 1637.02, "end": 1639.02, "text": "冀州了。"}, {"start": 1639.02, "end": 1641.02, "text": "协天子令诸侯的就是你元大将军。"}, {"start": 1641.02, "end": 1647.22, "text": "天子哥在我手里"}, {"start": 1647.22, "end": 1651.01, "text": "是个包袱。"}, {"start": 1651.01, "end": 1653.01, "text": "因为你比我强,"}, {"start": 1653.01, "end": 1655.01, "text": "你会讨伐我。"}, {"start": 1655.01, "end": 1657.01, "text": "可是如果天子在你手里,"}, {"start": 1657.01, "end": 1660.96, "text": "没人敢讨伐你。"}, {"start": 1660.96, "end": 1662.96, "text": "说白了,"}, {"start": 1662.96, "end": 1664.96, "text": "那跟兄台自个儿当皇帝"}, {"start": 1664.96, "end": 1666.96, "text": "有什么不同呢?"}, {"start": 1666.96, "end": 1668.96, "text": "而且还免除了篡你之名。"}, {"start": 1668.96, "end": 1670.96, "text": "兄台如果"}, {"start": 1670.96, "end": 1672.96, "text": "现在不愿意"}, {"start": 1672.96, "end": 1674.96, "text": "进大魏的话,"}, {"start": 1674.96, "end": 1676.96, "text": "今后无论任何时候,"}, {"start": 1676.96, "end": 1678.96, "text": "您都可以"}, {"start": 1678.96, "end": 1680.96, "text": "废敌自立。"}, {"start": 1680.96, "end": 1695.15, "text": "你看如何?"}, {"start": 1697.58, "end": 1699.58, "text": "徐游军士,"}, {"start": 1699.58, "end": 1701.58, "text": "傅帅跟曹操那儿说什么呢?"}, {"start": 1701.58, "end": 1703.58, "text": "他们有那么多话可说吗?"}, {"start": 1703.58, "end": 1705.58, "text": "我家主公"}, {"start": 1705.58, "end": 1707.58, "text": "与那曹操奸贼"}, {"start": 1707.58, "end": 1709.58, "text": "可是少时晚有。"}, {"start": 1709.58, "end": 1711.58, "text": "彼此之间"}, {"start": 1711.58, "end": 1713.58, "text": "有着说不清的恩恩怨怨。"}, {"start": 1713.58, "end": 1715.58, "text": "不过,"}, {"start": 1715.58, "end": 1717.58, "text": "那曹贼一向心腹狡诈,"}, {"start": 1717.58, "end": 1719.58, "text": "且诡计多端。"}, {"start": 1719.58, "end": 1721.58, "text": "他如此的拖延,"}, {"start": 1721.58, "end": 1723.58, "text": "肯定是别有用心。"}, {"start": 1723.58, "end": 1725.58, "text": "什么用心?"}, {"start": 1725.58, "end": 1727.58, "text": "这个,"}, {"start": 1727.58, "end": 1729.58, "text": "徐游一时,"}, {"start": 1729.58, "end": 1731.58, "text": "也说不清楚。"}, {"start": 1731.58, "end": 1746.22, "text": "你为了讲和,"}, {"start": 1746.22, "end": 1749.86, "text": "单单献出"}, {"start": 1749.86, "end": 1751.86, "text": "天子是不够的,"}, {"start": 1751.86, "end": 1753.86, "text": "你还必须割让许昌昌。"}, {"start": 1753.86, "end": 1759.57, "text": "首辅,"}, {"start": 1759.57, "end": 1761.57, "text": "割让了许昌,你让我何处容身呢?"}, {"start": 1761.57, "end": 1763.57, "text": "你不还有"}, {"start": 1763.57, "end": 1765.57, "text": "远州武俊之地吗?"}, {"start": 1765.57, "end": 1767.57, "text": "这足够让你独白一方。"}, {"start": 1767.57, "end": 1776.42, "text": "远州?"}, {"start": 1776.42, "end": 1778.42, "text": "地狭明寡,"}, {"start": 1778.42, "end": 1780.42, "text": "良想难知,"}, {"start": 1780.42, "end": 1782.42, "text": "自保且难,谈何成罢?"}, {"start": 1782.42, "end": 1787.01, "text": "太太,"}, {"start": 1787.01, "end": 1789.01, "text": "我已经答应割让许昌了。"}, {"start": 1789.01, "end": 1791.01, "text": "还愿意交出天子,"}, {"start": 1791.01, "end": 1793.01, "text": "你就不要违逼太深了。"}, {"start": 1793.01, "end": 1796.26, "text": "你每次"}, {"start": 1796.26, "end": 1798.26, "text": "率军征战,"}, {"start": 1798.26, "end": 1800.26, "text": "都在许昌用命。"}, {"start": 1800.26, "end": 1803.66, "text": "兄弟,"}, {"start": 1803.66, "end": 1805.66, "text": "如果你不想交出许昌城,"}, {"start": 1805.66, "end": 1807.66, "text": "我如何相信你的和谊?"}, {"start": 1807.66, "end": 1814.94, "text": "许昌一时,"}, {"start": 1814.94, "end": 1816.94, "text": "那些个文官武将"}, {"start": 1816.94, "end": 1818.94, "text": "就会认为我是个懦夫,"}, {"start": 1818.94, "end": 1820.94, "text": "庸主,"}, {"start": 1820.94, "end": 1822.94, "text": "他们就会施主夺位。"}, {"start": 1822.94, "end": 1824.94, "text": "那万一"}, {"start": 1824.94, "end": 1826.94, "text": "我要是死了,"}, {"start": 1826.94, "end": 1828.94, "text": "那谁来维护这个和谊呢?"}, {"start": 1828.94, "end": 1830.94, "text": "而且如果有一天"}, {"start": 1830.94, "end": 1832.94, "text": "他们兴兵讨伐兄台,"}, {"start": 1832.94, "end": 1834.94, "text": "那不是给兄台"}, {"start": 1834.94, "end": 1836.94, "text": "那不是给兄台添麻烦吗?"}, {"start": 1836.94, "end": 1883.07, "text": "袁叹将军,"}, {"start": 1883.07, "end": 1885.07, "text": "不必再等,"}, {"start": 1885.07, "end": 1887.07, "text": "即刻明金召回我家主公,"}, {"start": 1887.07, "end": 1889.07, "text": "准备开战!"}, {"start": 1889.07, "end": 1891.07, "text": "不,再等等。"}, {"start": 1891.07, "end": 1893.07, "text": "你们看,"}, {"start": 1893.07, "end": 1895.07, "text": "主公在跟曹操品茶的时候,"}, {"start": 1895.07, "end": 1897.07, "text": "一直是居高临下,"}, {"start": 1897.07, "end": 1899.07, "text": "从容不迫。"}, {"start": 1899.07, "end": 1901.07, "text": "而曹操却在向主公"}, {"start": 1901.07, "end": 1903.07, "text": "祈求着什么?"}, {"start": 1903.07, "end": 1905.07, "text": "曹贼祈求什么?"}, {"start": 1905.07, "end": 1907.07, "text": "要么是祈和,"}, {"start": 1907.07, "end": 1909.07, "text": "公子啊,"}, {"start": 1909.07, "end": 1911.07, "text": "你想主公他不急,"}, {"start": 1911.07, "end": 1913.07, "text": "那应该是胜券在握。"}, {"start": 1913.07, "end": 1915.07, "text": "再等等吧,"}, {"start": 1915.07, "end": 1917.07, "text": "或许我们能够不战而胜。"}, {"start": 1917.07, "end": 1919.07, "text": "郭徒大人,"}, {"start": 1919.07, "end": 1921.07, "text": "别忘了,"}, {"start": 1921.07, "end": 1923.07, "text": "那曹贼可是诡计多端啊。"}, {"start": 1923.07, "end": 1925.07, "text": "再这样拖延下去,"}, {"start": 1927.07, "end": 1929.07, "text": "我们三军将士"}, {"start": 1929.07, "end": 1931.07, "text": "也会躁动不安。"}, {"start": 1931.07, "end": 1943.79, "text": "他们是干什么的?"}, {"start": 1943.79, "end": 1945.79, "text": "他们这是干什么?"}, {"start": 1945.79, "end": 1947.79, "text": "兄弟,"}, {"start": 1947.79, "end": 1949.79, "text": "这些都是公女儿,"}, {"start": 1949.79, "end": 1951.79, "text": "他们拿的都是天子"}, {"start": 1951.79, "end": 1953.79, "text": "赐给将士们的美酒。"}, {"start": 1953.79, "end": 1955.79, "text": "兄弟啊,"}, {"start": 1955.79, "end": 1957.79, "text": "天子对你"}, {"start": 1957.79, "end": 1959.79, "text": "是一片厚爱啊。"}, {"start": 1959.79, "end": 1961.79, "text": "天子多么想化干戈为玉帛,"}, {"start": 1961.79, "end": 1963.79, "text": "让咱们俩都能双双开选啊。"}, {"start": 1963.79, "end": 1976.03, "text": "拜谢天安!"}, {"start": 1976.03, "end": 1984.08, "text": "兄弟,"}, {"start": 1984.08, "end": 1986.08, "text": "不管此番,"}, {"start": 1986.08, "end": 1988.08, "text": "我们是战是和,"}, {"start": 1988.08, "end": 2011.17, "text": "是敌是友。"}, {"start": 2011.17, "end": 2013.17, "text": "坐,坐。"}, {"start": 2013.17, "end": 2015.17, "text": "兄弟,"}, {"start": 2015.17, "end": 2051.47, "text": "你们是来打仗的,"}, {"start": 2051.47, "end": 2053.47, "text": "还是来调情的?"}, {"start": 2053.47, "end": 2055.47, "text": "所有将士听我命令,"}, {"start": 2055.47, "end": 2057.47, "text": "马上把这帮娘们给我赶走,"}, {"start": 2057.47, "end": 2059.47, "text": "快点赶走!"}, {"start": 2059.47, "end": 2061.47, "text": "走!"}, {"start": 2061.47, "end": 2063.47, "text": "走!"}, {"start": 2063.47, "end": 2065.47, "text": "快走!"}, {"start": 2065.47, "end": 2073.97, "text": "走!"}, {"start": 2073.97, "end": 2075.97, "text": "曹军在前面,"}, {"start": 2075.97, "end": 2077.97, "text": "不在后面。"}, {"start": 2077.97, "end": 2079.97, "text": "元熙将军,"}, {"start": 2079.97, "end": 2081.97, "text": "亲自率领一支铁骑,"}, {"start": 2081.97, "end": 2083.97, "text": "火速赶到我军后方去,"}, {"start": 2083.97, "end": 2085.97, "text": "严防那曹贼从后面偷袭。"}, {"start": 2085.97, "end": 2087.97, "text": "遵命!"}, {"start": 2098.9, "end": 2100.9, "text": "快让主公回到本镇!"}, {"start": 2100.9, "end": 2102.9, "text": "现交许长成后,"}, {"start": 2102.9, "end": 2104.9, "text": "我保证今后"}, {"start": 2104.9, "end": 2106.9, "text": "不再与你用兵。"}, {"start": 2106.9, "end": 2108.9, "text": "我还要助损天子,"}, {"start": 2108.9, "end": 2110.9, "text": "封你为大将军,"}, {"start": 2110.9, "end": 2112.9, "text": "领眼周目,"}, {"start": 2112.9, "end": 2114.9, "text": "保你荣华富贵,"}, {"start": 2114.9, "end": 2116.9, "text": "享有佛金。"}, {"start": 2116.9, "end": 2127.22, "text": "多谢兄太宽容啊。"}, {"start": 2127.22, "end": 2131.97, "text": "元盛,"}, {"start": 2131.97, "end": 2133.97, "text": "我如果是你,"}, {"start": 2133.97, "end": 2135.97, "text": "就决不同"}, {"start": 2135.97, "end": 2137.97, "text": "曹孟德议和,"}, {"start": 2137.97, "end": 2139.97, "text": "只会给他住一座青石大坟,"}, {"start": 2139.97, "end": 2141.97, "text": "因为,"}, {"start": 2141.97, "end": 2143.97, "text": "只要曹孟德"}, {"start": 2143.97, "end": 2145.97, "text": "一息尚存,"}, {"start": 2145.97, "end": 2147.97, "text": "他就战无不胜!"}, {"start": 2177.2, "end": 2179.2, "text": "傅帅,请赶紧回营!"}, {"start": 2179.2, "end": 2190.7, "text": "傅帅,曹冲数万铁骑,"}, {"start": 2190.7, "end": 2192.7, "text": "正在抄袭我军后方!"}, {"start": 2192.7, "end": 2197.71, "text": "你这天下第一巨金!"}, {"start": 2197.71, "end": 2199.71, "text": "我非将你碎尸万段不可!"}, {"start": 2199.71, "end": 2201.71, "text": "快撤,傅帅!"}]