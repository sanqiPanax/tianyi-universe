[{"start": 4.59, "end": 6.59, "text": "来人呐,在。"}, {"start": 6.59, "end": 8.59, "text": "去城里看看,是否还有曹军。"}, {"start": 8.59, "end": 29.57, "text": "诺。"}, {"start": 29.57, "end": 31.57, "text": "禀报大都督,城内空无一人,一个敌军都没有了。"}, {"start": 31.57, "end": 39.62, "text": "进城。"}, {"start": 39.62, "end": 96.94, "text": "太紧了,紧得不像是真的。"}, {"start": 96.94, "end": 104.74, "text": "我们已经中了敌方的埋伏。"}, {"start": 104.74, "end": 106.74, "text": "你们别慌,"}, {"start": 106.74, "end": 108.74, "text": "慢慢退出去。"}, {"start": 108.74, "end": 113.78, "text": "慢慢退,千万不能乱。"}, {"start": 113.78, "end": 408.8, "text": "极难愈合,"}, {"start": 408.8, "end": 410.8, "text": "百日之内,大都督"}, {"start": 410.8, "end": 412.8, "text": "定要安心静养,不可动怒。"}, {"start": 412.8, "end": 414.8, "text": "若是怒气冲击,"}, {"start": 414.8, "end": 416.8, "text": "伤口迸发,"}, {"start": 416.8, "end": 418.8, "text": "后果不堪设想啊。"}, {"start": 420.8, "end": 433.2, "text": "进城我军,"}, {"start": 433.2, "end": 442.24, "text": "不要瞒着我。你是多少?"}, {"start": 442.24, "end": 446.19, "text": "有五千人吧。"}, {"start": 449.84, "end": 453.66, "text": "大都督,"}, {"start": 453.66, "end": 455.66, "text": "你不可动怒啊,"}, {"start": 455.66, "end": 457.66, "text": "伤口又出血了。"}, {"start": 457.66, "end": 466.22, "text": "咱们暂且先退兵,"}, {"start": 466.22, "end": 468.22, "text": "回复吴侯,"}, {"start": 468.22, "end": 489.55, "text": "再做理会。"}, {"start": 489.55, "end": 493.98, "text": "对江东符合,向主公交代。"}, {"start": 493.98, "end": 495.98, "text": "再说了,"}, {"start": 495.98, "end": 502.88, "text": "诸葛亮有约在先,"}, {"start": 502.88, "end": 509.3, "text": "举不下南郡的时候。"}, {"start": 509.3, "end": 521.22, "text": "毕竟是身负重伤啊,"}, {"start": 521.22, "end": 523.22, "text": "就怕。"}, {"start": 523.22, "end": 534.05, "text": "这曹军在外头骂阵嘛,"}, {"start": 534.05, "end": 558.58, "text": "国捉我周华。"}, {"start": 558.58, "end": 560.58, "text": "东东,你不能再动怒了。"}, {"start": 560.58, "end": 562.58, "text": "伤口又出血了。"}, {"start": 562.58, "end": 586.21, "text": "主公,军师,南郡消息到了。"}, {"start": 586.21, "end": 588.21, "text": "曹人设计诈败,"}, {"start": 588.21, "end": 590.21, "text": "将吴军诱入南郡城中,"}, {"start": 590.21, "end": 592.21, "text": "在甕城将周瑜射伤。"}, {"start": 592.21, "end": 594.21, "text": "吴军大败,紧闭营门不出。"}, {"start": 594.21, "end": 596.21, "text": "曹军正日已在吴军大战门前"}, {"start": 596.21, "end": 600.54, "text": "逃敌骂阵。"}, {"start": 600.54, "end": 602.54, "text": "这曹人果然是智勇双全的上将啊。"}, {"start": 602.54, "end": 604.54, "text": "连周瑜都打败了。"}, {"start": 604.54, "end": 608.18, "text": "周瑜伤势如何?"}, {"start": 608.18, "end": 610.18, "text": "探子传回消息说,"}, {"start": 610.18, "end": 612.18, "text": "伤势急重,已经卧床不起了。"}, {"start": 612.18, "end": 616.38, "text": "如此看来,"}, {"start": 616.38, "end": 618.38, "text": "东吴这次取南郡"}, {"start": 618.38, "end": 620.38, "text": "是无功而返喽。"}, {"start": 620.38, "end": 622.38, "text": "孔明,"}, {"start": 622.38, "end": 624.38, "text": "那我们现在该进郡吗?"}, {"start": 624.38, "end": 629.97, "text": "主公啊,"}, {"start": 629.97, "end": 631.97, "text": "我看"}, {"start": 631.97, "end": 633.97, "text": "我们还是再等几日为好。"}, {"start": 633.97, "end": 635.97, "text": "我太明白周瑜了。"}, {"start": 635.97, "end": 637.97, "text": "他只要还剩一口气,"}, {"start": 637.97, "end": 639.97, "text": "就断然不会服输的。"}, {"start": 639.97, "end": 680.75, "text": "是军中正在操练士卒。"}, {"start": 680.75, "end": 682.75, "text": "骗我做甚?"}, {"start": 682.75, "end": 687.38, "text": "在外那些曹兵,"}, {"start": 687.38, "end": 689.38, "text": "早就叫骂半天了,"}, {"start": 689.38, "end": 692.75, "text": "听得清清楚楚。"}, {"start": 692.75, "end": 694.75, "text": "你们这些战家,"}, {"start": 694.75, "end": 698.77, "text": "就这么任敌军销政吗?"}, {"start": 698.77, "end": 700.77, "text": "孔静,"}, {"start": 700.77, "end": 702.77, "text": "我这事出于无奈啊。"}, {"start": 702.77, "end": 704.77, "text": "曹人刚错我兵风,"}, {"start": 704.77, "end": 706.77, "text": "此时,"}, {"start": 706.77, "end": 708.77, "text": "气焰正盛。"}, {"start": 708.77, "end": 710.77, "text": "我们准备暂时避起风浪。"}, {"start": 710.77, "end": 712.77, "text": "等你的伤势好些再说。"}, {"start": 712.77, "end": 718.96, "text": "都督!"}, {"start": 718.96, "end": 720.96, "text": "都督!"}, {"start": 720.96, "end": 730.86, "text": "都督!"}, {"start": 730.86, "end": 734.59, "text": "国家大使,"}, {"start": 734.59, "end": 736.59, "text": "拿我战甲来!"}, {"start": 736.59, "end": 738.59, "text": "都督,"}, {"start": 738.59, "end": 740.59, "text": "你的伤势未好,"}, {"start": 740.59, "end": 742.59, "text": "千万不可接战哪!"}, {"start": 742.59, "end": 744.59, "text": "大丈夫即使军录,"}, {"start": 744.59, "end": 749.95, "text": "就该死于战场,"}, {"start": 749.95, "end": 751.95, "text": "以马革骨尸环,"}, {"start": 751.95, "end": 753.95, "text": "都督,"}, {"start": 753.95, "end": 759.28, "text": "不能去,都督,"}, {"start": 759.28, "end": 761.28, "text": "杀出迎门。"}, {"start": 761.28, "end": 771.73, "text": "都督!"}, {"start": 771.73, "end": 773.73, "text": "你想娶我的南郡吗?"}, {"start": 773.73, "end": 775.73, "text": "为什么像乌龟一样,"}, {"start": 775.73, "end": 792.48, "text": "怕着不动呢?"}, {"start": 792.48, "end": 796.24, "text": "谁敢拿下曹人?"}, {"start": 796.24, "end": 830.91, "text": "末将去拿她,战将羞狂,"}, {"start": 830.91, "end": 832.91, "text": "你呢?"}, {"start": 832.91, "end": 834.91, "text": "我给你找了个好菜式,"}, {"start": 834.91, "end": 838.32, "text": "你只配给丞相羊马,"}, {"start": 838.32, "end": 849.63, "text": "给我曹人几酒。"}, {"start": 849.63, "end": 902.03, "text": "我 failure。"}, {"start": 902.03, "end": 903.11, "text": "周瑜气死了"}, {"start": 908.2, "end": 909.8, "text": "我就骂了几句破谜话呀"}, {"start": 916.36, "end": 918.0, "text": "辛雄太狭隘"}, {"start": 918.84, "end": 919.96, "text": "中了毒箭"}, {"start": 920.52, "end": 922.08, "text": "还死撑着应战"}, {"start": 926.97, "end": 928.09, "text": "周瑜尸体"}, {"start": 928.17, "end": 929.13, "text": "赏万斤"}, {"start": 937.57, "end": 954.75, "text": "清除这屌壶"}, {"start": 954.91, "end": 955.43, "text": "军师"}, {"start": 955.51, "end": 956.75, "text": "曹人急攻东吴大战"}, {"start": 957.15, "end": 958.19, "text": "周瑜带伤出战"}, {"start": 958.51, "end": 959.59, "text": "箭伤并肋而亡"}, {"start": 960.03, "end": 961.39, "text": "东吴大军全军举效"}, {"start": 961.47, "end": 962.23, "text": "空胜一片"}, {"start": 971.85, "end": 974.24, "text": "周瑜死了"}, {"start": 974.44, "end": 975.84, "text": "真让人不敢相信"}, {"start": 976.16, "end": 977.72, "text": "如此天纵之才"}, {"start": 977.76, "end": 979.0, "text": "竟然死了"}, {"start": 980.32, "end": 980.96, "text": "主公"}, {"start": 981.68, "end": 982.56, "text": "周瑜"}, {"start": 983.0, "end": 984.08, "text": "定是诈死"}, {"start": 984.6, "end": 985.56, "text": "何以见到"}, {"start": 986.92, "end": 988.4, "text": "周瑜如果死了"}, {"start": 989.12, "end": 990.56, "text": "程浦定会遣人来"}, {"start": 990.56, "end": 992.4, "text": "求我们与他合兵一处"}, {"start": 992.8, "end": 994.92, "text": "防止曹军趁势追击"}, {"start": 995.0, "end": 996.48, "text": "避免全军覆没"}, {"start": 996.8, "end": 997.88, "text": "可是到现在"}, {"start": 998.04, "end": 999.68, "text": "既不见有人来报丧"}, {"start": 999.76, "end": 1001.24, "text": "也不见有人来求救"}, {"start": 1001.6, "end": 1002.28, "text": "足见"}, {"start": 1002.48, "end": 1004.28, "text": "这是周瑜演的一出戏"}, {"start": 1006.0, "end": 1007.4, "text": "他在南郡城"}, {"start": 1008.04, "end": 1009.6, "text": "受了曹人的埋伏"}, {"start": 1009.76, "end": 1011.16, "text": "吃了一个大苦头"}, {"start": 1011.52, "end": 1013.32, "text": "现在要用曹人"}, {"start": 1013.32, "end": 1014.64, "text": "去劫他的大营"}, {"start": 1014.92, "end": 1016.44, "text": "还他一个福机"}, {"start": 1020.14, "end": 1021.02, "text": "那"}, {"start": 1022.06, "end": 1023.1, "text": "我们该怎么办"}, {"start": 1026.73, "end": 1027.33, "text": "主公"}, {"start": 1028.21, "end": 1029.21, "text": "派一支轻计"}, {"start": 1029.33, "end": 1031.01, "text": "坚诚赶往南郡城以东"}, {"start": 1031.41, "end": 1032.81, "text": "待曹人出城之后"}, {"start": 1033.45, "end": 1035.01, "text": "趁需夺下城池"}, {"start": 1035.13, "end": 1041.69, "text": "我们这么做"}, {"start": 1042.37, "end": 1043.37, "text": "不合适吧"}, {"start": 1044.65, "end": 1046.37, "text": "人家血仗了这么多天"}, {"start": 1046.73, "end": 1048.21, "text": "折了这么多人马"}, {"start": 1049.21, "end": 1051.05, "text": "我们这么做太不仁义了"}, {"start": 1052.9, "end": 1055.06, "text": "跟周瑜能讲仁义吗"}, {"start": 1055.34, "end": 1056.42, "text": "主公难道忘了"}, {"start": 1056.54, "end": 1058.18, "text": "他上次在这儿说什么来着"}, {"start": 1058.78, "end": 1059.82, "text": "乱世之中"}, {"start": 1060.22, "end": 1062.62, "text": "最珍贵的就是土地城池"}, {"start": 1063.02, "end": 1085.79, "text": "我们势力越大"}, {"start": 1086.23, "end": 1087.39, "text": "城池越多"}, {"start": 1087.63, "end": 1089.31, "text": "周瑜才会越尊重你"}, {"start": 1089.79, "end": 1090.55, "text": "反之"}, {"start": 1090.83, "end": 1091.95, "text": "如果我们始终处于"}, {"start": 1091.95, "end": 1093.19, "text": "孤寡弱小的话"}, {"start": 1093.47, "end": 1095.23, "text": "东吴都不会看上我们一眼"}, {"start": 1095.43, "end": 1097.93, "text": "早晚有一天"}, {"start": 1098.65, "end": 1099.89, "text": "会抛弃我们"}, {"start": 1100.65, "end": 1102.09, "text": "甚至消灭我们"}, {"start": 1122.22, "end": 1123.06, "text": "你头疼"}, {"start": 1127.26, "end": 1128.5, "text": "这几天风寒"}, {"start": 1129.34, "end": 1130.5, "text": "怕是着凉了吧"}, {"start": 1133.23, "end": 1133.83, "text": "来人"}, {"start": 1134.35, "end": 1134.91, "text": "阿布"}, {"start": 1138.27, "end": 1139.55, "text": "我到后章歇息"}, {"start": 1140.39, "end": 1140.99, "text": "军师"}, {"start": 1142.11, "end": 1143.03, "text": "军务师"}, {"start": 1144.31, "end": 1170.38, "text": "一概由你做主吧"}, {"start": 1170.5, "end": 1171.54, "text": "传子龙将军"}, {"start": 1171.66, "end": 1172.14, "text": "诺"}, {"start": 1188.12, "end": 1191.52, "text": "敌兵果然是兵无斗志"}, {"start": 1192.08, "end": 1193.88, "text": "防备也那么细松"}, {"start": 1194.28, "end": 1195.72, "text": "弟子们 给我上"}, {"start": 1195.8, "end": 1224.55, "text": "上"}, {"start": 1224.55, "end": 1246.06, "text": "我们中计了"}, {"start": 1246.06, "end": 1247.46, "text": "曹人是清朝而出"}, {"start": 1248.18, "end": 1248.82, "text": "我想"}, {"start": 1249.14, "end": 1250.34, "text": "城内应该没有几个人"}, {"start": 1250.54, "end": 1253.7, "text": "应是如此"}, {"start": 1254.5, "end": 1255.06, "text": "大都督"}, {"start": 1255.26, "end": 1255.74, "text": "你看"}, {"start": 1255.94, "end": 1257.9, "text": "曹人好像引军攻打西寨去了"}, {"start": 1258.66, "end": 1259.54, "text": "他想突出去"}, {"start": 1259.54, "end": 1260.66, "text": "就让他突出去吧"}, {"start": 1262.67, "end": 1264.87, "text": "这样的酒囊饭袋留给曹操"}, {"start": 1265.75, "end": 1267.71, "text": "往后曹操有的是败仗的事"}, {"start": 1268.39, "end": 1270.43, "text": "眼下最要紧的是南郡跟荆州"}, {"start": 1271.75, "end": 1272.59, "text": "传我将令"}, {"start": 1273.35, "end": 1274.79, "text": "各营立即整顿兵马"}, {"start": 1275.19, "end": 1276.39, "text": "北上攻取南郡"}, {"start": 1300.31, "end": 1301.35, "text": "你还健在呀"}, {"start": 1301.75, "end": 1302.87, "text": "末将恭喜了"}, {"start": 1303.19, "end": 1303.99, "text": "赵云"}, {"start": 1305.23, "end": 1306.67, "text": "我家军使得到消息"}, {"start": 1306.87, "end": 1308.31, "text": "说是贵军中了埋伏"}, {"start": 1308.71, "end": 1309.59, "text": "损失惨重"}, {"start": 1309.95, "end": 1311.15, "text": "连都督都阵亡了"}, {"start": 1311.91, "end": 1313.07, "text": "为防曹贼进军"}, {"start": 1313.43, "end": 1314.87, "text": "派在下取了南郡"}, {"start": 1315.15, "end": 1316.11, "text": "以拒曹贼啊"}, {"start": 1317.43, "end": 1318.71, "text": "我血沾月雨"}, {"start": 1320.03, "end": 1321.43, "text": "儿等却背信弃义"}, {"start": 1321.99, "end": 1323.99, "text": "暗示手脚夺我城池"}, {"start": 1324.79, "end": 1325.67, "text": "都督言重了"}, {"start": 1326.63, "end": 1327.99, "text": "你可是有言在先的"}, {"start": 1328.79, "end": 1330.15, "text": "若是你取不下南郡"}, {"start": 1330.75, "end": 1332.07, "text": "便由我家主公来取"}, {"start": 1332.35, "end": 1342.14, "text": "大都督"}, {"start": 1342.42, "end": 1342.98, "text": "大都督"}, {"start": 1343.46, "end": 1344.14, "text": "大都督"}, {"start": 1344.14, "end": 1344.7, "text": "大都督"}, {"start": 1344.7, "end": 1345.26, "text": "大都督"}, {"start": 1345.26, "end": 1346.06, "text": "大都督"}, {"start": 1346.26, "end": 1346.86, "text": "大都督"}, {"start": 1347.18, "end": 1352.34, "text": "大都督"}, {"start": 1352.34, "end": 1352.9, "text": "大都督"}, {"start": 1355.18, "end": 1355.78, "text": "下令吧"}, {"start": 1356.38, "end": 1357.86, "text": "我这就攻杀南郡"}, {"start": 1424.06, "end": 1424.7, "text": "军情嘛"}, {"start": 1424.94, "end": 1425.58, "text": "不着急"}, {"start": 1425.82, "end": 1437.89, "text": "当我军与曹人立战之时"}, {"start": 1438.29, "end": 1439.41, "text": "祝贵亮派赵云"}, {"start": 1439.49, "end": 1440.29, "text": "亲率兵马"}, {"start": 1440.69, "end": 1441.57, "text": "攻取了南郡"}, {"start": 1442.05, "end": 1443.61, "text": "擒获了守将陈娇"}, {"start": 1444.25, "end": 1445.89, "text": "夺得了曹人的兵符"}, {"start": 1446.81, "end": 1447.69, "text": "他们兴业"}, {"start": 1448.13, "end": 1450.09, "text": "调取了附近的守军"}, {"start": 1450.45, "end": 1451.73, "text": "前来救南郡"}, {"start": 1453.09, "end": 1453.97, "text": "却叫张飞"}, {"start": 1454.29, "end": 1455.09, "text": "夺取了一城"}, {"start": 1455.73, "end": 1456.13, "text": "关羽"}, {"start": 1456.73, "end": 1457.73, "text": "夺取了另一城"}, {"start": 1459.53, "end": 1459.93, "text": "因此"}, {"start": 1460.69, "end": 1462.85, "text": "荆州的南郡等三座城池"}, {"start": 1463.73, "end": 1465.05, "text": "皆在刘备之手"}, {"start": 1467.5, "end": 1467.98, "text": "大都督"}, {"start": 1468.18, "end": 1468.66, "text": "大都督"}, {"start": 1469.86, "end": 1470.46, "text": "大都督"}, {"start": 1470.66, "end": 1471.14, "text": "大都督"}, {"start": 1471.14, "end": 1471.62, "text": "大都督"}, {"start": 1471.62, "end": 1472.1, "text": "大都督"}, {"start": 1472.1, "end": 1472.58, "text": "大都督"}, {"start": 1473.06, "end": 1474.22, "text": "你千万别动怒啊"}, {"start": 1474.58, "end": 1517.41, "text": "我要将你碎尸万段"}, {"start": 1519.53, "end": 1520.37, "text": "不要动怒啊"}, {"start": 1520.77, "end": 1528.68, "text": "派尚书主公"}, {"start": 1528.76, "end": 1531.97, "text": "增调三万兵马来驻战"}, {"start": 1536.26, "end": 1537.54, "text": "二十日之内"}, {"start": 1538.78, "end": 1541.1, "text": "我誓将景湘夺回东吴"}, {"start": 1541.46, "end": 1563.66, "text": "快去办"}, {"start": 1563.98, "end": 1566.79, "text": "诺 将提办"}, {"start": 1567.07, "end": 1655.04, "text": "刘表去世后"}, {"start": 1656.16, "end": 1658.2, "text": "这块地盘一直虚稀一带"}, {"start": 1659.32, "end": 1659.88, "text": "今日"}, {"start": 1660.68, "end": 1662.44, "text": "总算迎来了真正的主公"}, {"start": 1667.5, "end": 1668.9, "text": "我等漂泊多年"}, {"start": 1669.18, "end": 1670.42, "text": "一直寄人李下"}, {"start": 1671.02, "end": 1671.54, "text": "今儿"}, {"start": 1671.9, "end": 1673.42, "text": "总算有自个儿的地盘了"}, {"start": 1674.46, "end": 1674.86, "text": "哥呀"}, {"start": 1675.3, "end": 1675.62, "text": "来"}, {"start": 1676.14, "end": 1676.54, "text": "坐下"}, {"start": 1677.06, "end": 1678.1, "text": "让咱瞧瞧"}, {"start": 1684.62, "end": 1685.26, "text": "孔明啊"}, {"start": 1687.74, "end": 1689.1, "text": "咱们趁周瑜不备"}, {"start": 1689.86, "end": 1690.7, "text": "得了荆州"}, {"start": 1692.77, "end": 1694.17, "text": "事情虽是无奈"}, {"start": 1695.93, "end": 1697.41, "text": "但多少有些力亏"}, {"start": 1698.25, "end": 1699.21, "text": "主公担心什么"}, {"start": 1701.98, "end": 1704.1, "text": "江东折了那么多兵马"}, {"start": 1704.98, "end": 1706.58, "text": "周瑜又受了重伤"}, {"start": 1708.3, "end": 1709.26, "text": "可城池"}, {"start": 1710.06, "end": 1711.18, "text": "尽落于我手"}, {"start": 1712.3, "end": 1714.58, "text": "我不担心曹操会行兵报复"}, {"start": 1716.18, "end": 1717.06, "text": "我只担忧"}, {"start": 1718.22, "end": 1719.82, "text": "周瑜会咽不下这口气"}, {"start": 1722.62, "end": 1723.58, "text": "你怕他做事"}, {"start": 1724.42, "end": 1725.46, "text": "有俺张飞在呢"}, {"start": 1726.34, "end": 1728.78, "text": "如果那周郎小儿敢来寻仇"}, {"start": 1729.58, "end": 1730.06, "text": "你瞧我"}, {"start": 1730.18, "end": 1731.38, "text": "戳他几个脱名窟窿"}, {"start": 1731.9, "end": 1732.38, "text": "三弟"}, {"start": 1733.3, "end": 1734.82, "text": "李执则能气壮"}, {"start": 1735.54, "end": 1736.66, "text": "李在人家那儿"}, {"start": 1738.18, "end": 1738.78, "text": "再说"}, {"start": 1739.86, "end": 1741.22, "text": "东吴雍兵十万"}, {"start": 1741.94, "end": 1743.22, "text": "我们只有两万人马"}, {"start": 1743.58, "end": 1744.38, "text": "真的要打起来"}, {"start": 1744.38, "end": 1745.62, "text": "哪里是人家的对手"}, {"start": 1748.7, "end": 1749.66, "text": "更重要的是"}, {"start": 1750.78, "end": 1751.78, "text": "玉城大业"}, {"start": 1752.74, "end": 1754.62, "text": "不能单靠兵马刀强"}, {"start": 1755.66, "end": 1756.26, "text": "仁义"}, {"start": 1756.98, "end": 1758.7, "text": "才能征服天下人心"}, {"start": 1760.06, "end": 1761.34, "text": "主公怕失了仁义"}, {"start": 1762.86, "end": 1763.86, "text": "我倒有个方法"}, {"start": 1764.34, "end": 1765.5, "text": "可让主公无忧"}, {"start": 1766.18, "end": 1766.98, "text": "先生请讲"}, {"start": 1768.38, "end": 1769.66, "text": "周瑜并不恨主公"}, {"start": 1770.26, "end": 1771.58, "text": "恨的乃是孔孺吧"}, {"start": 1772.58, "end": 1774.58, "text": "只要主公把我交给周瑜"}, {"start": 1774.9, "end": 1776.22, "text": "他定会转怒为喜"}, {"start": 1776.58, "end": 1777.78, "text": "把我点了天灯"}, {"start": 1778.22, "end": 1779.22, "text": "这叫什么话"}, {"start": 1779.86, "end": 1781.14, "text": "我就算不要京乡"}, {"start": 1781.22, "end": 1782.58, "text": "也万不能失去先生"}, {"start": 1788.24, "end": 1789.04, "text": "主公请放心"}, {"start": 1789.96, "end": 1790.8, "text": "两年之内"}, {"start": 1791.52, "end": 1793.48, "text": "不会有人赶来跟主公争京乡"}, {"start": 1794.04, "end": 1795.0, "text": "而两年之后呢"}, {"start": 1795.52, "end": 1797.12, "text": "我军将一发强大"}, {"start": 1797.36, "end": 1798.16, "text": "兵士更少"}, {"start": 1798.64, "end": 1801.44, "text": "那时他们想争也争不动"}, {"start": 1805.55, "end": 1806.31, "text": "周瑜的兵马"}, {"start": 1806.31, "end": 1808.07, "text": "现在扔住砸在南郡城下"}, {"start": 1808.79, "end": 1810.71, "text": "巨弩长枪以门而立"}, {"start": 1812.47, "end": 1813.43, "text": "过不了几日"}, {"start": 1814.47, "end": 1815.87, "text": "他便会引兵还武"}, {"start": 1817.43, "end": 1818.35, "text": "你何出此言"}, {"start": 1821.87, "end": 1822.63, "text": "我这么说吧"}, {"start": 1823.91, "end": 1824.95, "text": "一家有三兄弟"}, {"start": 1825.47, "end": 1827.47, "text": "最好做人的往往是老三"}, {"start": 1827.95, "end": 1829.71, "text": "最难做的往往是老二"}, {"start": 1830.91, "end": 1832.67, "text": "曹操虽然经历了赤壁之败"}, {"start": 1833.51, "end": 1834.95, "text": "但他仍是天下老大"}, {"start": 1835.83, "end": 1836.63, "text": "老二是谁"}, {"start": 1837.55, "end": 1838.07, "text": "东吴"}, {"start": 1839.55, "end": 1841.23, "text": "主公勉强可称为老三"}, {"start": 1842.39, "end": 1843.63, "text": "曹操要一统天下"}, {"start": 1843.91, "end": 1844.91, "text": "便要灭了东吴"}, {"start": 1845.91, "end": 1847.95, "text": "因此从东吴的角度看"}, {"start": 1848.35, "end": 1850.11, "text": "他最厉害的敌人不是我"}, {"start": 1850.63, "end": 1851.51, "text": "仍是曹操"}, {"start": 1853.23, "end": 1856.07, "text": "眼下周瑜遭挫受辱"}, {"start": 1856.39, "end": 1857.07, "text": "恼羞成"}, {"start": 1857.79, "end": 1858.95, "text": "却是恨透露了我"}, {"start": 1859.87, "end": 1860.71, "text": "尤其是我"}, {"start": 1862.31, "end": 1864.47, "text": "而孙权和鲁肃却是明白"}, {"start": 1865.67, "end": 1868.19, "text": "他们两眼一直盯着天下大局"}, {"start": 1868.99, "end": 1871.55, "text": "我料定他们定会想方设法"}, {"start": 1871.75, "end": 1873.79, "text": "阻止周瑜和我们交兵"}, {"start": 1875.47, "end": 1875.99, "text": "再者"}, {"start": 1876.63, "end": 1877.95, "text": "我们立足荆州之后"}, {"start": 1878.23, "end": 1879.51, "text": "便成了曹操的大患"}, {"start": 1879.99, "end": 1882.91, "text": "也因此分担了东吴的三分北患"}, {"start": 1883.87, "end": 1884.35, "text": "所以"}, {"start": 1885.43, "end": 1886.43, "text": "荆州之势"}, {"start": 1887.11, "end": 1888.35, "text": "对东吴来说是气"}, {"start": 1889.35, "end": 1890.27, "text": "消除北患"}, {"start": 1890.63, "end": 1891.79, "text": "对东吴来说是喜"}, {"start": 1892.43, "end": 1893.47, "text": "这一气一喜"}, {"start": 1894.11, "end": 1895.59, "text": "他们也就释怀了"}, {"start": 1899.66, "end": 1900.3, "text": "那还有呢"}, {"start": 1901.74, "end": 1903.42, "text": "曹操先是败于赤壁"}, {"start": 1904.34, "end": 1905.34, "text": "后又败于南郡"}, {"start": 1906.34, "end": 1907.58, "text": "他能不南下复仇吗"}, {"start": 1907.82, "end": 1908.7, "text": "想倒是想"}, {"start": 1909.74, "end": 1911.1, "text": "主公也可无虑"}, {"start": 1911.82, "end": 1912.22, "text": "为何"}, {"start": 1912.62, "end": 1913.62, "text": "我一直在琢磨"}, {"start": 1914.5, "end": 1917.06, "text": "赤壁之后曹操引兵北患"}, {"start": 1917.9, "end": 1919.82, "text": "在合肥一带重兵不防"}, {"start": 1920.38, "end": 1922.62, "text": "而在荆州只留下两万兵马"}, {"start": 1923.18, "end": 1923.86, "text": "这是为何"}, {"start": 1926.72, "end": 1927.48, "text": "这么说"}, {"start": 1929.4, "end": 1931.2, "text": "曹操他不是真心守荆州"}, {"start": 1931.56, "end": 1932.72, "text": "我苦思许久"}, {"start": 1933.32, "end": 1934.48, "text": "终于想明白了"}, {"start": 1935.6, "end": 1937.04, "text": "曹操心里有如意算盘"}, {"start": 1937.68, "end": 1938.24, "text": "他明白"}, {"start": 1938.72, "end": 1940.52, "text": "在孙柳两家兵封面前"}, {"start": 1940.8, "end": 1942.92, "text": "荆州早晚是要失守的"}, {"start": 1943.76, "end": 1944.76, "text": "既然非丢不可"}, {"start": 1945.08, "end": 1946.36, "text": "那就要丢得有价值"}, {"start": 1946.84, "end": 1947.96, "text": "如何才能有价值"}, {"start": 1948.32, "end": 1950.08, "text": "就是以荆州为耳"}, {"start": 1950.64, "end": 1952.0, "text": "让我们和东吴交兵"}, {"start": 1953.2, "end": 1954.64, "text": "他坐视孙柳交兵"}, {"start": 1954.96, "end": 1956.24, "text": "两败俱伤之后"}, {"start": 1956.36, "end": 1957.32, "text": "再引兵南下"}, {"start": 1958.12, "end": 1958.56, "text": "所以"}, {"start": 1959.04, "end": 1960.64, "text": "只要我们和东吴不交兵"}, {"start": 1961.16, "end": 1962.44, "text": "维持联盟大局"}, {"start": 1963.0, "end": 1964.96, "text": "曹操就不敢妄动"}, {"start": 1970.46, "end": 1971.18, "text": "那这么说"}, {"start": 1973.83, "end": 1974.47, "text": "此作"}, {"start": 1975.79, "end": 1976.35, "text": "我做得"}, {"start": 1978.31, "end": 1979.23, "text": "做得做得"}, {"start": 1979.95, "end": 1980.51, "text": "主公"}, {"start": 1980.79, "end": 1981.79, "text": "但做无妨"}, {"start": 1982.11, "end": 2007.3, "text": "龙马半生"}, {"start": 2008.38, "end": 2009.5, "text": "颠沛流离"}, {"start": 2011.02, "end": 2011.78, "text": "今日"}, {"start": 2014.66, "end": 2016.94, "text": "总算有了这么一块立足之地了"}, {"start": 2018.26, "end": 2019.74, "text": "恭喜主公"}, {"start": 2020.74, "end": 2021.62, "text": "恭喜主公"}, {"start": 2032.73, "end": 2033.69, "text": "你还记得"}, {"start": 2034.37, "end": 2035.61, "text": "三顾茅庐时"}, {"start": 2036.61, "end": 2037.93, "text": "你对我说的什么话"}, {"start": 2040.27, "end": 2040.91, "text": "在下"}, {"start": 2042.23, "end": 2042.87, "text": "不记得了"}, {"start": 2045.28, "end": 2045.88, "text": "你说"}, {"start": 2046.6, "end": 2047.56, "text": "玉城大业"}, {"start": 2048.44, "end": 2048.96, "text": "第一"}, {"start": 2050.0, "end": 2051.36, "text": "须取荆州为本"}, {"start": 2052.36, "end": 2052.88, "text": "第二"}, {"start": 2054.16, "end": 2056.4, "text": "须取西川城鼎足之势"}, {"start": 2057.68, "end": 2058.24, "text": "第三"}, {"start": 2059.2, "end": 2060.56, "text": "便是举兵备法"}, {"start": 2060.96, "end": 2069.79, "text": "今天"}, {"start": 2071.15, "end": 2073.03, "text": "是你帮我完成了这第一步"}, {"start": 2075.32, "end": 2076.24, "text": "刘备心中"}, {"start": 2077.04, "end": 2078.32, "text": "万分感激"}, {"start": 2084.34, "end": 2085.78, "text": "主公天赐雄才"}, {"start": 2086.14, "end": 2087.1, "text": "大业必成"}, {"start": 2093.58, "end": 2095.18, "text": "曹人丧失师弟"}, {"start": 2095.18, "end": 2096.18, "text": "惭愧不已"}, {"start": 2096.3, "end": 2098.34, "text": "尚书请丞相降罪"}, {"start": 2098.66, "end": 2099.42, "text": "拿来我看"}, {"start": 2107.34, "end": 2108.06, "text": "主公"}, {"start": 2109.46, "end": 2111.38, "text": "和我带着八十三万大军"}, {"start": 2111.38, "end": 2113.22, "text": "尚且兵败赤壁"}, {"start": 2115.02, "end": 2115.9, "text": "曹人"}, {"start": 2117.14, "end": 2118.58, "text": "带着那么点人"}, {"start": 2119.26, "end": 2121.26, "text": "居然能跟孙柳两家"}, {"start": 2121.62, "end": 2122.86, "text": "周旋这么久"}, {"start": 2123.06, "end": 2125.46, "text": "还差一点杀了周瑜"}, {"start": 2127.26, "end": 2128.22, "text": "不容易啊"}, {"start": 2130.09, "end": 2131.45, "text": "曹人是个将才"}, {"start": 2134.86, "end": 2137.02, "text": "不忘我对他的一番教诲啊"}, {"start": 2137.82, "end": 2138.7, "text": "打败仗"}, {"start": 2139.26, "end": 2140.58, "text": "打得都这么漂亮"}, {"start": 2142.38, "end": 2144.66, "text": "他把周瑜的兵马打了个金光"}, {"start": 2144.98, "end": 2146.5, "text": "却把三座城池"}, {"start": 2147.02, "end": 2148.14, "text": "丢给了刘备"}, {"start": 2151.86, "end": 2153.5, "text": "我们就等着看好戏吧"}, {"start": 2154.58, "end": 2156.22, "text": "我等不知丞相的意思"}, {"start": 2158.2, "end": 2159.8, "text": "文弱知我心思不"}, {"start": 2160.68, "end": 2161.4, "text": "在下"}, {"start": 2162.24, "end": 2163.64, "text": "只是怕说不好"}, {"start": 2163.92, "end": 2164.64, "text": "你试试"}, {"start": 2166.72, "end": 2167.48, "text": "金乡"}, {"start": 2168.08, "end": 2170.6, "text": "乃四面受敌之地"}, {"start": 2172.2, "end": 2173.44, "text": "据孙柳尽"}, {"start": 2174.48, "end": 2175.56, "text": "据许昌元"}, {"start": 2176.36, "end": 2179.12, "text": "孙柳早就对他垂涎三尺"}, {"start": 2180.08, "end": 2181.28, "text": "碧玉取之"}, {"start": 2182.44, "end": 2183.28, "text": "金乡"}, {"start": 2184.16, "end": 2185.96, "text": "早晚会丢失"}, {"start": 2187.04, "end": 2188.04, "text": "如果那样"}, {"start": 2188.92, "end": 2190.04, "text": "丢给刘备"}, {"start": 2191.6, "end": 2193.28, "text": "必丢给孙全好"}, {"start": 2193.72, "end": 2194.56, "text": "为何呢"}, {"start": 2195.64, "end": 2196.92, "text": "一根骨头"}, {"start": 2197.6, "end": 2199.04, "text": "两口相争"}, {"start": 2200.04, "end": 2201.92, "text": "瘦弱的那只嘴快"}, {"start": 2202.36, "end": 2203.72, "text": "先叼走了"}, {"start": 2204.92, "end": 2206.32, "text": "强壮的那只"}, {"start": 2207.52, "end": 2208.96, "text": "岂能甘愿"}, {"start": 2211.17, "end": 2211.69, "text": "梦"}, {"start": 2211.97, "end": 2215.06, "text": "梦梦"}, {"start": 2226.19, "end": 2227.39, "text": "恭敬祥请主公"}, {"start": 2227.39, "end": 2228.79, "text": "禁起江东之兵"}, {"start": 2228.79, "end": 2230.39, "text": "交与他讨伐刘备"}, {"start": 2231.23, "end": 2232.23, "text": "夺回京乡"}, {"start": 2258.96, "end": 2260.16, "text": "刘备此人"}, {"start": 2261.28, "end": 2263.12, "text": "赐命仁义之君"}, {"start": 2264.64, "end": 2267.24, "text": "其心底太险恶了"}, {"start": 2269.46, "end": 2270.74, "text": "有诸葛亮在"}, {"start": 2271.34, "end": 2273.42, "text": "谁也不必故作仁义"}, {"start": 2275.35, "end": 2275.99, "text": "主公啊"}, {"start": 2277.23, "end": 2279.03, "text": "我们如何恢复恭敬呢"}, {"start": 2286.71, "end": 2288.31, "text": "如果我让恭敬"}, {"start": 2289.51, "end": 2291.31, "text": "引兵攻打京乡"}, {"start": 2293.15, "end": 2296.84, "text": "就算最终夺取城池"}, {"start": 2296.84, "end": 2297.92, "text": "那我与刘备"}, {"start": 2302.66, "end": 2303.82, "text": "倘若这事"}, {"start": 2304.9, "end": 2306.94, "text": "曹操来攻我江东"}, {"start": 2308.86, "end": 2310.26, "text": "如何应敌"}, {"start": 2326.73, "end": 2327.49, "text": "这次"}, {"start": 2328.61, "end": 2330.89, "text": "就当让刘备占了个便宜"}, {"start": 2331.69, "end": 2334.61, "text": "我们暂且先忍一下这口气"}, {"start": 2335.53, "end": 2336.01, "text": "好"}, {"start": 2336.81, "end": 2338.17, "text": "我急传主公之令"}, {"start": 2338.49, "end": 2339.81, "text": "命恭敬退兵"}, {"start": 2342.64, "end": 2343.28, "text": "紫敬"}, {"start": 2345.54, "end": 2346.82, "text": "此时此刻"}, {"start": 2348.62, "end": 2349.86, "text": "你觉得我的令"}, {"start": 2351.22, "end": 2353.74, "text": "恭敬还能挺得进去吗"}, {"start": 2355.83, "end": 2357.51, "text": "主公担心的正是"}, {"start": 2358.55, "end": 2359.51, "text": "事到如今"}, {"start": 2359.51, "end": 2361.83, "text": "在下不得不直言相禀了"}, {"start": 2363.86, "end": 2364.38, "text": "快讲"}, {"start": 2365.26, "end": 2367.46, "text": "请主公收回恭敬的兵符"}, {"start": 2367.46, "end": 2369.1, "text": "命他回江东养伤"}, {"start": 2385.28, "end": 2385.8, "text": "紫敬"}, {"start": 2386.24, "end": 2386.68, "text": "在"}, {"start": 2387.64, "end": 2388.48, "text": "我意已决"}, {"start": 2389.48, "end": 2390.68, "text": "恭敬的兵符"}, {"start": 2391.28, "end": 2392.24, "text": "断不可夺"}, {"start": 2396.56, "end": 2397.32, "text": "当初"}, {"start": 2398.44, "end": 2400.28, "text": "我父兄引兵渡江"}, {"start": 2400.92, "end": 2402.28, "text": "只有几百部中"}, {"start": 2403.08, "end": 2404.84, "text": "凭什么在短短数年"}, {"start": 2405.36, "end": 2406.96, "text": "就可以雄拒江东"}, {"start": 2408.08, "end": 2408.84, "text": "凭的"}, {"start": 2409.2, "end": 2411.12, "text": "就是对部下的肝胆相照"}, {"start": 2411.8, "end": 2414.8, "text": "令江东才俊争相敬从"}, {"start": 2417.24, "end": 2419.92, "text": "我文功武略皆不如父兄"}, {"start": 2421.04, "end": 2422.52, "text": "如果再无点儿胸襟"}, {"start": 2423.56, "end": 2425.8, "text": "那凭什么拒江东以政天下"}, {"start": 2428.93, "end": 2429.97, "text": "恭敬这人"}, {"start": 2431.45, "end": 2432.81, "text": "虽然傲慢一些"}, {"start": 2433.97, "end": 2434.97, "text": "专断一些"}, {"start": 2436.13, "end": 2437.41, "text": "可他满腹才华"}, {"start": 2437.57, "end": 2438.57, "text": "忠勇双全"}, {"start": 2439.13, "end": 2440.05, "text": "赤壁一战"}, {"start": 2440.49, "end": 2441.53, "text": "若不是恭敬"}, {"start": 2441.77, "end": 2442.97, "text": "东吴早就完了"}, {"start": 2444.21, "end": 2446.57, "text": "恭敬之功足可传世"}, {"start": 2448.17, "end": 2450.05, "text": "我连刘备这等伪君子"}, {"start": 2450.05, "end": 2451.05, "text": "都可以忍受"}, {"start": 2452.45, "end": 2453.25, "text": "为何"}, {"start": 2454.17, "end": 2456.01, "text": "就容不下一个周恭敬"}, {"start": 2462.0, "end": 2464.48, "text": "恭敬之权断不可夺"}, {"start": 2466.79, "end": 2467.47, "text": "就算"}, {"start": 2468.67, "end": 2469.87, "text": "他把东吴之兵"}, {"start": 2470.35, "end": 2471.51, "text": "都折损干净了"}, {"start": 2472.91, "end": 2473.71, "text": "我也认了"}, {"start": 2475.23, "end": 2475.91, "text": "大王"}, {"start": 2477.19, "end": 2478.19, "text": "从头再来"}, {"start": 2480.5, "end": 2481.18, "text": "主公啊"}, {"start": 2481.54, "end": 2482.78, "text": "在下还有一计"}, {"start": 2482.94, "end": 2484.78, "text": "可是恭敬不得不回师"}, {"start": 2485.18, "end": 2487.46, "text": "不知主公愿意采拿否"}, {"start": 2488.5, "end": 2489.06, "text": "快讲"}]