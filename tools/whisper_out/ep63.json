[{"start": 7.25, "end": 13.09, "text": "你竟令人围攻我。"}, {"start": 13.09, "end": 14.09, "text": "好。"}, {"start": 14.09, "end": 168.19, "text": "任凭你们一起上我也不惧。"}, {"start": 168.19, "end": 169.19, "text": "来啊。"}, {"start": 171.19, "end": 173.19, "text": "马俏已经认定你咋了。"}, {"start": 173.19, "end": 180.98, "text": "你浑身有罪说不清了。"}, {"start": 180.98, "end": 181.98, "text": "现在就投了曹操吧。"}, {"start": 181.98, "end": 182.98, "text": "我的结义兄弟。"}, {"start": 182.98, "end": 187.42, "text": "事已至此,不得不忍啊。"}, {"start": 196.52, "end": 198.52, "text": "韩将军,不要惊慌。"}, {"start": 198.52, "end": 201.83, "text": "我来助你。"}, {"start": 201.83, "end": 202.83, "text": "放箭。"}, {"start": 202.83, "end": 204.83, "text": "逃贼就要来救你了。"}, {"start": 204.83, "end": 214.83, "text": "你还有得担心吗?"}, {"start": 214.83, "end": 215.83, "text": "没事吧?"}, {"start": 215.83, "end": 217.83, "text": "自然守记者赏千金风万..."}, {"start": 217.83, "end": 365.93, "text": "点睛失分,万万错失不得。"}, {"start": 366.93, "end": 370.93, "text": "稍一走神,就神韵皆无了。"}, {"start": 370.93, "end": 375.88, "text": "主公画上的簪花是女,"}, {"start": 375.88, "end": 379.88, "text": "要比堂上的舞女更有神韵。"}, {"start": 380.88, "end": 381.88, "text": "那是自然。"}, {"start": 382.88, "end": 383.88, "text": "说吧。"}, {"start": 384.88, "end": 385.88, "text": "是。"}, {"start": 385.88, "end": 390.28, "text": "启禀国主,"}, {"start": 390.28, "end": 393.28, "text": "曹操在魏水之盘击败马超二十万大军,"}, {"start": 393.28, "end": 395.28, "text": "并乘胜攻取西梁。"}, {"start": 395.28, "end": 397.28, "text": "马超走投无路,"}, {"start": 397.28, "end": 400.28, "text": "只得率五万残军奔往汉中,"}, {"start": 400.28, "end": 402.28, "text": "投了汉宁探守张鲁。"}, {"start": 404.28, "end": 406.28, "text": "曹操好厉害啊。"}, {"start": 406.28, "end": 408.28, "text": "把西梁都给取下来了。"}, {"start": 409.28, "end": 412.28, "text": "张鲁该忙着对付曹操了吧?"}, {"start": 412.28, "end": 413.28, "text": "不。"}, {"start": 414.28, "end": 417.28, "text": "张鲁兵风所向,直指我西船。"}, {"start": 417.28, "end": 418.28, "text": "什么?"}, {"start": 419.28, "end": 421.28, "text": "他不抗曹,攻我作甚?"}, {"start": 421.28, "end": 422.28, "text": "武功倾向。"}, {"start": 423.28, "end": 432.01, "text": "如果连马超都不是曹操的对手,"}, {"start": 433.01, "end": 436.01, "text": "那张鲁又如何抵得过曹操呢?"}, {"start": 437.01, "end": 440.01, "text": "汉中之地易攻难守。"}, {"start": 440.01, "end": 442.01, "text": "张鲁要想图存,"}, {"start": 442.01, "end": 445.01, "text": "最好的办法就是拜马超为将,"}, {"start": 445.01, "end": 447.01, "text": "夺取我西川,"}, {"start": 447.01, "end": 450.01, "text": "把西川和汉中都给取下来了。"}, {"start": 450.01, "end": 453.01, "text": "拜一拜了,汉中失手,"}, {"start": 453.01, "end": 456.01, "text": "他仍然可以退居西川,"}, {"start": 456.01, "end": 458.01, "text": "平险举手。"}, {"start": 458.01, "end": 460.01, "text": "你既知道西川艰险,"}, {"start": 460.01, "end": 462.01, "text": "那还担心什么?"}, {"start": 462.01, "end": 464.01, "text": "让张鲁来攻好了。"}, {"start": 464.01, "end": 467.01, "text": "我有二十万大军,何惧他?"}, {"start": 468.01, "end": 469.01, "text": "主公,"}, {"start": 469.01, "end": 472.01, "text": "这张鲁素有息故之心,"}, {"start": 472.01, "end": 474.01, "text": "但他却不敢担心。"}, {"start": 475.01, "end": 476.01, "text": "张鲁,"}, {"start": 476.01, "end": 477.01, "text": "主公,"}, {"start": 477.01, "end": 480.01, "text": "这张鲁素有息故之心,"}, {"start": 480.01, "end": 483.01, "text": "如今又添了猛将马超,"}, {"start": 483.01, "end": 485.01, "text": "如虎添翼啊。"}, {"start": 485.01, "end": 487.01, "text": "马超有这么骁勇,"}, {"start": 488.01, "end": 491.01, "text": "我西川将士斩他不过?"}, {"start": 491.01, "end": 494.01, "text": "主公知道吕布吧?"}, {"start": 495.01, "end": 496.01, "text": "当然,"}, {"start": 496.01, "end": 499.01, "text": "手中方天锦,跨下赤兔马,"}, {"start": 499.01, "end": 500.01, "text": "天下无人可敌。"}, {"start": 500.01, "end": 501.01, "text": "曹操说,"}, {"start": 501.01, "end": 504.01, "text": "马超之勇不下于吕布,"}, {"start": 504.01, "end": 506.01, "text": "卫水之战中,"}, {"start": 506.01, "end": 510.01, "text": "马超把曹操杀得隔续蒙面而逃,"}, {"start": 510.01, "end": 512.01, "text": "险些丢了性命,"}, {"start": 512.01, "end": 515.01, "text": "只因曹操失了离间计,"}, {"start": 515.01, "end": 518.01, "text": "那马超才功亏一篑。"}, {"start": 518.01, "end": 519.01, "text": "永年啊,"}, {"start": 520.01, "end": 523.01, "text": "你以为咱们如何是好?"}, {"start": 524.01, "end": 528.01, "text": "向许昌朝廷供奉重礼,"}, {"start": 528.01, "end": 530.01, "text": "拜曹操为盟,"}, {"start": 530.01, "end": 533.01, "text": "让他出军攻袭汉中,"}, {"start": 533.01, "end": 534.01, "text": "如此,"}, {"start": 534.01, "end": 537.01, "text": "张鲁无心稀固,"}, {"start": 537.01, "end": 539.01, "text": "西川无忧。"}, {"start": 539.01, "end": 541.01, "text": "好,好!"}, {"start": 541.01, "end": 542.01, "text": "永年啊,"}, {"start": 542.01, "end": 544.01, "text": "令你为使,"}, {"start": 544.01, "end": 546.01, "text": "亲自前往许昌,"}, {"start": 546.01, "end": 548.01, "text": "拜见曹丞相。"}, {"start": 548.01, "end": 549.01, "text": "遵命。"}, {"start": 549.01, "end": 554.63, "text": "主上这样昏庸,"}, {"start": 554.63, "end": 557.63, "text": "西川岂能自保,"}, {"start": 557.63, "end": 558.63, "text": "这次不亡,"}, {"start": 558.63, "end": 560.63, "text": "也难逃下司。"}, {"start": 560.63, "end": 566.22, "text": "你我一枪报复,"}, {"start": 566.22, "end": 568.22, "text": "满腹制谋,"}, {"start": 568.22, "end": 574.34, "text": "却只能用来为庸主看家守院。"}, {"start": 574.34, "end": 577.74, "text": "天赐西川与流争啊,"}, {"start": 577.74, "end": 579.74, "text": "他却不知珍惜。"}, {"start": 580.74, "end": 583.74, "text": "为西川四十一州百姓计,"}, {"start": 583.74, "end": 590.4, "text": "我们不如替西川寻一个名主吧。"}, {"start": 590.4, "end": 591.4, "text": "法正,"}, {"start": 591.4, "end": 599.65, "text": "你想叛主吗?"}, {"start": 599.65, "end": 609.73, "text": "我一向视你为数中才俊,"}, {"start": 609.73, "end": 612.73, "text": "没想到你这等浅薄。"}, {"start": 612.73, "end": 615.1, "text": "好,"}, {"start": 615.1, "end": 623.06, "text": "你拿我剑留着妖工去吧。"}, {"start": 626.06, "end": 630.4, "text": "孝之,"}, {"start": 630.4, "end": 633.4, "text": "你果然有肝胆。"}, {"start": 635.4, "end": 637.4, "text": "永年兄,"}, {"start": 637.4, "end": 640.4, "text": "莫非你也有此意?"}, {"start": 641.4, "end": 643.4, "text": "来,"}, {"start": 643.4, "end": 644.4, "text": "来,"}, {"start": 644.4, "end": 651.61, "text": "你看,"}, {"start": 651.61, "end": 652.61, "text": "这是什么?"}, {"start": 652.61, "end": 660.82, "text": "是一州祥土。"}, {"start": 660.82, "end": 662.82, "text": "川地之险,"}, {"start": 662.82, "end": 665.82, "text": "你之险雄于天下。"}, {"start": 665.82, "end": 667.82, "text": "如果没有地图,"}, {"start": 667.82, "end": 671.82, "text": "任得千军万马也休想入川。"}, {"start": 671.82, "end": 679.09, "text": "这张祥土是我花了三年的时间绘制而成。"}, {"start": 679.09, "end": 683.09, "text": "西川地通道山川险易,"}, {"start": 683.09, "end": 684.09, "text": "兵营军阵,"}, {"start": 684.09, "end": 686.09, "text": "府库钱粮,"}, {"start": 686.09, "end": 690.5, "text": "全部祥家载入。"}, {"start": 690.5, "end": 691.5, "text": "谁得此图,"}, {"start": 691.5, "end": 694.5, "text": "谁就得半个西川。"}, {"start": 694.5, "end": 696.5, "text": "那么,"}, {"start": 696.5, "end": 702.25, "text": "兄台想把此图献给谁呢?"}, {"start": 702.25, "end": 703.25, "text": "曲昌,"}, {"start": 703.25, "end": 704.25, "text": "曹操,"}, {"start": 704.25, "end": 707.25, "text": "此人胸有套略,"}, {"start": 707.25, "end": 709.25, "text": "手握雄兵,"}, {"start": 709.25, "end": 712.25, "text": "挟天子令天下,"}, {"start": 712.25, "end": 716.25, "text": "是当今世上第一雄主。"}, {"start": 716.25, "end": 718.25, "text": "西川落入他手,"}, {"start": 718.25, "end": 723.25, "text": "数中百姓便可长久太平。"}, {"start": 723.25, "end": 727.25, "text": "你我也能大战才干啊。"}, {"start": 727.25, "end": 731.25, "text": "曹操脱名汉相,"}, {"start": 731.25, "end": 733.25, "text": "实为汉贼。"}, {"start": 733.25, "end": 737.25, "text": "兄台为何不把此图献给刘备呢?"}, {"start": 737.25, "end": 738.25, "text": "他既是汉室后裔,"}, {"start": 738.25, "end": 740.25, "text": "又占据荆州九郡,"}, {"start": 740.25, "end": 741.25, "text": "本有祝格量,"}, {"start": 741.25, "end": 743.25, "text": "乌有端章照,"}, {"start": 743.25, "end": 745.25, "text": "将来必成大义。"}, {"start": 745.25, "end": 749.1, "text": "荆州之地,"}, {"start": 749.1, "end": 752.1, "text": "夹在曹操与孙泉之间,"}, {"start": 752.1, "end": 754.1, "text": "早晚必是。"}, {"start": 754.1, "end": 757.67, "text": "刘备若能自救,"}, {"start": 757.67, "end": 759.67, "text": "救赎不易,"}, {"start": 759.67, "end": 761.67, "text": "和谈大业。"}, {"start": 761.67, "end": 767.05, "text": "至于贤弟的汉相汉贼之说,"}, {"start": 767.05, "end": 769.05, "text": "就太迂了。"}, {"start": 769.05, "end": 773.05, "text": "天下何人无人骂,"}, {"start": 773.05, "end": 776.05, "text": "天下何人不骂人。"}, {"start": 776.05, "end": 778.05, "text": "骂来骂去,"}, {"start": 778.05, "end": 782.05, "text": "曹操却成就了功名大业。"}, {"start": 782.05, "end": 787.33, "text": "如果说刘备是贤主,"}, {"start": 788.33, "end": 791.33, "text": "那曹操便是熊主。"}, {"start": 791.33, "end": 795.33, "text": "乱世之中熊主胜于贤主。"}, {"start": 795.33, "end": 799.05, "text": "何时启行?"}, {"start": 799.05, "end": 801.05, "text": "明日出川,"}, {"start": 801.05, "end": 805.05, "text": "十日之后便可到许昌了。"}, {"start": 805.05, "end": 810.05, "text": "好,熊台一路顺风。"}, {"start": 810.05, "end": 811.05, "text": "好。"}, {"start": 811.05, "end": 830.93, "text": "丞相,"}, {"start": 830.93, "end": 838.53, "text": "这些都是西征时消耗的兵马钱粮不测。"}, {"start": 838.53, "end": 840.53, "text": "请丞相审阅。"}, {"start": 840.53, "end": 842.81, "text": "这么多?"}, {"start": 842.81, "end": 849.2, "text": "曹弘、徐晃、夏侯渊等部"}, {"start": 849.2, "end": 851.2, "text": "伤亡都超过了一半。"}, {"start": 851.2, "end": 853.2, "text": "青州、济州、徐州"}, {"start": 853.2, "end": 855.2, "text": "税付耗尽。"}, {"start": 855.2, "end": 857.2, "text": "丞相啊,"}, {"start": 857.2, "end": 861.2, "text": "这一仗把我们积攒八年的粮饷"}, {"start": 861.2, "end": 863.2, "text": "用掉了七成啊。"}, {"start": 865.2, "end": 867.2, "text": "损失果然不小,"}, {"start": 867.2, "end": 869.2, "text": "但是从长远看起来,"}, {"start": 869.2, "end": 871.2, "text": "咱们得到的更多。"}, {"start": 871.2, "end": 875.67, "text": "首先我们解除了北境之忧,"}, {"start": 875.67, "end": 880.67, "text": "其次我们得到了西粮八军。"}, {"start": 880.67, "end": 884.67, "text": "西粮是苦寒之地,"}, {"start": 884.67, "end": 887.67, "text": "出军马更出赶战之时。"}, {"start": 887.67, "end": 893.4, "text": "咱们占据中原也有近十年了吧。"}, {"start": 893.4, "end": 897.94, "text": "军中木器日盛,"}, {"start": 897.94, "end": 902.94, "text": "太需要西粮军师来充实我们的军营了。"}, {"start": 902.94, "end": 903.94, "text": "丞相,"}, {"start": 903.94, "end": 905.94, "text": "丞相做言极是啊。"}, {"start": 905.94, "end": 908.94, "text": "但西粮自董卓之后,"}, {"start": 908.94, "end": 910.94, "text": "就由马氏父子占据。"}, {"start": 910.94, "end": 912.94, "text": "我们刚刚拿下,"}, {"start": 912.94, "end": 914.94, "text": "人心未富,田木荒芜。"}, {"start": 914.94, "end": 916.94, "text": "枪人逃税,"}, {"start": 916.94, "end": 918.94, "text": "情状俱征啊。"}, {"start": 920.94, "end": 921.94, "text": "从现在起,"}, {"start": 921.94, "end": 924.94, "text": "全力做好三件事。"}, {"start": 924.94, "end": 926.94, "text": "哪三件事啊?"}, {"start": 926.94, "end": 927.94, "text": "第一,"}, {"start": 927.94, "end": 931.76, "text": "养民。"}, {"start": 931.76, "end": 934.2, "text": "第二,"}, {"start": 934.2, "end": 936.2, "text": "吞啃。"}, {"start": 936.2, "end": 939.64, "text": "第三,"}, {"start": 939.64, "end": 941.64, "text": "休战。"}, {"start": 941.64, "end": 944.64, "text": "请丞相详释。"}, {"start": 944.64, "end": 946.64, "text": "西粮,"}, {"start": 946.64, "end": 949.64, "text": "原本就是贫瘠之地。"}, {"start": 949.64, "end": 952.64, "text": "又逢连年兵祸,"}, {"start": 952.64, "end": 954.64, "text": "加上旱灾,"}, {"start": 954.64, "end": 956.64, "text": "百姓的日子,"}, {"start": 956.64, "end": 958.64, "text": "就更加艰难了。"}, {"start": 958.64, "end": 960.64, "text": "已传令下去,"}, {"start": 960.64, "end": 965.11, "text": "所有驻防西粮的军队,"}, {"start": 965.11, "end": 968.11, "text": "一律不准在当地挣粮。"}, {"start": 968.11, "end": 971.68, "text": "凡敢拿,"}, {"start": 971.68, "end": 974.68, "text": "百姓一树一草者,"}, {"start": 974.68, "end": 975.68, "text": "斩。"}, {"start": 975.68, "end": 980.47, "text": "把长安大仓中的所有军粮,"}, {"start": 980.47, "end": 983.47, "text": "全部调往西粮镇集灾民。"}, {"start": 983.47, "end": 985.47, "text": "还有,"}, {"start": 985.47, "end": 987.47, "text": "我们要免去西粮八军,"}, {"start": 987.47, "end": 989.47, "text": "百姓两年的赋税,"}, {"start": 989.47, "end": 992.47, "text": "这就是养民。"}, {"start": 992.47, "end": 994.47, "text": "记下了。"}, {"start": 994.47, "end": 996.47, "text": "第二呢?"}, {"start": 996.47, "end": 999.47, "text": "派上将于晋,"}, {"start": 999.47, "end": 1002.47, "text": "率老弱之师赴西粮无主之地,"}, {"start": 1002.47, "end": 1004.47, "text": "实行屯恳。"}, {"start": 1004.47, "end": 1006.47, "text": "凡冤屈者,"}, {"start": 1006.47, "end": 1009.47, "text": "赠钱粮。"}, {"start": 1009.47, "end": 1014.77, "text": "牛马,"}, {"start": 1014.77, "end": 1015.77, "text": "头三年,"}, {"start": 1015.77, "end": 1017.77, "text": "所产古物,"}, {"start": 1017.77, "end": 1018.77, "text": "权归己有。"}, {"start": 1018.77, "end": 1020.77, "text": "三年后,"}, {"start": 1020.77, "end": 1023.77, "text": "可按三七分队,"}, {"start": 1023.77, "end": 1025.77, "text": "共饮军粮。"}, {"start": 1025.77, "end": 1031.51, "text": "第三?"}, {"start": 1031.51, "end": 1033.51, "text": "现在,"}, {"start": 1034.51, "end": 1036.51, "text": "我们拥有"}, {"start": 1036.51, "end": 1038.51, "text": "中原四周,"}, {"start": 1038.51, "end": 1041.51, "text": "再加上西粮各地,"}, {"start": 1041.51, "end": 1043.51, "text": "也可以算是"}, {"start": 1043.51, "end": 1047.08, "text": "纵横数千里了。"}, {"start": 1047.08, "end": 1049.08, "text": "可是将士们连年征战,"}, {"start": 1049.08, "end": 1052.08, "text": "早已疲惫不堪。"}, {"start": 1052.08, "end": 1054.08, "text": "所以我们"}, {"start": 1054.08, "end": 1056.08, "text": "要休战数年,"}, {"start": 1056.08, "end": 1059.08, "text": "用以练兵养士,"}, {"start": 1059.08, "end": 1060.08, "text": "囤集粮草,"}, {"start": 1060.08, "end": 1062.08, "text": "打造军械。"}, {"start": 1062.08, "end": 1064.08, "text": "待我们的力量,"}, {"start": 1064.08, "end": 1066.08, "text": "还要在强盛的时候,"}, {"start": 1066.08, "end": 1069.35, "text": "在灰石南下。"}, {"start": 1069.35, "end": 1071.35, "text": "就是所谓,"}, {"start": 1071.35, "end": 1073.35, "text": "与取胜他人,"}, {"start": 1073.35, "end": 1075.35, "text": "自己先要利用,"}, {"start": 1075.35, "end": 1082.18, "text": "不败之道。"}, {"start": 1082.18, "end": 1083.18, "text": "丞相,"}, {"start": 1083.18, "end": 1085.18, "text": "我这就召集相关文武,"}, {"start": 1085.18, "end": 1086.18, "text": "不止施行,"}, {"start": 1086.18, "end": 1092.15, "text": "你的三大方略。"}, {"start": 1092.15, "end": 1094.15, "text": "报!"}, {"start": 1094.15, "end": 1095.15, "text": "禀丞相,"}, {"start": 1095.15, "end": 1096.15, "text": "西川刘璋派别驾张松为使,"}, {"start": 1096.15, "end": 1098.15, "text": "来许昌朝宫。"}, {"start": 1098.15, "end": 1099.15, "text": "你去吧。"}, {"start": 1099.15, "end": 1103.22, "text": "诺!"}, {"start": 1103.22, "end": 1107.11, "text": "西川刘璋,"}, {"start": 1107.11, "end": 1110.11, "text": "是一丘之河。"}, {"start": 1110.11, "end": 1112.11, "text": "向来以正统自居,"}, {"start": 1112.11, "end": 1114.11, "text": "从不与我往来。"}, {"start": 1114.11, "end": 1117.36, "text": "怎么会突然想起来,"}, {"start": 1117.36, "end": 1119.36, "text": "给我朝贡呢?"}, {"start": 1119.36, "end": 1121.36, "text": "使者是一周别驾张松。"}, {"start": 1121.36, "end": 1124.67, "text": "丞相,"}, {"start": 1124.67, "end": 1126.67, "text": "此人是刘璋的心腹和臂膀,"}, {"start": 1126.67, "end": 1128.67, "text": "在西川士族中,"}, {"start": 1128.67, "end": 1130.67, "text": "树大根深。"}, {"start": 1130.67, "end": 1132.67, "text": "刘璋,"}, {"start": 1132.67, "end": 1134.67, "text": "他到底想干什么?"}, {"start": 1134.67, "end": 1137.95, "text": "是来求我的,"}, {"start": 1137.95, "end": 1139.95, "text": "还是来骗我的。"}, {"start": 1139.95, "end": 1141.95, "text": "丞相,"}, {"start": 1141.95, "end": 1143.95, "text": "不管怎样,"}, {"start": 1143.95, "end": 1145.95, "text": "先见见才说。"}, {"start": 1145.95, "end": 1148.2, "text": "不,"}, {"start": 1148.2, "end": 1150.2, "text": "我先不见他。"}, {"start": 1150.2, "end": 1152.2, "text": "你告诉张松,"}, {"start": 1152.2, "end": 1154.2, "text": "让他稍候数日,"}, {"start": 1154.2, "end": 1158.02, "text": "现在管意,"}, {"start": 1158.02, "end": 1162.67, "text": "住下吧。"}, {"start": 1162.67, "end": 1167.77, "text": "遵命。"}, {"start": 1167.77, "end": 1169.77, "text": "今天丞相又没哭。"}, {"start": 1169.77, "end": 1171.77, "text": "回大人,"}, {"start": 1171.77, "end": 1173.77, "text": "今天丞相要给小儿子做晚睡,"}, {"start": 1173.77, "end": 1175.77, "text": "所以不能见大人。"}, {"start": 1175.77, "end": 1176.77, "text": "丞相,"}, {"start": 1176.77, "end": 1178.77, "text": "请大人见谅。"}, {"start": 1178.77, "end": 1180.77, "text": "什么?"}, {"start": 1180.77, "end": 1182.77, "text": "为了给一个小娃儿过生日,"}, {"start": 1182.77, "end": 1185.77, "text": "你们竟敢漫待西川特使?"}, {"start": 1185.77, "end": 1187.77, "text": "请大人见谅,"}, {"start": 1187.77, "end": 1198.12, "text": "见谅。"}, {"start": 1198.12, "end": 1200.12, "text": "都说,"}, {"start": 1200.12, "end": 1202.12, "text": "曹操素有胸襟,"}, {"start": 1202.12, "end": 1204.12, "text": "礼贤下士,"}, {"start": 1204.12, "end": 1206.12, "text": "我看是徒有虚名。"}, {"start": 1206.12, "end": 1224.34, "text": "丞相,"}, {"start": 1224.34, "end": 1226.34, "text": "今天已经是第五天了。"}, {"start": 1226.34, "end": 1228.34, "text": "据医馆的人说,"}, {"start": 1228.34, "end": 1230.34, "text": "张松每天戒酒使性,"}, {"start": 1230.34, "end": 1232.34, "text": "言语之中甚至不满,"}, {"start": 1232.34, "end": 1234.34, "text": "抱怨丞相,"}, {"start": 1234.34, "end": 1236.34, "text": "漫嫌。"}, {"start": 1236.34, "end": 1238.34, "text": "咱们漫待了人家,"}, {"start": 1238.34, "end": 1240.34, "text": "人家骂两句是应该的。"}, {"start": 1240.34, "end": 1242.34, "text": "千里之遥,"}, {"start": 1242.34, "end": 1249.27, "text": "来一趟也不容易啊。"}, {"start": 1249.27, "end": 1251.27, "text": "如果我们这样漫待人家,"}, {"start": 1251.27, "end": 1253.27, "text": "那岂不冷了,"}, {"start": 1253.27, "end": 1255.27, "text": "想依附你的人心了吗?"}, {"start": 1255.27, "end": 1257.27, "text": "刘章,"}, {"start": 1257.27, "end": 1259.27, "text": "也是一方诸侯啊。"}, {"start": 1259.27, "end": 1268.22, "text": "既然丞大人都发话了,"}, {"start": 1268.22, "end": 1270.22, "text": "那就让他明日来见我吧。"}, {"start": 1270.22, "end": 1274.94, "text": "丞相。"}, {"start": 1274.94, "end": 1276.94, "text": "你刚才不是都替他说话了吗?"}, {"start": 1276.94, "end": 1278.94, "text": "我也答应你了。"}, {"start": 1278.94, "end": 1280.94, "text": "你怎么不去传话啊?"}, {"start": 1282.94, "end": 1284.94, "text": "我不知道丞相,"}, {"start": 1284.94, "end": 1286.94, "text": "究竟何意啊?"}, {"start": 1286.94, "end": 1296.55, "text": "我听说许昌官府的风气"}, {"start": 1296.55, "end": 1298.55, "text": "有些堕落。"}, {"start": 1298.55, "end": 1300.55, "text": "像十年前的洛阳啊,"}, {"start": 1300.55, "end": 1302.55, "text": "凡是外地的官员进京,"}, {"start": 1302.55, "end": 1306.06, "text": "官府的人都索要贿赂。"}, {"start": 1306.06, "end": 1308.06, "text": "你该得到"}, {"start": 1308.06, "end": 1312.81, "text": "张诵什么好处了吧?"}, {"start": 1312.81, "end": 1314.81, "text": "我承玉"}, {"start": 1314.81, "end": 1316.81, "text": "岂是这种人呢?"}, {"start": 1316.81, "end": 1320.09, "text": "我跟你开玩笑呢?"}, {"start": 1320.09, "end": 1328.84, "text": "仲德,"}, {"start": 1328.84, "end": 1333.11, "text": "你可真是个老实人啊。"}, {"start": 1338.42, "end": 1340.42, "text": "丞相,"}, {"start": 1340.42, "end": 1342.42, "text": "不该戏弄老实人啊。"}, {"start": 1342.42, "end": 1344.42, "text": "好好好。"}, {"start": 1344.42, "end": 1346.42, "text": "咱们当着老实人"}, {"start": 1346.42, "end": 1348.42, "text": "不说假话。"}, {"start": 1348.42, "end": 1350.42, "text": "我之所以不想"}, {"start": 1350.42, "end": 1352.42, "text": "我之所以不见张诵"}, {"start": 1352.42, "end": 1354.42, "text": "是因为我一直没有弄清楚"}, {"start": 1354.42, "end": 1356.42, "text": "他的来意。"}, {"start": 1356.42, "end": 1358.42, "text": "现在我大致明白了。"}, {"start": 1358.42, "end": 1360.42, "text": "所以明日"}, {"start": 1360.42, "end": 1362.42, "text": "可以与他相见了。"}, {"start": 1362.42, "end": 1383.02, "text": "儿等,"}, {"start": 1383.02, "end": 1385.02, "text": "快快通报。"}, {"start": 1385.02, "end": 1387.02, "text": "西川特使,"}, {"start": 1387.02, "end": 1389.02, "text": "易州张诵,"}, {"start": 1389.02, "end": 1391.02, "text": "拜会曹丞相。"}, {"start": 1391.02, "end": 1393.02, "text": "刮造什么呀?"}, {"start": 1393.02, "end": 1395.02, "text": "谁是张诵?"}, {"start": 1395.02, "end": 1409.59, "text": "你吗?"}, {"start": 1409.59, "end": 1413.1, "text": "你是大人啊。"}, {"start": 1413.1, "end": 1416.38, "text": "在下有礼了。"}, {"start": 1416.38, "end": 1418.38, "text": "今日丞相公务繁忙。"}, {"start": 1418.38, "end": 1420.38, "text": "请大人回去等候吧。"}, {"start": 1420.38, "end": 1422.38, "text": "我已经等了六天了。"}, {"start": 1422.38, "end": 1424.38, "text": "今日是按照诚誉约定"}, {"start": 1424.38, "end": 1426.38, "text": "才来见丞相的。"}, {"start": 1426.38, "end": 1428.38, "text": "哦,是这样啊。"}, {"start": 1428.38, "end": 1430.38, "text": "那请大人在此等候。"}, {"start": 1430.38, "end": 1432.38, "text": "容在下进去禀报一声。"}, {"start": 1432.38, "end": 1441.99, "text": "你在等什么?"}, {"start": 1441.99, "end": 1443.99, "text": "还不快去。"}, {"start": 1443.99, "end": 1445.99, "text": "在等大人你的心意啊。"}, {"start": 1445.99, "end": 1449.37, "text": "什么?"}, {"start": 1449.37, "end": 1451.37, "text": "我是易州别嫁"}, {"start": 1451.37, "end": 1453.37, "text": "千里迢迢来见丞相。"}, {"start": 1453.37, "end": 1455.37, "text": "你这奴才"}, {"start": 1455.37, "end": 1457.37, "text": "还要收礼?"}, {"start": 1457.37, "end": 1459.37, "text": "不管大人从哪里来"}, {"start": 1459.37, "end": 1461.37, "text": "不能坏了"}, {"start": 1461.37, "end": 1463.37, "text": "相府的规矩啊。"}, {"start": 1463.37, "end": 1466.9, "text": "还是入乡随俗吧。"}, {"start": 1466.9, "end": 1481.77, "text": "谢谢大人。"}, {"start": 1481.77, "end": 1490.3, "text": "大人在此稍候。"}, {"start": 1490.3, "end": 1496.3, "text": "在下急去禀报。"}, {"start": 1498.3, "end": 1500.3, "text": "在下"}, {"start": 1500.3, "end": 1502.3, "text": "相府主部奉命迎接张大人。"}, {"start": 1502.3, "end": 1504.3, "text": "丞相何在?"}, {"start": 1504.3, "end": 1506.3, "text": "哦,请。"}, {"start": 1506.3, "end": 1526.63, "text": "丞相。"}, {"start": 1526.63, "end": 1530.23, "text": "丞相。"}, {"start": 1530.23, "end": 1535.62, "text": "西川特使来了。"}, {"start": 1535.62, "end": 1537.62, "text": "易州别嫁张松"}, {"start": 1537.62, "end": 1544.1, "text": "拜见丞相大人。"}, {"start": 1544.1, "end": 1546.1, "text": "你就是那个"}, {"start": 1546.1, "end": 1548.1, "text": "庄别嫁"}, {"start": 1548.1, "end": 1550.1, "text": "庄松?"}, {"start": 1550.1, "end": 1552.1, "text": "在下姓张"}, {"start": 1552.1, "end": 1554.1, "text": "工厂张"}, {"start": 1554.1, "end": 1556.1, "text": "张松。"}, {"start": 1556.1, "end": 1558.1, "text": "哦"}, {"start": 1558.1, "end": 1560.1, "text": "原来你姓张"}, {"start": 1560.1, "end": 1562.1, "text": "不姓庄。"}, {"start": 1562.1, "end": 1564.1, "text": "张别嫁"}, {"start": 1564.1, "end": 1567.58, "text": "如主刘张"}, {"start": 1567.58, "end": 1569.58, "text": "多年不来朝庭"}, {"start": 1569.58, "end": 1571.58, "text": "朝贡"}, {"start": 1571.58, "end": 1573.58, "text": "是何原因啊?"}, {"start": 1573.58, "end": 1575.58, "text": "路途艰难"}, {"start": 1575.58, "end": 1577.58, "text": "贼寇频频"}, {"start": 1577.58, "end": 1582.97, "text": "不能通达。"}, {"start": 1582.97, "end": 1586.25, "text": "托词。"}, {"start": 1586.25, "end": 1588.25, "text": "我早已扫清中原"}, {"start": 1588.25, "end": 1590.25, "text": "如今天下太平"}, {"start": 1590.25, "end": 1592.25, "text": "民生安定"}, {"start": 1592.25, "end": 1594.25, "text": "南有孙权"}, {"start": 1594.25, "end": 1596.25, "text": "北有张禄"}, {"start": 1596.25, "end": 1598.25, "text": "西有刘备"}, {"start": 1598.25, "end": 1600.25, "text": "此三人各地称兄"}, {"start": 1600.25, "end": 1602.25, "text": "代价数十万"}, {"start": 1602.25, "end": 1604.25, "text": "何为太平?"}, {"start": 1604.25, "end": 1606.25, "text": "庄松"}, {"start": 1606.25, "end": 1608.25, "text": "你既为来使"}, {"start": 1608.25, "end": 1610.25, "text": "何不知礼呢?"}, {"start": 1610.25, "end": 1613.53, "text": "在下姓张"}, {"start": 1613.53, "end": 1615.53, "text": "张松"}, {"start": 1615.53, "end": 1617.53, "text": "并丞相"}, {"start": 1617.53, "end": 1619.53, "text": "张松知礼"}, {"start": 1619.53, "end": 1621.53, "text": "张松千里迢迢来此"}, {"start": 1621.53, "end": 1623.53, "text": "并且在驿馆"}, {"start": 1623.53, "end": 1625.53, "text": "等候六天了。"}, {"start": 1625.53, "end": 1642.38, "text": "放肆!"}, {"start": 1642.38, "end": 1644.38, "text": "张大人"}, {"start": 1644.38, "end": 1646.38, "text": "幸亏丞相宽人为怀"}, {"start": 1646.38, "end": 1648.38, "text": "念你千里远来不忍责罚"}, {"start": 1648.38, "end": 1650.38, "text": "刚才你应该屈意"}, {"start": 1650.38, "end": 1652.38, "text": "尽言才是啊。"}, {"start": 1652.38, "end": 1654.38, "text": "我川中向无阐宁之人"}, {"start": 1654.38, "end": 1656.38, "text": "在下不懂"}, {"start": 1656.38, "end": 1658.38, "text": "屈意逢盈之数。"}, {"start": 1658.38, "end": 1660.38, "text": "川人不懂阐宁"}, {"start": 1660.38, "end": 1662.38, "text": "难道许昌"}, {"start": 1662.38, "end": 1664.38, "text": "就都是阐宁之徒吗?"}, {"start": 1664.38, "end": 1666.38, "text": "是也不是"}, {"start": 1666.38, "end": 1668.38, "text": "足下自主。"}, {"start": 1668.38, "end": 1673.8, "text": "你!"}, {"start": 1673.8, "end": 1677.85, "text": "郑德,传命。"}, {"start": 1677.85, "end": 1679.85, "text": "诺。"}, {"start": 1679.85, "end": 1681.85, "text": "两天后"}, {"start": 1681.85, "end": 1683.85, "text": "从许昌各军中"}, {"start": 1683.85, "end": 1685.85, "text": "抽调精锐三万人进驻西教场。"}, {"start": 1685.85, "end": 1689.26, "text": "我要亲自观看操演。"}, {"start": 1689.26, "end": 1691.26, "text": "丞相"}, {"start": 1691.26, "end": 1693.26, "text": "许昌原有驻军四万"}, {"start": 1693.26, "end": 1695.26, "text": "今平息已"}, {"start": 1695.26, "end": 1697.26, "text": "现在只剩下两万来人"}, {"start": 1697.26, "end": 1699.26, "text": "凑不足三万之数啊。"}, {"start": 1699.26, "end": 1701.26, "text": "就从夜城"}, {"start": 1701.26, "end": 1709.37, "text": "从洛阳清夜调兵来。"}, {"start": 1709.37, "end": 1711.37, "text": "眼下啊"}, {"start": 1711.37, "end": 1713.37, "text": "各军都很疲惫啊。"}, {"start": 1713.37, "end": 1715.37, "text": "再疲惫也得操演。"}, {"start": 1715.37, "end": 1717.37, "text": "如果敌军今晚杀来"}, {"start": 1717.37, "end": 1719.37, "text": "你说我很疲惫"}, {"start": 1719.37, "end": 1721.37, "text": "请敌军明天来吗?"}, {"start": 1721.37, "end": 1725.74, "text": "告诉驻将"}, {"start": 1725.74, "end": 1727.74, "text": "操演一定要有气势。"}, {"start": 1727.74, "end": 1729.74, "text": "务实者"}, {"start": 1729.74, "end": 1731.74, "text": "士气不振者"}, {"start": 1731.74, "end": 1733.74, "text": "已败战"}, {"start": 1733.74, "end": 1763.22, "text": "出于军阀。"}, {"start": 1763.22, "end": 1765.22, "text": "丞相军务繁忙"}, {"start": 1765.22, "end": 1767.22, "text": "只能在这里接待阁下。"}, {"start": 1767.22, "end": 1771.62, "text": "很客气啊"}, {"start": 1771.62, "end": 1803.1, "text": "客随主殿嘛。"}, {"start": 1803.1, "end": 1805.1, "text": "张别驾"}, {"start": 1805.1, "end": 1812.12, "text": "张宋拜见丞相。"}, {"start": 1812.12, "end": 1814.12, "text": "张别驾"}, {"start": 1814.12, "end": 1816.12, "text": "你在川中"}, {"start": 1816.12, "end": 1818.12, "text": "可见过如此雄壮的人马吗?"}, {"start": 1818.12, "end": 1820.12, "text": "蜀中明军"}, {"start": 1820.12, "end": 1822.12, "text": "刘章向以仁义治邦"}, {"start": 1822.12, "end": 1824.12, "text": "不曾见此兵阁。"}, {"start": 1824.12, "end": 1829.86, "text": "此话何意?"}, {"start": 1829.86, "end": 1831.86, "text": "是在说我不仁义吗?"}, {"start": 1831.86, "end": 1835.34, "text": "丞相虎威在上"}, {"start": 1835.34, "end": 1837.34, "text": "张宋岂敢?"}, {"start": 1837.34, "end": 1842.28, "text": "张宋"}, {"start": 1842.28, "end": 1844.28, "text": "我视天下诸侯如同草芥"}, {"start": 1844.28, "end": 1846.28, "text": "大军到处"}, {"start": 1846.28, "end": 1848.28, "text": "战无不胜 攻无不取"}, {"start": 1848.28, "end": 1850.28, "text": "顺我者胜"}, {"start": 1850.28, "end": 1852.28, "text": "逆我者死"}, {"start": 1852.28, "end": 1854.28, "text": "这你知道吗?"}, {"start": 1854.28, "end": 1856.28, "text": "知道"}, {"start": 1856.28, "end": 1858.28, "text": "丞相用兵如神"}, {"start": 1858.28, "end": 1860.28, "text": "大军到处"}, {"start": 1860.28, "end": 1862.28, "text": "战必胜"}, {"start": 1862.28, "end": 1864.28, "text": "攻必取"}, {"start": 1864.28, "end": 1866.28, "text": "张宋豈能不知啊?"}, {"start": 1866.28, "end": 1868.28, "text": "比如"}, {"start": 1868.28, "end": 1870.28, "text": "昔日"}, {"start": 1870.28, "end": 1872.28, "text": "蒲阳攻吕布之时"}, {"start": 1872.28, "end": 1874.28, "text": "板城战张秀之日"}, {"start": 1874.28, "end": 1876.28, "text": "赤壁与周郎"}, {"start": 1876.28, "end": 1878.28, "text": "华融逢关羽"}, {"start": 1878.28, "end": 1880.28, "text": "隔须气炮"}, {"start": 1880.28, "end": 1882.28, "text": "与同关"}, {"start": 1882.28, "end": 1884.28, "text": "多传避箭于未水"}, {"start": 1884.28, "end": 1886.28, "text": "恕辱"}, {"start": 1886.28, "end": 1888.28, "text": "如此放肆"}, {"start": 1888.28, "end": 1890.28, "text": "左右退出去斩了"}, {"start": 1890.28, "end": 1892.28, "text": "张相息怒"}, {"start": 1892.28, "end": 1894.28, "text": "但他毕竟千里而来许昌入宫"}, {"start": 1894.28, "end": 1896.28, "text": "若展之 恐是怨人之心哪"}, {"start": 1896.28, "end": 1898.28, "text": "丞相"}, {"start": 1898.28, "end": 1900.28, "text": "两军交战"}, {"start": 1900.28, "end": 1902.28, "text": "尚不斩来时"}, {"start": 1902.28, "end": 1904.28, "text": "何况 流章是把张宋前来"}, {"start": 1904.28, "end": 1907.53, "text": "修好的"}, {"start": 1907.53, "end": 1909.53, "text": "殊如坐井观天 夜郎自大"}, {"start": 1909.53, "end": 1911.53, "text": "狂辈可恨"}, {"start": 1911.53, "end": 1913.53, "text": "如果不是看在他们俩的分上"}, {"start": 1913.53, "end": 1915.53, "text": "定不饶你"}, {"start": 1915.53, "end": 1917.53, "text": "左右"}, {"start": 1917.53, "end": 1930.6, "text": "在"}, {"start": 1930.6, "end": 1932.6, "text": "棍棒大出"}, {"start": 1932.6, "end": 1934.6, "text": "走了吗"}, {"start": 1934.6, "end": 1936.6, "text": "张宋挨了丞相一顿赤马"}, {"start": 1936.6, "end": 1938.6, "text": "一回驿馆收拾行装"}, {"start": 1938.6, "end": 1940.6, "text": "出南门走了"}, {"start": 1940.6, "end": 1942.6, "text": "走得好"}, {"start": 1942.6, "end": 1944.6, "text": "该走的走了"}, {"start": 1944.6, "end": 1950.7, "text": "该来的才能来"}, {"start": 1950.7, "end": 1952.7, "text": "丞相 究竟为何折辱张宋"}, {"start": 1952.7, "end": 1954.7, "text": "在下真是不明白"}, {"start": 1956.7, "end": 1958.7, "text": "如果连你都不明白"}, {"start": 1958.7, "end": 1960.7, "text": "那这个计策就可以成功了"}, {"start": 1962.7, "end": 1964.7, "text": "你想想 马超战败"}, {"start": 1964.7, "end": 1966.7, "text": "投奔汉中张鲁"}, {"start": 1966.7, "end": 1968.7, "text": "张鲁"}, {"start": 1968.7, "end": 1970.7, "text": "要想保住汉中"}, {"start": 1970.7, "end": 1972.7, "text": "只有两条路"}, {"start": 1972.7, "end": 1974.7, "text": "一是归降我"}, {"start": 1974.7, "end": 1976.7, "text": "二是屠取西川"}, {"start": 1976.7, "end": 1978.7, "text": "眼下"}, {"start": 1978.7, "end": 1980.7, "text": "张鲁已经收留了马超"}, {"start": 1980.7, "end": 1982.7, "text": "自然不会归降我"}, {"start": 1982.7, "end": 1984.7, "text": "那么 他只有"}, {"start": 1984.7, "end": 1986.7, "text": "屠取西川"}, {"start": 1986.7, "end": 1988.7, "text": "一周流章"}, {"start": 1988.7, "end": 1990.7, "text": "多年不向朝廷朝共"}, {"start": 1990.7, "end": 1992.7, "text": "这个时候 突然派别驾来朝共"}, {"start": 1992.7, "end": 1994.7, "text": "其用心"}, {"start": 1994.7, "end": 1998.3, "text": "难道还不明显吗"}, {"start": 2000.3, "end": 2002.3, "text": "定是流章 畏惧张鲁"}, {"start": 2002.3, "end": 2004.3, "text": "又恐马超攻取西川"}, {"start": 2004.3, "end": 2006.3, "text": "所以派张松"}, {"start": 2006.3, "end": 2008.3, "text": "请来请丞相"}, {"start": 2008.3, "end": 2010.3, "text": "出兵打张鲁 以求自保"}, {"start": 2010.3, "end": 2012.3, "text": "我既不能答应他"}, {"start": 2012.3, "end": 2014.3, "text": "也不能拒绝他"}, {"start": 2014.3, "end": 2016.3, "text": "左右为难 所以只能"}, {"start": 2016.3, "end": 2018.3, "text": "把他骑走"}, {"start": 2018.3, "end": 2020.3, "text": "那丞相"}, {"start": 2020.3, "end": 2022.3, "text": "为何不答应呢"}, {"start": 2022.3, "end": 2024.3, "text": "何不和西川结盟"}, {"start": 2024.3, "end": 2026.3, "text": "夹攻汉中"}, {"start": 2026.3, "end": 2028.3, "text": "这样既可得汉中之地"}, {"start": 2028.3, "end": 2030.3, "text": "又可跟除肃敌马超"}, {"start": 2030.3, "end": 2032.3, "text": "岂不妙哉"}, {"start": 2032.3, "end": 2034.3, "text": "我们已经定下了基本方略"}, {"start": 2034.3, "end": 2036.3, "text": "要休战数年"}, {"start": 2036.3, "end": 2038.3, "text": "再行进取"}, {"start": 2038.3, "end": 2040.3, "text": "常言道"}, {"start": 2040.3, "end": 2043.86, "text": "杀敌一万 自损八千"}, {"start": 2043.86, "end": 2045.86, "text": "以我们目前的实力"}, {"start": 2045.86, "end": 2047.86, "text": "如果倾尽全力"}, {"start": 2047.86, "end": 2049.86, "text": "也能攻下汉中"}, {"start": 2049.86, "end": 2051.86, "text": "但是"}, {"start": 2051.86, "end": 2053.86, "text": "如果孙权和刘备"}, {"start": 2053.86, "end": 2055.86, "text": "此事来犯"}, {"start": 2055.86, "end": 2057.86, "text": "则许昌危宜"}, {"start": 2057.86, "end": 2059.86, "text": "所以我们还是休战待机的好啊"}, {"start": 2059.86, "end": 2061.86, "text": "再说了"}, {"start": 2061.86, "end": 2063.86, "text": "大计方略"}, {"start": 2063.86, "end": 2065.86, "text": "如果定下了"}, {"start": 2065.86, "end": 2067.86, "text": "就不能轻易变动"}, {"start": 2069.86, "end": 2071.86, "text": "丞相是不愿战"}, {"start": 2071.86, "end": 2073.86, "text": "但又不能让他看出不能战"}, {"start": 2073.86, "end": 2075.86, "text": "所以精兵操练"}, {"start": 2075.86, "end": 2077.86, "text": "展示军威"}, {"start": 2077.86, "end": 2079.86, "text": "震慑他"}, {"start": 2079.86, "end": 2081.86, "text": "面目可赠"}, {"start": 2081.86, "end": 2083.86, "text": "心术不端"}, {"start": 2083.86, "end": 2085.86, "text": "卖弄才华"}, {"start": 2085.86, "end": 2087.86, "text": "待嫁而故"}, {"start": 2089.86, "end": 2091.86, "text": "我不喜欢"}, {"start": 2113.98, "end": 2115.98, "text": "回益州应该是往西啊"}, {"start": 2115.98, "end": 2117.98, "text": "大人为何一直往东望啊"}, {"start": 2117.98, "end": 2119.98, "text": "我在主公面前"}, {"start": 2119.98, "end": 2121.98, "text": "夸下海口"}, {"start": 2121.98, "end": 2123.98, "text": "要让曹操兴必武功取汉"}, {"start": 2123.98, "end": 2125.98, "text": "如今"}, {"start": 2125.98, "end": 2127.98, "text": "走而归必将"}, {"start": 2127.98, "end": 2129.98, "text": "为川蜀管理取孝"}, {"start": 2129.98, "end": 2131.98, "text": "更无颜见中木马"}, {"start": 2131.98, "end": 2133.98, "text": "我本预见"}, {"start": 2133.98, "end": 2135.98, "text": "西川与曹操却不了"}, {"start": 2135.98, "end": 2137.98, "text": "此人心血如此狭隘"}, {"start": 2137.98, "end": 2139.98, "text": "曹操交进如此"}, {"start": 2139.98, "end": 2141.98, "text": "连相府侍卫都向小的"}, {"start": 2141.98, "end": 2143.98, "text": "索取贿赂"}, {"start": 2143.98, "end": 2145.98, "text": "这样的主子还配做丞相吗"}, {"start": 2145.98, "end": 2147.98, "text": "即使做了也做不长久"}, {"start": 2147.98, "end": 2149.98, "text": "大人"}, {"start": 2149.98, "end": 2154.98, "text": "咱们还是回益州吧"}, {"start": 2154.98, "end": 2158.84, "text": "到什么地方啊"}, {"start": 2158.84, "end": 2162.54, "text": "到云州地界啊"}, {"start": 2162.54, "end": 2166.01, "text": "那就以刘备的地位"}, {"start": 2166.01, "end": 2168.01, "text": "你们可要小心些了"}, {"start": 2168.01, "end": 2170.01, "text": "且不可暴露身份"}, {"start": 2170.01, "end": 2172.01, "text": "如果遭遇了荆州军马"}, {"start": 2172.01, "end": 2174.01, "text": "您就说是"}, {"start": 2174.01, "end": 2176.01, "text": "穿中可上"}, {"start": 2176.01, "end": 2178.01, "text": "大人为何这样谨慎"}, {"start": 2178.01, "end": 2180.01, "text": "主公与刘备"}, {"start": 2180.01, "end": 2182.01, "text": "同为皇室血脉"}, {"start": 2182.01, "end": 2184.01, "text": "我们起刘备不才"}, {"start": 2184.01, "end": 2186.01, "text": "却去向汉贼"}, {"start": 2186.01, "end": 2188.01, "text": "曹操去救救"}, {"start": 2188.01, "end": 2191.67, "text": "刘备知道了"}, {"start": 2191.67, "end": 2193.67, "text": "一定会对我们生出记恨来的"}, {"start": 2201.18, "end": 2203.18, "text": "益州别将这份风度"}, {"start": 2203.18, "end": 2205.18, "text": "可不像穿中的商客啊"}, {"start": 2213.18, "end": 2215.18, "text": "敢问足下是"}, {"start": 2215.18, "end": 2217.18, "text": "在下庞统"}, {"start": 2217.18, "end": 2219.18, "text": "自侍员"}, {"start": 2219.18, "end": 2221.18, "text": "好奉厨"}, {"start": 2221.18, "end": 2223.18, "text": "我给你介绍一下"}, {"start": 2223.18, "end": 2225.18, "text": "那位呢"}, {"start": 2225.18, "end": 2227.18, "text": "是荆州将军关云长"}, {"start": 2227.18, "end": 2229.18, "text": "那位是"}, {"start": 2229.18, "end": 2231.18, "text": "南郡将军张义德"}, {"start": 2233.18, "end": 2236.46, "text": "天哪 他们这是"}, {"start": 2236.46, "end": 2238.46, "text": "我等奉"}, {"start": 2238.46, "end": 2240.46, "text": "刘皇叔之命"}, {"start": 2240.46, "end": 2242.46, "text": "在这已经等候张大人"}, {"start": 2242.46, "end": 2244.46, "text": "多时了"}, {"start": 2244.46, "end": 2246.46, "text": "我"}, {"start": 2246.46, "end": 2248.46, "text": "不是张总"}, {"start": 2248.46, "end": 2250.46, "text": "在下姓庄"}, {"start": 2250.46, "end": 2252.46, "text": "是穿中客商"}, {"start": 2258.46, "end": 2260.46, "text": "永年兄"}, {"start": 2260.46, "end": 2262.46, "text": "不要再装了"}, {"start": 2262.46, "end": 2264.46, "text": "你赴喜昌朝贡的事"}, {"start": 2264.46, "end": 2266.46, "text": "我家主公早就知道了"}, {"start": 2266.46, "end": 2268.46, "text": "特令他的二弟三弟"}, {"start": 2268.46, "end": 2270.46, "text": "还有在下"}, {"start": 2270.46, "end": 2272.46, "text": "长驱三百多里"}, {"start": 2272.46, "end": 2274.46, "text": "在此相迎"}, {"start": 2274.46, "end": 2276.46, "text": "永年兄"}, {"start": 2276.46, "end": 2280.95, "text": "跟我们走吧"}, {"start": 2280.95, "end": 2282.95, "text": "皇叔"}, {"start": 2282.95, "end": 2284.95, "text": "急我作甚"}, {"start": 2284.95, "end": 2286.95, "text": "曹操不能"}, {"start": 2286.95, "end": 2288.95, "text": "近在主人椅"}, {"start": 2288.95, "end": 2290.95, "text": "我家主公可是个"}, {"start": 2290.95, "end": 2292.95, "text": "好客的贤君啊"}, {"start": 2292.95, "end": 2294.95, "text": "永年兄"}, {"start": 2294.95, "end": 2296.95, "text": "快快请吧"}, {"start": 2296.95, "end": 2298.95, "text": "请先生上车"}, {"start": 2298.95, "end": 2300.95, "text": "请先生上车"}, {"start": 2300.95, "end": 2302.95, "text": "请"}, {"start": 2302.95, "end": 2362.46, "text": "慕刘备恭候张大人"}, {"start": 2362.46, "end": 2378.92, "text": "干劳皇叔相迎"}, {"start": 2378.92, "end": 2380.92, "text": "如此"}, {"start": 2380.92, "end": 2382.92, "text": "自龙中长景"}, {"start": 2382.92, "end": 2384.92, "text": "张宋平生未见哪"}, {"start": 2384.92, "end": 2386.92, "text": "刘备久闻"}, {"start": 2386.92, "end": 2388.92, "text": "永年大名如雷贯耳"}, {"start": 2388.92, "end": 2390.92, "text": "恨云山遥远"}, {"start": 2390.92, "end": 2392.92, "text": "不得听教"}, {"start": 2392.92, "end": 2394.92, "text": "近闻先生回川"}, {"start": 2394.92, "end": 2396.92, "text": "特令云长亦得前去相迎"}, {"start": 2396.92, "end": 2398.92, "text": "如有冒昧之处"}, {"start": 2398.92, "end": 2400.92, "text": "还请先生宽容"}, {"start": 2400.92, "end": 2402.92, "text": "请先生暂入荒州小些"}, {"start": 2402.92, "end": 2404.92, "text": "以续可养之思"}, {"start": 2404.92, "end": 2406.92, "text": "刘备实为万幸"}, {"start": 2406.92, "end": 2408.92, "text": "皇叔如此热情"}, {"start": 2408.92, "end": 2410.92, "text": "令在下万分感激"}, {"start": 2412.92, "end": 2414.92, "text": "但这迎賓之礼"}, {"start": 2414.92, "end": 2416.92, "text": "近乎国礼"}, {"start": 2416.92, "end": 2418.92, "text": "在下当不起"}, {"start": 2418.92, "end": 2420.92, "text": "先生乃国事业"}, {"start": 2420.92, "end": 2427.69, "text": "何不能以国礼相迎"}, {"start": 2427.69, "end": 2429.69, "text": "贵主公刘继玉"}, {"start": 2429.69, "end": 2431.69, "text": "乃吾皇兄"}, {"start": 2431.69, "end": 2433.69, "text": "我今日见先生"}, {"start": 2433.69, "end": 2435.69, "text": "有如见益州刘皇兄"}, {"start": 2435.69, "end": 2437.69, "text": "请"}, {"start": 2437.69, "end": 2441.29, "text": "皇叔请"}, {"start": 2441.29, "end": 2443.29, "text": "其志是"}, {"start": 2443.29, "end": 2454.6, "text": "这是赤壁大战中"}, {"start": 2454.6, "end": 2456.6, "text": "我与曹操交战时"}, {"start": 2456.6, "end": 2458.6, "text": "所搅和的"}, {"start": 2458.6, "end": 2462.6, "text": "我脚下是曹操的帅气"}, {"start": 2462.6, "end": 2464.6, "text": "曹人的将气"}, {"start": 2464.6, "end": 2466.6, "text": "张辽的令气"}, {"start": 2466.6, "end": 2468.6, "text": "徐楚的英雄"}, {"start": 2468.6, "end": 2472.14, "text": "永年兄"}, {"start": 2472.14, "end": 2474.14, "text": "若非我二弟手下留情"}, {"start": 2474.14, "end": 2476.14, "text": "那曹操早就成为"}, {"start": 2476.14, "end": 2478.14, "text": "我的阶下酒了"}, {"start": 2478.14, "end": 2480.14, "text": "今日我用曹操这些"}, {"start": 2480.14, "end": 2482.14, "text": "来为国事殿祖"}, {"start": 2482.14, "end": 2484.14, "text": "踏棋入城"}, {"start": 2484.14, "end": 2486.14, "text": "再何事不过了"}, {"start": 2486.14, "end": 2488.14, "text": "我原以为曹操"}, {"start": 2488.14, "end": 2490.14, "text": "是天下雄主"}, {"start": 2490.14, "end": 2492.14, "text": "今日才知"}, {"start": 2492.14, "end": 2494.14, "text": "皇叔才是"}, {"start": 2494.14, "end": 2496.14, "text": "盖世英雄"}, {"start": 2496.14, "end": 2498.14, "text": "皇叔兵奉所向"}, {"start": 2498.14, "end": 2500.14, "text": "曹贼束手"}, {"start": 2500.14, "end": 2502.14, "text": "大汗天下"}, {"start": 2502.14, "end": 2504.14, "text": "早晚必归皇叔"}, {"start": 2504.14, "end": 2506.14, "text": "先生言过了"}, {"start": 2506.14, "end": 2508.14, "text": "刘备岂敢"}, {"start": 2508.14, "end": 2521.66, "text": "先生请"}, {"start": 2521.66, "end": 2523.66, "text": "永年啊"}, {"start": 2523.66, "end": 2525.66, "text": "你肝胆照人 忠义千秋"}, {"start": 2525.66, "end": 2527.66, "text": "我敬你一杯"}, {"start": 2527.66, "end": 2536.34, "text": "来 干"}, {"start": 2536.34, "end": 2538.34, "text": "张大人 我也敬你一杯"}, {"start": 2540.34, "end": 2542.34, "text": "来"}, {"start": 2542.34, "end": 2547.8, "text": "干"}, {"start": 2547.8, "end": 2549.8, "text": "咱家最佩服的"}, {"start": 2549.8, "end": 2551.8, "text": "就是像张大人这样的人"}, {"start": 2551.8, "end": 2553.8, "text": "来 我敬先生一杯"}, {"start": 2553.8, "end": 2555.8, "text": "先生饮一杯"}, {"start": 2555.8, "end": 2557.8, "text": "咱家饮三杯"}, {"start": 2557.8, "end": 2559.8, "text": "干了"}, {"start": 2559.8, "end": 2561.8, "text": "张将军"}, {"start": 2561.8, "end": 2563.8, "text": "在下不胜酒力"}, {"start": 2563.8, "end": 2565.8, "text": "喝醉了"}, {"start": 2567.8, "end": 2571.8, "text": "莫非先生瞧不起我这个粗人呢"}, {"start": 2571.8, "end": 2573.8, "text": "哪里哪里"}, {"start": 2573.8, "end": 2575.8, "text": "我真是喝醉了"}, {"start": 2575.8, "end": 2577.8, "text": "先生连曹操都不惧"}, {"start": 2579.8, "end": 2581.8, "text": "何惧这杯酒呢"}, {"start": 2581.8, "end": 2583.8, "text": "来 干"}, {"start": 2583.8, "end": 2585.8, "text": "好 好 好"}, {"start": 2585.8, "end": 2587.8, "text": "干"}, {"start": 2587.8, "end": 2589.8, "text": "干"}]