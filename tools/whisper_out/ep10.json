[{"start": 1.3, "end": 5.79, "text": "老爷回来了。"}, {"start": 5.79, "end": 10.66, "text": "老爷回来了。"}, {"start": 10.66, "end": 11.66, "text": "主公回来了。"}, {"start": 11.66, "end": 13.66, "text": "主公今日为何如此高兴啊?"}, {"start": 13.66, "end": 15.66, "text": "温酒上菜。"}, {"start": 15.66, "end": 17.66, "text": "我要痛饮一番啊。"}, {"start": 17.66, "end": 19.66, "text": "主公,酒菜已经摆上了。"}, {"start": 19.66, "end": 21.66, "text": "怎么?"}, {"start": 21.66, "end": 23.66, "text": "回主公,"}, {"start": 23.66, "end": 26.66, "text": "半个时辰以前来了个远道的客人。"}, {"start": 26.66, "end": 28.66, "text": "自称是主公的老友,"}, {"start": 28.66, "end": 31.66, "text": "吩咐在下温酒上菜。"}, {"start": 31.66, "end": 33.66, "text": "他是何人?"}, {"start": 33.66, "end": 35.66, "text": "姓甚名谁?"}, {"start": 35.66, "end": 37.66, "text": "此人不肯到处姓苗。"}, {"start": 37.66, "end": 39.66, "text": "在下不知虚实,"}, {"start": 39.66, "end": 41.66, "text": "也不敢得罪他。"}, {"start": 41.66, "end": 45.66, "text": "现在,此人大概已经犯罪了。"}, {"start": 45.66, "end": 62.64, "text": "阁下何人?"}, {"start": 62.64, "end": 65.64, "text": "董相国祸乱长安城,"}, {"start": 65.64, "end": 68.64, "text": "王司徒暗设连环计。"}, {"start": 76.05, "end": 78.05, "text": "臣攻台。"}, {"start": 79.05, "end": 82.39, "text": "此计毫不恶毒啊。"}, {"start": 82.39, "end": 86.39, "text": "司徒大人就不怕引发灭族大祸啊。"}, {"start": 86.39, "end": 89.39, "text": "你刚才吓死我了。"}, {"start": 89.39, "end": 91.39, "text": "熊台玉酒天下,"}, {"start": 91.39, "end": 92.39, "text": "功垂万古。"}, {"start": 92.39, "end": 94.39, "text": "在下深表敬佩。"}, {"start": 94.39, "end": 96.39, "text": "哪里?哪里?"}, {"start": 96.39, "end": 98.39, "text": "贤弟,请。"}, {"start": 98.39, "end": 100.39, "text": "请。"}, {"start": 100.39, "end": 110.62, "text": "乱世遇故人,"}, {"start": 110.62, "end": 112.62, "text": "真是喜从天降啊。"}, {"start": 113.62, "end": 115.62, "text": "我听人说,"}, {"start": 115.62, "end": 117.62, "text": "你投奔曹孟德,"}, {"start": 117.62, "end": 119.62, "text": "共乡大义,"}, {"start": 119.62, "end": 121.62, "text": "怎么跑到长安来了?"}, {"start": 121.62, "end": 127.04, "text": "那曹阿满,"}, {"start": 127.04, "end": 129.04, "text": "表面上中意,"}, {"start": 129.04, "end": 131.04, "text": "其实是个奸险之辈。"}, {"start": 133.04, "end": 136.04, "text": "我已经弃他而去了。"}, {"start": 136.04, "end": 138.04, "text": "为何?"}, {"start": 138.04, "end": 141.64, "text": "说来话长啊。"}, {"start": 141.64, "end": 143.64, "text": "离开曹操之后,"}, {"start": 143.64, "end": 145.64, "text": "我是浪迹四方,"}, {"start": 145.64, "end": 147.64, "text": "寻找能让我辅佐的"}, {"start": 147.64, "end": 149.64, "text": "贤民主公。"}, {"start": 150.64, "end": 152.64, "text": "但是数月下来,"}, {"start": 152.64, "end": 154.64, "text": "除了仗下奸雄,"}, {"start": 154.64, "end": 156.64, "text": "与路边海谷之外,"}, {"start": 156.64, "end": 158.64, "text": "我是一无所获。"}, {"start": 158.64, "end": 162.27, "text": "无奈之中,"}, {"start": 162.27, "end": 164.27, "text": "我又来到了长安城,"}, {"start": 164.27, "end": 166.27, "text": "可是刚到长安,"}, {"start": 166.27, "end": 168.27, "text": "我就在酒馆里,"}, {"start": 168.27, "end": 170.27, "text": "听人议论,"}, {"start": 170.27, "end": 172.27, "text": "说什么董卓和吕布,"}, {"start": 172.27, "end": 174.27, "text": "在争一个美女,"}, {"start": 174.27, "end": 176.27, "text": "名字叫什么,"}, {"start": 176.27, "end": 179.62, "text": "貂蝉。"}, {"start": 179.62, "end": 181.62, "text": "我一想,"}, {"start": 181.62, "end": 183.62, "text": "这貂蝉不是阁下的义女吗?"}, {"start": 187.62, "end": 189.62, "text": "吕律师啊,"}, {"start": 189.62, "end": 191.62, "text": "我什么都明白了。"}, {"start": 193.62, "end": 195.62, "text": "我什么都瞒不住贤弟你啊。"}, {"start": 195.62, "end": 197.62, "text": "你一眼就看破了乾坤啊。"}, {"start": 199.62, "end": 201.62, "text": "兄弟,"}, {"start": 201.62, "end": 203.62, "text": "事情进展如何?"}, {"start": 205.62, "end": 207.62, "text": "大局已定。"}, {"start": 207.62, "end": 209.62, "text": "只等他们二人"}, {"start": 209.62, "end": 211.62, "text": "反目成仇,"}, {"start": 211.62, "end": 213.62, "text": "互相拼杀。"}, {"start": 213.62, "end": 215.62, "text": "下一步,"}, {"start": 215.62, "end": 217.62, "text": "兄太相怎么办?"}, {"start": 217.62, "end": 219.62, "text": "正想,"}, {"start": 219.62, "end": 222.96, "text": "向贤弟请教啊。"}, {"start": 222.96, "end": 226.56, "text": "在下想,"}, {"start": 226.56, "end": 228.56, "text": "要除掉董贼,"}, {"start": 228.56, "end": 230.56, "text": "关键。"}, {"start": 230.56, "end": 238.74, "text": "外面何人?"}, {"start": 238.74, "end": 242.82, "text": "将军!"}, {"start": 242.82, "end": 244.82, "text": "义父!"}, {"start": 244.82, "end": 246.82, "text": "我家主公还没回来呢!"}, {"start": 246.82, "end": 248.82, "text": "义父!"}, {"start": 248.82, "end": 250.82, "text": "将军!"}, {"start": 250.82, "end": 252.82, "text": "义父!"}, {"start": 252.82, "end": 254.82, "text": "奉宣啊,"}, {"start": 254.82, "end": 256.82, "text": "老夫已经备好了美酒佳肴,"}, {"start": 256.82, "end": 258.82, "text": "就等你入席了。"}, {"start": 258.82, "end": 260.82, "text": "义父!"}, {"start": 260.82, "end": 262.82, "text": "不必多言,请。"}, {"start": 262.82, "end": 270.29, "text": "义父大人,"}, {"start": 270.29, "end": 272.29, "text": "小智大火临头了。"}, {"start": 272.29, "end": 274.29, "text": "未必。"}, {"start": 274.29, "end": 276.29, "text": "你不知道,"}, {"start": 276.29, "end": 278.29, "text": "奉义庭的事,"}, {"start": 278.29, "end": 280.29, "text": "董卓他是不会宽恕我的。"}, {"start": 280.29, "end": 282.29, "text": "我真不知道该怎么办。"}, {"start": 282.29, "end": 284.29, "text": "请义父,"}, {"start": 284.29, "end": 286.29, "text": "出个主意吧。"}, {"start": 286.29, "end": 288.29, "text": "哎呀,"}, {"start": 288.29, "end": 290.29, "text": "我是万万没有想到啊。"}, {"start": 290.29, "end": 292.29, "text": "这世间第一英雄"}, {"start": 292.29, "end": 294.29, "text": "吕奉先,"}, {"start": 294.29, "end": 296.29, "text": "竟也如此不堪啊。"}, {"start": 296.29, "end": 298.29, "text": "吕布啊,吕布。"}, {"start": 298.29, "end": 300.29, "text": "莫非你自己都不知道"}, {"start": 300.29, "end": 302.29, "text": "自己有多大的本事吗?"}, {"start": 302.29, "end": 304.29, "text": "依我看,"}, {"start": 304.29, "end": 306.29, "text": "你根本不用害怕董卓。"}, {"start": 306.29, "end": 308.29, "text": "相反,那董卓"}, {"start": 308.29, "end": 310.29, "text": "更应该害怕你才对。"}, {"start": 310.29, "end": 312.29, "text": "女士,"}, {"start": 312.29, "end": 314.29, "text": "这是我的老朋友,"}, {"start": 314.29, "end": 316.29, "text": "成功。"}, {"start": 316.29, "end": 318.29, "text": "自公台,"}, {"start": 318.29, "end": 320.29, "text": "他上知天文,"}, {"start": 320.29, "end": 322.29, "text": "下晓地理,"}, {"start": 322.29, "end": 324.29, "text": "薄览古今,"}, {"start": 324.29, "end": 326.29, "text": "胸怀韬略。"}, {"start": 326.29, "end": 328.29, "text": "奉先,若得"}, {"start": 328.29, "end": 330.29, "text": "公台相助,"}, {"start": 330.29, "end": 332.29, "text": "必能成就一番大业。"}, {"start": 332.29, "end": 336.85, "text": "请公台先生教我。"}, {"start": 336.85, "end": 338.85, "text": "将军,"}, {"start": 338.85, "end": 340.85, "text": "世人皆知,"}, {"start": 340.85, "end": 342.85, "text": "人中吕布,马中石土。"}, {"start": 342.85, "end": 344.85, "text": "加上你一杆,"}, {"start": 344.85, "end": 346.85, "text": "方天化际,"}, {"start": 346.85, "end": 348.85, "text": "将军足可以无敌于天下。"}, {"start": 350.85, "end": 352.85, "text": "但是不知,"}, {"start": 352.85, "end": 354.85, "text": "将军有无但略而已啊。"}, {"start": 354.85, "end": 358.51, "text": "将军啊,"}, {"start": 358.51, "end": 360.51, "text": "那董卓,"}, {"start": 360.51, "end": 362.51, "text": "隐我之女,"}, {"start": 362.51, "end": 364.51, "text": "夺将军之妻,"}, {"start": 364.51, "end": 366.51, "text": "兴秦寿之事,"}, {"start": 366.51, "end": 368.51, "text": "令天下人"}, {"start": 368.51, "end": 374.42, "text": "欠使之恨哪。"}, {"start": 374.42, "end": 376.42, "text": "如今老矣,"}, {"start": 376.42, "end": 378.42, "text": "不足为道。"}, {"start": 378.42, "end": 380.42, "text": "将军,你"}, {"start": 380.42, "end": 382.42, "text": "是英雄豪杰,"}, {"start": 382.42, "end": 384.42, "text": "岂能受此"}, {"start": 384.42, "end": 386.42, "text": "奇耻大辱啊。"}, {"start": 386.42, "end": 388.42, "text": "将军,"}, {"start": 388.42, "end": 390.42, "text": "将军,"}, {"start": 390.42, "end": 392.42, "text": "董卓他欺君篡位,"}, {"start": 392.42, "end": 394.42, "text": "祸乱朝纲。"}, {"start": 394.42, "end": 396.42, "text": "堪称是我们大汉四百年来"}, {"start": 396.42, "end": 398.42, "text": "从未有过的巨贼。"}, {"start": 398.42, "end": 400.42, "text": "如果将军"}, {"start": 400.42, "end": 402.42, "text": "你能够将他除掉,"}, {"start": 402.42, "end": 404.42, "text": "不但可以为你自己"}, {"start": 404.42, "end": 406.42, "text": "证明血耻,"}, {"start": 406.42, "end": 408.42, "text": "更可为我们大汉"}, {"start": 408.42, "end": 410.42, "text": "创建四百年来"}, {"start": 410.42, "end": 412.42, "text": "从未有过的工序。"}, {"start": 412.42, "end": 414.42, "text": "老夫夜观天下,"}, {"start": 414.42, "end": 416.42, "text": "只见紫薇星入,"}, {"start": 416.42, "end": 418.42, "text": "有意贼星陨落,"}, {"start": 418.42, "end": 420.42, "text": "证应了董卓"}, {"start": 420.42, "end": 423.82, "text": "气数已尽,"}, {"start": 423.82, "end": 425.82, "text": "活不了多久了。"}, {"start": 425.82, "end": 427.82, "text": "不瞒二位,"}, {"start": 427.82, "end": 429.82, "text": "凭我手中方天话计,"}, {"start": 429.82, "end": 431.82, "text": "要诛杀董卓"}, {"start": 431.82, "end": 435.71, "text": "如徒诛狗,"}, {"start": 435.71, "end": 437.71, "text": "只担心他是我义父,"}, {"start": 437.71, "end": 439.71, "text": "我怕世人会说我"}, {"start": 439.71, "end": 441.71, "text": "是不是君啊。"}, {"start": 441.71, "end": 444.96, "text": "董卓他姓董,"}, {"start": 444.96, "end": 446.96, "text": "吕将军姓吕,"}, {"start": 446.96, "end": 448.96, "text": "这何谓父子啊?"}, {"start": 448.96, "end": 450.96, "text": "再说了,"}, {"start": 450.96, "end": 452.96, "text": "他董卓知己追杀你的时候,"}, {"start": 452.96, "end": 454.96, "text": "哪里有一丝一毫"}, {"start": 454.96, "end": 456.96, "text": "的父子之情啊?"}, {"start": 456.96, "end": 461.26, "text": "小女貂蝉,"}, {"start": 461.26, "end": 463.26, "text": "身陷魔窟,"}, {"start": 463.26, "end": 465.26, "text": "日夜思念着将军。"}, {"start": 465.26, "end": 467.26, "text": "将军如若"}, {"start": 467.26, "end": 469.26, "text": "能除此巨贼,"}, {"start": 469.26, "end": 471.26, "text": "不但为大汉建功,"}, {"start": 473.26, "end": 475.26, "text": "而且可以和貂蝉"}, {"start": 475.26, "end": 477.26, "text": "终生幸福啊,"}, {"start": 477.26, "end": 479.26, "text": "这于公于私,"}, {"start": 479.26, "end": 481.26, "text": "都是功德无量的事。"}, {"start": 481.26, "end": 483.26, "text": "二位直言吧,"}, {"start": 483.26, "end": 489.97, "text": "我该怎么做?"}, {"start": 489.97, "end": 496.22, "text": "天子诏书,"}, {"start": 496.22, "end": 498.22, "text": "诛杀董贼。"}, {"start": 498.22, "end": 500.22, "text": "相国,"}, {"start": 500.22, "end": 515.28, "text": "相国,"}, {"start": 515.28, "end": 517.28, "text": "相国,"}, {"start": 517.28, "end": 519.28, "text": "大喜事,"}, {"start": 519.28, "end": 521.28, "text": "大喜事啊。"}, {"start": 523.28, "end": 525.28, "text": "什么事啊?"}, {"start": 525.28, "end": 527.28, "text": "禀相国,"}, {"start": 527.28, "end": 529.28, "text": "臣刚刚奉诏进宫,"}, {"start": 529.28, "end": 531.28, "text": "在后宫见过太后。"}, {"start": 531.28, "end": 533.28, "text": "太后亲口对臣说,"}, {"start": 533.28, "end": 535.28, "text": "天子缠弱,龙体多病,"}, {"start": 535.28, "end": 537.28, "text": "实在不堪作炒了。"}, {"start": 537.28, "end": 539.28, "text": "时下朝野纷乱,"}, {"start": 539.28, "end": 541.28, "text": "唯有相国才能治理天下。"}, {"start": 541.28, "end": 543.28, "text": "因此,太后决定"}, {"start": 543.28, "end": 545.28, "text": "让天子上位给相国,"}, {"start": 545.28, "end": 547.28, "text": "恭请相国加尊九五,"}, {"start": 547.28, "end": 549.28, "text": "改朝称帝。"}, {"start": 549.28, "end": 553.97, "text": "是吗?"}, {"start": 553.97, "end": 555.97, "text": "正是。"}, {"start": 555.97, "end": 557.97, "text": "太后真的肯让天子退位了?"}, {"start": 557.97, "end": 559.97, "text": "正是。"}, {"start": 559.97, "end": 564.05, "text": "不过,"}, {"start": 564.05, "end": 566.05, "text": "她唯一的条件就是,"}, {"start": 566.05, "end": 568.05, "text": "请相国善待他们"}, {"start": 568.05, "end": 570.05, "text": "孤儿寡母,"}, {"start": 570.05, "end": 572.05, "text": "保证她和天子一辈子"}, {"start": 572.05, "end": 574.05, "text": "衣食无虞。"}, {"start": 574.05, "end": 576.05, "text": "那好说啊,"}, {"start": 576.05, "end": 578.05, "text": "那太好说了。"}, {"start": 578.05, "end": 580.05, "text": "只要是"}, {"start": 580.05, "end": 582.05, "text": "她肯让天子退位,"}, {"start": 582.05, "end": 584.05, "text": "咱家可以赏她一个"}, {"start": 584.05, "end": 586.05, "text": "终生富贵。"}, {"start": 588.05, "end": 591.87, "text": "臣"}, {"start": 591.87, "end": 593.87, "text": "恭喜相国,"}, {"start": 593.87, "end": 595.87, "text": "不,"}, {"start": 595.87, "end": 597.87, "text": "臣恭喜陛下。"}, {"start": 603.87, "end": 608.82, "text": "不过,"}, {"start": 608.82, "end": 612.32, "text": "这件事情"}, {"start": 612.32, "end": 614.32, "text": "光是有这个太后"}, {"start": 614.32, "end": 616.32, "text": "的旨意,"}, {"start": 616.32, "end": 618.32, "text": "恐怕不行。"}, {"start": 618.32, "end": 620.32, "text": "那些百官们什么态度啊?"}, {"start": 620.32, "end": 622.32, "text": "还有王允那些个"}, {"start": 622.32, "end": 624.32, "text": "前朝的功行大臣们,"}, {"start": 624.32, "end": 626.32, "text": "他们会不会起奏太后,"}, {"start": 626.32, "end": 628.32, "text": "阻拦天子退位啊?"}, {"start": 628.32, "end": 630.32, "text": "太后亲口对臣说,"}, {"start": 630.32, "end": 632.32, "text": "由她出面,"}, {"start": 632.32, "end": 634.32, "text": "令王允亲自起草,"}, {"start": 634.32, "end": 636.32, "text": "退位诏书。"}, {"start": 636.32, "end": 640.21, "text": "禀相国,"}, {"start": 640.21, "end": 642.21, "text": "王允领着一干老臣,"}, {"start": 642.21, "end": 644.21, "text": "前来觐见。"}, {"start": 644.21, "end": 646.21, "text": "有请。"}, {"start": 650.26, "end": 676.22, "text": "王允等"}, {"start": 676.22, "end": 678.22, "text": "叩见陛下。"}, {"start": 678.22, "end": 680.22, "text": "叩见陛下。"}, {"start": 680.22, "end": 682.22, "text": "王允呢?"}, {"start": 682.22, "end": 684.22, "text": "咱家"}, {"start": 684.22, "end": 686.22, "text": "就是一个相国。"}, {"start": 686.22, "end": 688.22, "text": "你们为何要以陛下"}, {"start": 688.22, "end": 691.95, "text": "相称啊?"}, {"start": 691.95, "end": 693.95, "text": "臣等奉太后"}, {"start": 693.95, "end": 695.95, "text": "一旨,"}, {"start": 695.95, "end": 697.95, "text": "草拟了"}, {"start": 697.95, "end": 699.95, "text": "汉帝的退位诏书。"}, {"start": 699.95, "end": 701.95, "text": "恭请陛下"}, {"start": 701.95, "end": 703.95, "text": "以天下苍生"}, {"start": 703.95, "end": 705.95, "text": "为念,"}, {"start": 705.95, "end": 707.95, "text": "改元换代,"}, {"start": 707.95, "end": 709.95, "text": "及位久午。"}, {"start": 709.95, "end": 724.66, "text": "好。"}, {"start": 724.66, "end": 726.66, "text": "好好好。"}, {"start": 726.66, "end": 728.66, "text": "王允啊,"}, {"start": 728.66, "end": 730.66, "text": "你都替咱家"}, {"start": 730.66, "end": 732.66, "text": "把这国名"}, {"start": 732.66, "end": 734.66, "text": "和年号"}, {"start": 734.66, "end": 736.66, "text": "都已经弥好了。"}, {"start": 736.66, "end": 738.66, "text": "天意所致,"}, {"start": 738.66, "end": 740.66, "text": "万众归心。"}, {"start": 740.66, "end": 742.66, "text": "臣等顺应天意,"}, {"start": 742.66, "end": 744.66, "text": "愿为陛下"}, {"start": 744.66, "end": 746.66, "text": "效全马之劳。"}, {"start": 746.66, "end": 748.66, "text": "臣等顺应天意,"}, {"start": 748.66, "end": 750.66, "text": "恭请陛下"}, {"start": 750.66, "end": 754.1, "text": "起位。"}, {"start": 756.1, "end": 760.05, "text": "好好好。"}, {"start": 760.05, "end": 763.94, "text": "王允啊,"}, {"start": 763.94, "end": 765.94, "text": "我在这儿就多谢了。"}, {"start": 765.94, "end": 767.94, "text": "多谢了。"}, {"start": 767.94, "end": 769.94, "text": "将来"}, {"start": 769.94, "end": 771.94, "text": "我坐上了皇位以后,"}, {"start": 771.94, "end": 773.94, "text": "王允啊,"}, {"start": 773.94, "end": 775.94, "text": "我坐上了皇位以后,"}, {"start": 775.94, "end": 777.94, "text": "你们几位"}, {"start": 777.94, "end": 779.94, "text": "都是开国功臣。"}, {"start": 779.94, "end": 781.94, "text": "都是。"}, {"start": 781.94, "end": 783.94, "text": "好了,"}, {"start": 783.94, "end": 785.94, "text": "平身吧。"}, {"start": 785.94, "end": 810.46, "text": "谢陛下。"}, {"start": 810.46, "end": 812.46, "text": "奉先啊,"}, {"start": 812.46, "end": 823.74, "text": "你也来了。"}, {"start": 823.74, "end": 825.74, "text": "末将,"}, {"start": 825.74, "end": 831.07, "text": "前来向义父请罪。"}, {"start": 831.07, "end": 833.07, "text": "你知罪了?"}, {"start": 833.07, "end": 835.07, "text": "末将罪无可赦。"}, {"start": 835.07, "end": 837.07, "text": "请义父剥夺末将所有爵位,"}, {"start": 837.07, "end": 839.07, "text": "!..."}, {"start": 839.07, "end": 840.27, "text": "公衆"}, {"start": 840.27, "end": 847.45, "text": "已经安排 Depor"}, {"start": 847.45, "end": 848.45, "text": "崇 tube"}, {"start": 848.45, "end": 850.45, "text": "一"}, {"start": 850.45, "end": 852.45, "text": "咱家早就跟你说过了,"}, {"start": 852.45, "end": 854.45, "text": "咱家早晚要集大 Frank,"}, {"start": 854.45, "end": 861.73, "text": "崇 occupant,"}, {"start": 861.73, "end": 863.73, "text": "恭喜陛下"}, {"start": 863.73, "end": 865.73, "text": "好了,"}, {"start": 865.73, "end": 867.73, "text": "好了,"}, {"start": 867.73, "end": 869.73, "text": "奉先啊。"}, {"start": 869.73, "end": 871.73, "text": "奉席啊,"}, {"start": 871.73, "end": 872.85, "text": "终于咱家"}, {"start": 873.53, "end": 875.33, "text": "咱家仍然视你为子"}, {"start": 875.89, "end": 879.13, "text": "仍然是会让你位积人臣"}, {"start": 879.45, "end": 893.78, "text": "仍然会让你有想不完的荣华富贵"}, {"start": 894.14, "end": 896.58, "text": "儿臣拜谢父皇"}, {"start": 925.3, "end": 926.26, "text": "看到了吧"}, {"start": 927.86, "end": 930.86, "text": "这可是太后给咱家下的诏书"}, {"start": 931.3, "end": 935.06, "text": "后日午时咱家可要做皇上了"}, {"start": 935.3, "end": 937.1, "text": "你呢我的心肝"}, {"start": 937.62, "end": 940.26, "text": "你可就要做禅贵妃了"}, {"start": 945.49, "end": 946.17, "text": "给我看看"}, {"start": 947.17, "end": 948.09, "text": "看看"}, {"start": 948.85, "end": 950.29, "text": "看看可以"}, {"start": 950.41, "end": 952.65, "text": "到咱家的卧榻上来看吧"}, {"start": 959.11, "end": 960.23, "text": "快点来啊"}, {"start": 960.79, "end": 961.83, "text": "咱家等"}, {"start": 962.39, "end": 962.99, "text": "不"}, {"start": 963.71, "end": 966.19, "text": "是朕等你"}, {"start": 1025.11, "end": 1026.03, "text": "凤仙儿"}, {"start": 1028.75, "end": 1029.39, "text": "儿臣在"}, {"start": 1029.67, "end": 1031.79, "text": "你在想什么"}, {"start": 1033.86, "end": 1034.86, "text": "儿臣在想"}, {"start": 1035.98, "end": 1037.42, "text": "义父当上皇帝之后"}, {"start": 1037.82, "end": 1040.3, "text": "儿臣怎么帮义父剿灭各地乱贼"}, {"start": 1041.74, "end": 1042.3, "text": "对"}, {"start": 1044.34, "end": 1047.54, "text": "这个事你是得好好想想"}, {"start": 1049.43, "end": 1051.39, "text": "咱家继位以后嘛"}, {"start": 1052.39, "end": 1053.31, "text": "我想到了"}, {"start": 1053.87, "end": 1056.19, "text": "肯定有很多诸侯不服"}, {"start": 1056.71, "end": 1059.79, "text": "肯定他们要起兵闹事"}, {"start": 1059.87, "end": 1061.35, "text": "那个时候可是你"}, {"start": 1061.95, "end": 1063.55, "text": "建业的好机会"}, {"start": 1065.49, "end": 1066.29, "text": "儿臣明白"}, {"start": 1068.96, "end": 1070.8, "text": "今日祭天大礼"}, {"start": 1071.0, "end": 1073.12, "text": "着你左右护驾"}, {"start": 1074.32, "end": 1075.16, "text": "负责远离"}, {"start": 1077.22, "end": 1078.02, "text": "儿臣遵命"}, {"start": 1139.28, "end": 1140.56, "text": "爱卿们好"}, {"start": 1143.2, "end": 1146.71, "text": "爱卿们好啊"}, {"start": 1150.22, "end": 1154.58, "text": "这我怎么没见到王司统王大人呢"}, {"start": 1154.98, "end": 1155.86, "text": "听旨"}, {"start": 1167.62, "end": 1169.1, "text": "国贼董卓"}, {"start": 1169.46, "end": 1171.06, "text": "褻瀆朝纲"}, {"start": 1171.38, "end": 1172.9, "text": "祸乱天下"}, {"start": 1173.46, "end": 1175.58, "text": "召中勇之士"}, {"start": 1175.9, "end": 1178.54, "text": "诛杀逆贼董卓"}, {"start": 1179.82, "end": 1180.46, "text": "杀"}, {"start": 1180.7, "end": 1181.54, "text": "子恩旨"}, {"start": 1182.14, "end": 1218.54, "text": "只杀董卓一人"}, {"start": 1219.46, "end": 1220.54, "text": "余者不论"}, {"start": 1222.06, "end": 1223.74, "text": "你们快快放下兵器"}, {"start": 1224.74, "end": 1225.82, "text": "归顺圣上"}, {"start": 1232.18, "end": 1233.82, "text": "苍前啊"}, {"start": 1234.86, "end": 1235.98, "text": "先帝"}, {"start": 1236.38, "end": 1237.38, "text": "大汉"}, {"start": 1238.02, "end": 1239.94, "text": "有救了"}, {"start": 1240.46, "end": 1280.4, "text": "云锦奏"}, {"start": 1281.2, "end": 1282.72, "text": "国贼董卓"}, {"start": 1282.88, "end": 1284.8, "text": "已经在正阳宫门外"}, {"start": 1285.32, "end": 1286.28, "text": "服诸"}, {"start": 1287.16, "end": 1288.04, "text": "国大汉"}, {"start": 1288.28, "end": 1289.64, "text": "玉雨澄清"}, {"start": 1290.28, "end": 1291.0, "text": "天下"}, {"start": 1291.24, "end": 1293.52, "text": "万民欢信啊"}, {"start": 1294.36, "end": 1295.4, "text": "宣旨"}, {"start": 1303.94, "end": 1305.7, "text": "皇帝有旨"}, {"start": 1306.34, "end": 1307.78, "text": "册封王允"}, {"start": 1308.18, "end": 1310.18, "text": "为朝廷太师"}, {"start": 1310.46, "end": 1311.78, "text": "领相国"}, {"start": 1312.06, "end": 1313.78, "text": "涉国制政"}, {"start": 1314.42, "end": 1315.82, "text": "册封吕布"}, {"start": 1316.1, "end": 1317.66, "text": "为中义侯"}, {"start": 1317.9, "end": 1319.74, "text": "授奋威将军"}, {"start": 1319.94, "end": 1321.66, "text": "钦此"}, {"start": 1322.3, "end": 1324.3, "text": "臣领旨"}, {"start": 1326.14, "end": 1327.02, "text": "臣领旨"}, {"start": 1328.26, "end": 1329.34, "text": "叩谢天恩"}, {"start": 1329.62, "end": 1378.96, "text": "董老杰玷污国"}, {"start": 1379.84, "end": 1380.6, "text": "将军"}, {"start": 1381.84, "end": 1383.24, "text": "不会嫌弃我吗"}, {"start": 1385.07, "end": 1385.67, "text": "不"}, {"start": 1386.67, "end": 1387.95, "text": "吴卓的是我吕布"}, {"start": 1388.19, "end": 1399.7, "text": "她是天下最圣洁的女人"}, {"start": 1400.1, "end": 1402.5, "text": "如果没有你"}, {"start": 1402.5, "end": 1405.66, "text": "我岂不还在认贼做父王"}, {"start": 1405.9, "end": 1424.66, "text": "是你旧龙是我最爱的女人"}, {"start": 1424.66, "end": 1449.68, "text": "太师"}, {"start": 1450.44, "end": 1452.92, "text": "董卓部将李绝郭四二人"}, {"start": 1453.16, "end": 1454.6, "text": "已成惊弓之鸟"}, {"start": 1454.92, "end": 1456.08, "text": "愧退于边地"}, {"start": 1456.6, "end": 1458.32, "text": "他们畏惧太师之危"}, {"start": 1458.56, "end": 1459.56, "text": "吕布之勇"}, {"start": 1459.76, "end": 1461.24, "text": "不敢与朝廷相靠"}, {"start": 1461.44, "end": 1463.48, "text": "决定上表其相"}, {"start": 1464.0, "end": 1472.46, "text": "不成"}, {"start": 1472.9, "end": 1474.34, "text": "我谁都可以赦免"}, {"start": 1474.7, "end": 1475.66, "text": "唯独不赦"}, {"start": 1475.66, "end": 1476.62, "text": "谁都不赦"}, {"start": 1476.62, "end": 1478.3, "text": "李绝郭四二贼"}, {"start": 1478.74, "end": 1479.82, "text": "这两个人"}, {"start": 1480.5, "end": 1482.62, "text": "实在是太可恨了"}, {"start": 1483.62, "end": 1485.38, "text": "杀了我多少成功"}, {"start": 1486.46, "end": 1488.02, "text": "董卓的恶行"}, {"start": 1488.02, "end": 1490.82, "text": "大半是这两个人做下的"}, {"start": 1491.54, "end": 1492.3, "text": "不赦"}, {"start": 1493.26, "end": 1493.9, "text": "太师"}, {"start": 1494.5, "end": 1495.94, "text": "还望以大局为面"}, {"start": 1496.3, "end": 1497.86, "text": "不可拒于一时一分"}, {"start": 1498.22, "end": 1499.42, "text": "董卓虽然已死"}, {"start": 1499.62, "end": 1500.58, "text": "李国二人"}, {"start": 1500.58, "end": 1502.5, "text": "尚有十万西粮骑兵"}, {"start": 1503.18, "end": 1503.98, "text": "常言道"}, {"start": 1504.46, "end": 1505.62, "text": "勾集跳墙"}, {"start": 1505.62, "end": 1506.7, "text": "雄寇勿魄"}, {"start": 1507.98, "end": 1508.86, "text": "还望太师"}, {"start": 1508.86, "end": 1510.3, "text": "恩准他们投降"}, {"start": 1510.58, "end": 1512.1, "text": "以免把他们逼上绝路"}, {"start": 1514.9, "end": 1517.58, "text": "我非但要将他们逼上绝路"}, {"start": 1518.38, "end": 1520.82, "text": "我还要送他们上死路呢"}, {"start": 1523.46, "end": 1524.38, "text": "公台啊"}, {"start": 1524.78, "end": 1525.98, "text": "你想一想"}, {"start": 1526.82, "end": 1528.1, "text": "贼军不灭"}, {"start": 1528.42, "end": 1529.82, "text": "皇威何在"}, {"start": 1530.38, "end": 1531.66, "text": "斩草除根"}, {"start": 1531.94, "end": 1534.06, "text": "找大义于天下"}, {"start": 1534.38, "end": 1535.02, "text": "太师"}, {"start": 1535.9, "end": 1536.62, "text": "李国二人"}, {"start": 1536.62, "end": 1538.02, "text": "都是西粮上将"}, {"start": 1538.34, "end": 1540.14, "text": "万万不可轻视啊"}, {"start": 1544.35, "end": 1546.83, "text": "我有奋威将军吕布"}, {"start": 1548.59, "end": 1552.63, "text": "李国二贼乃待死蜀辈儿"}, {"start": 1553.55, "end": 1554.59, "text": "吕布听令"}, {"start": 1558.65, "end": 1559.37, "text": "末将在"}, {"start": 1559.81, "end": 1560.85, "text": "我令你"}, {"start": 1561.17, "end": 1562.69, "text": "带领本部人马"}, {"start": 1562.69, "end": 1565.17, "text": "三日之内出征边地"}, {"start": 1565.17, "end": 1566.53, "text": "务必全监"}, {"start": 1567.09, "end": 1568.65, "text": "西粮残部"}, {"start": 1569.05, "end": 1570.01, "text": "不得有误"}, {"start": 1570.57, "end": 1571.37, "text": "末将领命"}, {"start": 1583.21, "end": 1583.85, "text": "大哥"}, {"start": 1588.77, "end": 1589.49, "text": "王云"}, {"start": 1589.81, "end": 1591.05, "text": "不许我们跪上朝廷"}, {"start": 1591.65, "end": 1592.29, "text": "听说"}, {"start": 1592.45, "end": 1593.85, "text": "还要派大军来攻杀我们"}, {"start": 1594.61, "end": 1595.21, "text": "弟兄们"}, {"start": 1595.41, "end": 1596.29, "text": "你们看怎么办"}, {"start": 1596.81, "end": 1597.81, "text": "东乡一死"}, {"start": 1597.93, "end": 1599.69, "text": "西粮那边即刻倒向了朝廷"}, {"start": 1599.85, "end": 1601.69, "text": "而且还断了我们粮草后路"}, {"start": 1602.13, "end": 1603.77, "text": "我们现在是战无可战"}, {"start": 1603.97, "end": 1605.05, "text": "守无可守"}, {"start": 1605.93, "end": 1606.57, "text": "我看"}, {"start": 1606.77, "end": 1607.93, "text": "不如把银两分喽"}, {"start": 1608.21, "end": 1609.73, "text": "让弟兄们回家逼难去吧"}, {"start": 1610.57, "end": 1611.65, "text": "二哥也不想想"}, {"start": 1611.93, "end": 1613.37, "text": "要是现在逃回乡里"}, {"start": 1613.53, "end": 1615.37, "text": "一个厅长就能把咱们给杀了"}, {"start": 1615.97, "end": 1617.45, "text": "大家只有聚在一起"}, {"start": 1617.69, "end": 1618.77, "text": "才会有生路啊"}, {"start": 1619.45, "end": 1620.53, "text": "你这话说得不错"}, {"start": 1621.69, "end": 1622.61, "text": "现在我们手上"}, {"start": 1622.73, "end": 1624.13, "text": "握有十二万重兵"}, {"start": 1624.69, "end": 1625.89, "text": "绝对不可以坐以待毙"}, {"start": 1626.57, "end": 1627.17, "text": "不如"}, {"start": 1627.73, "end": 1629.05, "text": "我们拼带个鱼死网破"}, {"start": 1629.21, "end": 1629.93, "text": "日夜兼程"}, {"start": 1630.05, "end": 1630.89, "text": "攻下长安"}, {"start": 1631.25, "end": 1632.01, "text": "遵命"}, {"start": 1719.29, "end": 1720.57, "text": "将军纷纷投降"}, {"start": 1720.85, "end": 1722.69, "text": "我们大势已去了"}, {"start": 1724.61, "end": 1726.89, "text": "回不听贤弟建言"}, {"start": 1728.49, "end": 1729.73, "text": "一招不慎"}, {"start": 1729.93, "end": 1731.93, "text": "满盘皆输啊"}, {"start": 1733.61, "end": 1735.53, "text": "兄台此时再说这些"}, {"start": 1735.65, "end": 1737.05, "text": "还有什么用处"}, {"start": 1738.29, "end": 1738.97, "text": "我估计"}, {"start": 1739.21, "end": 1740.29, "text": "不出半个时辰"}, {"start": 1740.57, "end": 1742.09, "text": "他们就会拿下皇宫"}, {"start": 1742.37, "end": 1744.05, "text": "亲拿天赐啊"}, {"start": 1744.61, "end": 1745.09, "text": "这"}, {"start": 1745.65, "end": 1746.85, "text": "这万万不成"}, {"start": 1747.17, "end": 1748.49, "text": "我要亲自领军"}, {"start": 1748.65, "end": 1750.21, "text": "去皇宫护驾"}, {"start": 1750.69, "end": 1751.13, "text": "你"}, {"start": 1751.37, "end": 1752.09, "text": "去梅屋"}, {"start": 1752.33, "end": 1753.21, "text": "诉诏"}, {"start": 1753.73, "end": 1755.41, "text": "吕布前来支援"}, {"start": 1755.49, "end": 1755.89, "text": "不"}, {"start": 1756.37, "end": 1757.01, "text": "太师啊"}, {"start": 1757.33, "end": 1758.45, "text": "贼军势力太大"}, {"start": 1758.61, "end": 1759.97, "text": "此时遭吕布回来"}, {"start": 1760.17, "end": 1761.89, "text": "只怕是来不及了"}, {"start": 1762.85, "end": 1763.49, "text": "不如"}, {"start": 1763.93, "end": 1764.53, "text": "兄台"}, {"start": 1764.89, "end": 1767.05, "text": "不如你赶紧携天赐与太后"}, {"start": 1767.25, "end": 1768.69, "text": "出城避难吧"}, {"start": 1769.13, "end": 1769.65, "text": "不"}, {"start": 1770.21, "end": 1772.29, "text": "西梁军骁勇善战"}, {"start": 1772.49, "end": 1775.09, "text": "天赐一旦弃城而出"}, {"start": 1775.33, "end": 1776.37, "text": "荒郊野外"}, {"start": 1776.49, "end": 1777.57, "text": "无处可守"}, {"start": 1777.81, "end": 1778.41, "text": "早晚"}, {"start": 1778.77, "end": 1780.69, "text": "便落入贼军手中"}, {"start": 1782.58, "end": 1783.34, "text": "莫不如"}, {"start": 1784.22, "end": 1786.46, "text": "守城待园为室"}, {"start": 1788.06, "end": 1788.46, "text": "你"}, {"start": 1788.66, "end": 1789.78, "text": "速去找吕布"}, {"start": 1789.86, "end": 1790.86, "text": "前来增援"}, {"start": 1790.9, "end": 1791.26, "text": "不"}, {"start": 1792.1, "end": 1793.54, "text": "你去呀"}, {"start": 1795.06, "end": 1798.35, "text": "住手"}, {"start": 1798.55, "end": 1799.15, "text": "住手"}, {"start": 1799.35, "end": 1800.27, "text": "住手"}, {"start": 1801.31, "end": 1801.87, "text": "住手"}, {"start": 1801.87, "end": 1802.31, "text": "停"}, {"start": 1803.07, "end": 1811.04, "text": "天子何在"}, {"start": 1811.6, "end": 1813.24, "text": "我们要面见天子陛下"}, {"start": 1814.24, "end": 1815.68, "text": "天子在此"}, {"start": 1816.6, "end": 1818.68, "text": "尔等不得放肆"}, {"start": 1819.4, "end": 1822.31, "text": "启禀天子陛下"}, {"start": 1823.07, "end": 1824.63, "text": "我等定不是要谋反"}, {"start": 1825.35, "end": 1827.51, "text": "只是陛下身边出了个奸贼"}, {"start": 1828.59, "end": 1829.95, "text": "我们要诛杀奸贼"}, {"start": 1830.31, "end": 1831.31, "text": "矿赴汉宴"}, {"start": 1831.99, "end": 1833.27, "text": "谁是奸贼"}, {"start": 1833.83, "end": 1835.23, "text": "就是你身边的奸贼"}, {"start": 1835.35, "end": 1836.55, "text": "是你身边的王允"}, {"start": 1837.35, "end": 1838.55, "text": "此人谋害董相"}, {"start": 1839.07, "end": 1840.03, "text": "屠戮中粮"}, {"start": 1840.47, "end": 1841.35, "text": "独善朝政"}, {"start": 1841.71, "end": 1842.67, "text": "祸国殃民"}, {"start": 1848.47, "end": 1850.43, "text": "老夫反倒成了"}, {"start": 1850.67, "end": 1852.11, "text": "屠戮中粮"}, {"start": 1853.03, "end": 1855.83, "text": "祸国殃民的奸贼了"}, {"start": 1856.95, "end": 1857.55, "text": "陛下"}, {"start": 1858.47, "end": 1859.79, "text": "只要你交出王允"}, {"start": 1860.47, "end": 1861.07, "text": "我等"}, {"start": 1861.79, "end": 1863.11, "text": "绝不会伤害于你"}, {"start": 1868.66, "end": 1869.58, "text": "老夫"}, {"start": 1869.98, "end": 1871.78, "text": "若是下长寿路"}, {"start": 1872.7, "end": 1874.86, "text": "你们会善待天子吗"}, {"start": 1876.62, "end": 1877.82, "text": "只要你打开城门"}, {"start": 1878.54, "end": 1879.06, "text": "我等"}, {"start": 1879.94, "end": 1881.54, "text": "就不会为难于天子"}, {"start": 1898.7, "end": 1899.94, "text": "苍天哪"}, {"start": 1901.62, "end": 1903.22, "text": "先帝啊"}, {"start": 1904.62, "end": 1905.22, "text": "臣"}, {"start": 1906.18, "end": 1907.06, "text": "王允"}, {"start": 1907.98, "end": 1910.82, "text": "已死报国了"}, {"start": 1914.66, "end": 1915.54, "text": "奸贼"}, {"start": 1917.61, "end": 1919.17, "text": "老夫来也"}, {"start": 1923.8, "end": 1925.84, "text": "有把王允碎尸万段"}, {"start": 1937.86, "end": 1938.66, "text": "奉先"}, {"start": 1940.14, "end": 1941.02, "text": "奉先哪"}, {"start": 1941.02, "end": 1941.54, "text": "成功"}, {"start": 1942.1, "end": 1942.74, "text": "出什么事了"}, {"start": 1943.22, "end": 1944.82, "text": "我看见京城大火冲天"}, {"start": 1947.06, "end": 1947.94, "text": "全都完了"}, {"start": 1948.26, "end": 1949.34, "text": "京城陷落"}, {"start": 1949.46, "end": 1950.46, "text": "天子被擒"}, {"start": 1950.86, "end": 1953.06, "text": "王允也已经以身殉国了呀"}, {"start": 1955.02, "end": 1956.1, "text": "我立刻去城外大营"}, {"start": 1956.7, "end": 1957.66, "text": "领兵回宫长岸"}, {"start": 1958.02, "end": 1958.74, "text": "援救天子"}, {"start": 1958.9, "end": 1959.98, "text": "不 等一下"}, {"start": 1960.46, "end": 1960.86, "text": "将军"}, {"start": 1961.26, "end": 1962.9, "text": "你这类现在还有多少兵马"}, {"start": 1963.62, "end": 1964.3, "text": "不均两万"}, {"start": 1964.82, "end": 1965.54, "text": "骑兵八千"}, {"start": 1967.06, "end": 1967.78, "text": "不够啊"}, {"start": 1968.26, "end": 1969.3, "text": "贼军势大"}, {"start": 1969.7, "end": 1971.58, "text": "而且他们现在已经关闭城门"}, {"start": 1971.7, "end": 1972.58, "text": "居高坚守"}, {"start": 1972.74, "end": 1974.18, "text": "根本攻不进去啊"}, {"start": 1975.06, "end": 1975.38, "text": "那"}, {"start": 1980.36, "end": 1981.2, "text": "那该怎么办"}, {"start": 1982.36, "end": 1983.04, "text": "将军啊"}, {"start": 1983.64, "end": 1984.44, "text": "今日之火"}, {"start": 1985.08, "end": 1987.2, "text": "只怪那王允他不听我言哪"}, {"start": 1988.08, "end": 1990.64, "text": "他拒绝离过二人的归乡"}, {"start": 1990.88, "end": 1993.04, "text": "才导致今天贼军破城啊"}, {"start": 1993.64, "end": 1998.45, "text": "先生有何借教"}, {"start": 1999.89, "end": 2000.37, "text": "将军"}, {"start": 2000.73, "end": 2003.6, "text": "肯听我的计策"}, {"start": 2004.2, "end": 2005.4, "text": "我愿服辱将军"}, {"start": 2005.92, "end": 2007.6, "text": "共创一番功名大业"}, {"start": 2008.04, "end": 2012.1, "text": "请先生识相"}, {"start": 2013.3, "end": 2013.66, "text": "将军"}, {"start": 2014.7, "end": 2015.18, "text": "依我看"}, {"start": 2015.78, "end": 2017.3, "text": "这次京城陷入之火"}, {"start": 2018.06, "end": 2019.9, "text": "天下必定会再度大乱"}, {"start": 2020.62, "end": 2021.82, "text": "群雄兵器"}, {"start": 2022.18, "end": 2023.18, "text": "刀兵横行"}, {"start": 2024.18, "end": 2025.3, "text": "只怕是几十年"}, {"start": 2025.3, "end": 2026.38, "text": "天下也不得太平"}, {"start": 2026.98, "end": 2027.54, "text": "吕将军"}, {"start": 2028.02, "end": 2029.02, "text": "你英勇过人"}, {"start": 2029.5, "end": 2030.74, "text": "拥有数万兵家"}, {"start": 2031.3, "end": 2032.78, "text": "我们不如暂离长安"}, {"start": 2032.98, "end": 2033.74, "text": "南下京乡"}, {"start": 2034.46, "end": 2035.5, "text": "占据一城池"}, {"start": 2036.14, "end": 2037.3, "text": "作为立足根据"}, {"start": 2037.94, "end": 2038.26, "text": "然后"}, {"start": 2039.26, "end": 2039.74, "text": "我们再"}, {"start": 2040.58, "end": 2042.18, "text": "招兵买马 扩大实力"}, {"start": 2042.46, "end": 2043.3, "text": "逐路中原"}, {"start": 2043.58, "end": 2044.62, "text": "建功立业"}, {"start": 2050.12, "end": 2050.48, "text": "吕布"}, {"start": 2051.64, "end": 2052.88, "text": "愿一听先生吩咐"}, {"start": 2055.42, "end": 2055.74, "text": "将军"}, {"start": 2056.54, "end": 2057.46, "text": "尽快启行吧"}, {"start": 2058.5, "end": 2059.14, "text": "先生稍候"}, {"start": 2061.46, "end": 2062.38, "text": "容我稍作收拾"}, {"start": 2062.74, "end": 2063.06, "text": "什么"}, {"start": 2063.74, "end": 2064.9, "text": "世间如此进步"}, {"start": 2065.22, "end": 2066.3, "text": "难道你还贪恋那些"}, {"start": 2066.3, "end": 2067.66, "text": "金银细软不强"}, {"start": 2068.1, "end": 2068.34, "text": "不"}, {"start": 2069.26, "end": 2070.42, "text": "在下宁可不要金银"}, {"start": 2071.54, "end": 2072.9, "text": "但必须协商夫人同行"}, {"start": 2073.78, "end": 2074.1, "text": "夫人"}, {"start": 2076.61, "end": 2077.21, "text": "就是吊产"}, {"start": 2082.14, "end": 2082.5, "text": "好吧"}, {"start": 2107.06, "end": 2108.22, "text": "曹老太爷进城了"}, {"start": 2109.78, "end": 2111.9, "text": "哪个曹老太爷啊"}, {"start": 2112.7, "end": 2114.38, "text": "曹操的父亲 曹松"}, {"start": 2115.3, "end": 2116.14, "text": "借导徐州"}, {"start": 2116.26, "end": 2118.06, "text": "前往衍州与曹操团圆"}, {"start": 2118.86, "end": 2119.34, "text": "父亲"}, {"start": 2123.34, "end": 2125.38, "text": "你们赶紧布置仪仗"}, {"start": 2125.7, "end": 2127.02, "text": "安排酒宴"}, {"start": 2127.86, "end": 2129.34, "text": "以王公之礼"}, {"start": 2129.66, "end": 2131.02, "text": "迎接曹松"}, {"start": 2131.62, "end": 2131.9, "text": "我"}, {"start": 2132.42, "end": 2134.66, "text": "我必须亲自出城相迎"}, {"start": 2134.94, "end": 2135.26, "text": "父亲"}, {"start": 2135.46, "end": 2136.3, "text": "您重兵在身"}, {"start": 2136.34, "end": 2137.42, "text": "就别出城相迎了"}, {"start": 2137.7, "end": 2139.14, "text": "而我带您出营就是了"}, {"start": 2139.54, "end": 2141.78, "text": "来的是曹操的父亲的"}, {"start": 2142.42, "end": 2144.26, "text": "我岂能不亲自相迎"}, {"start": 2145.38, "end": 2147.14, "text": "咱们与曹操苏来往"}, {"start": 2147.78, "end": 2149.02, "text": "您以礼相待就行了"}, {"start": 2149.38, "end": 2150.9, "text": "何必要迟疑王公之礼呢"}, {"start": 2152.42, "end": 2154.34, "text": "你以为我愿意啊"}, {"start": 2154.86, "end": 2157.1, "text": "我只不得不如此啊"}, {"start": 2157.98, "end": 2158.54, "text": "儿啊"}, {"start": 2159.54, "end": 2162.06, "text": "徐州乃四战之地啊"}, {"start": 2163.14, "end": 2164.54, "text": "北面的元兽"}, {"start": 2164.94, "end": 2166.1, "text": "东面的元树"}, {"start": 2166.86, "end": 2168.58, "text": "再加上曹操"}, {"start": 2169.3, "end": 2171.78, "text": "他们都贪图我们徐州啊"}, {"start": 2172.7, "end": 2173.62, "text": "而我们"}, {"start": 2174.06, "end": 2175.62, "text": "兵寡将弱"}, {"start": 2176.1, "end": 2178.94, "text": "哪个诸侯都得罪不起啊"}, {"start": 2180.06, "end": 2181.7, "text": "父亲既然知道他贪图徐州"}, {"start": 2182.26, "end": 2183.66, "text": "为何还对他献殷行啊"}, {"start": 2184.02, "end": 2188.27, "text": "各方诸侯中"}, {"start": 2188.59, "end": 2191.47, "text": "曹操的兵将最为精悍"}, {"start": 2191.91, "end": 2194.75, "text": "其州府离徐州也最近"}, {"start": 2195.43, "end": 2197.31, "text": "其称霸之野心"}, {"start": 2197.99, "end": 2200.63, "text": "也是最为如火如荼啊"}, {"start": 2201.03, "end": 2205.82, "text": "也又灭不了他"}, {"start": 2206.06, "end": 2210.54, "text": "过他 怎么办呢"}, {"start": 2211.22, "end": 2213.54, "text": "就得向他们示以恩宠"}, {"start": 2214.3, "end": 2217.82, "text": "设法化敌为勇"}, {"start": 2218.86, "end": 2222.9, "text": "只有这样才能守得住徐州的太平啊"}, {"start": 2223.02, "end": 2223.74, "text": "儿明白了"}, {"start": 2241.62, "end": 2242.86, "text": "将军将军将军"}, {"start": 2247.18, "end": 2247.82, "text": "各位弟兄"}, {"start": 2249.02, "end": 2250.38, "text": "我等本是黄金鱼的"}, {"start": 2251.18, "end": 2252.38, "text": "虽然投靠了陶芊"}, {"start": 2252.54, "end": 2253.58, "text": "却一直不受重用"}, {"start": 2254.26, "end": 2254.82, "text": "我看呢"}, {"start": 2255.1, "end": 2256.86, "text": "日后除了替他战死沙城以外"}, {"start": 2257.34, "end": 2258.22, "text": "不会有什么出息了"}, {"start": 2258.54, "end": 2259.42, "text": "大哥说得不错"}, {"start": 2260.66, "end": 2261.46, "text": "我们一不做二不休"}, {"start": 2261.94, "end": 2263.34, "text": "杀了曹宋 取了贤才"}, {"start": 2264.14, "end": 2265.42, "text": "我们到五凤山落草去"}, {"start": 2265.82, "end": 2266.78, "text": "过神仙般的日子"}, {"start": 2267.58, "end": 2268.1, "text": "怎么样"}, {"start": 2268.1, "end": 2268.3, "text": "好"}, {"start": 2269.3, "end": 2269.54, "text": "走"}, {"start": 2269.74, "end": 2270.34, "text": "走"}, {"start": 2270.34, "end": 2270.58, "text": "走"}, {"start": 2300.96, "end": 2302.0, "text": "诸公出了什么事"}, {"start": 2302.36, "end": 2303.52, "text": "为何如此痛苦"}, {"start": 2304.16, "end": 2305.08, "text": "刚刚得报"}, {"start": 2306.04, "end": 2307.04, "text": "曹老太爷"}, {"start": 2307.8, "end": 2309.88, "text": "被贼人们给杀了"}, {"start": 2310.04, "end": 2311.24, "text": "被贼人给杀了"}, {"start": 2311.96, "end": 2313.96, "text": "昨天还寄到老太爷口信"}, {"start": 2314.68, "end": 2317.64, "text": "说徐州刺史陶芊派亲兵来护送"}, {"start": 2317.8, "end": 2319.32, "text": "今天就可以到达眼中"}, {"start": 2319.6, "end": 2320.96, "text": "与诸公父子相备"}, {"start": 2321.32, "end": 2323.8, "text": "这怎么会被贼人给杀害"}, {"start": 2324.32, "end": 2325.72, "text": "杀害老太爷的"}, {"start": 2326.2, "end": 2329.04, "text": "就是给他护驾的张铠呀"}, {"start": 2330.52, "end": 2331.28, "text": "这个陶芊"}, {"start": 2331.88, "end": 2333.32, "text": "真是昏昧到家了"}, {"start": 2334.56, "end": 2335.4, "text": "官人不明"}, {"start": 2336.0, "end": 2336.84, "text": "余下无方"}, {"start": 2337.32, "end": 2338.72, "text": "竟然做此大错"}, {"start": 2339.04, "end": 2341.16, "text": "父亲啊"}, {"start": 2342.08, "end": 2353.74, "text": "儿不孝啊"}, {"start": 2353.98, "end": 2354.66, "text": "徐医啊"}, {"start": 2355.54, "end": 2356.46, "text": "诸公在里面"}, {"start": 2356.9, "end": 2357.98, "text": "痛苦万分"}, {"start": 2357.98, "end": 2359.06, "text": "唇忧顿足"}, {"start": 2359.26, "end": 2360.62, "text": "我他怎么缺都缺不住"}, {"start": 2361.34, "end": 2362.1, "text": "你到里面"}, {"start": 2362.18, "end": 2363.34, "text": "宽慰他一下吧"}, {"start": 2363.82, "end": 2366.02, "text": "他可是最听你的话呀"}, {"start": 2367.74, "end": 2368.42, "text": "不急不急"}, {"start": 2369.78, "end": 2370.62, "text": "齐昂主公"}, {"start": 2371.34, "end": 2372.42, "text": "再痛苦一会儿吧"}, {"start": 2373.26, "end": 2373.62, "text": "你这"}, {"start": 2378.43, "end": 2378.83, "text": "父亲"}, {"start": 2379.87, "end": 2380.35, "text": "父亲"}, {"start": 2380.95, "end": 2381.51, "text": "曹松"}, {"start": 2381.99, "end": 2382.87, "text": "曹老太爷"}, {"start": 2383.51, "end": 2384.71, "text": "被张铠给杀了"}, {"start": 2384.71, "end": 2385.55, "text": "曹老太爷"}, {"start": 2385.55, "end": 2386.83, "text": "眼看第二天"}, {"start": 2386.83, "end": 2388.47, "text": "就要进入眼中地面了"}, {"start": 2388.87, "end": 2390.71, "text": "谁料张铠那贼将"}, {"start": 2390.71, "end": 2391.91, "text": "见财起义"}, {"start": 2392.83, "end": 2394.79, "text": "臣音火同不暇"}, {"start": 2394.79, "end": 2396.83, "text": "杀了老太爷十二口人"}, {"start": 2396.83, "end": 2399.63, "text": "劫走了全部金银财物"}, {"start": 2399.63, "end": 2401.59, "text": "放火山落草为口"}, {"start": 2401.59, "end": 2402.39, "text": "父亲"}, {"start": 2402.39, "end": 2403.43, "text": "父亲你怎么了父亲"}, {"start": 2403.43, "end": 2404.03, "text": "老爷"}, {"start": 2404.63, "end": 2405.63, "text": "完了"}, {"start": 2405.95, "end": 2412.48, "text": "如今全无人可救"}, {"start": 2413.04, "end": 2414.92, "text": "如今全完了"}, {"start": 2414.92, "end": 2415.72, "text": "父亲"}, {"start": 2415.72, "end": 2416.96, "text": "你别着急啊"}, {"start": 2416.96, "end": 2418.2, "text": "别着急啊父亲"}, {"start": 2419.72, "end": 2420.64, "text": "都怪我"}, {"start": 2420.64, "end": 2423.28, "text": "都怪我下了眼了"}, {"start": 2423.28, "end": 2425.44, "text": "国王见了张开世"}, {"start": 2425.44, "end": 2427.6, "text": "贼匪的余党啊"}, {"start": 2429.64, "end": 2432.88, "text": "我本想结交曹操这个萧雄"}, {"start": 2432.88, "end": 2435.04, "text": "谁知弄巧成拙"}, {"start": 2435.04, "end": 2437.76, "text": "惹起了逃奸拘祸呀"}]