[{"start": 3.7, "end": 7.7, "text": "没想到,刘备焦狂之气,"}, {"start": 8.7, "end": 11.7, "text": "净慎当年关羽,这是孤,"}, {"start": 12.7, "end": 13.7, "text": "不曾料到的。"}, {"start": 20.46, "end": 25.57, "text": "说吧,子虞,事到如今,"}, {"start": 27.57, "end": 31.57, "text": "什么事情,你都可以跟我直说。"}, {"start": 36.6, "end": 39.6, "text": "臣以为,眼下情势万机,"}, {"start": 43.1, "end": 46.1, "text": "主公可以给曹皮上一道祥表,"}, {"start": 46.1, "end": 49.1, "text": "承认他是天下之主,"}, {"start": 50.1, "end": 53.1, "text": "率江东文武,向他称臣。"}, {"start": 54.1, "end": 66.98, "text": "你要我,投降曹皮,放弃祖燕。"}, {"start": 67.98, "end": 73.89, "text": "主公,此乃拯救危局之策,"}, {"start": 74.89, "end": 78.89, "text": "如此一来,渴望得到曹皮出兵相援哪。"}, {"start": 79.89, "end": 81.89, "text": "与其让刘备称王,"}, {"start": 81.89, "end": 86.89, "text": "倒不如向曹皮称臣,以保江东哪。"}, {"start": 87.89, "end": 89.89, "text": "孤乃东吾之主,"}, {"start": 90.89, "end": 92.89, "text": "这祥表一上奏,"}, {"start": 93.89, "end": 101.21, "text": "我的颜面何在,王威何在。"}, {"start": 102.21, "end": 103.21, "text": "主公。"}, {"start": 103.21, "end": 108.38, "text": "这事容我三思。"}, {"start": 113.57, "end": 150.52, "text": "出格谨,劝我上奏祥表,"}, {"start": 151.52, "end": 153.52, "text": "向曹皮委曲称臣。"}, {"start": 153.52, "end": 160.74, "text": "我父兄三代鸡眼断送了。"}, {"start": 161.74, "end": 167.26, "text": "不上祥表,"}, {"start": 172.03, "end": 174.03, "text": "东吾只怕真要断送了。"}, {"start": 175.03, "end": 178.47, "text": "如果上了祥表,"}, {"start": 179.47, "end": 180.47, "text": "一胜。"}, {"start": 181.47, "end": 184.58, "text": "为何这样说?"}, {"start": 187.98, "end": 190.98, "text": "刘备称帝后,天下三族鼎立,"}, {"start": 191.98, "end": 193.98, "text": "缺失了任何一族,"}, {"start": 194.98, "end": 196.98, "text": "天下必然崩塌。"}, {"start": 197.98, "end": 199.98, "text": "曹皮与刘备一样,"}, {"start": 199.98, "end": 202.98, "text": "都有一统天下之志,"}, {"start": 203.98, "end": 206.98, "text": "岂能坐视刘备,攻去东吾。"}, {"start": 207.98, "end": 209.98, "text": "东吾一旦不存,"}, {"start": 210.98, "end": 212.98, "text": "曹位也不能久。"}, {"start": 213.98, "end": 216.98, "text": "曹皮最想看到的是,"}, {"start": 217.98, "end": 220.98, "text": "蜀无交兵,两败俱伤,"}, {"start": 221.98, "end": 224.98, "text": "但他并不想看见东吾灭亡。"}, {"start": 228.03, "end": 233.2, "text": "这个道理我也明白,"}, {"start": 233.2, "end": 238.86, "text": "可这像曹皮请香煮鸡。"}, {"start": 245.84, "end": 246.84, "text": "人主的胸怀,"}, {"start": 249.6, "end": 251.6, "text": "是被世间无数屈辱,"}, {"start": 252.6, "end": 253.6, "text": "称大的。"}, {"start": 254.6, "end": 255.6, "text": "子不,"}, {"start": 257.6, "end": 258.6, "text": "你看,"}, {"start": 259.6, "end": 260.6, "text": "可派何人为使?"}, {"start": 261.6, "end": 262.6, "text": "学士,"}, {"start": 263.6, "end": 265.6, "text": "赵姿心之过人,"}, {"start": 266.6, "end": 267.6, "text": "如遣他为使,"}, {"start": 268.6, "end": 271.6, "text": "既能表达东吾的请香之诚,"}, {"start": 271.6, "end": 274.6, "text": "又能不失主公王威。"}, {"start": 275.6, "end": 276.6, "text": "好,"}, {"start": 277.6, "end": 279.6, "text": "你立刻提问你一道响表,"}, {"start": 280.6, "end": 282.6, "text": "派赵姿送往许城。"}, {"start": 283.6, "end": 306.04, "text": "平身,"}, {"start": 306.04, "end": 315.42, "text": "赵姿,"}, {"start": 317.42, "end": 318.42, "text": "朕问你,"}, {"start": 319.42, "end": 320.42, "text": "孙全"}, {"start": 321.42, "end": 323.42, "text": "是怎样一个主公?"}, {"start": 323.42, "end": 329.22, "text": "聪明,"}, {"start": 329.22, "end": 330.22, "text": "仁智,"}, {"start": 330.22, "end": 331.22, "text": "雄劣之主。"}, {"start": 332.22, "end": 335.37, "text": "卒相,"}, {"start": 335.37, "end": 337.37, "text": "太过褒奖了吧?"}, {"start": 338.37, "end": 340.37, "text": "臣不敢过于我主,"}, {"start": 340.37, "end": 341.37, "text": "陛下可曾记得"}, {"start": 341.37, "end": 343.37, "text": "先父五皇帝的那句感叹?"}, {"start": 344.37, "end": 346.97, "text": "什么感叹?"}, {"start": 347.97, "end": 348.97, "text": "当年,"}, {"start": 348.97, "end": 351.97, "text": "卫王与我主吾侯在如虚交兵,"}, {"start": 351.97, "end": 353.97, "text": "我主刚刚策马而出,"}, {"start": 353.97, "end": 354.97, "text": "其风姿神采,"}, {"start": 354.97, "end": 356.97, "text": "就让卫王大惊,"}, {"start": 356.97, "end": 357.97, "text": "常叹道,"}, {"start": 357.97, "end": 359.97, "text": "生子当如孙仲谋,"}, {"start": 360.97, "end": 361.97, "text": "此叹,"}, {"start": 361.97, "end": 362.97, "text": "世人皆知。"}, {"start": 363.97, "end": 364.97, "text": "陛下,"}, {"start": 364.97, "end": 365.97, "text": "乃卫世子,"}, {"start": 365.97, "end": 366.97, "text": "敢问陛下,"}, {"start": 367.97, "end": 368.97, "text": "卫王这句感叹,"}, {"start": 368.97, "end": 371.97, "text": "岂不就是说我主吾侯"}, {"start": 371.97, "end": 373.97, "text": "可作卫王诸子的楷模吗?"}, {"start": 377.34, "end": 378.34, "text": "是有此事。"}, {"start": 379.34, "end": 380.34, "text": "陛下明鉴,"}, {"start": 381.34, "end": 383.34, "text": "容臣再举数例,"}, {"start": 384.34, "end": 386.34, "text": "我主纳鲁肃于凡品,"}, {"start": 386.34, "end": 387.34, "text": "是其聪也,"}, {"start": 388.34, "end": 389.34, "text": "把吕蒙于杭镇,"}, {"start": 389.34, "end": 390.34, "text": "是其名也,"}, {"start": 390.34, "end": 392.34, "text": "服于晋而不害,"}, {"start": 392.34, "end": 393.34, "text": "是其仁也,"}, {"start": 393.34, "end": 396.34, "text": "取荆州兵不血刃,"}, {"start": 396.34, "end": 397.34, "text": "是其志也,"}, {"start": 398.34, "end": 399.34, "text": "聚三江,"}, {"start": 399.34, "end": 400.34, "text": "而虎是天下,"}, {"start": 400.34, "end": 401.34, "text": "是其雄也,"}, {"start": 402.34, "end": 403.34, "text": "今日,"}, {"start": 403.34, "end": 404.34, "text": "愿屈身于陛下,"}, {"start": 405.34, "end": 406.34, "text": "是其略也。"}, {"start": 407.34, "end": 408.34, "text": "以此而论,"}, {"start": 408.34, "end": 409.34, "text": "我主岂不就是"}, {"start": 409.34, "end": 410.34, "text": "聪明,"}, {"start": 410.34, "end": 411.34, "text": "仁至,"}, {"start": 411.34, "end": 412.34, "text": "雄略之主吗?"}, {"start": 413.34, "end": 417.03, "text": "尊全"}, {"start": 418.03, "end": 419.03, "text": "通师叔一礼吗?"}, {"start": 420.03, "end": 421.03, "text": "我主"}, {"start": 421.03, "end": 422.03, "text": "福疆万艘,"}, {"start": 422.03, "end": 423.03, "text": "代价百万,"}, {"start": 424.03, "end": 425.03, "text": "任贤使能"}, {"start": 425.03, "end": 426.03, "text": "至存精略,"}, {"start": 427.03, "end": 428.03, "text": "虽然政务繁忙,"}, {"start": 428.03, "end": 430.03, "text": "不孝俘儒寻张斋具,"}, {"start": 430.03, "end": 431.03, "text": "但少有余闲,"}, {"start": 432.03, "end": 434.03, "text": "只需稍稍阅书官使,"}, {"start": 435.03, "end": 436.03, "text": "便能采其大旨,"}, {"start": 437.03, "end": 439.03, "text": "胜似学父武车者。"}, {"start": 440.03, "end": 444.04, "text": "尊全"}, {"start": 444.04, "end": 445.04, "text": "虽然降朕,"}, {"start": 446.04, "end": 448.04, "text": "但依现在的形势是"}, {"start": 448.04, "end": 449.04, "text": "蜀强,"}, {"start": 450.04, "end": 451.04, "text": "吾弱,"}, {"start": 452.04, "end": 453.04, "text": "朕"}, {"start": 453.04, "end": 454.04, "text": "如果拒绝尊全,"}, {"start": 455.04, "end": 456.04, "text": "反而"}, {"start": 456.04, "end": 458.04, "text": "连蜀伐吾呢?"}, {"start": 459.04, "end": 460.04, "text": "东吾"}, {"start": 460.04, "end": 461.04, "text": "如何相抗?"}, {"start": 461.04, "end": 463.04, "text": "大国有征伐之兵,"}, {"start": 463.04, "end": 465.04, "text": "小国有预备之策,"}, {"start": 466.04, "end": 467.04, "text": "我主"}, {"start": 467.04, "end": 468.04, "text": "无论陛下怎样做,"}, {"start": 469.04, "end": 470.04, "text": "都有成竹在胸。"}, {"start": 471.04, "end": 472.04, "text": "这么说"}, {"start": 473.04, "end": 475.32, "text": "东吾"}, {"start": 475.32, "end": 476.32, "text": "不怕?"}, {"start": 476.32, "end": 479.6, "text": "东吾战甲虽少,"}, {"start": 479.6, "end": 483.03, "text": "但水师之勇"}, {"start": 484.03, "end": 485.03, "text": "天下无双,"}, {"start": 485.03, "end": 487.03, "text": "更有长江天窃,"}, {"start": 487.03, "end": 489.03, "text": "足可坚守不坠。"}, {"start": 489.03, "end": 490.03, "text": "我主"}, {"start": 490.03, "end": 491.03, "text": "何惧之有?"}, {"start": 493.03, "end": 494.03, "text": "祖先"}, {"start": 495.03, "end": 496.03, "text": "祖先"}, {"start": 496.03, "end": 497.03, "text": "果然善变,"}, {"start": 497.03, "end": 501.88, "text": "东吾像你这样的人才"}, {"start": 502.88, "end": 503.88, "text": "还有多少?"}, {"start": 503.88, "end": 504.88, "text": "之勇超群者"}, {"start": 504.88, "end": 505.88, "text": "百人上下,"}, {"start": 506.88, "end": 507.88, "text": "如我辈,"}, {"start": 508.88, "end": 511.51, "text": "车载斗粮"}, {"start": 511.51, "end": 512.51, "text": "不可胜数。"}, {"start": 512.51, "end": 524.43, "text": "尊全派你为使者,"}, {"start": 524.43, "end": 525.43, "text": "真是不辱使命啊。"}, {"start": 526.43, "end": 527.43, "text": "好吧,"}, {"start": 528.43, "end": 529.43, "text": "朕"}, {"start": 529.43, "end": 531.43, "text": "接受尊全的响表。"}, {"start": 532.43, "end": 533.43, "text": "你告诉他"}, {"start": 534.43, "end": 535.43, "text": "朕"}, {"start": 535.43, "end": 536.43, "text": "封他为吾王"}, {"start": 536.43, "end": 537.43, "text": "加九夕。"}, {"start": 538.43, "end": 541.99, "text": "谢陛下。"}, {"start": 541.99, "end": 542.99, "text": "仲达,"}, {"start": 542.99, "end": 547.87, "text": "照你看这次吾蜀交战,"}, {"start": 548.87, "end": 549.87, "text": "谁可取胜啊?"}, {"start": 549.87, "end": 550.87, "text": "臣以为"}, {"start": 554.88, "end": 555.88, "text": "刘备必胜。"}, {"start": 557.88, "end": 558.88, "text": "何以见得?"}, {"start": 558.88, "end": 562.7, "text": "刘备称帝后雄心万丈。"}, {"start": 563.7, "end": 567.08, "text": "他梦想在有生之年"}, {"start": 567.08, "end": 569.08, "text": "完成天下大业。"}, {"start": 570.08, "end": 572.08, "text": "此次清国出兵,"}, {"start": 572.08, "end": 573.08, "text": "粮饷备足,"}, {"start": 574.08, "end": 575.08, "text": "将士用心,"}, {"start": 575.08, "end": 576.08, "text": "军风强劲。"}, {"start": 576.08, "end": 577.08, "text": "访观东吾尊全,"}, {"start": 579.68, "end": 580.68, "text": "其水师虽精锐,"}, {"start": 581.68, "end": 583.68, "text": "但步棋不如蜀军。"}, {"start": 584.68, "end": 585.68, "text": "坚诚死归,"}, {"start": 586.68, "end": 587.68, "text": "三个时辰便败了。"}, {"start": 588.68, "end": 589.68, "text": "东吾城门已开,"}, {"start": 592.25, "end": 593.25, "text": "由此看来"}, {"start": 593.25, "end": 594.25, "text": "主君当胜,"}, {"start": 595.25, "end": 599.13, "text": "吾君当败。"}, {"start": 599.13, "end": 601.13, "text": "那尊全这次"}, {"start": 604.56, "end": 605.56, "text": "会有亡国吗?"}, {"start": 606.56, "end": 607.56, "text": "臣以为"}, {"start": 607.56, "end": 609.56, "text": "东吾将士败而不亡。"}, {"start": 609.56, "end": 612.61, "text": "刘备如想灭吾,"}, {"start": 615.91, "end": 616.91, "text": "必须尊全。"}, {"start": 616.91, "end": 618.91, "text": "第一步仍是攻取荆州。"}, {"start": 618.91, "end": 619.91, "text": "荆州乃天下之府,"}, {"start": 620.91, "end": 621.91, "text": "四通八达。"}, {"start": 625.32, "end": 626.32, "text": "得荆州者"}, {"start": 626.32, "end": 627.32, "text": "是天下牛儿,"}, {"start": 628.32, "end": 629.32, "text": "之后"}, {"start": 629.32, "end": 631.32, "text": "补充粮饷士族,"}, {"start": 632.32, "end": 635.95, "text": "才可沿江东下"}, {"start": 637.95, "end": 638.95, "text": "取吾都建业。"}, {"start": 639.95, "end": 640.95, "text": "尊全为了避免"}, {"start": 640.95, "end": 641.95, "text": "灭顶之灾,"}, {"start": 642.95, "end": 643.95, "text": "不得已向朕请降。"}, {"start": 648.66, "end": 649.66, "text": "此时,"}, {"start": 649.66, "end": 650.66, "text": "又把灰尸西向"}, {"start": 650.66, "end": 651.66, "text": "攻取汉州。"}, {"start": 652.66, "end": 653.66, "text": "朕不会上这个当。"}, {"start": 655.66, "end": 657.66, "text": "朕既不攻蜀"}, {"start": 657.66, "end": 658.66, "text": "也不救吾,"}, {"start": 659.66, "end": 660.66, "text": "做官成败"}, {"start": 661.66, "end": 664.04, "text": "相机而斗。"}, {"start": 664.04, "end": 665.04, "text": "陛下英明。"}, {"start": 666.04, "end": 667.04, "text": "英明。"}, {"start": 667.04, "end": 668.04, "text": "陛下臣以为"}, {"start": 668.04, "end": 669.04, "text": "吾君胜。"}, {"start": 669.04, "end": 670.04, "text": "陛下可乘势"}, {"start": 670.04, "end": 672.67, "text": "收取汉州。"}, {"start": 676.46, "end": 677.46, "text": "如刘备胜,"}, {"start": 677.46, "end": 681.27, "text": "陛下可乘势"}, {"start": 681.27, "end": 682.27, "text": "收取荆州。"}, {"start": 683.27, "end": 684.27, "text": "吾君胜。"}, {"start": 685.27, "end": 686.27, "text": "吾君胜。"}, {"start": 686.27, "end": 687.27, "text": "吾君胜。"}, {"start": 688.27, "end": 689.27, "text": "好Coréne"}, {"start": 690.27, "end": 692.27, "text": "绝对 ai"}, {"start": 693.27, "end": 708.98, "text": "都紮合第七次的"}, {"start": 709.98, "end": 710.98, "text": "poison"}, {"start": 711.98, "end": 712.98, "text": "和"}, {"start": 713.98, "end": 717.19, "text": "St expressing"}, {"start": 719.19, "end": 720.19, "text": "除了"}, {"start": 722.79, "end": 727.65, "text": "bet"}, {"start": 728.65, "end": 729.65, "text": "既以"}, {"start": 730.65, "end": 731.65, "text": "无辜"}, {"start": 731.65, "end": 732.65, "text": "无重"}, {"start": 734.09, "end": 735.37, "text": "全军转入夷陵"}, {"start": 735.73, "end": 736.69, "text": "举敌刘备"}, {"start": 736.93, "end": 737.73, "text": "夷陵城池"}, {"start": 738.05, "end": 739.37, "text": "还不如紫硅坚实呢"}, {"start": 739.85, "end": 740.97, "text": "我们能抵挡多久啊"}, {"start": 741.41, "end": 742.57, "text": "主公命我抵挡多久"}, {"start": 742.89, "end": 743.97, "text": "我就抵挡多久"}, {"start": 745.17, "end": 746.25, "text": "夷陵城"}, {"start": 747.09, "end": 748.53, "text": "要么是刘备坟墓"}, {"start": 749.21, "end": 751.97, "text": "要么就是我孙桓坟墓"}, {"start": 752.17, "end": 753.37, "text": "孙将军这番胆识"}, {"start": 753.85, "end": 754.89, "text": "主人没什么说的了"}, {"start": 755.61, "end": 757.33, "text": "愿与将军同生共死"}, {"start": 757.33, "end": 761.64, "text": "愿与将军同生共死"}, {"start": 761.84, "end": 762.76, "text": "全军听令"}, {"start": 763.36, "end": 764.36, "text": "全军向北"}, {"start": 765.0, "end": 766.16, "text": "转入夷陵城"}, {"start": 771.63, "end": 772.91, "text": "孙花乃孙权亲职"}, {"start": 773.27, "end": 774.43, "text": "主人也号称是汉将"}, {"start": 774.83, "end": 776.55, "text": "没想到如此不堪一击吗"}, {"start": 777.39, "end": 778.47, "text": "照这个进度打下去"}, {"start": 778.75, "end": 779.63, "text": "再过二十天"}, {"start": 779.91, "end": 781.59, "text": "咱们就可以进入建康城了"}, {"start": 788.14, "end": 789.18, "text": "怎么不吹嘘了"}, {"start": 790.26, "end": 791.5, "text": "你们了解孙权吗"}, {"start": 792.98, "end": 794.78, "text": "他九岁单身入敌营"}, {"start": 795.82, "end": 797.54, "text": "向刘表求回腐蚀"}, {"start": 797.78, "end": 799.7, "text": "十八岁坐领江东"}, {"start": 799.94, "end": 802.3, "text": "第一仗便是赤壁交兵"}, {"start": 802.86, "end": 804.22, "text": "比朕小三十岁"}, {"start": 804.74, "end": 806.14, "text": "但极有套律"}, {"start": 806.54, "end": 807.54, "text": "胆识过人"}, {"start": 808.14, "end": 811.14, "text": "更何况自古江东多才俊"}, {"start": 811.54, "end": 813.54, "text": "江东水师还没有参战"}, {"start": 813.86, "end": 815.14, "text": "你们有什么可惜的"}, {"start": 815.66, "end": 817.46, "text": "陛下所言极是"}, {"start": 818.66, "end": 820.42, "text": "在下打了一辈子仗"}, {"start": 820.62, "end": 821.74, "text": "误出一个道理"}, {"start": 822.54, "end": 823.94, "text": "太容易获胜的仗"}, {"start": 824.14, "end": 825.82, "text": "十之八九有诈"}, {"start": 825.82, "end": 827.82, "text": "眼下吴军虽然败了几阵"}, {"start": 828.42, "end": 829.18, "text": "可是"}, {"start": 829.82, "end": 832.22, "text": "称府甘宁 邯郸周泰"}, {"start": 832.42, "end": 835.02, "text": "等等名将一个也没有露面"}, {"start": 836.02, "end": 837.62, "text": "孙权连败数阵"}, {"start": 839.02, "end": 840.42, "text": "这是他的交兵之计"}, {"start": 841.22, "end": 844.22, "text": "对江东军民也是挨兵之计"}, {"start": 844.62, "end": 846.42, "text": "如果我们小胜计较"}, {"start": 848.02, "end": 849.62, "text": "那大祸也就不远了"}, {"start": 850.02, "end": 850.22, "text": "报"}, {"start": 850.22, "end": 850.82, "text": "禀陛下"}, {"start": 851.02, "end": 855.08, "text": "孙权前使向曹皮请降"}, {"start": 855.28, "end": 856.96, "text": "曹皮在许昌昭告天下"}, {"start": 856.96, "end": 859.16, "text": "奉孙权为捕亡加九戏"}, {"start": 861.36, "end": 862.16, "text": "听见了吧"}, {"start": 862.76, "end": 864.56, "text": "孙权跟曹皮结盟了"}, {"start": 867.19, "end": 870.82, "text": "如果我们不能速战速决"}, {"start": 871.62, "end": 873.22, "text": "曹皮就会趁箭用灵"}, {"start": 873.62, "end": 874.22, "text": "报"}, {"start": 874.62, "end": 875.22, "text": "禀陛下"}, {"start": 875.62, "end": 880.2, "text": "孙桓引四万残军进入宜陵城"}, {"start": 880.4, "end": 882.0, "text": "一进城便加固城池"}, {"start": 882.2, "end": 884.4, "text": "并扬言要与宜陵共存亡"}, {"start": 885.0, "end": 888.0, "text": "想不到这个小侄倒有几分胆子"}, {"start": 888.4, "end": 890.0, "text": "放着南徐不回"}, {"start": 890.2, "end": 892.54, "text": "要坚守这国"}, {"start": 892.74, "end": 893.34, "text": "陛下"}, {"start": 893.54, "end": 895.14, "text": "末将请命 共驱宜陵"}, {"start": 895.54, "end": 898.54, "text": "好"}, {"start": 898.94, "end": 900.14, "text": "你领三万军去"}, {"start": 901.34, "end": 901.94, "text": "陛下"}, {"start": 904.7, "end": 905.9, "text": "孙桓还有四万军"}, {"start": 906.1, "end": 907.9, "text": "围攻城池至少应该三倍余地"}, {"start": 908.3, "end": 910.1, "text": "若陛下能给末将五万精兵"}, {"start": 910.3, "end": 912.1, "text": "我保证三日之内共下宜陵"}, {"start": 912.3, "end": 912.9, "text": "张宝"}, {"start": 913.5, "end": 915.3, "text": "朕只是让你阳攻宜陵"}, {"start": 915.7, "end": 918.82, "text": "并没有让你血债"}, {"start": 920.02, "end": 920.82, "text": "为何呀"}, {"start": 921.82, "end": 924.82, "text": "这里离南徐有多久"}, {"start": 925.22, "end": 930.53, "text": "这里离南徐有东吴监城十余座"}, {"start": 930.93, "end": 932.93, "text": "朕估计再往前"}, {"start": 933.33, "end": 936.13, "text": "便是东吴悍将聚守监城了"}, {"start": 939.24, "end": 940.24, "text": "我军虽重"}, {"start": 941.04, "end": 942.44, "text": "但劳师远征"}, {"start": 942.84, "end": 945.04, "text": "粮草均血共挤不易"}, {"start": 945.84, "end": 948.24, "text": "如果这样一城一池地打下去"}, {"start": 949.24, "end": 950.44, "text": "打不到南徐"}, {"start": 951.64, "end": 953.24, "text": "我们就会折兵过半"}, {"start": 953.84, "end": 955.84, "text": "那样草坯就有可乘之机"}, {"start": 956.04, "end": 960.78, "text": "陛下是想围城打圆"}, {"start": 964.66, "end": 971.88, "text": "正是孙桓是孙泉的亲职"}, {"start": 973.68, "end": 974.88, "text": "他非救不可"}, {"start": 975.88, "end": 977.08, "text": "我就是让他救"}, {"start": 978.08, "end": 979.68, "text": "就是要等他的援兵"}, {"start": 980.68, "end": 982.48, "text": "这样我才可以在野战中"}, {"start": 982.88, "end": 984.48, "text": "一举将他们歼灭"}, {"start": 996.76, "end": 997.56, "text": "草坯"}, {"start": 998.36, "end": 1002.31, "text": "给了我两个空头面关"}, {"start": 1002.51, "end": 1003.71, "text": "一个是吴王"}, {"start": 1005.72, "end": 1007.12, "text": "一个叫加九西"}, {"start": 1009.38, "end": 1011.18, "text": "他若真想出兵助我"}, {"start": 1011.38, "end": 1012.78, "text": "还需整顿军啊"}, {"start": 1013.98, "end": 1014.98, "text": "汉中附近"}, {"start": 1014.98, "end": 1016.98, "text": "就驻守曹任二十万大军"}, {"start": 1017.78, "end": 1019.18, "text": "只要他一声令下"}, {"start": 1019.58, "end": 1021.58, "text": "二十万大军杀入汉中"}, {"start": 1022.58, "end": 1026.18, "text": "刘备必然退兵回防蜀地"}, {"start": 1026.78, "end": 1030.18, "text": "草坯是得等蜀巫两败俱伤后"}, {"start": 1030.38, "end": 1032.18, "text": "他再进兵余力啊"}, {"start": 1033.78, "end": 1034.58, "text": "这样也好"}, {"start": 1035.38, "end": 1037.58, "text": "起码可以稳住草坯"}, {"start": 1037.98, "end": 1039.58, "text": "使他不能趁火打劫"}, {"start": 1039.78, "end": 1040.98, "text": "袭我荆州"}, {"start": 1042.18, "end": 1044.38, "text": "可是我们不能再败了"}, {"start": 1044.98, "end": 1046.38, "text": "如果一败再败"}, {"start": 1046.98, "end": 1048.98, "text": "就难保草坯和刘备"}, {"start": 1048.98, "end": 1050.18, "text": "不会使我荆州"}, {"start": 1056.14, "end": 1056.94, "text": "禀主公"}, {"start": 1057.74, "end": 1059.34, "text": "孙桓血书上表"}, {"start": 1059.54, "end": 1061.94, "text": "一者是为子规之师"}, {"start": 1062.14, "end": 1063.54, "text": "请主公降罪"}, {"start": 1063.94, "end": 1067.34, "text": "二者他已率四万大军退守夷陵"}, {"start": 1067.74, "end": 1070.54, "text": "并称是与夷陵共存亡"}, {"start": 1071.94, "end": 1072.54, "text": "主公"}, {"start": 1073.34, "end": 1075.74, "text": "臣来之时据探报得知"}, {"start": 1076.14, "end": 1077.54, "text": "刘备先锋张报"}, {"start": 1077.94, "end": 1080.14, "text": "已将夷陵团团围住"}, {"start": 1080.74, "end": 1082.74, "text": "今晚大军几日猛攻"}, {"start": 1083.14, "end": 1084.34, "text": "而不能下"}, {"start": 1084.94, "end": 1085.54, "text": "拿来"}, {"start": 1101.55, "end": 1103.35, "text": "知始而后永"}, {"start": 1104.93, "end": 1106.73, "text": "不愧为孙氏子孙"}, {"start": 1108.38, "end": 1109.78, "text": "夷陵不能再失"}, {"start": 1109.98, "end": 1112.38, "text": "请主公快快发兵救援"}, {"start": 1115.05, "end": 1115.65, "text": "传命"}, {"start": 1116.25, "end": 1118.25, "text": "韩当为正将 周太为副将"}, {"start": 1118.45, "end": 1119.45, "text": "潘张为先锋"}, {"start": 1119.45, "end": 1120.85, "text": "甘宁领统为后应"}, {"start": 1121.05, "end": 1122.05, "text": "起兵十万"}, {"start": 1122.25, "end": 1123.25, "text": "援助夷陵"}, {"start": 1123.25, "end": 1123.85, "text": "诺"}, {"start": 1124.25, "end": 1125.85, "text": "主公 这怕不妥啊"}, {"start": 1125.85, "end": 1126.65, "text": "有何不妥"}, {"start": 1127.25, "end": 1129.05, "text": "紫辉城坚是无比"}, {"start": 1129.65, "end": 1131.65, "text": "三个时辰就被刘备攻破"}, {"start": 1133.68, "end": 1134.68, "text": "夷陵城池"}, {"start": 1135.28, "end": 1136.68, "text": "远比紫辉难受"}, {"start": 1137.88, "end": 1138.68, "text": "为何"}, {"start": 1139.08, "end": 1141.88, "text": "蜀军连攻三日都未能攻下"}, {"start": 1142.88, "end": 1145.28, "text": "这其中恐怕有诈呀"}, {"start": 1145.88, "end": 1152.6, "text": "你是说"}, {"start": 1153.6, "end": 1155.0, "text": "刘备围攻夷陵"}, {"start": 1156.0, "end": 1157.8, "text": "是想引我大军决战"}, {"start": 1158.0, "end": 1158.6, "text": "臣"}, {"start": 1159.4, "end": 1161.0, "text": "虽然不能下此定论"}, {"start": 1162.0, "end": 1163.8, "text": "可臣必生征战"}, {"start": 1165.2, "end": 1166.2, "text": "也能从这"}, {"start": 1166.8, "end": 1168.2, "text": "诡异的敌情中"}, {"start": 1169.0, "end": 1170.2, "text": "闻出险境来"}, {"start": 1189.06, "end": 1190.46, "text": "老将军多虑了"}, {"start": 1191.86, "end": 1194.26, "text": "蜀国在我国土上作战"}, {"start": 1195.26, "end": 1197.26, "text": "并非我军在蜀地作战"}, {"start": 1198.66, "end": 1199.66, "text": "此时此刻"}, {"start": 1199.86, "end": 1201.26, "text": "夷陵不能再世了"}, {"start": 1201.26, "end": 1202.86, "text": "否则会祸及南郡"}, {"start": 1203.26, "end": 1203.86, "text": "那时候"}, {"start": 1204.06, "end": 1206.66, "text": "曹匹就会以为我东吴大势已去"}, {"start": 1206.66, "end": 1207.86, "text": "必袭荆州"}, {"start": 1209.46, "end": 1210.46, "text": "更何况"}, {"start": 1210.86, "end": 1212.26, "text": "即便决战"}, {"start": 1212.46, "end": 1213.86, "text": "我也不惧刘备"}, {"start": 1214.46, "end": 1215.46, "text": "他千里而来"}, {"start": 1215.66, "end": 1217.06, "text": "连战两月有余"}, {"start": 1217.86, "end": 1219.66, "text": "此时冰封已衰"}, {"start": 1220.86, "end": 1222.26, "text": "我就在夷陵城下"}, {"start": 1222.66, "end": 1224.06, "text": "与他决一次战"}, {"start": 1224.86, "end": 1225.46, "text": "主公"}, {"start": 1226.06, "end": 1227.26, "text": "三思啊"}, {"start": 1227.46, "end": 1228.26, "text": "我意已决"}, {"start": 1228.66, "end": 1229.46, "text": "传命吧"}, {"start": 1230.66, "end": 1231.06, "text": "诺"}, {"start": 1233.14, "end": 1234.54, "text": "各营到马里去"}, {"start": 1235.74, "end": 1237.14, "text": "凌晨就启程"}, {"start": 1237.34, "end": 1238.14, "text": "遵命"}, {"start": 1243.75, "end": 1244.35, "text": "禀将军"}, {"start": 1244.55, "end": 1245.95, "text": "前任大都督陆迅"}, {"start": 1246.35, "end": 1248.55, "text": "劈头散发坐在江边大哭不止"}, {"start": 1249.55, "end": 1250.75, "text": "看样子像是疯了"}, {"start": 1251.55, "end": 1251.95, "text": "走"}, {"start": 1252.15, "end": 1252.75, "text": "看一看"}, {"start": 1252.75, "end": 1253.15, "text": "诺"}, {"start": 1263.54, "end": 1265.54, "text": "是宋阳入虎口"}, {"start": 1266.14, "end": 1268.94, "text": "包心灸大火呀"}, {"start": 1269.54, "end": 1271.14, "text": "今日宋军去"}, {"start": 1272.74, "end": 1275.54, "text": "不得见君还呐"}, {"start": 1276.14, "end": 1277.94, "text": "惨呐"}, {"start": 1278.94, "end": 1280.74, "text": "惨呐"}, {"start": 1283.02, "end": 1283.62, "text": "伯焱"}, {"start": 1284.62, "end": 1285.82, "text": "你这是干什么"}, {"start": 1286.02, "end": 1291.8, "text": "冯夷将军嘛"}, {"start": 1291.8, "end": 1299.39, "text": "我是在给动物的儿郎们送行呢"}, {"start": 1301.3, "end": 1302.9, "text": "今日宋军去"}, {"start": 1304.3, "end": 1310.73, "text": "不得见君还呐"}, {"start": 1310.93, "end": 1311.53, "text": "住口"}, {"start": 1312.13, "end": 1312.73, "text": "陆迅"}, {"start": 1313.33, "end": 1315.53, "text": "你满口胡言乱我军心"}, {"start": 1316.73, "end": 1317.73, "text": "你再不住口"}, {"start": 1318.73, "end": 1319.93, "text": "我可不客气了"}, {"start": 1320.33, "end": 1327.35, "text": "吴当门"}, {"start": 1328.55, "end": 1331.75, "text": "你不过是一歹死的佣人儿"}, {"start": 1332.15, "end": 1334.35, "text": "土刀架在你脖子上"}, {"start": 1334.35, "end": 1335.95, "text": "当你尚不自知"}, {"start": 1337.15, "end": 1339.35, "text": "你懂什么祸福啊"}, {"start": 1339.95, "end": 1341.15, "text": "像我陆迅"}, {"start": 1342.15, "end": 1344.95, "text": "当年曾是东吴的大都督"}, {"start": 1345.75, "end": 1348.55, "text": "看他要比你深远得多"}, {"start": 1350.15, "end": 1350.95, "text": "左卫听令"}, {"start": 1351.15, "end": 1351.75, "text": "在"}, {"start": 1353.84, "end": 1356.24, "text": "此人出口不训满嘴胡言"}, {"start": 1356.44, "end": 1357.44, "text": "即刻拿下"}, {"start": 1357.64, "end": 1358.24, "text": "诺"}, {"start": 1358.44, "end": 1360.04, "text": "教主公贩落"}, {"start": 1361.04, "end": 1362.64, "text": "主公啊"}, {"start": 1363.44, "end": 1365.04, "text": "给东吴的老人们"}, {"start": 1365.04, "end": 1366.84, "text": "留几个儿郎吧"}, {"start": 1367.24, "end": 1368.84, "text": "给东吴的女人们"}, {"start": 1369.24, "end": 1371.64, "text": "留几个丈夫啊"}, {"start": 1372.24, "end": 1388.01, "text": "主公"}, {"start": 1388.21, "end": 1390.01, "text": "陆迅拜见主公"}, {"start": 1407.74, "end": 1408.74, "text": "主公何在啊"}, {"start": 1409.34, "end": 1411.34, "text": "你中风昧傻"}, {"start": 1411.54, "end": 1412.94, "text": "胡言乱语"}, {"start": 1413.14, "end": 1414.74, "text": "破乱军心"}, {"start": 1415.34, "end": 1416.94, "text": "罪无可赦"}, {"start": 1418.34, "end": 1419.14, "text": "张大人哪"}, {"start": 1419.74, "end": 1421.74, "text": "情势危急啊张大人"}, {"start": 1422.14, "end": 1424.14, "text": "请让我速速见见主公吧"}, {"start": 1425.14, "end": 1427.74, "text": "主公根本不屑一见"}, {"start": 1427.74, "end": 1429.34, "text": "你这样一个疯汉"}, {"start": 1429.74, "end": 1434.38, "text": "来人"}, {"start": 1434.38, "end": 1435.18, "text": "在"}, {"start": 1435.38, "end": 1437.18, "text": "把陆迅关押起来"}, {"start": 1437.18, "end": 1437.98, "text": "诺"}, {"start": 1438.18, "end": 1443.94, "text": "某人齐下马"}, {"start": 1444.14, "end": 1447.14, "text": "也办邻深渊"}, {"start": 1447.34, "end": 1451.58, "text": "好江山"}, {"start": 1451.78, "end": 1480.69, "text": "朕刚刚得到消息"}, {"start": 1481.49, "end": 1483.29, "text": "孙权令邯当为正将"}, {"start": 1483.49, "end": 1484.89, "text": "周泰为副将"}, {"start": 1485.09, "end": 1486.69, "text": "潘章为先锋"}, {"start": 1486.89, "end": 1488.69, "text": "灵统甘宁为后营"}, {"start": 1488.89, "end": 1490.29, "text": "起兵十万"}, {"start": 1490.69, "end": 1491.69, "text": "援助一令"}, {"start": 1491.89, "end": 1493.09, "text": "十万哪"}, {"start": 1493.09, "end": 1495.09, "text": "孙权这次把家底都使上了"}, {"start": 1495.89, "end": 1496.69, "text": "陛下"}, {"start": 1496.89, "end": 1497.89, "text": "孙权上钩了"}, {"start": 1498.09, "end": 1499.09, "text": "我们赶紧出军"}, {"start": 1499.29, "end": 1500.49, "text": "与他们决战吧"}, {"start": 1500.89, "end": 1501.69, "text": "陛下"}, {"start": 1501.89, "end": 1504.23, "text": "臣"}, {"start": 1504.43, "end": 1507.13, "text": "曾在荆州"}, {"start": 1507.33, "end": 1509.13, "text": "与孙权对峙多年"}, {"start": 1509.33, "end": 1511.73, "text": "深知此人满腹的击炸"}, {"start": 1511.93, "end": 1513.73, "text": "怎会如此轻易的"}, {"start": 1513.93, "end": 1515.33, "text": "就上钩了呢"}, {"start": 1515.53, "end": 1517.13, "text": "这个朕也想过"}, {"start": 1519.7, "end": 1521.3, "text": "原因只怕有二"}, {"start": 1521.7, "end": 1522.7, "text": "其一"}, {"start": 1523.7, "end": 1525.7, "text": "曹皮答应援助他"}, {"start": 1525.7, "end": 1527.3, "text": "这就使孙权壮了胆"}, {"start": 1528.1, "end": 1529.1, "text": "其二"}, {"start": 1529.3, "end": 1530.7, "text": "孙权一败再败"}, {"start": 1530.9, "end": 1532.1, "text": "大局危机"}, {"start": 1532.5, "end": 1534.7, "text": "他想拼其老本输死一仗"}, {"start": 1535.1, "end": 1536.9, "text": "这样也可以扬威许长"}, {"start": 1537.5, "end": 1539.3, "text": "让曹尉援兵来得更快"}, {"start": 1539.9, "end": 1540.9, "text": "如此看来"}, {"start": 1541.1, "end": 1543.1, "text": "我军更应该速战速决啊"}, {"start": 1543.5, "end": 1545.3, "text": "现在我们该想想"}, {"start": 1545.5, "end": 1558.05, "text": "如何收拾东吴这十万精锐"}, {"start": 1558.25, "end": 1559.25, "text": "此仗"}, {"start": 1560.25, "end": 1564.58, "text": "是东征的关键之一"}, {"start": 1564.78, "end": 1565.78, "text": "如圣旨"}, {"start": 1565.78, "end": 1569.42, "text": "孙权大势已去"}, {"start": 1569.62, "end": 1571.42, "text": "荆州指日可下"}, {"start": 1571.62, "end": 1572.62, "text": "陛下"}, {"start": 1573.22, "end": 1574.42, "text": "韩党周泰"}, {"start": 1574.62, "end": 1578.6, "text": "潘昌 林统这些将领"}, {"start": 1578.8, "end": 1580.6, "text": "虽然比不上周瑜"}, {"start": 1580.8, "end": 1583.0, "text": "可是个个身经百战"}, {"start": 1583.4, "end": 1585.0, "text": "他们要是累起营盘"}, {"start": 1585.2, "end": 1586.2, "text": "扎住阵脚"}, {"start": 1586.4, "end": 1588.2, "text": "面对面地和我们厮杀"}, {"start": 1589.0, "end": 1591.4, "text": "我们虽然也能将计击败"}, {"start": 1591.8, "end": 1593.8, "text": "可自身的折损"}, {"start": 1594.0, "end": 1595.8, "text": "也不会少啊"}, {"start": 1595.8, "end": 1596.8, "text": "陛下请看"}, {"start": 1597.0, "end": 1599.0, "text": "这片山蛙叫富池口"}, {"start": 1599.2, "end": 1600.6, "text": "最适合伏兵"}, {"start": 1600.8, "end": 1602.6, "text": "若把吴军诱到此地"}, {"start": 1602.8, "end": 1606.83, "text": "那他那十几万精锐"}, {"start": 1607.03, "end": 1609.03, "text": "肯定是有来无回呀"}, {"start": 1609.23, "end": 1610.63, "text": "此计甚佳"}, {"start": 1611.83, "end": 1613.23, "text": "但如何能将吴军"}, {"start": 1613.43, "end": 1614.63, "text": "诱入富池口呢"}, {"start": 1614.83, "end": 1616.03, "text": "要钓大鱼"}, {"start": 1616.23, "end": 1619.94, "text": "须上香儿"}, {"start": 1620.34, "end": 1622.54, "text": "皇中愿以身作尔"}, {"start": 1622.74, "end": 1623.94, "text": "诱入富池口"}, {"start": 1624.14, "end": 1625.34, "text": "此计设法"}, {"start": 1625.54, "end": 1627.14, "text": "必须必须必须"}, {"start": 1627.34, "end": 1629.62, "text": "此计设法"}, {"start": 1629.62, "end": 1631.42, "text": "愿以身作尔"}, {"start": 1631.62, "end": 1642.15, "text": "诱吴军上钩"}, {"start": 1642.35, "end": 1643.35, "text": "韩生啊"}, {"start": 1644.75, "end": 1646.35, "text": "你七十五岁了"}, {"start": 1646.55, "end": 1647.75, "text": "位居五虎上将"}, {"start": 1647.95, "end": 1649.35, "text": "声名显著"}, {"start": 1649.55, "end": 1651.35, "text": "是我蜀军大盗"}, {"start": 1651.95, "end": 1654.55, "text": "朕怎么能让你冒如此凶险呢"}, {"start": 1655.95, "end": 1657.15, "text": "说实话"}, {"start": 1657.75, "end": 1659.15, "text": "此次伐吴"}, {"start": 1659.35, "end": 1661.15, "text": "我本不想让你来的"}, {"start": 1661.75, "end": 1663.55, "text": "挡不住你一再恳请"}, {"start": 1663.75, "end": 1665.55, "text": "但以身作尔之事"}, {"start": 1665.75, "end": 1668.98, "text": "朕绝对不会答应"}, {"start": 1668.98, "end": 1670.18, "text": "陛下"}, {"start": 1671.18, "end": 1672.38, "text": "五虎将中"}, {"start": 1672.58, "end": 1674.98, "text": "云长义德都走了"}, {"start": 1675.38, "end": 1678.58, "text": "马超在汉中防着曹匹"}, {"start": 1678.78, "end": 1680.38, "text": "赵云留守川蜀"}, {"start": 1680.58, "end": 1682.98, "text": "只有我随驾出征"}, {"start": 1683.18, "end": 1684.58, "text": "东吴那些将领"}, {"start": 1684.78, "end": 1686.98, "text": "谁不想用五虎将的首级"}, {"start": 1687.18, "end": 1688.98, "text": "为自己扬名啊"}, {"start": 1689.58, "end": 1690.98, "text": "这以身作尔的人"}, {"start": 1691.18, "end": 1693.98, "text": "还有谁比我更适合呢"}, {"start": 1694.38, "end": 1696.78, "text": "只有我亲师现于阵前"}, {"start": 1696.78, "end": 1697.78, "text": "邯郸他们"}, {"start": 1697.98, "end": 1700.58, "text": "才会不顾一切地追杀我呀"}, {"start": 1701.98, "end": 1702.78, "text": "陛下"}, {"start": 1702.98, "end": 1703.78, "text": "请"}, {"start": 1704.58, "end": 1705.98, "text": "准我上阵吧"}, {"start": 1706.18, "end": 1706.78, "text": "别说了"}, {"start": 1706.98, "end": 1713.14, "text": "韩生啊"}, {"start": 1713.34, "end": 1720.9, "text": "你的忠勇令朕感动"}, {"start": 1721.1, "end": 1722.5, "text": "白发苍苍"}, {"start": 1722.9, "end": 1724.9, "text": "你让朕怎么能忍心"}, {"start": 1725.5, "end": 1727.3, "text": "一旦轻神附险"}, {"start": 1727.7, "end": 1729.7, "text": "失刃无情了"}, {"start": 1735.09, "end": 1737.49, "text": "臣打了一辈子仗"}, {"start": 1738.49, "end": 1741.89, "text": "直到六十都没有遇上明主"}, {"start": 1742.69, "end": 1743.89, "text": "臣以为"}, {"start": 1744.89, "end": 1748.69, "text": "此生也就如此了"}, {"start": 1748.89, "end": 1750.69, "text": "没想到临老了"}, {"start": 1750.89, "end": 1753.97, "text": "遇上了陛下"}, {"start": 1754.17, "end": 1756.57, "text": "封过为五虎上将"}, {"start": 1758.75, "end": 1759.75, "text": "陛下"}, {"start": 1761.39, "end": 1764.59, "text": "皇中已经是老朽了"}, {"start": 1765.39, "end": 1767.79, "text": "不想苟延残喘"}, {"start": 1769.6, "end": 1771.8, "text": "只想在一场大战中"}, {"start": 1772.2, "end": 1774.0, "text": "留此终身"}, {"start": 1774.2, "end": 1776.2, "text": "以求不憾"}, {"start": 1782.8, "end": 1783.8, "text": "臣"}, {"start": 1784.4, "end": 1786.8, "text": "恳求陛下了"}, {"start": 1814.42, "end": 1817.44, "text": "七十五岁"}, {"start": 1817.64, "end": 1819.04, "text": "这番雄心壮语"}, {"start": 1819.24, "end": 1822.28, "text": "告诉我们"}, {"start": 1822.48, "end": 1825.66, "text": "怎样才能不负平生"}, {"start": 1828.03, "end": 1829.03, "text": "怎样才能成为"}, {"start": 1829.23, "end": 1831.03, "text": "明垂青史的良相"}, {"start": 1837.13, "end": 1837.93, "text": "韩生"}, {"start": 1839.67, "end": 1841.07, "text": "我用你所谋"}, {"start": 1842.07, "end": 1843.87, "text": "你也可以率军出征"}, {"start": 1844.67, "end": 1850.42, "text": "此次付出十万精锐的粉肠"}, {"start": 1851.42, "end": 1852.22, "text": "但是"}, {"start": 1855.71, "end": 1859.42, "text": "更要你平安归来"}, {"start": 1860.22, "end": 1861.42, "text": "安然无恙"}, {"start": 1861.42, "end": 1886.23, "text": "我不想再失去你这位贤兄"}, {"start": 1890.56, "end": 1891.36, "text": "臣"}, {"start": 1908.1, "end": 1908.7, "text": "快"}, {"start": 1909.1, "end": 1910.3, "text": "加快速度"}, {"start": 1910.7, "end": 1911.7, "text": "将给钱"}, {"start": 1911.9, "end": 1913.5, "text": "一定要放过山去"}, {"start": 1913.7, "end": 1914.3, "text": "是"}, {"start": 1920.39, "end": 1921.39, "text": "这谁的马车"}, {"start": 1921.59, "end": 1922.19, "text": "停下"}, {"start": 1926.1, "end": 1927.1, "text": "程老将军"}, {"start": 1930.5, "end": 1931.3, "text": "老将军"}, {"start": 1931.9, "end": 1933.3, "text": "你怎么上前线来了"}, {"start": 1934.3, "end": 1935.3, "text": "杀敌啊"}, {"start": 1936.5, "end": 1937.7, "text": "你身患重病"}, {"start": 1938.1, "end": 1939.7, "text": "怎么还能胜振杀敌啊"}, {"start": 1940.1, "end": 1941.3, "text": "我程浦"}, {"start": 1941.9, "end": 1943.9, "text": "受三代主公的好恩"}, {"start": 1944.3, "end": 1945.9, "text": "只能以死为报"}, {"start": 1947.3, "end": 1948.3, "text": "你放心吧"}, {"start": 1949.5, "end": 1950.7, "text": "到了阵前"}, {"start": 1951.3, "end": 1952.9, "text": "我定能挥刀杀敌"}, {"start": 1953.5, "end": 1954.9, "text": "不会让你麻烦的"}, {"start": 1955.9, "end": 1958.5, "text": "我将能与老将军同上战场"}, {"start": 1959.3, "end": 1960.7, "text": "毕生荣幸啊"}, {"start": 1960.9, "end": 1962.3, "text": "我为老将军驾车"}, {"start": 1962.5, "end": 2027.85, "text": "不着急"}, {"start": 2028.45, "end": 2030.05, "text": "放敌军于近前"}, {"start": 2030.45, "end": 2031.85, "text": "五十步放箭"}, {"start": 2032.05, "end": 2033.45, "text": "三十步滚十"}, {"start": 2033.85, "end": 2035.85, "text": "十步之内长劳刺杀"}, {"start": 2036.65, "end": 2038.05, "text": "后备军接应"}, {"start": 2038.65, "end": 2039.45, "text": "韩将军"}, {"start": 2039.65, "end": 2040.85, "text": "你看那面蜀旗"}, {"start": 2041.05, "end": 2041.85, "text": "怎么了"}, {"start": 2042.05, "end": 2043.65, "text": "那是皇中的将旗啊"}, {"start": 2044.45, "end": 2046.25, "text": "皇中未居五虎上将"}, {"start": 2046.45, "end": 2047.65, "text": "如果他在这里"}, {"start": 2047.85, "end": 2049.65, "text": "蜀军主力必然在此"}, {"start": 2050.45, "end": 2051.65, "text": "他一定是去攻打"}, {"start": 2051.85, "end": 2053.45, "text": "程老将军的营寨去了"}, {"start": 2053.65, "end": 2054.65, "text": "什么五虎将啊"}, {"start": 2054.85, "end": 2056.45, "text": "我早想跟他较高地"}, {"start": 2056.65, "end": 2058.25, "text": "今天正好让我赶上了"}, {"start": 2058.65, "end": 2059.85, "text": "给我狠狠地打"}, {"start": 2067.96, "end": 2068.76, "text": "五十步"}, {"start": 2070.36, "end": 2070.96, "text": "放"}, {"start": 2110.84, "end": 2111.64, "text": "一步可施"}, {"start": 2111.84, "end": 2113.44, "text": "打开战门出击吧"}, {"start": 2114.44, "end": 2115.44, "text": "别再犹豫了"}, {"start": 2115.64, "end": 2116.64, "text": "我们居高临下"}, {"start": 2116.84, "end": 2118.84, "text": "一旦冲刹是不可挡"}, {"start": 2119.04, "end": 2120.24, "text": "如果能拿下皇中"}, {"start": 2120.44, "end": 2121.84, "text": "蜀军必然大败啊"}, {"start": 2122.04, "end": 2122.64, "text": "好"}, {"start": 2123.64, "end": 2125.44, "text": "传令全军杀出营寨"}, {"start": 2125.64, "end": 2126.64, "text": "盛清皇中"}, {"start": 2127.04, "end": 2127.44, "text": "诺"}, {"start": 2129.74, "end": 2130.34, "text": "皇将军"}, {"start": 2130.94, "end": 2131.94, "text": "敌军攻势太强"}, {"start": 2132.14, "end": 2133.94, "text": "我军实在抵挡不住了"}, {"start": 2134.14, "end": 2134.74, "text": "怎么办"}, {"start": 2135.74, "end": 2136.54, "text": "查军"}, {"start": 2136.94, "end": 2167.78, "text": "黄老将军"}, {"start": 2167.98, "end": 2169.38, "text": "已经把吴军引出山寨"}, {"start": 2169.58, "end": 2170.98, "text": "现正往富池口上来"}, {"start": 2171.78, "end": 2172.58, "text": "多少人马"}, {"start": 2172.78, "end": 2173.78, "text": "黑牙牙一片"}, {"start": 2173.98, "end": 2174.98, "text": "直连天边"}, {"start": 2175.58, "end": 2176.58, "text": "不可进蜀"}, {"start": 2177.78, "end": 2178.38, "text": "好"}, {"start": 2179.38, "end": 2179.98, "text": "再探"}, {"start": 2180.18, "end": 2180.58, "text": "诺"}, {"start": 2182.74, "end": 2184.14, "text": "三军将士们"}, {"start": 2184.54, "end": 2186.14, "text": "都五十万精锐"}, {"start": 2187.54, "end": 2189.54, "text": "正向鬼门关迈进"}, {"start": 2192.18, "end": 2193.58, "text": "半个时辰之内"}, {"start": 2193.78, "end": 2198.7, "text": "大战就要开始"}, {"start": 2200.63, "end": 2202.23, "text": "身为将士"}, {"start": 2204.3, "end": 2206.3, "text": "能够经历如此大战"}, {"start": 2207.1, "end": 2210.1, "text": "是上天赐予我们的荣幸"}, {"start": 2214.46, "end": 2215.86, "text": "也是上天"}, {"start": 2216.46, "end": 2217.86, "text": "赐予我们的机会"}, {"start": 2219.26, "end": 2220.06, "text": "将士们"}, {"start": 2221.06, "end": 2222.86, "text": "你们建功的时刻到了"}, {"start": 2223.26, "end": 2225.06, "text": "让敌人的鲜血"}, {"start": 2225.46, "end": 2227.86, "text": "浸透我们的正袍"}, {"start": 2254.82, "end": 2256.62, "text": "会把身后的吴军丢掉的"}, {"start": 2256.82, "end": 2278.91, "text": "我打对劲的"}, {"start": 2279.11, "end": 2280.11, "text": "有什么不对劲的"}, {"start": 2280.31, "end": 2280.91, "text": "你看"}, {"start": 2282.75, "end": 2284.35, "text": "前面像是个山谷"}, {"start": 2285.15, "end": 2286.35, "text": "一股阴森之气"}, {"start": 2286.75, "end": 2287.95, "text": "地势怕有埋伏"}, {"start": 2288.35, "end": 2289.35, "text": "不管有没有"}, {"start": 2290.35, "end": 2291.15, "text": "那地势"}, {"start": 2291.95, "end": 2293.15, "text": "适合伏击"}, {"start": 2293.75, "end": 2295.15, "text": "不可不防啊"}, {"start": 2295.95, "end": 2296.95, "text": "报"}, {"start": 2297.35, "end": 2298.15, "text": "杀将军"}, {"start": 2298.95, "end": 2299.55, "text": "杀将军"}, {"start": 2299.75, "end": 2301.15, "text": "吴军好像停止追击了"}, {"start": 2301.35, "end": 2303.15, "text": "只是用箭射杀我们的后队"}, {"start": 2303.55, "end": 2306.75, "text": "韩当果然是名将"}, {"start": 2306.95, "end": 2308.35, "text": "比狼还要诡诈"}, {"start": 2312.5, "end": 2313.1, "text": "听命"}, {"start": 2313.5, "end": 2315.1, "text": "搭起本将的大盗旗"}, {"start": 2315.3, "end": 2316.9, "text": "跟我回去继续冲杀"}, {"start": 2317.1, "end": 2317.7, "text": "杀将军"}, {"start": 2317.9, "end": 2319.3, "text": "几万吴军在放箭"}, {"start": 2319.5, "end": 2320.3, "text": "太危险了"}, {"start": 2321.3, "end": 2321.9, "text": "传令"}, {"start": 2322.9, "end": 2323.9, "text": "跟我回去"}, {"start": 2324.3, "end": 2325.5, "text": "伪令者斩"}, {"start": 2325.9, "end": 2326.5, "text": "遵命"}, {"start": 2326.7, "end": 2334.49, "text": "守军正在拜讨"}, {"start": 2334.69, "end": 2336.49, "text": "不追杀实在是太可惜了"}, {"start": 2337.09, "end": 2339.89, "text": "主公将十万精锐交给我俩"}, {"start": 2341.29, "end": 2342.69, "text": "要谨慎小心啊"}, {"start": 2343.49, "end": 2344.29, "text": "再说"}, {"start": 2345.09, "end": 2346.49, "text": "兵法有言"}, {"start": 2346.89, "end": 2348.29, "text": "穷寇勿追"}, {"start": 2351.02, "end": 2352.02, "text": "那就听你的"}, {"start": 2353.02, "end": 2354.02, "text": "传命各军"}, {"start": 2355.02, "end": 2356.02, "text": "停止追杀"}, {"start": 2356.42, "end": 2358.22, "text": "射箭杀敌即可"}, {"start": 2358.82, "end": 2359.82, "text": "停止追杀"}, {"start": 2360.42, "end": 2361.22, "text": "工农朝"}, {"start": 2361.42, "end": 2362.22, "text": "放箭"}, {"start": 2362.62, "end": 2392.33, "text": "老夫六岁"}, {"start": 2392.33, "end": 2395.5, "text": "习都说过射人"}, {"start": 2395.7, "end": 2396.9, "text": "岂有人射火"}, {"start": 2396.9, "end": 2405.56, "text": "莫将射军冲杀"}, {"start": 2405.56, "end": 2406.56, "text": "我征战一项"}, {"start": 2406.56, "end": 2407.96, "text": "死也要死在马上"}, {"start": 2407.96, "end": 2408.76, "text": "拖起来"}, {"start": 2408.76, "end": 2409.56, "text": "将军"}, {"start": 2409.56, "end": 2438.56, "text": "这个好机会啊"}, {"start": 2438.96, "end": 2440.36, "text": "让我上前去斩了他"}, {"start": 2440.36, "end": 2442.56, "text": "再把他的手机挂到仪岭城头"}, {"start": 2442.76, "end": 2444.56, "text": "让蜀军上下都看看"}, {"start": 2444.76, "end": 2446.56, "text": "蜀军必然魂飞丧胆"}, {"start": 2446.56, "end": 2447.16, "text": "周抬"}, {"start": 2447.36, "end": 2451.58, "text": "韩军军"}, {"start": 2451.78, "end": 2452.58, "text": "你留在这里"}, {"start": 2452.58, "end": 2453.58, "text": "我带军追杀"}, {"start": 2453.58, "end": 2454.18, "text": "跟我来"}]