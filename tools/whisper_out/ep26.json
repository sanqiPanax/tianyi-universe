[{"start": 3.89, "end": 8.57, "text": "站住"}, {"start": 12.57, "end": 14.57, "text": "天弓将军张角"}, {"start": 14.57, "end": 16.57, "text": "快快下马受降"}, {"start": 22.57, "end": 23.57, "text": "匹夫"}, {"start": 23.57, "end": 25.57, "text": "敢冒充我威名"}, {"start": 29.57, "end": 30.57, "text": "好汉"}, {"start": 30.57, "end": 32.57, "text": "你又是何人呐"}, {"start": 37.34, "end": 38.34, "text": "我这周沧"}, {"start": 38.34, "end": 39.34, "text": "你是谁"}, {"start": 39.34, "end": 42.34, "text": "关羽自云长"}, {"start": 42.34, "end": 47.95, "text": "将军"}, {"start": 47.95, "end": 49.95, "text": "我终于亲眼见到你了"}, {"start": 49.95, "end": 50.95, "text": "将军"}, {"start": 51.95, "end": 52.95, "text": "装饰"}, {"start": 53.95, "end": 54.95, "text": "装饰"}, {"start": 54.95, "end": 55.95, "text": "起来"}, {"start": 55.95, "end": 56.95, "text": "快快请起"}, {"start": 56.95, "end": 59.95, "text": "关某受之不齐啊"}, {"start": 60.95, "end": 61.95, "text": "将军"}, {"start": 61.95, "end": 63.95, "text": "在下本是黄金旧部"}, {"start": 63.95, "end": 64.95, "text": "跟张角征战的时候"}, {"start": 64.95, "end": 66.95, "text": "就听过将军的威名"}, {"start": 66.95, "end": 67.95, "text": "你收下我吧"}, {"start": 69.95, "end": 70.95, "text": "将军"}, {"start": 70.95, "end": 72.95, "text": "若能给您牵马追荡"}, {"start": 72.95, "end": 74.95, "text": "我死也甘心了将军"}, {"start": 74.95, "end": 75.95, "text": "将军"}, {"start": 75.95, "end": 77.95, "text": "我求求你将军"}, {"start": 77.95, "end": 79.95, "text": "我求求你了将军"}, {"start": 79.95, "end": 80.95, "text": "将军"}, {"start": 80.95, "end": 86.86, "text": "你在此战山为王"}, {"start": 86.86, "end": 87.86, "text": "有多痛快"}, {"start": 87.86, "end": 89.86, "text": "何必跟着我受罪"}, {"start": 89.86, "end": 91.86, "text": "我所过的日子"}, {"start": 91.86, "end": 93.86, "text": "天天为敌似伏"}, {"start": 93.86, "end": 95.86, "text": "凶险莫测"}, {"start": 95.86, "end": 99.62, "text": "周长不怕死"}, {"start": 99.62, "end": 101.62, "text": "只要能做将军的一个部族"}, {"start": 101.62, "end": 103.62, "text": "胜过战山为王"}, {"start": 103.62, "end": 105.99, "text": "禀告二位嫂嫂"}, {"start": 105.99, "end": 106.99, "text": "他们允许了"}, {"start": 106.99, "end": 107.99, "text": "我才敢收你"}, {"start": 107.99, "end": 108.99, "text": "二位嫂嫂"}, {"start": 108.99, "end": 116.23, "text": "关羽有事禀告"}, {"start": 117.23, "end": 118.23, "text": "叔叔请讲"}, {"start": 119.23, "end": 120.23, "text": "现有一壮汉"}, {"start": 120.23, "end": 121.23, "text": "名叫周沧"}, {"start": 122.23, "end": 124.23, "text": "他原本是黄金旧部"}, {"start": 125.23, "end": 126.23, "text": "现效居此山"}, {"start": 126.23, "end": 127.23, "text": "做了这一山的寨主"}, {"start": 128.23, "end": 129.23, "text": "他恳求于我"}, {"start": 129.23, "end": 130.23, "text": "让我收留他"}, {"start": 130.23, "end": 131.23, "text": "做我的部属"}, {"start": 132.23, "end": 134.23, "text": "关羽不敢自尊"}, {"start": 135.23, "end": 136.23, "text": "请二位嫂嫂决定"}, {"start": 137.23, "end": 138.23, "text": "叔叔"}, {"start": 138.23, "end": 140.23, "text": "这人先为贼后为盗"}, {"start": 140.23, "end": 141.23, "text": "山寨中"}, {"start": 141.23, "end": 143.23, "text": "还有他不少强人吧"}, {"start": 144.23, "end": 145.23, "text": "是"}, {"start": 146.23, "end": 148.23, "text": "那留他只怕不妥"}, {"start": 148.23, "end": 149.23, "text": "请叔叔斟酌"}, {"start": 151.23, "end": 152.23, "text": "嫂嫂说得是"}, {"start": 161.87, "end": 162.87, "text": "周沧啊"}, {"start": 162.87, "end": 163.87, "text": "嫂嫂认为你"}, {"start": 163.87, "end": 165.87, "text": "先从贼后从盗"}, {"start": 166.87, "end": 168.87, "text": "寨中还有那么多的部族"}, {"start": 169.87, "end": 170.87, "text": "不肯留你"}, {"start": 170.87, "end": 171.87, "text": "将军呢"}, {"start": 172.87, "end": 173.87, "text": "周沧是贼从盗"}, {"start": 174.87, "end": 175.87, "text": "都是出于无奈啊"}, {"start": 176.87, "end": 177.87, "text": "你想啊"}, {"start": 177.87, "end": 179.87, "text": "天下这么恶酌"}, {"start": 179.87, "end": 180.87, "text": "老是人活得了吗"}, {"start": 180.87, "end": 181.87, "text": "将军你起兵之前"}, {"start": 181.87, "end": 183.87, "text": "不也杀过仇家吗"}, {"start": 184.87, "end": 187.87, "text": "周沧说得也是啊"}, {"start": 188.87, "end": 193.49, "text": "你这山上"}, {"start": 193.49, "end": 194.49, "text": "还有很多的部族"}, {"start": 195.49, "end": 196.49, "text": "嫂嫂不肯留用"}, {"start": 197.49, "end": 198.49, "text": "周沧立刻"}, {"start": 198.49, "end": 199.49, "text": "遣散所有部众"}, {"start": 199.49, "end": 200.49, "text": "一把火烧了山寨"}, {"start": 200.49, "end": 201.49, "text": "只剩跟随将军"}, {"start": 202.49, "end": 205.09, "text": "稍候"}, {"start": 205.09, "end": 207.09, "text": "容我再禀告"}, {"start": 207.09, "end": 208.09, "text": "二位嫂嫂"}, {"start": 209.09, "end": 213.29, "text": "禀二位嫂嫂"}, {"start": 213.29, "end": 215.29, "text": "周沧情真意切"}, {"start": 215.29, "end": 217.29, "text": "他愿烧掉山寨"}, {"start": 217.29, "end": 218.29, "text": "遣散所有部族"}, {"start": 218.29, "end": 219.29, "text": "只身一人"}, {"start": 219.29, "end": 220.29, "text": "跟随关羽"}, {"start": 221.29, "end": 222.29, "text": "请二位嫂嫂"}, {"start": 223.29, "end": 225.29, "text": "如果只是他一人"}, {"start": 225.29, "end": 226.29, "text": "但随无妨"}, {"start": 227.29, "end": 242.25, "text": "周沧此生此世"}, {"start": 242.25, "end": 243.25, "text": "认定将军了"}, {"start": 244.25, "end": 245.25, "text": "周沧"}, {"start": 245.25, "end": 259.5, "text": "前面是什么地方"}, {"start": 259.5, "end": 260.5, "text": "前面五里就是古城"}, {"start": 261.5, "end": 262.5, "text": "我原本想占那个城池"}, {"start": 263.5, "end": 265.5, "text": "不想两个月以前"}, {"start": 265.5, "end": 266.5, "text": "来了个恶盗"}, {"start": 266.5, "end": 267.5, "text": "霸占了城池"}, {"start": 267.5, "end": 268.5, "text": "称王称霸"}, {"start": 269.5, "end": 270.5, "text": "方圆三百里"}, {"start": 271.5, "end": 272.5, "text": "没有人敢"}, {"start": 272.5, "end": 273.5, "text": "没有人敢惹他"}, {"start": 275.5, "end": 276.5, "text": "连你也不敢惹他吗"}, {"start": 277.5, "end": 278.5, "text": "那恶盗虎辈雄妖"}, {"start": 278.5, "end": 279.5, "text": "穷凶极恶"}, {"start": 281.5, "end": 282.5, "text": "我连占他三次"}, {"start": 283.5, "end": 284.5, "text": "都被他打败了"}, {"start": 285.5, "end": 286.5, "text": "敢不敢"}, {"start": 286.5, "end": 288.5, "text": "帮我上前通关"}, {"start": 289.5, "end": 290.5, "text": "有关将军在这"}, {"start": 290.5, "end": 291.5, "text": "就是那恶盗的末日"}, {"start": 292.5, "end": 293.5, "text": "我这就给你通关去"}, {"start": 294.5, "end": 295.5, "text": "令大司"}, {"start": 295.5, "end": 296.5, "text": "滚出城来"}, {"start": 296.5, "end": 300.18, "text": "孙乾"}, {"start": 301.18, "end": 302.18, "text": "在"}, {"start": 302.18, "end": 303.18, "text": "你押车慢行"}, {"start": 303.18, "end": 305.18, "text": "我先去打开城关"}, {"start": 305.18, "end": 306.18, "text": "再接你们入城"}, {"start": 307.18, "end": 308.18, "text": "遵命"}, {"start": 309.18, "end": 310.18, "text": "将军"}, {"start": 310.18, "end": 311.18, "text": "千万小心"}, {"start": 319.26, "end": 320.26, "text": "张将军"}, {"start": 320.26, "end": 321.26, "text": "我牛山的贼手周沧"}, {"start": 322.26, "end": 323.26, "text": "正在城外喊话"}, {"start": 323.26, "end": 324.26, "text": "叫将军滚出去"}, {"start": 327.26, "end": 328.26, "text": "不不不"}, {"start": 329.26, "end": 330.26, "text": "请将军出城"}, {"start": 331.26, "end": 332.26, "text": "手下外将"}, {"start": 332.26, "end": 333.26, "text": "也懒得踩他"}, {"start": 334.26, "end": 335.26, "text": "但这次"}, {"start": 335.26, "end": 336.26, "text": "不止他了"}, {"start": 337.26, "end": 338.26, "text": "来了另外一个将军"}, {"start": 338.26, "end": 340.26, "text": "姓关名语"}, {"start": 340.26, "end": 341.26, "text": "自云长"}, {"start": 342.26, "end": 345.91, "text": "什么"}, {"start": 345.91, "end": 346.91, "text": "关语"}, {"start": 347.91, "end": 348.91, "text": "不错"}, {"start": 348.91, "end": 349.91, "text": "正是将军的二哥"}, {"start": 350.91, "end": 351.91, "text": "将军"}, {"start": 351.91, "end": 352.91, "text": "不是日夜寻找他吗"}, {"start": 353.91, "end": 354.91, "text": "他来了"}, {"start": 354.91, "end": 355.91, "text": "好"}, {"start": 356.91, "end": 357.91, "text": "他来得好"}, {"start": 358.91, "end": 370.02, "text": "快快滚出来"}, {"start": 371.02, "end": 372.02, "text": "给我关将军磕头"}, {"start": 373.02, "end": 389.32, "text": "三弟"}, {"start": 389.32, "end": 400.14, "text": "是关语啊"}, {"start": 401.14, "end": 402.14, "text": "你是恶贼"}, {"start": 402.14, "end": 403.14, "text": "我没有你这二哥"}, {"start": 404.14, "end": 410.97, "text": "说清楚不行"}, {"start": 410.97, "end": 411.97, "text": "别"}, {"start": 412.97, "end": 413.97, "text": "好"}, {"start": 413.97, "end": 414.97, "text": "我让你死个明白"}, {"start": 415.97, "end": 416.97, "text": "我来问你"}, {"start": 417.97, "end": 418.97, "text": "你是否投降了曹操"}, {"start": 419.97, "end": 420.97, "text": "你是否被他"}, {"start": 421.97, "end": 422.97, "text": "拜剑封喉了"}, {"start": 427.81, "end": 428.81, "text": "你是否替他"}, {"start": 428.81, "end": 429.81, "text": "杀了颜良文筹"}, {"start": 434.68, "end": 438.08, "text": "贼子"}, {"start": 438.08, "end": 439.08, "text": "恩负义"}, {"start": 440.08, "end": 441.08, "text": "你还有脸来见我"}, {"start": 442.08, "end": 443.08, "text": "看我不戳你一万个窟窿"}, {"start": 444.08, "end": 445.08, "text": "三弟"}, {"start": 446.08, "end": 447.08, "text": "我之所以顺曹是为了"}, {"start": 448.08, "end": 449.08, "text": "保护嫂夫人"}, {"start": 449.08, "end": 450.08, "text": "寻找兄长下落"}, {"start": 451.08, "end": 452.08, "text": "那是万般无奈"}, {"start": 453.08, "end": 454.08, "text": "嫂夫人"}, {"start": 454.08, "end": 455.08, "text": "嫂夫人在哪里"}, {"start": 456.08, "end": 457.08, "text": "就在后面"}, {"start": 457.08, "end": 470.08, "text": "把曹军都带来了"}, {"start": 471.08, "end": 472.08, "text": "你还敢狡辩"}, {"start": 473.08, "end": 474.08, "text": "废话少说"}, {"start": 474.08, "end": 475.08, "text": "你先吃我一枪"}, {"start": 477.08, "end": 478.08, "text": "我斩了来将"}, {"start": 479.08, "end": 480.08, "text": "以表忠心"}, {"start": 481.08, "end": 482.08, "text": "好"}, {"start": 483.08, "end": 484.08, "text": "我在这里三通古罢"}, {"start": 485.08, "end": 486.08, "text": "你就要斩了那贼将"}, {"start": 487.08, "end": 488.08, "text": "否则"}, {"start": 488.08, "end": 489.08, "text": "你就是忘恩负义"}, {"start": 490.08, "end": 491.08, "text": "你就是个贼子"}, {"start": 491.08, "end": 492.08, "text": "是你杀了我外甥"}, {"start": 514.87, "end": 515.87, "text": "起气吧"}, {"start": 515.87, "end": 516.87, "text": "没错"}, {"start": 516.87, "end": 517.87, "text": "是我官毛所杀"}, {"start": 518.87, "end": 519.87, "text": "我要杀你顶面"}, {"start": 520.87, "end": 523.6, "text": "你通古罢"}, {"start": 523.6, "end": 533.85, "text": "本不想杀你"}, {"start": 534.85, "end": 535.85, "text": "可你屡次辱我"}, {"start": 535.85, "end": 536.85, "text": "今日"}, {"start": 536.85, "end": 537.85, "text": "我要取你手机"}, {"start": 538.85, "end": 539.85, "text": "洗我冤屈"}, {"start": 540.85, "end": 544.79, "text": "二通古罢"}, {"start": 570.77, "end": 573.82, "text": "三弟"}, {"start": 574.82, "end": 575.82, "text": "看到了吧"}, {"start": 575.82, "end": 576.82, "text": "关于何人"}, {"start": 577.82, "end": 579.82, "text": "永远不会忘恩负义"}, {"start": 595.45, "end": 629.47, "text": "好"}, {"start": 631.47, "end": 639.35, "text": "在下刚刚接报"}, {"start": 640.35, "end": 642.35, "text": "说刘备二弟关云长"}, {"start": 643.35, "end": 644.35, "text": "已经离开草草"}, {"start": 645.35, "end": 646.35, "text": "一路上"}, {"start": 646.35, "end": 647.35, "text": "他过五关斩六将"}, {"start": 648.35, "end": 649.35, "text": "千里走丹寂"}, {"start": 650.35, "end": 652.35, "text": "现在已经到达了汝南郡"}, {"start": 652.35, "end": 653.35, "text": "在一座古城中"}, {"start": 654.35, "end": 657.35, "text": "与其三弟张义德相会"}, {"start": 657.35, "end": 658.35, "text": "好啊"}, {"start": 658.35, "end": 660.35, "text": "汝南郡此不足二百里"}, {"start": 661.35, "end": 662.35, "text": "这三两日内"}, {"start": 662.35, "end": 663.35, "text": "他们就可以到了"}, {"start": 664.35, "end": 665.35, "text": "主公"}, {"start": 668.24, "end": 670.24, "text": "只是他们兄弟相会以后"}, {"start": 671.24, "end": 673.24, "text": "却在古城停留不前"}, {"start": 674.24, "end": 675.24, "text": "牵眼观望"}, {"start": 676.24, "end": 677.24, "text": "这是为何呢"}, {"start": 680.0, "end": 681.0, "text": "这"}, {"start": 681.0, "end": 682.0, "text": "主公"}, {"start": 682.0, "end": 684.0, "text": "这就得问问"}, {"start": 684.0, "end": 686.0, "text": "他们那生死与共的大哥"}, {"start": 686.0, "end": 687.0, "text": "刘备了"}, {"start": 688.0, "end": 689.0, "text": "报"}, {"start": 689.0, "end": 690.0, "text": "禀主公"}, {"start": 690.0, "end": 691.0, "text": "左将军刘备拜会"}, {"start": 695.62, "end": 696.62, "text": "叫我进来"}, {"start": 696.62, "end": 697.62, "text": "诺"}, {"start": 697.62, "end": 713.32, "text": "刘备拜见明公"}, {"start": 713.32, "end": 714.32, "text": "刘备"}, {"start": 714.32, "end": 723.74, "text": "我刚刚听说"}, {"start": 723.74, "end": 725.74, "text": "关羽离开草草了"}, {"start": 726.74, "end": 727.74, "text": "等他到了冀中"}, {"start": 728.74, "end": 730.74, "text": "我要将他斩首示众"}, {"start": 730.74, "end": 732.74, "text": "为严良文丑报仇"}, {"start": 732.74, "end": 733.74, "text": "以泄我恨"}, {"start": 734.74, "end": 735.74, "text": "严良文丑"}, {"start": 735.74, "end": 739.4, "text": "如同二鹿"}, {"start": 740.4, "end": 741.4, "text": "关羽如一虎"}, {"start": 742.4, "end": 743.4, "text": "明公失二鹿"}, {"start": 743.4, "end": 745.9, "text": "而得一虎"}, {"start": 746.9, "end": 747.9, "text": "何恨之有"}, {"start": 752.69, "end": 755.74, "text": "刚才"}, {"start": 755.74, "end": 756.74, "text": "刚才"}, {"start": 756.74, "end": 757.74, "text": "只是细言罢了"}, {"start": 759.74, "end": 760.74, "text": "我这么说是想"}, {"start": 760.74, "end": 761.74, "text": "试试你的心意"}, {"start": 762.74, "end": 763.74, "text": "其实啊"}, {"start": 763.74, "end": 765.74, "text": "我是非常喜爱关羽的"}, {"start": 766.74, "end": 767.74, "text": "你知道吗"}, {"start": 768.74, "end": 769.74, "text": "关羽他们现在"}, {"start": 769.74, "end": 771.74, "text": "已经到了汝南古城"}, {"start": 771.74, "end": 772.74, "text": "张飞也在那儿"}, {"start": 780.07, "end": 781.07, "text": "汝南距此不远"}, {"start": 781.07, "end": 782.07, "text": "那么"}, {"start": 782.07, "end": 784.07, "text": "我们兄弟几日后"}, {"start": 784.07, "end": 785.07, "text": "就可以相见了"}, {"start": 789.46, "end": 790.46, "text": "可是"}, {"start": 791.46, "end": 793.46, "text": "关羽他们在古城"}, {"start": 793.46, "end": 794.46, "text": "停留不前"}, {"start": 795.46, "end": 796.46, "text": "谦言观望"}, {"start": 797.46, "end": 801.03, "text": "你知道这其中的缘故吗"}, {"start": 803.03, "end": 804.03, "text": "在下不知"}, {"start": 804.03, "end": 806.03, "text": "我知道关羽的心思"}, {"start": 817.78, "end": 819.78, "text": "关羽因为杀了严良文丑"}, {"start": 820.78, "end": 821.78, "text": "对我有愧"}, {"start": 822.78, "end": 823.78, "text": "怕我治他的罪"}, {"start": 824.78, "end": 825.78, "text": "所以才在古城"}, {"start": 826.78, "end": 827.78, "text": "停留不前呢"}, {"start": 827.78, "end": 831.98, "text": "聪明见"}, {"start": 832.98, "end": 833.98, "text": "必然如此"}, {"start": 834.98, "end": 835.98, "text": "关羽素来忠义"}, {"start": 836.98, "end": 837.98, "text": "斩严良文丑之事"}, {"start": 837.98, "end": 839.98, "text": "定然会让他寝食不安"}, {"start": 840.98, "end": 841.98, "text": "柳威啊"}, {"start": 842.98, "end": 844.98, "text": "汝南距此不到二百里"}, {"start": 844.98, "end": 846.98, "text": "四日便可往返"}, {"start": 847.98, "end": 848.98, "text": "我想派你"}, {"start": 848.98, "end": 850.98, "text": "亲自前往汝南"}, {"start": 851.98, "end": 853.98, "text": "替我安抚关羽"}, {"start": 853.98, "end": 854.98, "text": "之后"}, {"start": 855.98, "end": 857.98, "text": "把关羽和张飞一同带来"}, {"start": 858.98, "end": 859.98, "text": "他们两人"}, {"start": 859.98, "end": 860.98, "text": "我都要重用啊"}, {"start": 861.98, "end": 866.22, "text": "遵命"}, {"start": 866.22, "end": 867.22, "text": "在下即刻"}, {"start": 867.22, "end": 868.22, "text": "选两马戍匹"}, {"start": 868.22, "end": 869.22, "text": "前往汝南"}, {"start": 869.22, "end": 870.22, "text": "四日之内"}, {"start": 870.22, "end": 871.22, "text": "携二弟三弟"}, {"start": 871.22, "end": 873.22, "text": "回来拜见明公"}, {"start": 874.22, "end": 875.22, "text": "去吧"}, {"start": 876.22, "end": 877.22, "text": "早去早回"}, {"start": 877.22, "end": 879.22, "text": "我静候佳音"}, {"start": 879.22, "end": 880.22, "text": "主公"}, {"start": 891.04, "end": 893.04, "text": "这刘备此一去"}, {"start": 894.04, "end": 896.04, "text": "恐怕再也不会回来了"}, {"start": 896.04, "end": 902.39, "text": "刘备乃正人君子"}, {"start": 903.39, "end": 904.39, "text": "他既然答应了我"}, {"start": 905.39, "end": 906.39, "text": "必不食言"}, {"start": 907.39, "end": 909.39, "text": "你不要以小人之心"}, {"start": 910.39, "end": 912.39, "text": "夺君子之父"}, {"start": 912.39, "end": 913.39, "text": "主公"}, {"start": 913.39, "end": 916.82, "text": "倒是在下"}, {"start": 917.82, "end": 921.03, "text": "错怪他了"}, {"start": 922.03, "end": 923.03, "text": "刘备"}, {"start": 923.03, "end": 924.03, "text": "刘玄德"}, {"start": 944.07, "end": 945.07, "text": "还不快快下马"}, {"start": 946.07, "end": 947.07, "text": "我徐悠"}, {"start": 948.07, "end": 950.74, "text": "候你多时了"}, {"start": 951.74, "end": 952.74, "text": "星台有何见教"}, {"start": 953.74, "end": 964.85, "text": "刘备"}, {"start": 964.85, "end": 965.85, "text": "我来问你"}, {"start": 968.1, "end": 971.41, "text": "你此一去汝南"}, {"start": 972.41, "end": 973.41, "text": "想必"}, {"start": 973.41, "end": 975.41, "text": "就再也不会回来了"}, {"start": 976.41, "end": 977.41, "text": "是也不是"}, {"start": 978.41, "end": 979.41, "text": "我曾奉劝过"}, {"start": 979.41, "end": 980.41, "text": "我曾奉劝我家主公"}, {"start": 981.41, "end": 982.41, "text": "一定要留住你"}, {"start": 983.41, "end": 984.41, "text": "徐兄为何相助"}, {"start": 988.45, "end": 989.45, "text": "你这可是害我"}, {"start": 991.45, "end": 992.45, "text": "刘备"}, {"start": 992.45, "end": 993.45, "text": "这不是明摆着吗"}, {"start": 994.45, "end": 995.45, "text": "你若在此"}, {"start": 995.45, "end": 999.14, "text": "你那生如手足的兄弟"}, {"start": 1000.14, "end": 1001.14, "text": "关与张飞"}, {"start": 1001.14, "end": 1002.14, "text": "势必前来相投"}, {"start": 1003.14, "end": 1004.14, "text": "然"}, {"start": 1004.14, "end": 1005.14, "text": "你若离去"}, {"start": 1007.14, "end": 1008.14, "text": "你们三兄弟相聚后"}, {"start": 1009.14, "end": 1010.14, "text": "又何必再来呢"}, {"start": 1012.14, "end": 1013.14, "text": "令徐兄"}, {"start": 1014.14, "end": 1015.14, "text": "我徐悠没有想到的是"}, {"start": 1016.14, "end": 1017.14, "text": "我这一片肺腑之言"}, {"start": 1018.14, "end": 1020.14, "text": "我家主公非但没有采纳"}, {"start": 1021.14, "end": 1022.14, "text": "反倒斥我"}, {"start": 1022.14, "end": 1024.14, "text": "是以小人之心"}, {"start": 1025.14, "end": 1026.14, "text": "夺君子之父"}, {"start": 1028.68, "end": 1029.68, "text": "你听见了"}, {"start": 1030.68, "end": 1032.68, "text": "这是何等的荒唐"}, {"start": 1034.68, "end": 1037.63, "text": "我徐悠"}, {"start": 1037.63, "end": 1038.63, "text": "一刘备"}, {"start": 1039.63, "end": 1041.63, "text": "反倒成了正人君子"}, {"start": 1043.94, "end": 1044.94, "text": "我家主公"}, {"start": 1044.94, "end": 1046.94, "text": "如此官人察事"}, {"start": 1046.94, "end": 1047.94, "text": "再一次证明"}, {"start": 1049.94, "end": 1050.94, "text": "证明大人"}, {"start": 1051.94, "end": 1055.95, "text": "是一个昏君"}, {"start": 1056.95, "end": 1059.46, "text": "徐兄啊"}, {"start": 1060.46, "end": 1062.46, "text": "我在济州客居半年多"}, {"start": 1063.46, "end": 1064.46, "text": "早已感受到"}, {"start": 1065.46, "end": 1066.46, "text": "袁绍不能成大事"}, {"start": 1068.46, "end": 1069.46, "text": "我如果继续留在这儿"}, {"start": 1070.46, "end": 1071.46, "text": "非但一无所为"}, {"start": 1072.46, "end": 1073.46, "text": "反而会有性命之限"}, {"start": 1074.46, "end": 1075.46, "text": "所以我必须离开这里"}, {"start": 1076.46, "end": 1077.46, "text": "只有这样"}, {"start": 1078.46, "end": 1080.46, "text": "我才能履行天子诏命"}, {"start": 1081.46, "end": 1082.46, "text": "举兵灭草"}, {"start": 1087.1, "end": 1088.1, "text": "好一个举兵灭草"}, {"start": 1089.1, "end": 1090.1, "text": "六辈"}, {"start": 1092.42, "end": 1094.42, "text": "就凭你现在这副潦倒的样子"}, {"start": 1095.42, "end": 1096.42, "text": "你还想"}, {"start": 1097.42, "end": 1099.42, "text": "你还敢与那奸贼曹操"}, {"start": 1099.42, "end": 1100.42, "text": "继续为敌吗"}, {"start": 1101.42, "end": 1104.08, "text": "想"}, {"start": 1104.08, "end": 1105.08, "text": "只要我还有一口气在"}, {"start": 1106.08, "end": 1107.08, "text": "我就会奋斗不止"}, {"start": 1114.8, "end": 1115.8, "text": "那我徐悠"}, {"start": 1116.8, "end": 1117.8, "text": "送你一刀剑"}, {"start": 1118.8, "end": 1119.8, "text": "你如果采纳"}, {"start": 1120.8, "end": 1121.8, "text": "我今天"}, {"start": 1121.8, "end": 1122.8, "text": "就放你走"}, {"start": 1124.8, "end": 1125.8, "text": "请讲"}, {"start": 1125.8, "end": 1130.83, "text": "当今天下"}, {"start": 1131.83, "end": 1132.83, "text": "虽然尚未一统"}, {"start": 1133.83, "end": 1135.83, "text": "但真正能与那曹操这奸贼"}, {"start": 1135.83, "end": 1136.83, "text": "相匹敌之人"}, {"start": 1137.83, "end": 1138.83, "text": "可谓屈指可数吧"}, {"start": 1140.83, "end": 1141.83, "text": "荆州刘表"}, {"start": 1142.83, "end": 1143.83, "text": "雄俱荆乡之九郡"}, {"start": 1144.83, "end": 1145.83, "text": "财大气粗"}, {"start": 1146.83, "end": 1147.83, "text": "兵精粮足"}, {"start": 1148.83, "end": 1150.83, "text": "他才是曹操的真正大敌"}, {"start": 1152.83, "end": 1153.83, "text": "只可惜我家主公袁绍"}, {"start": 1154.83, "end": 1155.83, "text": "与刘表似乎来不及"}, {"start": 1159.3, "end": 1160.3, "text": "这刘表"}, {"start": 1160.3, "end": 1161.3, "text": "一直暗兵未动"}, {"start": 1165.75, "end": 1166.75, "text": "你们三兄弟相会后"}, {"start": 1167.75, "end": 1168.75, "text": "一定共投刘表"}, {"start": 1169.75, "end": 1170.75, "text": "务必说服他"}, {"start": 1171.75, "end": 1172.75, "text": "举兵伐草"}, {"start": 1172.75, "end": 1175.9, "text": "徐兄啊徐兄"}, {"start": 1177.9, "end": 1178.9, "text": "不瞒你说我早有此意"}, {"start": 1179.9, "end": 1180.9, "text": "只是我怕袁绍阻拦"}, {"start": 1180.9, "end": 1181.9, "text": "我不敢跟他说"}, {"start": 1182.9, "end": 1183.9, "text": "刘敬生"}, {"start": 1183.9, "end": 1185.9, "text": "跟我同属皇族后裔"}, {"start": 1187.9, "end": 1188.9, "text": "我如劝他举兵"}, {"start": 1188.9, "end": 1189.9, "text": "他必会听从"}, {"start": 1192.75, "end": 1193.75, "text": "果真能够如此"}, {"start": 1194.75, "end": 1195.75, "text": "那么在下"}, {"start": 1195.75, "end": 1196.75, "text": "徐子远"}, {"start": 1197.75, "end": 1198.75, "text": "今天就当是"}, {"start": 1198.75, "end": 1199.75, "text": "为皇叔送刑了"}, {"start": 1200.75, "end": 1201.75, "text": "请吧"}, {"start": 1201.75, "end": 1202.75, "text": "上马"}, {"start": 1205.13, "end": 1216.75, "text": "多谢"}, {"start": 1216.75, "end": 1217.75, "text": "你明明知道袁绍"}, {"start": 1217.75, "end": 1218.75, "text": "并非英主"}, {"start": 1219.75, "end": 1222.45, "text": "为何不如"}, {"start": 1222.45, "end": 1223.45, "text": "随我一块去"}, {"start": 1228.96, "end": 1229.96, "text": "此言差矣"}, {"start": 1230.96, "end": 1231.96, "text": "有道是"}, {"start": 1232.96, "end": 1233.96, "text": "滴水之恩"}, {"start": 1234.96, "end": 1235.96, "text": "当饮泉相报"}, {"start": 1236.96, "end": 1238.96, "text": "我家主公虽然昏昧"}, {"start": 1238.96, "end": 1240.96, "text": "可对我有知遇之恩啊"}, {"start": 1242.96, "end": 1243.96, "text": "更何况"}, {"start": 1243.96, "end": 1244.96, "text": "我已经侍奉他"}, {"start": 1245.96, "end": 1246.96, "text": "有十余年之久了"}, {"start": 1247.96, "end": 1251.52, "text": "我实在是"}, {"start": 1252.52, "end": 1253.52, "text": "不忍心"}, {"start": 1253.52, "end": 1254.52, "text": "弃他而来"}, {"start": 1254.52, "end": 1262.37, "text": "徐兄"}, {"start": 1262.37, "end": 1263.37, "text": "保重"}, {"start": 1264.37, "end": 1265.37, "text": "人各有志"}, {"start": 1265.37, "end": 1295.87, "text": "从这里到冀州城"}, {"start": 1296.87, "end": 1297.87, "text": "只有一百多里了"}, {"start": 1297.87, "end": 1298.87, "text": "明日日落之前"}, {"start": 1299.87, "end": 1300.87, "text": "我们定可与兄长相会"}, {"start": 1301.87, "end": 1305.88, "text": "三弟"}, {"start": 1305.88, "end": 1306.88, "text": "这月时"}, {"start": 1307.88, "end": 1308.88, "text": "快与大哥相见"}, {"start": 1309.88, "end": 1310.88, "text": "我这心里"}, {"start": 1310.88, "end": 1311.88, "text": "越是不安呢"}, {"start": 1312.88, "end": 1313.88, "text": "这是为何"}, {"start": 1313.88, "end": 1314.88, "text": "兄长在袁绍手下"}, {"start": 1314.88, "end": 1317.48, "text": "为幕僚"}, {"start": 1318.48, "end": 1319.48, "text": "我却斩杀了他"}, {"start": 1319.48, "end": 1320.48, "text": "两缘大将"}, {"start": 1321.48, "end": 1329.71, "text": "这倒是个窘迫的事"}, {"start": 1330.71, "end": 1331.71, "text": "要不然这么着吧"}, {"start": 1331.71, "end": 1332.71, "text": "二哥在城外"}, {"start": 1332.71, "end": 1333.71, "text": "三十里等候"}, {"start": 1333.71, "end": 1335.71, "text": "我先进城与兄长相会"}, {"start": 1336.71, "end": 1338.71, "text": "顺便看看袁绍的虚实"}, {"start": 1339.71, "end": 1340.71, "text": "如果无事"}, {"start": 1340.71, "end": 1342.71, "text": "我回头来再见二哥"}, {"start": 1343.71, "end": 1344.71, "text": "卑尖兄长"}, {"start": 1345.71, "end": 1346.71, "text": "我过五关斩流将"}, {"start": 1346.71, "end": 1347.71, "text": "千里来寻"}, {"start": 1348.71, "end": 1350.71, "text": "现在就该相见了"}, {"start": 1350.71, "end": 1351.71, "text": "怕他作甚"}, {"start": 1352.71, "end": 1353.71, "text": "料那袁绍"}, {"start": 1354.71, "end": 1355.71, "text": "也不敢斩我人头"}, {"start": 1356.71, "end": 1358.71, "text": "他才舍不得杀你的"}, {"start": 1358.71, "end": 1359.71, "text": "他还要用你"}, {"start": 1359.71, "end": 1360.71, "text": "为他建功呢"}, {"start": 1361.71, "end": 1364.25, "text": "将军"}, {"start": 1364.25, "end": 1368.06, "text": "将军"}, {"start": 1368.06, "end": 1369.06, "text": "主堂这是为何"}, {"start": 1370.06, "end": 1371.06, "text": "我踏入踏到前面的谷口"}, {"start": 1372.06, "end": 1373.06, "text": "那里有座山寨"}, {"start": 1373.06, "end": 1374.06, "text": "原本是没有驻军的"}, {"start": 1375.06, "end": 1376.06, "text": "不想从哪儿冒出来一个将军"}, {"start": 1376.06, "end": 1377.06, "text": "引兵占住了山寨"}, {"start": 1378.06, "end": 1382.26, "text": "可是袁绍的部将"}, {"start": 1383.26, "end": 1384.26, "text": "在下不识得"}, {"start": 1384.26, "end": 1385.26, "text": "那人也不答应"}, {"start": 1385.26, "end": 1386.26, "text": "挥枪遍刺"}, {"start": 1386.26, "end": 1387.26, "text": "凶猛的厉害"}, {"start": 1388.26, "end": 1390.58, "text": "周苍 孙千"}, {"start": 1391.58, "end": 1392.58, "text": "守护驿车"}, {"start": 1392.58, "end": 1393.58, "text": "三弟"}, {"start": 1393.58, "end": 1394.58, "text": "我们前去看看"}, {"start": 1394.58, "end": 1395.58, "text": "好 走"}, {"start": 1395.58, "end": 1396.58, "text": "孙千 接着"}, {"start": 1396.58, "end": 1425.67, "text": "唐义德"}, {"start": 1425.67, "end": 1430.16, "text": "子龙兄弟"}, {"start": 1430.16, "end": 1431.16, "text": "义德"}, {"start": 1431.16, "end": 1432.16, "text": "子龙 真的是你"}, {"start": 1433.16, "end": 1434.16, "text": "这真是苍天开眼了"}, {"start": 1435.16, "end": 1436.16, "text": "你怎么会在这里"}, {"start": 1436.16, "end": 1437.16, "text": "自从叙州兵败之后"}, {"start": 1438.16, "end": 1439.16, "text": "我苦苦寻找主公"}, {"start": 1439.16, "end": 1440.16, "text": "跟你们的下落"}, {"start": 1440.16, "end": 1441.16, "text": "无奈之下"}, {"start": 1441.16, "end": 1442.16, "text": "只有回到幽州"}, {"start": 1442.16, "end": 1443.16, "text": "招募了公孙瓒的"}, {"start": 1443.16, "end": 1444.16, "text": "三千兵马"}, {"start": 1444.16, "end": 1445.16, "text": "又回到此地"}, {"start": 1445.16, "end": 1446.16, "text": "继续寻找你们跟主公"}, {"start": 1447.16, "end": 1448.16, "text": "子龙"}, {"start": 1448.16, "end": 1449.16, "text": "你可真了不起"}, {"start": 1449.16, "end": 1450.16, "text": "你啊"}, {"start": 1450.16, "end": 1451.16, "text": "不光自己回来"}, {"start": 1452.16, "end": 1453.16, "text": "还带回了一只兵马"}, {"start": 1454.16, "end": 1455.16, "text": "这比我在古城当县官"}, {"start": 1455.16, "end": 1456.16, "text": "可是强多了"}, {"start": 1457.16, "end": 1458.16, "text": "这座山寨"}, {"start": 1458.16, "end": 1459.16, "text": "名叫关定庄"}, {"start": 1459.16, "end": 1460.16, "text": "寨主与云长是同宗"}, {"start": 1461.16, "end": 1462.16, "text": "也姓关 叫关定"}, {"start": 1462.16, "end": 1463.16, "text": "此人静情豪爽"}, {"start": 1464.16, "end": 1465.16, "text": "伟人高义"}, {"start": 1465.16, "end": 1466.16, "text": "我这三千兵马住于此地"}, {"start": 1466.16, "end": 1467.16, "text": "他不收分文"}, {"start": 1468.16, "end": 1469.16, "text": "而且对两位兄长"}, {"start": 1469.16, "end": 1470.16, "text": "也是仰慕已久"}, {"start": 1470.16, "end": 1471.16, "text": "渴望见上一面了"}, {"start": 1472.16, "end": 1474.16, "text": "走 咱们进山寨喝酒去"}, {"start": 1474.16, "end": 1475.16, "text": "进庄 进庄"}, {"start": 1475.16, "end": 1476.16, "text": "走"}, {"start": 1484.33, "end": 1485.33, "text": "晚生拜见各位前辈"}, {"start": 1486.33, "end": 1489.66, "text": "关将军"}, {"start": 1490.66, "end": 1491.66, "text": "老朽有个心愿"}, {"start": 1492.66, "end": 1493.66, "text": "不知将军能否容纳"}, {"start": 1494.66, "end": 1495.66, "text": "关老太爷有何吩咐"}, {"start": 1496.66, "end": 1498.66, "text": "我想让他跟随将军外出"}, {"start": 1499.66, "end": 1500.66, "text": "在将军的鞍前马后"}, {"start": 1501.66, "end": 1502.66, "text": "历练一番"}, {"start": 1503.66, "end": 1504.66, "text": "或许能博个功名"}, {"start": 1506.66, "end": 1507.66, "text": "回禀老太爷"}, {"start": 1508.66, "end": 1509.66, "text": "在下的日子过于凶险"}, {"start": 1510.66, "end": 1511.66, "text": "万一有个闪失"}, {"start": 1512.66, "end": 1513.66, "text": "岂不隐恨终身"}, {"start": 1515.66, "end": 1516.66, "text": "不瞒将军说"}, {"start": 1517.66, "end": 1518.66, "text": "自从得知将军来了"}, {"start": 1520.66, "end": 1522.66, "text": "关平已经求过我好几次"}, {"start": 1523.66, "end": 1525.66, "text": "他定要跟随将军而去"}, {"start": 1526.66, "end": 1527.66, "text": "关将军"}, {"start": 1527.66, "end": 1528.66, "text": "你就收下我吧"}, {"start": 1529.66, "end": 1532.49, "text": "公子"}, {"start": 1533.49, "end": 1534.49, "text": "沙场征战"}, {"start": 1535.49, "end": 1536.49, "text": "绝非儿戏"}, {"start": 1536.49, "end": 1537.49, "text": "这我知道"}, {"start": 1538.49, "end": 1539.49, "text": "刀山火海"}, {"start": 1539.49, "end": 1540.49, "text": "绝无所惧"}, {"start": 1541.49, "end": 1542.49, "text": "好 好志气"}, {"start": 1543.49, "end": 1546.28, "text": "云长"}, {"start": 1546.28, "end": 1547.28, "text": "你看"}, {"start": 1547.28, "end": 1548.28, "text": "你也没有子嗣"}, {"start": 1550.28, "end": 1551.28, "text": "这关平"}, {"start": 1551.28, "end": 1552.28, "text": "英武过人"}, {"start": 1553.28, "end": 1554.28, "text": "你不如"}, {"start": 1554.28, "end": 1555.28, "text": "就把他收为义子"}, {"start": 1555.28, "end": 1556.28, "text": "对呀"}, {"start": 1556.28, "end": 1557.28, "text": "关将军"}, {"start": 1557.28, "end": 1558.28, "text": "你就收他做个义子吧"}, {"start": 1559.28, "end": 1560.28, "text": "这个我可做不了主"}, {"start": 1561.28, "end": 1562.28, "text": "还得"}, {"start": 1562.28, "end": 1563.28, "text": "禀过兄长才成"}, {"start": 1565.28, "end": 1566.28, "text": "二哥呀"}, {"start": 1566.28, "end": 1567.28, "text": "兄长不在"}, {"start": 1567.28, "end": 1568.28, "text": "兄弟说了也成啊"}, {"start": 1569.28, "end": 1570.28, "text": "二哥"}, {"start": 1570.28, "end": 1571.28, "text": "你暂且先收了"}, {"start": 1572.28, "end": 1573.28, "text": "等和兄长相会之时"}, {"start": 1574.28, "end": 1575.28, "text": "我和子龙兄弟"}, {"start": 1575.28, "end": 1576.28, "text": "替你说句话"}, {"start": 1577.28, "end": 1578.28, "text": "兄长岂能不准"}, {"start": 1578.28, "end": 1579.28, "text": "收了"}, {"start": 1579.28, "end": 1580.28, "text": "收了吧"}, {"start": 1580.28, "end": 1584.26, "text": "要我收你"}, {"start": 1585.26, "end": 1586.26, "text": "可有三个规矩"}, {"start": 1591.0, "end": 1592.0, "text": "人生在世"}, {"start": 1592.0, "end": 1593.0, "text": "义气重于性命"}, {"start": 1595.0, "end": 1596.0, "text": "第二是胆气"}, {"start": 1597.0, "end": 1598.0, "text": "无论是做将"}, {"start": 1598.0, "end": 1599.0, "text": "还是做士"}, {"start": 1600.0, "end": 1602.0, "text": "都要像相羽那样"}, {"start": 1602.0, "end": 1604.0, "text": "力拔山 气盖世"}, {"start": 1606.0, "end": 1607.0, "text": "第三是军规"}, {"start": 1608.0, "end": 1609.0, "text": "一旦从军"}, {"start": 1609.0, "end": 1610.0, "text": "法不容请"}, {"start": 1611.0, "end": 1612.0, "text": "禀将军"}, {"start": 1612.0, "end": 1613.0, "text": "我自自铭记"}, {"start": 1613.0, "end": 1614.0, "text": "好"}, {"start": 1615.0, "end": 1616.0, "text": "我收下你了"}, {"start": 1617.0, "end": 1618.0, "text": "谢将军"}, {"start": 1618.0, "end": 1619.0, "text": "孩儿叩见义父"}, {"start": 1620.0, "end": 1621.0, "text": "快起来吧"}, {"start": 1622.0, "end": 1623.0, "text": "拜见叔父"}, {"start": 1624.0, "end": 1625.0, "text": "拜见叔父"}, {"start": 1626.0, "end": 1627.0, "text": "来啊"}, {"start": 1627.0, "end": 1628.0, "text": "各位共饮此杯"}, {"start": 1629.0, "end": 1630.0, "text": "一谢苍天"}, {"start": 1631.0, "end": 1635.71, "text": "来"}, {"start": 1635.71, "end": 1636.71, "text": "外面有个叫咪芳的人"}, {"start": 1636.71, "end": 1637.71, "text": "前来求见"}, {"start": 1637.71, "end": 1638.71, "text": "咪芳 快叫她进来"}, {"start": 1641.15, "end": 1642.15, "text": "我的天哪"}, {"start": 1642.15, "end": 1643.15, "text": "你们都在这儿呢"}, {"start": 1643.15, "end": 1647.8, "text": "关将军"}, {"start": 1647.8, "end": 1648.8, "text": "快说"}, {"start": 1648.8, "end": 1649.8, "text": "兄长在呢"}, {"start": 1649.8, "end": 1650.8, "text": "容我先喘口气"}, {"start": 1651.8, "end": 1652.8, "text": "主公听说你们在古城"}, {"start": 1652.8, "end": 1654.8, "text": "昨天就已经离开了冀州"}, {"start": 1654.8, "end": 1655.8, "text": "欲与你们相会"}, {"start": 1656.8, "end": 1657.8, "text": "主公令我提前赶来"}, {"start": 1657.8, "end": 1658.8, "text": "向你们报个信"}, {"start": 1659.8, "end": 1660.8, "text": "主公"}, {"start": 1660.8, "end": 1662.8, "text": "既然已经前往古城"}, {"start": 1662.8, "end": 1664.8, "text": "那我们就赶紧折道返回吧"}, {"start": 1665.8, "end": 1666.8, "text": "老太爷"}, {"start": 1666.8, "end": 1667.8, "text": "告辞了"}, {"start": 1667.8, "end": 1741.66, "text": "告辞了"}, {"start": 1741.66, "end": 1742.66, "text": "大哥"}, {"start": 1742.66, "end": 1745.71, "text": "大哥"}, {"start": 1754.23, "end": 1762.66, "text": "我这下你下得好苦啊"}, {"start": 1763.66, "end": 1777.88, "text": "你这干什么"}, {"start": 1777.88, "end": 1778.88, "text": "来 大哥 起"}, {"start": 1778.88, "end": 1788.23, "text": "起来"}, {"start": 1788.23, "end": 1789.23, "text": "拜董相亲"}, {"start": 1789.23, "end": 1790.23, "text": "就拜 就拜"}, {"start": 1790.23, "end": 1791.23, "text": "拜"}, {"start": 1791.23, "end": 1792.23, "text": "来 喝"}, {"start": 1792.23, "end": 1802.64, "text": "十年前"}, {"start": 1803.64, "end": 1806.64, "text": "我三兄弟在聚禄桃园结译"}, {"start": 1806.64, "end": 1809.18, "text": "今日"}, {"start": 1810.18, "end": 1811.18, "text": "我们四兄弟"}, {"start": 1811.18, "end": 1813.18, "text": "又在古城桃园相会"}, {"start": 1814.18, "end": 1816.18, "text": "此生此世"}, {"start": 1816.18, "end": 1818.18, "text": "此情此景"}, {"start": 1818.18, "end": 1820.18, "text": "感慨万千"}, {"start": 1820.18, "end": 1827.19, "text": "一德"}, {"start": 1828.19, "end": 1831.08, "text": "这桃树怎么了"}, {"start": 1832.08, "end": 1833.08, "text": "怎么七零八落的"}, {"start": 1837.08, "end": 1838.08, "text": "哥哥"}, {"start": 1838.08, "end": 1839.08, "text": "这都是小弟的错"}, {"start": 1840.08, "end": 1841.08, "text": "我这一听说呀"}, {"start": 1841.08, "end": 1842.08, "text": "二哥想了草草"}, {"start": 1843.08, "end": 1844.08, "text": "这气得我呀"}, {"start": 1844.08, "end": 1846.08, "text": "我 我都快气死了"}, {"start": 1847.08, "end": 1848.08, "text": "没法子"}, {"start": 1848.08, "end": 1849.08, "text": "我拿了根棍"}, {"start": 1849.08, "end": 1851.08, "text": "把这桃园给打了个遍"}, {"start": 1854.08, "end": 1857.64, "text": "来年新春"}, {"start": 1858.64, "end": 1860.64, "text": "这桃树定会再发新枝"}, {"start": 1862.64, "end": 1863.64, "text": "这桃园"}, {"start": 1863.64, "end": 1865.64, "text": "就像我等兄弟的遭际"}, {"start": 1866.64, "end": 1867.64, "text": "虽然叠遭厄运"}, {"start": 1867.64, "end": 1868.64, "text": "颠沛流离"}, {"start": 1868.64, "end": 1869.64, "text": "但最终"}, {"start": 1869.64, "end": 1871.64, "text": "定会疲极泰来"}, {"start": 1871.64, "end": 1872.64, "text": "再现繁荣"}, {"start": 1872.64, "end": 1873.64, "text": "好"}, {"start": 1873.64, "end": 1875.64, "text": "大哥说得好啊"}, {"start": 1875.64, "end": 1876.64, "text": "当饮一杯"}, {"start": 1876.64, "end": 1877.64, "text": "来"}, {"start": 1877.64, "end": 1878.64, "text": "那主公"}, {"start": 1878.64, "end": 1889.18, "text": "日后有何打算"}, {"start": 1890.18, "end": 1891.18, "text": "还是子隆心细"}, {"start": 1891.18, "end": 1895.16, "text": "早早就想下一步"}, {"start": 1895.16, "end": 1896.16, "text": "下一步嘛"}, {"start": 1896.16, "end": 1899.72, "text": "我们要去荆州"}, {"start": 1902.06, "end": 1903.06, "text": "荆州"}, {"start": 1903.06, "end": 1904.06, "text": "荆州"}, {"start": 1904.06, "end": 1905.06, "text": "对"}, {"start": 1906.06, "end": 1908.06, "text": "拜会荆州刺史刘表"}, {"start": 1909.06, "end": 1910.06, "text": "劝他与袁绍联手"}, {"start": 1911.06, "end": 1912.06, "text": "举兵发草"}, {"start": 1912.06, "end": 1913.06, "text": "我上表汉地"}, {"start": 1921.36, "end": 1923.36, "text": "让他封我为大司马的事情"}, {"start": 1924.36, "end": 1926.36, "text": "许昌已经回消息了"}, {"start": 1927.36, "end": 1928.36, "text": "竟然不许"}, {"start": 1930.36, "end": 1931.36, "text": "曹操是看我在江东"}, {"start": 1931.36, "end": 1932.36, "text": "日渐强盛"}, {"start": 1933.36, "end": 1935.36, "text": "才故意驳回我的请求"}, {"start": 1935.36, "end": 1936.36, "text": "主公"}, {"start": 1938.67, "end": 1940.67, "text": "昨日防江将士截获一封"}, {"start": 1940.67, "end": 1942.67, "text": "吴郡太守许共"}, {"start": 1942.67, "end": 1943.67, "text": "给曹操的密报"}, {"start": 1944.67, "end": 1945.67, "text": "念"}, {"start": 1945.67, "end": 1946.67, "text": "丞相"}, {"start": 1946.67, "end": 1954.08, "text": "孙策骁勇"}, {"start": 1954.08, "end": 1955.08, "text": "他与项羽比肩"}, {"start": 1956.08, "end": 1958.08, "text": "朝廷以外事荣宠"}, {"start": 1958.08, "end": 1960.08, "text": "召唤京师加以控制"}, {"start": 1961.08, "end": 1963.08, "text": "不可使其居外阵"}, {"start": 1963.08, "end": 1964.08, "text": "以为后患"}, {"start": 1966.08, "end": 1967.08, "text": "大胆许共"}, {"start": 1967.08, "end": 1969.08, "text": "竟敢勾结曹操"}, {"start": 1969.08, "end": 1970.08, "text": "谋害玉王"}, {"start": 1971.08, "end": 1972.08, "text": "主公息怒"}, {"start": 1973.08, "end": 1974.08, "text": "许共"}, {"start": 1977.45, "end": 1978.45, "text": "如若不处"}, {"start": 1978.45, "end": 1979.45, "text": "大患"}, {"start": 1982.4, "end": 1983.4, "text": "你去"}, {"start": 1983.4, "end": 1984.4, "text": "替他人头来降"}, {"start": 1986.4, "end": 1987.4, "text": "遵命"}, {"start": 1988.4, "end": 2008.25, "text": "金阁百万"}, {"start": 2009.25, "end": 2010.25, "text": "钦在握"}, {"start": 2011.25, "end": 2012.25, "text": "引霸回首"}, {"start": 2018.3, "end": 2019.3, "text": "真是好诗"}, {"start": 2019.3, "end": 2020.3, "text": "好诗"}, {"start": 2020.3, "end": 2021.3, "text": "好好好"}, {"start": 2022.3, "end": 2023.3, "text": "主公"}, {"start": 2023.3, "end": 2024.3, "text": "出祸事了"}, {"start": 2024.3, "end": 2025.3, "text": "朕高兴着呢"}, {"start": 2026.3, "end": 2027.3, "text": "又有什么祸事"}, {"start": 2028.3, "end": 2029.3, "text": "古城县令差人禀报"}, {"start": 2030.3, "end": 2031.3, "text": "刘备 关羽 张飞 赵云"}, {"start": 2032.3, "end": 2033.3, "text": "在古城相会后"}, {"start": 2033.3, "end": 2034.3, "text": "集兵数千"}, {"start": 2034.3, "end": 2035.3, "text": "往西而去"}, {"start": 2036.3, "end": 2037.3, "text": "往西"}, {"start": 2039.81, "end": 2040.81, "text": "他难道不回冀州了吗"}, {"start": 2040.81, "end": 2041.81, "text": "主公"}, {"start": 2041.81, "end": 2042.81, "text": "你还指望刘备回来吗"}, {"start": 2043.81, "end": 2045.81, "text": "他一定是投奔曹操去了"}, {"start": 2046.81, "end": 2049.22, "text": "退下"}, {"start": 2049.22, "end": 2054.89, "text": "徐水流上"}, {"start": 2055.89, "end": 2056.89, "text": "探如河"}, {"start": 2057.89, "end": 2058.89, "text": "人生如梦"}, {"start": 2059.89, "end": 2060.89, "text": "亦蹉跎"}, {"start": 2061.89, "end": 2063.89, "text": "这自运绝妙"}, {"start": 2064.89, "end": 2065.89, "text": "好诗啊"}, {"start": 2069.0, "end": 2070.0, "text": "许妖"}, {"start": 2070.0, "end": 2071.0, "text": "在"}, {"start": 2071.0, "end": 2072.0, "text": "刘备叛我"}, {"start": 2073.0, "end": 2074.0, "text": "投奔曹操而去"}, {"start": 2075.0, "end": 2076.0, "text": "非爷"}, {"start": 2076.0, "end": 2077.0, "text": "非爷"}, {"start": 2078.0, "end": 2079.0, "text": "兵主公"}, {"start": 2080.0, "end": 2081.0, "text": "依在下判断"}, {"start": 2082.0, "end": 2084.0, "text": "那刘备对曹操恨之辱"}, {"start": 2085.0, "end": 2086.0, "text": "可以说是不共戴天"}, {"start": 2087.0, "end": 2088.0, "text": "故"}, {"start": 2088.0, "end": 2089.0, "text": "在下可以断言"}, {"start": 2090.0, "end": 2091.0, "text": "刘玄德绝不会投曹"}, {"start": 2092.0, "end": 2093.0, "text": "然"}, {"start": 2093.0, "end": 2094.0, "text": "他果真是西去了的话"}, {"start": 2096.31, "end": 2097.31, "text": "那他一定"}, {"start": 2097.31, "end": 2098.31, "text": "是投了"}, {"start": 2098.31, "end": 2099.31, "text": "荆州的刘表"}, {"start": 2102.17, "end": 2103.17, "text": "试图以荆襄九郡为靠"}, {"start": 2104.17, "end": 2105.17, "text": "再图"}, {"start": 2105.17, "end": 2111.48, "text": "难道"}, {"start": 2112.48, "end": 2113.48, "text": "我还不如刘表吗"}, {"start": 2114.48, "end": 2118.59, "text": "我对刘备是恩爱有价"}, {"start": 2118.59, "end": 2119.59, "text": "他却对我食言"}, {"start": 2120.59, "end": 2121.59, "text": "背我"}, {"start": 2121.59, "end": 2122.59, "text": "欺我"}, {"start": 2122.59, "end": 2126.61, "text": "尤其是他那个弟弟关羽"}, {"start": 2127.61, "end": 2129.61, "text": "还杀了我的大将严良文丑"}, {"start": 2130.61, "end": 2134.11, "text": "如不将这三个贼兄弟斩首"}, {"start": 2135.11, "end": 2137.11, "text": "难消我心头的怒气"}, {"start": 2138.11, "end": 2139.11, "text": "郭托"}, {"start": 2139.11, "end": 2141.11, "text": "我想刘备尚未走远"}, {"start": 2143.11, "end": 2144.11, "text": "你速派五千铁骑"}, {"start": 2145.11, "end": 2146.11, "text": "清夜追杀"}, {"start": 2146.11, "end": 2147.11, "text": "一定要拿住他们"}, {"start": 2148.11, "end": 2149.11, "text": "不可不可"}, {"start": 2149.11, "end": 2150.11, "text": "主公"}, {"start": 2150.11, "end": 2151.11, "text": "我"}, {"start": 2151.11, "end": 2152.11, "text": "万万不可"}, {"start": 2154.11, "end": 2155.11, "text": "区区一个刘备"}, {"start": 2156.11, "end": 2158.11, "text": "焉能成为武之大敌啊"}, {"start": 2159.11, "end": 2160.11, "text": "依在下之见"}, {"start": 2162.11, "end": 2163.11, "text": "倒是那曹操"}, {"start": 2164.11, "end": 2166.55, "text": "主公"}, {"start": 2166.55, "end": 2167.55, "text": "你一向明鉴"}, {"start": 2168.55, "end": 2169.55, "text": "此事"}, {"start": 2169.55, "end": 2171.55, "text": "你还要三思啊"}, {"start": 2177.16, "end": 2179.16, "text": "我们当前的大敌"}, {"start": 2179.16, "end": 2180.16, "text": "是曹操"}, {"start": 2181.16, "end": 2184.4, "text": "而不是刘备"}, {"start": 2185.4, "end": 2187.84, "text": "主公明鉴"}, {"start": 2188.84, "end": 2189.84, "text": "主公"}, {"start": 2189.84, "end": 2190.84, "text": "圣明"}, {"start": 2191.84, "end": 2192.84, "text": "报"}, {"start": 2193.84, "end": 2194.84, "text": "禀主公"}, {"start": 2194.84, "end": 2195.84, "text": "长公子元潭"}, {"start": 2195.84, "end": 2196.84, "text": "率军十万从青州而来"}, {"start": 2197.84, "end": 2198.84, "text": "二公子元兮"}, {"start": 2198.84, "end": 2199.84, "text": "率军十五万从幽州而来"}, {"start": 2199.84, "end": 2200.84, "text": "三公子元尚"}, {"start": 2200.84, "end": 2202.84, "text": "率军十五万从并州而来"}, {"start": 2202.84, "end": 2203.84, "text": "好啊"}, {"start": 2204.84, "end": 2205.84, "text": "传令所有文武"}, {"start": 2206.84, "end": 2207.84, "text": "明日辰迟"}, {"start": 2208.84, "end": 2209.84, "text": "到帅府议兵"}, {"start": 2210.84, "end": 2211.84, "text": "遵命"}, {"start": 2211.84, "end": 2212.84, "text": "主公有令"}, {"start": 2213.84, "end": 2214.84, "text": "传"}, {"start": 2214.84, "end": 2215.84, "text": "青州次使元潭"}, {"start": 2216.84, "end": 2218.84, "text": "幽州太守元兮"}, {"start": 2219.84, "end": 2221.84, "text": "幽州上将元尚天天"}, {"start": 2221.84, "end": 2231.51, "text": "元尚兮"}, {"start": 2231.51, "end": 2232.51, "text": "拜见副帅"}, {"start": 2233.51, "end": 2234.51, "text": "副帅"}, {"start": 2234.51, "end": 2235.51, "text": "儿新练成的铁甲战阵"}, {"start": 2235.51, "end": 2236.51, "text": "如果排不开来"}, {"start": 2237.51, "end": 2238.51, "text": "又如苍龙出海"}, {"start": 2238.51, "end": 2239.51, "text": "猛虎下山"}, {"start": 2239.51, "end": 2241.51, "text": "天下无人可敌"}, {"start": 2242.51, "end": 2243.51, "text": "副帅"}, {"start": 2243.51, "end": 2245.51, "text": "儿请命为先锋大将"}, {"start": 2245.51, "end": 2247.51, "text": "我有唐儿的铁甲战阵"}, {"start": 2248.51, "end": 2249.51, "text": "破曹军"}, {"start": 2249.51, "end": 2250.51, "text": "易如反掌"}, {"start": 2254.39, "end": 2255.39, "text": "唐儿"}, {"start": 2255.39, "end": 2256.39, "text": "英雄啊"}, {"start": 2257.39, "end": 2258.39, "text": "英雄"}, {"start": 2259.39, "end": 2260.39, "text": "副帅"}, {"start": 2260.39, "end": 2261.39, "text": "新练成霹雳战车阵"}, {"start": 2262.39, "end": 2263.39, "text": "一旦部长开来"}, {"start": 2263.39, "end": 2264.39, "text": "定当山呼海啸"}, {"start": 2265.39, "end": 2266.39, "text": "雷霆万军"}, {"start": 2266.39, "end": 2267.39, "text": "无论何人军队"}, {"start": 2267.39, "end": 2268.39, "text": "想与之抗衡"}, {"start": 2268.39, "end": 2269.39, "text": "眨眼间"}, {"start": 2269.39, "end": 2270.39, "text": "定叫他灰飞烟灭"}, {"start": 2271.39, "end": 2272.39, "text": "请父王下令"}, {"start": 2272.39, "end": 2274.39, "text": "儿越做先锋大将"}, {"start": 2275.39, "end": 2277.39, "text": "我有唐儿的霹雳战车阵"}, {"start": 2278.39, "end": 2279.39, "text": "破曹操三军"}, {"start": 2280.39, "end": 2282.39, "text": "真如同滚滚雷霆"}, {"start": 2283.39, "end": 2284.39, "text": "及腐败洛燕儿"}, {"start": 2286.39, "end": 2287.39, "text": "唐儿"}, {"start": 2287.39, "end": 2288.39, "text": "英雄啊"}, {"start": 2288.39, "end": 2289.39, "text": "英雄"}, {"start": 2290.39, "end": 2292.99, "text": "副帅"}, {"start": 2293.99, "end": 2295.99, "text": "孩儿所练得的剑弩阵"}, {"start": 2295.99, "end": 2296.99, "text": "装备着新进打造的"}, {"start": 2296.99, "end": 2298.99, "text": "五万幅强弓硬弩"}, {"start": 2298.99, "end": 2300.99, "text": "其每一支利剑"}, {"start": 2300.99, "end": 2302.99, "text": "百步之内都能射胸腹"}, {"start": 2302.99, "end": 2303.99, "text": "五十步之内"}, {"start": 2303.99, "end": 2305.99, "text": "能射透曹军的甲冲"}, {"start": 2305.99, "end": 2306.99, "text": "据而判断"}, {"start": 2307.99, "end": 2309.99, "text": "副帅此次起兵灭曹"}, {"start": 2309.99, "end": 2310.99, "text": "其决战的战场"}, {"start": 2310.99, "end": 2312.99, "text": "必定设在关渡一旦"}, {"start": 2313.99, "end": 2314.99, "text": "因此"}, {"start": 2314.99, "end": 2315.99, "text": "孩儿已经预先"}, {"start": 2315.99, "end": 2316.99, "text": "将兵器 军粮"}, {"start": 2316.99, "end": 2318.99, "text": "以及攻城所必需的军械"}, {"start": 2318.99, "end": 2320.99, "text": "全部运往了距离关渡"}, {"start": 2320.99, "end": 2322.99, "text": "几十里的乌巢镇"}, {"start": 2323.99, "end": 2324.99, "text": "并在那里"}, {"start": 2324.99, "end": 2327.99, "text": "为副帅的大军扎好了营盘"}, {"start": 2327.99, "end": 2328.99, "text": "兵马未动"}, {"start": 2329.99, "end": 2330.99, "text": "粮草先行"}, {"start": 2331.99, "end": 2333.99, "text": "尚儿年纪轻轻"}, {"start": 2333.99, "end": 2335.99, "text": "却也是文武双全"}, {"start": 2335.99, "end": 2338.99, "text": "此乃大将之风范啊"}, {"start": 2339.99, "end": 2340.99, "text": "禀副帅"}, {"start": 2340.99, "end": 2341.99, "text": "孩儿以为"}, {"start": 2341.99, "end": 2342.99, "text": "临敌至胜"}, {"start": 2342.99, "end": 2343.99, "text": "需志勇双全"}, {"start": 2344.99, "end": 2345.99, "text": "儿虽不才"}, {"start": 2345.99, "end": 2347.99, "text": "但愿谨为先锋大将"}, {"start": 2348.99, "end": 2349.99, "text": "而若不胜"}, {"start": 2349.99, "end": 2351.99, "text": "请副帅将儿斩首正法"}, {"start": 2352.99, "end": 2357.86, "text": "儿应请"}, {"start": 2357.86, "end": 2360.14, "text": "王子令"}, {"start": 2360.14, "end": 2364.18, "text": "副帅"}, {"start": 2364.18, "end": 2366.18, "text": "儿愿为先锋大将"}, {"start": 2366.18, "end": 2367.18, "text": "儿的铁甲战阵"}, {"start": 2367.18, "end": 2368.18, "text": "副帅"}, {"start": 2368.18, "end": 2370.18, "text": "儿非做先锋大将不可"}, {"start": 2370.18, "end": 2371.18, "text": "如不胜"}, {"start": 2371.18, "end": 2372.18, "text": "儿愿提头来见"}, {"start": 2372.18, "end": 2373.18, "text": "副帅"}, {"start": 2373.18, "end": 2375.18, "text": "大哥二哥都是我的兄长"}, {"start": 2375.18, "end": 2376.18, "text": "身负大任"}, {"start": 2376.18, "end": 2377.18, "text": "但临敌接战"}, {"start": 2377.18, "end": 2379.18, "text": "性命交关"}, {"start": 2379.18, "end": 2380.18, "text": "还是请副帅"}, {"start": 2380.18, "end": 2381.18, "text": "让我为先锋大将"}, {"start": 2381.18, "end": 2382.18, "text": "小哥不太"}, {"start": 2383.18, "end": 2384.18, "text": "三个公子"}, {"start": 2384.18, "end": 2386.18, "text": "都在征服先锋"}, {"start": 2386.18, "end": 2387.18, "text": "我为先锋大将"}, {"start": 2387.18, "end": 2388.18, "text": "主公为难了"}, {"start": 2389.18, "end": 2391.18, "text": "主公尚未立死"}, {"start": 2392.18, "end": 2394.18, "text": "三个公子都在急做先锋"}, {"start": 2394.18, "end": 2395.18, "text": "其实"}, {"start": 2396.18, "end": 2397.18, "text": "是在征大位"}, {"start": 2398.18, "end": 2399.18, "text": "那么你估计"}, {"start": 2400.18, "end": 2402.18, "text": "主公会立谁为先锋大将"}, {"start": 2403.18, "end": 2405.18, "text": "这次和曹操决战"}, {"start": 2405.18, "end": 2406.18, "text": "事关重大"}, {"start": 2408.18, "end": 2409.18, "text": "先锋大将"}, {"start": 2410.18, "end": 2411.18, "text": "我决定由"}, {"start": 2421.14, "end": 2422.14, "text": "由我袁绍"}, {"start": 2423.14, "end": 2424.14, "text": "亲自担当"}, {"start": 2425.14, "end": 2426.14, "text": "这次灭曹"}, {"start": 2427.14, "end": 2428.14, "text": "主公高明啊"}, {"start": 2429.14, "end": 2430.14, "text": "我跟你说"}, {"start": 2431.14, "end": 2433.14, "text": "主公一旦携命起来"}, {"start": 2433.14, "end": 2435.14, "text": "那是比天下任何主公都携命"}, {"start": 2436.14, "end": 2437.14, "text": "没错没错"}, {"start": 2440.14, "end": 2441.14, "text": "听令"}, {"start": 2441.14, "end": 2445.12, "text": "后日正午"}, {"start": 2446.12, "end": 2447.12, "text": "三军齐聚关前"}, {"start": 2448.12, "end": 2451.12, "text": "举行灭曹操事事大会"}, {"start": 2452.12, "end": 2453.12, "text": "祭天"}, {"start": 2453.12, "end": 2454.12, "text": "祭地"}, {"start": 2454.12, "end": 2455.12, "text": "祭祖"}, {"start": 2456.12, "end": 2457.12, "text": "杀薛"}, {"start": 2458.12, "end": 2459.12, "text": "出征"}, {"start": 2459.12, "end": 2460.12, "text": "遵命"}]