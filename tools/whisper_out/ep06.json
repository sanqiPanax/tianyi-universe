[{"start": 14.03, "end": 15.83, "text": "你为何把洛阳让给孙监"}, {"start": 15.83, "end": 17.35, "text": "自己却要追杀祖国呢"}, {"start": 18.03, "end": 20.11, "text": "你说是一片废墟重要呢"}, {"start": 20.11, "end": 21.63, "text": "还是一个天子重要"}, {"start": 22.03, "end": 23.27, "text": "那当然是天子了"}, {"start": 23.71, "end": 25.99, "text": "洛阳也是一片废墟"}, {"start": 25.99, "end": 27.07, "text": "无用之物"}, {"start": 27.63, "end": 29.59, "text": "天子才是宝中之马"}, {"start": 29.95, "end": 32.03, "text": "如果我们能劫回圣驾"}, {"start": 32.03, "end": 33.99, "text": "绝对是汉庭屠宫"}, {"start": 34.31, "end": 35.43, "text": "从此之后"}, {"start": 35.43, "end": 36.63, "text": "各镇诸侯"}, {"start": 36.91, "end": 38.79, "text": "都要对我们刮目相看"}, {"start": 38.99, "end": 41.59, "text": "朝廷至少也得设封我为"}, {"start": 41.63, "end": 44.27, "text": "以西梁自首或者是金州人来说"}, {"start": 44.83, "end": 45.67, "text": "由此"}, {"start": 45.95, "end": 48.27, "text": "我们就可以奠定大业"}, {"start": 48.67, "end": 49.59, "text": "末将明白了"}, {"start": 50.11, "end": 51.07, "text": "不过大哥呀"}, {"start": 51.07, "end": 52.75, "text": "我们明明只有四千兵马"}, {"start": 52.75, "end": 53.99, "text": "你为何对孙监说"}, {"start": 53.99, "end": 55.27, "text": "我没有万余经济呀"}, {"start": 56.43, "end": 57.59, "text": "如果我不这么说"}, {"start": 57.59, "end": 58.95, "text": "他能把他的三千战器"}, {"start": 58.95, "end": 59.91, "text": "交给我吗"}, {"start": 61.91, "end": 62.59, "text": "大哥"}, {"start": 62.87, "end": 64.39, "text": "此行我们是孤军追杀"}, {"start": 64.75, "end": 65.95, "text": "永卓虽然败了"}, {"start": 65.95, "end": 67.15, "text": "但他的西梁败军"}, {"start": 67.15, "end": 68.59, "text": "仍然不下于数万呀"}, {"start": 68.79, "end": 71.27, "text": "称圣精军不在兵马"}, {"start": 72.11, "end": 74.47, "text": "沸逃之事无惧其多"}, {"start": 75.03, "end": 76.43, "text": "可吕布在他身边呀"}, {"start": 76.59, "end": 78.35, "text": "此人可是骁勇无比呀"}, {"start": 79.55, "end": 80.59, "text": "你估计自己"}, {"start": 80.59, "end": 81.83, "text": "站得过吕布吗"}, {"start": 82.47, "end": 83.27, "text": "惭愧"}, {"start": 83.71, "end": 84.91, "text": "如论咱打独斗"}, {"start": 84.91, "end": 85.99, "text": "我非他之敌"}, {"start": 86.31, "end": 87.47, "text": "但如论排兵雇阵"}, {"start": 87.47, "end": 88.47, "text": "他不是我的对手"}, {"start": 88.91, "end": 89.79, "text": "说对了"}, {"start": 90.39, "end": 91.87, "text": "吕布虽然小勇"}, {"start": 92.07, "end": 93.35, "text": "却是一剑匹夫"}, {"start": 93.35, "end": 94.67, "text": "绝对撑不了气候"}, {"start": 95.19, "end": 96.47, "text": "西梁军虽多"}, {"start": 96.75, "end": 98.19, "text": "也是强弩之末"}, {"start": 98.59, "end": 99.75, "text": "我军虽少"}, {"start": 100.15, "end": 101.75, "text": "却是乘胜追击"}, {"start": 102.03, "end": 104.23, "text": "两者一胜一衰"}, {"start": 104.35, "end": 105.51, "text": "胜负力霸"}, {"start": 106.63, "end": 107.27, "text": "听着"}, {"start": 107.83, "end": 108.87, "text": "进敌之后"}, {"start": 109.47, "end": 110.51, "text": "你无需立战"}, {"start": 110.83, "end": 112.15, "text": "只要多步移兵"}, {"start": 112.15, "end": 113.27, "text": "虚张声势"}, {"start": 113.43, "end": 115.71, "text": "让西梁军浑飞胆丧即可"}, {"start": 116.35, "end": 117.67, "text": "而交战之时"}, {"start": 117.95, "end": 119.43, "text": "你也不要去站吕布"}, {"start": 119.67, "end": 121.67, "text": "更不用去取董卓的首级"}, {"start": 121.91, "end": 124.15, "text": "我只要你不顾一切地冲上去"}, {"start": 124.15, "end": 125.75, "text": "给我劫回田子即可"}, {"start": 126.15, "end": 126.75, "text": "遵命"}, {"start": 130.75, "end": 143.94, "text": "田子啊"}, {"start": 145.62, "end": 147.06, "text": "老臣的命苦啊"}, {"start": 148.26, "end": 152.38, "text": "老臣是天底下命最苦的人"}, {"start": 153.18, "end": 156.58, "text": "苦得就像是车轮底下的野草"}, {"start": 156.98, "end": 158.34, "text": "我苦得就像是"}, {"start": 159.42, "end": 161.06, "text": "石头缝里的黄莲荡"}, {"start": 162.42, "end": 164.14, "text": "老臣为了救助大汉"}, {"start": 164.34, "end": 165.86, "text": "不惜抛家舍业"}, {"start": 166.14, "end": 167.86, "text": "从西梁来到了朝廷"}, {"start": 167.98, "end": 168.74, "text": "六年多来"}, {"start": 168.74, "end": 170.94, "text": "老臣是吃不好睡不好"}, {"start": 171.78, "end": 173.14, "text": "藕心瀝血"}, {"start": 173.74, "end": 174.42, "text": "我时宜"}, {"start": 178.58, "end": 180.38, "text": "老臣的一片中心换来了什么"}, {"start": 181.9, "end": 182.78, "text": "换来了是"}, {"start": 182.9, "end": 185.34, "text": "满朝的宫廷大臣对老臣的恨"}, {"start": 185.98, "end": 187.46, "text": "换来了中原诸侯"}, {"start": 187.74, "end": 188.9, "text": "对老臣的怒"}, {"start": 189.22, "end": 191.22, "text": "换来了数不清的明枪暗箭"}, {"start": 191.22, "end": 192.22, "text": "阴谋诡计"}, {"start": 192.5, "end": 196.54, "text": "老臣知道"}, {"start": 197.38, "end": 198.9, "text": "天下的人恨不得"}, {"start": 199.66, "end": 200.82, "text": "剥老臣的蹄"}, {"start": 201.02, "end": 202.1, "text": "食老臣的肉"}, {"start": 202.94, "end": 204.3, "text": "老臣被他们逼得是"}, {"start": 204.3, "end": 205.98, "text": "步步走在刀刃上"}, {"start": 207.98, "end": 210.9, "text": "老臣是天底下命最苦的人哪"}, {"start": 211.66, "end": 213.34, "text": "你说是不是"}, {"start": 213.9, "end": 214.78, "text": "天子啊"}, {"start": 216.66, "end": 219.02, "text": "咱家可是跟你掏心窝子了"}, {"start": 220.86, "end": 224.62, "text": "你是老臣唯一的一个亲人哪"}, {"start": 231.58, "end": 232.5, "text": "是老臣"}, {"start": 233.26, "end": 234.82, "text": "把你摆到这个地位上的"}, {"start": 235.26, "end": 237.22, "text": "既然我能把你摆上去"}, {"start": 237.7, "end": 239.14, "text": "想扒了下来你"}, {"start": 239.26, "end": 240.54, "text": "那就扒了下来你了"}, {"start": 241.58, "end": 243.34, "text": "老臣对你是一片中心"}, {"start": 243.62, "end": 245.62, "text": "你也要忠心于老臣哪"}, {"start": 246.42, "end": 247.5, "text": "你说是不是"}, {"start": 248.22, "end": 249.18, "text": "你明白了吗"}, {"start": 249.94, "end": 250.82, "text": "明白没有"}, {"start": 280.98, "end": 281.54, "text": "义父"}, {"start": 282.34, "end": 283.26, "text": "贼军追上来了"}, {"start": 285.3, "end": 286.22, "text": "不必惊慌"}, {"start": 287.1, "end": 289.1, "text": "我已命李国二将断后了"}, {"start": 289.54, "end": 290.34, "text": "奉献啊"}, {"start": 290.78, "end": 291.86, "text": "小心护驾"}, {"start": 292.42, "end": 292.9, "text": "遵命"}, {"start": 293.14, "end": 328.8, "text": "吕布在此"}, {"start": 339.82, "end": 340.5, "text": "这世上"}, {"start": 341.5, "end": 342.5, "text": "有我就有你"}, {"start": 509.34, "end": 510.06, "text": "小姐"}, {"start": 514.78, "end": 515.62, "text": "好孩子"}, {"start": 516.86, "end": 518.46, "text": "你安然无恙啊"}, {"start": 518.86, "end": 519.66, "text": "我没事"}, {"start": 525.87, "end": 526.87, "text": "你得真是"}, {"start": 532.82, "end": 534.02, "text": "凤凰液盘"}, {"start": 576.91, "end": 578.23, "text": "虽说贼兵都跑了"}, {"start": 578.51, "end": 579.47, "text": "可是我们得到的"}, {"start": 579.47, "end": 580.67, "text": "也只是一座空城"}, {"start": 584.18, "end": 585.22, "text": "早生十年"}, {"start": 585.22, "end": 587.02, "text": "就可以到这里来玩玩了"}, {"start": 588.86, "end": 589.62, "text": "秦儿"}, {"start": 590.82, "end": 591.38, "text": "子儿"}, {"start": 592.66, "end": 593.9, "text": "东贼乱京"}, {"start": 594.02, "end": 595.1, "text": "破满天下"}, {"start": 595.34, "end": 600.95, "text": "大汉王朝一夜间"}, {"start": 600.95, "end": 602.87, "text": "竟变成了一片灰烬"}, {"start": 603.11, "end": 606.35, "text": "大汉的命啊"}, {"start": 606.51, "end": 640.63, "text": "是大汉天子的"}, {"start": 641.43, "end": 642.71, "text": "传过玉玺呀"}, {"start": 642.99, "end": 648.76, "text": "国玉玺"}, {"start": 649.76, "end": 650.88, "text": "末将年幼的时候"}, {"start": 651.12, "end": 652.24, "text": "就听家父说过"}, {"start": 652.64, "end": 653.64, "text": "这传过玉玺上"}, {"start": 653.92, "end": 654.92, "text": "写着八个字"}, {"start": 655.96, "end": 657.0, "text": "受命于天"}, {"start": 657.48, "end": 658.68, "text": "继寿永昌"}, {"start": 660.48, "end": 661.32, "text": "春秋年间"}, {"start": 661.72, "end": 663.24, "text": "便和采玉进入京山"}, {"start": 663.96, "end": 665.0, "text": "看见一枝金凤"}, {"start": 665.24, "end": 667.0, "text": "落在一块打青石上鸣叫"}, {"start": 667.52, "end": 669.04, "text": "便和便抛开青石"}, {"start": 669.64, "end": 671.36, "text": "采得一块绝世美玉"}, {"start": 671.92, "end": 673.76, "text": "便把它献给了楚王"}, {"start": 674.64, "end": 675.6, "text": "启灭六国后"}, {"start": 676.16, "end": 678.96, "text": "这块玉就落入了秦皇的手中"}, {"start": 679.76, "end": 680.92, "text": "丞相李斯啊"}, {"start": 681.16, "end": 682.92, "text": "亲自撰刻了这八个字"}, {"start": 684.16, "end": 687.24, "text": "秦皇就把它列为传过玉玺"}, {"start": 687.96, "end": 690.4, "text": "预传百世千世万世"}, {"start": 693.08, "end": 693.56, "text": "主公"}, {"start": 695.65, "end": 696.69, "text": "就是他呀"}, {"start": 696.97, "end": 702.13, "text": "承睦叔叔说得非常对"}, {"start": 702.57, "end": 703.09, "text": "爹"}, {"start": 703.25, "end": 704.53, "text": "犬儿也知道"}, {"start": 707.81, "end": 708.73, "text": "那你说说"}, {"start": 709.65, "end": 712.45, "text": "秦皇嬴政得到这块传过玉玺以后"}, {"start": 712.65, "end": 714.73, "text": "根本就没有传千世万世"}, {"start": 715.01, "end": 716.33, "text": "仅仅传了两世"}, {"start": 716.57, "end": 717.77, "text": "报秦就亡了"}, {"start": 718.17, "end": 721.01, "text": "后来由我高祖皇帝一统天下"}, {"start": 721.25, "end": 722.77, "text": "建立了大汉王朝"}, {"start": 723.17, "end": 725.49, "text": "玉玺落到了高祖手里以后"}, {"start": 725.73, "end": 727.33, "text": "又传了十五代君王"}, {"start": 727.77, "end": 728.89, "text": "西汉末年"}, {"start": 729.09, "end": 730.17, "text": "王莽篡逆"}, {"start": 730.45, "end": 733.25, "text": "校园皇太后就用这块玉玺砸贼"}, {"start": 733.53, "end": 735.01, "text": "玉玺掉在了地上"}, {"start": 735.25, "end": 736.21, "text": "崩坏了一脚"}, {"start": 736.41, "end": 739.29, "text": "后来将士们就用黄金相补了"}, {"start": 743.28, "end": 743.8, "text": "二弟"}, {"start": 744.96, "end": 746.4, "text": "你是怎么知道那么多的"}, {"start": 747.44, "end": 748.56, "text": "那是应该的"}, {"start": 753.95, "end": 754.83, "text": "今日上天"}, {"start": 755.23, "end": 756.79, "text": "把玉玺授命于主公"}, {"start": 758.19, "end": 759.03, "text": "足见主公"}, {"start": 759.47, "end": 760.75, "text": "有其无五之尊哪"}, {"start": 811.34, "end": 812.78, "text": "恭喜爹可以称帝了"}, {"start": 813.22, "end": 813.74, "text": "哥哥"}, {"start": 813.74, "end": 814.78, "text": "可是谁知道"}, {"start": 814.78, "end": 816.66, "text": "这东西是福是祸"}, {"start": 817.38, "end": 817.94, "text": "别胡说"}, {"start": 818.14, "end": 818.66, "text": "哥哥"}, {"start": 818.66, "end": 819.86, "text": "难道你忘了吗"}, {"start": 820.14, "end": 822.98, "text": "秦皇想让他传千世万世"}, {"start": 823.1, "end": 824.42, "text": "可仅仅传了两世"}, {"start": 824.54, "end": 825.74, "text": "报秦就亡了"}, {"start": 826.06, "end": 826.54, "text": "住嘴"}, {"start": 831.67, "end": 832.23, "text": "张伯"}, {"start": 833.39, "end": 834.07, "text": "末将在"}, {"start": 835.31, "end": 836.11, "text": "传令各部"}, {"start": 837.03, "end": 838.23, "text": "立刻收拾行装"}, {"start": 839.43, "end": 840.47, "text": "明天一早"}, {"start": 840.99, "end": 842.19, "text": "随我返回江东"}, {"start": 843.19, "end": 843.67, "text": "遵命"}, {"start": 851.42, "end": 851.9, "text": "主主"}, {"start": 852.26, "end": 853.74, "text": "原盟主率领诸侯大军"}, {"start": 853.94, "end": 854.86, "text": "快要进城来了"}, {"start": 858.86, "end": 860.54, "text": "他们到底是来了呀"}, {"start": 860.7, "end": 874.97, "text": "刘备"}, {"start": 876.41, "end": 877.61, "text": "败计列为"}, {"start": 878.17, "end": 879.65, "text": "先皇天灵"}, {"start": 880.49, "end": 882.33, "text": "东贼祸乱天下"}, {"start": 884.13, "end": 885.37, "text": "玷污宫廷"}, {"start": 886.41, "end": 887.77, "text": "焚毁宗庙"}, {"start": 888.73, "end": 890.09, "text": "褻瀆皇冈"}, {"start": 890.89, "end": 891.61, "text": "臣"}, {"start": 892.69, "end": 894.53, "text": "身为帝宙侯仪"}, {"start": 895.41, "end": 897.37, "text": "竟不能缴贼建功"}, {"start": 898.37, "end": 900.45, "text": "退不能保静安民"}, {"start": 901.73, "end": 902.61, "text": "惭愧"}, {"start": 906.58, "end": 908.54, "text": "列为先祖先皇"}, {"start": 913.71, "end": 914.19, "text": "哥呀"}, {"start": 914.47, "end": 915.67, "text": "这说两句就行了"}, {"start": 916.23, "end": 917.59, "text": "谁知道先帝爷"}, {"start": 917.59, "end": 918.71, "text": "他听得见听不见"}, {"start": 919.07, "end": 933.03, "text": "今日在先祖先皇面前立誓"}, {"start": 933.31, "end": 936.25, "text": "此生此世"}, {"start": 937.05, "end": 939.25, "text": "臣定要剿灭叛贼"}, {"start": 939.81, "end": 941.17, "text": "看平四海"}, {"start": 941.93, "end": 943.17, "text": "光复宗庙"}, {"start": 943.97, "end": 945.45, "text": "忠行皇室"}, {"start": 946.33, "end": 947.29, "text": "玄奘老弟"}, {"start": 955.4, "end": 956.32, "text": "我去问你"}, {"start": 956.92, "end": 958.04, "text": "袁绍何在"}, {"start": 959.99, "end": 961.79, "text": "我听说在驾德殿上"}, {"start": 962.03, "end": 963.91, "text": "为孙监制酒庆功的吧"}, {"start": 964.55, "end": 965.39, "text": "你可愿意"}, {"start": 965.39, "end": 966.83, "text": "随我去见他一面"}, {"start": 970.39, "end": 970.87, "text": "好"}, {"start": 971.47, "end": 972.27, "text": "我与你去"}, {"start": 973.15, "end": 974.15, "text": "孙将军"}, {"start": 975.03, "end": 975.75, "text": "请"}, {"start": 984.64, "end": 986.8, "text": "孟德兄班时回朝了"}, {"start": 989.16, "end": 990.28, "text": "情况怎么样"}, {"start": 991.32, "end": 992.64, "text": "大胜而归吧"}, {"start": 993.08, "end": 994.48, "text": "就回圣家了吗"}, {"start": 1010.93, "end": 1011.97, "text": "我没有得胜"}, {"start": 1013.01, "end": 1014.09, "text": "我大败而归"}, {"start": 1014.09, "end": 1015.37, "text": "而且败得极惨"}, {"start": 1015.85, "end": 1019.62, "text": "我星夜率兵"}, {"start": 1020.78, "end": 1022.1, "text": "追杀董卓"}, {"start": 1023.38, "end": 1024.9, "text": "不了再形养"}, {"start": 1025.62, "end": 1027.58, "text": "遭遇吕布的伏击"}, {"start": 1028.5, "end": 1030.1, "text": "不其伤亡过半"}, {"start": 1030.94, "end": 1032.1, "text": "如果不是曹洪"}, {"start": 1032.1, "end": 1033.74, "text": "把他的战马让给我"}, {"start": 1034.42, "end": 1035.22, "text": "此刻"}, {"start": 1035.9, "end": 1038.34, "text": "我已经命丧吕布几下了"}, {"start": 1038.9, "end": 1044.14, "text": "孟德孤军追杀"}, {"start": 1044.66, "end": 1045.9, "text": "勇冠三军"}, {"start": 1046.06, "end": 1047.26, "text": "随败有容"}, {"start": 1047.82, "end": 1048.74, "text": "是吗"}, {"start": 1052.62, "end": 1053.82, "text": "我也有一句"}, {"start": 1054.54, "end": 1056.14, "text": "痛彻心扉的话"}, {"start": 1056.82, "end": 1057.58, "text": "想说"}, {"start": 1058.22, "end": 1058.7, "text": "你说"}, {"start": 1058.98, "end": 1059.42, "text": "说"}, {"start": 1059.7, "end": 1063.89, "text": "匹夫庶子"}, {"start": 1064.33, "end": 1065.61, "text": "不相于谋"}, {"start": 1070.02, "end": 1070.74, "text": "曹操"}, {"start": 1072.34, "end": 1074.3, "text": "你这话什么意思"}, {"start": 1075.54, "end": 1076.22, "text": "袁绍"}, {"start": 1077.9, "end": 1078.98, "text": "袁盟主"}, {"start": 1080.18, "end": 1081.42, "text": "我等会盟以来"}, {"start": 1081.42, "end": 1082.94, "text": "至少有三次机会"}, {"start": 1083.1, "end": 1084.74, "text": "可以把董卓扑灭"}, {"start": 1085.82, "end": 1086.54, "text": "可是"}, {"start": 1089.1, "end": 1090.06, "text": "都被你们"}, {"start": 1090.38, "end": 1091.82, "text": "生生给错过了"}, {"start": 1096.05, "end": 1096.93, "text": "第一次"}, {"start": 1097.97, "end": 1100.41, "text": "就是我等会盟之初"}, {"start": 1101.29, "end": 1102.13, "text": "我建议"}, {"start": 1102.69, "end": 1104.21, "text": "趁董卓无妨"}, {"start": 1104.89, "end": 1106.09, "text": "兵分五路"}, {"start": 1106.09, "end": 1107.01, "text": "攻取洛阳"}, {"start": 1107.01, "end": 1108.05, "text": "可是你们不听"}, {"start": 1108.37, "end": 1109.13, "text": "第二次"}, {"start": 1110.09, "end": 1111.89, "text": "就是董卓刚刚出关的时候"}, {"start": 1111.89, "end": 1113.29, "text": "我建议出骑兵"}, {"start": 1113.85, "end": 1115.85, "text": "攻袭董卓的后方大胤"}, {"start": 1116.37, "end": 1117.41, "text": "可是各路诸侯"}, {"start": 1117.41, "end": 1118.45, "text": "各为名利"}, {"start": 1119.01, "end": 1120.25, "text": "争权夺利"}, {"start": 1120.25, "end": 1121.45, "text": "勾心斗角"}, {"start": 1121.45, "end": 1123.41, "text": "都不愿意率先出兵"}, {"start": 1124.53, "end": 1125.41, "text": "第三次"}, {"start": 1125.81, "end": 1126.97, "text": "就是董卓西迁"}, {"start": 1126.97, "end": 1128.65, "text": "我率兵追杀的时候"}, {"start": 1129.17, "end": 1130.37, "text": "你们本该派出"}, {"start": 1130.37, "end": 1132.45, "text": "所有的旌旗萧将"}, {"start": 1132.45, "end": 1134.25, "text": "行业驰援于我"}, {"start": 1134.57, "end": 1136.37, "text": "可是你们都暗兵不动"}, {"start": 1136.37, "end": 1137.69, "text": "致使我大败"}, {"start": 1138.37, "end": 1139.89, "text": "这话就是"}, {"start": 1140.21, "end": 1141.93, "text": "孟德兄不对了"}, {"start": 1144.08, "end": 1146.36, "text": "你为何追杀董卓啊"}, {"start": 1147.32, "end": 1150.16, "text": "那是因为你贪功心切"}, {"start": 1150.16, "end": 1151.6, "text": "孤军深入"}, {"start": 1151.96, "end": 1152.76, "text": "为何呀"}, {"start": 1153.56, "end": 1156.36, "text": "你想独自劫得天子吗"}, {"start": 1157.0, "end": 1157.8, "text": "怎么样"}, {"start": 1158.64, "end": 1160.68, "text": "中了董卓的圈套"}, {"start": 1160.68, "end": 1162.8, "text": "那才大败而至"}, {"start": 1162.8, "end": 1163.84, "text": "没错"}, {"start": 1163.84, "end": 1164.88, "text": "我是有些青帅"}, {"start": 1164.88, "end": 1166.44, "text": "中了董卓的伏击"}, {"start": 1166.92, "end": 1169.04, "text": "可是在我被伏击之后"}, {"start": 1169.04, "end": 1170.68, "text": "如果能用上万的旌旗"}, {"start": 1170.68, "end": 1172.0, "text": "继续追杀下去"}, {"start": 1172.0, "end": 1173.76, "text": "一定能够斩杀董卓"}, {"start": 1173.76, "end": 1175.04, "text": "劫回圣家"}, {"start": 1175.04, "end": 1176.68, "text": "因为已经有了一次伏击"}, {"start": 1176.68, "end": 1178.96, "text": "就绝不会再有第二次伏击"}, {"start": 1179.8, "end": 1181.44, "text": "董卓伏击得逞之后"}, {"start": 1181.92, "end": 1184.08, "text": "必然知得一蛮以征交兵"}, {"start": 1184.52, "end": 1186.4, "text": "他料定我们不敢追杀"}, {"start": 1186.4, "end": 1188.24, "text": "根本想不到追兵之后"}, {"start": 1188.24, "end": 1190.2, "text": "还会再有追兵"}, {"start": 1190.2, "end": 1191.68, "text": "孟德此话"}, {"start": 1192.96, "end": 1195.08, "text": "深得兵法精髓"}, {"start": 1202.84, "end": 1203.8, "text": "只可惜"}, {"start": 1204.84, "end": 1206.08, "text": "我兵败之后"}, {"start": 1206.6, "end": 1207.72, "text": "实在是"}, {"start": 1208.28, "end": 1209.84, "text": "无力继续追杀"}, {"start": 1210.84, "end": 1212.32, "text": "可是我回来一看"}, {"start": 1213.24, "end": 1215.04, "text": "各位诸侯居然在这儿"}, {"start": 1215.6, "end": 1216.88, "text": "捧羊宰牛"}, {"start": 1217.4, "end": 1218.8, "text": "饮酒作乐"}, {"start": 1219.8, "end": 1220.72, "text": "我曹某"}, {"start": 1221.2, "end": 1222.32, "text": "今次大败"}, {"start": 1222.96, "end": 1225.12, "text": "已经看透了列位的心计"}, {"start": 1226.36, "end": 1227.48, "text": "你们名为"}, {"start": 1227.48, "end": 1228.8, "text": "伏汉剿贼"}, {"start": 1229.44, "end": 1230.44, "text": "实际上"}, {"start": 1231.36, "end": 1233.64, "text": "都是在谋取自己的私利"}, {"start": 1234.8, "end": 1235.6, "text": "曹某"}, {"start": 1236.16, "end": 1237.4, "text": "深以为耻"}, {"start": 1238.2, "end": 1239.08, "text": "仅此"}, {"start": 1239.84, "end": 1240.6, "text": "告辞"}, {"start": 1240.8, "end": 1241.64, "text": "你这是"}, {"start": 1244.42, "end": 1245.54, "text": "玄德也要走吗"}, {"start": 1245.54, "end": 1246.42, "text": "将军且慢"}, {"start": 1252.58, "end": 1254.58, "text": "其实在下早已经告过辞了"}, {"start": 1255.46, "end": 1257.62, "text": "只不过内心还有报国之私"}, {"start": 1257.62, "end": 1259.02, "text": "所以才徘徊不定"}, {"start": 1260.22, "end": 1261.62, "text": "袁盟主既然问起"}, {"start": 1261.9, "end": 1263.18, "text": "在下正好直言"}, {"start": 1264.38, "end": 1266.62, "text": "我三兄弟自会盟以来"}, {"start": 1266.62, "end": 1267.9, "text": "屡力战功"}, {"start": 1268.34, "end": 1269.02, "text": "可是"}, {"start": 1269.58, "end": 1271.58, "text": "非但没有得到任何犒赏"}, {"start": 1272.14, "end": 1274.1, "text": "反而处处受到刁难"}, {"start": 1274.1, "end": 1276.14, "text": "今天刘备也斗胆问一下"}, {"start": 1276.14, "end": 1277.14, "text": "袁氏兄弟"}, {"start": 1278.58, "end": 1281.74, "text": "你们二位是想除贼伏汉呢"}, {"start": 1282.46, "end": 1285.02, "text": "还是想借除贼之名"}, {"start": 1285.02, "end": 1286.74, "text": "趁机掠取天下呢"}, {"start": 1287.66, "end": 1288.86, "text": "所以我刘备"}, {"start": 1288.86, "end": 1290.5, "text": "宁肯落入草马"}, {"start": 1291.02, "end": 1300.66, "text": "也休与而登为伍"}, {"start": 1300.94, "end": 1301.74, "text": "袁盟主"}, {"start": 1302.46, "end": 1304.74, "text": "我孙监自入盟以来"}, {"start": 1305.66, "end": 1308.18, "text": "始终担当先锋大任"}, {"start": 1309.38, "end": 1311.58, "text": "破百马 战虎牢"}, {"start": 1312.42, "end": 1314.74, "text": "可是一直得不到答应的知觉"}, {"start": 1316.1, "end": 1319.22, "text": "只是我江东子弟死伤过半"}, {"start": 1320.58, "end": 1323.82, "text": "我孙监如何向他们的父母交代"}, {"start": 1325.22, "end": 1326.94, "text": "听孙将军的话"}, {"start": 1328.46, "end": 1330.66, "text": "相士也要告辞了"}, {"start": 1330.66, "end": 1331.5, "text": "不错"}, {"start": 1334.22, "end": 1335.82, "text": "君子绝交"}, {"start": 1339.94, "end": 1341.66, "text": "我战伤发作"}, {"start": 1342.1, "end": 1343.5, "text": "不能再战了"}, {"start": 1344.62, "end": 1346.3, "text": "我准备明日率部"}, {"start": 1347.42, "end": 1348.7, "text": "返回江东"}, {"start": 1355.72, "end": 1357.4, "text": "孙将军之急"}, {"start": 1357.88, "end": 1359.76, "text": "恐怕不是战伤吧"}, {"start": 1360.84, "end": 1364.72, "text": "是为了那块传国玉玺吧"}, {"start": 1366.71, "end": 1367.47, "text": "你说什么"}, {"start": 1367.47, "end": 1368.47, "text": "文太兄"}, {"start": 1368.95, "end": 1371.86, "text": "俗话说得好啊"}, {"start": 1372.14, "end": 1375.14, "text": "要想人不知 出非己莫为"}, {"start": 1376.54, "end": 1379.54, "text": "那块玉玺是天子的命脉"}, {"start": 1379.9, "end": 1381.34, "text": "朝廷的大宝"}, {"start": 1381.66, "end": 1384.7, "text": "任何臣子都不得私自藏匿"}, {"start": 1385.22, "end": 1387.18, "text": "否则就有不臣之心"}, {"start": 1387.38, "end": 1389.38, "text": "有谋国之嫌哪"}, {"start": 1390.74, "end": 1393.22, "text": "你既然拿到了传国玉玺"}, {"start": 1394.42, "end": 1397.18, "text": "为了避免众诸侯起疑"}, {"start": 1397.3, "end": 1399.82, "text": "理应放在盟主这里"}, {"start": 1401.06, "end": 1402.06, "text": "日后"}, {"start": 1403.18, "end": 1405.1, "text": "我也好进献给朝廷"}, {"start": 1405.1, "end": 1406.74, "text": "归魂于天子"}, {"start": 1406.74, "end": 1409.1, "text": "并奏报你的护国之功"}, {"start": 1409.42, "end": 1412.3, "text": "否则众诸侯会说"}, {"start": 1412.3, "end": 1414.62, "text": "我们舍生冒死的狡贼"}, {"start": 1414.62, "end": 1415.82, "text": "贼在哪儿啊"}, {"start": 1417.66, "end": 1419.78, "text": "原来我们自己的大营里"}, {"start": 1419.82, "end": 1422.22, "text": "出了妄想篡地的国贼了"}, {"start": 1429.42, "end": 1431.7, "text": "原盟主暗部假释"}, {"start": 1437.66, "end": 1438.98, "text": "是想杀了我们"}, {"start": 1440.78, "end": 1442.18, "text": "断断不适"}, {"start": 1444.77, "end": 1446.97, "text": "不过我既然身为盟主"}, {"start": 1447.45, "end": 1449.33, "text": "就必须要秉公办事"}, {"start": 1450.33, "end": 1451.33, "text": "为朝廷"}, {"start": 1452.01, "end": 1453.57, "text": "拿回传国玉玺"}, {"start": 1453.97, "end": 1457.49, "text": "这点还请文太兄多多见谅"}, {"start": 1458.41, "end": 1460.53, "text": "来人 叫孙箭打下"}, {"start": 1460.53, "end": 1461.41, "text": "诺"}, {"start": 1461.41, "end": 1462.05, "text": "来人"}, {"start": 1462.05, "end": 1462.89, "text": "来人"}, {"start": 1476.06, "end": 1477.06, "text": "文太兄"}, {"start": 1478.42, "end": 1479.22, "text": "别误会"}, {"start": 1480.82, "end": 1483.3, "text": "你我还是从长计议吧"}, {"start": 1487.38, "end": 1489.02, "text": "请原盟主讲清楚"}, {"start": 1490.22, "end": 1492.7, "text": "我孙箭有没有藏匿传国玉玺"}, {"start": 1493.66, "end": 1494.22, "text": "没有"}, {"start": 1494.9, "end": 1495.54, "text": "没有"}, {"start": 1496.1, "end": 1497.1, "text": "绝对没有"}, {"start": 1497.58, "end": 1500.22, "text": "我孙箭是不是妄图称帝的国贼"}, {"start": 1501.58, "end": 1502.22, "text": "不是"}, {"start": 1503.02, "end": 1503.7, "text": "不是"}, {"start": 1504.3, "end": 1505.78, "text": "绝对不是"}, {"start": 1506.26, "end": 1506.86, "text": "好"}, {"start": 1509.22, "end": 1512.02, "text": "那你以后如何对各路诸侯解释"}, {"start": 1513.42, "end": 1514.26, "text": "我就说"}, {"start": 1515.42, "end": 1517.54, "text": "孙将军战伤复发"}, {"start": 1518.46, "end": 1521.38, "text": "引兵回江东养伤去了"}, {"start": 1539.11, "end": 1544.08, "text": "孙王恩断义绝"}, {"start": 1545.32, "end": 1547.32, "text": "反目成仇"}, {"start": 1557.3, "end": 1558.46, "text": "此番别后"}, {"start": 1559.26, "end": 1561.22, "text": "不知何日才能相见"}, {"start": 1562.78, "end": 1563.98, "text": "再见时"}, {"start": 1564.38, "end": 1565.94, "text": "也不知你我之间"}, {"start": 1566.9, "end": 1568.38, "text": "是敌是友啊"}, {"start": 1569.98, "end": 1570.74, "text": "今后"}, {"start": 1572.54, "end": 1573.9, "text": "无论发生什么事"}, {"start": 1575.58, "end": 1577.94, "text": "我孙某绝不与两位英雄为敌"}, {"start": 1578.9, "end": 1580.66, "text": "只要是忠于大汉之人"}, {"start": 1581.42, "end": 1582.7, "text": "便是我刘备之友"}, {"start": 1584.5, "end": 1586.78, "text": "只要叛汉助贼不管他是谁"}, {"start": 1587.5, "end": 1588.78, "text": "都是我刘备之敌"}, {"start": 1589.42, "end": 1590.14, "text": "说得好"}, {"start": 1592.03, "end": 1592.75, "text": "宣德"}, {"start": 1593.51, "end": 1595.31, "text": "请问你准备往哪里去"}, {"start": 1596.15, "end": 1598.03, "text": "我已得到公孙将军邀请"}, {"start": 1598.23, "end": 1599.67, "text": "前往平原县赞助"}, {"start": 1600.39, "end": 1601.95, "text": "请问曹将军孙将军呢"}, {"start": 1603.59, "end": 1606.71, "text": "我准备引军前往扬州"}, {"start": 1607.03, "end": 1608.79, "text": "别途救国之道"}, {"start": 1611.55, "end": 1612.35, "text": "我嘛"}, {"start": 1613.75, "end": 1614.55, "text": "自然是"}, {"start": 1615.39, "end": 1616.87, "text": "返江东故里养伤"}, {"start": 1618.27, "end": 1619.19, "text": "生于后"}, {"start": 1622.75, "end": 1624.31, "text": "只能报敬安民了"}, {"start": 1627.5, "end": 1628.26, "text": "可叹啊"}, {"start": 1629.02, "end": 1631.66, "text": "十八路英雄豪杰刚刚起事"}, {"start": 1631.98, "end": 1632.86, "text": "却有兴惨"}, {"start": 1633.82, "end": 1634.66, "text": "从此后"}, {"start": 1635.58, "end": 1637.98, "text": "汉庭霍乱 无休无止"}, {"start": 1639.06, "end": 1640.3, "text": "宣德此言"}, {"start": 1641.1, "end": 1641.98, "text": "是有不确"}, {"start": 1644.56, "end": 1645.44, "text": "恕我直言"}, {"start": 1646.8, "end": 1648.28, "text": "十八路诸侯当中"}, {"start": 1649.12, "end": 1651.24, "text": "只有孙文台兄"}, {"start": 1651.4, "end": 1653.08, "text": "你我堪称英雄"}, {"start": 1653.84, "end": 1654.72, "text": "其他人物"}, {"start": 1655.4, "end": 1656.92, "text": "不是英雄而是萧兄"}, {"start": 1657.76, "end": 1659.6, "text": "我料要不了多久"}, {"start": 1659.6, "end": 1661.64, "text": "他们之间就会拼个你死我活"}, {"start": 1662.52, "end": 1663.12, "text": "所以"}, {"start": 1663.96, "end": 1665.76, "text": "我们选择尽早离开"}, {"start": 1665.96, "end": 1667.44, "text": "是为上上之策"}, {"start": 1674.14, "end": 1675.06, "text": "谨辞告辞"}, {"start": 1676.9, "end": 1677.5, "text": "宣德"}, {"start": 1681.53, "end": 1682.37, "text": "宣德保重"}, {"start": 1682.89, "end": 1684.33, "text": "曹将军 孙将军"}, {"start": 1703.4, "end": 1704.08, "text": "文台兄"}, {"start": 1704.92, "end": 1705.48, "text": "告辞了"}, {"start": 1705.96, "end": 1706.96, "text": "文台兄留步"}, {"start": 1710.71, "end": 1712.23, "text": "在下有一事相问"}, {"start": 1712.95, "end": 1714.39, "text": "如有难言之处"}, {"start": 1714.39, "end": 1715.55, "text": "你可以不回答"}, {"start": 1716.47, "end": 1717.03, "text": "请问吧"}, {"start": 1720.72, "end": 1722.88, "text": "你真的得到了传国玉玺吗"}, {"start": 1727.95, "end": 1728.63, "text": "文台兄"}, {"start": 1729.51, "end": 1730.43, "text": "恕我直言"}, {"start": 1730.71, "end": 1731.71, "text": "在我看来"}, {"start": 1732.11, "end": 1734.39, "text": "此物并非福气而是祸害"}, {"start": 1735.39, "end": 1737.79, "text": "元树 元绍皆有君王之职"}, {"start": 1737.79, "end": 1739.15, "text": "无不贪恋此物"}, {"start": 1740.43, "end": 1741.19, "text": "你得到的"}, {"start": 1741.67, "end": 1742.95, "text": "只是一块石头"}, {"start": 1743.79, "end": 1745.59, "text": "却可能树地于天下"}, {"start": 1748.51, "end": 1749.63, "text": "孟德此话"}, {"start": 1751.27, "end": 1752.39, "text": "与儿小儿孙全"}, {"start": 1752.39, "end": 1754.11, "text": "说得倒是十分相近"}, {"start": 1754.79, "end": 1755.55, "text": "孙全"}, {"start": 1758.78, "end": 1759.34, "text": "全儿"}, {"start": 1761.18, "end": 1762.14, "text": "拜见曹伯伯"}, {"start": 1763.42, "end": 1764.66, "text": "拜见曹伯伯"}, {"start": 1768.3, "end": 1769.26, "text": "全儿说"}, {"start": 1770.5, "end": 1773.74, "text": "秦皇想用玉玺传百诗千诗"}, {"start": 1774.22, "end": 1775.5, "text": "不料仅仅二诗"}, {"start": 1776.5, "end": 1777.66, "text": "泡秦就亡了"}, {"start": 1779.78, "end": 1780.82, "text": "说得好啊"}, {"start": 1782.18, "end": 1782.86, "text": "有见地"}, {"start": 1784.9, "end": 1786.7, "text": "养个儿子就应该像他一样"}, {"start": 1792.62, "end": 1793.14, "text": "全儿"}, {"start": 1793.82, "end": 1794.26, "text": "全儿"}, {"start": 1794.86, "end": 1795.34, "text": "我们走"}, {"start": 1799.75, "end": 1800.23, "text": "保重"}, {"start": 1800.51, "end": 1820.51, "text": "江东孙氏"}, {"start": 1821.15, "end": 1822.31, "text": "满门英侯"}, {"start": 1823.27, "end": 1824.31, "text": "何尽可探"}, {"start": 1825.19, "end": 1826.19, "text": "更可律啊"}, {"start": 1828.07, "end": 1828.83, "text": "元绍"}, {"start": 1829.59, "end": 1830.95, "text": "给我送来一封密信"}, {"start": 1832.9, "end": 1834.98, "text": "约我在三金渡劫杀孙涧"}, {"start": 1835.66, "end": 1837.46, "text": "多取传国玉玺"}, {"start": 1837.82, "end": 1838.82, "text": "事成之后"}, {"start": 1838.82, "end": 1840.58, "text": "许我济州三座城池"}, {"start": 1840.78, "end": 1842.58, "text": "并报以黄金五千两"}, {"start": 1843.06, "end": 1844.86, "text": "战马三千匹香榭"}, {"start": 1846.74, "end": 1847.54, "text": "元绍"}, {"start": 1848.5, "end": 1850.74, "text": "为何非要让我劫杀孙涧呢"}, {"start": 1851.78, "end": 1852.38, "text": "此举"}, {"start": 1853.38, "end": 1856.1, "text": "不是有失我金州府的人意之风吗"}, {"start": 1858.31, "end": 1859.51, "text": "不是让我刘表"}, {"start": 1860.43, "end": 1861.83, "text": "左右为难吗"}, {"start": 1862.63, "end": 1863.11, "text": "主公"}, {"start": 1864.03, "end": 1866.39, "text": "元绍的势力比孙涧强盛很多"}, {"start": 1867.27, "end": 1868.99, "text": "他既然想夺传国玉玺"}, {"start": 1869.55, "end": 1871.43, "text": "则说明他怀有君王大志"}, {"start": 1872.19, "end": 1873.95, "text": "主公如果能助他一臂之力"}, {"start": 1874.07, "end": 1875.35, "text": "那么不但靖州无忧"}, {"start": 1875.99, "end": 1877.87, "text": "日后我们还可以借元绍的势力"}, {"start": 1878.43, "end": 1880.47, "text": "相激向青州济州一带扩展"}, {"start": 1881.11, "end": 1881.63, "text": "如此"}, {"start": 1882.51, "end": 1884.51, "text": "主公的前途不可限量了"}, {"start": 1886.42, "end": 1886.94, "text": "再者"}, {"start": 1887.58, "end": 1889.62, "text": "孙涧素来藐视我家主公"}, {"start": 1890.3, "end": 1892.22, "text": "江东战船也不时侵犯武器"}, {"start": 1892.78, "end": 1894.66, "text": "末将赞同与元绍结盟"}, {"start": 1894.9, "end": 1895.7, "text": "屠杀孙涧"}, {"start": 1896.42, "end": 1897.38, "text": "尽元绍之力"}, {"start": 1897.78, "end": 1899.18, "text": "消除金州大患"}, {"start": 1901.4, "end": 1902.88, "text": "孙涧骁勇无比"}, {"start": 1903.36, "end": 1904.24, "text": "听心而论"}, {"start": 1905.44, "end": 1908.32, "text": "你二人是孙涧的对手吗"}, {"start": 1915.75, "end": 1916.23, "text": "主公"}, {"start": 1916.99, "end": 1918.11, "text": "孙涧勇虽勇"}, {"start": 1918.43, "end": 1919.51, "text": "但他有勇无谋"}, {"start": 1920.15, "end": 1921.07, "text": "在下有一计"}, {"start": 1923.2, "end": 1925.16, "text": "如果主公能依计行事的话"}, {"start": 1926.4, "end": 1927.8, "text": "定能灭掉孙涧"}, {"start": 1951.95, "end": 1952.35, "text": "父亲"}, {"start": 1953.23, "end": 1954.83, "text": "有一人自称是元绍密使"}, {"start": 1955.31, "end": 1956.07, "text": "想要见你"}, {"start": 1956.91, "end": 1957.63, "text": "此人何在"}, {"start": 1966.13, "end": 1966.89, "text": "你是何人"}, {"start": 1967.53, "end": 1968.41, "text": "为何要见我"}, {"start": 1968.97, "end": 1971.49, "text": "在下元绍仗前谋士范骏"}, {"start": 1972.37, "end": 1973.73, "text": "受元将军所托"}, {"start": 1974.05, "end": 1976.01, "text": "在此专候孙将军"}, {"start": 1979.22, "end": 1979.98, "text": "何事啊"}, {"start": 1980.46, "end": 1980.78, "text": "说吧"}, {"start": 1984.01, "end": 1984.69, "text": "将军请看"}, {"start": 1987.24, "end": 1989.24, "text": "弟元树百拜文台兄"}, {"start": 1990.36, "end": 1991.68, "text": "先前会盟时"}, {"start": 1992.2, "end": 1994.28, "text": "弟科寇将军梁祥等事"}, {"start": 1994.56, "end": 1996.24, "text": "全是奉元绍所命"}, {"start": 1997.52, "end": 1998.96, "text": "元绍早有帝王之心"}, {"start": 1999.72, "end": 2002.52, "text": "意图借会盟之机壮大实力"}, {"start": 2002.8, "end": 2004.96, "text": "取代董卓独霸天下"}, {"start": 2005.68, "end": 2008.32, "text": "现在他已经密信金州刘表"}, {"start": 2008.6, "end": 2009.52, "text": "许以重力"}, {"start": 2009.88, "end": 2012.08, "text": "约刘表在三京渡社福"}, {"start": 2012.56, "end": 2014.12, "text": "截取传国玉玺"}, {"start": 2014.52, "end": 2016.48, "text": "文台兄千万小心啊"}, {"start": 2017.36, "end": 2018.28, "text": "袁公路为什么"}, {"start": 2018.28, "end": 2019.88, "text": "把这么机密的事告诉我"}, {"start": 2021.48, "end": 2023.24, "text": "难道他不是袁绍的兄弟吗"}, {"start": 2023.6, "end": 2025.16, "text": "同性未必同道啊"}, {"start": 2025.76, "end": 2027.48, "text": "我家主公乃仁义之君"}, {"start": 2027.92, "end": 2029.76, "text": "袁绍则是假仁假义"}, {"start": 2030.28, "end": 2031.52, "text": "口密附鉴之徒"}, {"start": 2032.44, "end": 2034.68, "text": "我家主公不忍见孙将军蒙难"}, {"start": 2035.4, "end": 2037.72, "text": "更不愿让袁绍祸乱天下"}, {"start": 2044.74, "end": 2045.82, "text": "袁叔在信中"}, {"start": 2045.82, "end": 2047.78, "text": "大谈对我孙监的敬重之情"}, {"start": 2048.46, "end": 2050.78, "text": "要与我阶层生死同盟"}, {"start": 2051.18, "end": 2052.46, "text": "共图大业"}, {"start": 2053.5, "end": 2054.78, "text": "两位袁氏兄弟"}, {"start": 2055.78, "end": 2057.3, "text": "表面亲如手足"}, {"start": 2057.78, "end": 2059.5, "text": "内心都始而与我战"}, {"start": 2060.98, "end": 2062.18, "text": "依我看来"}, {"start": 2063.14, "end": 2064.18, "text": "这两人"}, {"start": 2065.26, "end": 2067.46, "text": "都是贪图我的传国玉玺啊"}, {"start": 2068.18, "end": 2069.1, "text": "你们说说"}, {"start": 2069.98, "end": 2071.18, "text": "我们如何应付"}, {"start": 2071.66, "end": 2072.34, "text": "父亲"}, {"start": 2074.16, "end": 2075.0, "text": "依我看"}, {"start": 2075.56, "end": 2077.44, "text": "袁树比袁绍更可恶"}, {"start": 2077.44, "end": 2079.44, "text": "他连自己的堂哥都可以出卖"}, {"start": 2079.64, "end": 2080.92, "text": "末将的意思是"}, {"start": 2081.24, "end": 2083.44, "text": "我部刚受重创"}, {"start": 2084.04, "end": 2085.64, "text": "主公又身负债伤"}, {"start": 2086.44, "end": 2088.04, "text": "我到万不得已的时候"}, {"start": 2088.44, "end": 2089.64, "text": "不要与刘表交兵"}, {"start": 2091.24, "end": 2093.84, "text": "我们还是设法绕过三金渡吧"}, {"start": 2095.24, "end": 2096.44, "text": "三金渡"}, {"start": 2097.24, "end": 2098.84, "text": "是反江东的要道"}, {"start": 2100.04, "end": 2102.64, "text": "我已经命令渡传在那里等候"}, {"start": 2104.04, "end": 2105.84, "text": "如果绕过三金渡"}, {"start": 2106.24, "end": 2108.04, "text": "如果绕过三金渡"}, {"start": 2109.04, "end": 2111.24, "text": "非但渡传在那儿白等一场"}, {"start": 2111.64, "end": 2114.44, "text": "而且我们的归程要延迟二十多天"}, {"start": 2115.04, "end": 2115.84, "text": "特别是"}, {"start": 2116.64, "end": 2118.04, "text": "各部已经断了粮"}, {"start": 2118.44, "end": 2120.04, "text": "而我们的后续粮草"}, {"start": 2120.64, "end": 2122.04, "text": "都在渡传上了"}, {"start": 2122.44, "end": 2123.64, "text": "末将有个想法"}, {"start": 2124.04, "end": 2125.44, "text": "请主公不要生气"}, {"start": 2126.04, "end": 2126.64, "text": "说"}, {"start": 2127.04, "end": 2129.44, "text": "万般祸事都源自玉玺"}, {"start": 2130.04, "end": 2132.24, "text": "主公自从得到那方传国玉玺后"}, {"start": 2132.64, "end": 2135.64, "text": "各地诸侯都像恶狗一般瞪大了眼睛"}, {"start": 2136.04, "end": 2136.84, "text": "眼下"}, {"start": 2137.04, "end": 2140.04, "text": "袁绍 袁束叹图玉玺"}, {"start": 2140.64, "end": 2142.24, "text": "主公何不抛出他来"}, {"start": 2142.24, "end": 2143.44, "text": "两个人员相争"}, {"start": 2143.64, "end": 2146.04, "text": "如此可保江东太平啊"}, {"start": 2146.84, "end": 2148.44, "text": "皇叔万万不可呀"}, {"start": 2148.84, "end": 2151.84, "text": "这传国玉玺乃是上天授予我父亲的"}, {"start": 2152.04, "end": 2153.44, "text": "岂能让给他人"}, {"start": 2154.24, "end": 2155.04, "text": "要我说"}, {"start": 2155.64, "end": 2156.24, "text": "父亲"}, {"start": 2156.44, "end": 2158.84, "text": "刘表现在已经老迈昏溃了"}, {"start": 2158.84, "end": 2160.04, "text": "绝非我敌"}, {"start": 2160.24, "end": 2162.24, "text": "只要我们集中五千金兵"}, {"start": 2162.44, "end": 2163.64, "text": "由我来打先锋"}, {"start": 2163.84, "end": 2165.64, "text": "我保证在三个时辰之内"}, {"start": 2165.64, "end": 2168.04, "text": "擒下刘表攻克荆州城"}, {"start": 2172.42, "end": 2174.62, "text": "荆州城防坚实"}, {"start": 2175.82, "end": 2177.82, "text": "城中有数万兵甲"}, {"start": 2178.42, "end": 2180.42, "text": "仓促之间你攻不下呀"}, {"start": 2182.02, "end": 2182.82, "text": "城铺黄盖"}, {"start": 2184.22, "end": 2185.02, "text": "末将在"}, {"start": 2185.62, "end": 2187.02, "text": "你们俩率本部人马"}, {"start": 2187.02, "end": 2188.82, "text": "在三金渡北面设下一兵"}, {"start": 2189.02, "end": 2189.62, "text": "诺"}, {"start": 2190.82, "end": 2191.42, "text": "孙策"}, {"start": 2192.62, "end": 2193.42, "text": "孩儿在"}, {"start": 2194.22, "end": 2195.42, "text": "你率两千精兵"}, {"start": 2196.02, "end": 2197.22, "text": "在南面设下埋伏"}, {"start": 2197.42, "end": 2198.02, "text": "诺"}, {"start": 2199.02, "end": 2200.82, "text": "如果刘表敢动兵甲"}, {"start": 2202.22, "end": 2203.42, "text": "你们相机杀出"}, {"start": 2204.62, "end": 2205.82, "text": "只取刘表首级"}, {"start": 2207.82, "end": 2208.22, "text": "父亲"}, {"start": 2210.03, "end": 2210.63, "text": "那你呢"}, {"start": 2215.33, "end": 2216.93, "text": "刘表不是冲我来的吗"}, {"start": 2218.73, "end": 2220.73, "text": "那我就带几百老弱残兵"}, {"start": 2221.53, "end": 2222.13, "text": "去会会他"}, {"start": 2239.65, "end": 2241.45, "text": "想取我孙监的首级吗"}, {"start": 2257.77, "end": 2258.57, "text": "文太兄"}, {"start": 2258.77, "end": 2259.97, "text": "别来无恙"}, {"start": 2260.77, "end": 2261.57, "text": "刘兄"}, {"start": 2263.37, "end": 2264.97, "text": "此行何为啊"}, {"start": 2265.37, "end": 2267.37, "text": "特来给你送一份博礼"}, {"start": 2269.44, "end": 2271.84, "text": "袁绍给我的密信"}, {"start": 2289.34, "end": 2290.54, "text": "果然如此啊"}, {"start": 2292.71, "end": 2294.31, "text": "袁绍让你劫杀我"}, {"start": 2294.31, "end": 2296.11, "text": "你孙监最了解我"}, {"start": 2296.71, "end": 2299.11, "text": "我刘表将过半百"}, {"start": 2299.51, "end": 2300.71, "text": "体弱多病"}, {"start": 2300.91, "end": 2302.11, "text": "胸无大志"}, {"start": 2302.31, "end": 2303.71, "text": "手无长技"}, {"start": 2304.31, "end": 2306.51, "text": "我只想保荆州九郡"}, {"start": 2307.11, "end": 2308.51, "text": "上不负皇恩"}, {"start": 2308.91, "end": 2311.11, "text": "下不负黎民百姓罢了"}, {"start": 2311.91, "end": 2312.71, "text": "可是"}, {"start": 2313.31, "end": 2316.11, "text": "袁绍却让我在此设伏"}, {"start": 2316.31, "end": 2318.31, "text": "让我劫杀足下"}, {"start": 2319.71, "end": 2322.51, "text": "这真叫我左右为难啊"}, {"start": 2323.11, "end": 2324.11, "text": "敢问刘兄"}, {"start": 2327.79, "end": 2328.59, "text": "如何决定"}, {"start": 2328.99, "end": 2346.23, "text": "思来想去"}, {"start": 2346.23, "end": 2348.83, "text": "只有率军在此布阵"}, {"start": 2349.23, "end": 2351.83, "text": "其用意是假做拦截"}, {"start": 2351.83, "end": 2353.03, "text": "遮人耳目"}, {"start": 2353.03, "end": 2354.23, "text": "敷衍袁绍"}, {"start": 2354.83, "end": 2355.63, "text": "现在"}, {"start": 2355.83, "end": 2356.63, "text": "文太兄"}, {"start": 2357.23, "end": 2359.83, "text": "你可以率军冲过我的战阵"}, {"start": 2359.83, "end": 2361.43, "text": "直奔三京渡"}, {"start": 2361.83, "end": 2362.83, "text": "请你放心"}, {"start": 2363.43, "end": 2365.23, "text": "只要贵部的号角一响"}, {"start": 2365.63, "end": 2367.03, "text": "我荆州的军阵"}, {"start": 2367.23, "end": 2368.43, "text": "立即败退"}, {"start": 2368.63, "end": 2370.03, "text": "决不交战"}, {"start": 2371.83, "end": 2372.63, "text": "之后"}, {"start": 2373.23, "end": 2375.63, "text": "我可以向袁绍禀报说"}, {"start": 2376.63, "end": 2378.83, "text": "我刘表无能"}, {"start": 2379.03, "end": 2380.23, "text": "拦截失败"}, {"start": 2380.63, "end": 2382.03, "text": "我荆州的兵马"}, {"start": 2382.03, "end": 2384.03, "text": "反而遭到了损失"}, {"start": 2385.23, "end": 2386.03, "text": "这样"}, {"start": 2386.03, "end": 2388.03, "text": "我就既不得罪他袁绍"}, {"start": 2388.03, "end": 2390.03, "text": "也不得罪你孙尖了"}, {"start": 2391.43, "end": 2392.23, "text": "文太兄"}, {"start": 2392.63, "end": 2394.83, "text": "这就是我的两全之策"}, {"start": 2395.23, "end": 2397.03, "text": "你意下如何"}, {"start": 2397.63, "end": 2398.83, "text": "此话当真"}, {"start": 2399.63, "end": 2400.43, "text": "当然"}, {"start": 2402.18, "end": 2402.98, "text": "不过"}, {"start": 2403.58, "end": 2406.98, "text": "我确实还有一个要求"}, {"start": 2408.18, "end": 2408.78, "text": "讲"}, {"start": 2410.62, "end": 2411.82, "text": "从今往后"}, {"start": 2412.42, "end": 2415.22, "text": "你我两家和平相处"}, {"start": 2415.82, "end": 2417.62, "text": "你江东的兵马"}, {"start": 2418.22, "end": 2421.22, "text": "再也不要侵犯我荆州的境界了"}, {"start": 2422.02, "end": 2422.62, "text": "刘兄"}, {"start": 2424.59, "end": 2425.59, "text": "今日起"}, {"start": 2426.39, "end": 2427.59, "text": "我江东兵马"}, {"start": 2427.59, "end": 2429.99, "text": "永远不会过荆州境界半步"}, {"start": 2430.59, "end": 2431.39, "text": "如此"}, {"start": 2431.99, "end": 2434.19, "text": "老朽多谢了"}, {"start": 2435.39, "end": 2436.39, "text": "文太兄"}, {"start": 2436.79, "end": 2440.99, "text": "你现在可以率兵冲杀了"}]