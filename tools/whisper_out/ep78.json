[{"start": 7.73, "end": 8.73, "text": "陛下。"}, {"start": 9.73, "end": 10.73, "text": "让开。"}, {"start": 17.17, "end": 19.17, "text": "朕没有你的辅助,"}, {"start": 20.17, "end": 21.17, "text": "就不能自立了吗?"}, {"start": 22.17, "end": 53.26, "text": "死的愿,"}, {"start": 54.26, "end": 64.91, "text": "大哥没有听你的话。"}, {"start": 64.91, "end": 72.01, "text": "如果我能早早把握,"}, {"start": 73.01, "end": 82.12, "text": "早此独守。"}, {"start": 83.12, "end": 89.78, "text": "陛下,"}, {"start": 89.78, "end": 91.78, "text": "我爹爹是被孙璇害死的,"}, {"start": 91.78, "end": 93.78, "text": "侄儿与他势不两立。"}, {"start": 93.78, "end": 94.78, "text": "九叔奉下令,"}, {"start": 94.78, "end": 95.78, "text": "杀往东吴,"}, {"start": 95.78, "end": 97.78, "text": "砍掉孙璇的脑袋。"}, {"start": 97.78, "end": 127.68, "text": "我伤痛,"}, {"start": 127.68, "end": 132.47, "text": "乡下虎牢关,"}, {"start": 133.47, "end": 143.14, "text": "乡下荡漾桥香,"}, {"start": 143.14, "end": 150.83, "text": "卓郡难以遍桃园,"}, {"start": 150.83, "end": 158.22, "text": "我的心已摘走了。"}, {"start": 158.22, "end": 165.52, "text": "陛下,"}, {"start": 165.52, "end": 167.52, "text": "你一定要替我父亲报仇啊。"}, {"start": 168.52, "end": 198.1, "text": "今日有邪,"}, {"start": 198.1, "end": 200.1, "text": "义德授机,"}, {"start": 201.1, "end": 203.1, "text": "投降东吴。"}, {"start": 204.1, "end": 219.3, "text": "他孙璇折我连七族。"}, {"start": 220.3, "end": 222.77, "text": "亲密。"}, {"start": 222.77, "end": 223.77, "text": "陛下。"}, {"start": 223.77, "end": 229.34, "text": "发吾息文。"}, {"start": 232.42, "end": 233.42, "text": "臣叩请陛下三思。"}, {"start": 234.42, "end": 240.64, "text": "禀陛下,"}, {"start": 240.64, "end": 244.05, "text": "吴贼虽承奸鬼之际,"}, {"start": 244.05, "end": 245.05, "text": "只有京云州父王,"}, {"start": 246.05, "end": 248.05, "text": "但篡汉窃鼎者,"}, {"start": 249.05, "end": 250.05, "text": "罪犹曹魏。"}, {"start": 251.05, "end": 252.05, "text": "魏贼若除,"}, {"start": 252.05, "end": 254.05, "text": "东吴自然望风归降,"}, {"start": 254.05, "end": 256.05, "text": "大汉江山竟可重见天日。"}, {"start": 257.05, "end": 259.05, "text": "盼陛下以社稷为重,"}, {"start": 259.05, "end": 260.05, "text": "先发魏,"}, {"start": 260.05, "end": 261.05, "text": "后屠吾。"}, {"start": 261.05, "end": 263.05, "text": "如此大业必成,"}, {"start": 263.05, "end": 264.05, "text": "天下兴盛。"}, {"start": 265.05, "end": 267.65, "text": "又是仇,"}, {"start": 267.65, "end": 272.57, "text": "朕今天告诉你,"}, {"start": 272.57, "end": 274.57, "text": "魏强吾若。"}, {"start": 275.57, "end": 277.57, "text": "要成大业,"}, {"start": 277.57, "end": 278.57, "text": "必发吾。"}, {"start": 279.57, "end": 281.57, "text": "要报仇血恨,"}, {"start": 281.57, "end": 283.57, "text": "也必发吾。"}, {"start": 284.57, "end": 286.57, "text": "朕心意已决,"}, {"start": 286.57, "end": 287.57, "text": "休要再见。"}, {"start": 288.57, "end": 289.57, "text": "陛下,"}, {"start": 289.57, "end": 291.57, "text": "孙氏举江东一立三世,"}, {"start": 291.57, "end": 293.57, "text": "根基巩固。"}, {"start": 293.57, "end": 295.57, "text": "当年曹操率八十三万大军南征,"}, {"start": 295.57, "end": 297.57, "text": "已落得折减尘杀。"}, {"start": 297.57, "end": 298.57, "text": "陛下,"}, {"start": 298.57, "end": 299.57, "text": "若意气用事,"}, {"start": 300.57, "end": 302.57, "text": "臣担心会"}, {"start": 302.57, "end": 304.57, "text": "重蹈曹操覆辙呀,"}, {"start": 304.57, "end": 305.57, "text": "陛下。"}, {"start": 305.57, "end": 306.57, "text": "来人。"}, {"start": 306.57, "end": 307.57, "text": "在。"}, {"start": 307.57, "end": 310.57, "text": "将此人推出斩首。"}, {"start": 310.57, "end": 311.57, "text": "陛下,"}, {"start": 311.57, "end": 312.57, "text": "臣虽死无恨,"}, {"start": 312.57, "end": 313.57, "text": "但可惜,"}, {"start": 313.57, "end": 314.57, "text": "新创之业,"}, {"start": 314.57, "end": 315.57, "text": "又将颠覆啊,"}, {"start": 315.57, "end": 316.57, "text": "陛下。"}, {"start": 316.57, "end": 317.57, "text": "陛下,"}, {"start": 318.57, "end": 319.57, "text": "秦觅虽来言语貌实,"}, {"start": 320.57, "end": 321.57, "text": "但她可是一片忠心的。"}, {"start": 321.57, "end": 322.57, "text": "子龙,"}, {"start": 324.57, "end": 326.57, "text": "勿再替此人说情。"}, {"start": 327.57, "end": 330.55, "text": "陛下,"}, {"start": 330.55, "end": 331.55, "text": "请恕秦觅死罪,"}, {"start": 331.55, "end": 333.55, "text": "臣愿你写,"}, {"start": 333.55, "end": 334.55, "text": "发吾习文。"}, {"start": 335.55, "end": 349.01, "text": "不劳丞相们,"}, {"start": 349.01, "end": 352.06, "text": "朕,"}, {"start": 353.06, "end": 354.06, "text": "亲自钻写,"}, {"start": 355.06, "end": 356.06, "text": "发吾习文。"}, {"start": 356.06, "end": 357.06, "text": "与秦觅,"}, {"start": 362.77, "end": 364.77, "text": "暂且押入牢中,"}, {"start": 364.77, "end": 368.88, "text": "待朕发吾归来,"}, {"start": 369.88, "end": 385.38, "text": "再行罚牢,"}, {"start": 385.38, "end": 422.51, "text": "再组。"}, {"start": 422.51, "end": 423.51, "text": "何事?"}, {"start": 423.51, "end": 430.53, "text": "末将听说,"}, {"start": 430.53, "end": 432.53, "text": "陛下下礼到诏令,"}, {"start": 433.53, "end": 435.53, "text": "封李延为尚书令,"}, {"start": 435.53, "end": 437.53, "text": "黄泉为蜀军太守,"}, {"start": 437.53, "end": 442.11, "text": "是快被要架空了。"}, {"start": 442.11, "end": 444.71, "text": "魏延,"}, {"start": 444.71, "end": 448.7, "text": "你这是在挑拨君臣关系。"}, {"start": 451.07, "end": 452.07, "text": "末将不敢。"}, {"start": 453.07, "end": 454.07, "text": "丞相,"}, {"start": 454.07, "end": 455.07, "text": "现在朝中,"}, {"start": 455.07, "end": 457.07, "text": "流言暗传,"}, {"start": 457.07, "end": 458.07, "text": "说陛下"}, {"start": 458.07, "end": 460.07, "text": "想让李延取代你的位置。"}, {"start": 461.07, "end": 462.07, "text": "你的耳朵为何总听这些"}, {"start": 462.07, "end": 464.07, "text": "乌七八糟的流言?"}, {"start": 465.07, "end": 466.07, "text": "魏延,"}, {"start": 466.07, "end": 467.07, "text": "你的上将"}, {"start": 467.07, "end": 469.07, "text": "是陛下斥令的。"}, {"start": 469.07, "end": 470.07, "text": "你除了对主公"}, {"start": 470.07, "end": 472.07, "text": "忠心效命之外,"}, {"start": 472.07, "end": 474.07, "text": "不该再有其他妄自猜想。"}, {"start": 474.07, "end": 478.15, "text": "退一万步说,"}, {"start": 478.15, "end": 479.15, "text": "就算陛下"}, {"start": 479.15, "end": 481.15, "text": "真的着李延为相,"}, {"start": 481.15, "end": 483.15, "text": "那又未尝不可。"}, {"start": 483.15, "end": 485.15, "text": "我们身在川蜀,"}, {"start": 485.15, "end": 486.15, "text": "就当要依众,"}, {"start": 486.15, "end": 488.15, "text": "属中采菌。"}, {"start": 488.15, "end": 492.51, "text": "丞相,"}, {"start": 492.51, "end": 494.51, "text": "魏延虽然言故,"}, {"start": 494.51, "end": 498.14, "text": "也是为丞相担忧啊。"}, {"start": 498.14, "end": 499.14, "text": "马苏尔,"}, {"start": 502.86, "end": 504.86, "text": "替我拟一道奏表,"}, {"start": 504.86, "end": 506.86, "text": "我要向陛下请罪。"}, {"start": 506.86, "end": 507.86, "text": "丞相,"}, {"start": 507.86, "end": 509.86, "text": "你有何罪啊?"}, {"start": 509.86, "end": 513.75, "text": "你就说,"}, {"start": 514.75, "end": 516.75, "text": "陛下法无,"}, {"start": 516.75, "end": 518.75, "text": "乃顺天逃逆。"}, {"start": 518.75, "end": 520.75, "text": "但臣下愚钝,"}, {"start": 520.75, "end": 522.75, "text": "未能体会陛下用心。"}, {"start": 523.75, "end": 525.75, "text": "吕家劝阻,"}, {"start": 525.75, "end": 527.75, "text": "臣追悔莫及。"}, {"start": 527.75, "end": 529.75, "text": "请陛下降罪。"}, {"start": 529.75, "end": 533.51, "text": "知道了,"}, {"start": 533.51, "end": 536.51, "text": "在下即刻你走。"}, {"start": 536.51, "end": 540.88, "text": "我要抚情了,"}, {"start": 540.88, "end": 542.88, "text": "你们都退下吧。"}, {"start": 542.88, "end": 543.88, "text": "诺。"}, {"start": 543.88, "end": 544.88, "text": "诺。"}, {"start": 544.88, "end": 639.33, "text": "大军进入无尽之后,"}, {"start": 639.33, "end": 640.33, "text": "每驻一地,"}, {"start": 640.33, "end": 642.33, "text": "你都要把四周山川地形划腿,"}, {"start": 642.33, "end": 643.33, "text": "并与敌军情况当,"}, {"start": 643.33, "end": 645.33, "text": "星夜送往成都报于武汉,"}, {"start": 645.33, "end": 647.33, "text": "切不可耽误。"}, {"start": 647.33, "end": 648.33, "text": "遵命。"}, {"start": 649.33, "end": 650.33, "text": "丞相,"}, {"start": 650.33, "end": 651.33, "text": "你觉得,"}, {"start": 651.33, "end": 653.33, "text": "此次大军东征,"}, {"start": 653.33, "end": 655.33, "text": "胜负急求如何?"}, {"start": 655.33, "end": 659.47, "text": "不必多虑,"}, {"start": 659.47, "end": 661.47, "text": "好生辅佐陛下便是。"}, {"start": 661.47, "end": 681.22, "text": "少记谈报,"}, {"start": 681.22, "end": 683.22, "text": "刘备御驾亲征,"}, {"start": 683.22, "end": 684.22, "text": "八月初八日,"}, {"start": 684.22, "end": 686.22, "text": "蜀军已经出船。"}, {"start": 687.22, "end": 696.67, "text": "哦,"}, {"start": 697.67, "end": 699.67, "text": "到底是来了。"}, {"start": 699.67, "end": 700.67, "text": "看来,"}, {"start": 700.67, "end": 703.67, "text": "出口量也没能阻止刘备。"}, {"start": 703.67, "end": 705.67, "text": "不过这些,"}, {"start": 705.67, "end": 707.67, "text": "都在孤的意料当中,"}, {"start": 707.67, "end": 711.78, "text": "多少兵马?"}, {"start": 711.78, "end": 713.78, "text": "水陆大军,"}, {"start": 713.78, "end": 715.78, "text": "共约七十万。"}, {"start": 716.78, "end": 718.78, "text": "七十万?"}, {"start": 718.78, "end": 719.78, "text": "刘备,"}, {"start": 719.78, "end": 721.78, "text": "出清国之兵啊。"}, {"start": 722.78, "end": 723.78, "text": "看来这回,"}, {"start": 723.78, "end": 725.78, "text": "他也是拼上老本了。"}, {"start": 726.78, "end": 727.78, "text": "德盟。"}, {"start": 728.78, "end": 729.78, "text": "在。"}, {"start": 729.78, "end": 730.78, "text": "大唐听证。"}, {"start": 733.1, "end": 734.1, "text": "诺。"}, {"start": 734.1, "end": 741.91, "text": "刘备,"}, {"start": 741.91, "end": 743.91, "text": "除率川蜀大军外,"}, {"start": 743.91, "end": 744.91, "text": "另有蛮王,"}, {"start": 744.91, "end": 746.91, "text": "沙摩科的五万藩军,"}, {"start": 746.91, "end": 748.91, "text": "并东西汉将,"}, {"start": 748.91, "end": 749.91, "text": "杜禄,"}, {"start": 749.91, "end": 751.91, "text": "和刘宁的两只人马,"}, {"start": 751.91, "end": 752.91, "text": "水陆并进,"}, {"start": 752.91, "end": 754.91, "text": "车船双行。"}, {"start": 754.91, "end": 756.91, "text": "截至昨日,"}, {"start": 756.91, "end": 757.91, "text": "其水军,"}, {"start": 757.91, "end": 759.91, "text": "已出巫口。"}, {"start": 759.91, "end": 760.91, "text": "战绩,"}, {"start": 760.91, "end": 762.91, "text": "已逼近自归。"}, {"start": 763.91, "end": 764.91, "text": "连位,"}, {"start": 764.91, "end": 765.91, "text": "中午,"}, {"start": 765.91, "end": 771.18, "text": "应如何应礼?"}, {"start": 771.18, "end": 772.18, "text": "主公,"}, {"start": 772.18, "end": 775.18, "text": "此次刘备千里东征,"}, {"start": 775.18, "end": 777.18, "text": "进军如此神速,"}, {"start": 777.18, "end": 779.18, "text": "实则是想,"}, {"start": 779.18, "end": 781.18, "text": "速战速决。"}, {"start": 781.18, "end": 782.18, "text": "我军,"}, {"start": 782.18, "end": 783.18, "text": "应该想方设法,"}, {"start": 783.18, "end": 785.18, "text": "迟至刘备,"}, {"start": 785.18, "end": 787.18, "text": "以待时变。"}, {"start": 787.18, "end": 790.54, "text": "子虞,"}, {"start": 790.54, "end": 792.54, "text": "有何良策?"}, {"start": 792.54, "end": 794.54, "text": "刘备因张妃之死,"}, {"start": 794.54, "end": 796.54, "text": "痛恨范江张大二人。"}, {"start": 796.54, "end": 799.54, "text": "此次东征的名目之一,"}, {"start": 799.54, "end": 802.54, "text": "就是要替其三弟复仇。"}, {"start": 802.54, "end": 803.54, "text": "主公,"}, {"start": 803.54, "end": 805.54, "text": "你可将此二人,"}, {"start": 805.54, "end": 807.54, "text": "交与刘备,"}, {"start": 807.54, "end": 808.54, "text": "开成沿河,"}, {"start": 808.54, "end": 810.54, "text": "大兵修战。"}, {"start": 810.54, "end": 813.53, "text": "这个法子,"}, {"start": 813.53, "end": 815.53, "text": "倒是可行之。"}, {"start": 815.53, "end": 818.53, "text": "但恐记不了大事。"}, {"start": 818.53, "end": 821.84, "text": "我太了解刘备这个人了。"}, {"start": 821.84, "end": 823.84, "text": "他既然来了,"}, {"start": 823.84, "end": 825.84, "text": "便是来者不善。"}, {"start": 825.84, "end": 827.84, "text": "我军,"}, {"start": 827.84, "end": 829.84, "text": "必须立足于战。"}, {"start": 829.84, "end": 830.84, "text": "战,"}, {"start": 830.84, "end": 832.84, "text": "方能沿河,"}, {"start": 832.84, "end": 834.84, "text": "不能战。"}, {"start": 834.84, "end": 835.84, "text": "河,"}, {"start": 835.84, "end": 837.84, "text": "也是屈辱之河。"}, {"start": 837.84, "end": 839.84, "text": "祈求得来的和平,"}, {"start": 839.84, "end": 840.84, "text": "跟投降,"}, {"start": 840.84, "end": 842.84, "text": "也差不了多少。"}, {"start": 842.84, "end": 849.35, "text": "主公明鉴,"}, {"start": 849.35, "end": 851.35, "text": "在下也议为,"}, {"start": 851.35, "end": 853.35, "text": "武军必须拼命一战,"}, {"start": 853.35, "end": 856.35, "text": "先让刘备吃些苦头。"}, {"start": 856.35, "end": 858.35, "text": "待战事焦灼不下,"}, {"start": 858.35, "end": 860.35, "text": "刘备的粮草渐进时,"}, {"start": 860.35, "end": 863.35, "text": "方能前驶沿河。"}, {"start": 863.35, "end": 866.35, "text": "得谋直言是也。"}, {"start": 866.35, "end": 867.35, "text": "现在,"}, {"start": 867.35, "end": 869.35, "text": "刘备大军直逼紫规,"}, {"start": 869.35, "end": 872.35, "text": "而紫规又是东吴的门户,"}, {"start": 872.35, "end": 874.35, "text": "绝不可失。"}, {"start": 874.35, "end": 876.35, "text": "列位,"}, {"start": 876.35, "end": 878.35, "text": "有谁敢率兵前往紫规,"}, {"start": 878.35, "end": 888.54, "text": "迎战刘备?"}, {"start": 888.54, "end": 889.54, "text": "主公,"}, {"start": 889.54, "end": 890.54, "text": "承谋愿望。"}, {"start": 890.54, "end": 895.94, "text": "老将军保京沙场,"}, {"start": 895.94, "end": 897.94, "text": "功勋卓著,"}, {"start": 897.94, "end": 898.94, "text": "可是,"}, {"start": 898.94, "end": 899.94, "text": "年事已高,"}, {"start": 899.94, "end": 901.94, "text": "金飞西萍。"}, {"start": 901.94, "end": 902.94, "text": "我看,"}, {"start": 902.94, "end": 905.94, "text": "应该让后辈卿郡门建功了。"}, {"start": 905.94, "end": 908.94, "text": "有谁愿意前往?"}, {"start": 908.94, "end": 934.12, "text": "曹操率八十三万大军来此。"}, {"start": 934.12, "end": 936.12, "text": "周瑜和鲁肃,"}, {"start": 936.12, "end": 938.12, "text": "只用了五万精锐,"}, {"start": 938.12, "end": 942.14, "text": "就杀他个落花流水。"}, {"start": 942.14, "end": 943.14, "text": "可惜,"}, {"start": 943.14, "end": 948.91, "text": "功尽殡天,"}, {"start": 948.91, "end": 952.86, "text": "自敬勇士,"}, {"start": 952.86, "end": 961.2, "text": "竟要逼得我拱手成臣了。"}, {"start": 961.2, "end": 963.2, "text": "周瑜、鲁肃之后,"}, {"start": 963.2, "end": 965.2, "text": "更有末将孙桓。"}, {"start": 965.2, "end": 966.2, "text": "兵主公,"}, {"start": 966.2, "end": 968.2, "text": "臣职虽年轻,"}, {"start": 968.2, "end": 971.2, "text": "但自幼保习兵书。"}, {"start": 971.2, "end": 973.2, "text": "臣曾多次随周瑜大都督,"}, {"start": 973.2, "end": 975.2, "text": "征战沙场。"}, {"start": 975.2, "end": 977.2, "text": "臣愿领五万精兵,"}, {"start": 977.2, "end": 979.2, "text": "迎战刘备。"}, {"start": 979.2, "end": 981.2, "text": "若不胜,"}, {"start": 981.2, "end": 985.89, "text": "我会受罚。"}, {"start": 985.89, "end": 986.89, "text": "好。"}, {"start": 986.89, "end": 988.89, "text": "孙桓,"}, {"start": 988.89, "end": 990.89, "text": "我封你为镇西左都督,"}, {"start": 990.89, "end": 992.89, "text": "诸然为镇西右都督,"}, {"start": 992.89, "end": 994.89, "text": "并拨你们精兵五万,"}, {"start": 994.89, "end": 996.89, "text": "前往紫辉迎战刘备。"}, {"start": 996.89, "end": 997.89, "text": "领命。"}, {"start": 997.89, "end": 998.89, "text": "领命。"}, {"start": 998.89, "end": 1000.89, "text": "听着。"}, {"start": 1000.89, "end": 1005.14, "text": "我不指望你们能够击败刘备大军。"}, {"start": 1005.14, "end": 1009.14, "text": "我只要你们在紫辉坚守一个月,"}, {"start": 1009.14, "end": 1012.14, "text": "等刘备兵封已衰,"}, {"start": 1012.14, "end": 1017.42, "text": "那时我就可以逼他言和。"}, {"start": 1017.42, "end": 1019.42, "text": "记住,"}, {"start": 1019.42, "end": 1022.42, "text": "一个月之内坚守紫辉,"}, {"start": 1022.42, "end": 1023.42, "text": "绝不可失。"}, {"start": 1023.42, "end": 1026.11, "text": "切记。"}, {"start": 1026.11, "end": 1027.11, "text": "诺。"}, {"start": 1027.11, "end": 1028.11, "text": "诺。"}, {"start": 1028.11, "end": 1046.36, "text": "陛下,"}, {"start": 1046.36, "end": 1048.36, "text": "东吴特使承秉,"}, {"start": 1048.36, "end": 1049.36, "text": "奉孙泉之命,"}, {"start": 1049.36, "end": 1053.92, "text": "前来见驾。"}, {"start": 1053.92, "end": 1054.92, "text": "叫进来。"}, {"start": 1054.92, "end": 1055.92, "text": "遵命。"}, {"start": 1055.92, "end": 1056.92, "text": "请。"}, {"start": 1056.92, "end": 1069.24, "text": "我吴侯给刘皇叔请安。"}, {"start": 1069.24, "end": 1070.24, "text": "接着说。"}, {"start": 1070.24, "end": 1073.81, "text": "在下奉吴侯之命,"}, {"start": 1073.81, "end": 1077.81, "text": "前来请求皇叔罢病议和。"}, {"start": 1077.81, "end": 1081.81, "text": "此行吴侯给皇叔带来了两件礼物。"}, {"start": 1081.81, "end": 1083.81, "text": "什么礼物?"}, {"start": 1083.81, "end": 1085.81, "text": "皇叔的仇人,"}, {"start": 1085.81, "end": 1088.81, "text": "杀害易德将军的叛贼,"}, {"start": 1088.81, "end": 1090.81, "text": "范疆张达。"}, {"start": 1090.81, "end": 1099.98, "text": "听令。"}, {"start": 1099.98, "end": 1101.98, "text": "拿下来使,"}, {"start": 1101.98, "end": 1104.98, "text": "与范疆张达一同斩首,"}, {"start": 1104.98, "end": 1106.98, "text": "以祭奠五弟,"}, {"start": 1106.98, "end": 1107.98, "text": "易德在天之令。"}, {"start": 1107.98, "end": 1109.98, "text": "诺。"}, {"start": 1109.98, "end": 1110.98, "text": "陛下,"}, {"start": 1110.98, "end": 1112.98, "text": "吾有成令,"}, {"start": 1112.98, "end": 1113.98, "text": "两军相战,"}, {"start": 1113.98, "end": 1114.98, "text": "不斩来时。"}, {"start": 1114.98, "end": 1118.45, "text": "我对孙泉之恨,"}, {"start": 1118.45, "end": 1119.45, "text": "超越古今。"}, {"start": 1119.45, "end": 1120.45, "text": "今日,"}, {"start": 1120.45, "end": 1122.45, "text": "我偏要斩使示威。"}, {"start": 1122.45, "end": 1123.45, "text": "退下。"}, {"start": 1123.45, "end": 1124.45, "text": "斩。"}, {"start": 1124.45, "end": 1125.45, "text": "诺。"}, {"start": 1125.45, "end": 1126.45, "text": "皇叔饶命啊。"}, {"start": 1126.45, "end": 1127.45, "text": "皇叔,"}, {"start": 1127.45, "end": 1128.45, "text": "皇叔饶命。"}, {"start": 1128.45, "end": 1140.37, "text": "各位都看到了吗?"}, {"start": 1140.37, "end": 1141.37, "text": "尚未交战,"}, {"start": 1141.37, "end": 1143.37, "text": "孙泉已畏惧三分。"}, {"start": 1143.37, "end": 1148.18, "text": "紫龟城,"}, {"start": 1148.18, "end": 1150.18, "text": "是东吴的门户。"}, {"start": 1150.18, "end": 1152.18, "text": "此城一破,"}, {"start": 1152.18, "end": 1154.18, "text": "东吴门户洞开,"}, {"start": 1154.18, "end": 1157.18, "text": "我军便可车传并进。"}, {"start": 1157.18, "end": 1158.18, "text": "张包官兴,"}, {"start": 1158.18, "end": 1159.18, "text": "听令。"}, {"start": 1159.18, "end": 1160.18, "text": "在。"}, {"start": 1160.18, "end": 1161.18, "text": "命你二位,"}, {"start": 1161.18, "end": 1162.18, "text": "直奔紫龟,"}, {"start": 1162.18, "end": 1163.18, "text": "三日之内,"}, {"start": 1163.18, "end": 1165.18, "text": "攻取紫龟城。"}, {"start": 1165.18, "end": 1166.18, "text": "遵命。"}, {"start": 1166.18, "end": 1470.38, "text": "我有何面目,"}, {"start": 1470.38, "end": 1471.38, "text": "再见主公。"}, {"start": 1471.38, "end": 1475.23, "text": "我,"}, {"start": 1475.23, "end": 1476.23, "text": "如果将军自闻,"}, {"start": 1476.23, "end": 1477.23, "text": "军心一定会大乱,"}, {"start": 1477.23, "end": 1478.23, "text": "赶紧撑住紫龟吧。"}, {"start": 1478.23, "end": 1479.23, "text": "是。"}, {"start": 1479.23, "end": 1522.71, "text": "我军就深入吴京两百里,"}, {"start": 1522.71, "end": 1524.71, "text": "可谓进展神速。"}, {"start": 1524.71, "end": 1526.71, "text": "紫龟城这一破,"}, {"start": 1526.71, "end": 1528.71, "text": "星城屡定的吴军,"}, {"start": 1528.71, "end": 1529.71, "text": "定不能持久。"}, {"start": 1529.71, "end": 1530.71, "text": "臣料想,"}, {"start": 1530.71, "end": 1531.71, "text": "入东以前,"}, {"start": 1531.71, "end": 1533.71, "text": "陛下就可以进入京州了。"}, {"start": 1533.71, "end": 1536.57, "text": "张包,"}, {"start": 1536.57, "end": 1539.57, "text": "听说是你第一个杀入城中的。"}, {"start": 1539.57, "end": 1541.57, "text": "末将率五千甲士,"}, {"start": 1541.57, "end": 1542.57, "text": "率些攻破东关。"}, {"start": 1542.57, "end": 1548.15, "text": "我知之勇,"}, {"start": 1548.15, "end": 1549.15, "text": "不下于奈夫。"}, {"start": 1549.15, "end": 1550.15, "text": "传命,"}, {"start": 1550.15, "end": 1552.15, "text": "嘉奖你部兵士,"}, {"start": 1552.15, "end": 1554.15, "text": "每人赏肉两斤,"}, {"start": 1554.15, "end": 1555.15, "text": "赏酒两斤。"}, {"start": 1555.15, "end": 1557.15, "text": "校位以上者,"}, {"start": 1557.15, "end": 1559.15, "text": "另外论功行赏。"}, {"start": 1559.15, "end": 1560.15, "text": "谢陛下。"}, {"start": 1560.15, "end": 1562.15, "text": "星城屡定两处,"}, {"start": 1562.15, "end": 1564.15, "text": "就交给关兴吧。"}, {"start": 1564.15, "end": 1566.15, "text": "关兴人呢?"}, {"start": 1566.15, "end": 1567.15, "text": "陛下,"}, {"start": 1567.15, "end": 1570.15, "text": "关将军听说张将军建功,"}, {"start": 1570.15, "end": 1572.15, "text": "早就急不可待了。"}, {"start": 1572.15, "end": 1574.15, "text": "刺客已经率本部兵马,"}, {"start": 1574.15, "end": 1575.15, "text": "出发了。"}, {"start": 1575.15, "end": 1579.2, "text": "朕还没有下令,"}, {"start": 1579.2, "end": 1580.2, "text": "他就急不可待了。"}, {"start": 1580.2, "end": 1585.01, "text": "无权子。"}, {"start": 1585.01, "end": 1637.45, "text": "这里供奉的是哪路神仙?"}, {"start": 1637.45, "end": 1639.45, "text": "禀陛下,"}, {"start": 1639.45, "end": 1641.45, "text": "好像是大雨。"}, {"start": 1641.45, "end": 1646.86, "text": "大雨瓷的门板,"}, {"start": 1646.86, "end": 1648.86, "text": "你们也敢烧啊?"}, {"start": 1648.86, "end": 1651.86, "text": "真是无所敬畏了。"}, {"start": 1651.86, "end": 1653.86, "text": "现在,"}, {"start": 1653.86, "end": 1654.86, "text": "这里的一草一木,"}, {"start": 1654.86, "end": 1657.86, "text": "都是咱们蜀国的。"}, {"start": 1657.86, "end": 1659.86, "text": "你们说说,"}, {"start": 1659.86, "end": 1662.86, "text": "有谁会拆了自家的门板当柴烧?"}, {"start": 1662.86, "end": 1664.86, "text": "末将知罪。"}, {"start": 1664.86, "end": 1666.86, "text": "把门板装上。"}, {"start": 1666.86, "end": 1667.86, "text": "诺,"}, {"start": 1667.86, "end": 1668.86, "text": "装上。"}, {"start": 1668.86, "end": 1676.91, "text": "马良。"}, {"start": 1676.91, "end": 1677.91, "text": "陛下。"}, {"start": 1677.91, "end": 1680.91, "text": "这道提醒了朕,"}, {"start": 1680.91, "end": 1682.91, "text": "从现在起,"}, {"start": 1682.91, "end": 1684.91, "text": "我军每攻下一座城池,"}, {"start": 1684.91, "end": 1685.91, "text": "都要视如蜀地。"}, {"start": 1685.91, "end": 1687.91, "text": "所有的寺庙民宅,"}, {"start": 1687.91, "end": 1688.91, "text": "不可擅入。"}, {"start": 1688.91, "end": 1690.91, "text": "所有的庶民,牛马,"}, {"start": 1690.91, "end": 1691.91, "text": "钱母,"}, {"start": 1691.91, "end": 1692.91, "text": "赋税,"}, {"start": 1692.91, "end": 1695.91, "text": "都要造册登记。"}, {"start": 1695.91, "end": 1696.91, "text": "还有,"}, {"start": 1696.91, "end": 1700.16, "text": "当地的政令典律,"}, {"start": 1700.16, "end": 1702.16, "text": "也都要按照蜀律,"}, {"start": 1702.16, "end": 1705.16, "text": "重新颁布。"}, {"start": 1705.16, "end": 1706.16, "text": "诺。"}, {"start": 1706.16, "end": 1712.44, "text": "孙桓兵败,"}, {"start": 1712.44, "end": 1714.44, "text": "子龟失手,"}, {"start": 1714.44, "end": 1716.44, "text": "京中门户洞开。"}, {"start": 1716.44, "end": 1719.72, "text": "确实,"}, {"start": 1719.72, "end": 1721.72, "text": "我曾命他们二人坚守,"}, {"start": 1721.72, "end": 1722.72, "text": "坚守,"}, {"start": 1722.72, "end": 1724.72, "text": "怎会如此坚守城池?"}, {"start": 1724.72, "end": 1725.72, "text": "我命,"}, {"start": 1725.72, "end": 1728.72, "text": "孙桓坚守城池一个月,"}, {"start": 1728.72, "end": 1733.51, "text": "居然击斩了三个时辰就失手,"}, {"start": 1733.51, "end": 1736.82, "text": "被折损了上万兵士。"}, {"start": 1736.82, "end": 1744.64, "text": "主公,"}, {"start": 1744.64, "end": 1746.64, "text": "子龟失手的消息,"}, {"start": 1746.64, "end": 1748.64, "text": "已不尽而走。"}, {"start": 1748.64, "end": 1750.64, "text": "就连江东境地的健康,"}, {"start": 1750.64, "end": 1751.64, "text": "借口等城,"}, {"start": 1751.64, "end": 1753.64, "text": "也相继发生混乱。"}, {"start": 1753.64, "end": 1756.64, "text": "百姓们把蜀军传得神乎其神。"}, {"start": 1756.64, "end": 1758.64, "text": "士绅转运家财,"}, {"start": 1758.64, "end": 1760.64, "text": "百姓争相嫁女,"}, {"start": 1760.64, "end": 1763.64, "text": "城中甚至出现了抢新郎的"}, {"start": 1763.64, "end": 1765.64, "text": "咄咄怪事。"}, {"start": 1765.64, "end": 1777.04, "text": "主公,"}, {"start": 1777.04, "end": 1778.04, "text": "刚刚接到的军报。"}, {"start": 1778.04, "end": 1784.58, "text": "恐怕,"}, {"start": 1784.58, "end": 1790.42, "text": "又是战败的军报吧。"}, {"start": 1790.42, "end": 1791.42, "text": "不妨事,"}, {"start": 1791.42, "end": 1793.42, "text": "念给大家听听。"}, {"start": 1793.42, "end": 1794.42, "text": "大声念。"}, {"start": 1794.42, "end": 1799.56, "text": "蜀军右前封关兴,"}, {"start": 1799.56, "end": 1800.56, "text": "率军一万,"}, {"start": 1800.56, "end": 1801.56, "text": "攻陷兴城。"}, {"start": 1801.56, "end": 1803.56, "text": "守城将军令狐鸣,"}, {"start": 1803.56, "end": 1804.56, "text": "稳静自杀,"}, {"start": 1804.56, "end": 1806.56, "text": "兴城将士大步阵亡。"}, {"start": 1806.56, "end": 1808.56, "text": "蜀军军计严明,"}, {"start": 1808.56, "end": 1809.56, "text": "攻占城池后,"}, {"start": 1809.56, "end": 1810.56, "text": "严禁烧杀抢掠,"}, {"start": 1810.56, "end": 1813.56, "text": "并派官员接掌崖蜀,"}, {"start": 1813.56, "end": 1814.56, "text": "核查田土,"}, {"start": 1814.56, "end": 1815.56, "text": "子民,牛马,"}, {"start": 1815.56, "end": 1816.56, "text": "税赋,"}, {"start": 1816.56, "end": 1818.56, "text": "并立即废除东吴的正立体。"}, {"start": 1818.56, "end": 1819.56, "text": "够了。"}, {"start": 1819.56, "end": 1833.72, "text": "你们知道,"}, {"start": 1833.72, "end": 1835.72, "text": "刘备为什么要这样做吗?"}, {"start": 1837.72, "end": 1839.72, "text": "为什么要这样做吗?"}, {"start": 1839.72, "end": 1844.66, "text": "那是因为,"}, {"start": 1844.66, "end": 1846.66, "text": "他已经把吴帝,"}, {"start": 1846.66, "end": 1848.66, "text": "看作蜀帝,"}, {"start": 1848.66, "end": 1852.01, "text": "把吴中的百姓,"}, {"start": 1852.01, "end": 1854.01, "text": "看作蜀国的子民了。"}, {"start": 1854.01, "end": 1859.3, "text": "现在你们看到了吗?"}, {"start": 1859.3, "end": 1864.18, "text": "刘备到此,"}, {"start": 1864.18, "end": 1866.18, "text": "不是为了报仇,"}, {"start": 1866.18, "end": 1869.18, "text": "而是为了精尊江东河山,"}, {"start": 1869.18, "end": 1871.18, "text": "为了一统天下而来的。"}, {"start": 1871.18, "end": 1916.96, "text": "是的,母亲。"}, {"start": 1916.96, "end": 1918.96, "text": "女儿来了。"}, {"start": 1918.96, "end": 1920.96, "text": "他的兵马,"}, {"start": 1920.96, "end": 1922.96, "text": "一攻破紫归城,"}, {"start": 1922.96, "end": 1926.96, "text": "正向东吴内地进发。"}, {"start": 1926.96, "end": 1931.8, "text": "他是谁?"}, {"start": 1931.8, "end": 1935.71, "text": "刘备。"}, {"start": 1935.71, "end": 1944.3, "text": "女儿,"}, {"start": 1944.3, "end": 1947.54, "text": "早已经忘记这个人了。"}, {"start": 1947.54, "end": 1954.51, "text": "你真的忘了自己的夫君吗?"}, {"start": 1955.51, "end": 1957.51, "text": "他应该,"}, {"start": 1957.51, "end": 1959.51, "text": "已经六十二岁了,"}, {"start": 1959.51, "end": 1961.51, "text": "都不知道老成什么样子。"}, {"start": 1961.51, "end": 1974.06, "text": "刘备亲自率七十万大军征吴。"}, {"start": 1975.06, "end": 1977.06, "text": "三个时辰,"}, {"start": 1977.06, "end": 1979.06, "text": "就破了紫归。"}, {"start": 1979.06, "end": 1982.06, "text": "或许用不了多久,"}, {"start": 1982.06, "end": 1985.06, "text": "他就该杀到建业了。"}, {"start": 1985.06, "end": 1988.06, "text": "东吴亡国时,"}, {"start": 1988.06, "end": 1990.06, "text": "你们夫妻俩,"}, {"start": 1990.06, "end": 1992.06, "text": "却可以重逢。"}, {"start": 1992.06, "end": 1998.22, "text": "女儿,"}, {"start": 1998.22, "end": 2000.22, "text": "你高兴吗?"}, {"start": 2000.22, "end": 2005.0, "text": "母亲。"}, {"start": 2005.0, "end": 2007.0, "text": "女儿,"}, {"start": 2007.0, "end": 2010.41, "text": "帮你哥哥一回吧。"}, {"start": 2010.41, "end": 2013.41, "text": "也是救救江东的百姓。"}, {"start": 2013.41, "end": 2016.75, "text": "母亲,"}, {"start": 2016.75, "end": 2018.75, "text": "女儿要怎么做,"}, {"start": 2018.75, "end": 2023.31, "text": "才能救江东百姓呢?"}, {"start": 2023.31, "end": 2027.39, "text": "回到刘备身边去,"}, {"start": 2027.39, "end": 2028.39, "text": "集团聚。"}, {"start": 2028.39, "end": 2038.26, "text": "妹妹,"}, {"start": 2038.26, "end": 2041.26, "text": "你是一幅温良之药,"}, {"start": 2041.26, "end": 2043.26, "text": "可灭刘备心中,"}, {"start": 2043.26, "end": 2052.02, "text": "仇恨之火。"}, {"start": 2052.02, "end": 2067.33, "text": "你不愿意吗?"}, {"start": 2067.33, "end": 2072.08, "text": "是我气他而去,"}, {"start": 2072.08, "end": 2075.08, "text": "如今我又有什么颜面见他呢?"}, {"start": 2076.08, "end": 2078.08, "text": "你跟我说过,"}, {"start": 2078.08, "end": 2080.08, "text": "他十分地疼爱你。"}, {"start": 2080.08, "end": 2082.08, "text": "母亲知道,"}, {"start": 2082.08, "end": 2086.33, "text": "你也依然眷恋着他。"}, {"start": 2086.33, "end": 2088.33, "text": "人哪,"}, {"start": 2088.33, "end": 2090.33, "text": "什么都好抛弃,"}, {"start": 2090.33, "end": 2092.33, "text": "情感难断。"}, {"start": 2092.33, "end": 2114.94, "text": "是哥哥无能,"}, {"start": 2114.94, "end": 2118.94, "text": "哥哥愧对先父先兄的在天之灵,"}, {"start": 2118.94, "end": 2120.94, "text": "我在另途两侧。"}, {"start": 2120.94, "end": 2132.89, "text": "哥哥,"}, {"start": 2132.89, "end": 2138.89, "text": "把我送给刘备吧。"}, {"start": 2138.89, "end": 2140.89, "text": "妹妹,"}, {"start": 2140.89, "end": 2142.89, "text": "卑兄和江东拜行,"}, {"start": 2142.89, "end": 2149.18, "text": "拜先宁。"}, {"start": 2149.18, "end": 2151.18, "text": "孙全百拜刘皇叔,"}, {"start": 2151.18, "end": 2153.18, "text": "云长之梦,"}, {"start": 2153.18, "end": 2155.18, "text": "皆因吕蒙与其不沐,"}, {"start": 2155.18, "end": 2157.18, "text": "故擅自兴兵,"}, {"start": 2157.18, "end": 2159.18, "text": "成水火。"}, {"start": 2159.18, "end": 2161.18, "text": "今吕蒙已亡,"}, {"start": 2161.18, "end": 2163.18, "text": "冤仇当兮。"}, {"start": 2163.18, "end": 2165.18, "text": "至于一德蒙难,"}, {"start": 2165.18, "end": 2167.18, "text": "则是贵部叛将所为。"}, {"start": 2167.18, "end": 2169.18, "text": "全已将张达范江奉上,"}, {"start": 2169.18, "end": 2171.18, "text": "以示哀痛。"}, {"start": 2171.18, "end": 2173.18, "text": "天下皆知,"}, {"start": 2173.18, "end": 2175.18, "text": "陛下志在兴旱。"}, {"start": 2175.18, "end": 2177.18, "text": "今,"}, {"start": 2177.18, "end": 2179.18, "text": "陛下至曹魏不问,"}, {"start": 2179.18, "end": 2181.18, "text": "反御乏无,"}, {"start": 2181.18, "end": 2183.18, "text": "且为陛下不娶。"}, {"start": 2183.18, "end": 2185.18, "text": "五妹多年思归,"}, {"start": 2185.18, "end": 2187.18, "text": "全愿将五妹与京乡三郡"}, {"start": 2187.18, "end": 2189.18, "text": "一并送回,"}, {"start": 2189.18, "end": 2191.18, "text": "盼两家重结盟好,"}, {"start": 2191.18, "end": 2193.18, "text": "共灭曹魏,"}, {"start": 2193.18, "end": 2200.3, "text": "望陛下思之。"}, {"start": 2200.3, "end": 2206.49, "text": "当年,"}, {"start": 2206.49, "end": 2211.18, "text": "孙全为了夺娶京州,"}, {"start": 2211.18, "end": 2213.18, "text": "将小妹嫁给我。"}, {"start": 2213.18, "end": 2215.18, "text": "现在,"}, {"start": 2215.18, "end": 2217.18, "text": "为了保全江东,"}, {"start": 2217.18, "end": 2221.38, "text": "又想将小妹送来。"}, {"start": 2223.38, "end": 2229.54, "text": "朕让你告诉他,"}, {"start": 2229.54, "end": 2231.54, "text": "无论是小妹,"}, {"start": 2231.54, "end": 2235.43, "text": "她是京州,"}, {"start": 2235.43, "end": 2239.1, "text": "朕无需她送,"}, {"start": 2239.1, "end": 2241.1, "text": "朕自己会娶。"}, {"start": 2241.1, "end": 2243.1, "text": "陛下"}, {"start": 2243.1, "end": 2245.1, "text": "本是汉帝皇叔,"}, {"start": 2247.1, "end": 2249.1, "text": "草皮弑君篡汉,"}, {"start": 2251.1, "end": 2253.1, "text": "陛下不思剿除,"}, {"start": 2253.1, "end": 2255.1, "text": "却娶万长之尊,"}, {"start": 2255.1, "end": 2257.1, "text": "率兵伐吾。"}, {"start": 2259.1, "end": 2261.1, "text": "这实在是,"}, {"start": 2261.1, "end": 2263.1, "text": "设大义而救小丽儿。"}, {"start": 2263.1, "end": 2266.82, "text": "江东,"}, {"start": 2266.82, "end": 2268.82, "text": "不过是海内之地,"}, {"start": 2268.82, "end": 2270.82, "text": "而两都,"}, {"start": 2270.82, "end": 2274.1, "text": "却是汉族庙台之本。"}, {"start": 2274.1, "end": 2276.1, "text": "陛下不驱两都,"}, {"start": 2276.1, "end": 2278.1, "text": "却兵至江东,"}, {"start": 2278.1, "end": 2280.1, "text": "实乃,"}, {"start": 2280.1, "end": 2282.1, "text": "器重,"}, {"start": 2282.1, "end": 2297.77, "text": "而娶清也。"}, {"start": 2297.77, "end": 2303.64, "text": "用二弟三弟的命来吗?"}, {"start": 2303.64, "end": 2305.64, "text": "杀弟之仇,"}, {"start": 2305.64, "end": 2309.21, "text": "不共戴天,"}, {"start": 2309.21, "end": 2311.21, "text": "想要我罢兵,"}, {"start": 2311.21, "end": 2313.21, "text": "出死方休。"}, {"start": 2313.21, "end": 2315.21, "text": "草皮正式用兵,"}, {"start": 2315.21, "end": 2317.21, "text": "是恕吾两家,"}, {"start": 2317.21, "end": 2343.78, "text": "与时俱焚。"}, {"start": 2343.78, "end": 2345.78, "text": "不看在丞相的面子上,"}, {"start": 2345.78, "end": 2353.32, "text": "我先斩你的头,"}, {"start": 2353.32, "end": 2356.73, "text": "回去告诉孙犬,"}, {"start": 2356.73, "end": 2358.73, "text": "令他率领江东百官,"}, {"start": 2358.73, "end": 2402.97, "text": "来向我请降。"}, {"start": 2402.97, "end": 2404.97, "text": "刘备,"}, {"start": 2404.97, "end": 2406.97, "text": "拒绝哥哥了,"}, {"start": 2406.97, "end": 2412.01, "text": "那么,"}, {"start": 2412.01, "end": 2414.01, "text": "两家的血战,"}, {"start": 2414.01, "end": 2417.48, "text": "不可避免了。"}, {"start": 2417.48, "end": 2419.48, "text": "只怕,"}, {"start": 2419.48, "end": 2421.48, "text": "比当年赤壁之战,"}, {"start": 2421.48, "end": 2423.48, "text": "还要血腥。"}, {"start": 2425.48, "end": 2427.48, "text": "一头是我的哥哥,"}, {"start": 2427.48, "end": 2432.68, "text": "一头,"}, {"start": 2432.68, "end": 2434.68, "text": "是我的夫君。"}, {"start": 2434.68, "end": 2436.68, "text": "女儿的血,"}, {"start": 2436.68, "end": 2438.68, "text": "被这两个男人,"}, {"start": 2438.68, "end": 2440.68, "text": "抛成两半。"}, {"start": 2440.68, "end": 2442.68, "text": "女儿啊,"}, {"start": 2442.68, "end": 2448.62, "text": "对不起你。"}, {"start": 2448.62, "end": 2454.65, "text": "我恨刘备偷他了,"}, {"start": 2454.65, "end": 2461.1, "text": "我真该一剑杀了他。"}, {"start": 2461.1, "end": 2463.1, "text": "真的吗?"}, {"start": 2463.1, "end": 2474.57, "text": "胜负。"}]