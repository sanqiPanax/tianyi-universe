[{"start": 7.22, "end": 166.46, "text": "在我们玉旅部交战的时候,京都长安发生了惊天动地的巨变。"}, {"start": 166.46, "end": 176.66, "text": "东卓部就将离绝国寺,决略天子。"}, {"start": 176.66, "end": 179.66, "text": "后来又反目为仇,大砍大杀。"}, {"start": 179.66, "end": 185.66, "text": "天子和百官被沦为人质,被国内二人是拉来拉去。"}, {"start": 185.66, "end": 190.66, "text": "整个长安是一片废墟,血流成河,断水断粮。"}, {"start": 190.66, "end": 195.66, "text": "天子一粗糠腐肉为食,百官更是眼眼待毙。"}, {"start": 195.66, "end": 197.66, "text": "讲要紧的说。"}, {"start": 197.66, "end": 201.66, "text": "要紧的是天子在安吉将军董成的相助下,"}, {"start": 201.66, "end": 206.66, "text": "侥幸逃脱了长安,星夜向东逃往洛阳。"}, {"start": 206.66, "end": 209.66, "text": "天子在逃亡途中写下此诏,"}, {"start": 209.66, "end": 213.66, "text": "急招天下诸侯前去秦王。"}, {"start": 213.66, "end": 218.66, "text": "如此两个人,天子和百官被沦为人质。"}, {"start": 219.66, "end": 223.66, "text": "如此两计,千古难觅。"}, {"start": 224.66, "end": 226.66, "text": "两计?"}, {"start": 227.66, "end": 229.66, "text": "主公,这叫什么两计啊?"}, {"start": 229.66, "end": 236.3, "text": "主公的意思是,从长安到洛阳,"}, {"start": 236.3, "end": 238.3, "text": "必须经过盲荡山一带。"}, {"start": 238.3, "end": 241.3, "text": "此山离眼州不足五百里。"}, {"start": 241.3, "end": 245.3, "text": "主公想起兵救驾,"}, {"start": 246.3, "end": 250.3, "text": "待天子到手之后,就可以..."}, {"start": 250.3, "end": 253.3, "text": "就可以挟天子以令诸侯,"}, {"start": 253.3, "end": 255.3, "text": "掌天下之柄。"}, {"start": 255.3, "end": 264.76, "text": "天子已经逃出长安了,"}, {"start": 264.76, "end": 268.76, "text": "急招各镇诸侯前去护驾。"}, {"start": 268.76, "end": 270.76, "text": "你们说说,"}, {"start": 270.76, "end": 274.76, "text": "我是奉诏还是不奉诏呢?"}, {"start": 274.76, "end": 284.1, "text": "主公,依许忧之见,"}, {"start": 284.1, "end": 288.1, "text": "主公非但应该奉诏赶去护驾,"}, {"start": 288.1, "end": 292.1, "text": "而且还必须抢先一步。"}, {"start": 292.1, "end": 296.1, "text": "因为当今天下纷乱动荡,"}, {"start": 296.1, "end": 300.1, "text": "诸侯争雄,但只是各霸一方。"}, {"start": 300.1, "end": 302.1, "text": "在这种时候,"}, {"start": 302.1, "end": 305.1, "text": "谁若能把天子握于掌中,"}, {"start": 305.1, "end": 308.1, "text": "谁就可以知天下牛而已。"}, {"start": 308.1, "end": 314.72, "text": "许忧之言,真乃匹夫之见。"}, {"start": 314.72, "end": 317.72, "text": "如今天下大事一目了然,"}, {"start": 317.72, "end": 322.1, "text": "当今天子只是徒有虚名,"}, {"start": 322.1, "end": 325.1, "text": "汉室遥遥欲坠。"}, {"start": 325.1, "end": 327.1, "text": "主公,若真把他请来,"}, {"start": 327.1, "end": 330.1, "text": "那是给自己添了个累赘。"}, {"start": 330.1, "end": 333.1, "text": "试问,天子如果来了,"}, {"start": 333.1, "end": 336.1, "text": "这冀州谁是主人?"}, {"start": 336.1, "end": 339.1, "text": "是主公你还是那个小娃儿?"}, {"start": 339.1, "end": 341.1, "text": "再者说,"}, {"start": 341.1, "end": 343.1, "text": "如果他白起皇帝谱来,"}, {"start": 343.1, "end": 345.1, "text": "今天一诏,"}, {"start": 345.1, "end": 348.1, "text": "明日一指,你听是不听,"}, {"start": 348.1, "end": 350.1, "text": "从是不从。"}, {"start": 350.1, "end": 354.63, "text": "天封说得有理。"}, {"start": 354.63, "end": 357.63, "text": "那天子也确实是个累赘。"}, {"start": 357.63, "end": 361.94, "text": "我就解罢。"}, {"start": 361.94, "end": 362.94, "text": "主公,"}, {"start": 362.94, "end": 364.94, "text": "刚才天封所言,"}, {"start": 364.94, "end": 367.94, "text": "那才真正是数目寸光,"}, {"start": 367.94, "end": 369.94, "text": "欲浮短见。"}, {"start": 369.94, "end": 372.94, "text": "大汉虽然遥遥欲坠,"}, {"start": 372.94, "end": 374.94, "text": "可尚未崩溃。"}, {"start": 374.94, "end": 377.94, "text": "那天子虽然年少无为,"}, {"start": 377.94, "end": 379.94, "text": "且徒有虚名,"}, {"start": 379.94, "end": 381.94, "text": "可他仍为汉帝。"}, {"start": 381.94, "end": 385.94, "text": "主公,你虽贵为冀州之主,"}, {"start": 385.94, "end": 389.94, "text": "可你仍是汉帝之臣啊。"}, {"start": 389.94, "end": 391.94, "text": "有道是,"}, {"start": 391.94, "end": 393.94, "text": "名不正则言不顺,"}, {"start": 393.94, "end": 395.94, "text": "言不顺则必败言。"}, {"start": 395.94, "end": 402.36, "text": "天子可不是累赘啊,"}, {"start": 402.36, "end": 408.36, "text": "那是一面号召天下诸侯的皇旗,"}, {"start": 408.36, "end": 413.83, "text": "一面统领三军的大盗啊。"}, {"start": 413.83, "end": 417.83, "text": "其作用可限量乎。"}, {"start": 417.83, "end": 419.83, "text": "在下担心,"}, {"start": 419.83, "end": 421.83, "text": "如果主公弃而不娶,"}, {"start": 421.83, "end": 426.83, "text": "定会落入别人掌中。"}, {"start": 426.83, "end": 430.27, "text": "谁会娶娶?"}, {"start": 430.27, "end": 432.27, "text": "燕州的曹操,"}, {"start": 432.27, "end": 434.27, "text": "荆州的刘表,"}, {"start": 434.27, "end": 436.27, "text": "他们都会娶娶,"}, {"start": 436.27, "end": 438.27, "text": "尤其是那曹操,"}, {"start": 438.27, "end": 440.27, "text": "甚至会娶姜。"}, {"start": 440.27, "end": 442.27, "text": "许幽之言,"}, {"start": 442.27, "end": 444.27, "text": "威严俗听啊,"}, {"start": 444.27, "end": 446.27, "text": "什么大旗大盗。"}, {"start": 446.27, "end": 448.27, "text": "那昔日天子,"}, {"start": 448.27, "end": 450.27, "text": "不过是寒秋中的一片落叶,"}, {"start": 450.27, "end": 452.27, "text": "无用之物罢了。"}, {"start": 452.27, "end": 454.27, "text": "曹操想要,"}, {"start": 454.27, "end": 456.27, "text": "任由他取却。"}, {"start": 456.27, "end": 458.27, "text": "我家主公,"}, {"start": 458.27, "end": 460.27, "text": "应该不上虚名,"}, {"start": 460.27, "end": 462.27, "text": "专心实际。"}, {"start": 462.27, "end": 464.27, "text": "敢问,"}, {"start": 464.27, "end": 466.27, "text": "当今最大的实际是什么?"}, {"start": 466.27, "end": 467.27, "text": "我以为,"}, {"start": 467.27, "end": 469.27, "text": "是迅速消灭公孙瓒,"}, {"start": 469.27, "end": 471.27, "text": "兼并青州幽州。"}, {"start": 471.27, "end": 473.27, "text": "如果此一成功,"}, {"start": 473.27, "end": 475.27, "text": "那天下神州,"}, {"start": 475.27, "end": 477.27, "text": "我家主公已独占四州。"}, {"start": 477.27, "end": 479.27, "text": "这和真正的天子,"}, {"start": 479.27, "end": 481.27, "text": "又有什么区别?"}, {"start": 481.27, "end": 483.27, "text": "所以主公,"}, {"start": 483.27, "end": 485.27, "text": "应该整军备战,"}, {"start": 485.27, "end": 487.27, "text": "迅速兼并清幽,"}, {"start": 487.27, "end": 492.95, "text": "切勿分心旁悟啊。"}, {"start": 492.95, "end": 496.26, "text": "主公,"}, {"start": 496.26, "end": 498.26, "text": "我意已决,"}, {"start": 498.26, "end": 500.26, "text": "不奉天子诏令。"}, {"start": 500.26, "end": 502.26, "text": "今备战,"}, {"start": 502.26, "end": 504.26, "text": "等秋收过后,"}, {"start": 504.26, "end": 506.26, "text": "粮饷备足,"}, {"start": 506.26, "end": 508.26, "text": "即可发兵,"}, {"start": 508.26, "end": 510.26, "text": "进去幽州。"}, {"start": 510.26, "end": 521.38, "text": "主公短见,"}, {"start": 521.38, "end": 523.38, "text": "庸臣无功,"}, {"start": 523.38, "end": 527.76, "text": "一只小小的传国玉璽。"}, {"start": 527.76, "end": 529.76, "text": "各路诸侯,"}, {"start": 529.76, "end": 531.76, "text": "尚且争来抢去,"}, {"start": 531.76, "end": 534.76, "text": "可一个活生生的皇帝,"}, {"start": 534.76, "end": 536.76, "text": "却怎么没人要呢?"}, {"start": 536.76, "end": 548.2, "text": "主是庸主。"}, {"start": 548.2, "end": 576.89, "text": "庸快,庸快。"}, {"start": 576.89, "end": 578.89, "text": "你们看,"}, {"start": 578.89, "end": 580.89, "text": "咱们跟太阳"}, {"start": 580.89, "end": 582.89, "text": "一块登上盲荡山了。"}, {"start": 582.89, "end": 584.89, "text": "已经一天一夜,"}, {"start": 584.89, "end": 586.89, "text": "走了五百多里了。"}, {"start": 586.89, "end": 588.89, "text": "这人不累,马也累啊。"}, {"start": 588.89, "end": 590.89, "text": "咱们还是歇息歇息吧。"}, {"start": 590.89, "end": 592.89, "text": "行,"}, {"start": 592.89, "end": 594.89, "text": "那就稍歇片刻。"}, {"start": 594.89, "end": 596.89, "text": "等日上三干的时候,"}, {"start": 596.89, "end": 598.89, "text": "继续出发。"}, {"start": 598.89, "end": 600.89, "text": "遵命。"}, {"start": 600.89, "end": 602.89, "text": "袁绍有什么动静?"}, {"start": 602.89, "end": 604.89, "text": "袁绍没有奉旨前来护驾。"}, {"start": 605.89, "end": 608.89, "text": "袁绍离盲荡山如此的近,"}, {"start": 608.89, "end": 610.89, "text": "可是他却没有来。"}, {"start": 610.89, "end": 612.89, "text": "人婚姻到这个地步,"}, {"start": 612.89, "end": 614.89, "text": "真是叫人喜欢啊。"}, {"start": 615.89, "end": 617.89, "text": "袁叔和刘表呢?"}, {"start": 617.89, "end": 619.89, "text": "南阳的袁叔没有行动,"}, {"start": 619.89, "end": 622.89, "text": "荆州的探少回报也没有到。"}, {"start": 622.89, "end": 625.89, "text": "估计他们也不可能前来护驾。"}, {"start": 626.89, "end": 628.89, "text": "看来天子非我莫属了。"}, {"start": 629.89, "end": 631.89, "text": "怎么?"}, {"start": 631.89, "end": 633.89, "text": "我的意思是说,"}, {"start": 633.89, "end": 635.89, "text": "看来救驾的,"}, {"start": 635.89, "end": 637.89, "text": "非我不可啦。"}, {"start": 639.89, "end": 641.89, "text": "主公!"}, {"start": 641.89, "end": 643.89, "text": "主公!"}, {"start": 643.89, "end": 645.89, "text": "谁下意的发现车轴印!"}, {"start": 645.89, "end": 647.89, "text": "撤!"}, {"start": 647.89, "end": 649.89, "text": "轮尖齿幅有多快?"}, {"start": 649.89, "end": 651.89, "text": "轮尖齿幅六尺六。"}, {"start": 651.89, "end": 653.89, "text": "六尺六?"}, {"start": 653.89, "end": 655.89, "text": "不好,天子的坐驾已经过去了。"}, {"start": 655.89, "end": 657.89, "text": "马上出发,全力追赶。"}, {"start": 657.89, "end": 659.89, "text": "主公,"}, {"start": 659.89, "end": 661.89, "text": "我们车车上看,"}, {"start": 661.89, "end": 663.89, "text": "这车已经驾过去很长时间了,"}, {"start": 663.89, "end": 665.89, "text": "咱们要是追不上怎么办?"}, {"start": 665.89, "end": 667.89, "text": "追不上?"}, {"start": 667.89, "end": 669.89, "text": "你就是给我追到洛阳城,"}, {"start": 669.89, "end": 671.89, "text": "追到常乐宫,"}, {"start": 671.89, "end": 673.89, "text": "追到上天入地,"}, {"start": 673.89, "end": 675.89, "text": "也要把天子给我追到手,"}, {"start": 675.89, "end": 686.21, "text": "听到了吗?"}, {"start": 686.21, "end": 688.21, "text": "主公,这五百多里啊。"}, {"start": 688.21, "end": 690.21, "text": "快去!"}, {"start": 690.21, "end": 692.21, "text": "咱们还是歇一会再走吧。"}, {"start": 692.21, "end": 694.21, "text": "刚才你警下令,"}, {"start": 694.21, "end": 696.21, "text": "说太阳到了三干,"}, {"start": 696.21, "end": 698.21, "text": "你说没用,走!"}, {"start": 698.21, "end": 714.96, "text": "陛下,陛下,"}, {"start": 714.96, "end": 721.54, "text": "来,陛下,"}, {"start": 721.54, "end": 723.54, "text": "我们终算是回来了。"}, {"start": 723.54, "end": 725.54, "text": "陛下,回宫了,陛下。"}, {"start": 737.39, "end": 739.39, "text": "陛下,我们终算是回来了。"}, {"start": 744.66, "end": 746.66, "text": "陛下,陛下,"}, {"start": 746.66, "end": 748.66, "text": "我们终算是回宫了。"}, {"start": 750.66, "end": 755.02, "text": "陛下,"}, {"start": 755.02, "end": 757.02, "text": "陛下,"}, {"start": 757.02, "end": 759.02, "text": "先坐一会儿吧。"}, {"start": 766.62, "end": 812.5, "text": "整座皇城都炒变了,"}, {"start": 812.5, "end": 814.5, "text": "没有水,"}, {"start": 814.5, "end": 816.5, "text": "连护人河都干了,"}, {"start": 816.5, "end": 826.5, "text": "祖宗保佑,"}, {"start": 826.5, "end": 828.5, "text": "最艰难的时候都过去了。"}, {"start": 828.5, "end": 832.48, "text": "陛下,"}, {"start": 832.48, "end": 834.48, "text": "这次咱们重返东东,"}, {"start": 836.48, "end": 838.48, "text": "盯着镇兴大汉的。"}, {"start": 838.48, "end": 843.2, "text": "恭喜皇上回朝!"}, {"start": 843.2, "end": 845.2, "text": "恭喜皇上回朝!"}, {"start": 845.2, "end": 853.12, "text": "est"}, {"start": 874.94, "end": 875.78, "text": "最美家"}, {"start": 875.78, "end": 876.78, "text": "最美家"}, {"start": 876.78, "end": 877.78, "text": "最美派"}, {"start": 877.78, "end": 878.78, "text": "最美派"}, {"start": 878.78, "end": 879.76, "text": "天赋最美"}, {"start": 879.76, "end": 880.38, "text": "太后"}, {"start": 880.38, "end": 881.46, "text": "天赋最美"}, {"start": 881.46, "end": 881.8, "text": "气AK"}, {"start": 881.8, "end": 882.34, "text": "气AK"}, {"start": 882.34, "end": 883.2, "text": "万全"}, {"start": 883.2, "end": 884.56, "text": "天赋最美"}, {"start": 884.56, "end": 888.44, "text": "九家 九家"}, {"start": 889.52, "end": 890.96, "text": "祖宗啊"}, {"start": 893.4, "end": 895.12, "text": "睁开眼"}, {"start": 896.36, "end": 904.46, "text": "看看皇朝的子孙吧"}, {"start": 905.02, "end": 906.18, "text": "胡佑"}, {"start": 911.58, "end": 914.26, "text": "怎么办 你们快点拿主意啊"}, {"start": 915.22, "end": 917.46, "text": "大喜啊 大喜啊"}, {"start": 917.46, "end": 918.9, "text": "救兵 救兵"}, {"start": 918.9, "end": 920.54, "text": "救兵来了 皇上"}, {"start": 921.22, "end": 922.82, "text": "陛下 陛下"}, {"start": 923.1, "end": 924.54, "text": "祖宗显灵了"}, {"start": 924.54, "end": 926.22, "text": "救兵到了"}, {"start": 927.54, "end": 928.86, "text": "是谁来救"}, {"start": 928.86, "end": 930.58, "text": "肯定是冀州的元少"}, {"start": 930.58, "end": 932.3, "text": "奉招前来护驾"}, {"start": 932.3, "end": 934.38, "text": "他离洛阳最近啊"}, {"start": 934.38, "end": 935.38, "text": "陛下"}, {"start": 935.86, "end": 936.74, "text": "好"}, {"start": 936.74, "end": 937.74, "text": "忠臣啊"}, {"start": 937.74, "end": 938.58, "text": "好"}, {"start": 939.14, "end": 940.1, "text": "陛下"}, {"start": 940.1, "end": 941.5, "text": "真是忠臣啊"}, {"start": 941.5, "end": 942.3, "text": "陛下"}, {"start": 945.1, "end": 946.02, "text": "禀陛下"}, {"start": 946.02, "end": 948.5, "text": "救兵不 不是冀州元少"}, {"start": 948.5, "end": 950.42, "text": "是 延 延州刺史"}, {"start": 950.94, "end": 952.22, "text": "曹操"}, {"start": 952.58, "end": 954.1, "text": "怎么是曹操啊"}, {"start": 954.1, "end": 955.06, "text": "曹孟德"}, {"start": 955.06, "end": 956.14, "text": "这是怎么回事"}, {"start": 957.82, "end": 959.02, "text": "朕没想到"}, {"start": 959.94, "end": 961.74, "text": "曹操能来呀"}, {"start": 961.74, "end": 963.02, "text": "是啊"}, {"start": 963.02, "end": 965.1, "text": "元少离洛阳最近"}, {"start": 965.1, "end": 967.34, "text": "却左直不顾"}, {"start": 967.34, "end": 968.94, "text": "而曹操"}, {"start": 968.94, "end": 970.54, "text": "却从千里之外"}, {"start": 970.54, "end": 971.9, "text": "赶来护驾"}, {"start": 973.7, "end": 974.7, "text": "陛下"}, {"start": 975.7, "end": 977.1, "text": "这真是"}, {"start": 977.1, "end": 979.18, "text": "家平见孝子"}, {"start": 979.74, "end": 982.38, "text": "祸难见忠臣啊"}, {"start": 982.38, "end": 983.18, "text": "陛下"}, {"start": 983.18, "end": 984.94, "text": "是啊 皇上"}, {"start": 986.1, "end": 988.46, "text": "待会曹操来了"}, {"start": 988.46, "end": 989.14, "text": "您可要"}, {"start": 989.14, "end": 991.78, "text": "好好地奖赏他几句呀"}, {"start": 991.78, "end": 993.54, "text": "是啊 皇上"}, {"start": 993.54, "end": 995.86, "text": "可要好好地奖赏他"}, {"start": 997.26, "end": 998.26, "text": "陛下"}, {"start": 999.98, "end": 1001.54, "text": "朕知道"}, {"start": 1001.54, "end": 1003.22, "text": "朕"}, {"start": 1003.22, "end": 1004.66, "text": "重重地夸奖他"}, {"start": 1017.5, "end": 1018.5, "text": "给朕更衣"}, {"start": 1018.66, "end": 1020.46, "text": "快 给皇上更衣"}, {"start": 1020.46, "end": 1021.58, "text": "快 快"}, {"start": 1024.66, "end": 1025.34, "text": "荀玉"}, {"start": 1025.34, "end": 1026.02, "text": "在"}, {"start": 1026.7, "end": 1027.98, "text": "有个事儿忘了"}, {"start": 1027.98, "end": 1029.14, "text": "何事"}, {"start": 1029.14, "end": 1030.98, "text": "依礼外臣觐见天子"}, {"start": 1030.98, "end": 1032.94, "text": "都得上供点什么"}, {"start": 1032.94, "end": 1033.78, "text": "我走得匆忙"}, {"start": 1033.78, "end": 1035.22, "text": "什么都没准备怎么办"}, {"start": 1035.22, "end": 1035.9, "text": "禀主公"}, {"start": 1035.9, "end": 1037.06, "text": "在下倒有个主意"}, {"start": 1037.06, "end": 1037.66, "text": "说"}, {"start": 1037.66, "end": 1039.5, "text": "此时此刻天子和百官"}, {"start": 1039.5, "end": 1041.62, "text": "肯定是饥寒交迫"}, {"start": 1041.62, "end": 1043.42, "text": "他们现在最需要什么"}, {"start": 1043.42, "end": 1044.7, "text": "一口肉汤"}, {"start": 1044.7, "end": 1046.42, "text": "两只面饼罢了"}, {"start": 1046.42, "end": 1047.42, "text": "这个时候"}, {"start": 1047.42, "end": 1048.46, "text": "一口肉汤"}, {"start": 1048.46, "end": 1049.98, "text": "胜死万两黄金啊"}, {"start": 1049.98, "end": 1050.82, "text": "没错"}, {"start": 1050.82, "end": 1052.1, "text": "当年我亡命的时候"}, {"start": 1052.1, "end": 1054.1, "text": "馋肉汤馋得真是要命啊"}, {"start": 1054.1, "end": 1054.58, "text": "曹人"}, {"start": 1054.58, "end": 1055.5, "text": "在"}, {"start": 1055.5, "end": 1056.3, "text": "曹当地"}, {"start": 1056.3, "end": 1056.86, "text": "遵命"}, {"start": 1056.86, "end": 1058.22, "text": "还有一事情主公在意"}, {"start": 1058.22, "end": 1059.22, "text": "说"}, {"start": 1059.22, "end": 1060.78, "text": "主公拜见天子时"}, {"start": 1060.78, "end": 1062.82, "text": "务必恪守朝廷礼法"}, {"start": 1062.82, "end": 1065.34, "text": "让天子和百官安心"}, {"start": 1065.34, "end": 1077.32, "text": "知道了 知道了"}, {"start": 1077.32, "end": 1078.72, "text": "荀玉"}, {"start": 1078.72, "end": 1080.52, "text": "还有一件事你也得考虑"}, {"start": 1080.52, "end": 1082.04, "text": "何事"}, {"start": 1082.04, "end": 1084.4, "text": "洛阳已成废墟不能再用"}, {"start": 1084.4, "end": 1085.44, "text": "我们接驾之后"}, {"start": 1085.44, "end": 1087.92, "text": "该在何处建都为托"}, {"start": 1087.92, "end": 1089.64, "text": "盐州府许县"}, {"start": 1089.64, "end": 1090.88, "text": "为何"}, {"start": 1090.88, "end": 1093.08, "text": "因为那是主公的腹地"}, {"start": 1093.08, "end": 1094.2, "text": "主公把天子放在"}, {"start": 1094.2, "end": 1096.4, "text": "自个儿的身边才会安心"}, {"start": 1096.4, "end": 1098.92, "text": "其实主公早就想好了"}, {"start": 1098.92, "end": 1101.56, "text": "但不愿执眼"}, {"start": 1101.56, "end": 1104.3, "text": "荀玉"}, {"start": 1104.3, "end": 1105.78, "text": "你怎么把我的心思"}, {"start": 1105.78, "end": 1110.21, "text": "琢磨得这么透"}, {"start": 1110.21, "end": 1111.41, "text": "禀主公"}, {"start": 1111.41, "end": 1113.69, "text": "这是做属下的本分"}, {"start": 1139.46, "end": 1142.02, "text": "盐州刺史曹操"}, {"start": 1142.02, "end": 1143.82, "text": "叩见吾皇"}, {"start": 1143.82, "end": 1175.0, "text": "宦南见忠臣哪"}, {"start": 1175.0, "end": 1199.78, "text": "爱卿平身"}, {"start": 1199.78, "end": 1202.1, "text": "吾皇万岁万岁"}, {"start": 1202.1, "end": 1230.65, "text": "万万岁"}, {"start": 1230.65, "end": 1234.08, "text": "陛下 请"}, {"start": 1234.08, "end": 1235.72, "text": "爱卿"}, {"start": 1235.72, "end": 1237.56, "text": "这是何物啊"}, {"start": 1237.56, "end": 1241.48, "text": "请陛下一猜"}, {"start": 1241.48, "end": 1246.26, "text": "玉玺"}, {"start": 1246.26, "end": 1249.11, "text": "玛瑙"}, {"start": 1249.11, "end": 1252.78, "text": "琥珀"}, {"start": 1252.78, "end": 1255.18, "text": "朕猜不出来了"}, {"start": 1255.18, "end": 1266.32, "text": "请陛下揭盖"}, {"start": 1266.32, "end": 1267.2, "text": "陛下"}, {"start": 1267.2, "end": 1283.1, "text": "这是刚刚烹熟的鸡汤啊"}, {"start": 1283.1, "end": 1284.62, "text": "爱卿啊"}, {"start": 1284.62, "end": 1285.7, "text": "朕"}, {"start": 1285.7, "end": 1289.9, "text": "已经半年多没有吃过肉粪了"}, {"start": 1289.9, "end": 1314.13, "text": "请陛下用膳"}, {"start": 1314.13, "end": 1315.25, "text": "各位大人"}, {"start": 1315.25, "end": 1316.77, "text": "请用膳吧"}, {"start": 1346.03, "end": 1371.95, "text": "臣"}, {"start": 1371.95, "end": 1378.37, "text": "恭请陛下教育盐州将士"}, {"start": 1378.37, "end": 1380.41, "text": "爱卿啊"}, {"start": 1380.41, "end": 1382.49, "text": "这些将士都是你的吗"}, {"start": 1382.49, "end": 1383.77, "text": "不"}, {"start": 1383.77, "end": 1387.01, "text": "他们都是天子的将士"}, {"start": 1387.01, "end": 1389.21, "text": "你有多少兵马"}, {"start": 1389.21, "end": 1390.73, "text": "精兵五十万"}, {"start": 1390.73, "end": 1399.29, "text": "战将上千元"}, {"start": 1399.29, "end": 1400.21, "text": "了不起"}, {"start": 1400.21, "end": 1405.31, "text": "比董卓他们英雄十倍"}, {"start": 1405.31, "end": 1442.12, "text": "有曹将军在"}, {"start": 1442.12, "end": 1444.28, "text": "这乃朝廷之幸"}, {"start": 1444.28, "end": 1446.04, "text": "大汉之福"}, {"start": 1446.04, "end": 1448.2, "text": "乱贼可灭"}, {"start": 1448.2, "end": 1450.88, "text": "大势可欺"}, {"start": 1450.88, "end": 1452.16, "text": "陛下"}, {"start": 1452.16, "end": 1453.52, "text": "现在"}, {"start": 1453.52, "end": 1456.36, "text": "应该奖赏曹操才是"}, {"start": 1456.36, "end": 1457.92, "text": "爱卿啊"}, {"start": 1457.92, "end": 1458.88, "text": "朕"}, {"start": 1458.88, "end": 1461.52, "text": "拜你为大将军"}, {"start": 1461.52, "end": 1462.92, "text": "授武平侯"}, {"start": 1462.92, "end": 1466.68, "text": "从今天起你就是这天下的栋梁"}, {"start": 1466.68, "end": 1467.76, "text": "臣"}, {"start": 1467.76, "end": 1469.6, "text": "谢五皇贺文"}, {"start": 1469.6, "end": 1473.08, "text": "恭祝武平侯"}, {"start": 1473.08, "end": 1474.36, "text": "禀陛下"}, {"start": 1474.4, "end": 1476.56, "text": "臣有本劲奏"}, {"start": 1476.56, "end": 1479.04, "text": "爱卿请讲"}, {"start": 1479.04, "end": 1480.84, "text": "东都洛阳"}, {"start": 1480.84, "end": 1483.8, "text": "眼下已是残破不堪"}, {"start": 1483.8, "end": 1486.92, "text": "宫廷庙宇皆为乱军所废"}, {"start": 1486.92, "end": 1487.88, "text": "而且"}, {"start": 1487.88, "end": 1491.44, "text": "洛阳聚西梁贼军太近"}, {"start": 1491.44, "end": 1494.48, "text": "臣为天子安危所忌"}, {"start": 1494.48, "end": 1498.24, "text": "为忠心大汉宗室所想"}, {"start": 1498.24, "end": 1500.64, "text": "恳请千都许昌"}, {"start": 1500.64, "end": 1501.96, "text": "重建朝廷"}, {"start": 1501.96, "end": 1508.31, "text": "重振朝纲"}, {"start": 1508.35, "end": 1509.99, "text": "这是二百年帝都"}, {"start": 1509.99, "end": 1512.83, "text": "天灵地秀 虎巨龙盘"}, {"start": 1512.83, "end": 1514.71, "text": "许昌是什么地方"}, {"start": 1514.71, "end": 1517.15, "text": "是曹操的王朝啊"}, {"start": 1517.15, "end": 1519.19, "text": "如果千都许昌"}, {"start": 1519.19, "end": 1521.55, "text": "那不是掉进曹操的囊中了吗"}, {"start": 1521.55, "end": 1521.95, "text": "是不是"}, {"start": 1521.95, "end": 1522.95, "text": "是啊是啊"}, {"start": 1522.95, "end": 1558.92, "text": "言之有理"}, {"start": 1558.92, "end": 1560.84, "text": "陛下看看吧"}, {"start": 1560.84, "end": 1563.32, "text": "陛下好好看看吧"}, {"start": 1563.32, "end": 1565.28, "text": "只有在许昌才能得到"}, {"start": 1565.28, "end": 1567.88, "text": "这么多精兵猛将的保护"}, {"start": 1567.88, "end": 1579.49, "text": "朝廷才能安然无忧啊"}, {"start": 1579.49, "end": 1581.41, "text": "千都许"}, {"start": 1581.97, "end": 1583.25, "text": "许昌"}, {"start": 1583.25, "end": 1607.0, "text": "刚逃出兰窝"}, {"start": 1607.0, "end": 1609.92, "text": "却又落入虎穴"}, {"start": 1609.92, "end": 1614.34, "text": "这可怎说是好"}, {"start": 1614.34, "end": 1617.06, "text": "事已至此"}, {"start": 1617.06, "end": 1620.82, "text": "陛下应该韬光养贵"}, {"start": 1620.82, "end": 1622.54, "text": "官时待变"}, {"start": 1622.54, "end": 1629.26, "text": "不会把朕杀了"}, {"start": 1629.26, "end": 1631.18, "text": "自己当皇帝"}, {"start": 1631.18, "end": 1632.74, "text": "不会"}, {"start": 1632.74, "end": 1634.74, "text": "曹操只是想把陛下"}, {"start": 1634.74, "end": 1636.22, "text": "握于掌中"}, {"start": 1636.22, "end": 1644.58, "text": "为他所用"}, {"start": 1644.58, "end": 1691.09, "text": "那朕不就成了个弃物了吗"}, {"start": 1691.13, "end": 1692.29, "text": "马上"}, {"start": 1692.29, "end": 1693.85, "text": "以汉帝之名逆旨"}, {"start": 1693.85, "end": 1695.93, "text": "召告天下"}, {"start": 1695.93, "end": 1698.73, "text": "就说天子"}, {"start": 1698.73, "end": 1702.13, "text": "将帝都迁于许昌"}, {"start": 1702.13, "end": 1704.65, "text": "召告各州驻侯"}, {"start": 1704.65, "end": 1706.53, "text": "太守四使将军"}, {"start": 1706.53, "end": 1708.89, "text": "速速前来朝拜"}, {"start": 1708.89, "end": 1710.25, "text": "此外"}, {"start": 1710.25, "end": 1712.05, "text": "自即日起"}, {"start": 1712.05, "end": 1714.89, "text": "许昌更名为许东"}, {"start": 1714.89, "end": 1716.57, "text": "朝廷改年号为"}, {"start": 1716.57, "end": 1719.33, "text": "建安并大赦天下"}, {"start": 1719.33, "end": 1722.06, "text": "遵命"}, {"start": 1722.14, "end": 1785.74, "text": "驾"}, {"start": 1785.74, "end": 1798.37, "text": "平身"}, {"start": 1798.37, "end": 1800.01, "text": "禀陛下"}, {"start": 1800.01, "end": 1802.89, "text": "自从迁都许昌以来"}, {"start": 1802.89, "end": 1805.57, "text": "天下军民无不欢欣鼓舞"}, {"start": 1805.57, "end": 1807.13, "text": "交口称信"}, {"start": 1807.13, "end": 1809.81, "text": "九州也是海燕和亲"}, {"start": 1809.81, "end": 1811.81, "text": "雨顺风调"}, {"start": 1811.81, "end": 1813.05, "text": "好 好"}, {"start": 1813.05, "end": 1814.65, "text": "这都是爱亲之功"}, {"start": 1814.65, "end": 1817.01, "text": "朕"}, {"start": 1817.01, "end": 1818.85, "text": "欢喜得很"}, {"start": 1818.85, "end": 1822.33, "text": "恳请陛下恩旨"}, {"start": 1822.33, "end": 1825.37, "text": "加封季州袁绍为大将军"}, {"start": 1825.37, "end": 1827.09, "text": "授武廷侯"}, {"start": 1827.09, "end": 1829.77, "text": "加封南阳袁术为镖戚将军"}, {"start": 1829.77, "end": 1831.37, "text": "授忠义侯"}, {"start": 1831.37, "end": 1834.53, "text": "加封金州刘表为前将军"}, {"start": 1834.53, "end": 1836.13, "text": "授东安侯"}, {"start": 1836.13, "end": 1839.13, "text": "加封幽州公孙瓒为后将军"}, {"start": 1839.13, "end": 1847.62, "text": "授靖安侯"}, {"start": 1847.62, "end": 1849.82, "text": "曹操"}, {"start": 1849.82, "end": 1852.3, "text": "天子刚刚一驾许昌"}, {"start": 1852.3, "end": 1854.1, "text": "百费待兴"}, {"start": 1854.1, "end": 1856.38, "text": "为何要急于嘉奖"}, {"start": 1856.38, "end": 1857.86, "text": "各路诸侯呢"}, {"start": 1857.86, "end": 1859.58, "text": "正是因为刚刚迁都"}, {"start": 1859.58, "end": 1861.5, "text": "所以才要恩威天下"}, {"start": 1861.5, "end": 1864.7, "text": "机不可失 时不我待"}, {"start": 1864.7, "end": 1867.18, "text": "族下在这道奏章里"}, {"start": 1867.18, "end": 1871.7, "text": "把袁绍 刘表 公孙瓒"}, {"start": 1871.7, "end": 1876.74, "text": "这各路诸侯都封赏了一遍"}, {"start": 1876.74, "end": 1879.3, "text": "有的还生寿两三级"}, {"start": 1879.3, "end": 1882.94, "text": "可独独没有你自个儿呀"}, {"start": 1882.94, "end": 1884.98, "text": "想当年"}, {"start": 1884.98, "end": 1888.5, "text": "董卓还把自己封个什么"}, {"start": 1888.5, "end": 1890.9, "text": "相国"}, {"start": 1890.9, "end": 1895.58, "text": "甚至还自号上傅"}, {"start": 1895.58, "end": 1898.9, "text": "你为何不请之加恩呢"}, {"start": 1898.9, "end": 1902.58, "text": "那正是董卓的狂妄和愚蠢"}, {"start": 1902.58, "end": 1904.26, "text": "我不是董卓"}, {"start": 1904.26, "end": 1910.62, "text": "我是曹操"}, {"start": 1910.62, "end": 1913.9, "text": "臣是受不恩"}, {"start": 1913.9, "end": 1915.42, "text": "知恩图报"}, {"start": 1915.42, "end": 1917.5, "text": "只想为陛下尽忠"}, {"start": 1917.5, "end": 1924.02, "text": "不想贪图虚名"}, {"start": 1924.02, "end": 1929.1, "text": "族下是勿识 图勿虚眼"}, {"start": 1929.1, "end": 1944.84, "text": "凡曹爱卿所奏"}, {"start": 1944.84, "end": 1949.2, "text": "朕 胡不照传"}, {"start": 1949.2, "end": 1952.76, "text": "臣谢恩"}, {"start": 1952.76, "end": 1955.32, "text": "朝廷颁罚诏书"}, {"start": 1955.32, "end": 1957.8, "text": "封我为司马将军"}, {"start": 1957.8, "end": 1960.24, "text": "加授武廷侯"}, {"start": 1960.24, "end": 1964.56, "text": "朝廷还把济州 青州"}, {"start": 1964.56, "end": 1967.48, "text": "深州我们一直图谋工区"}, {"start": 1967.48, "end": 1971.36, "text": "但还没有到手的病州"}, {"start": 1971.36, "end": 1978.34, "text": "也一并地赤封给我了"}, {"start": 1978.34, "end": 1980.26, "text": "你们说说"}, {"start": 1980.26, "end": 1989.76, "text": "此诏 我是接还是不接"}, {"start": 1989.76, "end": 1992.28, "text": "恭喜主公容领大将军"}, {"start": 1992.28, "end": 1997.02, "text": "此诏当接"}, {"start": 1997.02, "end": 1999.62, "text": "朝廷刚刚迁于许昌"}, {"start": 1999.62, "end": 2001.94, "text": "天子自顾不暇"}, {"start": 2001.94, "end": 2003.78, "text": "此诏只不过是一道"}, {"start": 2003.78, "end": 2007.9, "text": "顺水人情罢了"}, {"start": 2007.9, "end": 2011.42, "text": "主公 以在下之见"}, {"start": 2011.42, "end": 2013.46, "text": "这道诏书表面上看"}, {"start": 2013.46, "end": 2015.7, "text": "是个顺水人情"}, {"start": 2015.7, "end": 2021.17, "text": "实际上是暗藏祸心哪"}, {"start": 2021.17, "end": 2023.45, "text": "主公应该明白"}, {"start": 2023.45, "end": 2024.73, "text": "这道诏书"}, {"start": 2024.73, "end": 2028.17, "text": "虽然是以皇帝的名义下诏"}, {"start": 2028.17, "end": 2030.85, "text": "可从那诏书的字里行间中"}, {"start": 2030.85, "end": 2033.05, "text": "不难看出那每一个字"}, {"start": 2033.05, "end": 2035.21, "text": "都是曹操的意思"}, {"start": 2035.21, "end": 2038.05, "text": "主公 你一旦接下此诏"}, {"start": 2038.05, "end": 2040.29, "text": "就须上表谢恩"}, {"start": 2040.29, "end": 2041.81, "text": "如此一来"}, {"start": 2041.81, "end": 2044.57, "text": "就等于主公你承认了那曹操"}, {"start": 2044.57, "end": 2047.97, "text": "挟天子以令诸侯是合法的了"}, {"start": 2047.97, "end": 2051.17, "text": "主公如果不接此诏"}, {"start": 2051.17, "end": 2052.81, "text": "又有违臣道"}, {"start": 2052.81, "end": 2055.81, "text": "那曹操会说你身为汉臣"}, {"start": 2055.81, "end": 2057.65, "text": "却对抗朝廷"}, {"start": 2057.65, "end": 2060.89, "text": "此外 今天是以恩诏"}, {"start": 2060.89, "end": 2062.65, "text": "主公便接了"}, {"start": 2062.65, "end": 2065.65, "text": "明天再来一恶诏呢"}, {"start": 2065.65, "end": 2069.53, "text": "令主公或纳粮 或退兵"}, {"start": 2069.53, "end": 2072.41, "text": "甚至是让你割地"}, {"start": 2072.41, "end": 2074.45, "text": "到那时 主公"}, {"start": 2074.45, "end": 2078.05, "text": "你是接还是不接"}, {"start": 2078.05, "end": 2085.43, "text": "因此 此诏接与不接均属两难"}, {"start": 2085.43, "end": 2087.95, "text": "只是那曹贼的祸心"}, {"start": 2087.95, "end": 2094.67, "text": "已然得逞了"}, {"start": 2094.67, "end": 2099.6, "text": "我后悔没有采纳先生之言"}, {"start": 2099.6, "end": 2103.04, "text": "曹把天子夺到首领那就好了"}, {"start": 2103.04, "end": 2106.44, "text": "这样一来 挟天子令诸侯的"}, {"start": 2106.48, "end": 2110.4, "text": "就不是他曹操 而是我了"}, {"start": 2110.4, "end": 2113.64, "text": "我兵马将士比他多二十万"}, {"start": 2113.64, "end": 2117.2, "text": "城池属地更比他多两倍有余"}, {"start": 2117.2, "end": 2123.14, "text": "我甚至可以把朝廷安在这儿"}, {"start": 2123.14, "end": 2126.3, "text": "接引我一时疏忽"}, {"start": 2126.3, "end": 2128.74, "text": "让曹操占了先机"}, {"start": 2128.74, "end": 2135.0, "text": "奉来他要听他的脚诏 乱命"}, {"start": 2135.96, "end": 2137.44, "text": "可惜啊"}, {"start": 2137.44, "end": 2140.08, "text": "当初我的这个建议"}, {"start": 2140.08, "end": 2143.12, "text": "却被那鼠目寸光之人"}, {"start": 2143.12, "end": 2146.24, "text": "说成是匹夫之言"}, {"start": 2146.24, "end": 2152.89, "text": "此事 既因我迟疑而耽误"}, {"start": 2152.89, "end": 2155.61, "text": "与裂尾断然无关"}, {"start": 2155.61, "end": 2163.3, "text": "你说 我们现在该怎么办"}, {"start": 2163.3, "end": 2167.98, "text": "主公 臣下可以断言"}, {"start": 2167.98, "end": 2169.94, "text": "五年之内"}, {"start": 2170.34, "end": 2172.5, "text": "五年之内"}, {"start": 2172.5, "end": 2174.66, "text": "你与那曹操"}, {"start": 2174.66, "end": 2180.41, "text": "必将有一场生死之战"}, {"start": 2180.41, "end": 2183.55, "text": "竟有这么快"}, {"start": 2183.55, "end": 2187.43, "text": "主公 你不妨想想"}, {"start": 2187.43, "end": 2190.55, "text": "那曹操为何要挟天子一令诸侯"}, {"start": 2190.55, "end": 2192.63, "text": "又为何遍封了各地诸侯"}, {"start": 2192.63, "end": 2196.94, "text": "而独独不封他自己"}, {"start": 2196.94, "end": 2198.34, "text": "因为在他眼里"}, {"start": 2198.34, "end": 2200.14, "text": "他已然是天子"}, {"start": 2200.14, "end": 2202.02, "text": "天子就是他"}, {"start": 2202.02, "end": 2203.46, "text": "他已经知天下牛儿"}, {"start": 2203.5, "end": 2207.61, "text": "用不着再自封了"}, {"start": 2207.61, "end": 2209.45, "text": "现在的曹操"}, {"start": 2209.45, "end": 2211.49, "text": "论蜀地之广"}, {"start": 2211.49, "end": 2212.97, "text": "不及你"}, {"start": 2212.97, "end": 2214.97, "text": "论兵马之强"}, {"start": 2214.97, "end": 2216.53, "text": "钱粮之多"}, {"start": 2216.53, "end": 2218.37, "text": "也不如你"}, {"start": 2218.37, "end": 2219.89, "text": "可那曹操"}, {"start": 2219.89, "end": 2221.53, "text": "他一定会充分利用"}, {"start": 2221.53, "end": 2224.25, "text": "挟天子一令诸侯之力"}, {"start": 2224.25, "end": 2227.69, "text": "一步步逐渐地壮大起来"}, {"start": 2227.69, "end": 2232.49, "text": "主公 曹操可远非董卓可比"}, {"start": 2232.49, "end": 2233.81, "text": "他比董卓"}, {"start": 2233.81, "end": 2236.97, "text": "要阴险狡诈百倍"}, {"start": 2236.97, "end": 2239.33, "text": "此人"}, {"start": 2239.33, "end": 2241.61, "text": "志在天下呀"}, {"start": 2243.61, "end": 2245.29, "text": "想不到当年和我一块"}, {"start": 2245.29, "end": 2247.29, "text": "吃喝嫖赌的臭小子"}, {"start": 2247.29, "end": 2250.25, "text": "今天却要和我争夺天下了"}, {"start": 2253.49, "end": 2256.05, "text": "恕在下直言"}, {"start": 2256.05, "end": 2261.9, "text": "那曹操非但要跟你争天下"}, {"start": 2261.9, "end": 2264.5, "text": "鹿死水手"}, {"start": 2264.5, "end": 2267.99, "text": "尤为可知啊"}, {"start": 2267.99, "end": 2272.92, "text": "我绝不会坐视曹操为患"}, {"start": 2272.92, "end": 2275.04, "text": "我绝不会坐等曹操有能力"}, {"start": 2275.04, "end": 2276.04, "text": "向我挑战"}, {"start": 2276.04, "end": 2278.04, "text": "我再和他一决此行"}, {"start": 2278.04, "end": 2279.48, "text": "众卿听令"}, {"start": 2279.48, "end": 2280.96, "text": "秋收过后"}, {"start": 2280.96, "end": 2282.44, "text": "计发兵十五万"}, {"start": 2282.44, "end": 2284.52, "text": "攻去幽禀二州"}, {"start": 2284.52, "end": 2285.32, "text": "之后"}, {"start": 2285.32, "end": 2286.84, "text": "立兵默马"}, {"start": 2286.84, "end": 2288.96, "text": "剿灭曹操"}, {"start": 2288.96, "end": 2290.76, "text": "遵命"}, {"start": 2290.76, "end": 2292.56, "text": "主公"}, {"start": 2292.56, "end": 2295.12, "text": "倘能如此"}, {"start": 2295.12, "end": 2296.96, "text": "主公幸甚"}, {"start": 2296.96, "end": 2315.99, "text": "天下幸甚"}, {"start": 2315.99, "end": 2317.59, "text": "主公"}, {"start": 2317.59, "end": 2320.03, "text": "袁绍 袁术 刘表 公孙瓒等"}, {"start": 2320.03, "end": 2322.07, "text": "都接受了朝廷的斥风"}, {"start": 2322.07, "end": 2326.22, "text": "上表谢恩了"}, {"start": 2326.22, "end": 2331.57, "text": "好"}, {"start": 2331.57, "end": 2334.33, "text": "向朝廷先"}, {"start": 2334.33, "end": 2337.69, "text": "就是向我曹操谢恩嘛"}, {"start": 2337.69, "end": 2338.73, "text": "巡语"}, {"start": 2338.73, "end": 2339.25, "text": "在"}, {"start": 2339.25, "end": 2340.33, "text": "你说"}, {"start": 2340.33, "end": 2343.45, "text": "袁绍他们此时此刻"}, {"start": 2343.45, "end": 2346.89, "text": "心中当是何等滋味"}, {"start": 2346.89, "end": 2348.77, "text": "又苦又酸"}, {"start": 2348.77, "end": 2355.48, "text": "又忌又恨吧"}, {"start": 2355.48, "end": 2358.45, "text": "养一个天子"}, {"start": 2358.45, "end": 2360.53, "text": "比自个儿做天子舒服多了"}, {"start": 2360.53, "end": 2362.05, "text": "主公当心啊"}, {"start": 2362.05, "end": 2363.25, "text": "此时此刻"}, {"start": 2363.25, "end": 2366.09, "text": "你可是各路诸侯心目中的大敌"}, {"start": 2366.09, "end": 2369.41, "text": "嗯 这我知道"}, {"start": 2369.41, "end": 2372.29, "text": "早晚有一天我跟他们必有一战"}, {"start": 2372.29, "end": 2376.01, "text": "但是眼下他们还顾不上"}, {"start": 2376.01, "end": 2377.45, "text": "袁绍"}, {"start": 2377.45, "end": 2379.85, "text": "正忙着和公孙瓒交战"}, {"start": 2379.85, "end": 2382.25, "text": "将攻去幽州"}, {"start": 2382.25, "end": 2383.57, "text": "袁术"}, {"start": 2383.57, "end": 2386.13, "text": "正图谋独霸将来"}, {"start": 2386.13, "end": 2387.81, "text": "巡语"}, {"start": 2387.81, "end": 2391.01, "text": "我们也应该抓紧时机"}, {"start": 2391.01, "end": 2393.57, "text": "进取中原了"}, {"start": 2393.57, "end": 2395.21, "text": "主公心里头"}, {"start": 2395.21, "end": 2397.65, "text": "一直还惦记着徐州吧"}, {"start": 2397.65, "end": 2398.93, "text": "何止是惦记"}, {"start": 2398.93, "end": 2403.21, "text": "简直是朝思暮想啊"}, {"start": 2403.21, "end": 2405.33, "text": "欲成大业"}, {"start": 2405.33, "end": 2408.01, "text": "必取徐州啊"}, {"start": 2408.01, "end": 2410.09, "text": "徐州一日不得"}, {"start": 2410.09, "end": 2412.89, "text": "我一日不安"}, {"start": 2412.89, "end": 2415.05, "text": "但是眼下"}, {"start": 2415.05, "end": 2417.53, "text": "刘备和吕布"}, {"start": 2417.53, "end": 2420.21, "text": "团聚在徐州"}, {"start": 2420.21, "end": 2423.01, "text": "他们二人相互支援"}, {"start": 2423.01, "end": 2424.85, "text": "着实棘手"}, {"start": 2424.85, "end": 2427.69, "text": "你曾经说过"}, {"start": 2427.69, "end": 2428.89, "text": "棘弓"}, {"start": 2428.89, "end": 2432.25, "text": "则二人同心相聚"}, {"start": 2432.25, "end": 2433.89, "text": "宽忍"}, {"start": 2433.89, "end": 2436.73, "text": "则毕生分裂"}, {"start": 2436.73, "end": 2440.09, "text": "我已经宽忍许久了"}, {"start": 2440.09, "end": 2442.09, "text": "何以不见他们分裂呢"}, {"start": 2442.09, "end": 2444.81, "text": "主公要去徐州"}, {"start": 2444.81, "end": 2451.33, "text": "在下倒有一计"}, {"start": 2451.33, "end": 2452.65, "text": "我悉耳恭听"}, {"start": 2452.65, "end": 2454.45, "text": "主公可以以天子的名义"}, {"start": 2454.45, "end": 2456.45, "text": "给刘备下一刀诏书"}, {"start": 2456.45, "end": 2458.45, "text": "斥封他为徐州牧"}, {"start": 2458.45, "end": 2460.01, "text": "除徐州各郡之外"}, {"start": 2460.01, "end": 2462.65, "text": "还可以把元素的南洋郡"}, {"start": 2462.65, "end": 2464.37, "text": "一并斥封给他"}, {"start": 2464.37, "end": 2466.49, "text": "同时下道密令"}, {"start": 2466.49, "end": 2469.25, "text": "叫他出兵征讨元素"}, {"start": 2469.25, "end": 2471.85, "text": "就说元素图谋不轨"}, {"start": 2471.85, "end": 2474.37, "text": "暗怀称帝之心"}, {"start": 2474.37, "end": 2476.73, "text": "刘备乃汉帝后裔啊"}, {"start": 2476.73, "end": 2478.89, "text": "对朝廷是忠心耿耿"}, {"start": 2478.89, "end": 2480.69, "text": "刚刚做了徐州牧"}, {"start": 2480.69, "end": 2483.85, "text": "他岂敢不尽忠效命"}, {"start": 2483.85, "end": 2485.93, "text": "与此同时"}, {"start": 2485.93, "end": 2487.93, "text": "我在以天子之名"}, {"start": 2487.93, "end": 2490.49, "text": "给元素下一道诏书"}, {"start": 2490.49, "end": 2493.65, "text": "就说刘备心怀叵测"}, {"start": 2493.65, "end": 2496.93, "text": "给朝廷上表密奏"}, {"start": 2496.93, "end": 2500.05, "text": "说他元素有称帝之心"}, {"start": 2500.05, "end": 2503.41, "text": "要发兵恭喜他的首府南洋郡"}, {"start": 2503.41, "end": 2504.57, "text": "对吗"}, {"start": 2504.57, "end": 2505.85, "text": "正是"}, {"start": 2505.85, "end": 2507.37, "text": "这样一来"}, {"start": 2507.37, "end": 2509.09, "text": "刘备和元素之间"}, {"start": 2509.09, "end": 2510.65, "text": "必有一场恶斗"}, {"start": 2510.65, "end": 2512.33, "text": "不是你死就是我活"}, {"start": 2513.37, "end": 2516.13, "text": "最后他们会同归于尽"}, {"start": 2516.13, "end": 2518.97, "text": "而我们就可以四肌"}, {"start": 2518.97, "end": 2522.11, "text": "攻取徐州了"}, {"start": 2522.11, "end": 2523.35, "text": "主公圣命"}, {"start": 2523.35, "end": 2525.27, "text": "驱虎吞狼"}, {"start": 2525.27, "end": 2530.82, "text": "此诏书到"}, {"start": 2530.82, "end": 2538.06, "text": "赵偏将军刘备接旨"}, {"start": 2538.06, "end": 2540.06, "text": "刘备接旨"}, {"start": 2541.42, "end": 2543.22, "text": "顺天承运"}, {"start": 2543.22, "end": 2544.98, "text": "皇帝诏曰"}, {"start": 2544.98, "end": 2547.98, "text": "刘备自提领徐州以来"}, {"start": 2547.98, "end": 2549.66, "text": "忠心护国"}, {"start": 2549.66, "end": 2551.5, "text": "保静安民"}, {"start": 2551.5, "end": 2553.22, "text": "振兴甚位"}, {"start": 2553.22, "end": 2556.46, "text": "今特命其为徐州牧"}, {"start": 2556.46, "end": 2558.98, "text": "领徐州六郡"}, {"start": 2558.98, "end": 2561.62, "text": "并封车继将军"}, {"start": 2561.62, "end": 2563.18, "text": "五义侯"}, {"start": 2563.18, "end": 2564.9, "text": "钦此"}, {"start": 2565.78, "end": 2574.78, "text": "臣刘备领旨谢恩"}, {"start": 2574.78, "end": 2577.66, "text": "恭喜将军晋升为徐州牧"}, {"start": 2577.66, "end": 2578.58, "text": "此外"}, {"start": 2578.58, "end": 2580.94, "text": "陛下还有一道密诏给将军"}, {"start": 2580.94, "end": 2583.66, "text": "盼将军务必遵行"}]