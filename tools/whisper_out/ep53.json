[{"start": 4.98, "end": 12.82, "text": "我身为武侯,你怎能擅自用兵?"}, {"start": 12.82, "end": 154.82, "text": "这江东到底你是主,回府待"}, {"start": 154.82, "end": 173.9, "text": "刘文大军去西荆州,又不知道,对"}, {"start": 173.9, "end": 183.09, "text": "杜公做得完全正确,孙柳联盟不能坏"}, {"start": 183.09, "end": 186.09, "text": "我们现在绝不能和刘备开战"}, {"start": 187.09, "end": 196.51, "text": "有你这句话,我悬着的心就落下一半"}, {"start": 196.51, "end": 198.51, "text": "那是公瑾留下的兵符"}, {"start": 198.51, "end": 200.51, "text": "你令人把他制到芭林"}, {"start": 201.51, "end": 205.51, "text": "传我的令,命所有进军的军队"}, {"start": 206.51, "end": 209.51, "text": "立刻回营,待命"}, {"start": 210.51, "end": 215.51, "text": "主公啊,我料想兵符到后"}, {"start": 215.51, "end": 217.51, "text": "停止行军可以"}, {"start": 218.51, "end": 221.51, "text": "可是让那些军队回营"}, {"start": 221.51, "end": 226.54, "text": "为何?"}, {"start": 226.54, "end": 229.54, "text": "芭林将士只听命于公瑾"}, {"start": 229.54, "end": 232.54, "text": "只凭主公一声之令,怕是调不动"}, {"start": 232.54, "end": 236.37, "text": "我当了十年的武侯了"}, {"start": 236.37, "end": 242.66, "text": "这东吴到底是姓孙还是姓周?"}, {"start": 242.66, "end": 248.03, "text": "传我的令,让他们送回营"}, {"start": 248.03, "end": 250.03, "text": "敢有不尊者,杀"}, {"start": 250.03, "end": 265.46, "text": "大都督,你有伤在身,身体虚弱"}, {"start": 265.46, "end": 266.46, "text": "不能再饮酒了"}, {"start": 266.46, "end": 268.46, "text": "连你也敢管我"}, {"start": 268.46, "end": 271.12, "text": "退下"}, {"start": 271.12, "end": 275.55, "text": "大都督,你真的不能再喝了"}, {"start": 275.55, "end": 278.82, "text": "滚开"}, {"start": 278.82, "end": 281.82, "text": "大都督,就算你打死末将"}, {"start": 281.82, "end": 285.03, "text": "末将也不能再让你喝了"}, {"start": 285.03, "end": 287.03, "text": "我打伤你了"}, {"start": 287.03, "end": 300.74, "text": "不,末将无碍"}, {"start": 300.74, "end": 302.74, "text": "大都督伤得更重"}, {"start": 302.74, "end": 305.74, "text": "我为孙氏赴堂蹈火十几年"}, {"start": 305.74, "end": 315.02, "text": "主公年少,不安世事"}, {"start": 315.02, "end": 331.0, "text": "你就不要再怪他了"}, {"start": 331.0, "end": 333.0, "text": "我恨的是那诸葛匹夫"}, {"start": 333.0, "end": 342.6, "text": "一定是他看透了主公好面子的弱点"}, {"start": 342.6, "end": 344.6, "text": "让刘备青州直下"}, {"start": 344.6, "end": 349.98, "text": "到建康大半聘礼弄得近人皆知"}, {"start": 349.98, "end": 352.98, "text": "逼得主公不得不嫁美于他"}, {"start": 352.98, "end": 354.98, "text": "你就不要再难过了"}, {"start": 354.98, "end": 362.22, "text": "主公心意已决"}, {"start": 362.22, "end": 364.22, "text": "此事难以改变"}, {"start": 364.22, "end": 367.22, "text": "现在重要的是大都督一定要保重身体"}, {"start": 367.22, "end": 369.22, "text": "不能一日没有大都督"}, {"start": 369.22, "end": 373.21, "text": "已经没有周瑜了"}, {"start": 373.21, "end": 385.23, "text": "主公,末将刚刚从芭令回来"}, {"start": 395.77, "end": 398.77, "text": "怎么样,他们撤军了吗"}, {"start": 398.77, "end": 401.77, "text": "丁凤、蒋钦、甘霖等将都说"}, {"start": 402.77, "end": 404.77, "text": "如果此时让他们撤下"}, {"start": 404.77, "end": 407.77, "text": "诸葛亮必定会挥失东晋"}, {"start": 407.77, "end": 409.77, "text": "芭令必失"}, {"start": 409.77, "end": 412.77, "text": "因此他们请主公三思"}, {"start": 412.77, "end": 415.77, "text": "什么,让我三思"}, {"start": 418.14, "end": 421.39, "text": "你太胡言"}, {"start": 421.39, "end": 423.39, "text": "刘备在建康"}, {"start": 423.39, "end": 425.39, "text": "诸葛亮只会虚张声势"}, {"start": 425.39, "end": 427.39, "text": "怎会在这个时候挥失东晋"}, {"start": 427.39, "end": 429.39, "text": "这分明是他们抗敌的托词"}, {"start": 429.39, "end": 431.39, "text": "你执我建议立个传令"}, {"start": 431.39, "end": 433.39, "text": "将他们全都挥失"}, {"start": 433.39, "end": 435.39, "text": "你以为你是曹操啊"}, {"start": 435.39, "end": 436.39, "text": "家大业大"}, {"start": 436.39, "end": 440.39, "text": "我东吴有多少战将让你来免"}, {"start": 440.39, "end": 442.39, "text": "母亲"}, {"start": 442.39, "end": 443.39, "text": "母亲"}, {"start": 443.39, "end": 449.82, "text": "孩儿最近心烦事太多"}, {"start": 449.82, "end": 451.82, "text": "一时怒气"}, {"start": 451.82, "end": 453.82, "text": "做人主的"}, {"start": 453.82, "end": 456.82, "text": "应该能忍常人所不能忍"}, {"start": 456.82, "end": 459.82, "text": "宽人为怀,虔诚待世"}, {"start": 459.82, "end": 462.82, "text": "以周瑜在军中的威信"}, {"start": 462.82, "end": 464.82, "text": "你罢免了他"}, {"start": 464.82, "end": 466.82, "text": "那些青年将领"}, {"start": 466.82, "end": 468.82, "text": "只怕都会与你离心离德"}, {"start": 468.82, "end": 470.82, "text": "没他们扶持"}, {"start": 470.82, "end": 473.82, "text": "我看你这个吴侯还能当几天"}, {"start": 473.82, "end": 475.82, "text": "母亲"}, {"start": 475.82, "end": 476.82, "text": "可"}, {"start": 476.82, "end": 478.82, "text": "可是事情已经僵持在这"}, {"start": 478.82, "end": 480.82, "text": "孩儿"}, {"start": 480.82, "end": 482.82, "text": "也是束手无策"}, {"start": 482.82, "end": 484.82, "text": "我告诉你一策"}, {"start": 484.82, "end": 487.82, "text": "马上把兵符给公瑾送回去"}, {"start": 487.82, "end": 489.82, "text": "请她继续执掌大都督"}, {"start": 489.82, "end": 490.82, "text": "母亲"}, {"start": 490.82, "end": 496.97, "text": "你让我还她兵符"}, {"start": 496.97, "end": 498.97, "text": "我可以给她送过去"}, {"start": 498.97, "end": 499.97, "text": "但是"}, {"start": 499.97, "end": 502.97, "text": "依公瑾之计要袭取荆州"}, {"start": 502.97, "end": 503.97, "text": "这样"}, {"start": 503.97, "end": 505.97, "text": "势必会激进孙柳大战"}, {"start": 505.97, "end": 507.97, "text": "大局崩溃"}, {"start": 509.97, "end": 510.97, "text": "不会有大战"}, {"start": 510.97, "end": 512.97, "text": "也不会有崩溃"}, {"start": 512.97, "end": 514.97, "text": "母亲经历那么多兴风学雨"}, {"start": 514.97, "end": 517.97, "text": "这道理焉能不懂"}, {"start": 517.97, "end": 518.97, "text": "现在"}, {"start": 518.97, "end": 520.97, "text": "首先是你们主臣将帅"}, {"start": 520.97, "end": 522.97, "text": "要同心同德"}, {"start": 522.97, "end": 524.97, "text": "尤其是你"}, {"start": 524.97, "end": 526.97, "text": "不能和周瑜闹翻"}, {"start": 526.97, "end": 532.9, "text": "母亲的意思是"}, {"start": 532.9, "end": 540.49, "text": "只能把小妹嫁给刘备了"}, {"start": 540.49, "end": 543.49, "text": "孙柳两家皆为亲家"}, {"start": 543.49, "end": 544.49, "text": "母亲"}, {"start": 544.49, "end": 552.66, "text": "你不是不愿意吗"}, {"start": 552.66, "end": 556.77, "text": "我真不愿意"}, {"start": 556.77, "end": 558.77, "text": "我十八岁的女儿"}, {"start": 558.77, "end": 561.77, "text": "去侍奉一个四十八岁的老头"}, {"start": 561.77, "end": 567.0, "text": "为了保住你父兄留下的记忆"}, {"start": 567.0, "end": 571.78, "text": "别无选择"}, {"start": 571.78, "end": 572.78, "text": "主公"}, {"start": 572.78, "end": 590.5, "text": "奴才即刻禀报都督"}, {"start": 590.5, "end": 591.5, "text": "我和公瑾是兄弟"}, {"start": 591.5, "end": 593.5, "text": "你不必禀报"}, {"start": 593.5, "end": 594.5, "text": "看你来了"}, {"start": 594.5, "end": 602.06, "text": "拜见主公"}, {"start": 602.06, "end": 643.35, "text": "公瑾还是在生我气"}, {"start": 643.35, "end": 654.17, "text": "兵符我给你送来了"}, {"start": 654.17, "end": 656.17, "text": "你收也得收"}, {"start": 656.17, "end": 658.17, "text": "不收也得收"}, {"start": 658.17, "end": 664.81, "text": "这件事"}, {"start": 664.81, "end": 666.81, "text": "说起来是我的不对"}, {"start": 666.81, "end": 670.92, "text": "你与五兄同年"}, {"start": 670.92, "end": 672.92, "text": "师武为弟"}, {"start": 672.92, "end": 675.92, "text": "奉我母为姬母"}, {"start": 675.92, "end": 677.92, "text": "当年"}, {"start": 677.92, "end": 679.92, "text": "五兄渡江沽刘遥时"}, {"start": 679.92, "end": 682.92, "text": "你率亲族子侄相从"}, {"start": 682.92, "end": 683.92, "text": "那时"}, {"start": 683.92, "end": 685.92, "text": "我孙嘉语就迁于兵马"}, {"start": 685.92, "end": 687.92, "text": "没有你公瑾"}, {"start": 687.92, "end": 691.3, "text": "就没有我江东之地"}, {"start": 691.3, "end": 700.3, "text": "先兄"}, {"start": 700.3, "end": 702.3, "text": "一直视你为手足绑壁"}, {"start": 702.3, "end": 705.3, "text": "他在临终前留下一句话"}, {"start": 705.3, "end": 708.3, "text": "内事不绝问张昭"}, {"start": 708.3, "end": 712.3, "text": "外事不绝问周瑜"}, {"start": 712.3, "end": 715.3, "text": "可见你在我先兄心中"}, {"start": 715.3, "end": 718.3, "text": "在东吴八十一县中"}, {"start": 718.3, "end": 720.3, "text": "是何等地位"}, {"start": 720.3, "end": 725.01, "text": "是我错了"}, {"start": 725.01, "end": 728.01, "text": "是我违背了先兄的一言"}, {"start": 728.01, "end": 732.86, "text": "我想赔罪"}, {"start": 732.86, "end": 734.86, "text": "主公"}, {"start": 734.86, "end": 737.86, "text": "在下向主公请罪"}, {"start": 737.86, "end": 738.86, "text": "公瑾"}, {"start": 738.86, "end": 739.86, "text": "名为君臣"}, {"start": 739.86, "end": 744.61, "text": "世为兄弟"}, {"start": 744.61, "end": 745.61, "text": "我年纪轻"}, {"start": 745.61, "end": 747.61, "text": "经得世手"}, {"start": 747.61, "end": 749.61, "text": "难免不搬错事"}, {"start": 749.61, "end": 751.61, "text": "你是当哥哥的"}, {"start": 751.61, "end": 754.89, "text": "就不能原谅我一回吗"}, {"start": 754.89, "end": 761.49, "text": "你就别再说了"}, {"start": 761.49, "end": 767.26, "text": "我收回来"}, {"start": 767.26, "end": 768.26, "text": "荆州之事"}, {"start": 768.26, "end": 774.96, "text": "我都听你的"}, {"start": 774.96, "end": 775.96, "text": "你说该怎么办吧"}, {"start": 775.96, "end": 776.96, "text": "那好"}, {"start": 776.96, "end": 778.96, "text": "请主公这就下令"}, {"start": 778.96, "end": 782.04, "text": "拿下刘备"}, {"start": 782.04, "end": 783.04, "text": "进军荆州"}, {"start": 783.04, "end": 784.04, "text": "主公"}, {"start": 784.04, "end": 785.04, "text": "此事断不可一日"}, {"start": 785.04, "end": 786.04, "text": "公瑾"}, {"start": 786.04, "end": 787.04, "text": "此境"}, {"start": 788.04, "end": 789.04, "text": "主公"}, {"start": 789.04, "end": 791.04, "text": "我亲自去了趟芭林前线"}, {"start": 791.04, "end": 793.04, "text": "攻袭荆州的六万大军"}, {"start": 793.04, "end": 794.04, "text": "已经全部归迎了"}, {"start": 794.04, "end": 795.04, "text": "你"}, {"start": 796.04, "end": 797.04, "text": "公瑾"}, {"start": 797.04, "end": 799.04, "text": "刘备是汉制宗室"}, {"start": 799.04, "end": 800.04, "text": "现在剪灭他"}, {"start": 800.04, "end": 802.04, "text": "就等于与汉为敌"}, {"start": 802.04, "end": 803.04, "text": "如今天下人"}, {"start": 803.04, "end": 805.04, "text": "皆视曹操为国贼"}, {"start": 805.04, "end": 806.04, "text": "如果我们现在"}, {"start": 806.04, "end": 808.04, "text": "如果我们现在除掉刘备"}, {"start": 808.04, "end": 809.04, "text": "那么天下人"}, {"start": 809.04, "end": 811.04, "text": "就要以我们为国贼了"}, {"start": 811.04, "end": 813.04, "text": "什么汉制宗室"}, {"start": 813.04, "end": 814.04, "text": "虚名罢了"}, {"start": 816.04, "end": 817.04, "text": "刘备跟曹操一样"}, {"start": 817.04, "end": 819.04, "text": "都是乱世枭雄"}, {"start": 819.04, "end": 820.04, "text": "表面仁义"}, {"start": 820.04, "end": 821.04, "text": "心图天下"}, {"start": 822.04, "end": 824.04, "text": "我们必须趁其羽翼未丰时"}, {"start": 824.04, "end": 825.04, "text": "剪除他"}, {"start": 825.04, "end": 827.04, "text": "否则待他强大起来"}, {"start": 827.04, "end": 828.04, "text": "我东吴面对的"}, {"start": 828.04, "end": 831.04, "text": "就不止曹操这一方大敌了"}, {"start": 831.04, "end": 832.04, "text": "主公"}, {"start": 832.04, "end": 834.04, "text": "当今天下三族鼎立"}, {"start": 834.04, "end": 835.04, "text": "曹操强孙柳弱"}, {"start": 835.04, "end": 837.04, "text": "如果两个弱者相拼"}, {"start": 837.04, "end": 838.04, "text": "那么曹操必得天下"}, {"start": 838.04, "end": 840.04, "text": "我等皆为其虏"}, {"start": 840.04, "end": 841.04, "text": "不到万不得已"}, {"start": 841.04, "end": 843.04, "text": "切不可和诸葛亮交兵"}, {"start": 844.04, "end": 847.18, "text": "主公"}, {"start": 847.18, "end": 859.26, "text": "有人议论"}, {"start": 859.26, "end": 861.26, "text": "公瑾数度想灭刘备"}, {"start": 861.26, "end": 863.26, "text": "是因为不服诸葛亮之故"}, {"start": 864.26, "end": 867.26, "text": "其实根本没那么回事"}, {"start": 867.26, "end": 870.66, "text": "公瑾早就深谋远虑"}, {"start": 871.66, "end": 873.66, "text": "东西刘备自是正统之名"}, {"start": 873.66, "end": 875.66, "text": "兼有官章二人之用"}, {"start": 875.66, "end": 876.66, "text": "纵之"}, {"start": 876.66, "end": 877.66, "text": "纵之"}, {"start": 877.66, "end": 879.66, "text": "是养虎为患"}, {"start": 880.66, "end": 882.66, "text": "刘备这个人"}, {"start": 882.66, "end": 884.66, "text": "善于左右取巧 顺势而动"}, {"start": 885.66, "end": 887.66, "text": "他投到谁门下"}, {"start": 887.66, "end": 889.66, "text": "谁就要受其所累"}, {"start": 890.66, "end": 891.66, "text": "起初"}, {"start": 891.66, "end": 893.66, "text": "他投陶谦"}, {"start": 893.66, "end": 894.66, "text": "不久"}, {"start": 894.66, "end": 896.66, "text": "就从陶谦手中夺了徐者"}, {"start": 896.66, "end": 898.66, "text": "后又投刘表"}, {"start": 898.66, "end": 900.66, "text": "这刘表也就失了精者"}, {"start": 901.66, "end": 902.66, "text": "现在"}, {"start": 902.66, "end": 904.66, "text": "他口口声声要和我们联合"}, {"start": 904.66, "end": 905.66, "text": "谁又能保证"}, {"start": 905.66, "end": 907.66, "text": "到头来他不会害我东吴呢"}, {"start": 908.66, "end": 909.66, "text": "主公"}, {"start": 909.66, "end": 912.66, "text": "徐州城是陶谦主动让给刘备的"}, {"start": 912.66, "end": 913.66, "text": "刘表失去荆州"}, {"start": 913.66, "end": 914.66, "text": "是因为他费掌力诱"}, {"start": 914.66, "end": 916.66, "text": "由内乱而导致外患"}, {"start": 916.66, "end": 918.66, "text": "最终被曹操夺了荆乡"}, {"start": 918.66, "end": 921.66, "text": "其实这和刘备并没有关系"}, {"start": 921.66, "end": 922.66, "text": "罗素"}, {"start": 922.66, "end": 924.66, "text": "你这是在跟我说话吗"}, {"start": 925.66, "end": 926.66, "text": "放肆"}, {"start": 926.66, "end": 935.19, "text": "这几天我都想明白了"}, {"start": 936.19, "end": 938.19, "text": "当初要不是错听了你的话"}, {"start": 938.19, "end": 940.19, "text": "怎能让东吴损失荆州"}, {"start": 940.19, "end": 941.19, "text": "你也不看看战报"}, {"start": 941.19, "end": 944.79, "text": "诸葛亮都要兴兵去芭灵了"}, {"start": 944.79, "end": 946.79, "text": "你怎么还在替他们说话"}, {"start": 946.79, "end": 948.79, "text": "难道这就是你跟诸葛亮"}, {"start": 948.79, "end": 949.79, "text": "相交甚好的缘故吗"}, {"start": 950.79, "end": 957.75, "text": "我和诸葛亮是有些交情"}, {"start": 957.75, "end": 961.03, "text": "我和他都是各为其主"}, {"start": 961.03, "end": 963.03, "text": "一旦两国交兵"}, {"start": 963.03, "end": 964.03, "text": "他诸葛亮仍然是我"}, {"start": 964.03, "end": 965.03, "text": "鲁素的死敌"}, {"start": 966.03, "end": 970.37, "text": "方才主公因为此人"}, {"start": 970.37, "end": 971.37, "text": "说到了公瑾"}, {"start": 973.37, "end": 974.37, "text": "在下以为"}, {"start": 974.37, "end": 977.37, "text": "公瑾不但是诸葛亮为死敌"}, {"start": 977.37, "end": 978.37, "text": "理天敌"}, {"start": 978.37, "end": 981.71, "text": "公瑾对诸葛亮之恨"}, {"start": 982.71, "end": 983.71, "text": "已经远远地超过了"}, {"start": 983.71, "end": 985.71, "text": "对国贼曹操之恨"}, {"start": 986.71, "end": 987.71, "text": "而且是又恨又毒"}, {"start": 988.71, "end": 990.71, "text": "在下以为这样就不对了"}, {"start": 991.71, "end": 992.71, "text": "以为不管什么样的仇恨"}, {"start": 992.71, "end": 993.71, "text": "一旦失去了控制"}, {"start": 993.71, "end": 995.71, "text": "就会反过来杀伤我们自己"}, {"start": 996.71, "end": 998.71, "text": "所以在下绝不愿意看到"}, {"start": 998.71, "end": 1000.71, "text": "公瑾因一己私怨"}, {"start": 1000.71, "end": 1001.71, "text": "而罔顾天下一"}, {"start": 1002.71, "end": 1003.71, "text": "子敬"}, {"start": 1003.71, "end": 1010.38, "text": "那你以为诸葛亮是什么人"}, {"start": 1011.38, "end": 1012.38, "text": "一敌一友"}, {"start": 1012.38, "end": 1015.46, "text": "敌人好对付"}, {"start": 1015.46, "end": 1018.51, "text": "友人也好对付"}, {"start": 1018.51, "end": 1020.51, "text": "但是一敌一友之人"}, {"start": 1020.51, "end": 1021.51, "text": "却最难对付"}, {"start": 1022.51, "end": 1023.51, "text": "因为他随时可以"}, {"start": 1023.51, "end": 1024.51, "text": "成为你的大敌"}, {"start": 1025.51, "end": 1026.51, "text": "也随时可以成为"}, {"start": 1026.51, "end": 1027.51, "text": "你的盟友"}, {"start": 1028.51, "end": 1029.51, "text": "究竟是他为敌"}, {"start": 1029.51, "end": 1030.51, "text": "还是是他为友"}, {"start": 1030.51, "end": 1032.51, "text": "就要看我们的智慧了"}, {"start": 1032.51, "end": 1034.51, "text": "如果听任公瑾一意孤行"}, {"start": 1037.43, "end": 1039.43, "text": "那么必将是误国误军"}, {"start": 1039.43, "end": 1040.43, "text": "断送我江东"}, {"start": 1041.43, "end": 1042.43, "text": "鲁素"}, {"start": 1042.43, "end": 1047.69, "text": "依你之言"}, {"start": 1048.69, "end": 1049.69, "text": "我和公瑾"}, {"start": 1049.69, "end": 1050.69, "text": "一个是奸臣"}, {"start": 1050.69, "end": 1052.69, "text": "一个是暗主了"}, {"start": 1053.69, "end": 1054.69, "text": "主公"}, {"start": 1054.69, "end": 1055.69, "text": "鲁素"}, {"start": 1055.69, "end": 1056.69, "text": "你太狂辈了"}, {"start": 1056.69, "end": 1058.69, "text": "你又从骨捉狼"}, {"start": 1059.69, "end": 1065.26, "text": "不忍重责于你"}, {"start": 1066.26, "end": 1067.26, "text": "这暂军督卫之职"}, {"start": 1068.26, "end": 1069.26, "text": "就不必当了"}, {"start": 1069.26, "end": 1070.26, "text": "主公息怒"}, {"start": 1071.26, "end": 1077.23, "text": "子敬虽然言辞激励"}, {"start": 1078.23, "end": 1079.23, "text": "但到底是一片忠心"}, {"start": 1079.23, "end": 1081.23, "text": "请主公收回成命"}, {"start": 1082.23, "end": 1083.23, "text": "无异议决"}, {"start": 1083.23, "end": 1085.23, "text": "公瑾休要再劝"}, {"start": 1085.23, "end": 1086.23, "text": "他不视我为主"}, {"start": 1087.23, "end": 1094.1, "text": "我又何必视他为臣"}, {"start": 1094.1, "end": 1097.37, "text": "这就是鲁大夫家了"}, {"start": 1098.37, "end": 1099.37, "text": "子敬好歹也做了"}, {"start": 1099.37, "end": 1161.78, "text": "这么些年官"}, {"start": 1161.78, "end": 1171.64, "text": "我从吴侯府回来"}, {"start": 1172.64, "end": 1173.64, "text": "顺道来看看你"}, {"start": 1173.64, "end": 1214.86, "text": "来人"}, {"start": 1214.86, "end": 1215.86, "text": "去打些韭菜来"}, {"start": 1216.86, "end": 1221.13, "text": "我要陪大都督"}, {"start": 1221.13, "end": 1224.92, "text": "好好畅饮几杯"}, {"start": 1225.92, "end": 1226.92, "text": "这"}, {"start": 1227.92, "end": 1228.92, "text": "怎么还站着不动啊"}, {"start": 1230.92, "end": 1231.92, "text": "主人去年的俸禄"}, {"start": 1231.92, "end": 1232.92, "text": "都周记了"}, {"start": 1232.92, "end": 1233.92, "text": "赤壁湛王将士的遗孤"}, {"start": 1233.92, "end": 1234.92, "text": "今年的俸禄"}, {"start": 1234.92, "end": 1235.92, "text": "还没有领到"}, {"start": 1236.92, "end": 1237.92, "text": "家中"}, {"start": 1237.92, "end": 1238.92, "text": "实在无欲牵大酒"}, {"start": 1240.92, "end": 1241.92, "text": "这有何难呢"}, {"start": 1241.92, "end": 1242.92, "text": "来啊"}, {"start": 1242.92, "end": 1243.92, "text": "把我这个貂皮袍子"}, {"start": 1243.92, "end": 1244.92, "text": "拿去做鸭"}, {"start": 1244.92, "end": 1245.92, "text": "换些好酒菜来"}, {"start": 1246.92, "end": 1247.92, "text": "这"}, {"start": 1247.92, "end": 1248.92, "text": "来啊"}, {"start": 1248.92, "end": 1249.92, "text": "请"}, {"start": 1249.92, "end": 1250.92, "text": "你是对我有大恩的人"}, {"start": 1251.92, "end": 1257.69, "text": "先了今日"}, {"start": 1272.52, "end": 1273.52, "text": "你我竟相争不下"}, {"start": 1273.52, "end": 1274.52, "text": "成为正敌"}, {"start": 1275.52, "end": 1276.52, "text": "不过我来了"}, {"start": 1277.52, "end": 1278.52, "text": "你也不应该"}, {"start": 1278.52, "end": 1279.52, "text": "不过我来了"}, {"start": 1280.52, "end": 1282.52, "text": "你仍以雕琼换酒相待"}, {"start": 1283.52, "end": 1284.52, "text": "令我十分感动"}, {"start": 1284.52, "end": 1288.34, "text": "在下为你这份豪气"}, {"start": 1289.34, "end": 1290.34, "text": "敬你一杯"}, {"start": 1292.34, "end": 1293.34, "text": "恭谨言过了"}, {"start": 1295.34, "end": 1296.34, "text": "你我绝非正敌"}, {"start": 1297.34, "end": 1298.34, "text": "只是方略不同罢了"}, {"start": 1299.34, "end": 1300.34, "text": "试想"}, {"start": 1300.34, "end": 1302.34, "text": "当初我倾家荡产相助的"}, {"start": 1303.34, "end": 1304.34, "text": "不是你恭谨个人"}, {"start": 1305.34, "end": 1306.34, "text": "而是要让你恭谨"}, {"start": 1307.34, "end": 1308.34, "text": "相助天下之人"}, {"start": 1308.34, "end": 1309.34, "text": "而现在"}, {"start": 1312.55, "end": 1313.55, "text": "你我相争的"}, {"start": 1314.55, "end": 1315.55, "text": "也不是私家的事"}, {"start": 1316.55, "end": 1318.55, "text": "仍然是天下之事啊"}, {"start": 1319.55, "end": 1323.37, "text": "卢子清毕竟是卢子清啊"}, {"start": 1324.37, "end": 1325.37, "text": "大义凛然"}, {"start": 1325.37, "end": 1326.37, "text": "毫不通路"}, {"start": 1326.37, "end": 1327.37, "text": "恭敬过奖了"}, {"start": 1330.74, "end": 1331.74, "text": "其实我也想过"}, {"start": 1331.74, "end": 1342.05, "text": "你连流抗曹的方略"}, {"start": 1344.84, "end": 1345.84, "text": "可能是正确的"}, {"start": 1346.84, "end": 1347.84, "text": "如果再给我二十年"}, {"start": 1348.84, "end": 1349.84, "text": "我一定会按你的方略行事"}, {"start": 1352.82, "end": 1353.82, "text": "可是"}, {"start": 1353.82, "end": 1354.82, "text": "保天爷不会"}, {"start": 1354.82, "end": 1358.03, "text": "给我那么多时间了"}, {"start": 1358.03, "end": 1359.03, "text": "十多年来"}, {"start": 1360.03, "end": 1361.03, "text": "我征南闯北"}, {"start": 1362.03, "end": 1363.03, "text": "刀剑无情啊"}, {"start": 1364.03, "end": 1367.85, "text": "我已经多数负伤"}, {"start": 1368.85, "end": 1369.85, "text": "南郡城下"}, {"start": 1370.85, "end": 1373.32, "text": "又中我曹人那支毒箭"}, {"start": 1374.32, "end": 1375.32, "text": "我的身体"}, {"start": 1375.32, "end": 1376.32, "text": "我的身体像一块"}, {"start": 1376.32, "end": 1378.82, "text": "快要坠落的流星"}, {"start": 1381.55, "end": 1382.55, "text": "不知道什么时候"}, {"start": 1382.55, "end": 1383.55, "text": "就会消失在天空"}, {"start": 1383.55, "end": 1386.76, "text": "我已经不能选择"}, {"start": 1386.76, "end": 1387.76, "text": "走最好走的那条路"}, {"start": 1387.76, "end": 1390.71, "text": "而只能选择"}, {"start": 1390.71, "end": 1391.71, "text": "走最快的那条路"}, {"start": 1391.71, "end": 1394.76, "text": "去帮助主公"}, {"start": 1394.76, "end": 1396.76, "text": "实现一统江山的愿望"}, {"start": 1396.76, "end": 1398.76, "text": "我设计挟制刘备"}, {"start": 1398.76, "end": 1399.76, "text": "公主公"}, {"start": 1399.76, "end": 1404.41, "text": "我设计挟制刘备"}, {"start": 1404.41, "end": 1405.41, "text": "公取经乡"}, {"start": 1406.41, "end": 1407.41, "text": "令关张之辈扶手称臣"}, {"start": 1408.41, "end": 1409.41, "text": "然后挥施北伐"}, {"start": 1409.41, "end": 1410.41, "text": "剿灭曹操"}, {"start": 1410.41, "end": 1418.45, "text": "你的心素无明"}, {"start": 1418.45, "end": 1423.1, "text": "你也知道"}, {"start": 1424.1, "end": 1425.1, "text": "凡事"}, {"start": 1425.1, "end": 1426.1, "text": "欲速则不达呀"}, {"start": 1428.1, "end": 1429.1, "text": "关张二将"}, {"start": 1429.1, "end": 1430.1, "text": "乃世之勇将"}, {"start": 1431.1, "end": 1432.1, "text": "性情刚烈"}, {"start": 1433.1, "end": 1434.1, "text": "你用这种办法"}, {"start": 1434.1, "end": 1435.1, "text": "逼他们就范"}, {"start": 1436.1, "end": 1437.1, "text": "他们能够心服吗"}, {"start": 1438.1, "end": 1439.1, "text": "心中不服"}, {"start": 1439.1, "end": 1440.1, "text": "他们又怎么能够"}, {"start": 1440.1, "end": 1441.1, "text": "心甘情愿地"}, {"start": 1442.1, "end": 1443.1, "text": "为我东吴效力呢"}, {"start": 1445.1, "end": 1446.1, "text": "运行王霸之术"}, {"start": 1447.1, "end": 1448.1, "text": "只能无所不用其极"}, {"start": 1449.1, "end": 1450.1, "text": "此言差矣"}, {"start": 1450.1, "end": 1453.44, "text": "最终极的王霸之术"}, {"start": 1454.44, "end": 1455.44, "text": "还是人术"}, {"start": 1456.44, "end": 1457.44, "text": "你看"}, {"start": 1457.44, "end": 1458.44, "text": "曹操一贯霸道"}, {"start": 1459.44, "end": 1460.44, "text": "可是"}, {"start": 1461.44, "end": 1462.44, "text": "自赤壁败归之后"}, {"start": 1463.44, "end": 1464.44, "text": "他回到了许多"}, {"start": 1465.44, "end": 1466.44, "text": "没有兴兵暴虏"}, {"start": 1467.44, "end": 1469.44, "text": "而是卧薪偿胆"}, {"start": 1469.44, "end": 1470.44, "text": "收拾人心"}, {"start": 1470.44, "end": 1473.46, "text": "会有这样的变化"}, {"start": 1477.46, "end": 1478.46, "text": "经过一场大败之后"}, {"start": 1478.46, "end": 1479.46, "text": "他最终悟出了"}, {"start": 1480.46, "end": 1482.46, "text": "人数高于霸术的道理"}, {"start": 1499.02, "end": 1500.02, "text": "你以为必是对的"}, {"start": 1500.02, "end": 1503.94, "text": "就让时间来证明一切吧"}, {"start": 1505.94, "end": 1506.94, "text": "我的性子你知道"}, {"start": 1507.94, "end": 1508.94, "text": "决定的事是不会改变的"}, {"start": 1511.38, "end": 1512.38, "text": "更何况主公"}, {"start": 1512.38, "end": 1513.38, "text": "现在已经同意我了"}, {"start": 1514.38, "end": 1515.38, "text": "不错"}, {"start": 1516.38, "end": 1517.38, "text": "主公是同意了"}, {"start": 1519.38, "end": 1520.38, "text": "可是太夫人呢"}, {"start": 1524.61, "end": 1526.61, "text": "你以小姐之名赚去刘备"}, {"start": 1528.61, "end": 1529.61, "text": "太夫人是最要面子的"}, {"start": 1531.61, "end": 1532.61, "text": "她能够答应"}, {"start": 1532.61, "end": 1535.14, "text": "再说"}, {"start": 1536.14, "end": 1537.14, "text": "自伯扶将军去后"}, {"start": 1538.14, "end": 1540.14, "text": "你把太夫人视作姬母"}, {"start": 1542.58, "end": 1543.58, "text": "她的话"}, {"start": 1544.58, "end": 1545.58, "text": "你能够不听吗"}, {"start": 1553.59, "end": 1554.59, "text": "你身为江东之主"}, {"start": 1554.59, "end": 1555.59, "text": "统十几万精兵"}, {"start": 1556.59, "end": 1557.59, "text": "没能耐去取荆州"}, {"start": 1558.59, "end": 1559.59, "text": "却以我女儿为诱饵"}, {"start": 1560.59, "end": 1561.59, "text": "使这美人计骗刘备来"}, {"start": 1562.59, "end": 1563.59, "text": "你羞不羞"}, {"start": 1565.59, "end": 1566.59, "text": "现在刘备来了"}, {"start": 1566.59, "end": 1567.59, "text": "你又不嫁了"}, {"start": 1568.59, "end": 1569.59, "text": "扣下人家做人质"}, {"start": 1569.59, "end": 1570.59, "text": "你愧不愧"}, {"start": 1572.59, "end": 1573.59, "text": "孩儿羞愧"}, {"start": 1576.26, "end": 1577.26, "text": "禀太夫人"}, {"start": 1577.26, "end": 1578.26, "text": "此事跟主公无关"}, {"start": 1578.26, "end": 1579.26, "text": "都是我的主意"}, {"start": 1580.26, "end": 1581.26, "text": "原来是你出的馊主意"}, {"start": 1584.26, "end": 1585.26, "text": "就算是你的馊主意"}, {"start": 1586.26, "end": 1587.26, "text": "他身为吴侯"}, {"start": 1587.26, "end": 1588.26, "text": "岂能不当家做主"}, {"start": 1590.26, "end": 1591.26, "text": "既然做主"}, {"start": 1591.26, "end": 1592.26, "text": "他就不该把过错"}, {"start": 1593.26, "end": 1594.26, "text": "往臣属身上推"}, {"start": 1595.26, "end": 1596.26, "text": "周瑜"}, {"start": 1597.26, "end": 1598.26, "text": "这事我懒得骂你"}, {"start": 1599.26, "end": 1600.26, "text": "我只骂孙全"}, {"start": 1601.26, "end": 1602.26, "text": "你们啊"}, {"start": 1603.26, "end": 1604.26, "text": "已经让我女儿"}, {"start": 1604.26, "end": 1605.26, "text": "成为天下孝秉"}, {"start": 1607.26, "end": 1609.26, "text": "她以后还怎么嫁人呢"}, {"start": 1610.26, "end": 1611.26, "text": "你们只图自个儿"}, {"start": 1611.26, "end": 1612.26, "text": "那点小聪明"}, {"start": 1613.26, "end": 1615.26, "text": "却误了我女儿一生一世"}, {"start": 1619.95, "end": 1620.95, "text": "太夫人则得是"}, {"start": 1621.95, "end": 1623.95, "text": "若用这个计策"}, {"start": 1624.95, "end": 1625.95, "text": "即便是取了荆州"}, {"start": 1627.95, "end": 1629.95, "text": "也会被天下人耻笑"}, {"start": 1630.95, "end": 1631.95, "text": "禀太夫人"}, {"start": 1632.95, "end": 1633.95, "text": "小妹乃侯门之女"}, {"start": 1633.95, "end": 1634.95, "text": "身份高贵"}, {"start": 1635.95, "end": 1636.95, "text": "并没有真的嫁给刘备"}, {"start": 1636.95, "end": 1637.95, "text": "将来怎么会愁家"}, {"start": 1638.95, "end": 1639.95, "text": "再说了"}, {"start": 1639.95, "end": 1641.95, "text": "小妹乃老主公血脉"}, {"start": 1642.95, "end": 1643.95, "text": "也该为东吴大业"}, {"start": 1643.95, "end": 1644.95, "text": "尽些力量"}, {"start": 1645.95, "end": 1646.95, "text": "你还知道小妹"}, {"start": 1646.95, "end": 1647.95, "text": "是老主公的血脉"}, {"start": 1649.95, "end": 1651.95, "text": "文台当年是何等英雄啊"}, {"start": 1652.95, "end": 1653.95, "text": "他如果知道"}, {"start": 1654.95, "end": 1655.95, "text": "自己的血脉"}, {"start": 1655.95, "end": 1657.95, "text": "现在落到这步田地"}, {"start": 1657.95, "end": 1659.95, "text": "也早已修上了"}, {"start": 1660.95, "end": 1661.95, "text": "你们不要脸"}, {"start": 1661.95, "end": 1662.95, "text": "我要脸"}, {"start": 1663.95, "end": 1664.95, "text": "我还要为死人"}, {"start": 1664.95, "end": 1666.95, "text": "要点尊严"}, {"start": 1678.61, "end": 1679.61, "text": "母亲 消消气"}, {"start": 1680.61, "end": 1681.61, "text": "不要你捶"}, {"start": 1682.61, "end": 1683.61, "text": "都是你个没主意的东西"}, {"start": 1684.61, "end": 1685.61, "text": "弄出这等丑事了"}, {"start": 1686.61, "end": 1694.49, "text": "我看呢"}, {"start": 1695.49, "end": 1696.49, "text": "事已至此"}, {"start": 1697.49, "end": 1699.49, "text": "也只能假戏真做了"}, {"start": 1700.49, "end": 1701.49, "text": "刘皇叔"}, {"start": 1701.49, "end": 1702.49, "text": "乃汉室宗亲"}, {"start": 1703.49, "end": 1704.49, "text": "当世英雄"}, {"start": 1705.49, "end": 1706.49, "text": "找了这个女婿"}, {"start": 1706.49, "end": 1708.49, "text": "也算是不辱没我女儿"}, {"start": 1709.49, "end": 1710.49, "text": "太夫人 不可"}, {"start": 1711.49, "end": 1712.49, "text": "怎么着"}, {"start": 1712.49, "end": 1713.49, "text": "刘备跟孙小妹"}, {"start": 1713.49, "end": 1714.49, "text": "门庭虽然相配"}, {"start": 1715.49, "end": 1716.49, "text": "但是年纪不相当"}, {"start": 1717.49, "end": 1718.49, "text": "这刘备已经年近五旬了"}, {"start": 1719.49, "end": 1721.49, "text": "当初你向孙全献计"}, {"start": 1721.49, "end": 1722.49, "text": "招刘备为婿时"}, {"start": 1723.49, "end": 1724.49, "text": "怎么没想到年纪不相当呢"}, {"start": 1725.49, "end": 1726.49, "text": "我当时只是设下此计"}, {"start": 1729.66, "end": 1731.66, "text": "并不是真的想让小妹嫁给他"}, {"start": 1733.66, "end": 1734.66, "text": "资格做些事来"}, {"start": 1735.66, "end": 1736.66, "text": "后悔了"}, {"start": 1736.66, "end": 1737.66, "text": "不"}, {"start": 1737.66, "end": 1738.66, "text": "主公与我"}, {"start": 1738.66, "end": 1739.66, "text": "有手足之情"}, {"start": 1740.66, "end": 1741.66, "text": "小妹与我有兄妹之意"}, {"start": 1742.66, "end": 1743.66, "text": "如果小妹嫁给刘备"}, {"start": 1744.66, "end": 1745.66, "text": "我心痛"}, {"start": 1746.66, "end": 1747.66, "text": "莫非太夫人不心痛"}, {"start": 1748.66, "end": 1749.66, "text": "你能否这样"}, {"start": 1749.66, "end": 1753.74, "text": "明天约刘备"}, {"start": 1753.74, "end": 1754.74, "text": "于甘露寺见"}, {"start": 1755.74, "end": 1756.74, "text": "让小妹躲于账后观看"}, {"start": 1757.74, "end": 1758.74, "text": "如果合了小妹心意"}, {"start": 1759.74, "end": 1760.74, "text": "那就是天意所属"}, {"start": 1761.74, "end": 1762.74, "text": "我等也敬遵太夫人之命"}, {"start": 1762.74, "end": 1763.74, "text": "让两人成亲"}, {"start": 1764.74, "end": 1765.74, "text": "可要是小妹"}, {"start": 1766.74, "end": 1767.74, "text": "看不上刘备"}, {"start": 1768.74, "end": 1769.74, "text": "那就不甘心了"}, {"start": 1770.74, "end": 1771.74, "text": "我该委屈小妹了"}, {"start": 1772.74, "end": 1773.74, "text": "主公 太夫人"}, {"start": 1774.74, "end": 1775.74, "text": "也不愿意逼着小妹"}, {"start": 1775.74, "end": 1776.74, "text": "跳入火坑吧"}, {"start": 1781.1, "end": 1782.1, "text": "母亲"}, {"start": 1782.1, "end": 1783.1, "text": "恭谨这番话"}, {"start": 1784.1, "end": 1785.1, "text": "也是为了小妹着想"}, {"start": 1790.19, "end": 1791.19, "text": "那好"}, {"start": 1791.19, "end": 1792.19, "text": "就依你"}, {"start": 1793.19, "end": 1794.19, "text": "如小妹看不中"}, {"start": 1795.19, "end": 1797.57, "text": "咱们再商量"}, {"start": 1798.57, "end": 1806.86, "text": "大都督"}, {"start": 1807.86, "end": 1808.86, "text": "太夫人从不干预正事"}, {"start": 1809.86, "end": 1810.86, "text": "今时为何要出来做主呢"}, {"start": 1812.86, "end": 1813.86, "text": "是有人请她出来的"}, {"start": 1814.86, "end": 1815.86, "text": "是谁"}, {"start": 1815.86, "end": 1819.01, "text": "你不必问"}, {"start": 1820.01, "end": 1821.01, "text": "我也不便说"}, {"start": 1822.01, "end": 1823.01, "text": "难不成"}, {"start": 1823.01, "end": 1824.01, "text": "真让主公妹妹嫁给刘备吗"}, {"start": 1825.01, "end": 1826.01, "text": "小妹青春年少"}, {"start": 1827.01, "end": 1828.01, "text": "怎么会看得上"}, {"start": 1828.01, "end": 1829.01, "text": "她刘备这个糟老头子呢"}, {"start": 1830.01, "end": 1833.34, "text": "我明白了"}, {"start": 1834.34, "end": 1835.34, "text": "大都督是想让小姐"}, {"start": 1835.34, "end": 1836.34, "text": "堵住太夫人的嘴"}, {"start": 1838.62, "end": 1839.62, "text": "什么事都怕万一啊"}, {"start": 1841.62, "end": 1842.62, "text": "万一小姐真的看上刘备"}, {"start": 1843.62, "end": 1844.62, "text": "那怎么办"}, {"start": 1845.62, "end": 1846.62, "text": "凡事都有天意"}, {"start": 1847.62, "end": 1848.62, "text": "如果老天能开眼"}, {"start": 1852.06, "end": 1853.06, "text": "那就不要让刘备"}, {"start": 1853.06, "end": 1854.06, "text": "走出甘露寺"}, {"start": 1855.06, "end": 1861.14, "text": "遵命"}, {"start": 1861.14, "end": 1878.5, "text": "你的头发是越长越好了"}, {"start": 1879.5, "end": 1880.5, "text": "真是让娘喜欢了"}, {"start": 1881.5, "end": 1884.74, "text": "只可惜"}, {"start": 1884.74, "end": 1888.02, "text": "以后就不能常疏了"}, {"start": 1889.02, "end": 1890.02, "text": "母亲这是什么话"}, {"start": 1891.02, "end": 1892.02, "text": "女儿永远陪在你身边"}, {"start": 1893.02, "end": 1894.02, "text": "女大不中留"}, {"start": 1895.02, "end": 1896.02, "text": "你该嫁人了"}, {"start": 1897.02, "end": 1899.94, "text": "我才不想嫁人呢"}, {"start": 1900.94, "end": 1901.94, "text": "鬼丫头"}, {"start": 1902.94, "end": 1903.94, "text": "你说的是真心话"}, {"start": 1904.94, "end": 1909.43, "text": "我跟你哥商量好了"}, {"start": 1910.43, "end": 1911.43, "text": "给你寻了一门亲"}, {"start": 1913.43, "end": 1914.43, "text": "人家是皇亲宋氏"}, {"start": 1915.43, "end": 1916.43, "text": "这样的人家"}, {"start": 1917.43, "end": 1918.43, "text": "配得上我女儿"}, {"start": 1919.43, "end": 1920.43, "text": "母亲"}, {"start": 1921.43, "end": 1922.43, "text": "你真的把我嫁给那个老头子"}, {"start": 1923.43, "end": 1924.43, "text": "你都知道了"}, {"start": 1927.92, "end": 1928.92, "text": "满城的人都在传"}, {"start": 1929.92, "end": 1930.92, "text": "你们要把我嫁给刘备"}, {"start": 1931.92, "end": 1932.92, "text": "这件事"}, {"start": 1932.92, "end": 1933.92, "text": "我恐怕是最后一个才听说的吧"}, {"start": 1936.2, "end": 1937.2, "text": "你愿意吗"}, {"start": 1938.2, "end": 1939.2, "text": "母亲"}, {"start": 1939.2, "end": 1940.2, "text": "他是个糟老头子"}, {"start": 1942.2, "end": 1943.2, "text": "怎么能这么说话呢"}, {"start": 1944.2, "end": 1946.2, "text": "人家是当今皇叔"}, {"start": 1946.2, "end": 1947.2, "text": "太狠心了"}, {"start": 1948.2, "end": 1949.2, "text": "你知道他多大年纪吗"}, {"start": 1950.2, "end": 1951.2, "text": "知道"}, {"start": 1952.2, "end": 1953.2, "text": "四十八"}, {"start": 1954.2, "end": 1955.2, "text": "他大我三十岁"}, {"start": 1956.2, "end": 1958.2, "text": "你也舍得把我嫁给他"}, {"start": 1959.2, "end": 1960.2, "text": "我当然不舍得"}, {"start": 1961.2, "end": 1963.2, "text": "你是我心肝肝上的各大任务"}, {"start": 1963.2, "end": 1966.54, "text": "可就算是一万个不舍得"}, {"start": 1967.54, "end": 1968.54, "text": "我仍然要这么做"}, {"start": 1968.54, "end": 1969.54, "text": "为什么"}, {"start": 1970.54, "end": 1971.54, "text": "因为我是孙家的女人"}, {"start": 1972.54, "end": 1974.54, "text": "得为江东八十一县的安危"}, {"start": 1975.54, "end": 1976.54, "text": "为几百万百姓着想"}, {"start": 1978.54, "end": 1980.54, "text": "我可不愿让人当礼物送出去"}, {"start": 1982.54, "end": 1983.54, "text": "你就算是一万个不愿意"}, {"start": 1984.54, "end": 1985.54, "text": "也必须要嫁过去"}, {"start": 1986.54, "end": 1987.54, "text": "因为你是孙家的女儿"}, {"start": 1988.54, "end": 1992.36, "text": "母亲嫁到孙氏家族后"}, {"start": 1994.36, "end": 1996.36, "text": "不到三十就死了夫君"}, {"start": 1998.36, "end": 1999.36, "text": "不到四十"}, {"start": 2000.36, "end": 2001.36, "text": "就经历了丧子之痛"}, {"start": 2002.36, "end": 2003.36, "text": "我流的泪水"}, {"start": 2004.36, "end": 2008.41, "text": "只怕比天下哪个女人流的都毒"}, {"start": 2009.41, "end": 2012.36, "text": "可我为什么还要咬着牙"}, {"start": 2012.36, "end": 2013.36, "text": "够活下来呢"}, {"start": 2014.36, "end": 2016.36, "text": "就是为了孙氏的基业"}, {"start": 2017.36, "end": 2018.36, "text": "我一个外星人"}, {"start": 2018.36, "end": 2019.36, "text": "尚且能够这样"}, {"start": 2020.36, "end": 2021.36, "text": "而你身上"}, {"start": 2021.36, "end": 2022.36, "text": "流着孙家的血"}, {"start": 2023.36, "end": 2024.36, "text": "对孙家的前途"}, {"start": 2025.36, "end": 2027.36, "text": "更负着义不容辞的责任呢"}, {"start": 2028.36, "end": 2029.36, "text": "我嫁什么人"}, {"start": 2029.36, "end": 2030.36, "text": "和孙家的前途"}, {"start": 2030.36, "end": 2031.36, "text": "又有什么关系"}, {"start": 2032.36, "end": 2033.36, "text": "那边的曹操太强大了"}, {"start": 2035.36, "end": 2036.36, "text": "江东只有孙流联合"}, {"start": 2037.36, "end": 2038.36, "text": "才能发展壮大"}, {"start": 2038.36, "end": 2039.36, "text": "而现在"}, {"start": 2039.36, "end": 2040.36, "text": "只有你嫁过去"}, {"start": 2040.36, "end": 2041.36, "text": "才能维护住"}, {"start": 2041.36, "end": 2042.36, "text": "孙流联合的大局"}, {"start": 2043.36, "end": 2044.36, "text": "才能保住江东啊"}, {"start": 2045.36, "end": 2046.36, "text": "今天才知道"}, {"start": 2046.36, "end": 2047.36, "text": "你是世上"}, {"start": 2050.34, "end": 2054.0, "text": "也是最心狠的母亲"}, {"start": 2061.11, "end": 2062.11, "text": "我们来了几天了"}, {"start": 2063.11, "end": 2093.55, "text": "算起来"}, {"start": 2094.55, "end": 2095.55, "text": "应该是第七天了"}, {"start": 2095.55, "end": 2096.55, "text": "七天了"}, {"start": 2097.55, "end": 2100.15, "text": "还不见吴侯的动静"}, {"start": 2101.15, "end": 2102.15, "text": "前几日"}, {"start": 2103.15, "end": 2104.15, "text": "卢夙还不时地来照应"}, {"start": 2105.15, "end": 2106.15, "text": "这几天"}, {"start": 2106.15, "end": 2108.15, "text": "连他也不见了人影"}, {"start": 2109.15, "end": 2110.15, "text": "采买的人回来说"}, {"start": 2110.15, "end": 2113.49, "text": "市井间已传言"}, {"start": 2114.49, "end": 2115.49, "text": "路素已经被削植了"}, {"start": 2116.49, "end": 2117.49, "text": "主公"}, {"start": 2117.49, "end": 2119.96, "text": "我有种不祥的预感"}, {"start": 2120.96, "end": 2121.96, "text": "此次到甘露寺相亲"}, {"start": 2122.96, "end": 2123.96, "text": "可能会有什么阴谋"}, {"start": 2124.96, "end": 2125.96, "text": "你所忧不无道理"}, {"start": 2130.19, "end": 2131.19, "text": "招我来东吴结亲"}, {"start": 2134.24, "end": 2135.24, "text": "是吴侯钦浅的使者"}, {"start": 2136.24, "end": 2137.24, "text": "如果不是遇到什么波折"}, {"start": 2138.24, "end": 2139.24, "text": "不至于这么久"}, {"start": 2139.24, "end": 2140.24, "text": "还见不到孙犬"}, {"start": 2141.24, "end": 2142.24, "text": "我想"}, {"start": 2142.24, "end": 2143.24, "text": "可能是东吴"}, {"start": 2143.24, "end": 2144.24, "text": "自己出现了分歧"}, {"start": 2145.24, "end": 2146.24, "text": "如果卢紫静"}, {"start": 2146.24, "end": 2147.24, "text": "被削植时"}, {"start": 2147.24, "end": 2148.24, "text": "就更加印证了这一点"}, {"start": 2149.24, "end": 2150.24, "text": "皇叔"}, {"start": 2150.24, "end": 2151.24, "text": "我是管成"}, {"start": 2151.24, "end": 2155.66, "text": "鲁大夫求见"}, {"start": 2156.66, "end": 2157.66, "text": "快请进来"}, {"start": 2157.66, "end": 2158.66, "text": "公瑾在甘露寺里"}, {"start": 2158.66, "end": 2159.66, "text": "摆下了一场红门宴"}, {"start": 2167.96, "end": 2168.96, "text": "万一小姐"}, {"start": 2168.96, "end": 2169.96, "text": "不肯嫁给皇叔"}, {"start": 2169.96, "end": 2171.96, "text": "那埋伏在甘露寺两厢的"}, {"start": 2171.96, "end": 2172.96, "text": "三百刀斧首饰"}, {"start": 2172.96, "end": 2173.96, "text": "绝不会让皇叔"}, {"start": 2173.96, "end": 2174.96, "text": "走出去的"}, {"start": 2174.96, "end": 2175.96, "text": "此话当真"}, {"start": 2175.96, "end": 2176.96, "text": "皇叔"}, {"start": 2184.3, "end": 2185.3, "text": "难道我卢紫静"}, {"start": 2185.3, "end": 2187.3, "text": "肝冒背主之命"}, {"start": 2187.3, "end": 2189.3, "text": "来到你这管邑之中"}, {"start": 2189.3, "end": 2190.3, "text": "就是为了说句谎话不成"}, {"start": 2191.3, "end": 2192.3, "text": "此事"}, {"start": 2192.3, "end": 2193.3, "text": "是为了说句谎话不成"}, {"start": 2196.02, "end": 2197.02, "text": "紫静"}, {"start": 2197.02, "end": 2198.02, "text": "我相信你"}, {"start": 2198.02, "end": 2199.02, "text": "孔明早就说过了"}, {"start": 2200.02, "end": 2201.02, "text": "卢紫静"}, {"start": 2201.02, "end": 2202.02, "text": "乃江东第一君子"}, {"start": 2202.02, "end": 2203.02, "text": "与你这样的人"}, {"start": 2203.02, "end": 2204.02, "text": "不论是做朋友"}, {"start": 2204.02, "end": 2205.02, "text": "还是做敌人"}, {"start": 2205.02, "end": 2206.02, "text": "都是人生的快事"}, {"start": 2207.02, "end": 2208.02, "text": "孔明谬讲了"}, {"start": 2208.02, "end": 2209.02, "text": "事不宜迟"}, {"start": 2209.02, "end": 2210.02, "text": "请皇叔"}, {"start": 2210.02, "end": 2211.02, "text": "立刻坐在下的车架"}, {"start": 2211.02, "end": 2212.02, "text": "离开此地"}, {"start": 2212.02, "end": 2213.02, "text": "我已经密使人"}, {"start": 2213.02, "end": 2214.02, "text": "在江中"}, {"start": 2214.02, "end": 2215.02, "text": "备下了一只小船"}, {"start": 2215.02, "end": 2217.02, "text": "连夜送你们回荆州"}, {"start": 2224.26, "end": 2225.26, "text": "多谢紫静"}, {"start": 2225.26, "end": 2226.26, "text": "可是"}, {"start": 2226.26, "end": 2227.26, "text": "我不能走啊"}, {"start": 2229.74, "end": 2230.74, "text": "这是为何呀"}, {"start": 2230.74, "end": 2231.74, "text": "我若走了"}, {"start": 2231.74, "end": 2233.74, "text": "将至吴侯于何地啊"}, {"start": 2234.74, "end": 2235.74, "text": "东吴主战的人"}, {"start": 2235.74, "end": 2237.74, "text": "又占上风"}, {"start": 2237.74, "end": 2238.74, "text": "孙六渐"}, {"start": 2238.74, "end": 2240.74, "text": "就只能是大动干戈了"}, {"start": 2241.74, "end": 2242.74, "text": "这一来"}, {"start": 2243.74, "end": 2244.74, "text": "得意者是谁啊"}, {"start": 2245.74, "end": 2246.74, "text": "曹操啊"}, {"start": 2247.74, "end": 2248.74, "text": "再说了"}, {"start": 2248.74, "end": 2250.74, "text": "明日干龙寺"}, {"start": 2251.74, "end": 2252.74, "text": "小姐未必就一定"}, {"start": 2252.74, "end": 2253.74, "text": "相不中我呀"}, {"start": 2254.74, "end": 2255.74, "text": "要是她相中我了"}, {"start": 2256.74, "end": 2257.74, "text": "周瑜"}, {"start": 2257.74, "end": 2258.74, "text": "不就没有办法"}, {"start": 2258.74, "end": 2259.74, "text": "动刀斧手了吗"}, {"start": 2260.74, "end": 2261.74, "text": "皇叔啊"}, {"start": 2262.74, "end": 2264.74, "text": "公瑾是什么样的人"}, {"start": 2264.74, "end": 2265.74, "text": "你还不知道吗"}, {"start": 2266.74, "end": 2267.74, "text": "她早就算你好了"}, {"start": 2269.74, "end": 2270.74, "text": "现在皇叔的安危"}, {"start": 2270.74, "end": 2271.74, "text": "全系于小姐一念"}, {"start": 2272.74, "end": 2274.74, "text": "可小姐今年才十八岁"}, {"start": 2274.74, "end": 2276.74, "text": "皇叔毕竟都四十八了"}, {"start": 2277.74, "end": 2278.74, "text": "按常理说"}, {"start": 2279.74, "end": 2281.74, "text": "胜算时不足矣"}, {"start": 2281.74, "end": 2282.74, "text": "万一小姐"}, {"start": 2282.74, "end": 2283.74, "text": "她不点这个头"}, {"start": 2283.74, "end": 2284.74, "text": "到时候皇叔"}, {"start": 2284.74, "end": 2285.74, "text": "要是再相走"}, {"start": 2286.74, "end": 2287.74, "text": "可就难了"}, {"start": 2287.74, "end": 2288.74, "text": "紫静不必再劝了"}, {"start": 2288.74, "end": 2292.62, "text": "就算"}, {"start": 2293.62, "end": 2294.62, "text": "只有一场胜算"}, {"start": 2295.62, "end": 2296.62, "text": "我也一定要试试"}, {"start": 2297.62, "end": 2314.49, "text": "母亲"}, {"start": 2314.49, "end": 2315.49, "text": "我卓人"}, {"start": 2315.49, "end": 2316.49, "text": "给您煮了一碗羹"}, {"start": 2317.49, "end": 2320.57, "text": "这么晚了"}, {"start": 2321.57, "end": 2322.57, "text": "你还没睡"}, {"start": 2324.57, "end": 2325.57, "text": "睡不着啊"}, {"start": 2326.57, "end": 2328.57, "text": "你是在担心你妹妹"}, {"start": 2329.57, "end": 2330.57, "text": "到底会不会"}, {"start": 2330.57, "end": 2331.57, "text": "听从我的安排吧"}, {"start": 2332.57, "end": 2340.1, "text": "我没见过刘备"}, {"start": 2341.1, "end": 2342.1, "text": "她必定是个"}, {"start": 2342.1, "end": 2343.1, "text": "年近半百的人了"}, {"start": 2344.1, "end": 2345.1, "text": "这些年遭遇不及"}, {"start": 2346.1, "end": 2347.1, "text": "风餐露宿"}, {"start": 2349.1, "end": 2350.1, "text": "万一她长得"}, {"start": 2352.34, "end": 2353.34, "text": "长得太不近人意"}, {"start": 2354.34, "end": 2355.34, "text": "小眉看不上她"}, {"start": 2357.34, "end": 2358.34, "text": "那可是无法挽回的"}, {"start": 2362.58, "end": 2363.58, "text": "你不要担心"}, {"start": 2364.58, "end": 2365.58, "text": "我的女儿"}, {"start": 2365.58, "end": 2366.58, "text": "我比谁都清楚"}, {"start": 2368.58, "end": 2369.58, "text": "我们孙家后代"}, {"start": 2370.58, "end": 2371.58, "text": "都是英雄"}, {"start": 2372.58, "end": 2373.58, "text": "英雄"}, {"start": 2374.58, "end": 2376.58, "text": "哪有不爱英雄的呢"}, {"start": 2378.58, "end": 2379.58, "text": "你是要做大事的人"}, {"start": 2380.58, "end": 2381.58, "text": "你忍得住气"}, {"start": 2381.58, "end": 2382.58, "text": "天塌下来"}, {"start": 2383.58, "end": 2384.58, "text": "也要能睡得着"}, {"start": 2387.56, "end": 2388.56, "text": "快回去睡吧"}, {"start": 2389.56, "end": 2390.56, "text": "母亲教导的是"}, {"start": 2394.09, "end": 2395.09, "text": "母亲也早些休息吧"}, {"start": 2438.14, "end": 2439.14, "text": "主公真沉得住气"}, {"start": 2440.14, "end": 2441.14, "text": "还是睡得很香"}, {"start": 2443.7, "end": 2444.7, "text": "主公就是主公"}, {"start": 2445.7, "end": 2446.7, "text": "从我第一天跟他起"}, {"start": 2446.7, "end": 2447.7, "text": "我就知道"}, {"start": 2447.7, "end": 2448.7, "text": "他就是天上的"}, {"start": 2448.7, "end": 2449.7, "text": "星宿下凡"}, {"start": 2467.5, "end": 2468.5, "text": "公瑾在甘露寺里"}, {"start": 2468.5, "end": 2469.5, "text": "摆下了一场红梅宴"}, {"start": 2470.5, "end": 2471.5, "text": "万一小姐不肯嫁给皇叔"}, {"start": 2472.5, "end": 2473.5, "text": "那埋伏在甘露寺两乡的"}, {"start": 2473.5, "end": 2474.5, "text": "三百刀斧首饰"}, {"start": 2474.5, "end": 2475.5, "text": "绝不会让皇叔走出去的"}]