[{"start": 4.18, "end": 6.18, "text": "川帝艰险易守难攻,"}, {"start": 6.18, "end": 8.18, "text": "古称川帝为天府之国,"}, {"start": 8.18, "end": 10.18, "text": "那里物产丰盛,"}, {"start": 10.18, "end": 12.18, "text": "足可养兵百万。"}, {"start": 12.18, "end": 16.18, "text": "当年,高祖刘邦就是从川帝起兵而得天下成帝也。"}, {"start": 17.18, "end": 19.18, "text": "将军得西川、京乡两地之后,"}, {"start": 19.18, "end": 21.18, "text": "天下一居齐半。"}, {"start": 21.18, "end": 23.18, "text": "既知,就改南府一跃,"}, {"start": 23.18, "end": 25.18, "text": "西河朱荣,外劫孙氏,"}, {"start": 25.18, "end": 27.18, "text": "内修君正名声。"}, {"start": 27.18, "end": 30.18, "text": "待天下有变,便可率熊师出秦川,"}, {"start": 30.18, "end": 32.18, "text": "取许昌,灭曹贼。"}, {"start": 32.18, "end": 35.18, "text": "如果将军按此方略行事,"}, {"start": 35.18, "end": 38.18, "text": "我料十年之内,大业必成。"}, {"start": 39.18, "end": 41.18, "text": "再十年,天下可定。"}, {"start": 42.18, "end": 45.18, "text": "将军就能忠心汉事,"}, {"start": 45.18, "end": 47.18, "text": "而名垂千古。"}, {"start": 48.18, "end": 52.18, "text": "二十年,即可安天下。"}, {"start": 52.18, "end": 59.57, "text": "将军可知,我去何处远游了吗?"}, {"start": 59.57, "end": 61.57, "text": "不知。"}, {"start": 61.57, "end": 63.57, "text": "西川,将军请看。"}, {"start": 63.57, "end": 78.18, "text": "这便是西川五十四郡的祥土。"}, {"start": 78.18, "end": 83.04, "text": "从现在开始,将军便要"}, {"start": 83.04, "end": 85.04, "text": "眼观京州,意在西川,"}, {"start": 85.04, "end": 88.04, "text": "心存天下,徐图进取。"}, {"start": 88.04, "end": 111.6, "text": "刘备,斗胆请你出山相助。"}, {"start": 112.6, "end": 115.6, "text": "我必终生奉你为师。"}, {"start": 115.6, "end": 118.6, "text": "先生啊,先生不出,"}, {"start": 118.6, "end": 123.84, "text": "苍生无救。"}, {"start": 123.84, "end": 126.84, "text": "刘备,恳请先生。"}, {"start": 126.84, "end": 130.84, "text": "刘备,叩求先生。"}, {"start": 130.84, "end": 149.98, "text": "诸葛亮,愿效全马之劳。"}, {"start": 149.98, "end": 151.98, "text": "先生,您真要走了吗?"}, {"start": 151.98, "end": 176.31, "text": "那阿三怎么办?"}, {"start": 176.31, "end": 178.31, "text": "好生看管家园,"}, {"start": 178.31, "end": 181.31, "text": "我功成之后,定当归也。"}, {"start": 181.31, "end": 183.31, "text": "阿三知道了。"}, {"start": 183.31, "end": 186.31, "text": "易德兄弟,别忘了,"}, {"start": 186.31, "end": 188.31, "text": "欠我一座草堂。"}, {"start": 188.31, "end": 190.31, "text": "你若助我哥哥得了天下,"}, {"start": 190.31, "end": 191.31, "text": "我给你盖一座"}, {"start": 191.31, "end": 193.31, "text": "八百里大的草堂吧。"}, {"start": 195.31, "end": 196.31, "text": "一言为定。"}, {"start": 196.31, "end": 197.31, "text": "一言为定。"}, {"start": 197.31, "end": 198.31, "text": "请。"}, {"start": 198.31, "end": 199.31, "text": "走。"}, {"start": 199.31, "end": 201.31, "text": "从这一刻起,"}, {"start": 201.31, "end": 204.88, "text": "历史发生了巨变。"}, {"start": 204.88, "end": 217.22, "text": "龙中队成为千古名点。"}, {"start": 217.22, "end": 219.22, "text": "孔明未出茅蒙,"}, {"start": 219.22, "end": 222.22, "text": "已定三分天下。"}, {"start": 222.22, "end": 223.22, "text": "孔明先生十五年"}, {"start": 223.22, "end": 225.22, "text": "静观天下,"}, {"start": 225.22, "end": 226.22, "text": "今日终于得其主,"}, {"start": 226.22, "end": 230.11, "text": "出神山了。"}, {"start": 230.11, "end": 232.11, "text": "孔明虽得其主,"}, {"start": 232.11, "end": 234.11, "text": "不得其时日了。"}, {"start": 234.11, "end": 236.11, "text": "细哉。"}, {"start": 236.11, "end": 238.11, "text": "今天,"}, {"start": 238.11, "end": 240.11, "text": "神先射中猎物,"}, {"start": 240.11, "end": 242.11, "text": "我重赏。"}, {"start": 281.42, "end": 283.42, "text": "夫君怎么还没回来?"}, {"start": 283.42, "end": 284.42, "text": "随我去看看。"}, {"start": 284.42, "end": 285.42, "text": "诺。"}, {"start": 285.42, "end": 286.42, "text": "叫兵。"}, {"start": 286.42, "end": 302.63, "text": "齐桓宫,"}, {"start": 302.63, "end": 303.63, "text": "我去看看。"}, {"start": 303.63, "end": 309.02, "text": "是。"}, {"start": 309.02, "end": 403.82, "text": "齐桓宫,"}, {"start": 404.82, "end": 405.82, "text": "齐桓宫,"}, {"start": 405.82, "end": 406.82, "text": "楚庄王,"}, {"start": 406.82, "end": 407.82, "text": "晋文宫,"}, {"start": 407.82, "end": 410.82, "text": "相继称霸。"}, {"start": 410.82, "end": 411.82, "text": "燕,"}, {"start": 411.82, "end": 412.82, "text": "秦鲁,"}, {"start": 412.82, "end": 414.82, "text": "又继续征雄,"}, {"start": 414.82, "end": 417.82, "text": "先后三百年。"}, {"start": 417.82, "end": 420.82, "text": "中原吴宁日,"}, {"start": 420.82, "end": 423.82, "text": "京齐卷长空。"}, {"start": 423.82, "end": 424.82, "text": "报!"}, {"start": 424.82, "end": 425.82, "text": "报!"}, {"start": 425.82, "end": 426.82, "text": "少将军,"}, {"start": 426.82, "end": 427.82, "text": "主公被仇家射伤,"}, {"start": 427.82, "end": 429.82, "text": "主你快回去。"}, {"start": 429.82, "end": 434.31, "text": "伤势严重吗?"}, {"start": 434.31, "end": 436.31, "text": "伤势很严重,"}, {"start": 436.31, "end": 438.31, "text": "主公被侍卫抬回来的时候,"}, {"start": 438.31, "end": 439.31, "text": "已经,"}, {"start": 439.31, "end": 445.34, "text": "已经神志不清了。"}, {"start": 445.34, "end": 446.34, "text": "公子啊,"}, {"start": 446.34, "end": 448.34, "text": "听稍候。"}, {"start": 448.34, "end": 449.34, "text": "公子啊,"}, {"start": 449.34, "end": 450.34, "text": "咒讽计辩,"}, {"start": 450.34, "end": 453.34, "text": "定要冷静应对。"}, {"start": 453.34, "end": 454.34, "text": "主公纵伤的消息,"}, {"start": 454.34, "end": 456.34, "text": "一旦流传出去,"}, {"start": 456.34, "end": 457.34, "text": "各军的文武,"}, {"start": 457.34, "end": 459.34, "text": "就会惶惶不安。"}, {"start": 459.34, "end": 460.34, "text": "特别是,"}, {"start": 460.34, "end": 461.34, "text": "如果许昌,"}, {"start": 461.34, "end": 462.34, "text": "曹操和靖州刘表,"}, {"start": 462.34, "end": 464.34, "text": "知道此讯,"}, {"start": 464.34, "end": 465.34, "text": "趁着可能,"}, {"start": 465.34, "end": 467.34, "text": "蠢蠢欲动,"}, {"start": 467.34, "end": 469.34, "text": "趁江东内乱之时,"}, {"start": 469.34, "end": 471.34, "text": "向我用兵啊。"}, {"start": 471.34, "end": 498.5, "text": "多谢先生教诲。"}, {"start": 498.5, "end": 499.5, "text": "程老将军。"}, {"start": 499.5, "end": 500.5, "text": "在。"}, {"start": 500.5, "end": 501.5, "text": "请令三军统领及各级将士,"}, {"start": 501.5, "end": 502.5, "text": "就说主公在行猎时,"}, {"start": 502.5, "end": 503.5, "text": "不幸坠马,"}, {"start": 503.5, "end": 504.5, "text": "受了点轻伤,"}, {"start": 504.5, "end": 505.5, "text": "不日及个痊愈,"}, {"start": 505.5, "end": 506.5, "text": "敢有遭遥生事。"}, {"start": 506.5, "end": 507.5, "text": "急诊。"}, {"start": 507.5, "end": 508.5, "text": "明白,"}, {"start": 508.5, "end": 509.5, "text": "我这就去传命。"}, {"start": 509.5, "end": 510.5, "text": "黄老将军。"}, {"start": 510.5, "end": 511.5, "text": "在。"}, {"start": 511.5, "end": 512.5, "text": "请你撤去街上的军事,"}, {"start": 512.5, "end": 513.5, "text": "让将军府恢复常态,"}, {"start": 513.5, "end": 514.5, "text": "让各级官员归守原职。"}, {"start": 514.5, "end": 515.5, "text": "知道了,"}, {"start": 515.5, "end": 545.17, "text": "急办。"}, {"start": 545.17, "end": 546.17, "text": "母亲,"}, {"start": 546.17, "end": 549.17, "text": "霍哥怎么样了?"}, {"start": 549.17, "end": 551.8, "text": "你,"}, {"start": 551.8, "end": 552.8, "text": "哥,"}, {"start": 552.8, "end": 553.8, "text": "他,"}, {"start": 553.8, "end": 564.7, "text": "怕是不好了。"}, {"start": 564.7, "end": 568.38, "text": "哥,"}, {"start": 568.38, "end": 575.78, "text": "我来了。"}, {"start": 575.78, "end": 576.78, "text": "全帝来了。"}, {"start": 576.78, "end": 583.93, "text": "哥。"}, {"start": 583.93, "end": 592.0, "text": "扶来,"}, {"start": 592.0, "end": 600.38, "text": "接下江东兵府。"}, {"start": 600.38, "end": 602.38, "text": "哥,"}, {"start": 602.38, "end": 605.38, "text": "这万万不可。"}, {"start": 605.38, "end": 607.38, "text": "你会好起来的。"}, {"start": 607.38, "end": 611.98, "text": "请令!"}, {"start": 611.98, "end": 615.42, "text": "接下兵府,"}, {"start": 615.42, "end": 627.14, "text": "执掌江东。"}, {"start": 627.14, "end": 629.14, "text": "不及这等大任呢。"}, {"start": 629.14, "end": 633.9, "text": "要论杀场、吃场,"}, {"start": 633.9, "end": 642.92, "text": "皆胜于两阵之间。"}, {"start": 642.92, "end": 645.92, "text": "但要论举弦任能,"}, {"start": 645.92, "end": 648.92, "text": "运筹于帷幄。"}, {"start": 648.92, "end": 649.92, "text": "我,"}, {"start": 649.92, "end": 699.86, "text": "你能胆敢大任。"}, {"start": 699.86, "end": 700.86, "text": "全儿,"}, {"start": 700.86, "end": 702.86, "text": "听你哥的话,"}, {"start": 702.86, "end": 704.86, "text": "借过印符吧。"}, {"start": 704.86, "end": 716.21, "text": "江东文物,"}, {"start": 716.21, "end": 720.97, "text": "大多都是我的前辈叔伯,"}, {"start": 720.97, "end": 722.97, "text": "大哥英雄盖世,"}, {"start": 722.97, "end": 725.97, "text": "与他们有生死之情。"}, {"start": 725.97, "end": 729.79, "text": "他们定然扶大哥,"}, {"start": 729.79, "end": 733.36, "text": "可他们怎么会扶我呢?"}, {"start": 733.36, "end": 735.36, "text": "我才十八岁,"}, {"start": 735.36, "end": 737.36, "text": "在他们眼里,"}, {"start": 737.36, "end": 739.36, "text": "我太稚嫩了,"}, {"start": 739.36, "end": 743.76, "text": "我甚至,"}, {"start": 743.76, "end": 749.29, "text": "比他们的儿子还小许多。"}, {"start": 749.29, "end": 772.47, "text": "你是主,"}, {"start": 772.47, "end": 774.47, "text": "他们是臣。"}, {"start": 774.47, "end": 827.26, "text": "你父亲做将军时,"}, {"start": 827.26, "end": 829.26, "text": "也是你这般大。"}, {"start": 829.26, "end": 831.26, "text": "你哥成绩复页时,"}, {"start": 831.26, "end": 834.26, "text": "比你的年龄还小。"}, {"start": 834.26, "end": 836.26, "text": "数代以来,"}, {"start": 836.26, "end": 840.26, "text": "我江东一直是英雄初少年。"}, {"start": 840.26, "end": 843.26, "text": "现在祖爷交到你手里,"}, {"start": 843.26, "end": 845.26, "text": "你定能够,"}, {"start": 845.26, "end": 879.35, "text": "无愧于父兄。"}, {"start": 879.35, "end": 887.3, "text": "母亲孙权,"}, {"start": 887.3, "end": 888.3, "text": "领命了。"}, {"start": 888.3, "end": 898.07, "text": "放下了。"}, {"start": 898.07, "end": 925.74, "text": "老臣张昭,"}, {"start": 925.74, "end": 927.74, "text": "拜见主公。"}, {"start": 927.74, "end": 930.74, "text": "拜见主公。"}, {"start": 930.74, "end": 939.65, "text": "各位亲戚,"}, {"start": 939.65, "end": 954.0, "text": "我受兄长一命,"}, {"start": 954.0, "end": 957.44, "text": "成绩祖爷,"}, {"start": 957.44, "end": 959.44, "text": "指令江东。"}, {"start": 959.44, "end": 961.44, "text": "即日起,"}, {"start": 961.44, "end": 963.44, "text": "盼各位叔伯,"}, {"start": 963.44, "end": 965.44, "text": "多多辅佐,"}, {"start": 965.44, "end": 968.44, "text": "共乡大业。"}, {"start": 968.44, "end": 970.44, "text": "指令。"}, {"start": 970.44, "end": 979.38, "text": "将军周瑜,"}, {"start": 979.38, "end": 981.38, "text": "正在芭秀贤县。"}, {"start": 981.38, "end": 982.38, "text": "此时,"}, {"start": 982.38, "end": 984.38, "text": "末将的意思,"}, {"start": 984.38, "end": 986.38, "text": "应该立即招他回吴郡,"}, {"start": 986.38, "end": 988.38, "text": "主持江东大计。"}, {"start": 988.38, "end": 993.3, "text": "我是说,"}, {"start": 993.3, "end": 995.3, "text": "招他回来,"}, {"start": 995.3, "end": 996.3, "text": "辅佐少主公,"}, {"start": 996.3, "end": 999.3, "text": "主持江东大计。"}, {"start": 999.3, "end": 1002.3, "text": "母亲已经传命了,"}, {"start": 1002.3, "end": 1004.3, "text": "让周公锦,"}, {"start": 1004.3, "end": 1006.3, "text": "速归。"}, {"start": 1006.3, "end": 1007.3, "text": "遵命。"}, {"start": 1007.3, "end": 1047.16, "text": "如今我生世于此,"}, {"start": 1047.16, "end": 1051.46, "text": "发现一道,"}, {"start": 1051.46, "end": 1054.84, "text": "不能跟你白头偕老,"}, {"start": 1054.84, "end": 1058.12, "text": "走完以后的路,"}, {"start": 1058.12, "end": 1063.42, "text": "不要怪我呀。"}, {"start": 1064.42, "end": 1067.66, "text": "夫君,"}, {"start": 1067.66, "end": 1068.66, "text": "你不要这样说,"}, {"start": 1068.66, "end": 1072.26, "text": "你还会站起来的,"}, {"start": 1072.26, "end": 1074.26, "text": "还会驰骋沙场。"}, {"start": 1074.26, "end": 1076.26, "text": "别忘了,"}, {"start": 1076.26, "end": 1077.26, "text": "你的江东大业,"}, {"start": 1077.26, "end": 1083.1, "text": "还没有完成呢。"}, {"start": 1083.1, "end": 1085.1, "text": "我已如此,"}, {"start": 1085.1, "end": 1090.11, "text": "何谈大业?"}, {"start": 1090.11, "end": 1098.82, "text": "像我少年时骑兵,"}, {"start": 1098.82, "end": 1102.9, "text": "数年间,"}, {"start": 1102.9, "end": 1106.46, "text": "又占据了江东。"}, {"start": 1106.46, "end": 1109.54, "text": "现在,"}, {"start": 1109.54, "end": 1114.05, "text": "我却要先离江东,"}, {"start": 1114.05, "end": 1119.13, "text": "我心痛了。"}, {"start": 1119.13, "end": 1121.13, "text": "不夫君,"}, {"start": 1121.13, "end": 1123.13, "text": "你不会倒下的,"}, {"start": 1123.13, "end": 1124.13, "text": "不会。"}, {"start": 1124.13, "end": 1130.45, "text": "一切都是命啊,"}, {"start": 1130.45, "end": 1138.16, "text": "只是少儿现在年纪太小,"}, {"start": 1138.16, "end": 1139.16, "text": "不成大业。"}, {"start": 1139.16, "end": 1149.39, "text": "我已将江东托付给了全帝。"}, {"start": 1149.39, "end": 1151.39, "text": "你要记着,"}, {"start": 1151.39, "end": 1155.02, "text": "以后,"}, {"start": 1155.02, "end": 1161.34, "text": "以江东大举为重,"}, {"start": 1161.34, "end": 1165.36, "text": "为江东整命。"}, {"start": 1165.36, "end": 1173.98, "text": "定以江东大举为重。"}, {"start": 1174.98, "end": 1186.92, "text": "我现在就要离去啊,"}, {"start": 1186.92, "end": 1190.92, "text": "怎么能躺在床踏之上而死。"}, {"start": 1190.92, "end": 1195.19, "text": "来,"}, {"start": 1195.19, "end": 1197.19, "text": "扶我起来。"}, {"start": 1197.19, "end": 1198.19, "text": "夫君,"}, {"start": 1198.19, "end": 1199.19, "text": "你。"}, {"start": 1199.19, "end": 1201.19, "text": "扶我起来。"}, {"start": 1201.19, "end": 1255.0, "text": "若有来世,"}, {"start": 1255.0, "end": 1257.0, "text": "大强,"}, {"start": 1257.0, "end": 1259.0, "text": "还愿意做夫君的妻子。"}, {"start": 1259.0, "end": 1281.31, "text": "夫君。"}, {"start": 1281.31, "end": 1335.85, "text": "先主公,"}, {"start": 1335.85, "end": 1338.85, "text": "虽将兵符交给少主,"}, {"start": 1338.85, "end": 1340.85, "text": "可权力交接"}, {"start": 1340.85, "end": 1343.85, "text": "历来是父王子弟。"}, {"start": 1343.85, "end": 1346.85, "text": "孙少是先主公亲子,"}, {"start": 1346.85, "end": 1348.85, "text": "理应由孙少"}, {"start": 1348.85, "end": 1351.85, "text": "接替先主公掌管江东。"}, {"start": 1351.85, "end": 1354.85, "text": "孙少尚小,"}, {"start": 1354.85, "end": 1357.85, "text": "可由夫人代为掌管。"}, {"start": 1357.85, "end": 1361.85, "text": "这才是千年流传的规矩,"}, {"start": 1361.85, "end": 1364.85, "text": "如此才有礼法可徇。"}, {"start": 1364.85, "end": 1366.85, "text": "请夫人代幼子孙少"}, {"start": 1366.85, "end": 1368.85, "text": "接管江东。"}, {"start": 1368.85, "end": 1371.85, "text": "幼子孙少理应接管江东,"}, {"start": 1371.85, "end": 1374.85, "text": "如此才是以江东大局为重,"}, {"start": 1374.85, "end": 1377.85, "text": "才可使众人信服。"}, {"start": 1377.85, "end": 1380.85, "text": "请夫人三思。"}, {"start": 1380.85, "end": 1417.4, "text": "夫人,"}, {"start": 1417.4, "end": 1423.96, "text": "请以江东大局为重。"}, {"start": 1423.96, "end": 1429.16, "text": "张大人想说什么,"}, {"start": 1429.16, "end": 1430.16, "text": "大桥听着。"}, {"start": 1430.16, "end": 1434.21, "text": "夫人,"}, {"start": 1434.21, "end": 1436.21, "text": "请问,"}, {"start": 1436.21, "end": 1440.21, "text": "如今汉室衰败的起因是什么呢?"}, {"start": 1440.21, "end": 1446.74, "text": "应是多位先帝幼小,"}, {"start": 1446.74, "end": 1448.74, "text": "皇后当政,"}, {"start": 1448.74, "end": 1451.74, "text": "外戚专权所至啊。"}, {"start": 1451.74, "end": 1453.74, "text": "如今我江东,"}, {"start": 1453.74, "end": 1456.74, "text": "虽然先主公孙策,"}, {"start": 1456.74, "end": 1459.74, "text": "把大权交给了孙权,"}, {"start": 1459.74, "end": 1462.74, "text": "可是留下幼子孙少"}, {"start": 1462.74, "end": 1465.74, "text": "还有夫人你。"}, {"start": 1465.74, "end": 1470.74, "text": "有很多人因此而心存芥蒂,"}, {"start": 1470.74, "end": 1474.74, "text": "生怕夫人仿效汉室皇后,"}, {"start": 1474.74, "end": 1476.74, "text": "一旦有人要挟夫人,"}, {"start": 1476.74, "end": 1478.74, "text": "以此作乱,"}, {"start": 1478.74, "end": 1480.74, "text": "那我江东,"}, {"start": 1480.74, "end": 1482.74, "text": "必将大乱啊。"}, {"start": 1482.74, "end": 1488.84, "text": "可我只想为夫君守灵,"}, {"start": 1488.84, "end": 1489.84, "text": "你说,"}, {"start": 1489.84, "end": 1494.22, "text": "难道我错了吗?"}, {"start": 1494.22, "end": 1497.22, "text": "夫人当然没有错,"}, {"start": 1497.22, "end": 1499.22, "text": "或许也没有什么人是错的,"}, {"start": 1499.22, "end": 1503.22, "text": "可是古往今来权力的交接,"}, {"start": 1503.22, "end": 1506.22, "text": "是父王子替,"}, {"start": 1506.22, "end": 1508.22, "text": "如今是孙权当政,"}, {"start": 1508.22, "end": 1510.22, "text": "你带着幼子,"}, {"start": 1510.22, "end": 1512.22, "text": "肯定会引起人们的猜疑,"}, {"start": 1512.22, "end": 1514.22, "text": "防备。"}, {"start": 1514.22, "end": 1516.22, "text": "一旦有人利用此事,"}, {"start": 1516.22, "end": 1520.22, "text": "那最终的结局将是,"}, {"start": 1520.22, "end": 1524.22, "text": "孙策一手建立起来的江东大局,"}, {"start": 1524.22, "end": 1527.22, "text": "不得稳定啊。"}, {"start": 1527.22, "end": 1531.53, "text": "请夫人三思,"}, {"start": 1531.53, "end": 1533.53, "text": "主公啊,"}, {"start": 1533.53, "end": 1542.58, "text": "请原谅老臣的直言。"}, {"start": 1542.58, "end": 1544.58, "text": "夫君,"}, {"start": 1544.58, "end": 1612.15, "text": "我追随你多年,"}, {"start": 1612.15, "end": 1615.85, "text": "知道你的雄心伟略,"}, {"start": 1615.85, "end": 1620.06, "text": "我知道,"}, {"start": 1620.06, "end": 1622.06, "text": "江东吉夜,"}, {"start": 1622.06, "end": 1624.06, "text": "是夫君的生命。"}, {"start": 1624.06, "end": 1628.3, "text": "我知道,"}, {"start": 1628.3, "end": 1630.3, "text": "夫君即使在天上,"}, {"start": 1630.3, "end": 1632.3, "text": "也想看到江东的稳定,"}, {"start": 1632.3, "end": 1634.3, "text": "如果江东不稳,"}, {"start": 1634.3, "end": 1638.63, "text": "夫君的在天之灵,"}, {"start": 1638.63, "end": 1640.63, "text": "又怎么能够安息?"}, {"start": 1640.63, "end": 1642.63, "text": "为了江东的稳定,"}, {"start": 1642.63, "end": 1648.41, "text": "甘愿为夫君,"}, {"start": 1648.41, "end": 1653.8, "text": "舍弃生命,"}, {"start": 1653.8, "end": 1655.8, "text": "我是夫君的。"}, {"start": 1655.8, "end": 1672.23, "text": "将军!"}, {"start": 1672.23, "end": 1674.23, "text": "将军!"}, {"start": 1674.23, "end": 1680.52, "text": "何事大呼小叫?"}, {"start": 1680.52, "end": 1682.52, "text": "传太夫人口讯,"}, {"start": 1682.52, "end": 1684.52, "text": "请你迅速返回江东。"}, {"start": 1684.52, "end": 1685.52, "text": "出什么事了?"}, {"start": 1685.52, "end": 1686.52, "text": "主公,"}, {"start": 1686.52, "end": 1691.37, "text": "主公去世了。"}, {"start": 1691.37, "end": 1692.37, "text": "令少主孙全,"}, {"start": 1692.37, "end": 1693.37, "text": "执掌江东印符,"}, {"start": 1693.37, "end": 1695.37, "text": "成绩祖业。"}, {"start": 1695.37, "end": 1697.37, "text": "太夫人命你立即返回江东,"}, {"start": 1697.37, "end": 1698.37, "text": "辅助少主,"}, {"start": 1698.37, "end": 1715.18, "text": "以祭江东大业。"}, {"start": 1715.18, "end": 1716.18, "text": "令少主,"}, {"start": 1716.18, "end": 1718.18, "text": "上将军周瑜回城奔丧了。"}, {"start": 1718.18, "end": 1720.18, "text": "带来多少兵马?"}, {"start": 1720.18, "end": 1721.18, "text": "周将军进城的时候,"}, {"start": 1721.18, "end": 1723.18, "text": "只有单击匹马。"}, {"start": 1723.18, "end": 1725.98, "text": "知道了。"}, {"start": 1725.98, "end": 1772.58, "text": "你为何匆匆离去?"}, {"start": 1772.58, "end": 1785.37, "text": "周瑜来迟,"}, {"start": 1785.37, "end": 1791.88, "text": "连面都没见上。"}, {"start": 1791.88, "end": 1822.46, "text": "兄长。"}, {"start": 1822.46, "end": 1823.46, "text": "恭敬将军,"}, {"start": 1823.46, "end": 1827.95, "text": "请你接下兵符,"}, {"start": 1827.95, "end": 1830.2, "text": "提令江东,"}, {"start": 1830.2, "end": 1833.96, "text": "继承我父兄大业。"}, {"start": 1833.96, "end": 1849.43, "text": "你这是为何?"}, {"start": 1849.43, "end": 1852.43, "text": "江东是孙氏三代大侠的江山。"}, {"start": 1852.43, "end": 1854.43, "text": "我周瑜,"}, {"start": 1854.43, "end": 1856.43, "text": "万不能行窜逆之事。"}, {"start": 1856.43, "end": 1858.43, "text": "将军听我说,"}, {"start": 1858.43, "end": 1860.43, "text": "这不是窜逆,"}, {"start": 1860.43, "end": 1862.43, "text": "这恰恰,"}, {"start": 1862.43, "end": 1864.43, "text": "是为了我父兄大业着想。"}, {"start": 1864.43, "end": 1866.43, "text": "我年幼稚难,"}, {"start": 1866.43, "end": 1868.43, "text": "不能服众。"}, {"start": 1868.43, "end": 1870.43, "text": "可将军你文武超俊,"}, {"start": 1870.43, "end": 1873.43, "text": "又久随我父兄征战,"}, {"start": 1873.43, "end": 1875.43, "text": "在江东文武中,"}, {"start": 1875.43, "end": 1878.43, "text": "你是最有威望的大将军。"}, {"start": 1878.43, "end": 1882.13, "text": "由你来指令江东,"}, {"start": 1882.13, "end": 1884.13, "text": "才能使文武败俘,"}, {"start": 1884.13, "end": 1887.13, "text": "广大祖业。"}, {"start": 1887.13, "end": 1905.52, "text": "我愿做将军手下一常事,"}, {"start": 1905.52, "end": 1907.52, "text": "一方面,"}, {"start": 1907.52, "end": 1909.52, "text": "可以相助将军,"}, {"start": 1909.52, "end": 1911.52, "text": "另一方面,"}, {"start": 1911.52, "end": 1913.52, "text": "可以安心侍奉母亲,"}, {"start": 1913.52, "end": 1915.52, "text": "安享太平,"}, {"start": 1915.52, "end": 1917.52, "text": "请将军体谅我的辱惑。"}, {"start": 1917.52, "end": 1925.12, "text": "这难道是主公的遗命吗?"}, {"start": 1925.12, "end": 1929.17, "text": "兄长的遗命是,"}, {"start": 1929.17, "end": 1931.17, "text": "让我们保佑江东,"}, {"start": 1931.17, "end": 1933.17, "text": "广大祖业。"}, {"start": 1933.17, "end": 1935.17, "text": "可能完成这遗命的"}, {"start": 1935.17, "end": 1958.35, "text": "首当将军你啊?"}, {"start": 1958.35, "end": 1959.35, "text": "少主心意,"}, {"start": 1959.35, "end": 1964.1, "text": "周瑜极为感动,"}, {"start": 1964.1, "end": 2006.26, "text": "但周瑜绝不能受命。"}, {"start": 2006.26, "end": 2008.26, "text": "周瑜奉命回城,"}, {"start": 2008.26, "end": 2014.26, "text": "拜见太夫人。"}, {"start": 2014.26, "end": 2017.63, "text": "周瑜,"}, {"start": 2017.63, "end": 2020.63, "text": "我幼年丧母,"}, {"start": 2020.63, "end": 2022.63, "text": "终年丧夫,"}, {"start": 2022.63, "end": 2027.01, "text": "晚年丧子。"}, {"start": 2027.01, "end": 2029.01, "text": "你说,"}, {"start": 2029.01, "end": 2032.01, "text": "我的命苦不苦啊?"}, {"start": 2032.01, "end": 2041.21, "text": "太夫人命苦,"}, {"start": 2041.21, "end": 2044.21, "text": "但夫人辅佐上将军孙涧,"}, {"start": 2044.21, "end": 2046.21, "text": "创下三江基业,"}, {"start": 2046.21, "end": 2048.21, "text": "又养育了主公和少主,"}, {"start": 2048.21, "end": 2050.21, "text": "使得江东能有今天的昌盛,"}, {"start": 2050.21, "end": 2056.18, "text": "足以敬佩太夫人。"}, {"start": 2056.18, "end": 2058.18, "text": "我虽然命苦,"}, {"start": 2058.18, "end": 2060.18, "text": "但有一个人,"}, {"start": 2060.18, "end": 2069.03, "text": "可能比我命更苦。"}, {"start": 2069.03, "end": 2071.03, "text": "小儿孙全呢?"}, {"start": 2071.03, "end": 2073.03, "text": "你看,"}, {"start": 2073.03, "end": 2075.03, "text": "他年方十八,"}, {"start": 2075.03, "end": 2078.03, "text": "就不得不执掌江东,"}, {"start": 2078.03, "end": 2081.03, "text": "任中而道远,"}, {"start": 2081.03, "end": 2084.03, "text": "内忧而外患,"}, {"start": 2084.03, "end": 2085.03, "text": "这些,"}, {"start": 2085.03, "end": 2088.03, "text": "都让他惶恐不安,"}, {"start": 2088.03, "end": 2090.03, "text": "让他暗暗发抖啊。"}, {"start": 2091.41, "end": 2093.41, "text": "刚才,"}, {"start": 2093.41, "end": 2095.41, "text": "全儿向你辞兵服了吧?"}, {"start": 2095.41, "end": 2104.47, "text": "太夫人,"}, {"start": 2104.47, "end": 2108.74, "text": "主公的遗命,"}, {"start": 2108.74, "end": 2110.74, "text": "究竟是什么?"}, {"start": 2110.74, "end": 2111.74, "text": "周瑜啊,"}, {"start": 2111.74, "end": 2114.99, "text": "你虽然不是我亲生,"}, {"start": 2114.99, "end": 2116.99, "text": "但我视你如亲子,"}, {"start": 2116.99, "end": 2118.99, "text": "所以,"}, {"start": 2118.99, "end": 2121.99, "text": "我把一切都告诉你了,"}, {"start": 2121.99, "end": 2123.99, "text": "孙策留下的遗命,"}, {"start": 2123.99, "end": 2125.99, "text": "确实是让全儿,"}, {"start": 2125.99, "end": 2127.99, "text": "提领江东。"}, {"start": 2127.99, "end": 2131.69, "text": "那少主为何要签让给我?"}, {"start": 2131.69, "end": 2134.69, "text": "这还不明白吗?"}, {"start": 2134.69, "end": 2136.69, "text": "孙策死后,"}, {"start": 2136.69, "end": 2138.69, "text": "全儿最敬重的人是你,"}, {"start": 2138.69, "end": 2141.69, "text": "最担心的人也是你。"}, {"start": 2141.69, "end": 2142.69, "text": "他想,"}, {"start": 2142.69, "end": 2144.69, "text": "与其将来你让他如坐针针,"}, {"start": 2144.69, "end": 2146.69, "text": "大权旁落,"}, {"start": 2146.69, "end": 2147.69, "text": "还不如早早地,"}, {"start": 2147.69, "end": 2150.69, "text": "把江东让给你。"}, {"start": 2150.69, "end": 2151.69, "text": "他相信,"}, {"start": 2151.69, "end": 2153.69, "text": "只有这样做,"}, {"start": 2153.69, "end": 2155.69, "text": "不但他能得到安全,"}, {"start": 2155.69, "end": 2157.69, "text": "江东的祖业,"}, {"start": 2157.69, "end": 2159.69, "text": "也能发展壮大。"}, {"start": 2159.69, "end": 2161.69, "text": "还有三军将士,"}, {"start": 2161.69, "end": 2163.69, "text": "各州郡的文武官员,"}, {"start": 2163.69, "end": 2166.69, "text": "也都能同心同德了。"}, {"start": 2166.69, "end": 2168.69, "text": "周瑜啊,"}, {"start": 2168.69, "end": 2171.69, "text": "孙策并不是庸弱的孩子,"}, {"start": 2171.69, "end": 2172.69, "text": "相反,"}, {"start": 2172.69, "end": 2174.69, "text": "他太聪明了,"}, {"start": 2174.69, "end": 2177.69, "text": "以示于他为了江东的百年大业,"}, {"start": 2177.69, "end": 2180.69, "text": "决心放弃自己的主位。"}, {"start": 2180.69, "end": 2181.69, "text": "秉先主公,"}, {"start": 2181.69, "end": 2233.64, "text": "在下周瑜,"}, {"start": 2233.64, "end": 2234.64, "text": "率成普,"}, {"start": 2234.64, "end": 2235.64, "text": "黄盖,"}, {"start": 2235.64, "end": 2236.64, "text": "韩当,"}, {"start": 2236.64, "end": 2237.64, "text": "祖茂,"}, {"start": 2237.64, "end": 2239.64, "text": "并率三军将士,"}, {"start": 2239.64, "end": 2241.64, "text": "在主公临前立誓,"}, {"start": 2241.64, "end": 2243.64, "text": "同心同德,"}, {"start": 2243.64, "end": 2245.64, "text": "扶助少主,"}, {"start": 2245.64, "end": 2246.64, "text": "生死无悔,"}, {"start": 2246.64, "end": 2248.64, "text": "永固江东。"}, {"start": 2248.64, "end": 2250.64, "text": "生死无悔,"}, {"start": 2250.64, "end": 2252.64, "text": "永固江东。"}, {"start": 2252.64, "end": 2276.72, "text": "各位将军请起,"}, {"start": 2276.72, "end": 2291.1, "text": "我孙泉,"}, {"start": 2291.1, "end": 2293.1, "text": "在此发誓,"}, {"start": 2293.1, "end": 2295.1, "text": "与各位前辈,"}, {"start": 2295.1, "end": 2297.1, "text": "荣辱于共,"}, {"start": 2297.1, "end": 2299.1, "text": "生死同仇,"}, {"start": 2299.1, "end": 2301.1, "text": "共创,"}, {"start": 2301.1, "end": 2303.1, "text": "千秋大业。"}, {"start": 2303.1, "end": 2348.85, "text": "你带着幼子,"}, {"start": 2348.85, "end": 2351.85, "text": "肯定会引起人们的见地防备。"}, {"start": 2351.85, "end": 2353.85, "text": "一旦有人,"}, {"start": 2353.85, "end": 2354.85, "text": "利用此事,"}, {"start": 2354.85, "end": 2357.85, "text": "那最终的结局将是,"}, {"start": 2357.85, "end": 2362.85, "text": "孙泉一手建立起来的江东大局,"}, {"start": 2362.85, "end": 2364.85, "text": "不得稳定。"}, {"start": 2364.85, "end": 2410.91, "text": "我得先生日日授教,"}, {"start": 2410.91, "end": 2412.91, "text": "心胸大开,"}, {"start": 2412.91, "end": 2414.91, "text": "真是如鱼得水啊。"}, {"start": 2414.91, "end": 2415.91, "text": "先生,"}, {"start": 2415.91, "end": 2416.91, "text": "请。"}, {"start": 2416.91, "end": 2417.91, "text": "好。"}, {"start": 2419.91, "end": 2420.91, "text": "云长,"}, {"start": 2420.91, "end": 2421.91, "text": "你听见没有?"}, {"start": 2421.91, "end": 2423.91, "text": "这大哥成了鱼,"}, {"start": 2423.91, "end": 2424.91, "text": "孔明成了水,"}, {"start": 2424.91, "end": 2426.91, "text": "那咱哥俩是什么呀?"}, {"start": 2426.91, "end": 2427.91, "text": "大哥,"}, {"start": 2427.91, "end": 2429.91, "text": "把孔明接下山后,"}, {"start": 2429.91, "end": 2431.91, "text": "便以施礼相待,"}, {"start": 2431.91, "end": 2433.91, "text": "食之同席,"}, {"start": 2433.91, "end": 2435.91, "text": "寝则同事,"}, {"start": 2435.91, "end": 2437.91, "text": "争天谈古论今。"}, {"start": 2438.91, "end": 2441.91, "text": "都快把你我兄弟给忘了。"}, {"start": 2442.91, "end": 2443.91, "text": "这孔明啊,"}, {"start": 2443.91, "end": 2444.91, "text": "比我还小十多岁呢。"}, {"start": 2444.91, "end": 2446.91, "text": "说他是乳嗅未干,"}, {"start": 2446.91, "end": 2447.91, "text": "也不为过啊。"}, {"start": 2447.91, "end": 2450.91, "text": "他怎么配做咱大哥的师父啊?"}, {"start": 2451.91, "end": 2454.91, "text": "此人浑身上下都是嘴,"}, {"start": 2454.91, "end": 2456.91, "text": "除了巧舌如簧之外,"}, {"start": 2456.91, "end": 2458.91, "text": "不见真本事。"}, {"start": 2458.91, "end": 2459.91, "text": "大哥,"}, {"start": 2459.91, "end": 2461.91, "text": "都快被他给哄糊涂了。"}, {"start": 2465.64, "end": 2466.64, "text": "二哥,"}, {"start": 2466.64, "end": 2467.64, "text": "让我收拾他一下。"}, {"start": 2467.64, "end": 2468.64, "text": "不可,"}, {"start": 2469.64, "end": 2471.64, "text": "你何必招大哥发怒呢?"}, {"start": 2471.64, "end": 2473.64, "text": "那咱们就这么忍着?"}, {"start": 2473.64, "end": 2474.64, "text": "莫急,"}, {"start": 2474.64, "end": 2476.64, "text": "太平时光,"}, {"start": 2476.64, "end": 2477.64, "text": "看不出真本事。"}, {"start": 2477.64, "end": 2479.64, "text": "大敌当前,"}, {"start": 2479.64, "end": 2481.64, "text": "还是要靠你我兄弟。"}, {"start": 2482.64, "end": 2483.64, "text": "这倒是。"}]