[{"start": 4.05, "end": 45.6, "text": "误会他们了。"}, {"start": 45.6, "end": 80.11, "text": "你太多疑了。"}, {"start": 80.11, "end": 82.11, "text": "咱们错杀了好人。"}, {"start": 82.11, "end": 84.11, "text": "做下大恶了。"}, {"start": 84.11, "end": 90.14, "text": "事已至此,悲叹何用?"}, {"start": 90.14, "end": 97.1, "text": "赶紧忘命吧。"}, {"start": 97.1, "end": 175.1, "text": "走吧。"}, {"start": 175.1, "end": 177.1, "text": "这是要去哪儿啊?"}, {"start": 177.1, "end": 179.1, "text": "伯父!"}, {"start": 179.1, "end": 181.1, "text": "这两天风声太紧,"}, {"start": 181.1, "end": 183.1, "text": "官兵追索甚急。"}, {"start": 183.1, "end": 185.1, "text": "假如我们留下,"}, {"start": 185.1, "end": 187.1, "text": "会给你带来祸患。"}, {"start": 187.1, "end": 189.1, "text": "我们还是走了为妙。"}, {"start": 189.1, "end": 191.1, "text": "那可不成啊。"}, {"start": 191.1, "end": 194.8, "text": "我们没酒都过来了。"}, {"start": 194.8, "end": 196.8, "text": "家里正杀猪煮猪肉呢。"}, {"start": 196.8, "end": 198.8, "text": "今晚咱们呢"}, {"start": 198.8, "end": 200.8, "text": "是吃饱喝足,"}, {"start": 200.8, "end": 202.8, "text": "一醉方休。"}, {"start": 202.8, "end": 204.8, "text": "谁也不能走啊。"}, {"start": 206.8, "end": 210.24, "text": "你待着干嘛?"}, {"start": 210.24, "end": 212.24, "text": "赶快给我回家啊。"}, {"start": 212.24, "end": 214.24, "text": "别在这儿待着啦。"}, {"start": 216.24, "end": 218.24, "text": "这大冷天的,"}, {"start": 218.24, "end": 220.24, "text": "你看。"}, {"start": 220.24, "end": 262.91, "text": "蒙德。"}, {"start": 262.91, "end": 264.91, "text": "这是我们的救命恩人。"}, {"start": 264.91, "end": 266.91, "text": "是位义士啊。"}, {"start": 266.91, "end": 268.91, "text": "对。"}, {"start": 268.91, "end": 270.91, "text": "他还是你父亲的姐姐兄弟,"}, {"start": 270.91, "end": 272.91, "text": "是你的伯父啊。"}, {"start": 272.91, "end": 274.91, "text": "对。"}, {"start": 274.91, "end": 276.91, "text": "我们已经错杀了"}, {"start": 276.91, "end": 278.91, "text": "吕家十几口无辜的人。"}, {"start": 278.91, "end": 280.91, "text": "你为什么还要杀了吕博社?"}, {"start": 280.91, "end": 282.91, "text": "正因为已经错杀无辜了,"}, {"start": 282.91, "end": 284.91, "text": "所以必须要斩草除根。"}, {"start": 284.91, "end": 286.91, "text": "你说什么?"}, {"start": 286.91, "end": 288.91, "text": "你想想,"}, {"start": 288.91, "end": 290.91, "text": "吕家十几口都被我们杀了。"}, {"start": 290.91, "end": 292.91, "text": "他能不惊不怒,"}, {"start": 292.91, "end": 294.91, "text": "能不带人来追杀吗?"}, {"start": 294.91, "end": 298.16, "text": "只有杀了他,"}, {"start": 298.16, "end": 300.16, "text": "才能永绝后患。"}, {"start": 300.16, "end": 306.35, "text": "你!"}, {"start": 306.35, "end": 308.35, "text": "手腕不抱鱼,"}, {"start": 308.35, "end": 310.35, "text": "吃醋还杀?"}, {"start": 310.35, "end": 312.35, "text": "你,你还有半个忠义之心吗?"}, {"start": 314.35, "end": 347.2, "text": "主什么?"}, {"start": 347.2, "end": 349.2, "text": "宁肯我负天下人,"}, {"start": 349.2, "end": 351.2, "text": "休叫天下人负我。"}, {"start": 351.2, "end": 362.26, "text": "龚台兄,"}, {"start": 362.26, "end": 432.06, "text": "恐怕我们得回去。"}, {"start": 432.06, "end": 434.06, "text": "要回哪里去?"}, {"start": 434.06, "end": 436.06, "text": "宁高县。"}, {"start": 436.06, "end": 438.06, "text": "为什么?"}, {"start": 438.06, "end": 440.06, "text": "死去城柳还有七百里路。"}, {"start": 440.06, "end": 442.06, "text": "我们已经两天两夜都没吃没喝了。"}, {"start": 442.06, "end": 444.06, "text": "如果再这么走下去,"}, {"start": 444.06, "end": 446.06, "text": "我们非冻饿而死不可。"}, {"start": 446.06, "end": 448.06, "text": "灵心发现,"}, {"start": 448.06, "end": 450.06, "text": "要回去安葬武功及其家人。"}, {"start": 450.06, "end": 454.24, "text": "龚台兄,"}, {"start": 454.24, "end": 456.24, "text": "不必太动感情。"}, {"start": 456.24, "end": 458.24, "text": "我一定会帮你。"}, {"start": 458.24, "end": 460.24, "text": "龚台兄,不必太动感情。"}, {"start": 460.24, "end": 462.24, "text": "死者不可复生,"}, {"start": 462.24, "end": 464.24, "text": "而生者仍需肩负大业。"}, {"start": 464.24, "end": 466.24, "text": "妈已经把吃的喝的都准备好了。"}, {"start": 466.24, "end": 468.24, "text": "如果我们不回去,"}, {"start": 468.24, "end": 470.24, "text": "她不是白死了吗?"}, {"start": 470.24, "end": 472.24, "text": "走吧。"}, {"start": 472.24, "end": 485.92, "text": "伯父,"}, {"start": 485.92, "end": 489.55, "text": "不是阿满害了你,"}, {"start": 489.55, "end": 491.55, "text": "是这个乱世害了你。"}, {"start": 491.55, "end": 493.55, "text": "你的大恩大德,"}, {"start": 493.55, "end": 495.55, "text": "大仁大义,"}, {"start": 495.55, "end": 497.55, "text": "侄儿至死都不会忘。"}, {"start": 497.55, "end": 499.55, "text": "侄儿想念你,"}, {"start": 499.55, "end": 501.55, "text": "无辜痛哉,痛哉。"}, {"start": 506.56, "end": 511.86, "text": "有忌耻,"}, {"start": 511.86, "end": 513.86, "text": "有这道无耻的世界。"}, {"start": 513.86, "end": 515.86, "text": "伯父,"}, {"start": 517.65, "end": 519.65, "text": "曹操,"}, {"start": 519.65, "end": 521.65, "text": "定会为你老人家报仇雪恨。"}, {"start": 521.65, "end": 523.65, "text": "举一套贼,"}, {"start": 523.65, "end": 525.65, "text": "扩清天下。"}, {"start": 525.65, "end": 527.65, "text": "日后,"}, {"start": 527.65, "end": 529.65, "text": "曹操大业有成,"}, {"start": 529.65, "end": 531.65, "text": "定会,"}, {"start": 531.65, "end": 533.65, "text": "赐你丹书铁卷,"}, {"start": 533.65, "end": 535.65, "text": "还要册封你为公侯。"}, {"start": 535.65, "end": 537.65, "text": "让你老人家的在天之灵,"}, {"start": 537.65, "end": 539.65, "text": "永享万世香火。"}, {"start": 541.65, "end": 543.65, "text": "听你这话,"}, {"start": 543.65, "end": 549.1, "text": "不像是逃亡的罪徒,"}, {"start": 551.1, "end": 553.1, "text": "倒像是明天的帝王。"}, {"start": 553.1, "end": 555.1, "text": "龚太兄,"}, {"start": 555.1, "end": 558.8, "text": "人心叵测,"}, {"start": 558.8, "end": 560.8, "text": "世事难料。"}, {"start": 560.8, "end": 562.8, "text": "将来的事,"}, {"start": 562.8, "end": 564.8, "text": "谁说得定呢?"}, {"start": 564.8, "end": 581.3, "text": "铁壁。"}, {"start": 581.3, "end": 583.3, "text": "吃东西吧,"}, {"start": 583.3, "end": 588.46, "text": "我已经十几天都没有吃过肉了。"}, {"start": 588.46, "end": 590.46, "text": "你呢?"}, {"start": 590.46, "end": 604.94, "text": "想什么呢?"}, {"start": 604.94, "end": 608.99, "text": "我的那些个蛆蛆,"}, {"start": 608.99, "end": 612.37, "text": "个个儿。"}, {"start": 612.37, "end": 614.37, "text": "但是你却抛弃了他们,"}, {"start": 614.37, "end": 616.37, "text": "跟着我走了。"}, {"start": 616.37, "end": 618.37, "text": "这是为什么呢?"}, {"start": 618.37, "end": 620.37, "text": "是不是说明,"}, {"start": 620.37, "end": 622.37, "text": "我曹操比那些蛆蛆,"}, {"start": 622.37, "end": 624.37, "text": "强点儿啊?"}, {"start": 624.37, "end": 626.37, "text": "所以说,"}, {"start": 626.37, "end": 628.37, "text": "在乱世当中,"}, {"start": 628.37, "end": 630.37, "text": "只有强者,"}, {"start": 630.37, "end": 632.37, "text": "才配谈人意。"}, {"start": 632.37, "end": 634.37, "text": "弱者,"}, {"start": 634.37, "end": 637.9, "text": "只有配炮器。"}, {"start": 642.11, "end": 644.11, "text": "你是不是有点后悔啊,"}, {"start": 644.11, "end": 646.11, "text": "龚太兄?"}, {"start": 646.11, "end": 648.11, "text": "当初在中谋县的大牢里,"}, {"start": 648.11, "end": 650.11, "text": "应该一刀把我的脑袋砍下来,"}, {"start": 650.11, "end": 652.11, "text": "装到坛子里,"}, {"start": 652.11, "end": 654.11, "text": "送到京师,"}, {"start": 654.11, "end": 656.11, "text": "到董卓那儿去,"}, {"start": 656.11, "end": 660.1, "text": "换几个小巧合。"}, {"start": 660.1, "end": 664.4, "text": "是!"}, {"start": 664.4, "end": 666.4, "text": "因为你是英雄豪杰,"}, {"start": 666.4, "end": 668.4, "text": "一生忘死,"}, {"start": 668.4, "end": 670.4, "text": "抛家器官跟随于你。"}, {"start": 670.4, "end": 672.4, "text": "今天我真不知道,"}, {"start": 672.4, "end": 674.4, "text": "你是忠义之士,"}, {"start": 674.4, "end": 685.07, "text": "还是奸恶之徒。"}, {"start": 685.07, "end": 687.07, "text": "龚太兄,"}, {"start": 687.07, "end": 689.07, "text": "自古以来就是,"}, {"start": 689.07, "end": 691.07, "text": "大奸思中,"}, {"start": 691.07, "end": 693.07, "text": "大伪思真。"}, {"start": 693.07, "end": 695.07, "text": "忠义和奸恶,"}, {"start": 695.07, "end": 697.07, "text": "都不是从表面就能看得出来的。"}, {"start": 697.07, "end": 699.07, "text": "也许你昨天看错了我曹操,"}, {"start": 699.07, "end": 701.07, "text": "可是今天呢,"}, {"start": 701.07, "end": 703.07, "text": "你就看错了。"}, {"start": 703.07, "end": 705.07, "text": "不算是我,仍然是我。"}, {"start": 705.07, "end": 707.07, "text": "我从来都不怕别人看错我。"}, {"start": 718.94, "end": 720.94, "text": "行了,肉,吃吧。"}, {"start": 720.94, "end": 749.57, "text": "十几口无辜蓝,"}, {"start": 749.57, "end": 754.48, "text": "竟然能如此汗水。"}, {"start": 754.48, "end": 757.86, "text": "什么人呐,是人不是。"}, {"start": 757.86, "end": 761.49, "text": "宁肯我负天下人,"}, {"start": 761.49, "end": 763.49, "text": "休叫天下人负我。"}, {"start": 765.49, "end": 772.58, "text": "建峰,"}, {"start": 772.58, "end": 776.85, "text": "建峰之煞律师,"}, {"start": 776.85, "end": 778.85, "text": "却能禁住天下人心,"}, {"start": 778.85, "end": 784.56, "text": "更危险,更可怕。"}, {"start": 784.56, "end": 792.06, "text": "把他杀了,"}, {"start": 792.06, "end": 817.84, "text": "为天下人助。"}, {"start": 817.84, "end": 823.62, "text": "天救了他,杀了他。"}, {"start": 823.62, "end": 832.75, "text": "这样做好吗?我不能无情啊。"}, {"start": 832.75, "end": 890.3, "text": "要杀便杀嘛,"}, {"start": 890.3, "end": 892.3, "text": "何必犹豫呢?"}, {"start": 892.3, "end": 904.54, "text": "眼下已是数百年来,"}, {"start": 904.54, "end": 906.54, "text": "从未有过的大乱。"}, {"start": 906.54, "end": 908.54, "text": "金城中,"}, {"start": 908.54, "end": 910.54, "text": "董卓祸乱朝廷,"}, {"start": 910.54, "end": 912.54, "text": "屠戮中粮,"}, {"start": 912.54, "end": 914.54, "text": "擅行废礼,"}, {"start": 914.54, "end": 916.54, "text": "褻瀆朝纲。"}, {"start": 916.54, "end": 919.92, "text": "金城外,"}, {"start": 919.92, "end": 921.92, "text": "各路诸侯,刺史,"}, {"start": 921.92, "end": 923.92, "text": "将军,"}, {"start": 923.92, "end": 925.92, "text": "眼看着董卓,"}, {"start": 925.92, "end": 927.92, "text": "独霸京师,全倾天下,"}, {"start": 927.92, "end": 929.92, "text": "哪一个不是,"}, {"start": 929.92, "end": 931.92, "text": "又气,又怒,"}, {"start": 931.92, "end": 933.92, "text": "又嫉妒。"}, {"start": 933.92, "end": 935.92, "text": "而乱世,正是"}, {"start": 935.92, "end": 937.92, "text": "英雄辈出之时,"}, {"start": 937.92, "end": 939.92, "text": "所谓时势造英雄。"}, {"start": 941.92, "end": 943.92, "text": "尔,"}, {"start": 943.92, "end": 945.92, "text": "想举一起兵,成就一番大业。"}, {"start": 945.92, "end": 947.92, "text": "尔啊,"}, {"start": 947.92, "end": 949.92, "text": "董贼事大,"}, {"start": 949.92, "end": 951.92, "text": "只恐一时,"}, {"start": 951.92, "end": 953.92, "text": "难计为敌啊。"}, {"start": 953.92, "end": 955.92, "text": "尔在京城时曾经,"}, {"start": 955.92, "end": 957.92, "text": "屈身试于董贼,"}, {"start": 957.92, "end": 959.92, "text": "据我观察,"}, {"start": 959.92, "end": 961.92, "text": "董贼所倚仗的,"}, {"start": 961.92, "end": 963.92, "text": "就是一支西良军,"}, {"start": 963.92, "end": 965.92, "text": "而西良军"}, {"start": 965.92, "end": 967.92, "text": "虽然小勇,"}, {"start": 967.92, "end": 969.92, "text": "贼手董卓,"}, {"start": 969.92, "end": 971.92, "text": "却是并无远见与着实。"}, {"start": 971.92, "end": 973.92, "text": "此人,"}, {"start": 973.92, "end": 975.92, "text": "独霸洛阳,"}, {"start": 975.92, "end": 977.92, "text": "手握朝纲,"}, {"start": 977.92, "end": 979.92, "text": "却只懂得,"}, {"start": 979.92, "end": 981.92, "text": "奸淫烧杀掠夺,"}, {"start": 981.92, "end": 983.92, "text": "胸中并无大志。"}, {"start": 983.92, "end": 987.23, "text": "尔啊,"}, {"start": 987.23, "end": 989.23, "text": "我已把曹氏家产,"}, {"start": 989.23, "end": 991.23, "text": "全部变卖,"}, {"start": 991.23, "end": 993.23, "text": "得金两万五千。"}, {"start": 993.23, "end": 995.23, "text": "你可用他,"}, {"start": 995.23, "end": 997.23, "text": "招募兵用,"}, {"start": 997.23, "end": 999.23, "text": "打造战价齐藩。"}, {"start": 999.23, "end": 1001.23, "text": "不够,"}, {"start": 1001.23, "end": 1003.23, "text": "远远不够,"}, {"start": 1003.23, "end": 1005.23, "text": "成大事者,"}, {"start": 1005.23, "end": 1007.23, "text": "不可无欠,"}, {"start": 1007.23, "end": 1009.23, "text": "却又不完全在于欠。"}, {"start": 1009.23, "end": 1011.23, "text": "首先,"}, {"start": 1011.23, "end": 1013.23, "text": "是人,"}, {"start": 1013.23, "end": 1015.23, "text": "得以英雄豪杰,"}, {"start": 1015.23, "end": 1025.26, "text": "胜过十万金银。"}, {"start": 1025.26, "end": 1030.21, "text": "在下魏国人士热敬,"}, {"start": 1030.21, "end": 1032.21, "text": "自文谦,"}, {"start": 1032.21, "end": 1034.21, "text": "特来投拜曹操,"}, {"start": 1034.21, "end": 1036.21, "text": "共乡大义。"}, {"start": 1036.21, "end": 1038.21, "text": "在下俱路人士李典,"}, {"start": 1038.21, "end": 1040.21, "text": "自曼城,"}, {"start": 1040.21, "end": 1042.21, "text": "愿效于曹公,"}, {"start": 1042.21, "end": 1044.21, "text": "下侯元下侯敦兄弟,"}, {"start": 1044.21, "end": 1046.21, "text": "领壮士千语,"}, {"start": 1046.21, "end": 1048.21, "text": "特来投奔曹兄,共同逃贼。"}, {"start": 1048.21, "end": 1050.21, "text": "孟德能够得到"}, {"start": 1050.21, "end": 1052.21, "text": "列位壮士相助,"}, {"start": 1052.21, "end": 1054.21, "text": "实乃天意,"}, {"start": 1054.21, "end": 1056.21, "text": "大事必成。"}, {"start": 1056.21, "end": 1058.21, "text": "大伙快坐吧,"}, {"start": 1058.21, "end": 1060.21, "text": "咱们从长计议。"}, {"start": 1060.21, "end": 1062.21, "text": "大哥,大哥,"}, {"start": 1062.21, "end": 1064.21, "text": "大哥,"}, {"start": 1064.21, "end": 1066.21, "text": "袁绍派人送信来,"}, {"start": 1066.21, "end": 1068.21, "text": "说他已从渤海起兵,"}, {"start": 1068.21, "end": 1070.21, "text": "沿途邀集了十八阵诸侯,"}, {"start": 1070.21, "end": 1072.21, "text": "力请大哥前去入盟呢。"}, {"start": 1072.21, "end": 1089.44, "text": "中原十八阵诸侯"}, {"start": 1089.44, "end": 1091.44, "text": "都加盟义军了,"}, {"start": 1091.44, "end": 1093.44, "text": "仅此就占了大半个天下,"}, {"start": 1093.44, "end": 1095.44, "text": "我看,"}, {"start": 1095.44, "end": 1097.44, "text": "董卓河带的西凉军,"}, {"start": 1097.44, "end": 1099.44, "text": "岂不是谈之可蔑吗?"}, {"start": 1099.44, "end": 1101.44, "text": "大哥,赶紧动身吧,"}, {"start": 1101.44, "end": 1103.44, "text": "弟兄们与你同去。"}, {"start": 1103.44, "end": 1105.44, "text": "大哥,弟兄们与你同去。"}, {"start": 1105.44, "end": 1109.36, "text": "大伙想想,"}, {"start": 1109.36, "end": 1111.36, "text": "这十八阵诸侯,"}, {"start": 1111.36, "end": 1113.36, "text": "原本都是各地"}, {"start": 1113.36, "end": 1116.93, "text": "枭雄,"}, {"start": 1116.93, "end": 1118.93, "text": "一个手里没有几万兵马,"}, {"start": 1118.93, "end": 1122.3, "text": "一个手里没有几万兵马,"}, {"start": 1122.3, "end": 1124.3, "text": "我们就凭着这点家族子弟,"}, {"start": 1124.3, "end": 1126.3, "text": "我们就凭着这点家族子弟,"}, {"start": 1126.3, "end": 1128.3, "text": "怎么可能在盟军中"}, {"start": 1128.3, "end": 1130.3, "text": "占有一席之地?"}, {"start": 1130.3, "end": 1132.3, "text": "但是如果没有一席之地,"}, {"start": 1132.3, "end": 1134.3, "text": "但是如果没有一席之地,"}, {"start": 1134.3, "end": 1136.3, "text": "就算你打败了董卓,"}, {"start": 1136.3, "end": 1138.3, "text": "就算你打败了董卓,"}, {"start": 1138.3, "end": 1141.9, "text": "我们又能得到什么呢?"}, {"start": 1141.9, "end": 1143.9, "text": "这些诸侯原本就是要"}, {"start": 1143.9, "end": 1145.9, "text": "争官,争享,"}, {"start": 1145.9, "end": 1147.9, "text": "争城池,"}, {"start": 1147.9, "end": 1149.9, "text": "谁会把我们放在眼里?"}, {"start": 1149.9, "end": 1153.79, "text": "大哥,真是有远见啊,"}, {"start": 1153.79, "end": 1155.79, "text": "董贼还没有灭掉,"}, {"start": 1155.79, "end": 1157.79, "text": "你就已经看到攻城之后的事了。"}, {"start": 1157.79, "end": 1159.79, "text": "你就已经看到攻城之后的事了。"}, {"start": 1159.79, "end": 1161.79, "text": "智者律远,"}, {"start": 1161.79, "end": 1163.79, "text": "健威之助。"}, {"start": 1163.79, "end": 1165.79, "text": "那你说怎么办?"}, {"start": 1165.79, "end": 1167.79, "text": "难道我们不去入盟了吗?"}, {"start": 1167.79, "end": 1171.58, "text": "当然要入。"}, {"start": 1171.58, "end": 1173.58, "text": "因为我,已经给十八路诸侯准备了一份大礼。"}, {"start": 1173.58, "end": 1175.58, "text": "因为我,已经给十八路诸侯准备了一份大礼。"}, {"start": 1175.58, "end": 1177.58, "text": "而这,"}, {"start": 1177.58, "end": 1179.58, "text": "恰恰是十八路诸侯"}, {"start": 1179.58, "end": 1181.58, "text": "最要紧之物。"}, {"start": 1181.58, "end": 1183.58, "text": "它的价值,"}, {"start": 1183.58, "end": 1185.58, "text": "甚过十万雄兵。"}, {"start": 1185.58, "end": 1187.58, "text": "大哥,什么礼物啊?"}, {"start": 1187.58, "end": 1193.23, "text": "天子诏书。"}, {"start": 1193.23, "end": 1196.99, "text": "大家想想,十八路诸侯,"}, {"start": 1196.99, "end": 1200.27, "text": "什么都有了。"}, {"start": 1200.27, "end": 1202.27, "text": "兵马,粮草,"}, {"start": 1202.27, "end": 1204.27, "text": "军械。"}, {"start": 1204.27, "end": 1206.27, "text": "唯独缺少了"}, {"start": 1206.27, "end": 1208.27, "text": "逃贼所必需的"}, {"start": 1208.27, "end": 1210.27, "text": "天子诏。"}, {"start": 1210.27, "end": 1212.27, "text": "无此,"}, {"start": 1212.27, "end": 1214.27, "text": "他们凭什么举一逃贼?"}, {"start": 1214.27, "end": 1216.27, "text": "凭什么号令天下?"}, {"start": 1216.27, "end": 1218.27, "text": "他们岂非,明不正,"}, {"start": 1218.27, "end": 1220.27, "text": "言不顺了吗?"}, {"start": 1220.27, "end": 1222.27, "text": "而我,刚刚"}, {"start": 1222.27, "end": 1224.27, "text": "从京师出来,"}, {"start": 1224.27, "end": 1226.27, "text": "只有我,能够挟出天子"}, {"start": 1226.27, "end": 1228.27, "text": "谜诏。"}, {"start": 1228.27, "end": 1230.27, "text": "也就是说,"}, {"start": 1230.27, "end": 1232.27, "text": "只有,"}, {"start": 1232.27, "end": 1234.27, "text": "有了我曹操,"}, {"start": 1234.27, "end": 1236.27, "text": "十八镇诸侯才算是"}, {"start": 1236.27, "end": 1238.27, "text": "明镇,言顺。"}, {"start": 1238.27, "end": 1240.27, "text": "盟军,才算是"}, {"start": 1240.27, "end": 1242.27, "text": "奉天举一。"}, {"start": 1242.27, "end": 1244.27, "text": "大哥,天子"}, {"start": 1244.27, "end": 1246.27, "text": "真的授予你,逃贼诏书了吗?"}, {"start": 1246.27, "end": 1248.27, "text": "当然没有。"}, {"start": 1250.27, "end": 1252.27, "text": "不过,"}, {"start": 1252.27, "end": 1254.27, "text": "我可以替天子你一道诏书。"}, {"start": 1254.27, "end": 1256.27, "text": "狡诏啊?"}, {"start": 1256.27, "end": 1258.27, "text": "狡诏?"}, {"start": 1258.27, "end": 1261.71, "text": "对,假的。"}, {"start": 1261.71, "end": 1263.71, "text": "假的,"}, {"start": 1263.71, "end": 1265.71, "text": "有时候比真的"}, {"start": 1265.71, "end": 1267.71, "text": "还管用。"}, {"start": 1267.71, "end": 1342.54, "text": "孙监!"}, {"start": 1342.54, "end": 1344.54, "text": "长沙孙监,拜见员工!"}, {"start": 1344.54, "end": 1346.54, "text": "请!"}, {"start": 1346.54, "end": 1348.54, "text": "北平公孙瓒,拜见员工!"}, {"start": 1348.54, "end": 1350.54, "text": "快请,快请。"}, {"start": 1350.54, "end": 1378.78, "text": "二弟三弟,"}, {"start": 1378.78, "end": 1383.38, "text": "那就是沉流城。"}, {"start": 1383.38, "end": 1385.38, "text": "袁绍正在汇集各路诸侯。"}, {"start": 1385.38, "end": 1389.23, "text": "我们这就去入盟吧。"}, {"start": 1389.23, "end": 1391.23, "text": "去是去,但有一条,"}, {"start": 1391.23, "end": 1393.23, "text": "大哥非议我不可。"}, {"start": 1393.23, "end": 1395.23, "text": "三弟说。"}, {"start": 1395.23, "end": 1397.23, "text": "既然是去入盟,"}, {"start": 1397.23, "end": 1399.23, "text": "那大哥就得做盟主。"}, {"start": 1399.23, "end": 1401.23, "text": "要不,咱不入这破盟。"}, {"start": 1401.23, "end": 1403.23, "text": "三弟,你有所不知,"}, {"start": 1403.23, "end": 1405.23, "text": "袁绍四市三宫,"}, {"start": 1405.23, "end": 1407.23, "text": "名动天下。"}, {"start": 1407.23, "end": 1409.23, "text": "他所召集的十八镇诸侯,"}, {"start": 1409.23, "end": 1411.23, "text": "个个都是刺史俊手之类的人物。"}, {"start": 1411.23, "end": 1413.23, "text": "任谁都比你哥哥的名头大。"}, {"start": 1413.23, "end": 1415.23, "text": "咱不管这个。"}, {"start": 1415.23, "end": 1417.23, "text": "咱只要问问,"}, {"start": 1417.23, "end": 1419.23, "text": "在这些诸侯当中,"}, {"start": 1419.23, "end": 1421.23, "text": "可有像哥哥这样的汉皇后裔吗?"}, {"start": 1423.23, "end": 1425.23, "text": "只怕没有。"}, {"start": 1425.23, "end": 1427.23, "text": "可有像哥哥这样的仁义君子吗?"}, {"start": 1427.23, "end": 1429.23, "text": "只怕"}, {"start": 1429.23, "end": 1431.23, "text": "也没有。"}, {"start": 1431.23, "end": 1433.23, "text": "大哥不做盟主,"}, {"start": 1433.23, "end": 1435.23, "text": "谁做呀?"}, {"start": 1435.23, "end": 1437.23, "text": "难道叫我张飞做吗?"}, {"start": 1437.23, "end": 1439.23, "text": "我最怕这啰嗦事了。"}, {"start": 1439.23, "end": 1441.23, "text": "所以,进城之后,"}, {"start": 1441.23, "end": 1443.23, "text": "盟主是我大哥的,"}, {"start": 1443.23, "end": 1445.23, "text": "副盟主"}, {"start": 1445.23, "end": 1447.23, "text": "是二哥的。"}, {"start": 1447.23, "end": 1449.23, "text": "但张飞嘛,"}, {"start": 1449.23, "end": 1451.23, "text": "就做个先锋将军。"}, {"start": 1451.23, "end": 1453.23, "text": "好了,三弟,不客胡言,"}, {"start": 1453.23, "end": 1455.23, "text": "快快进城吧。"}, {"start": 1455.23, "end": 1457.23, "text": "三弟,咱哥制大,"}, {"start": 1457.23, "end": 1459.23, "text": "岂在一时啊。"}, {"start": 1459.23, "end": 1461.23, "text": "快快进城吧。"}, {"start": 1461.23, "end": 1463.23, "text": "各路英雄,既然已经到了城里,"}, {"start": 1463.23, "end": 1465.23, "text": "咱们也好,早早地会会他们。"}, {"start": 1465.23, "end": 1474.05, "text": "走!"}, {"start": 1474.05, "end": 1476.05, "text": "此次会盟聚义,"}, {"start": 1476.05, "end": 1478.05, "text": "我们是为了剿灭董贼,"}, {"start": 1478.05, "end": 1480.05, "text": "振兴汉市,"}, {"start": 1480.05, "end": 1482.05, "text": "并不是为了加官进爵,"}, {"start": 1482.05, "end": 1484.05, "text": "贪图高官后路。"}, {"start": 1484.05, "end": 1486.05, "text": "知道了大哥,"}, {"start": 1486.05, "end": 1494.77, "text": "走,进城!"}, {"start": 1494.77, "end": 1496.77, "text": "袁绍,"}, {"start": 1496.77, "end": 1498.77, "text": "非常感谢,"}, {"start": 1498.77, "end": 1500.77, "text": "各位将军前来会盟,"}, {"start": 1500.77, "end": 1506.29, "text": "今日之会,"}, {"start": 1506.29, "end": 1508.29, "text": "真乃我大汉王朝的"}, {"start": 1508.29, "end": 1510.29, "text": "中兴之兆,"}, {"start": 1510.29, "end": 1512.29, "text": "空前之盛事啊。"}, {"start": 1512.29, "end": 1514.29, "text": "就是洛阳朝廷,"}, {"start": 1514.29, "end": 1516.29, "text": "又何曾聚过这么多英雄豪杰啊?"}, {"start": 1516.29, "end": 1518.29, "text": "东贼要是知道我等在此聚义,"}, {"start": 1518.29, "end": 1520.29, "text": "肯定会闻风丧胆。"}, {"start": 1520.29, "end": 1522.29, "text": "我等兵风所向,"}, {"start": 1522.29, "end": 1524.29, "text": "破洛阳驱董卓首级,"}, {"start": 1524.29, "end": 1526.29, "text": "阵入探当群伍啊。"}, {"start": 1528.29, "end": 1530.29, "text": "十怕阵诸侯望这一战,"}, {"start": 1530.29, "end": 1532.29, "text": "这大半个江山,"}, {"start": 1532.29, "end": 1534.29, "text": "就在我们的脚底下了。"}, {"start": 1534.29, "end": 1536.29, "text": "剩下那一小片江山,"}, {"start": 1536.29, "end": 1538.29, "text": "也是弹指可取。"}, {"start": 1538.29, "end": 1540.29, "text": "各位将军,"}, {"start": 1540.29, "end": 1542.29, "text": "此时此刻,"}, {"start": 1542.29, "end": 1544.29, "text": "我各路人马相驾,"}, {"start": 1544.29, "end": 1546.29, "text": "步军四十五万,"}, {"start": 1546.29, "end": 1548.29, "text": "其余兵九万。"}, {"start": 1548.29, "end": 1550.29, "text": "这匹董卓的西凉军,"}, {"start": 1550.29, "end": 1552.29, "text": "还督出两倍有余,"}, {"start": 1552.29, "end": 1554.29, "text": "如此强大的军力,"}, {"start": 1554.29, "end": 1556.29, "text": "何愁贼寇不灭。"}, {"start": 1556.29, "end": 1558.29, "text": "这一战,"}, {"start": 1558.29, "end": 1560.29, "text": "袁弓,"}, {"start": 1560.29, "end": 1562.29, "text": "各位将军,"}, {"start": 1562.29, "end": 1564.29, "text": "在下有一言,"}, {"start": 1564.29, "end": 1566.29, "text": "我等既然是聚义会盟,"}, {"start": 1566.29, "end": 1575.04, "text": "必须先立一位得高望重之士为盟主,"}, {"start": 1575.04, "end": 1577.04, "text": "统一号令,"}, {"start": 1577.04, "end": 1580.48, "text": "方可进军剿贼。"}, {"start": 1580.48, "end": 1582.48, "text": "我们都应该遵从盟主号令。"}, {"start": 1582.48, "end": 1584.48, "text": "原本初,"}, {"start": 1584.48, "end": 1586.48, "text": "四十三公兵,"}, {"start": 1586.48, "end": 1588.48, "text": "三十四公兵,"}, {"start": 1588.48, "end": 1590.48, "text": "三十四公兵,"}, {"start": 1590.48, "end": 1592.48, "text": "三十四公兵,"}, {"start": 1592.48, "end": 1594.48, "text": "三十四公兵,"}, {"start": 1594.48, "end": 1596.48, "text": "这是一 Belly Steel答案。"}, {"start": 1596.48, "end": 1598.48, "text": "此事三公,"}, {"start": 1598.48, "end": 1600.48, "text": "焊想后亦,"}, {"start": 1600.48, "end": 1602.48, "text": "门生故力遍天下,"}, {"start": 1602.48, "end": 1604.48, "text": "贤德之声,"}, {"start": 1604.48, "end": 1607.98, "text": "远波四海。"}, {"start": 1607.98, "end": 1609.98, "text": "在下的意思,"}, {"start": 1609.98, "end": 1611.98, "text": "请袁弓丹当义军盟主,"}, {"start": 1611.98, "end": 1613.98, "text": "我等遵奉号令,"}, {"start": 1613.98, "end": 1615.98, "text": "共同逃贼。"}, {"start": 1615.98, "end": 1617.98, "text": "这,非本初不可。"}, {"start": 1617.98, "end": 1619.98, "text": "非本初不可呀!"}, {"start": 1619.98, "end": 1633.66, "text": "非本初不可呀!"}, {"start": 1633.66, "end": 1635.66, "text": "这既然诸公有令,"}, {"start": 1635.66, "end": 1636.66, "text": "袁某"}, {"start": 1636.66, "end": 1637.66, "text": "只好奉命了"}, {"start": 1642.25, "end": 1647.02, "text": "站住"}, {"start": 1647.02, "end": 1648.02, "text": "儿等何人"}, {"start": 1648.02, "end": 1649.02, "text": "小子"}, {"start": 1649.02, "end": 1651.02, "text": "快去叫袁绍出来接驾"}, {"start": 1651.02, "end": 1652.02, "text": "我大哥前来会盟了"}, {"start": 1652.02, "end": 1653.02, "text": "你"}, {"start": 1653.02, "end": 1654.02, "text": "三弟"}, {"start": 1654.02, "end": 1659.06, "text": "休得无礼"}, {"start": 1659.06, "end": 1660.06, "text": "这位弟兄"}, {"start": 1660.06, "end": 1661.06, "text": "请通禀一声"}, {"start": 1661.06, "end": 1662.06, "text": "就说平原"}, {"start": 1662.06, "end": 1664.06, "text": "刘备 关羽 张飞"}, {"start": 1664.06, "end": 1665.06, "text": "前来会盟"}, {"start": 1666.06, "end": 1667.06, "text": "刘什么"}, {"start": 1667.06, "end": 1668.06, "text": "关什么"}, {"start": 1669.06, "end": 1670.06, "text": "没听说过"}, {"start": 1670.06, "end": 1672.06, "text": "袁将军请你们了吗"}, {"start": 1672.06, "end": 1676.86, "text": "天下兴亡"}, {"start": 1676.86, "end": 1677.86, "text": "匹夫有责"}, {"start": 1677.86, "end": 1678.86, "text": "何必要请"}, {"start": 1678.86, "end": 1679.86, "text": "既然没请"}, {"start": 1679.86, "end": 1680.86, "text": "就快快离去"}, {"start": 1681.86, "end": 1683.86, "text": "城关内都是群英聚一"}, {"start": 1683.86, "end": 1684.86, "text": "没你们可作息"}, {"start": 1687.86, "end": 1688.86, "text": "走吧 走吧"}, {"start": 1688.86, "end": 1689.86, "text": "赶紧走"}, {"start": 1696.06, "end": 1697.06, "text": "给我拿下"}, {"start": 1697.06, "end": 1698.06, "text": "拿下"}, {"start": 1698.06, "end": 1699.06, "text": "敢打我"}, {"start": 1699.06, "end": 1700.06, "text": "拿下"}, {"start": 1700.06, "end": 1701.06, "text": "拿下"}, {"start": 1701.06, "end": 1702.06, "text": "拿下"}, {"start": 1708.88, "end": 1709.88, "text": "想当初我赴"}, {"start": 1709.88, "end": 1711.88, "text": "王司徒寿宴的时候"}, {"start": 1711.88, "end": 1713.88, "text": "也是因为名位太低"}, {"start": 1713.88, "end": 1715.88, "text": "而被拒之门外"}, {"start": 1715.88, "end": 1717.88, "text": "想不到今天这三位壮士"}, {"start": 1717.88, "end": 1719.88, "text": "和我同死遭遇"}, {"start": 1721.88, "end": 1722.88, "text": "在下刘备"}, {"start": 1722.88, "end": 1723.88, "text": "有礼"}, {"start": 1724.88, "end": 1725.88, "text": "敢问足下是"}, {"start": 1726.88, "end": 1727.88, "text": "萧綦校尉"}, {"start": 1727.88, "end": 1728.88, "text": "曹操"}, {"start": 1728.88, "end": 1732.9, "text": "你就是次董的曹孟德"}, {"start": 1732.9, "end": 1734.9, "text": "曹某未曾见过"}, {"start": 1735.9, "end": 1737.9, "text": "孟德兄次贼一举"}, {"start": 1737.9, "end": 1738.9, "text": "已经名扬海内"}, {"start": 1738.9, "end": 1740.9, "text": "刘备深感敬佩"}, {"start": 1742.9, "end": 1743.9, "text": "这位将军"}, {"start": 1743.9, "end": 1744.9, "text": "你既没听过"}, {"start": 1744.9, "end": 1745.9, "text": "这三位壮士的大名"}, {"start": 1745.9, "end": 1747.9, "text": "那你听说过我曹操吗"}, {"start": 1747.9, "end": 1749.9, "text": "曹公大名 如雷贯耳"}, {"start": 1749.9, "end": 1751.9, "text": "在我次董之前"}, {"start": 1751.9, "end": 1752.9, "text": "和他们一样"}, {"start": 1752.9, "end": 1753.9, "text": "也是无名之辈"}, {"start": 1754.9, "end": 1755.9, "text": "你又怎么知道"}, {"start": 1755.9, "end": 1757.9, "text": "今天的无名之辈"}, {"start": 1757.9, "end": 1759.9, "text": "来日会不会明镇天下"}, {"start": 1760.9, "end": 1761.9, "text": "假如有一天"}, {"start": 1762.9, "end": 1764.9, "text": "他们真的明镇天下了"}, {"start": 1764.9, "end": 1765.9, "text": "你又会不会"}, {"start": 1765.9, "end": 1766.9, "text": "为今天的所作所为"}, {"start": 1766.9, "end": 1768.9, "text": "追悔国旗呢"}, {"start": 1769.9, "end": 1770.9, "text": "曹公说的是"}, {"start": 1770.9, "end": 1771.9, "text": "曹公说的是"}, {"start": 1771.9, "end": 1773.9, "text": "三位 随我入关吧"}, {"start": 1773.9, "end": 1774.9, "text": "多谢曹将军"}, {"start": 1774.9, "end": 1776.9, "text": "三位英雄 起"}, {"start": 1778.9, "end": 1790.95, "text": "孟德 你终于来了"}, {"start": 1790.95, "end": 1792.95, "text": "我等可都是望眼欲穿了"}, {"start": 1792.95, "end": 1794.95, "text": "曹孟德之身次董"}, {"start": 1794.95, "end": 1795.95, "text": "名扬海内"}, {"start": 1795.95, "end": 1796.95, "text": "兄弟见礼了"}, {"start": 1796.95, "end": 1797.95, "text": "孟德"}, {"start": 1797.95, "end": 1798.95, "text": "中原八百里"}, {"start": 1798.95, "end": 1800.95, "text": "都贴满了拿你的告示"}, {"start": 1800.95, "end": 1801.95, "text": "正可谓是"}, {"start": 1801.95, "end": 1803.95, "text": "天下何人不识君哪"}, {"start": 1806.95, "end": 1807.95, "text": "本初兄"}, {"start": 1807.95, "end": 1808.95, "text": "龚禄兄"}, {"start": 1809.95, "end": 1810.95, "text": "孙文泰将军"}, {"start": 1811.95, "end": 1812.95, "text": "龔孙将军"}, {"start": 1813.95, "end": 1814.95, "text": "马腾将军"}, {"start": 1814.95, "end": 1818.65, "text": "操某见礼了"}, {"start": 1818.65, "end": 1819.65, "text": "好"}, {"start": 1819.65, "end": 1824.08, "text": "那位将军请坐"}, {"start": 1824.08, "end": 1827.83, "text": "孟德"}, {"start": 1827.83, "end": 1828.83, "text": "请坐"}, {"start": 1828.83, "end": 1829.83, "text": "请"}, {"start": 1829.83, "end": 1830.83, "text": "请"}, {"start": 1830.83, "end": 1831.83, "text": "你们没有看见"}, {"start": 1831.83, "end": 1832.83, "text": "我哥哥在这里吗"}, {"start": 1832.83, "end": 1841.49, "text": "三弟 不可无礼"}, {"start": 1841.49, "end": 1842.49, "text": "孟德"}, {"start": 1842.49, "end": 1849.58, "text": "这三位壮士"}, {"start": 1849.58, "end": 1851.58, "text": "是你的人吗"}, {"start": 1851.58, "end": 1852.58, "text": "倒也不是"}, {"start": 1852.58, "end": 1854.58, "text": "我们三位将军"}, {"start": 1854.58, "end": 1855.58, "text": "倒也不是"}, {"start": 1855.58, "end": 1857.58, "text": "我是在关前与他们相遇"}, {"start": 1857.58, "end": 1860.58, "text": "当时守将正在"}, {"start": 1860.58, "end": 1861.58, "text": "为难他们"}, {"start": 1861.58, "end": 1863.58, "text": "我顺便就把他们"}, {"start": 1863.58, "end": 1864.58, "text": "带进来了"}, {"start": 1864.58, "end": 1865.58, "text": "都是陌路英雄"}, {"start": 1867.58, "end": 1871.26, "text": "来 三位"}, {"start": 1871.26, "end": 1873.26, "text": "我给你们引荐一下"}, {"start": 1873.26, "end": 1877.05, "text": "这位"}, {"start": 1877.05, "end": 1878.05, "text": "就是咱们"}, {"start": 1878.05, "end": 1880.05, "text": "十八路盟军的盟主"}, {"start": 1880.05, "end": 1881.05, "text": "袁绍"}, {"start": 1881.05, "end": 1882.05, "text": "袁本初将军"}, {"start": 1883.05, "end": 1895.5, "text": "这位是"}, {"start": 1896.5, "end": 1897.5, "text": "对不住"}, {"start": 1897.5, "end": 1898.5, "text": "我实在是"}, {"start": 1898.5, "end": 1899.5, "text": "记不住你的名字吧"}, {"start": 1899.5, "end": 1902.58, "text": "禀袁盟主"}, {"start": 1902.58, "end": 1904.58, "text": "在下刘备 自玄德"}, {"start": 1904.58, "end": 1906.58, "text": "这位是我二弟关羽"}, {"start": 1906.58, "end": 1907.58, "text": "自云长"}, {"start": 1907.58, "end": 1909.58, "text": "这位是我三弟张飞"}, {"start": 1909.58, "end": 1910.58, "text": "自易德"}, {"start": 1914.46, "end": 1915.46, "text": "请问"}, {"start": 1915.46, "end": 1917.46, "text": "足下是何出身"}, {"start": 1917.46, "end": 1922.44, "text": "我是汉室宗亲"}, {"start": 1922.44, "end": 1923.44, "text": "景帝之子"}, {"start": 1923.44, "end": 1925.44, "text": "中山晋王刘胜之后"}, {"start": 1925.44, "end": 1926.44, "text": "什么"}, {"start": 1931.44, "end": 1932.44, "text": "请问"}, {"start": 1933.44, "end": 1935.44, "text": "足下从何而来"}, {"start": 1935.44, "end": 1937.44, "text": "现居和官爵"}, {"start": 1938.44, "end": 1940.44, "text": "又以何事为业"}, {"start": 1941.44, "end": 1942.44, "text": "刘备事局相里"}, {"start": 1942.44, "end": 1943.44, "text": "并无爵位"}, {"start": 1944.44, "end": 1946.44, "text": "以知席范履为业"}, {"start": 1946.44, "end": 1947.44, "text": "二弟关羽"}, {"start": 1947.44, "end": 1949.44, "text": "河北谢梁人士"}, {"start": 1949.44, "end": 1951.44, "text": "以守门护院为业"}, {"start": 1952.44, "end": 1953.44, "text": "三弟张飞"}, {"start": 1953.44, "end": 1955.44, "text": "河北卓州人士"}, {"start": 1955.44, "end": 1957.44, "text": "以卖酒屠猪为业"}, {"start": 1958.44, "end": 1959.44, "text": "一个知席范履"}, {"start": 1959.44, "end": 1961.44, "text": "一个看门护院"}, {"start": 1961.44, "end": 1962.44, "text": "还有一个"}, {"start": 1962.44, "end": 1963.44, "text": "屠猪卖酒的"}, {"start": 1963.44, "end": 1964.44, "text": "可笑三个莽夫"}, {"start": 1964.44, "end": 1966.44, "text": "竟然在此大言不惭"}, {"start": 1970.44, "end": 1971.44, "text": "我以为"}, {"start": 1972.44, "end": 1974.82, "text": "一个堂堂"}, {"start": 1975.82, "end": 1976.82, "text": "帝王之后"}, {"start": 1977.82, "end": 1978.82, "text": "能在大庭广众之下"}, {"start": 1979.82, "end": 1980.82, "text": "天下英雄面前"}, {"start": 1981.82, "end": 1983.82, "text": "将知席范履"}, {"start": 1984.82, "end": 1985.82, "text": "卖酒屠猪"}, {"start": 1985.82, "end": 1987.82, "text": "说得如此态然"}, {"start": 1988.82, "end": 1989.82, "text": "可见此人"}, {"start": 1989.82, "end": 1990.82, "text": "心胸不凡"}, {"start": 1991.82, "end": 1992.82, "text": "说得是"}, {"start": 1992.82, "end": 1993.82, "text": "龙德说得是"}, {"start": 1994.82, "end": 1995.82, "text": "柳辈"}, {"start": 1996.82, "end": 1998.82, "text": "你此行来有何目的"}, {"start": 1999.82, "end": 2003.7, "text": "闻原本初传书海内"}, {"start": 2003.7, "end": 2004.7, "text": "拒议讨贼"}, {"start": 2004.7, "end": 2006.7, "text": "在下是来会盟的"}, {"start": 2008.7, "end": 2009.7, "text": "你有多少人马"}, {"start": 2010.7, "end": 2011.7, "text": "连我在内"}, {"start": 2011.7, "end": 2012.7, "text": "三人三计"}, {"start": 2013.7, "end": 2014.7, "text": "二弟关羽"}, {"start": 2014.7, "end": 2015.7, "text": "为马攻守"}, {"start": 2015.7, "end": 2016.7, "text": "三弟张飞"}, {"start": 2016.7, "end": 2017.7, "text": "为部攻守"}, {"start": 2018.7, "end": 2019.7, "text": "我兄弟三人"}, {"start": 2019.7, "end": 2020.7, "text": "一同生死"}, {"start": 2020.7, "end": 2021.7, "text": "荣辱与共"}, {"start": 2021.7, "end": 2022.7, "text": "我十八战诸侯"}, {"start": 2022.7, "end": 2023.7, "text": "引兵最少的也有一万五千"}, {"start": 2024.7, "end": 2025.7, "text": "你们区区三人"}, {"start": 2026.7, "end": 2027.7, "text": "也好意思与我们会盟"}, {"start": 2029.7, "end": 2030.7, "text": "旧国兴盟"}, {"start": 2031.7, "end": 2032.7, "text": "忠义为先"}, {"start": 2033.7, "end": 2034.7, "text": "岂在人多"}, {"start": 2035.7, "end": 2037.7, "text": "既然是皇族后裔"}, {"start": 2038.7, "end": 2039.7, "text": "那就看座吧"}, {"start": 2039.7, "end": 2040.7, "text": "谢座"}, {"start": 2040.7, "end": 2041.7, "text": "员工"}, {"start": 2044.3, "end": 2060.82, "text": "诸位"}, {"start": 2060.82, "end": 2061.82, "text": "我们虽然已经"}, {"start": 2061.82, "end": 2062.82, "text": "起义讨贼了"}, {"start": 2063.82, "end": 2064.82, "text": "但是我们师出无名"}, {"start": 2065.82, "end": 2066.82, "text": "为什么呢"}, {"start": 2066.82, "end": 2068.82, "text": "因为我们缺一道天子诏"}, {"start": 2069.82, "end": 2071.82, "text": "如果我们没有天子诏"}, {"start": 2072.82, "end": 2073.82, "text": "我们不就成了"}, {"start": 2073.82, "end": 2074.82, "text": "乱兵了吗"}, {"start": 2075.82, "end": 2077.82, "text": "我们不就跟董卓一样"}, {"start": 2077.82, "end": 2078.82, "text": "无道了吗"}, {"start": 2078.82, "end": 2081.82, "text": "可天子却掌控在"}, {"start": 2081.82, "end": 2084.39, "text": "董贼的手中"}, {"start": 2085.39, "end": 2087.39, "text": "无法给我们此诏啊"}, {"start": 2088.39, "end": 2090.39, "text": "我出洛阳之前"}, {"start": 2090.39, "end": 2092.39, "text": "天子亲手授予我"}, {"start": 2092.39, "end": 2093.39, "text": "一道密诏"}, {"start": 2094.39, "end": 2095.39, "text": "诏天子"}, {"start": 2095.39, "end": 2097.39, "text": "亲手授予我一道密诏"}, {"start": 2101.37, "end": 2103.37, "text": "诏天下英雄入金秦王"}, {"start": 2104.37, "end": 2105.37, "text": "除贼复国"}, {"start": 2110.02, "end": 2111.02, "text": "十八镇铸侯"}, {"start": 2112.02, "end": 2127.86, "text": "结诏"}, {"start": 2127.86, "end": 2128.86, "text": "贼臣董卓"}, {"start": 2129.86, "end": 2130.86, "text": "篡夺朝纲"}, {"start": 2131.86, "end": 2132.86, "text": "贿乱宫廷"}, {"start": 2133.86, "end": 2134.86, "text": "残害生灵"}, {"start": 2134.86, "end": 2135.86, "text": "祸国士君"}, {"start": 2136.86, "end": 2137.86, "text": "朕"}, {"start": 2137.86, "end": 2138.86, "text": "弃学守诏"}, {"start": 2138.86, "end": 2139.86, "text": "诏天下英雄"}, {"start": 2140.86, "end": 2142.86, "text": "率义军入金秦王"}, {"start": 2142.86, "end": 2143.86, "text": "扩清环语"}, {"start": 2144.86, "end": 2145.86, "text": "扫平奸贼"}, {"start": 2145.86, "end": 2146.86, "text": "忠心大汉"}, {"start": 2148.86, "end": 2150.86, "text": "这诏有些不对啊"}, {"start": 2152.86, "end": 2153.86, "text": "哪儿不对"}, {"start": 2153.86, "end": 2154.86, "text": "天子年幼"}, {"start": 2156.86, "end": 2158.86, "text": "且又被董卓拘于深宫"}, {"start": 2160.86, "end": 2162.86, "text": "再说他也没见过臣下"}, {"start": 2162.86, "end": 2164.86, "text": "怎么会把此诏传给你呢"}, {"start": 2165.86, "end": 2167.86, "text": "公路将军说得对"}, {"start": 2168.86, "end": 2171.86, "text": "天子年方九岁"}, {"start": 2172.86, "end": 2174.86, "text": "怎么能写出如此雄壮的诏书"}, {"start": 2176.86, "end": 2177.86, "text": "这诏书"}, {"start": 2178.86, "end": 2179.86, "text": "乃是我草草"}, {"start": 2180.86, "end": 2181.86, "text": "替天子拟的"}, {"start": 2184.86, "end": 2185.86, "text": "原来是讲道啊"}, {"start": 2187.86, "end": 2188.86, "text": "请问公路将军"}, {"start": 2189.86, "end": 2190.86, "text": "既然那董卓"}, {"start": 2191.86, "end": 2193.86, "text": "能把天子拘于深宫之中"}, {"start": 2193.86, "end": 2194.86, "text": "视如掌上玩物"}, {"start": 2195.86, "end": 2196.86, "text": "我等"}, {"start": 2197.86, "end": 2198.86, "text": "为什么就不能"}, {"start": 2199.86, "end": 2200.86, "text": "视他如草祭"}, {"start": 2201.86, "end": 2202.86, "text": "拿他来为我们所用呢"}, {"start": 2203.86, "end": 2204.86, "text": "再说"}, {"start": 2205.86, "end": 2206.86, "text": "草某手中的诏书"}, {"start": 2207.86, "end": 2208.86, "text": "哪一句"}, {"start": 2208.86, "end": 2210.86, "text": "不是天子想说而不敢说的话"}, {"start": 2211.86, "end": 2212.86, "text": "此诏虽假"}, {"start": 2213.86, "end": 2214.86, "text": "却比真的"}, {"start": 2214.86, "end": 2215.86, "text": "更真"}, {"start": 2216.86, "end": 2217.86, "text": "我料定"}, {"start": 2217.86, "end": 2219.86, "text": "此诏一旦颁布天下"}, {"start": 2220.86, "end": 2222.86, "text": "定然是群贼胆丧"}, {"start": 2222.86, "end": 2223.86, "text": "群雄奋起"}, {"start": 2224.86, "end": 2225.86, "text": "是啊"}, {"start": 2225.86, "end": 2226.86, "text": "说得是啊"}, {"start": 2229.86, "end": 2230.86, "text": "好啊"}, {"start": 2230.86, "end": 2231.86, "text": "好啊"}, {"start": 2232.86, "end": 2233.86, "text": "人言"}, {"start": 2233.86, "end": 2234.86, "text": "曹孟德乃"}, {"start": 2234.86, "end": 2236.86, "text": "治世之能臣"}, {"start": 2237.86, "end": 2239.86, "text": "乱世之奸雄"}, {"start": 2240.86, "end": 2241.86, "text": "今日一见"}, {"start": 2243.86, "end": 2244.86, "text": "果然如此啊"}, {"start": 2247.86, "end": 2249.86, "text": "多谢公路将军夸奖我"}, {"start": 2250.86, "end": 2251.86, "text": "我不但"}, {"start": 2251.86, "end": 2253.86, "text": "替天子拟好了一道诏书"}, {"start": 2254.86, "end": 2255.86, "text": "我还替咱们大伙"}, {"start": 2256.86, "end": 2257.86, "text": "拟好了讨贼方略"}, {"start": 2258.86, "end": 2261.18, "text": "出洛阳之前"}, {"start": 2261.18, "end": 2262.18, "text": "我已经"}, {"start": 2262.18, "end": 2263.18, "text": "屈身是贼"}, {"start": 2263.18, "end": 2264.18, "text": "有半年多了"}, {"start": 2265.18, "end": 2267.18, "text": "这半年多的时间里"}, {"start": 2267.18, "end": 2269.18, "text": "我已经把西梁军"}, {"start": 2270.18, "end": 2271.18, "text": "部署的军力"}, {"start": 2272.18, "end": 2273.18, "text": "粮饷供给"}, {"start": 2274.18, "end": 2275.18, "text": "强弱情况"}, {"start": 2275.18, "end": 2276.18, "text": "摸得一清二楚"}, {"start": 2277.18, "end": 2278.18, "text": "有了这些"}, {"start": 2278.18, "end": 2280.18, "text": "我相信咱们就能"}, {"start": 2280.18, "end": 2281.18, "text": "胜券在握"}, {"start": 2282.18, "end": 2283.18, "text": "大伙请看"}, {"start": 2283.18, "end": 2306.74, "text": "城上的小子们"}, {"start": 2307.74, "end": 2308.74, "text": "给我听好喽"}, {"start": 2309.74, "end": 2311.74, "text": "我是千将军华雄"}, {"start": 2311.74, "end": 2312.74, "text": "奉相国之命"}, {"start": 2313.74, "end": 2314.74, "text": "前来讨伐叛贼"}, {"start": 2315.74, "end": 2316.74, "text": "如果"}, {"start": 2316.74, "end": 2317.74, "text": "你们谁"}, {"start": 2317.74, "end": 2319.74, "text": "能将曹操狗贼的头颅"}, {"start": 2319.74, "end": 2320.74, "text": "给我踢上来"}, {"start": 2321.74, "end": 2323.74, "text": "我将免你们不死"}, {"start": 2324.74, "end": 2325.74, "text": "报"}, {"start": 2325.74, "end": 2326.74, "text": "报"}, {"start": 2326.74, "end": 2327.74, "text": "禀蒙主"}, {"start": 2327.74, "end": 2329.74, "text": "董卓的前封将军华雄"}, {"start": 2329.74, "end": 2330.74, "text": "带着西梁大军"}, {"start": 2330.74, "end": 2331.74, "text": "说要讨伐曹操"}, {"start": 2331.74, "end": 2332.74, "text": "正在关前叫骂"}, {"start": 2334.74, "end": 2336.74, "text": "华雄何需人言"}, {"start": 2336.74, "end": 2338.74, "text": "怎敢如此放肆"}, {"start": 2338.74, "end": 2340.74, "text": "此人不可小事"}, {"start": 2340.74, "end": 2342.74, "text": "可是关西人士"}, {"start": 2342.74, "end": 2344.74, "text": "我称董卓麾下的"}, {"start": 2344.74, "end": 2345.74, "text": "第四员猛将"}, {"start": 2346.74, "end": 2347.74, "text": "第四"}, {"start": 2348.74, "end": 2349.74, "text": "那其他三名"}, {"start": 2349.74, "end": 2350.74, "text": "都是谁啊"}, {"start": 2351.74, "end": 2352.74, "text": "第一是吕布"}, {"start": 2353.74, "end": 2354.74, "text": "第二是李爵"}, {"start": 2354.74, "end": 2355.74, "text": "第三郭四"}, {"start": 2356.74, "end": 2357.74, "text": "第四员"}, {"start": 2357.74, "end": 2358.74, "text": "才是这个华雄"}, {"start": 2360.74, "end": 2364.17, "text": "六位将军"}, {"start": 2365.17, "end": 2368.48, "text": "我等刚刚聚议"}, {"start": 2369.48, "end": 2370.48, "text": "西梁军就来挑战"}, {"start": 2371.48, "end": 2372.48, "text": "这次是我军"}, {"start": 2372.48, "end": 2374.48, "text": "和董贼的首战"}, {"start": 2375.48, "end": 2376.48, "text": "此战"}, {"start": 2376.48, "end": 2377.48, "text": "要求必须"}, {"start": 2377.48, "end": 2378.48, "text": "斩将立功"}, {"start": 2378.48, "end": 2379.48, "text": "以仗我盟军的挺威"}, {"start": 2380.48, "end": 2381.48, "text": "末将请求出战"}, {"start": 2385.94, "end": 2386.94, "text": "石河之内"}, {"start": 2386.94, "end": 2388.94, "text": "定斩下华雄的狗头"}, {"start": 2389.94, "end": 2390.94, "text": "这是我的上将军"}, {"start": 2390.94, "end": 2391.94, "text": "余舍"}, {"start": 2392.94, "end": 2393.94, "text": "好"}, {"start": 2393.94, "end": 2394.94, "text": "取酒来"}, {"start": 2394.94, "end": 2396.94, "text": "为余将军重刑"}, {"start": 2397.94, "end": 2402.81, "text": "蒙德"}, {"start": 2402.81, "end": 2403.81, "text": "接着说你的方略吧"}, {"start": 2404.81, "end": 2405.81, "text": "好"}, {"start": 2406.81, "end": 2407.81, "text": "西梁军"}, {"start": 2408.81, "end": 2413.91, "text": "奉 奉 奉 奉"}]