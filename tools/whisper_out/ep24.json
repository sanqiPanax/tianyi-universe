[{"start": 17.14, "end": 19.7, "text": "云城可认得此人吗"}, {"start": 20.06, "end": 21.06, "text": "认得"}, {"start": 21.78, "end": 24.18, "text": "丞相的公子 曹辟"}, {"start": 24.58, "end": 26.94, "text": "那你可认得此马"}, {"start": 32.5, "end": 34.02, "text": "吕布的吃兔马"}, {"start": 34.02, "end": 35.02, "text": "没错"}, {"start": 35.94, "end": 38.42, "text": "人中吕布 马中吃兔"}, {"start": 38.54, "end": 41.34, "text": "如今吕布已经不在人间了"}, {"start": 41.58, "end": 44.46, "text": "吃兔马在等着它的新主人"}, {"start": 45.14, "end": 48.42, "text": "此马是天下第一剑戚"}, {"start": 48.42, "end": 50.1, "text": "日行千里"}, {"start": 50.38, "end": 52.98, "text": "越山川大河 如履平地"}, {"start": 53.78, "end": 54.78, "text": "两年来"}, {"start": 55.42, "end": 57.86, "text": "曹辟不知跟我要了多少回"}, {"start": 58.06, "end": 59.58, "text": "我都不舍得给他"}, {"start": 60.22, "end": 60.94, "text": "冰儿"}, {"start": 61.46, "end": 62.78, "text": "我是怎么说的"}, {"start": 63.54, "end": 64.5, "text": "父亲说"}, {"start": 64.98, "end": 67.42, "text": "儿配不上这匹吃兔马"}, {"start": 67.42, "end": 68.74, "text": "你是配不上的"}, {"start": 69.22, "end": 71.54, "text": "此马是给勇将用的"}, {"start": 71.54, "end": 72.46, "text": "不是你"}, {"start": 75.41, "end": 77.45, "text": "云长 从今日起"}, {"start": 77.81, "end": 79.77, "text": "此马就是你的坐骑了"}, {"start": 81.43, "end": 82.23, "text": "丞相"}, {"start": 82.71, "end": 83.43, "text": "当真"}, {"start": 83.43, "end": 84.91, "text": "吃兔配关羽"}, {"start": 85.27, "end": 86.63, "text": "宝马配英雄"}, {"start": 86.87, "end": 88.31, "text": "天下绝配"}, {"start": 96.04, "end": 97.6, "text": "谢丞相大恩大德"}, {"start": 97.6, "end": 98.56, "text": "不知末将"}, {"start": 98.72, "end": 101.1, "text": "不是其"}, {"start": 101.5, "end": 103.5, "text": "请吧 它是你的了"}, {"start": 103.62, "end": 151.72, "text": "丞相大恩 关羽"}, {"start": 160.8, "end": 163.28, "text": "云长 快快进棋"}, {"start": 163.56, "end": 164.64, "text": "云长啊"}, {"start": 165.76, "end": 168.6, "text": "我平日里赠你许多金银美女"}, {"start": 168.6, "end": 170.52, "text": "也未见你如此欢喜啊"}, {"start": 171.64, "end": 173.4, "text": "吃兔马日行千里"}, {"start": 174.4, "end": 175.92, "text": "末将拥有了它"}, {"start": 176.48, "end": 177.96, "text": "一旦知道兄长的下落"}, {"start": 177.96, "end": 187.9, "text": "一日之内便能相会"}, {"start": 191.89, "end": 193.89, "text": "好 好啊"}, {"start": 195.41, "end": 197.85, "text": "云长的忠肝义胆"}, {"start": 198.41, "end": 199.77, "text": "古今罕见"}, {"start": 201.71, "end": 203.15, "text": "你先去吧"}, {"start": 207.26, "end": 208.22, "text": "谢丞相"}, {"start": 208.22, "end": 209.02, "text": "去吧"}, {"start": 209.22, "end": 230.88, "text": "丞相 丞相"}, {"start": 230.88, "end": 231.88, "text": "丞相 丞相"}, {"start": 231.88, "end": 233.12, "text": "父亲 父亲"}, {"start": 233.12, "end": 234.32, "text": "丞相 父亲"}, {"start": 234.6, "end": 235.84, "text": "丞相 丞相"}, {"start": 235.84, "end": 237.04, "text": "我头疯犯了"}, {"start": 237.24, "end": 238.56, "text": "头中欲裂"}, {"start": 239.16, "end": 239.84, "text": "丞相"}, {"start": 240.16, "end": 242.28, "text": "你对这关羽天高地厚之恩"}, {"start": 242.28, "end": 243.16, "text": "可是他"}, {"start": 243.16, "end": 244.68, "text": "还是忘不了留背啊"}, {"start": 244.68, "end": 245.44, "text": "今日"}, {"start": 245.44, "end": 246.68, "text": "如不杀关羽"}, {"start": 246.68, "end": 249.28, "text": "日后将是我们的大敌啊"}, {"start": 249.28, "end": 250.32, "text": "丞相"}, {"start": 250.32, "end": 251.52, "text": "你曾就说过"}, {"start": 251.88, "end": 253.32, "text": "念我父天下人"}, {"start": 253.32, "end": 254.84, "text": "休叫天下人父我"}, {"start": 255.2, "end": 256.48, "text": "可是关羽"}, {"start": 256.48, "end": 257.92, "text": "他受丞相大恩"}, {"start": 257.92, "end": 259.16, "text": "却知恩不报"}, {"start": 259.16, "end": 260.36, "text": "贪恋救主"}, {"start": 260.36, "end": 261.56, "text": "辜负丞相"}, {"start": 261.88, "end": 262.92, "text": "丞相"}, {"start": 262.92, "end": 264.44, "text": "你为何不杀"}, {"start": 264.44, "end": 265.32, "text": "丞相 丞相"}, {"start": 265.32, "end": 266.32, "text": "末将请命 末将请命"}, {"start": 266.32, "end": 267.84, "text": "张关羽 张关羽"}, {"start": 268.84, "end": 270.0, "text": "丞相点头了"}, {"start": 270.0, "end": 271.88, "text": "弟兄们 上马"}, {"start": 271.88, "end": 272.96, "text": "上马 上马"}, {"start": 272.96, "end": 274.2, "text": "张关羽 张关羽"}, {"start": 274.2, "end": 275.2, "text": "张关羽"}, {"start": 275.2, "end": 276.52, "text": "丞相 醒醒啊"}, {"start": 276.52, "end": 278.28, "text": "他们去杀关羽了"}, {"start": 278.88, "end": 279.88, "text": "丞相"}, {"start": 280.56, "end": 281.56, "text": "回来"}, {"start": 281.92, "end": 282.92, "text": "回来"}, {"start": 285.84, "end": 286.6, "text": "回来"}, {"start": 286.6, "end": 291.12, "text": "令你们回来"}, {"start": 291.12, "end": 306.06, "text": "你们听着"}, {"start": 307.06, "end": 308.42, "text": "关羽的忠义"}, {"start": 309.34, "end": 311.34, "text": "堪称重将之开谋"}, {"start": 311.62, "end": 314.68, "text": "我宁肯"}, {"start": 315.4, "end": 316.8, "text": "他以我为敌"}, {"start": 317.8, "end": 319.32, "text": "也舍不得杀他"}, {"start": 319.68, "end": 338.74, "text": "那匹吃肚马"}, {"start": 339.26, "end": 340.86, "text": "丞相连自己的儿子"}, {"start": 340.86, "end": 341.86, "text": "都舍不得给"}, {"start": 341.86, "end": 342.9, "text": "却给了你"}, {"start": 343.7, "end": 345.34, "text": "当时有很多位将军"}, {"start": 345.34, "end": 347.34, "text": "对你是又羡慕又嫉妒"}, {"start": 347.7, "end": 348.7, "text": "你知道吗"}, {"start": 349.1, "end": 350.98, "text": "他们都是多年"}, {"start": 350.98, "end": 352.7, "text": "跟随丞相的人"}, {"start": 352.7, "end": 354.58, "text": "多次的出生入死"}, {"start": 354.58, "end": 355.98, "text": "赴汤蹈火"}, {"start": 355.98, "end": 357.26, "text": "都没有得到"}, {"start": 357.26, "end": 359.5, "text": "如此的恩宠吗"}, {"start": 359.78, "end": 363.34, "text": "丞相大恩"}, {"start": 363.7, "end": 368.1, "text": "可是你"}, {"start": 369.14, "end": 370.22, "text": "却说什么"}, {"start": 371.14, "end": 373.18, "text": "一旦得知兄长下落"}, {"start": 373.18, "end": 374.46, "text": "一日间"}, {"start": 374.46, "end": 375.98, "text": "便可相见"}, {"start": 375.98, "end": 378.42, "text": "这多伤丞相的心哪"}, {"start": 378.42, "end": 383.09, "text": "当时有几位将军"}, {"start": 383.09, "end": 385.55, "text": "想去杀你"}, {"start": 385.55, "end": 387.67, "text": "你知道丞相说什么吗"}, {"start": 388.95, "end": 389.95, "text": "丞相说"}, {"start": 391.47, "end": 392.67, "text": "我宁可"}, {"start": 392.67, "end": 394.87, "text": "关羽以我为敌"}, {"start": 395.79, "end": 397.75, "text": "也舍不得杀他"}, {"start": 398.55, "end": 399.75, "text": "丞相好恩"}, {"start": 401.03, "end": 402.99, "text": "关羽就是粉身碎骨"}, {"start": 402.99, "end": 412.67, "text": "也要报答的"}, {"start": 412.71, "end": 413.63, "text": "若我问你一句话"}, {"start": 413.63, "end": 415.31, "text": "你必须如实相告"}, {"start": 416.07, "end": 416.83, "text": "请说"}, {"start": 417.55, "end": 419.87, "text": "如果刘备命丧九泉"}, {"start": 419.87, "end": 445.62, "text": "你会不会归顺丞相"}, {"start": 445.62, "end": 450.91, "text": "如果兄长命丧九泉"}, {"start": 450.91, "end": 451.79, "text": "关羽"}, {"start": 452.39, "end": 454.51, "text": "愿赴九泉之下"}, {"start": 454.51, "end": 473.63, "text": "与兄长相会"}, {"start": 473.63, "end": 474.43, "text": "主公"}, {"start": 475.07, "end": 476.23, "text": "吃杯茶吧"}, {"start": 478.86, "end": 480.82, "text": "二弟三弟有消息了吗"}, {"start": 481.38, "end": 483.62, "text": "在下四处使人打听"}, {"start": 484.26, "end": 488.92, "text": "一点消息都没有"}, {"start": 488.92, "end": 489.76, "text": "子龙呢"}, {"start": 490.76, "end": 492.04, "text": "也无消息啊"}, {"start": 493.24, "end": 494.6, "text": "兄弟失散"}, {"start": 495.4, "end": 499.34, "text": "两位夫人不知下落"}, {"start": 499.34, "end": 504.37, "text": "我们寄人篱下"}, {"start": 504.37, "end": 506.05, "text": "终非长远之计啊"}, {"start": 506.85, "end": 507.57, "text": "主公"}, {"start": 508.05, "end": 511.71, "text": "难道袁绍有逐客之意了"}, {"start": 511.71, "end": 516.28, "text": "那倒没有"}, {"start": 516.28, "end": 517.2, "text": "不过"}, {"start": 517.2, "end": 529.71, "text": "我与袁绍相处多时"}, {"start": 529.71, "end": 531.31, "text": "觉得他并非雄主"}, {"start": 531.83, "end": 532.55, "text": "你看"}, {"start": 533.07, "end": 534.71, "text": "他坐拥四周之地"}, {"start": 534.71, "end": 537.07, "text": "拥有天下最多的兵马将士"}, {"start": 537.71, "end": 539.35, "text": "可是却多忧寡断"}, {"start": 540.11, "end": 541.71, "text": "至如今举兵半年多了"}, {"start": 541.71, "end": 542.79, "text": "却将士不下"}, {"start": 543.31, "end": 545.47, "text": "与曹操战飞战 喝飞喝"}, {"start": 545.47, "end": 546.63, "text": "进不进退不退"}, {"start": 547.15, "end": 548.83, "text": "这岂是成大业之君"}, {"start": 549.75, "end": 550.63, "text": "主公"}, {"start": 550.63, "end": 551.35, "text": "玄德"}, {"start": 555.1, "end": 556.42, "text": "玄德公在"}, {"start": 556.42, "end": 557.18, "text": "徐兄"}, {"start": 557.18, "end": 558.5, "text": "在下危急远迎"}, {"start": 558.5, "end": 559.38, "text": "罪过罪过"}, {"start": 560.1, "end": 560.94, "text": "哪里哪里"}, {"start": 561.66, "end": 563.82, "text": "徐敖也是闲来无事"}, {"start": 563.82, "end": 565.86, "text": "特到贵府讨杯茶吃吃"}, {"start": 566.46, "end": 568.66, "text": "可否有上好的新茶"}, {"start": 568.66, "end": 570.42, "text": "酌人给泡得浓一些"}, {"start": 571.22, "end": 572.74, "text": "徐芳 快上茶"}, {"start": 572.74, "end": 573.26, "text": "诺"}, {"start": 573.94, "end": 574.9, "text": "徐兄请坐"}, {"start": 574.9, "end": 575.42, "text": "请"}, {"start": 595.9, "end": 597.26, "text": "徐兄"}, {"start": 597.26, "end": 603.63, "text": "怎么想起来到寒舍吃茶了"}, {"start": 603.63, "end": 604.39, "text": "那我"}, {"start": 606.15, "end": 607.67, "text": "也就没必要兜圈子了"}, {"start": 609.27, "end": 611.43, "text": "我今天特地来到贵府"}, {"start": 612.23, "end": 613.83, "text": "是有要事与你相商"}, {"start": 615.83, "end": 616.51, "text": "请吩咐"}, {"start": 618.15, "end": 618.75, "text": "玄德公"}, {"start": 619.63, "end": 622.39, "text": "我家主公袁绍发布讨贼西闻"}, {"start": 623.07, "end": 626.28, "text": "已有半年之久"}, {"start": 626.28, "end": 628.64, "text": "此事可为天下人人皆知"}, {"start": 629.84, "end": 631.28, "text": "可事到如今"}, {"start": 631.28, "end": 633.6, "text": "这战局却没有丝毫的进展"}, {"start": 634.48, "end": 635.96, "text": "我军与那曹军"}, {"start": 635.96, "end": 638.0, "text": "始终处于焦灼状态"}, {"start": 640.77, "end": 641.97, "text": "这样长此下去"}, {"start": 642.69, "end": 644.65, "text": "我担心连你我"}, {"start": 645.33, "end": 648.95, "text": "都会大瞌睡了"}, {"start": 648.95, "end": 651.07, "text": "老师武功徒浩浅粮"}, {"start": 651.07, "end": 652.67, "text": "非战非和 不进不退"}, {"start": 653.39, "end": 654.83, "text": "确实是兵家大计"}, {"start": 655.55, "end": 658.07, "text": "我明天准备主动觐见"}, {"start": 659.03, "end": 661.03, "text": "劝说我家主公遇到曹操决战"}, {"start": 661.55, "end": 662.71, "text": "攻伐许昌"}, {"start": 662.71, "end": 663.23, "text": "好啊"}, {"start": 664.55, "end": 665.07, "text": "徐兄"}, {"start": 666.19, "end": 668.27, "text": "我也听说曹军发生了恶迹"}, {"start": 668.99, "end": 670.79, "text": "不少兵士都染了病"}, {"start": 670.79, "end": 672.59, "text": "连战马都倒闭了不少"}, {"start": 672.59, "end": 674.31, "text": "时不我待 机不可失"}, {"start": 675.03, "end": 675.99, "text": "确实如此"}, {"start": 676.71, "end": 677.19, "text": "玄德"}, {"start": 678.19, "end": 679.67, "text": "你明天和我一道觐见"}, {"start": 680.39, "end": 682.79, "text": "劝说我家主公逼曹操决战"}, {"start": 684.85, "end": 687.37, "text": "在下倒极是愿意"}, {"start": 688.37, "end": 689.17, "text": "不过"}, {"start": 689.69, "end": 693.21, "text": "我现在是吃闲饭的"}, {"start": 693.89, "end": 695.05, "text": "客居贵方"}, {"start": 695.57, "end": 697.85, "text": "如果对员工战和大忌"}, {"start": 697.85, "end": 698.97, "text": "收散倒私"}, {"start": 699.37, "end": 700.57, "text": "恐怕不合适吧"}, {"start": 702.51, "end": 703.91, "text": "就算员工不在意"}, {"start": 705.15, "end": 706.95, "text": "那么手下的文臣武将们"}, {"start": 706.95, "end": 707.87, "text": "也会不在意"}, {"start": 710.23, "end": 710.99, "text": "这个嘛"}, {"start": 711.63, "end": 712.63, "text": "我已经想好了"}, {"start": 713.11, "end": 714.71, "text": "明天在议事大堂上"}, {"start": 714.99, "end": 717.63, "text": "由我率先向我家主公觐见"}, {"start": 718.31, "end": 719.43, "text": "不管结果如何"}, {"start": 719.43, "end": 721.43, "text": "我家主公退堂以后"}, {"start": 721.43, "end": 723.07, "text": "势必向你讨论主意"}, {"start": 724.11, "end": 725.03, "text": "到那时"}, {"start": 725.55, "end": 726.15, "text": "玄德"}, {"start": 726.71, "end": 729.43, "text": "你在把你刚才跟我说的这番话"}, {"start": 730.07, "end": 732.11, "text": "原封不动 遗字不落的"}, {"start": 732.11, "end": 733.47, "text": "说与我家主公听"}, {"start": 733.91, "end": 734.71, "text": "其余的"}, {"start": 735.23, "end": 737.67, "text": "肯定要等水到渠成"}, {"start": 738.03, "end": 742.26, "text": "为何员工要问我"}, {"start": 743.34, "end": 744.66, "text": "我只是一个客吧"}, {"start": 747.14, "end": 749.22, "text": "恰恰因为你是客"}, {"start": 749.86, "end": 752.14, "text": "所谓客者难以置信"}, {"start": 752.38, "end": 753.5, "text": "只身事外"}, {"start": 754.3, "end": 756.14, "text": "有道是刚举者弥"}, {"start": 756.7, "end": 757.98, "text": "旁观者轻"}, {"start": 758.42, "end": 759.14, "text": "我可以料定"}, {"start": 759.9, "end": 763.74, "text": "我家主公必然要向你讨问主意"}, {"start": 765.34, "end": 766.26, "text": "敬佩敬佩"}, {"start": 767.78, "end": 769.42, "text": "在下遵命就是了"}, {"start": 770.78, "end": 771.3, "text": "主公"}, {"start": 772.06, "end": 773.82, "text": "眼下是大地回春"}, {"start": 773.94, "end": 775.06, "text": "天暖花开"}, {"start": 775.46, "end": 776.54, "text": "河流解冻"}, {"start": 776.98, "end": 778.22, "text": "冰雪消融"}, {"start": 778.78, "end": 780.62, "text": "我三军两享足备"}, {"start": 781.18, "end": 784.18, "text": "将士们个个斗志昂扬"}, {"start": 784.46, "end": 785.86, "text": "情绪高涨"}, {"start": 786.58, "end": 788.3, "text": "可那曹军内部"}, {"start": 788.9, "end": 790.5, "text": "却爆发了恶疾"}, {"start": 791.26, "end": 791.82, "text": "据报"}, {"start": 792.46, "end": 793.94, "text": "有数千兵士"}, {"start": 794.42, "end": 795.06, "text": "战马"}, {"start": 795.46, "end": 797.38, "text": "纷纷染病倒闭"}, {"start": 798.3, "end": 799.7, "text": "那曹营上下"}, {"start": 800.38, "end": 801.58, "text": "是军心浮动"}, {"start": 801.94, "end": 802.98, "text": "大为恐慌"}, {"start": 804.18, "end": 804.9, "text": "在下认为"}, {"start": 805.82, "end": 808.62, "text": "此刻正是我进军的最佳时机"}, {"start": 809.58, "end": 813.38, "text": "请主公肃令颜良文丑进军许昌"}, {"start": 815.02, "end": 816.46, "text": "颜良文丑二将"}, {"start": 817.62, "end": 818.58, "text": "也有书信来"}, {"start": 819.18, "end": 819.94, "text": "他们说"}, {"start": 820.38, "end": 821.98, "text": "如果再千言不战"}, {"start": 823.42, "end": 824.86, "text": "则将士懈怠"}, {"start": 825.34, "end": 826.38, "text": "兵封夜楼"}, {"start": 827.7, "end": 829.86, "text": "他们二人都催我肃绝"}, {"start": 831.58, "end": 834.22, "text": "我正相驾考虑"}, {"start": 835.34, "end": 835.74, "text": "主公"}, {"start": 836.38, "end": 837.9, "text": "那颜良文丑之意"}, {"start": 838.38, "end": 839.3, "text": "也是促战"}, {"start": 840.18, "end": 841.34, "text": "与在下之意"}, {"start": 841.34, "end": 842.98, "text": "正好是不谋而合"}, {"start": 842.98, "end": 844.14, "text": "完全一致"}, {"start": 844.74, "end": 847.18, "text": "恳请主公再务犹豫"}, {"start": 856.26, "end": 857.34, "text": "传令颜良文丑"}, {"start": 857.74, "end": 860.06, "text": "令他们率前军进取许昌"}, {"start": 861.1, "end": 863.62, "text": "数日后我亲率大军前往"}, {"start": 863.9, "end": 864.74, "text": "主公英明"}, {"start": 865.34, "end": 866.18, "text": "主公胜断"}, {"start": 867.14, "end": 868.82, "text": "在下即刻拟写军令"}, {"start": 869.26, "end": 870.46, "text": "并派飞机传命"}, {"start": 872.38, "end": 872.86, "text": "办去吧"}, {"start": 873.82, "end": 874.5, "text": "谢主公"}, {"start": 879.19, "end": 880.63, "text": "我不日就要进军"}, {"start": 882.03, "end": 883.75, "text": "你们各回齐职"}, {"start": 884.31, "end": 885.27, "text": "速速准备"}, {"start": 903.15, "end": 905.03, "text": "外面天暖花开"}, {"start": 906.35, "end": 907.39, "text": "差子烟红"}, {"start": 909.11, "end": 911.55, "text": "我们到园中赏花去吧"}, {"start": 913.43, "end": 915.15, "text": "否则大战一开"}, {"start": 915.83, "end": 917.79, "text": "就再无闲情雅致了"}, {"start": 918.15, "end": 919.07, "text": "甚好 甚好"}, {"start": 919.31, "end": 920.11, "text": "在下遵命"}, {"start": 920.47, "end": 924.1, "text": "主公 主公"}, {"start": 924.98, "end": 926.18, "text": "您下了进军令了吧"}, {"start": 927.18, "end": 928.34, "text": "刚刚下完"}, {"start": 929.26, "end": 930.82, "text": "许有误主啊"}, {"start": 931.58, "end": 932.18, "text": "禀主公"}, {"start": 932.62, "end": 934.94, "text": "数月前曹操攻伐徐州"}, {"start": 935.1, "end": 936.86, "text": "那时的确是我们进军"}, {"start": 936.86, "end": 938.5, "text": "许昌的大好时机"}, {"start": 938.78, "end": 940.58, "text": "可现在徐州已陷"}, {"start": 940.78, "end": 942.86, "text": "刘备全军丧尽"}, {"start": 944.26, "end": 945.46, "text": "六皇叔请见谅"}, {"start": 947.7, "end": 948.82, "text": "曹操写大盛之时"}, {"start": 948.82, "end": 949.62, "text": "兵封郑禁"}, {"start": 949.86, "end": 951.34, "text": "我禁飞弹不能进军"}, {"start": 951.5, "end": 952.98, "text": "而且应该避其锋芒"}, {"start": 952.98, "end": 953.82, "text": "暗兵不动"}, {"start": 954.1, "end": 955.54, "text": "另寻战机啊"}, {"start": 956.42, "end": 957.46, "text": "有消息说"}, {"start": 957.86, "end": 959.38, "text": "曹军正发生恶疾"}, {"start": 959.9, "end": 961.06, "text": "不少军事战马"}, {"start": 961.22, "end": 962.14, "text": "纷纷倒闭"}, {"start": 962.38, "end": 963.06, "text": "主公啊"}, {"start": 963.42, "end": 965.38, "text": "那曹操统领二十万大军"}, {"start": 965.58, "end": 967.38, "text": "哪天没有几个人病的呀"}, {"start": 967.62, "end": 968.62, "text": "借选小吉"}, {"start": 968.62, "end": 970.1, "text": "不足以撼动三军"}, {"start": 970.34, "end": 971.62, "text": "这不是战机"}, {"start": 972.94, "end": 974.18, "text": "可颜良文丑"}, {"start": 974.46, "end": 976.06, "text": "也有书信来促战"}, {"start": 976.86, "end": 977.62, "text": "为将者"}, {"start": 977.98, "end": 979.38, "text": "谁不渴望建功啊"}, {"start": 979.74, "end": 981.3, "text": "但是身为统帅"}, {"start": 981.62, "end": 983.06, "text": "应该审时夺势"}, {"start": 983.46, "end": 984.74, "text": "独掌全局"}, {"start": 984.94, "end": 986.94, "text": "不为轻浮议论所动"}, {"start": 987.98, "end": 988.54, "text": "主公"}, {"start": 988.82, "end": 990.78, "text": "你现在所拥州 郡 子 民"}, {"start": 990.9, "end": 992.18, "text": "在曹操一倍以上"}, {"start": 992.18, "end": 993.1, "text": "三年之内"}, {"start": 993.34, "end": 995.78, "text": "兵马粮草必树北于曹操"}, {"start": 995.9, "end": 997.7, "text": "那时灭曹易如反掌"}, {"start": 997.7, "end": 998.3, "text": "主公"}, {"start": 998.5, "end": 1001.42, "text": "当富民强兵徐图进取"}, {"start": 1001.78, "end": 1003.94, "text": "以净制动后发之人"}, {"start": 1004.02, "end": 1004.5, "text": "这"}, {"start": 1004.78, "end": 1006.62, "text": "才是至胜之道啊"}, {"start": 1020.41, "end": 1021.05, "text": "好"}, {"start": 1022.41, "end": 1024.05, "text": "你立即传令颜良文丑"}, {"start": 1024.13, "end": 1025.41, "text": "叫他停止进军"}, {"start": 1027.47, "end": 1028.03, "text": "在下"}, {"start": 1028.27, "end": 1028.95, "text": "这就去办"}, {"start": 1029.27, "end": 1035.42, "text": "宣德啊"}, {"start": 1036.1, "end": 1036.82, "text": "请"}, {"start": 1045.02, "end": 1045.54, "text": "主公"}, {"start": 1046.1, "end": 1048.58, "text": "你让那天锋传命停止进军"}, {"start": 1049.14, "end": 1049.74, "text": "是啊"}, {"start": 1050.66, "end": 1052.22, "text": "天锋所言有理"}, {"start": 1052.98, "end": 1054.46, "text": "眼下战机不佳"}, {"start": 1054.82, "end": 1056.7, "text": "我明当以净制动"}, {"start": 1057.06, "end": 1057.62, "text": "主公"}, {"start": 1057.74, "end": 1059.38, "text": "为何又要招令替改"}, {"start": 1059.66, "end": 1061.34, "text": "况且那传令的飞机"}, {"start": 1061.42, "end": 1063.66, "text": "已经奔驰在大陆上了"}, {"start": 1063.82, "end": 1065.02, "text": "这有什么"}, {"start": 1065.9, "end": 1067.58, "text": "做人追他回来就是了"}, {"start": 1080.79, "end": 1081.63, "text": "宣德啊"}, {"start": 1082.63, "end": 1083.75, "text": "你都看见了"}, {"start": 1085.27, "end": 1087.59, "text": "有人劝我战而取胜"}, {"start": 1088.55, "end": 1091.63, "text": "也有人力劝我不战而胜"}, {"start": 1092.03, "end": 1093.59, "text": "你非属我部下"}, {"start": 1093.79, "end": 1094.83, "text": "置身局外"}, {"start": 1096.39, "end": 1097.99, "text": "你你公心而论"}, {"start": 1099.67, "end": 1101.39, "text": "我是进军好呢"}, {"start": 1102.59, "end": 1104.27, "text": "还是退军好"}, {"start": 1108.12, "end": 1110.56, "text": "在下承员工厚恩"}, {"start": 1110.64, "end": 1111.88, "text": "客居帐下"}, {"start": 1112.8, "end": 1114.32, "text": "本不该多言的"}, {"start": 1115.04, "end": 1116.16, "text": "不必过切"}, {"start": 1116.88, "end": 1117.56, "text": "直说吧"}, {"start": 1122.54, "end": 1125.1, "text": "自明公发布讨贼西温以来"}, {"start": 1125.58, "end": 1128.46, "text": "天下苍生莫不翘首相望"}, {"start": 1128.9, "end": 1130.18, "text": "可是这半年来"}, {"start": 1130.22, "end": 1131.78, "text": "战非战 和非和"}, {"start": 1131.86, "end": 1133.38, "text": "进不进 退不退"}, {"start": 1133.74, "end": 1135.94, "text": "劳师武功 图好前两"}, {"start": 1136.46, "end": 1138.46, "text": "这些都是有利于曹操"}, {"start": 1138.5, "end": 1139.82, "text": "而不利于明公啊"}, {"start": 1140.86, "end": 1141.86, "text": "余放胆说"}, {"start": 1142.54, "end": 1144.62, "text": "眼下明公与曹操相比"}, {"start": 1145.1, "end": 1146.78, "text": "本来是占绝对优势"}, {"start": 1146.86, "end": 1149.3, "text": "可是明公如果不战而退"}, {"start": 1149.34, "end": 1151.86, "text": "那么曹操就会宣称他大获全胜"}, {"start": 1155.41, "end": 1156.17, "text": "他会说"}, {"start": 1156.21, "end": 1157.13, "text": "奉天子诏"}, {"start": 1157.13, "end": 1159.05, "text": "率王者师 大败逆贼"}, {"start": 1159.49, "end": 1160.77, "text": "那么天下苍生"}, {"start": 1161.05, "end": 1163.01, "text": "尤其是在明公与曹操之间"}, {"start": 1163.01, "end": 1164.65, "text": "摇摆不定的各地诸侯"}, {"start": 1164.69, "end": 1165.85, "text": "他们会怎么想"}, {"start": 1165.89, "end": 1167.17, "text": "他们会倒向谁"}, {"start": 1168.25, "end": 1169.33, "text": "明公别忘了"}, {"start": 1169.85, "end": 1172.25, "text": "朝廷是安在曹操的家门口"}, {"start": 1172.29, "end": 1174.13, "text": "而不在明公手上啊"}, {"start": 1174.73, "end": 1175.45, "text": "这"}, {"start": 1175.49, "end": 1176.69, "text": "在下这么说吧"}, {"start": 1177.13, "end": 1177.89, "text": "如果"}, {"start": 1179.53, "end": 1181.77, "text": "如果我有明公三分之一的兵马"}, {"start": 1182.41, "end": 1183.61, "text": "也早就进军了"}, {"start": 1186.72, "end": 1188.48, "text": "天封雾我呀"}, {"start": 1189.84, "end": 1191.16, "text": "我即刻进军"}, {"start": 1192.2, "end": 1192.88, "text": "明公"}, {"start": 1193.36, "end": 1195.28, "text": "还是跟各位谋臣商量一下"}, {"start": 1195.28, "end": 1196.16, "text": "再决定吧"}, {"start": 1198.46, "end": 1199.46, "text": "我意已决"}, {"start": 1200.94, "end": 1202.18, "text": "不再听他们的了"}, {"start": 1205.78, "end": 1206.78, "text": "天封兄台"}, {"start": 1207.5, "end": 1210.26, "text": "我好不容易说动了楚公进兵"}, {"start": 1210.86, "end": 1213.86, "text": "你为何又要加以阻拦呢"}, {"start": 1213.86, "end": 1215.38, "text": "因为你的方略是错的"}, {"start": 1215.74, "end": 1216.86, "text": "而我的方略"}, {"start": 1217.42, "end": 1218.9, "text": "才可滋万全"}, {"start": 1220.7, "end": 1221.66, "text": "未必吧"}, {"start": 1222.38, "end": 1223.38, "text": "该不是"}, {"start": 1223.86, "end": 1225.18, "text": "兄台妒忌我"}, {"start": 1225.22, "end": 1226.74, "text": "颇受主公之信"}, {"start": 1227.46, "end": 1229.34, "text": "怕抢了你的风头啊"}, {"start": 1231.06, "end": 1233.34, "text": "我田某若真有妒忌之心"}, {"start": 1233.62, "end": 1234.62, "text": "也该嫉妒"}, {"start": 1234.98, "end": 1236.26, "text": "值得我嫉妒的人"}, {"start": 1236.78, "end": 1237.62, "text": "你许悠"}, {"start": 1238.14, "end": 1238.74, "text": "不配"}, {"start": 1239.78, "end": 1240.46, "text": "兄台"}, {"start": 1241.42, "end": 1242.58, "text": "你发火了"}, {"start": 1242.98, "end": 1244.66, "text": "看来你对我许悠"}, {"start": 1244.82, "end": 1245.86, "text": "非但是妒"}, {"start": 1246.22, "end": 1247.58, "text": "而且还有恨"}, {"start": 1247.82, "end": 1248.62, "text": "许悠"}, {"start": 1249.06, "end": 1251.3, "text": "还记得上次主公对你的仗则吗"}, {"start": 1252.3, "end": 1254.18, "text": "不要好了伤疤忘了疼啊"}, {"start": 1255.5, "end": 1256.14, "text": "怎么"}, {"start": 1256.5, "end": 1257.18, "text": "兄台"}, {"start": 1258.02, "end": 1259.3, "text": "你就敢断定"}, {"start": 1260.34, "end": 1263.06, "text": "你天封不会有那一天"}, {"start": 1267.44, "end": 1268.36, "text": "也许有"}, {"start": 1269.48, "end": 1270.8, "text": "但我不会像你一样"}, {"start": 1270.8, "end": 1272.2, "text": "挨了打就改口"}, {"start": 1273.2, "end": 1275.08, "text": "我田某就是被主公打死"}, {"start": 1275.4, "end": 1277.44, "text": "也会尽忠尽贱以死相见"}, {"start": 1277.44, "end": 1278.28, "text": "绝不投机"}, {"start": 1278.52, "end": 1279.0, "text": "你"}, {"start": 1279.0, "end": 1281.28, "text": "主公君命已下"}, {"start": 1281.56, "end": 1284.36, "text": "令延梁文炒进军"}, {"start": 1284.92, "end": 1287.28, "text": "主公君命已下"}, {"start": 1287.48, "end": 1288.08, "text": "什么"}, {"start": 1288.08, "end": 1290.48, "text": "令延梁文炒进军"}, {"start": 1293.07, "end": 1294.35, "text": "田封兄台"}, {"start": 1294.83, "end": 1296.71, "text": "许有料定你田封"}, {"start": 1297.11, "end": 1299.27, "text": "早晚会有这一声惊叫"}, {"start": 1299.27, "end": 1300.19, "text": "不日之内"}, {"start": 1301.27, "end": 1302.91, "text": "前军必须抵达里亚"}, {"start": 1303.83, "end": 1304.71, "text": "持无力战"}, {"start": 1304.91, "end": 1305.59, "text": "主公"}, {"start": 1308.16, "end": 1308.76, "text": "主公"}, {"start": 1311.93, "end": 1312.81, "text": "田封听着"}, {"start": 1313.97, "end": 1315.49, "text": "不许你说三道四"}, {"start": 1315.73, "end": 1316.69, "text": "蛊惑军心"}, {"start": 1318.33, "end": 1319.05, "text": "主公"}, {"start": 1319.45, "end": 1320.81, "text": "容臣再说一句"}, {"start": 1321.09, "end": 1322.57, "text": "如果非要开战不可"}, {"start": 1322.57, "end": 1324.33, "text": "也万万不可进军许昌"}, {"start": 1324.33, "end": 1326.33, "text": "应该屯兵沿近一线"}, {"start": 1326.33, "end": 1327.25, "text": "分兵关渡"}, {"start": 1327.65, "end": 1328.57, "text": "再者"}, {"start": 1328.57, "end": 1329.73, "text": "延梁虽勇"}, {"start": 1329.73, "end": 1330.81, "text": "却无谋略"}, {"start": 1330.81, "end": 1332.05, "text": "不可视为前锋啊"}, {"start": 1332.53, "end": 1334.05, "text": "你还敢为延宋宁"}, {"start": 1334.53, "end": 1335.61, "text": "扰乱军心"}, {"start": 1336.53, "end": 1337.13, "text": "主公"}, {"start": 1339.23, "end": 1339.95, "text": "听令"}, {"start": 1339.95, "end": 1344.55, "text": "延出天方参军职位"}, {"start": 1345.23, "end": 1346.31, "text": "免为慕满意"}, {"start": 1346.75, "end": 1347.27, "text": "主公"}, {"start": 1347.99, "end": 1348.51, "text": "下去"}, {"start": 1349.35, "end": 1349.95, "text": "主公"}, {"start": 1350.23, "end": 1351.11, "text": "下去"}, {"start": 1351.59, "end": 1352.59, "text": "主公三思"}, {"start": 1352.99, "end": 1357.59, "text": "主公三思啊"}, {"start": 1357.87, "end": 1359.67, "text": "主公"}, {"start": 1360.19, "end": 1360.95, "text": "慢慢慢"}, {"start": 1362.83, "end": 1364.35, "text": "是田封兄台啊"}, {"start": 1369.45, "end": 1370.25, "text": "兄台啊"}, {"start": 1371.21, "end": 1372.53, "text": "我平时只知道"}, {"start": 1372.53, "end": 1374.09, "text": "你就会大话连篇"}, {"start": 1374.09, "end": 1375.29, "text": "和夸夸其谈"}, {"start": 1375.29, "end": 1375.93, "text": "原来"}, {"start": 1376.57, "end": 1378.05, "text": "你还会养马呀"}, {"start": 1383.09, "end": 1383.69, "text": "拉出去"}, {"start": 1385.67, "end": 1386.39, "text": "主公"}, {"start": 1387.19, "end": 1393.21, "text": "主公"}, {"start": 1393.21, "end": 1393.81, "text": "活该"}, {"start": 1405.29, "end": 1405.81, "text": "丞相"}, {"start": 1407.98, "end": 1409.7, "text": "听说你率军阻击袁绍"}, {"start": 1410.02, "end": 1411.22, "text": "末将愿做先锋"}, {"start": 1412.18, "end": 1412.86, "text": "云长"}, {"start": 1414.06, "end": 1415.46, "text": "我听说你这些日子"}, {"start": 1415.46, "end": 1416.54, "text": "思念你兄长"}, {"start": 1416.54, "end": 1418.06, "text": "几乎寝食俱沸"}, {"start": 1418.78, "end": 1419.38, "text": "是不是"}, {"start": 1424.96, "end": 1427.28, "text": "此行就不劳你大驾了"}, {"start": 1427.88, "end": 1429.36, "text": "你且回去静养"}, {"start": 1429.36, "end": 1430.76, "text": "静候我的佳音吧"}, {"start": 1432.85, "end": 1433.33, "text": "出发"}, {"start": 1433.73, "end": 1434.17, "text": "遵命"}, {"start": 1434.53, "end": 1435.13, "text": "出发"}, {"start": 1485.72, "end": 1487.32, "text": "我军刚刚土利亚"}, {"start": 1487.32, "end": 1488.56, "text": "危机奢华"}, {"start": 1488.56, "end": 1489.48, "text": "就被延梁突袭"}, {"start": 1490.04, "end": 1491.4, "text": "吕平呼嘲二将"}, {"start": 1491.4, "end": 1492.36, "text": "立战半日不敌"}, {"start": 1493.16, "end": 1494.16, "text": "延梁陪上了"}, {"start": 1496.6, "end": 1498.96, "text": "没想到这个延梁如此阴勇"}, {"start": 1499.64, "end": 1500.76, "text": "半日之内"}, {"start": 1500.76, "end": 1502.72, "text": "延瞻我两人大将"}, {"start": 1503.84, "end": 1504.92, "text": "徐蜀山河"}, {"start": 1504.92, "end": 1505.92, "text": "太阳月尽"}, {"start": 1505.92, "end": 1506.84, "text": "都纷纷请战"}, {"start": 1507.88, "end": 1509.04, "text": "被我强行来驾"}, {"start": 1509.04, "end": 1509.76, "text": "我让他们"}, {"start": 1509.76, "end": 1510.88, "text": "一口重强军令"}, {"start": 1510.88, "end": 1511.6, "text": "做得对"}, {"start": 1513.2, "end": 1515.2, "text": "眼下我军锋芒烧错"}, {"start": 1515.72, "end": 1517.16, "text": "下一战必须取胜"}, {"start": 1517.84, "end": 1518.64, "text": "否则"}, {"start": 1518.88, "end": 1519.64, "text": "宁可不战"}, {"start": 1520.0, "end": 1520.8, "text": "主公"}, {"start": 1520.8, "end": 1521.64, "text": "我建议人"}, {"start": 1522.36, "end": 1523.28, "text": "定可斩延梁"}, {"start": 1524.08, "end": 1525.56, "text": "你是说关羽吧"}, {"start": 1525.56, "end": 1525.88, "text": "对"}, {"start": 1526.56, "end": 1527.2, "text": "正是关羽"}, {"start": 1528.16, "end": 1529.32, "text": "主公还记得"}, {"start": 1529.32, "end": 1530.16, "text": "他曾经"}, {"start": 1530.16, "end": 1531.28, "text": "杯酒斩华雄吧"}, {"start": 1531.28, "end": 1531.76, "text": "当然"}, {"start": 1532.92, "end": 1534.28, "text": "可是我担心"}, {"start": 1534.28, "end": 1536.52, "text": "他斩将立功之后"}, {"start": 1536.52, "end": 1537.84, "text": "会离我而去"}, {"start": 1538.84, "end": 1539.28, "text": "主公"}, {"start": 1540.2, "end": 1541.2, "text": "我们且设下"}, {"start": 1541.2, "end": 1541.92, "text": "刘备还活着"}, {"start": 1542.6, "end": 1543.6, "text": "那么"}, {"start": 1543.6, "end": 1544.72, "text": "此人在何处"}, {"start": 1545.36, "end": 1546.24, "text": "他应该投奔谁"}, {"start": 1546.96, "end": 1548.24, "text": "肯定是袁绍啊"}, {"start": 1549.36, "end": 1549.96, "text": "主公"}, {"start": 1550.64, "end": 1552.16, "text": "如果令关羽出战"}, {"start": 1552.16, "end": 1553.64, "text": "斩了袁绍的大将"}, {"start": 1553.64, "end": 1554.52, "text": "袁绍一怒之下"}, {"start": 1555.16, "end": 1556.16, "text": "岂能不杀了刘备"}, {"start": 1556.76, "end": 1558.36, "text": "主公你可以想一想"}, {"start": 1558.36, "end": 1560.32, "text": "这刘备一旦被袁绍所杀"}, {"start": 1560.96, "end": 1563.2, "text": "那关羽就只有主公了"}, {"start": 1567.64, "end": 1568.52, "text": "老任"}, {"start": 1568.52, "end": 1568.76, "text": "在"}, {"start": 1570.52, "end": 1572.04, "text": "连夜召关羽前来"}, {"start": 1572.76, "end": 1573.84, "text": "他的赤土马快"}, {"start": 1574.84, "end": 1576.92, "text": "让他后日正午到达"}, {"start": 1578.0, "end": 1580.16, "text": "就说我会涉酒等候"}, {"start": 1580.92, "end": 1581.64, "text": "遵命"}, {"start": 1581.64, "end": 1654.29, "text": "不挑战"}, {"start": 1654.29, "end": 1656.13, "text": "那就是袁绍的军阵"}, {"start": 1656.13, "end": 1657.53, "text": "你看何等凶壮"}, {"start": 1660.12, "end": 1661.2, "text": "破砖烂瓦"}, {"start": 1663.12, "end": 1665.92, "text": "那人就是袁绍的前军主将"}, {"start": 1665.92, "end": 1666.48, "text": "严良"}, {"start": 1667.0, "end": 1668.12, "text": "听说他的武艺"}, {"start": 1668.12, "end": 1669.4, "text": "不在吕布之下"}, {"start": 1669.92, "end": 1675.2, "text": "插标卖手"}, {"start": 1678.04, "end": 1680.2, "text": "你何以如此狂啊"}, {"start": 1680.2, "end": 1681.36, "text": "令丞相"}, {"start": 1681.36, "end": 1683.72, "text": "末将愿将他首级取来"}, {"start": 1684.28, "end": 1685.84, "text": "军中无戏言"}, {"start": 1685.84, "end": 1687.16, "text": "如果拿他不下"}, {"start": 1687.16, "end": 1687.76, "text": "你怎么办"}, {"start": 1689.48, "end": 1692.0, "text": "那就请丞相取我的首级"}, {"start": 1692.04, "end": 1692.48, "text": "好"}, {"start": 1693.04, "end": 1693.76, "text": "真酒来"}, {"start": 1697.39, "end": 1698.11, "text": "雷鼓"}, {"start": 1702.35, "end": 1741.49, "text": "这次的事"}, {"start": 1742.25, "end": 1744.01, "text": "刘备身死宽忧了"}, {"start": 1748.61, "end": 1749.49, "text": "你估算一下"}, {"start": 1749.49, "end": 1751.05, "text": "这次战事会如何呀"}, {"start": 1752.33, "end": 1755.53, "text": "这次我们可是轻超而出了"}, {"start": 1755.53, "end": 1756.13, "text": "主公啊"}, {"start": 1756.77, "end": 1759.01, "text": "这次我军由你亲自统帅"}, {"start": 1759.01, "end": 1761.17, "text": "将士们一定会更加神勇"}, {"start": 1761.17, "end": 1761.89, "text": "奋力杀敌"}, {"start": 1761.89, "end": 1762.57, "text": "主公"}, {"start": 1766.52, "end": 1767.4, "text": "禀主公"}, {"start": 1767.4, "end": 1769.32, "text": "严良将军被关羽斩杀"}, {"start": 1769.32, "end": 1770.64, "text": "我军阵脚大乱"}, {"start": 1770.64, "end": 1772.52, "text": "曹军顺势攻杀"}, {"start": 1772.52, "end": 1774.64, "text": "什么"}, {"start": 1775.72, "end": 1778.08, "text": "严良将军被关羽所杀"}, {"start": 1778.08, "end": 1778.52, "text": "主公"}, {"start": 1779.24, "end": 1790.25, "text": "关羽已经归降曹操了"}, {"start": 1790.25, "end": 1791.17, "text": "你怎么能确定"}, {"start": 1791.17, "end": 1792.61, "text": "那是关羽的呀"}, {"start": 1792.61, "end": 1794.33, "text": "末将亲眼看到的"}, {"start": 1794.33, "end": 1795.97, "text": "那将赤面长须"}, {"start": 1795.97, "end": 1797.89, "text": "手持一把青龙大刀"}, {"start": 1797.89, "end": 1799.37, "text": "不是关羽又是何人"}, {"start": 1800.57, "end": 1801.09, "text": "刘备"}, {"start": 1804.6, "end": 1805.8, "text": "我待你不管我"}, {"start": 1807.04, "end": 1808.48, "text": "你却暗通曹操"}, {"start": 1808.48, "end": 1810.12, "text": "杀害我严良大将军"}, {"start": 1811.12, "end": 1811.92, "text": "来人"}, {"start": 1811.92, "end": 1813.64, "text": "将刘备吞噬斩首"}, {"start": 1813.64, "end": 1815.0, "text": "为严良复仇"}, {"start": 1815.0, "end": 1815.88, "text": "遵命"}, {"start": 1815.88, "end": 1817.44, "text": "明公 请听我一言"}, {"start": 1818.32, "end": 1820.16, "text": "我与那曹操有不共戴天之仇"}, {"start": 1821.04, "end": 1822.56, "text": "自从叙州之战之后"}, {"start": 1822.56, "end": 1823.6, "text": "我从未见过云长"}, {"start": 1824.32, "end": 1826.12, "text": "更不知其生死下落"}, {"start": 1826.96, "end": 1830.12, "text": "明公怎么能凭一将军貌似关羽"}, {"start": 1830.12, "end": 1837.75, "text": "就来判断我与曹操暗通呢"}, {"start": 1837.75, "end": 1838.51, "text": "说得是"}, {"start": 1839.75, "end": 1842.23, "text": "我信其有错杀无辜"}, {"start": 1842.87, "end": 1843.27, "text": "主公"}, {"start": 1844.23, "end": 1845.79, "text": "不管那人是否是关羽"}, {"start": 1846.47, "end": 1847.67, "text": "可以肯定的是"}, {"start": 1847.67, "end": 1849.47, "text": "曹操已经有所准备"}, {"start": 1849.47, "end": 1851.75, "text": "主公不如留一支仪兵在此"}, {"start": 1851.75, "end": 1854.31, "text": "然后大军驻守严禁分兵关渡"}, {"start": 1854.31, "end": 1855.79, "text": "从侧翼攻去曹操"}, {"start": 1861.3, "end": 1861.74, "text": "主公"}, {"start": 1862.5, "end": 1864.22, "text": "区区一个马夫"}, {"start": 1864.22, "end": 1865.14, "text": "又来教导你了"}, {"start": 1866.62, "end": 1868.58, "text": "这大敌当前"}, {"start": 1868.58, "end": 1869.98, "text": "岂能不战自退啊"}, {"start": 1870.82, "end": 1871.86, "text": "常言道"}, {"start": 1871.86, "end": 1872.78, "text": "退则乱"}, {"start": 1872.78, "end": 1874.66, "text": "这乱必败"}, {"start": 1874.66, "end": 1876.3, "text": "天封居心妥则"}, {"start": 1878.02, "end": 1878.5, "text": "天封"}, {"start": 1880.18, "end": 1883.02, "text": "你口口声声让我退军退军"}, {"start": 1883.02, "end": 1885.22, "text": "实则是乱我军心"}, {"start": 1885.22, "end": 1887.22, "text": "严良就是这样才被斩于马下的"}, {"start": 1889.94, "end": 1890.38, "text": "来人"}, {"start": 1890.9, "end": 1892.9, "text": "将天封拖下去"}, {"start": 1892.9, "end": 1894.38, "text": "涨达五十军棍"}, {"start": 1894.38, "end": 1895.02, "text": "遵命"}, {"start": 1895.62, "end": 1896.02, "text": "主公"}, {"start": 1897.34, "end": 1897.82, "text": "主公"}, {"start": 1898.26, "end": 1898.94, "text": "主公"}, {"start": 1899.7, "end": 1906.61, "text": "主公"}, {"start": 1906.61, "end": 1907.37, "text": "萧义振"}, {"start": 1909.13, "end": 1911.97, "text": "你们谁敢出阵迎战曹军"}, {"start": 1912.93, "end": 1913.85, "text": "震我军威"}, {"start": 1914.89, "end": 1915.61, "text": "我愿出战"}, {"start": 1918.39, "end": 1918.79, "text": "主公"}, {"start": 1919.31, "end": 1920.95, "text": "严良与我亲如兄弟"}, {"start": 1920.95, "end": 1922.87, "text": "我非要斩杀了长驯贼将不可"}, {"start": 1923.51, "end": 1924.83, "text": "为严良报仇"}, {"start": 1924.83, "end": 1925.15, "text": "好"}, {"start": 1928.09, "end": 1930.17, "text": "只是今天天色已晚"}, {"start": 1930.17, "end": 1931.37, "text": "明天正午时分"}, {"start": 1931.37, "end": 1932.81, "text": "你亲率五万军兵"}, {"start": 1932.81, "end": 1933.81, "text": "迎战朝军"}, {"start": 1934.69, "end": 1936.05, "text": "我将欺凌郑杰"}, {"start": 1936.05, "end": 1938.61, "text": "为你摇旗呐喊以壮军威"}, {"start": 1938.61, "end": 1938.93, "text": "遵命"}, {"start": 1938.93, "end": 1939.57, "text": "主公"}, {"start": 1940.29, "end": 1941.49, "text": "曹操有所准备"}, {"start": 1942.09, "end": 1942.97, "text": "文丑虽勇"}, {"start": 1942.97, "end": 1944.25, "text": "恐难敌曹贼"}, {"start": 1944.25, "end": 1946.01, "text": "主公还是退兵吧"}, {"start": 1946.01, "end": 1946.37, "text": "天封"}, {"start": 1947.01, "end": 1948.65, "text": "你屡屡如我"}, {"start": 1948.65, "end": 1949.73, "text": "我是一人贼人"}, {"start": 1949.73, "end": 1951.97, "text": "今天我是无论如何也忍受不了了"}, {"start": 1951.97, "end": 1952.49, "text": "来人"}, {"start": 1952.49, "end": 1954.29, "text": "将天封推出去斩首示众"}, {"start": 1954.77, "end": 1955.53, "text": "主公"}, {"start": 1955.53, "end": 1956.17, "text": "主公"}, {"start": 1956.17, "end": 1956.89, "text": "主公"}, {"start": 1956.89, "end": 1957.41, "text": "主公"}, {"start": 1957.41, "end": 1957.93, "text": "主公"}, {"start": 1957.93, "end": 1958.45, "text": "主公"}, {"start": 1958.45, "end": 1959.45, "text": "主公"}, {"start": 1961.5, "end": 1962.26, "text": "是啊 主公"}, {"start": 1962.98, "end": 1964.66, "text": "中将士说得也不无道理"}, {"start": 1965.86, "end": 1967.06, "text": "天封小人"}, {"start": 1967.06, "end": 1968.26, "text": "虽然是狂妄无知"}, {"start": 1969.14, "end": 1970.42, "text": "可对主公你来说"}, {"start": 1970.98, "end": 1972.02, "text": "尚属忠诚"}, {"start": 1975.55, "end": 1976.91, "text": "看在他们的面上"}, {"start": 1977.67, "end": 1979.47, "text": "我今天暂且饶你不死"}, {"start": 1980.03, "end": 1981.23, "text": "等我灭了曹贼"}, {"start": 1981.75, "end": 1983.07, "text": "再拿你点天灯"}, {"start": 1984.23, "end": 1984.63, "text": "听令"}, {"start": 1985.63, "end": 1986.83, "text": "将天封"}, {"start": 1986.83, "end": 1988.83, "text": "押回济州府"}, {"start": 1988.83, "end": 1989.35, "text": "下御"}, {"start": 1991.11, "end": 1992.43, "text": "斩奸后"}, {"start": 1992.43, "end": 1992.91, "text": "遵命"}, {"start": 1994.03, "end": 1994.67, "text": "在下"}, {"start": 1995.71, "end": 1996.35, "text": "谢恩"}, {"start": 2007.97, "end": 2009.01, "text": "出来受死"}, {"start": 2015.02, "end": 2016.62, "text": "文丑是我的大将"}, {"start": 2017.7, "end": 2019.78, "text": "他有万福不挡之勇啊"}, {"start": 2022.32, "end": 2024.0, "text": "去年叫公孙瓒的时候"}, {"start": 2024.76, "end": 2025.36, "text": "他一人"}, {"start": 2026.04, "end": 2027.28, "text": "勇斗七元战将"}, {"start": 2029.08, "end": 2030.24, "text": "斩其三"}, {"start": 2030.24, "end": 2031.08, "text": "伤其四"}, {"start": 2031.88, "end": 2032.56, "text": "四级"}, {"start": 2033.92, "end": 2035.28, "text": "去豪放为三"}, {"start": 2037.24, "end": 2039.16, "text": "明公有文将军这样的猛将"}, {"start": 2039.72, "end": 2041.2, "text": "何愁曹军不破呀"}, {"start": 2046.1, "end": 2047.9, "text": "那个致命长虚者何在"}, {"start": 2047.9, "end": 2049.74, "text": "快快出来受死"}, {"start": 2049.74, "end": 2050.9, "text": "贼将休狂"}, {"start": 2050.9, "end": 2052.54, "text": "徐皇在此"}, {"start": 2052.54, "end": 2053.78, "text": "张辽来与"}, {"start": 2062.57, "end": 2063.73, "text": "那曹军"}, {"start": 2063.73, "end": 2064.53, "text": "有二将出战了"}, {"start": 2065.29, "end": 2066.61, "text": "一路是张辽"}, {"start": 2066.61, "end": 2067.61, "text": "一路是徐皇"}, {"start": 2068.21, "end": 2068.89, "text": "明公"}, {"start": 2069.61, "end": 2070.53, "text": "这两人"}, {"start": 2070.53, "end": 2072.17, "text": "都是曹操的猛将"}, {"start": 2072.17, "end": 2073.49, "text": "都在那座山上"}, {"start": 2197.89, "end": 2244.86, "text": "就是你的二弟关羽"}, {"start": 2244.86, "end": 2247.18, "text": "亲手杀了我的上将文丑"}, {"start": 2248.18, "end": 2249.66, "text": "你暗吐曹操"}, {"start": 2249.66, "end": 2251.82, "text": "心是无比的险恶"}, {"start": 2252.38, "end": 2252.98, "text": "来人"}, {"start": 2252.98, "end": 2253.38, "text": "在"}, {"start": 2253.38, "end": 2255.02, "text": "请刘备推出去砍牢"}, {"start": 2255.02, "end": 2255.58, "text": "诺便"}, {"start": 2255.58, "end": 2256.1, "text": "且慢"}, {"start": 2256.66, "end": 2257.3, "text": "明公"}, {"start": 2260.38, "end": 2262.18, "text": "能容我说一句话再死吗"}, {"start": 2263.14, "end": 2264.14, "text": "都这个时候了"}, {"start": 2264.14, "end": 2265.58, "text": "你还有什么话说"}, {"start": 2266.1, "end": 2266.7, "text": "明公"}, {"start": 2268.52, "end": 2269.2, "text": "那曹操"}, {"start": 2269.56, "end": 2271.56, "text": "那曹操素来忌恨我刘备"}, {"start": 2272.76, "end": 2273.96, "text": "显然他已经知道"}, {"start": 2273.96, "end": 2275.24, "text": "我在明公这里"}, {"start": 2275.24, "end": 2277.08, "text": "所以故意是关羽出战"}, {"start": 2277.08, "end": 2278.92, "text": "借明公之手杀我"}, {"start": 2278.92, "end": 2280.12, "text": "此一劫"}, {"start": 2280.12, "end": 2281.24, "text": "起明公名产"}, {"start": 2288.25, "end": 2289.89, "text": "我不管曹操什么用意"}, {"start": 2290.53, "end": 2292.69, "text": "我只是要用你的头"}, {"start": 2292.69, "end": 2295.09, "text": "为阎梁文主祭命"}, {"start": 2295.09, "end": 2295.77, "text": "可是我二弟"}, {"start": 2295.77, "end": 2297.57, "text": "并不知道我在这儿"}, {"start": 2297.57, "end": 2298.77, "text": "明公"}, {"start": 2298.77, "end": 2300.33, "text": "如果二弟知道我在这儿"}, {"start": 2301.13, "end": 2303.17, "text": "岂能斩杀明公爱将"}, {"start": 2303.17, "end": 2308.42, "text": "陷我于死地"}, {"start": 2308.46, "end": 2309.06, "text": "明公"}, {"start": 2310.02, "end": 2310.94, "text": "我想请问"}, {"start": 2312.34, "end": 2314.06, "text": "我二弟关羽武艺"}, {"start": 2314.06, "end": 2317.88, "text": "与阎梁文丑相比如何"}, {"start": 2317.88, "end": 2319.88, "text": "高低不可相比"}, {"start": 2319.88, "end": 2320.88, "text": "我再请问"}, {"start": 2322.4, "end": 2324.16, "text": "若我写一封密信"}, {"start": 2324.16, "end": 2325.28, "text": "召回关羽"}, {"start": 2325.96, "end": 2327.0, "text": "让他与我一起"}, {"start": 2327.0, "end": 2336.84, "text": "辅助明公又如何"}, {"start": 2336.84, "end": 2337.84, "text": "真的吗"}, {"start": 2339.12, "end": 2341.32, "text": "我如果能够得到关羽"}, {"start": 2342.44, "end": 2344.52, "text": "那可是比阎梁文丑"}, {"start": 2345.24, "end": 2354.32, "text": "高出十倍啊"}, {"start": 2354.36, "end": 2355.48, "text": "云长如雾"}, {"start": 2356.12, "end": 2358.2, "text": "我三兄弟桃园结义"}, {"start": 2358.2, "end": 2359.32, "text": "誓同生死"}, {"start": 2360.0, "end": 2360.72, "text": "如今"}, {"start": 2361.16, "end": 2363.48, "text": "贤弟却为何割袍断义"}, {"start": 2363.48, "end": 2364.48, "text": "助贼为义"}, {"start": 2365.4, "end": 2367.36, "text": "贤弟如要娶功名富贵"}, {"start": 2367.96, "end": 2370.64, "text": "于兄愿自献首级相助"}, {"start": 2371.4, "end": 2372.96, "text": "疏不尽言"}, {"start": 2372.96, "end": 2388.56, "text": "死待活着"}, {"start": 2390.24, "end": 2391.76, "text": "你斩杀了阎梁文丑"}, {"start": 2392.28, "end": 2396.94, "text": "主公险些被你害死"}, {"start": 2396.94, "end": 2404.18, "text": "于天地之主以忠义为本"}, {"start": 2404.18, "end": 2404.98, "text": "掌经在"}, {"start": 2408.61, "end": 2409.61, "text": "将军"}, {"start": 2409.61, "end": 2416.96, "text": "我将如何回复主公"}, {"start": 2416.96, "end": 2417.72, "text": "禀告兄长"}, {"start": 2418.8, "end": 2419.96, "text": "明日我急向曹城"}, {"start": 2420.92, "end": 2421.76, "text": "曹操自行"}, {"start": 2422.72, "end": 2424.52, "text": "护送二位嫂嫂"}, {"start": 2424.52, "end": 2425.84, "text": "速去与兄长相会"}, {"start": 2426.96, "end": 2430.67, "text": "曹操会放你走吗"}, {"start": 2430.67, "end": 2433.23, "text": "顺曹时定有三约"}, {"start": 2433.23, "end": 2435.35, "text": "其中最重要的一约就是"}, {"start": 2435.35, "end": 2438.79, "text": "但迟到兄长的下落"}, {"start": 2438.79, "end": 2440.31, "text": "无论天涯海角"}, {"start": 2440.31, "end": 2442.27, "text": "急去与之相会"}, {"start": 2443.79, "end": 2444.59, "text": "好"}, {"start": 2444.59, "end": 2445.95, "text": "我连夜返回冀州"}, {"start": 2445.95, "end": 2446.95, "text": "禀报主公"}]