[{"start": 25.81, "end": 27.81, "text": "你是副都督。"}, {"start": 27.81, "end": 28.81, "text": "是。"}, {"start": 28.81, "end": 31.81, "text": "在曹振辉拥梁养伤期间,"}, {"start": 32.81, "end": 34.81, "text": "你应主理大都督,"}, {"start": 34.81, "end": 36.81, "text": "直到我来继任,"}, {"start": 36.81, "end": 37.81, "text": "是吧?"}, {"start": 37.81, "end": 38.81, "text": "是。"}, {"start": 38.81, "end": 40.81, "text": "可我在来此路上,"}, {"start": 40.81, "end": 43.81, "text": "抓获了九个逃兵。"}, {"start": 44.81, "end": 46.81, "text": "巡问后得知,"}, {"start": 46.81, "end": 48.81, "text": "英中军心大乱,"}, {"start": 48.81, "end": 50.81, "text": "日日都有逃兵。"}, {"start": 50.81, "end": 55.98, "text": "你是咱们执掌军纪的。"}, {"start": 55.98, "end": 57.98, "text": "禀大都督,"}, {"start": 57.98, "end": 58.98, "text": "逃兵太多,"}, {"start": 58.98, "end": 60.98, "text": "在下实在无法依约束。"}, {"start": 60.98, "end": 64.9, "text": "无法约束,为何不战?"}, {"start": 64.9, "end": 67.98, "text": "战了逃兵,"}, {"start": 67.98, "end": 69.98, "text": "日后谁敢出战蜀军呢?"}, {"start": 69.98, "end": 83.98, "text": "逃兵能战吗?"}, {"start": 83.98, "end": 90.62, "text": "牵涉一少人吗?"}, {"start": 90.62, "end": 103.34, "text": "拉下郭怀,"}, {"start": 103.34, "end": 104.34, "text": "斩首示众。"}, {"start": 104.34, "end": 105.34, "text": "诺。"}, {"start": 105.34, "end": 106.34, "text": "大都督,"}, {"start": 106.34, "end": 107.34, "text": "军心动乱,"}, {"start": 107.34, "end": 108.34, "text": "最在曹申的。"}, {"start": 108.34, "end": 109.34, "text": "大都督,"}, {"start": 109.34, "end": 110.34, "text": "郭将军虽然执法不严,"}, {"start": 110.34, "end": 111.34, "text": "但曹战离任之后,"}, {"start": 111.34, "end": 112.34, "text": "一直是他布军迎敌,"}, {"start": 112.34, "end": 113.34, "text": "否则,"}, {"start": 113.34, "end": 114.34, "text": "钟国亮早就杀来了。"}, {"start": 114.34, "end": 115.34, "text": "是啊,大都督,"}, {"start": 115.34, "end": 116.34, "text": "饶了他吧。"}, {"start": 116.34, "end": 117.34, "text": "大都督,"}, {"start": 122.03, "end": 123.03, "text": "如果再有逃兵,"}, {"start": 123.03, "end": 124.03, "text": "与郭将军同罪。"}, {"start": 124.03, "end": 125.03, "text": "饶了郭将军吧。"}, {"start": 125.03, "end": 126.03, "text": "请大都督开恩。"}, {"start": 126.03, "end": 127.03, "text": "请大都督开恩。"}, {"start": 127.03, "end": 128.03, "text": "请大都督开恩啊。"}, {"start": 129.03, "end": 135.18, "text": "听着,"}, {"start": 136.18, "end": 137.18, "text": "不恕军威,"}, {"start": 138.18, "end": 140.18, "text": "不战自愧,"}, {"start": 140.18, "end": 141.18, "text": "即日起,"}, {"start": 141.18, "end": 143.18, "text": "逃一个斩一个,"}, {"start": 144.18, "end": 147.18, "text": "士族逃跑斩五掌,"}, {"start": 147.18, "end": 150.18, "text": "五掌逃跑斩十掌,"}, {"start": 151.18, "end": 154.18, "text": "十掌逃跑斩校尉,"}, {"start": 155.18, "end": 156.18, "text": "校尉逃跑,"}, {"start": 157.18, "end": 159.85, "text": "斩将军,"}, {"start": 161.85, "end": 162.85, "text": "将军逃跑,"}, {"start": 162.85, "end": 164.85, "text": "我司马宜自斩投入,"}, {"start": 164.85, "end": 165.85, "text": "向朝廷谢罪。"}, {"start": 166.85, "end": 167.85, "text": "遵命。"}, {"start": 167.85, "end": 176.02, "text": "通杖四十。"}, {"start": 176.02, "end": 177.02, "text": "诺。"}, {"start": 177.02, "end": 185.67, "text": "现在可以议兵了,"}, {"start": 185.67, "end": 188.98, "text": "众将听令,"}, {"start": 188.98, "end": 193.6, "text": "都第一道军令是,"}, {"start": 193.6, "end": 196.98, "text": "这个甩案给我换了,"}, {"start": 196.98, "end": 198.98, "text": "立刻打造一座统案,"}, {"start": 198.98, "end": 199.98, "text": "立在这里。"}, {"start": 199.98, "end": 200.98, "text": "遵命。"}, {"start": 200.98, "end": 201.98, "text": "来人。"}, {"start": 201.98, "end": 202.98, "text": "在。"}, {"start": 202.98, "end": 203.98, "text": "抬出去。"}, {"start": 203.98, "end": 204.98, "text": "诺。"}, {"start": 204.98, "end": 216.61, "text": "本都第二道军令是,"}, {"start": 217.61, "end": 218.61, "text": "放假两日,"}, {"start": 219.61, "end": 222.61, "text": "把营中所有酒肉都搬出来,"}, {"start": 222.61, "end": 224.61, "text": "让将士们饱餐两日,"}, {"start": 224.61, "end": 225.61, "text": "大醉一场。"}, {"start": 226.61, "end": 227.61, "text": "遵命。"}, {"start": 227.61, "end": 232.27, "text": "这将士们如果都喝醉了,"}, {"start": 232.27, "end": 233.27, "text": "一旦有警,"}, {"start": 233.27, "end": 236.0, "text": "何以迎敌?"}, {"start": 236.0, "end": 237.0, "text": "无妨。"}, {"start": 238.0, "end": 240.0, "text": "把我的率旗插遍山岗,"}, {"start": 241.0, "end": 243.0, "text": "蜀军文封后,"}, {"start": 243.0, "end": 244.0, "text": "就是不丧诞,"}, {"start": 245.0, "end": 247.0, "text": "也得倒退三十里吧。"}, {"start": 248.0, "end": 249.0, "text": "遵命。"}, {"start": 249.0, "end": 251.0, "text": "本都第三道军令是,"}, {"start": 251.0, "end": 255.0, "text": "把前一阵子有功将士的名册报上来,"}, {"start": 255.0, "end": 258.0, "text": "凡是斩杀过两个蜀军的,"}, {"start": 258.0, "end": 260.0, "text": "皆升一级,"}, {"start": 260.0, "end": 262.0, "text": "赏钱五百,"}, {"start": 262.0, "end": 265.0, "text": "杀四个蜀军的,"}, {"start": 265.0, "end": 266.0, "text": "升两级,"}, {"start": 266.0, "end": 267.0, "text": "赏钱一千,"}, {"start": 267.0, "end": 268.0, "text": "依此类推。"}, {"start": 268.0, "end": 270.0, "text": "直指各位将军。"}, {"start": 270.0, "end": 271.0, "text": "遵命。"}, {"start": 271.0, "end": 272.0, "text": "没说完呢。"}, {"start": 273.0, "end": 276.0, "text": "凡是没有斩杀过蜀军的人,"}, {"start": 276.0, "end": 278.0, "text": "不管他是将,是威,"}, {"start": 278.0, "end": 280.0, "text": "是士,是卒,"}, {"start": 280.0, "end": 282.82, "text": "立刻斩杀。"}, {"start": 284.82, "end": 285.82, "text": "遵命。"}, {"start": 285.82, "end": 286.82, "text": "大胆声。"}, {"start": 286.82, "end": 288.82, "text": "遵命。"}, {"start": 288.82, "end": 294.95, "text": "凡还是那些营牌,"}, {"start": 295.95, "end": 298.95, "text": "将士还是那些将士,"}, {"start": 298.95, "end": 300.95, "text": "可一看便明白,"}, {"start": 301.95, "end": 303.95, "text": "大赌赌换人吧。"}, {"start": 304.95, "end": 306.95, "text": "陈仓已在我军手中,"}, {"start": 306.95, "end": 308.95, "text": "良道已开,"}, {"start": 308.95, "end": 310.95, "text": "他司马仪来了又能如何?"}, {"start": 310.95, "end": 312.95, "text": "千万不要这么想,"}, {"start": 313.95, "end": 315.95, "text": "司马仪深通兵法,"}, {"start": 315.95, "end": 317.95, "text": "颇负套律,"}, {"start": 317.95, "end": 319.95, "text": "是我最棘手的敌人。"}, {"start": 320.95, "end": 321.95, "text": "丞相,"}, {"start": 321.95, "end": 323.95, "text": "恕末将眼拙,"}, {"start": 323.95, "end": 326.95, "text": "我就没有看出来司马仪有什么套律。"}, {"start": 327.95, "end": 328.95, "text": "上次被罚,"}, {"start": 328.95, "end": 330.95, "text": "丞相一到空城记,"}, {"start": 330.95, "end": 331.95, "text": "就惊叨了他。"}, {"start": 331.95, "end": 336.52, "text": "我来告诉你司马仪的套律吧。"}, {"start": 336.52, "end": 337.52, "text": "他这个人,"}, {"start": 337.52, "end": 339.52, "text": "不善于攻,"}, {"start": 339.52, "end": 341.52, "text": "却善于守,"}, {"start": 341.52, "end": 344.52, "text": "是天下第一守城大将。"}, {"start": 345.52, "end": 347.52, "text": "而我们哪,"}, {"start": 347.52, "end": 350.52, "text": "最讨厌卫军深沟高垒,"}, {"start": 350.52, "end": 352.52, "text": "坚守不战,"}, {"start": 352.52, "end": 354.52, "text": "因为时间不利于我,"}, {"start": 354.52, "end": 356.52, "text": "而有利于敌。"}, {"start": 356.52, "end": 360.52, "text": "司马仪希望我们强攻一座座城池,"}, {"start": 360.52, "end": 361.52, "text": "这样,"}, {"start": 361.52, "end": 364.52, "text": "五十年都攻不到洛阳,"}, {"start": 364.52, "end": 366.52, "text": "现在你该明白,"}, {"start": 366.52, "end": 369.96, "text": "坚守不战,"}, {"start": 369.96, "end": 371.96, "text": "就是司马仪的套律。"}, {"start": 372.96, "end": 374.96, "text": "看似愚呆,"}, {"start": 374.96, "end": 377.96, "text": "其实乃大志啊。"}, {"start": 378.96, "end": 379.96, "text": "明白了。"}, {"start": 380.96, "end": 381.96, "text": "丞相,"}, {"start": 381.96, "end": 383.96, "text": "那你有何打算呢?"}, {"start": 384.96, "end": 386.96, "text": "不消除司马仪,"}, {"start": 386.96, "end": 388.96, "text": "竟不夺中原。"}, {"start": 389.96, "end": 392.96, "text": "我们只能诱他出来与我决战,"}, {"start": 392.96, "end": 393.96, "text": "将为,"}, {"start": 393.96, "end": 397.53, "text": "龙溪各城,"}, {"start": 397.53, "end": 399.53, "text": "卫军守备如何?"}, {"start": 400.53, "end": 401.53, "text": "末将已查明,"}, {"start": 401.53, "end": 403.53, "text": "在龙溪十五座城池中,"}, {"start": 403.53, "end": 405.53, "text": "只有武都和殷平的守备是最弱的。"}, {"start": 406.53, "end": 407.53, "text": "威延,"}, {"start": 407.53, "end": 410.53, "text": "你能攻下武都和殷平吗?"}, {"start": 411.53, "end": 412.53, "text": "丞相,"}, {"start": 412.53, "end": 414.53, "text": "两座小城,"}, {"start": 414.53, "end": 415.53, "text": "去他又何难?"}, {"start": 415.53, "end": 417.53, "text": "好,"}, {"start": 417.53, "end": 420.53, "text": "但不只是攻城这么简单,"}, {"start": 420.53, "end": 422.53, "text": "你应该知道怎么攻城。"}, {"start": 422.53, "end": 424.53, "text": "你应该知道怎么办吧?"}, {"start": 424.53, "end": 425.53, "text": "知道。"}, {"start": 425.53, "end": 427.53, "text": "先为而不攻,"}, {"start": 427.53, "end": 429.53, "text": "再攻而不下。"}, {"start": 429.53, "end": 430.53, "text": "等他卫军来远。"}, {"start": 431.53, "end": 435.86, "text": "你打探清楚了?"}, {"start": 436.86, "end": 438.86, "text": "蜀军真的只有三千?"}, {"start": 438.86, "end": 440.86, "text": "末将看得清清楚楚,"}, {"start": 440.86, "end": 442.86, "text": "蜀军确实不多,"}, {"start": 442.86, "end": 444.86, "text": "甚至不到三千。"}, {"start": 444.86, "end": 446.86, "text": "城池周围五十里,"}, {"start": 446.86, "end": 447.86, "text": "你也探查过了?"}, {"start": 447.86, "end": 450.86, "text": "周围的每座山巒都探查过了,"}, {"start": 450.86, "end": 452.86, "text": "确实没有发现蜀军。"}, {"start": 453.86, "end": 456.2, "text": "退下吧。"}, {"start": 456.2, "end": 457.2, "text": "是。"}, {"start": 457.2, "end": 472.63, "text": "蜀上人,"}, {"start": 472.63, "end": 475.63, "text": "急于向朝廷告诫啊。"}, {"start": 475.63, "end": 482.56, "text": "列位将军,"}, {"start": 482.56, "end": 486.9, "text": "谁肯给本都一个面子,"}, {"start": 486.9, "end": 488.9, "text": "灭了武都的蜀军?"}, {"start": 488.9, "end": 492.18, "text": "末将愿望。"}, {"start": 492.18, "end": 495.64, "text": "好,孙离,"}, {"start": 495.64, "end": 498.64, "text": "不愧为奋威将军。"}, {"start": 498.64, "end": 502.02, "text": "我给你三千人马,"}, {"start": 502.02, "end": 503.02, "text": "条件是,"}, {"start": 503.02, "end": 505.02, "text": "拿下武都,"}, {"start": 505.02, "end": 507.02, "text": "赏金封侯。"}, {"start": 507.02, "end": 509.02, "text": "如果攻不下武都城,"}, {"start": 509.02, "end": 511.02, "text": "就不要回来见本都了。"}, {"start": 511.02, "end": 512.02, "text": "遵命。"}, {"start": 512.02, "end": 513.02, "text": "退下吧,"}, {"start": 513.02, "end": 519.2, "text": "国怀留下。"}, {"start": 519.2, "end": 541.17, "text": "营长的军师手下留情,"}, {"start": 541.17, "end": 543.17, "text": "在下已无大碍。"}, {"start": 543.17, "end": 558.89, "text": "办件事吧,"}, {"start": 558.89, "end": 560.89, "text": "不要让将士们知道。"}, {"start": 560.89, "end": 565.86, "text": "为好三千口棺材,"}, {"start": 565.86, "end": 567.86, "text": "孙离回不来了。"}, {"start": 567.86, "end": 570.86, "text": "我不想让他们扑尸山谷。"}, {"start": 570.86, "end": 572.86, "text": "为什么呀?"}, {"start": 572.86, "end": 575.86, "text": "武都城在我大营侧移,"}, {"start": 575.86, "end": 577.86, "text": "蜀军三千人马,"}, {"start": 577.86, "end": 579.86, "text": "岂敢攻城?"}, {"start": 579.86, "end": 582.86, "text": "诸葛亮是诱我出军,"}, {"start": 582.86, "end": 584.86, "text": "半刀伏击罢了。"}, {"start": 584.86, "end": 588.86, "text": "都督既知孙离回不来了,"}, {"start": 588.86, "end": 591.86, "text": "为何还要拆他前去?"}, {"start": 591.86, "end": 593.86, "text": "不救不行啊,"}, {"start": 593.86, "end": 598.2, "text": "不出手相救。"}, {"start": 598.2, "end": 601.2, "text": "一旦武都城陷落,"}, {"start": 601.2, "end": 605.2, "text": "各城的守军就会认定,"}, {"start": 605.2, "end": 607.2, "text": "被围后本都不会救援,"}, {"start": 607.2, "end": 612.34, "text": "他们就会不战自愧。"}, {"start": 612.34, "end": 614.34, "text": "周围几十座城池,"}, {"start": 614.34, "end": 616.34, "text": "就会相继陷落。"}, {"start": 616.34, "end": 618.34, "text": "到那时,"}, {"start": 618.34, "end": 621.34, "text": "军中大营该如何支撑啊?"}, {"start": 621.34, "end": 626.13, "text": "孙离重用啊,"}, {"start": 626.13, "end": 631.37, "text": "是才我提到救援武都城,"}, {"start": 631.37, "end": 635.51, "text": "他开然请命,"}, {"start": 635.51, "end": 637.51, "text": "虽说我不好当面点破,"}, {"start": 637.51, "end": 639.51, "text": "但一想到这样的勇将,"}, {"start": 639.51, "end": 641.51, "text": "有去无回,"}, {"start": 641.51, "end": 648.19, "text": "我,我心痛欲裂。"}, {"start": 648.19, "end": 654.06, "text": "请再赐我三千军,"}, {"start": 654.06, "end": 656.06, "text": "我前去接应孙离,"}, {"start": 656.06, "end": 662.7, "text": "定能设法将他救出。"}, {"start": 662.7, "end": 663.7, "text": "敢亲赴险,"}, {"start": 663.7, "end": 666.59, "text": "再多打造三千棺,"}, {"start": 666.59, "end": 670.54, "text": "死又何惧,"}, {"start": 670.54, "end": 675.63, "text": "你先去吧,"}, {"start": 675.63, "end": 677.63, "text": "我不会让你死的。"}, {"start": 677.63, "end": 701.13, "text": "前面势力就是武都,"}, {"start": 701.13, "end": 703.13, "text": "蜀军正在击攻县城。"}, {"start": 703.13, "end": 704.13, "text": "再探!"}, {"start": 704.13, "end": 705.13, "text": "诺!"}, {"start": 705.13, "end": 706.13, "text": "驾!"}, {"start": 706.13, "end": 708.13, "text": "弟兄们!"}, {"start": 708.13, "end": 710.13, "text": "为国尽忠!"}, {"start": 710.13, "end": 713.13, "text": "扬我军威的时候到了!"}, {"start": 713.13, "end": 715.13, "text": "跟我冲!"}, {"start": 715.13, "end": 731.3, "text": "我代大将魏延,"}, {"start": 731.3, "end": 733.3, "text": "丞相差我在此等候多时,"}, {"start": 733.3, "end": 735.3, "text": "两儿等小贼也非我对手,"}, {"start": 735.3, "end": 737.3, "text": "快快下马收降吧!"}, {"start": 737.3, "end": 738.3, "text": "魏延!"}, {"start": 739.3, "end": 741.3, "text": "我孙离专斩大将!"}, {"start": 741.3, "end": 743.3, "text": "你拿命来吧!"}, {"start": 743.3, "end": 744.3, "text": "放箭!"}, {"start": 746.3, "end": 751.91, "text": "杀!"}, {"start": 751.91, "end": 781.43, "text": "休跑了贼将!"}, {"start": 781.43, "end": 782.43, "text": "弟兄们!"}, {"start": 782.43, "end": 793.67, "text": "郭将军!"}, {"start": 793.67, "end": 794.67, "text": "你来得正好!"}, {"start": 794.67, "end": 795.67, "text": "随我杀出去!"}, {"start": 795.67, "end": 838.95, "text": "魏军败逃了。"}, {"start": 838.95, "end": 840.95, "text": "你斩获如何呀?"}, {"start": 840.95, "end": 844.16, "text": "魏将孙离,"}, {"start": 844.16, "end": 847.16, "text": "因三千兵马援救武都城,"}, {"start": 847.16, "end": 849.16, "text": "被我斩杀了两千多,"}, {"start": 849.16, "end": 852.16, "text": "眼看着就要擒杀孙离了。"}, {"start": 852.16, "end": 854.16, "text": "不料副都督郭怀凌军杀除,"}, {"start": 854.16, "end": 856.16, "text": "救回了孙离。"}, {"start": 856.16, "end": 859.47, "text": "我是没想到,"}, {"start": 859.47, "end": 861.47, "text": "冤军背后,"}, {"start": 861.47, "end": 866.96, "text": "他还有一股冤军。"}, {"start": 866.96, "end": 869.96, "text": "司马已猜破了我的用心啊。"}, {"start": 869.96, "end": 871.96, "text": "丞相,"}, {"start": 871.96, "end": 873.96, "text": "此话怎讲?"}, {"start": 873.96, "end": 877.96, "text": "我让你在武都应评围城大元,"}, {"start": 877.96, "end": 880.96, "text": "此等肤浅的计谋,"}, {"start": 880.96, "end": 883.96, "text": "哪怕是一个初战之将都能看出来,"}, {"start": 883.96, "end": 886.96, "text": "司马已岂能看不出来?"}, {"start": 886.96, "end": 889.96, "text": "他如果弃城不救,"}, {"start": 889.96, "end": 892.96, "text": "那么远近及时坐城一里的魏军,"}, {"start": 892.96, "end": 894.96, "text": "如欲我军攻城,"}, {"start": 894.96, "end": 895.96, "text": "定会绝望,"}, {"start": 895.96, "end": 898.96, "text": "甚至将会现城来降。"}, {"start": 898.96, "end": 900.96, "text": "可是司马已不舍城池,"}, {"start": 900.96, "end": 902.96, "text": "他必定派军来救了呀!"}, {"start": 902.96, "end": 905.96, "text": "派个莽夫孙离来救武都,"}, {"start": 905.96, "end": 907.96, "text": "再派副都督来救孙离,"}, {"start": 907.96, "end": 910.96, "text": "前者摆明了是假救,"}, {"start": 910.96, "end": 914.96, "text": "做给其他城一魏军守将看的,"}, {"start": 914.96, "end": 917.96, "text": "后者才是真救。"}, {"start": 917.96, "end": 921.98, "text": "可司马已,"}, {"start": 921.98, "end": 924.98, "text": "他不会亲自率大军来援的。"}, {"start": 924.98, "end": 927.98, "text": "司马已这只老狐狸。"}, {"start": 927.98, "end": 930.98, "text": "没有湘儿是诱不到他的。"}, {"start": 930.98, "end": 932.98, "text": "丞相,"}, {"start": 932.98, "end": 935.98, "text": "想以谁为儿啊?"}, {"start": 935.98, "end": 939.57, "text": "我啊。"}, {"start": 939.57, "end": 943.98, "text": "司马已做梦都想娶我的少级。"}, {"start": 943.98, "end": 949.3, "text": "魏延哪?"}, {"start": 949.3, "end": 951.3, "text": "在。"}, {"start": 951.3, "end": 953.3, "text": "你这就回营去,"}, {"start": 953.3, "end": 957.96, "text": "整顿兵马准备出战。"}, {"start": 957.96, "end": 959.96, "text": "明天一早,"}, {"start": 959.96, "end": 962.96, "text": "你带五千军护我去武都府宁。"}, {"start": 962.96, "end": 964.96, "text": "丞相,这太危险了吧?"}, {"start": 964.96, "end": 965.96, "text": "丞相,"}, {"start": 965.96, "end": 967.96, "text": "如果司马一情场而出,"}, {"start": 967.96, "end": 974.32, "text": "到那个时候在下根本来不及援救你呀。"}, {"start": 974.32, "end": 976.32, "text": "生死自有天命。"}, {"start": 976.32, "end": 985.0, "text": "遵命。"}, {"start": 985.0, "end": 1028.78, "text": "大都督,"}, {"start": 1028.78, "end": 1031.78, "text": "中个量引军朝武都方向去了。"}, {"start": 1031.78, "end": 1032.78, "text": "来人哪?"}, {"start": 1032.78, "end": 1033.78, "text": "在!"}, {"start": 1033.78, "end": 1036.19, "text": "把此人推下去,"}, {"start": 1036.19, "end": 1037.19, "text": "斩首。"}, {"start": 1037.19, "end": 1038.19, "text": "诺!"}, {"start": 1038.19, "end": 1039.19, "text": "大都督,你为何要杀我呀?"}, {"start": 1039.19, "end": 1043.3, "text": "因为你谎报军情,"}, {"start": 1043.3, "end": 1045.3, "text": "本都最恨人说谎。"}, {"start": 1045.3, "end": 1046.3, "text": "大都督,"}, {"start": 1046.3, "end": 1047.3, "text": "小的万万没有说谎,"}, {"start": 1047.3, "end": 1049.3, "text": "小的亲眼看见了诸葛亮。"}, {"start": 1049.3, "end": 1051.3, "text": "是吗?"}, {"start": 1051.3, "end": 1054.3, "text": "诸葛亮身高极许,"}, {"start": 1054.3, "end": 1055.3, "text": "穿什么衣裳,"}, {"start": 1055.3, "end": 1057.3, "text": "骑马还是坐车,"}, {"start": 1057.3, "end": 1059.3, "text": "身边护卫是谁?"}, {"start": 1059.3, "end": 1062.3, "text": "随行有多少军马,"}, {"start": 1062.3, "end": 1063.3, "text": "不许犹豫,"}, {"start": 1063.3, "end": 1065.3, "text": "马上就说。"}, {"start": 1065.3, "end": 1067.3, "text": "诸葛亮羽裳关机,"}, {"start": 1067.3, "end": 1068.3, "text": "坐在一辆四轮车中,"}, {"start": 1068.3, "end": 1070.3, "text": "因此看不出身高极许,"}, {"start": 1070.3, "end": 1071.3, "text": "护卫将军是姜维,"}, {"start": 1071.3, "end": 1073.3, "text": "身高六尺有余,"}, {"start": 1073.3, "end": 1075.3, "text": "随行兵马大约有五千左右,"}, {"start": 1075.3, "end": 1076.3, "text": "小的一直跟了二十多里,"}, {"start": 1076.3, "end": 1078.3, "text": "亲眼看着诸葛亮进入城中。"}, {"start": 1078.3, "end": 1090.1, "text": "你非但没有说谎,"}, {"start": 1090.1, "end": 1092.1, "text": "反而胆大信息,"}, {"start": 1092.1, "end": 1096.11, "text": "本都升你为军前校尉,"}, {"start": 1096.11, "end": 1098.11, "text": "赏钱三千。"}, {"start": 1098.11, "end": 1100.11, "text": "谢谢大都督!"}, {"start": 1100.11, "end": 1102.11, "text": "谢大都督!"}, {"start": 1102.11, "end": 1104.11, "text": "谢大都督!"}, {"start": 1104.11, "end": 1123.61, "text": "这是真的吗?"}, {"start": 1123.61, "end": 1126.61, "text": "诸葛亮离开大营去武都?"}, {"start": 1126.61, "end": 1128.61, "text": "我琢磨诸葛亮有几年了,"}, {"start": 1128.61, "end": 1132.21, "text": "有一个习惯,"}, {"start": 1132.21, "end": 1135.29, "text": "每下一城,"}, {"start": 1135.29, "end": 1136.29, "text": "每得一郡,"}, {"start": 1136.29, "end": 1138.29, "text": "他都要亲自迁往,"}, {"start": 1138.29, "end": 1140.29, "text": "抚慰官民百姓。"}, {"start": 1140.29, "end": 1142.89, "text": "不错,"}, {"start": 1142.89, "end": 1144.89, "text": "我也听说诸葛亮,"}, {"start": 1144.89, "end": 1146.89, "text": "势必攻亲,"}, {"start": 1146.89, "end": 1151.99, "text": "是擒杀诸葛亮的良机啊!"}, {"start": 1151.99, "end": 1153.99, "text": "武都小城一座,"}, {"start": 1153.99, "end": 1155.99, "text": "易攻难守,"}, {"start": 1155.99, "end": 1157.99, "text": "我即刻在两万经济前去,"}, {"start": 1157.99, "end": 1159.99, "text": "明日凌晨便可赶到武都,"}, {"start": 1159.99, "end": 1160.99, "text": "日落之前,"}, {"start": 1160.99, "end": 1162.99, "text": "便能擒杀诸葛亮。"}, {"start": 1162.99, "end": 1166.43, "text": "武都虽说是座小城,"}, {"start": 1166.43, "end": 1174.85, "text": "这山里面若是藏匿几万大军,"}, {"start": 1174.85, "end": 1176.85, "text": "也会不留痕迹。"}, {"start": 1176.85, "end": 1179.16, "text": "别忘了,"}, {"start": 1179.16, "end": 1182.16, "text": "魏妍就在这儿打过一次埋伏。"}, {"start": 1182.16, "end": 1185.16, "text": "大都督所虑极是,"}, {"start": 1185.16, "end": 1186.16, "text": "上一次,"}, {"start": 1186.16, "end": 1190.16, "text": "诸葛亮拿武都城做诱饵,"}, {"start": 1190.16, "end": 1192.16, "text": "这一次他的诱饵,"}, {"start": 1192.16, "end": 1194.16, "text": "是他自己。"}, {"start": 1194.16, "end": 1196.16, "text": "诸葛亮如此胆大,"}, {"start": 1196.16, "end": 1198.16, "text": "真是令人佩服啊!"}, {"start": 1198.16, "end": 1216.3, "text": "诸葛亮是不是就是搬起石头,"}, {"start": 1216.3, "end": 1217.3, "text": "砸自己的脚?"}, {"start": 1217.3, "end": 1219.3, "text": "这世上太聪明的人,"}, {"start": 1219.3, "end": 1222.3, "text": "往往会被聪明所误。"}, {"start": 1222.3, "end": 1224.3, "text": "明白了,"}, {"start": 1224.3, "end": 1226.3, "text": "我们不必追杀诸葛亮,"}, {"start": 1226.3, "end": 1228.3, "text": "而是要杀他个回马枪,"}, {"start": 1228.3, "end": 1230.3, "text": "直击蜀军大营。"}, {"start": 1230.3, "end": 1233.3, "text": "将军不愧为九经沙场,"}, {"start": 1233.3, "end": 1235.3, "text": "一眼就看破要害。"}, {"start": 1235.3, "end": 1239.3, "text": "蜀军的粮草资重都在大营,"}, {"start": 1239.3, "end": 1242.3, "text": "那才是他们的命根子。"}, {"start": 1242.3, "end": 1245.3, "text": "我军要是趁虚攻陷他,"}, {"start": 1245.3, "end": 1247.3, "text": "一把火烧了他,"}, {"start": 1247.3, "end": 1251.3, "text": "诸葛亮的蜀军就会土崩瓦解。"}, {"start": 1251.3, "end": 1253.3, "text": "禀大都董,"}, {"start": 1253.3, "end": 1256.3, "text": "此役轮到我张河出战了,"}, {"start": 1256.3, "end": 1258.3, "text": "我愿带领两万精兵,"}, {"start": 1258.3, "end": 1260.3, "text": "直击蜀军大营。"}, {"start": 1260.3, "end": 1266.14, "text": "将军是大魏三朝老将,"}, {"start": 1266.14, "end": 1268.14, "text": "名扬天下,"}, {"start": 1268.14, "end": 1269.14, "text": "此役,"}, {"start": 1269.14, "end": 1271.14, "text": "还是让后生们去战吧。"}, {"start": 1271.14, "end": 1273.14, "text": "我久不上阵,"}, {"start": 1273.14, "end": 1276.14, "text": "侠中宝剑只知作响,"}, {"start": 1276.14, "end": 1278.14, "text": "浑身骨头,"}, {"start": 1278.14, "end": 1279.14, "text": "村养难忍,"}, {"start": 1279.14, "end": 1281.14, "text": "我非上阵不可。"}, {"start": 1281.14, "end": 1289.96, "text": "就请将军督战,"}, {"start": 1289.96, "end": 1292.96, "text": "不必亲自遇敌厮杀。"}, {"start": 1292.96, "end": 1317.36, "text": "杀大营,杀!"}, {"start": 1317.36, "end": 1478.33, "text": "十年前,"}, {"start": 1478.33, "end": 1558.12, "text": "前方便是剑壳道,"}, {"start": 1558.12, "end": 1560.12, "text": "两面都是绝壁。"}, {"start": 1560.12, "end": 1562.12, "text": "你带两千工奴手前去埋伏,"}, {"start": 1562.12, "end": 1564.12, "text": "我让卫炎罔开一面,"}, {"start": 1564.12, "end": 1566.12, "text": "把张河引入剑壳,"}, {"start": 1566.12, "end": 1570.36, "text": "他活着出来。"}, {"start": 1570.36, "end": 1571.36, "text": "诺!"}, {"start": 1571.36, "end": 1594.44, "text": "什么地方?"}, {"start": 1594.44, "end": 1596.44, "text": "如此一森,"}, {"start": 1596.44, "end": 1606.7, "text": "念你年老,"}, {"start": 1606.7, "end": 1608.7, "text": "我且问你一句,"}, {"start": 1608.7, "end": 1610.7, "text": "详是不详?"}, {"start": 1610.7, "end": 1675.02, "text": "我垂钓高手了,"}, {"start": 1675.02, "end": 1690.88, "text": "可这世上哪有这样下钩的呀?"}, {"start": 1690.88, "end": 1692.88, "text": "尔在武都那边,"}, {"start": 1692.88, "end": 1694.88, "text": "高雪安在了大营这头。"}, {"start": 1694.88, "end": 1699.92, "text": "张河将军,"}, {"start": 1699.92, "end": 1704.3, "text": "身中三十七剑啊!"}, {"start": 1706.3, "end": 1725.84, "text": "我军士气却复活了,"}, {"start": 1725.84, "end": 1729.22, "text": "知道吗?"}, {"start": 1730.22, "end": 1733.22, "text": "张河将军带去的两万精兵,"}, {"start": 1733.22, "end": 1735.22, "text": "没有一人临阵脱逃,"}, {"start": 1735.22, "end": 1738.56, "text": "这就是我军的胜利!"}, {"start": 1738.56, "end": 1742.13, "text": "军心如铁,"}, {"start": 1742.13, "end": 1746.78, "text": "何愁蜀军不败?"}, {"start": 1746.78, "end": 1748.78, "text": "司马昭!"}, {"start": 1748.78, "end": 1750.78, "text": "杀了本都作计,"}, {"start": 1750.78, "end": 1751.78, "text": "剥下马皮来,"}, {"start": 1751.78, "end": 1753.78, "text": "包裹张将军的尸首!"}, {"start": 1753.78, "end": 1755.78, "text": "本都要率三军为他送行!"}, {"start": 1755.78, "end": 1758.26, "text": "遵命!"}, {"start": 1758.26, "end": 1805.11, "text": "丞相,"}, {"start": 1805.11, "end": 1809.54, "text": "末将太营回来了。"}, {"start": 1809.54, "end": 1810.54, "text": "情况如何呀?"}, {"start": 1810.54, "end": 1812.54, "text": "卫军他们身沟高雷,"}, {"start": 1812.54, "end": 1814.54, "text": "丝马衣确实不同于曹真。"}, {"start": 1814.54, "end": 1816.54, "text": "曹真打了败仗,"}, {"start": 1816.54, "end": 1818.54, "text": "上下皆尸昏落魄,"}, {"start": 1818.54, "end": 1820.54, "text": "可司马衣打了败仗,"}, {"start": 1820.54, "end": 1822.54, "text": "却不见一丝乱象。"}, {"start": 1822.54, "end": 1824.54, "text": "丞相!"}, {"start": 1824.54, "end": 1826.54, "text": "大将军,"}, {"start": 1826.54, "end": 1828.54, "text": "在下拟了这幅药方之后,"}, {"start": 1828.54, "end": 1858.86, "text": "还要带一份回去承宇陛下看的。"}, {"start": 1858.86, "end": 1860.86, "text": "请问大将军,"}, {"start": 1860.86, "end": 1862.86, "text": "我是依照病情止血呢,"}, {"start": 1862.86, "end": 1864.86, "text": "还是..."}, {"start": 1864.86, "end": 1866.86, "text": "若是优劣,"}, {"start": 1866.86, "end": 1868.86, "text": "我会尽力尽力,"}, {"start": 1868.86, "end": 1870.86, "text": "但是,"}, {"start": 1870.86, "end": 1872.86, "text": "若是有我的病情,"}, {"start": 1872.86, "end": 1874.86, "text": "你看,"}, {"start": 1874.86, "end": 1876.86, "text": "该如何开这个药方?"}, {"start": 1878.86, "end": 1880.86, "text": "若是依照大将军的病情,"}, {"start": 1880.86, "end": 1882.86, "text": "在下就不用开药了。"}, {"start": 1882.86, "end": 1884.86, "text": "不可!"}, {"start": 1884.86, "end": 1888.53, "text": "万万不可!"}, {"start": 1890.53, "end": 1892.53, "text": "你还是赶紧开这个药方吧。"}, {"start": 1892.53, "end": 1894.53, "text": "只是这药方要开得重一点,"}, {"start": 1894.53, "end": 1896.53, "text": "才能拿回洛阳,"}, {"start": 1896.53, "end": 1898.53, "text": "承越陛下。"}, {"start": 1900.53, "end": 1902.53, "text": "那可不好办了。"}, {"start": 1902.53, "end": 1904.53, "text": "陛下若是知道"}, {"start": 1904.53, "end": 1906.53, "text": "在下作假,"}, {"start": 1906.53, "end": 1908.53, "text": "那还了得。"}, {"start": 1908.53, "end": 1910.53, "text": "我的病情除了足下,"}, {"start": 1910.53, "end": 1912.53, "text": "神不知归不效。"}, {"start": 1912.53, "end": 1914.53, "text": "陛下如何会知道?"}, {"start": 1918.53, "end": 1923.02, "text": "来人哪!"}, {"start": 1923.02, "end": 1930.66, "text": "这是..."}, {"start": 1930.66, "end": 1932.66, "text": "多谢大将军。"}, {"start": 1932.66, "end": 1936.7, "text": "陛下若是看了"}, {"start": 1936.7, "end": 1938.7, "text": "这幅药方,"}, {"start": 1938.7, "end": 1940.7, "text": "我准定赐予大将军"}, {"start": 1940.7, "end": 1944.98, "text": "半年的假期。"}, {"start": 1944.98, "end": 1946.98, "text": "半年?"}, {"start": 1946.98, "end": 1951.22, "text": "多谢了。"}, {"start": 1951.22, "end": 1955.36, "text": "请大将军过目。"}, {"start": 1955.36, "end": 1957.36, "text": "算了。"}, {"start": 1957.36, "end": 1959.36, "text": "爽儿,"}, {"start": 1959.36, "end": 1961.36, "text": "送柳大人。"}, {"start": 1961.36, "end": 1965.95, "text": "诺。"}, {"start": 1965.95, "end": 1969.39, "text": "将军,"}, {"start": 1969.39, "end": 1975.3, "text": "龙启军报到了。"}, {"start": 1975.3, "end": 1977.3, "text": "父亲,"}, {"start": 1977.3, "end": 1979.3, "text": "喜事啊!"}, {"start": 1979.3, "end": 1981.3, "text": "什么喜事啊?"}, {"start": 1981.3, "end": 1983.3, "text": "你怎么弄成这个模样啊?"}, {"start": 1983.3, "end": 1985.3, "text": "司马医中了诸葛亮的诱敌之计,"}, {"start": 1985.3, "end": 1987.3, "text": "吃了大败,"}, {"start": 1987.3, "end": 1989.3, "text": "损军两万多。"}, {"start": 1989.3, "end": 1991.3, "text": "此外,"}, {"start": 1991.3, "end": 1993.3, "text": "大将军张和也因为司马医之过,"}, {"start": 1993.3, "end": 1997.31, "text": "不幸阵亡。"}, {"start": 1997.31, "end": 1999.31, "text": "张和被司马医害死了?"}, {"start": 1999.31, "end": 2001.31, "text": "正是。"}, {"start": 2001.31, "end": 2003.31, "text": "父亲啊,"}, {"start": 2003.31, "end": 2005.31, "text": "你常说司马医深明兵法,"}, {"start": 2005.31, "end": 2007.31, "text": "而看不尽然。"}, {"start": 2007.31, "end": 2009.31, "text": "这一战,"}, {"start": 2009.31, "end": 2016.34, "text": "他不是败得比你更惨吗?"}, {"start": 2016.34, "end": 2018.34, "text": "张和,"}, {"start": 2018.34, "end": 2020.34, "text": "损失了两万多兵马。"}, {"start": 2020.34, "end": 2022.34, "text": "他损失了两万多兵马。"}, {"start": 2022.34, "end": 2024.34, "text": "父亲,"}, {"start": 2024.34, "end": 2026.34, "text": "行。"}, {"start": 2026.34, "end": 2028.34, "text": "去!"}, {"start": 2028.34, "end": 2030.34, "text": "司马医啊!"}, {"start": 2030.34, "end": 2032.34, "text": "中达!"}, {"start": 2032.34, "end": 2036.13, "text": "你不会也是一个败军之将啊!"}, {"start": 2036.13, "end": 2038.13, "text": "爽儿,"}, {"start": 2038.13, "end": 2040.13, "text": "我即刻写到奏者,你星夜赶往洛阳承认陛下。"}, {"start": 2040.13, "end": 2042.13, "text": "父亲是要弹劾司马医。"}, {"start": 2042.13, "end": 2046.59, "text": "我不光要弹劾他,"}, {"start": 2046.59, "end": 2050.77, "text": "我要夺回大都督之权。"}, {"start": 2050.77, "end": 2052.77, "text": "快把医官拦下,"}, {"start": 2052.77, "end": 2054.77, "text": "把他手里那个药方拿回来,快!"}, {"start": 2054.77, "end": 2056.77, "text": "刘大人!"}, {"start": 2056.77, "end": 2060.98, "text": "刘大人!"}, {"start": 2060.98, "end": 2062.98, "text": "司马医长军以来,一直消极避战。"}, {"start": 2062.98, "end": 2064.98, "text": "都三个月了,他总共只打两仗。"}, {"start": 2064.98, "end": 2066.98, "text": "第一仗,失了五度等程。"}, {"start": 2066.98, "end": 2068.98, "text": "第二仗,折损近兵两万多。"}, {"start": 2068.98, "end": 2070.98, "text": "连老将军张和,"}, {"start": 2070.98, "end": 2072.98, "text": "都依司马医指挥失误,"}, {"start": 2072.98, "end": 2074.98, "text": "不幸阵亡。"}, {"start": 2074.98, "end": 2076.98, "text": "老将军身重三十七件哪。"}, {"start": 2076.98, "end": 2078.98, "text": "曹真有何建议?"}, {"start": 2078.98, "end": 2080.98, "text": "家父身上的伤病基本痊愈。"}, {"start": 2080.98, "end": 2082.98, "text": "但心中之痛,仍然痛不可当。"}, {"start": 2082.98, "end": 2084.98, "text": "家父日夜都在为朝廷的安危担忧啊。"}, {"start": 2086.98, "end": 2088.98, "text": "家父托儿臣向陛下请命,"}, {"start": 2088.98, "end": 2090.98, "text": "想要再次出征,"}, {"start": 2090.98, "end": 2092.98, "text": "以血尘苍之耻,尽忠报国。"}, {"start": 2092.98, "end": 2094.98, "text": "又再拜于诸葛亮呢?"}, {"start": 2094.98, "end": 2096.98, "text": "家父说了,"}, {"start": 2096.98, "end": 2098.98, "text": "若再拜于诸葛亮,"}, {"start": 2098.98, "end": 2100.98, "text": "就不等朝廷下旨,"}, {"start": 2100.98, "end": 2102.98, "text": "自斩于军前。"}, {"start": 2102.98, "end": 2104.98, "text": "好,听着。"}, {"start": 2104.98, "end": 2108.86, "text": "令曹真官复原职,"}, {"start": 2108.86, "end": 2110.86, "text": "再次出任平息大都督。"}, {"start": 2110.86, "end": 2112.86, "text": "前往龙溪长军。"}, {"start": 2112.86, "end": 2114.86, "text": "遵旨。"}, {"start": 2114.86, "end": 2118.3, "text": "陛下,"}, {"start": 2118.3, "end": 2120.3, "text": "那司马仪,"}, {"start": 2120.3, "end": 2122.3, "text": "该如何处置?"}, {"start": 2122.3, "end": 2124.3, "text": "你有何建议?"}, {"start": 2124.3, "end": 2126.3, "text": "陛下,"}, {"start": 2126.3, "end": 2128.3, "text": "司马仪先是拒敌必战,"}, {"start": 2128.3, "end": 2130.3, "text": "后则损兵折将。"}, {"start": 2130.3, "end": 2132.3, "text": "朝廷应该明正典型啊。"}, {"start": 2132.3, "end": 2134.3, "text": "你父亲战败的时候,"}, {"start": 2134.3, "end": 2136.3, "text": "明正典型了吗?"}, {"start": 2136.3, "end": 2139.65, "text": "听旨。"}, {"start": 2139.65, "end": 2141.65, "text": "命司马仪为平息副都督,"}, {"start": 2141.65, "end": 2143.65, "text": "协同曹真长军。"}, {"start": 2143.65, "end": 2145.65, "text": "二人尽事前嫌,"}, {"start": 2145.65, "end": 2147.65, "text": "共聚大敌。"}, {"start": 2147.65, "end": 2149.65, "text": "钦此。"}, {"start": 2149.65, "end": 2171.33, "text": "人接旨。"}, {"start": 2171.33, "end": 2173.33, "text": "我费尽心机,"}, {"start": 2173.33, "end": 2175.33, "text": "稳固了几十万军心,"}, {"start": 2175.33, "end": 2177.33, "text": "稳固了大魏防务,"}, {"start": 2177.33, "end": 2180.96, "text": "却无法稳固"}, {"start": 2180.96, "end": 2182.96, "text": "朝廷对我的信任啊。"}, {"start": 2182.96, "end": 2184.96, "text": "父亲,"}, {"start": 2184.96, "end": 2186.96, "text": "如果你比那个曹真当副都督,"}, {"start": 2186.96, "end": 2188.96, "text": "那,"}, {"start": 2188.96, "end": 2190.96, "text": "那是大吃大辱啊,父亲。"}, {"start": 2190.96, "end": 2192.96, "text": "何况,曹真肯定会陷害你。"}, {"start": 2192.96, "end": 2194.96, "text": "我已经给陷害了,"}, {"start": 2194.96, "end": 2196.96, "text": "还能怎么陷害?"}, {"start": 2196.96, "end": 2201.33, "text": "你比如说,"}, {"start": 2201.33, "end": 2203.33, "text": "朱国良只会在"}, {"start": 2203.33, "end": 2205.33, "text": "战场上跟你相敌,"}, {"start": 2205.33, "end": 2207.33, "text": "可曹真呢,"}, {"start": 2207.33, "end": 2209.33, "text": "却会在背后释放暗箭呢。"}, {"start": 2209.33, "end": 2227.52, "text": "不合作。"}, {"start": 2227.52, "end": 2229.52, "text": "跟曹真换个位置。"}, {"start": 2229.52, "end": 2231.52, "text": "既然曹真离开雍良前来长军,"}, {"start": 2231.52, "end": 2233.52, "text": "那父亲就离开军营回雍良去。"}, {"start": 2233.52, "end": 2235.52, "text": "我看不守两个月,"}, {"start": 2235.52, "end": 2237.52, "text": "他又会兵败,又会被陛下撤回。"}, {"start": 2237.52, "end": 2248.1, "text": "大都督,"}, {"start": 2248.1, "end": 2250.1, "text": "你千万不能走啊。"}, {"start": 2250.1, "end": 2252.1, "text": "大都督,"}, {"start": 2252.1, "end": 2254.1, "text": "大都督,千万不能走啊。"}, {"start": 2254.1, "end": 2259.1, "text": "钟达兄,"}, {"start": 2259.1, "end": 2261.1, "text": "你是军心所在,"}, {"start": 2261.1, "end": 2263.1, "text": "唯你才能抵挡朱国良。"}, {"start": 2263.1, "end": 2265.1, "text": "你容易走了之,"}, {"start": 2265.1, "end": 2267.1, "text": "军心,"}, {"start": 2267.1, "end": 2269.1, "text": "又散了。"}, {"start": 2269.1, "end": 2271.1, "text": "不管朝廷怎么对你,"}, {"start": 2271.1, "end": 2273.1, "text": "在我们心中,"}, {"start": 2273.1, "end": 2275.1, "text": "只有你是大都督,"}, {"start": 2275.1, "end": 2277.1, "text": "我们永远听你的军令。"}, {"start": 2277.1, "end": 2279.1, "text": "多谢各位将军。"}, {"start": 2279.1, "end": 2281.1, "text": "多谢。"}, {"start": 2281.1, "end": 2284.9, "text": "我不走。"}, {"start": 2284.9, "end": 2297.3, "text": "不走咱们也得迎接曹真大都督啊。"}, {"start": 2297.3, "end": 2315.42, "text": "停。"}, {"start": 2315.42, "end": 2320.72, "text": "平西副都督司马怡,"}, {"start": 2320.72, "end": 2322.72, "text": "恭迎大将军,"}, {"start": 2322.72, "end": 2329.17, "text": "大都督。"}, {"start": 2329.17, "end": 2331.17, "text": "钟达,"}, {"start": 2331.17, "end": 2335.7, "text": "好久不见,可好吗?"}, {"start": 2335.7, "end": 2337.7, "text": "尚好,尚好。"}, {"start": 2337.7, "end": 2339.7, "text": "我听人说,"}, {"start": 2339.7, "end": 2341.7, "text": "你宁可负贤,"}, {"start": 2341.7, "end": 2343.7, "text": "也不肯做人家的副职。"}, {"start": 2343.7, "end": 2345.7, "text": "这回怎么愿意驱居副都督了?"}, {"start": 2347.7, "end": 2349.7, "text": "回大都督话,"}, {"start": 2349.7, "end": 2351.7, "text": "如不做副都督,"}, {"start": 2351.7, "end": 2353.7, "text": "有人就会上奏朝廷。"}, {"start": 2353.7, "end": 2358.03, "text": "那司马怡脑袋就掉了。"}, {"start": 2364.03, "end": 2366.03, "text": "那就让她先在你的脖子上长着吧。"}, {"start": 2368.03, "end": 2370.03, "text": "如不遵本都军令,"}, {"start": 2370.03, "end": 2372.03, "text": "再让她掉下来不迟。"}, {"start": 2372.03, "end": 2374.03, "text": "在下必遵军令,"}, {"start": 2374.03, "end": 2376.03, "text": "也都依从大都督。"}, {"start": 2376.03, "end": 2378.03, "text": "真的?"}, {"start": 2378.03, "end": 2380.03, "text": "千真万确,"}, {"start": 2380.03, "end": 2400.37, "text": "大都督日后便知。"}, {"start": 2400.37, "end": 2402.37, "text": "金油,了不得呀。"}, {"start": 2402.37, "end": 2404.37, "text": "这个帅案,"}, {"start": 2404.37, "end": 2406.37, "text": "好堂皇,"}, {"start": 2406.37, "end": 2408.37, "text": "好气派。"}, {"start": 2408.37, "end": 2410.37, "text": "简直比圣上的龙案都大。"}, {"start": 2412.37, "end": 2414.37, "text": "各位将军,"}, {"start": 2416.37, "end": 2418.37, "text": "本都奉旨长君,"}, {"start": 2418.37, "end": 2420.37, "text": "陛下对各位"}, {"start": 2420.37, "end": 2422.37, "text": "深怀厚望。"}, {"start": 2422.37, "end": 2424.37, "text": "可是数月来,"}, {"start": 2424.37, "end": 2426.37, "text": "我军一直"}, {"start": 2426.37, "end": 2428.37, "text": "深沟高垒,"}, {"start": 2428.37, "end": 2430.37, "text": "消极必战。"}, {"start": 2430.37, "end": 2432.37, "text": "照这样下去,"}, {"start": 2432.37, "end": 2434.37, "text": "何日可以退敌?"}, {"start": 2434.37, "end": 2436.37, "text": "何日可以告慰圣上?"}, {"start": 2438.37, "end": 2440.37, "text": "这不是在作战,"}, {"start": 2440.37, "end": 2442.37, "text": "这是养寇自重。"}, {"start": 2442.37, "end": 2448.69, "text": "听令!"}, {"start": 2448.69, "end": 2450.69, "text": "本都设四条禁军之策,"}, {"start": 2450.69, "end": 2452.69, "text": "半月之内"}, {"start": 2452.69, "end": 2454.69, "text": "大败诸葛亮!"}]