[{"start": 12.94, "end": 16.94, "text": "成相有令,攻进众地,外臣只可到此为止。"}, {"start": 16.94, "end": 20.94, "text": "天子握病了,是才亲召刘备入宫谨安。"}, {"start": 20.94, "end": 22.94, "text": "夜深了,请明日再来吧。"}, {"start": 22.94, "end": 27.94, "text": "我是刘皇叔,天子授我任意出入职权。"}, {"start": 27.94, "end": 29.94, "text": "你们是何许人也,竟敢拦我。"}, {"start": 29.94, "end": 37.72, "text": "闪开,否则我告知曹子,拿你们问罪。"}, {"start": 37.72, "end": 41.63, "text": "报警。"}, {"start": 41.63, "end": 74.26, "text": "皇叔来了。"}, {"start": 74.26, "end": 76.26, "text": "臣刘备拜见董贵妃。"}, {"start": 76.26, "end": 81.05, "text": "为何不见其他皇亲?"}, {"start": 82.05, "end": 86.05, "text": "陛下只召见了你一人。"}, {"start": 86.05, "end": 90.42, "text": "陛下在哪里?兵得重吗?"}, {"start": 91.42, "end": 93.42, "text": "陛下在里间如厕。"}, {"start": 93.42, "end": 95.42, "text": "容臣在此恭候。"}, {"start": 95.42, "end": 102.92, "text": "不,清皇叔也到里间如厕。"}, {"start": 103.92, "end": 110.18, "text": "贵妃让臣如厕见家。"}, {"start": 110.18, "end": 114.66, "text": "清皇叔如厕。"}, {"start": 117.61, "end": 154.46, "text": "陛下,奇怪。"}, {"start": 155.46, "end": 158.46, "text": "宫中到处都是草草的耳目。"}, {"start": 158.46, "end": 161.46, "text": "只有这厕所才是最安全的地方。"}, {"start": 161.46, "end": 167.2, "text": "你看见这个地方了吗?"}, {"start": 167.2, "end": 171.7, "text": "它才是朕真正的地位。"}, {"start": 171.7, "end": 176.7, "text": "只有在这儿,朕才敢说句心里话。"}, {"start": 176.7, "end": 183.15, "text": "臣心如刀枪。"}, {"start": 183.15, "end": 212.69, "text": "朕现在的处境,比前些年好多了。"}, {"start": 217.59, "end": 218.59, "text": "你知道吗?"}, {"start": 218.59, "end": 223.86, "text": "朕从继位的那天起,"}, {"start": 223.86, "end": 226.86, "text": "就沦为董卓的掌中玩物。"}, {"start": 226.86, "end": 230.86, "text": "那时节,董卓祸乱宫廷,"}, {"start": 230.86, "end": 235.86, "text": "奸淫贫废,号称尚服。"}, {"start": 235.86, "end": 237.86, "text": "独掌朝政,"}, {"start": 237.86, "end": 245.28, "text": "朕又落入李国二贼手里。"}, {"start": 245.28, "end": 252.9, "text": "他们更是毒如歇舌,恶如狼啊。"}, {"start": 252.9, "end": 255.9, "text": "在董成国舅的谋划下,"}, {"start": 255.9, "end": 257.9, "text": "他逃出了长安,"}, {"start": 257.9, "end": 278.6, "text": "可却又被曹操挟持到徐昌来了。"}, {"start": 278.6, "end": 280.6, "text": "他从没虐待朕,"}, {"start": 280.6, "end": 282.6, "text": "每月每季,"}, {"start": 282.6, "end": 289.16, "text": "他还献给朕吃用不尽的锦衣玉食。"}, {"start": 289.16, "end": 293.16, "text": "他独把朝政当朕的家做朕的主。"}, {"start": 293.16, "end": 296.16, "text": "他正关在这个金丝笼里,"}, {"start": 296.16, "end": 299.16, "text": "挟天子令诸侯。"}, {"start": 299.16, "end": 302.63, "text": "而且只要时机一到,"}, {"start": 302.63, "end": 304.63, "text": "他必然篡夺帝位,"}, {"start": 304.63, "end": 307.63, "text": "弑君自立啊。"}, {"start": 307.63, "end": 309.63, "text": "皇叔,"}, {"start": 309.63, "end": 311.63, "text": "曹操名为汉相,"}, {"start": 311.63, "end": 313.63, "text": "实为汉贼。"}, {"start": 313.63, "end": 319.28, "text": "董卓不同的是,"}, {"start": 319.28, "end": 321.28, "text": "曹操窃国,"}, {"start": 321.28, "end": 323.28, "text": "不留贼名,"}, {"start": 325.17, "end": 328.17, "text": "对外反而显示出他是汉廷洞内,"}, {"start": 328.17, "end": 330.17, "text": "人为齐天啊。"}, {"start": 330.17, "end": 335.21, "text": "曹贼窃国,"}, {"start": 335.21, "end": 338.21, "text": "比董卓高明千百倍。"}, {"start": 338.21, "end": 341.21, "text": "昨日行猎已足见一般哪。"}, {"start": 341.21, "end": 343.21, "text": "陛下,"}, {"start": 343.21, "end": 344.21, "text": "陛下,"}, {"start": 344.21, "end": 348.86, "text": "臣迟早,"}, {"start": 348.86, "end": 350.86, "text": "定要受任此奸贼,"}, {"start": 350.86, "end": 352.86, "text": "重刑大汉,"}, {"start": 352.86, "end": 363.38, "text": "以报皇恩。"}, {"start": 363.38, "end": 364.38, "text": "就是想告诉你,"}, {"start": 364.38, "end": 371.78, "text": "请皇叔在,"}, {"start": 371.78, "end": 373.78, "text": "牟利英雄大业,"}, {"start": 373.78, "end": 374.78, "text": "匡扶汉氏,"}, {"start": 374.78, "end": 376.78, "text": "拯救天下苍生,"}, {"start": 376.78, "end": 378.78, "text": "高威先帝天灵。"}, {"start": 378.78, "end": 384.37, "text": "朕会另有秘制给你。"}, {"start": 385.68, "end": 386.68, "text": "领旨。"}, {"start": 386.68, "end": 403.33, "text": "受朕一拜。"}, {"start": 403.33, "end": 404.33, "text": "陛下。"}, {"start": 404.33, "end": 411.79, "text": "朕这一拜,"}, {"start": 411.79, "end": 413.79, "text": "不是天子拜成功,"}, {"start": 413.79, "end": 417.23, "text": "而是子侄,"}, {"start": 417.23, "end": 419.23, "text": "拜叔父。"}, {"start": 420.23, "end": 421.23, "text": "陛下。"}, {"start": 435.86, "end": 467.83, "text": "请皇叔擦干眼泪再出去,"}, {"start": 467.83, "end": 470.83, "text": "外面都是草草的卫士。"}, {"start": 500.02, "end": 502.02, "text": "请留皇叔稍候。"}, {"start": 503.02, "end": 504.02, "text": "何事?"}, {"start": 504.02, "end": 506.02, "text": "外官深夜出宫,"}, {"start": 506.02, "end": 508.02, "text": "依律必须搜身。"}, {"start": 508.02, "end": 509.02, "text": "放肆!"}, {"start": 509.02, "end": 511.33, "text": "敢搜我的身,"}, {"start": 511.33, "end": 513.33, "text": "我砍你的头!"}, {"start": 514.33, "end": 515.33, "text": "如果不搜身,"}, {"start": 515.33, "end": 517.33, "text": "陈相也一样会砍了我的头。"}, {"start": 517.33, "end": 518.33, "text": "这是君令,"}, {"start": 518.33, "end": 519.33, "text": "请皇叔体谅。"}, {"start": 519.33, "end": 570.66, "text": "爱妃,"}, {"start": 570.66, "end": 571.66, "text": "来,"}, {"start": 571.66, "end": 575.29, "text": "劳你把这道秘制"}, {"start": 575.29, "end": 577.29, "text": "缝入朕的玉带之中。"}, {"start": 577.29, "end": 579.29, "text": "这两天朕会出宫祭祖,"}, {"start": 579.29, "end": 580.29, "text": "朕便把它交给一位忠臣,"}, {"start": 580.29, "end": 582.29, "text": "让他联络天下英雄,"}, {"start": 582.29, "end": 618.91, "text": "举兵逃贼。"}, {"start": 618.91, "end": 619.91, "text": "禀陈相,"}, {"start": 619.91, "end": 621.91, "text": "陛下前天行列归来,"}, {"start": 621.91, "end": 622.91, "text": "说是受了风寒,"}, {"start": 622.91, "end": 623.91, "text": "病了。"}, {"start": 624.91, "end": 626.91, "text": "这个我知道。"}, {"start": 626.91, "end": 630.54, "text": "不过奇怪的是,"}, {"start": 630.54, "end": 632.54, "text": "陛下今天说病又好了,"}, {"start": 632.54, "end": 634.54, "text": "要去宫城阁祭祖,"}, {"start": 634.54, "end": 638.98, "text": "还带了国舅董成相随。"}, {"start": 638.98, "end": 640.98, "text": "陛下还招了谁?"}, {"start": 640.98, "end": 642.98, "text": "陛下只带了董成一人。"}, {"start": 642.98, "end": 644.98, "text": "两个人目前就在阁里,"}, {"start": 644.98, "end": 645.98, "text": "还没出来。"}, {"start": 645.98, "end": 647.98, "text": "卑职觉得很可疑,"}, {"start": 647.98, "end": 649.98, "text": "所以就立刻前来禀报。"}, {"start": 649.98, "end": 698.15, "text": "董国舅。"}, {"start": 699.15, "end": 700.15, "text": "曹丞相。"}, {"start": 700.15, "end": 703.15, "text": "我听闻陛下在此祭祖,"}, {"start": 703.15, "end": 705.15, "text": "特意赶来与他同祭。"}, {"start": 705.15, "end": 707.15, "text": "陛下还在吗?"}, {"start": 707.15, "end": 709.15, "text": "陛下刚刚祭霸,"}, {"start": 709.15, "end": 710.15, "text": "已经回宫。"}, {"start": 710.15, "end": 712.15, "text": "我正准备离开。"}, {"start": 713.15, "end": 716.15, "text": "我既来此,"}, {"start": 716.15, "end": 718.15, "text": "你还没离开。"}, {"start": 718.15, "end": 720.15, "text": "请你陪陪我,"}, {"start": 720.15, "end": 723.15, "text": "我们一起祭拜皇族。"}, {"start": 724.15, "end": 729.74, "text": "我遵命。"}, {"start": 729.74, "end": 733.05, "text": "国舅,请。"}, {"start": 733.05, "end": 734.05, "text": "丞相,请。"}, {"start": 734.05, "end": 735.05, "text": "国舅。"}, {"start": 755.8, "end": 758.8, "text": "这里真是个上大天意,"}, {"start": 758.8, "end": 760.8, "text": "下通灵溪的好地方。"}, {"start": 760.8, "end": 762.8, "text": "这里真是个上大天意,"}, {"start": 762.8, "end": 764.8, "text": "下通灵溪的好地方。"}, {"start": 765.8, "end": 767.8, "text": "我不明白丞相的意思。"}, {"start": 768.8, "end": 773.11, "text": "陛下单独召你到此,"}, {"start": 773.11, "end": 775.11, "text": "有何秘旨?"}, {"start": 775.11, "end": 777.11, "text": "绝对没有,绝对没有。"}, {"start": 778.11, "end": 780.11, "text": "从进来到出去,"}, {"start": 780.11, "end": 783.11, "text": "陛下没有跟我说过任何话。"}, {"start": 783.11, "end": 784.11, "text": "真的?"}, {"start": 785.11, "end": 789.1, "text": "千真万确。"}, {"start": 789.1, "end": 792.1, "text": "陛下只是赏了我一副玉带。"}, {"start": 792.1, "end": 794.1, "text": "你看看,"}, {"start": 794.1, "end": 796.1, "text": "这不是说过话吗?"}, {"start": 797.1, "end": 799.1, "text": "岂止说话,"}, {"start": 799.1, "end": 801.1, "text": "还赏了你一样东西。"}, {"start": 802.1, "end": 803.1, "text": "我是说,"}, {"start": 803.1, "end": 806.1, "text": "陛下并没有受我任何秘旨。"}, {"start": 807.1, "end": 808.1, "text": "就是他?"}, {"start": 809.1, "end": 810.1, "text": "对。"}, {"start": 811.1, "end": 814.1, "text": "赶紧国舅把他解下来,"}, {"start": 814.1, "end": 821.1, "text": "让我细细地观赏他吧。"}, {"start": 821.1, "end": 842.22, "text": "可以。"}, {"start": 842.22, "end": 843.22, "text": "合适吗?"}, {"start": 843.22, "end": 846.5, "text": "合适。"}, {"start": 847.5, "end": 849.5, "text": "我也觉得合适。"}, {"start": 850.5, "end": 853.5, "text": "我看这根带子扎在我身上,"}, {"start": 853.5, "end": 856.5, "text": "比扎在国舅身上更合适。"}, {"start": 857.5, "end": 858.5, "text": "你说对不对?"}, {"start": 858.5, "end": 862.5, "text": "对。"}, {"start": 863.5, "end": 864.5, "text": "那么,"}, {"start": 864.5, "end": 866.5, "text": "草某就厚着脸皮,"}, {"start": 867.5, "end": 869.5, "text": "请国舅把他转赠给我。"}, {"start": 875.24, "end": 877.24, "text": "丞相拿去吧。"}, {"start": 877.24, "end": 879.24, "text": "国舅真的答应了?"}, {"start": 879.24, "end": 882.45, "text": "我答应了。"}, {"start": 882.45, "end": 883.45, "text": "真舍得,"}, {"start": 884.45, "end": 885.45, "text": "我舍得。"}, {"start": 892.18, "end": 896.84, "text": "草某豈敢多人所爱。"}, {"start": 896.84, "end": 898.84, "text": "尤其是此物,"}, {"start": 898.84, "end": 901.84, "text": "又是天子赐给你的宝物。"}, {"start": 901.84, "end": 903.84, "text": "草某一介外臣,"}, {"start": 903.84, "end": 904.84, "text": "无福销售。"}, {"start": 905.84, "end": 906.84, "text": "国舅,"}, {"start": 906.84, "end": 907.84, "text": "收好它吧。"}, {"start": 908.84, "end": 909.84, "text": "多谢,"}, {"start": 909.84, "end": 910.84, "text": "多谢。"}, {"start": 910.84, "end": 911.84, "text": "董国舅,"}, {"start": 944.17, "end": 945.17, "text": "你,"}, {"start": 945.17, "end": 946.17, "text": "你这是..."}, {"start": 946.17, "end": 947.17, "text": "刘皇叔,"}, {"start": 948.17, "end": 950.17, "text": "我们进屋说话,好吗?"}, {"start": 951.17, "end": 952.17, "text": "国舅请。"}, {"start": 952.17, "end": 957.14, "text": "在《血诏》中说,"}, {"start": 959.14, "end": 960.14, "text": "人伦之大,"}, {"start": 961.14, "end": 962.14, "text": "以父子为先,"}, {"start": 964.14, "end": 965.14, "text": "卑贱之礼,"}, {"start": 966.14, "end": 968.14, "text": "以君臣为重,"}, {"start": 968.14, "end": 972.64, "text": "曹贼欺君雅妇,"}, {"start": 972.64, "end": 974.64, "text": "屠毒天下,"}, {"start": 975.64, "end": 976.64, "text": "祸乱朝纲,"}, {"start": 976.64, "end": 977.64, "text": "欺能难,"}, {"start": 977.64, "end": 981.5, "text": "国之重臣,"}, {"start": 981.5, "end": 984.5, "text": "当年列祖创业之艰难,"}, {"start": 985.5, "end": 987.5, "text": "天安之浩大,"}, {"start": 988.5, "end": 990.5, "text": "集结朝廷内外,"}, {"start": 991.5, "end": 993.5, "text": "助臣议事,"}, {"start": 993.5, "end": 994.5, "text": "起兵,"}, {"start": 995.5, "end": 996.5, "text": "缴密奸党,"}, {"start": 997.5, "end": 999.5, "text": "复兴大汗,"}, {"start": 999.5, "end": 1005.62, "text": "协书证,"}, {"start": 1006.62, "end": 1007.62, "text": "以武器,"}, {"start": 1008.62, "end": 1010.62, "text": "何难取?"}, {"start": 1011.62, "end": 1012.62, "text": "刘皇叔,"}, {"start": 1012.62, "end": 1045.63, "text": "二位将军何故到此?"}, {"start": 1054.41, "end": 1055.41, "text": "丞相有令,"}, {"start": 1055.41, "end": 1057.41, "text": "请你立刻就去。"}, {"start": 1058.41, "end": 1059.41, "text": "哦,"}, {"start": 1059.41, "end": 1060.41, "text": "那请二位稍候容我更衣。"}, {"start": 1061.41, "end": 1062.41, "text": "丞相只说让你立刻就去,"}, {"start": 1062.41, "end": 1063.41, "text": "可没说让你更衣。"}, {"start": 1064.41, "end": 1065.41, "text": "请。"}, {"start": 1065.41, "end": 1066.41, "text": "拜见丞相。"}, {"start": 1137.42, "end": 1139.42, "text": "你在家做了一件好大的事,"}, {"start": 1139.42, "end": 1141.42, "text": "以为我不知道吗?"}, {"start": 1142.42, "end": 1147.91, "text": "不知丞相所指何事?"}, {"start": 1148.91, "end": 1149.91, "text": "种菜,"}, {"start": 1149.91, "end": 1151.91, "text": "丞相当今皇叔,"}, {"start": 1151.91, "end": 1152.91, "text": "侯爵将军,"}, {"start": 1152.91, "end": 1154.91, "text": "竟然像农夫一样的种起菜来。"}, {"start": 1155.91, "end": 1157.91, "text": "难道我草草供礼不足吗?"}, {"start": 1158.91, "end": 1159.91, "text": "不是,"}, {"start": 1159.91, "end": 1161.91, "text": "相府对我照料极是周到,"}, {"start": 1161.91, "end": 1164.91, "text": "是我自己闲来无事,"}, {"start": 1164.91, "end": 1166.91, "text": "突然想吃一口新鲜的韭菜了,"}, {"start": 1166.91, "end": 1168.91, "text": "于是就种下了。"}, {"start": 1169.91, "end": 1170.91, "text": "韭菜长得如何?"}, {"start": 1171.91, "end": 1172.91, "text": "很好,"}, {"start": 1172.91, "end": 1173.91, "text": "极为旺盛。"}, {"start": 1174.91, "end": 1176.91, "text": "收割头一刀韭菜,"}, {"start": 1176.91, "end": 1177.91, "text": "别忘了给我一筐,"}, {"start": 1177.91, "end": 1178.91, "text": "我也要尝尝。"}, {"start": 1178.91, "end": 1179.91, "text": "好,"}, {"start": 1179.91, "end": 1181.91, "text": "在下深感荣幸。"}, {"start": 1182.91, "end": 1183.91, "text": "走。"}, {"start": 1183.91, "end": 1185.91, "text": "记得千年蒸元树,"}, {"start": 1185.91, "end": 1187.91, "text": "烈日炎炎,"}, {"start": 1187.91, "end": 1191.96, "text": "将士们甘渴难耐,"}, {"start": 1191.96, "end": 1193.96, "text": "连路都走不动了。"}, {"start": 1193.96, "end": 1195.96, "text": "我忽然心生一计,"}, {"start": 1195.96, "end": 1197.96, "text": "举边指着远处大窖,"}, {"start": 1197.96, "end": 1198.96, "text": "看那,"}, {"start": 1198.96, "end": 1200.96, "text": "前方有一片梅林,"}, {"start": 1201.96, "end": 1202.96, "text": "将士们听了,"}, {"start": 1202.96, "end": 1203.96, "text": "欢声泪动,"}, {"start": 1203.96, "end": 1205.96, "text": "口中流浪,"}, {"start": 1205.96, "end": 1208.96, "text": "其实前头连一颗梅子也没有,"}, {"start": 1208.96, "end": 1210.96, "text": "但是将士们被梅子所诱,"}, {"start": 1210.96, "end": 1212.96, "text": "营地却到了。"}, {"start": 1213.96, "end": 1215.96, "text": "丞相智谋过人,"}, {"start": 1215.96, "end": 1217.96, "text": "望为只可一事,"}, {"start": 1217.96, "end": 1219.96, "text": "定可成为传师名典,"}, {"start": 1219.96, "end": 1220.96, "text": "世代相传。"}, {"start": 1221.96, "end": 1222.96, "text": "丞相啊,"}, {"start": 1222.96, "end": 1226.96, "text": "刚才我进府门的时候,"}, {"start": 1226.96, "end": 1243.82, "text": "看见一具尸首太烂了,"}, {"start": 1243.82, "end": 1244.82, "text": "我心想,"}, {"start": 1244.82, "end": 1246.82, "text": "这尸首太烂了,"}, {"start": 1246.82, "end": 1248.82, "text": "当我进门的时候,"}, {"start": 1248.82, "end": 1250.82, "text": "看见一具尸首抬了出去,"}, {"start": 1250.82, "end": 1252.82, "text": "一打听才知道,"}, {"start": 1252.82, "end": 1255.82, "text": "是丞相梦中将它斩杀,"}, {"start": 1256.82, "end": 1258.82, "text": "丞相真乃义人也,"}, {"start": 1258.82, "end": 1261.82, "text": "连睡梦中也要睁着一只眼。"}, {"start": 1264.29, "end": 1265.29, "text": "宣德,"}, {"start": 1265.29, "end": 1267.29, "text": "你是厚道人,"}, {"start": 1267.29, "end": 1269.29, "text": "我就跟你说实话吧,"}, {"start": 1269.29, "end": 1271.29, "text": "并非我梦中好杀人,"}, {"start": 1271.29, "end": 1273.29, "text": "睡觉就睡觉呗,"}, {"start": 1273.29, "end": 1275.29, "text": "杀什么人嘛,"}, {"start": 1275.29, "end": 1277.29, "text": "但是我一直担心,"}, {"start": 1277.29, "end": 1279.29, "text": "有人在我睡觉的时候行刺我,"}, {"start": 1280.29, "end": 1281.29, "text": "怎么会呢,"}, {"start": 1281.29, "end": 1282.29, "text": "丞相多虑了,"}, {"start": 1282.29, "end": 1283.29, "text": "怎么不会,"}, {"start": 1284.29, "end": 1285.29, "text": "当年,"}, {"start": 1285.29, "end": 1288.29, "text": "我就是在董卓睡觉的时候行刺他的,"}, {"start": 1288.29, "end": 1289.29, "text": "我能刺人,"}, {"start": 1289.29, "end": 1291.29, "text": "人也能刺我,"}, {"start": 1291.29, "end": 1293.29, "text": "所以就算是在睡觉的时候,"}, {"start": 1293.29, "end": 1295.29, "text": "也不可不防啊,"}, {"start": 1296.29, "end": 1301.18, "text": "那丞相是怎么提防的?"}, {"start": 1301.18, "end": 1303.18, "text": "我就故意扬言,"}, {"start": 1304.18, "end": 1306.18, "text": "说我好梦中杀人,"}, {"start": 1306.18, "end": 1308.18, "text": "所有人在我睡觉的时候靠近,"}, {"start": 1308.18, "end": 1310.18, "text": "都会有生命危险,"}, {"start": 1310.18, "end": 1313.18, "text": "下人将信将疑,"}, {"start": 1314.18, "end": 1315.18, "text": "这可不好,"}, {"start": 1316.18, "end": 1317.18, "text": "于是,"}, {"start": 1318.18, "end": 1320.18, "text": "今日上午,"}, {"start": 1320.18, "end": 1322.18, "text": "我就再踏上假妹,"}, {"start": 1322.18, "end": 1324.18, "text": "说梦话,"}, {"start": 1324.18, "end": 1327.18, "text": "下人以为我在唤她,"}, {"start": 1327.18, "end": 1328.18, "text": "就上前伺候,"}, {"start": 1328.18, "end": 1329.18, "text": "我大叫一声,"}, {"start": 1329.18, "end": 1330.18, "text": "拔剑便刺,"}, {"start": 1330.18, "end": 1332.18, "text": "杀完了,"}, {"start": 1332.18, "end": 1334.18, "text": "我回去接着睡,"}, {"start": 1334.18, "end": 1336.18, "text": "睡醒了,"}, {"start": 1337.18, "end": 1338.18, "text": "假装不知道,"}, {"start": 1338.18, "end": 1340.18, "text": "一无所知,"}, {"start": 1340.18, "end": 1342.18, "text": "悲痛万分,"}, {"start": 1344.18, "end": 1346.18, "text": "我想此时此刻,"}, {"start": 1346.18, "end": 1348.18, "text": "草草梦中杀人的事,"}, {"start": 1349.18, "end": 1350.18, "text": "会一传十,"}, {"start": 1350.18, "end": 1352.18, "text": "十传百,"}, {"start": 1352.18, "end": 1354.18, "text": "从今往后,"}, {"start": 1354.18, "end": 1357.18, "text": "没有人敢在我睡觉的时候靠近我,"}, {"start": 1357.18, "end": 1359.18, "text": "原来,"}, {"start": 1359.18, "end": 1361.18, "text": "丞相不在梦中,"}, {"start": 1361.18, "end": 1362.18, "text": "是世人,"}, {"start": 1362.18, "end": 1363.18, "text": "却在梦中,"}, {"start": 1363.18, "end": 1365.18, "text": "除了你刘皇叔,"}, {"start": 1365.18, "end": 1366.18, "text": "来,"}, {"start": 1366.18, "end": 1378.76, "text": "好风啊,"}, {"start": 1378.76, "end": 1380.76, "text": "风从虎,"}, {"start": 1380.76, "end": 1381.76, "text": "云从龙,"}, {"start": 1381.76, "end": 1382.76, "text": "龙虎英雄,"}, {"start": 1382.76, "end": 1384.76, "text": "傲苍穹啊,"}, {"start": 1384.76, "end": 1385.76, "text": "说得好,"}, {"start": 1386.76, "end": 1387.76, "text": "宣德啊,"}, {"start": 1387.76, "end": 1389.76, "text": "你九历四方,"}, {"start": 1389.76, "end": 1390.76, "text": "越人无数,"}, {"start": 1390.76, "end": 1393.76, "text": "必然接纳过不少英雄豪奸,"}, {"start": 1393.76, "end": 1394.76, "text": "你说说,"}, {"start": 1394.76, "end": 1395.76, "text": "谁,"}, {"start": 1395.76, "end": 1397.76, "text": "才是当时英雄?"}, {"start": 1397.76, "end": 1398.76, "text": "岂敢岂敢,"}, {"start": 1398.76, "end": 1400.76, "text": "在下一双俗眼,"}, {"start": 1400.76, "end": 1402.76, "text": "哪里识得什么英雄?"}, {"start": 1402.76, "end": 1403.76, "text": "说说,"}, {"start": 1403.76, "end": 1404.76, "text": "不用客气,"}, {"start": 1404.76, "end": 1406.76, "text": "就算是未曾谋面,"}, {"start": 1406.76, "end": 1407.76, "text": "也会,"}, {"start": 1407.76, "end": 1408.76, "text": "有耳闻嘛,"}, {"start": 1408.76, "end": 1409.76, "text": "说说,"}, {"start": 1412.1, "end": 1413.1, "text": "怀南元树,"}, {"start": 1413.1, "end": 1415.1, "text": "有称帝之志,"}, {"start": 1415.1, "end": 1417.1, "text": "虽称帝失败,"}, {"start": 1417.1, "end": 1419.1, "text": "但曾经独霸一方,"}, {"start": 1419.1, "end": 1421.1, "text": "算得上是英雄了,"}, {"start": 1421.1, "end": 1422.1, "text": "败君之将,"}, {"start": 1422.1, "end": 1424.1, "text": "忠忠枯骨,"}, {"start": 1424.1, "end": 1426.1, "text": "他活不了多久了,"}, {"start": 1426.1, "end": 1428.1, "text": "早晚备备我所请,"}, {"start": 1428.1, "end": 1432.25, "text": "那,"}, {"start": 1432.25, "end": 1434.25, "text": "河北元绍,"}, {"start": 1434.25, "end": 1436.25, "text": "祖上四世三宫,"}, {"start": 1436.25, "end": 1437.25, "text": "兵精两族,"}, {"start": 1437.25, "end": 1439.25, "text": "虎拒千里济州,"}, {"start": 1439.25, "end": 1441.25, "text": "而且图谋天下,"}, {"start": 1441.25, "end": 1443.25, "text": "他算得上是英雄。"}, {"start": 1443.25, "end": 1444.25, "text": "元绍,"}, {"start": 1444.25, "end": 1447.25, "text": "色利而胆薄,"}, {"start": 1447.25, "end": 1448.25, "text": "优柔寡断,"}, {"start": 1448.25, "end": 1451.25, "text": "做大事而牺牲,"}, {"start": 1451.25, "end": 1454.25, "text": "见小利而妄议,"}, {"start": 1454.25, "end": 1456.25, "text": "绝非英雄。"}, {"start": 1457.25, "end": 1458.25, "text": "有一人,"}, {"start": 1458.25, "end": 1460.25, "text": "名列当世八郡,"}, {"start": 1460.25, "end": 1462.25, "text": "威震九州,"}, {"start": 1462.25, "end": 1463.25, "text": "刘景升,"}, {"start": 1463.25, "end": 1465.25, "text": "可称得上是英雄?"}, {"start": 1465.25, "end": 1466.25, "text": "刘表,"}, {"start": 1466.25, "end": 1469.25, "text": "有名无实,"}, {"start": 1469.25, "end": 1472.25, "text": "离英雄二字还差得远啊。"}, {"start": 1472.25, "end": 1474.25, "text": "那一州刘继玉,"}, {"start": 1474.25, "end": 1476.25, "text": "可称得上英雄吗?"}, {"start": 1476.25, "end": 1478.25, "text": "柳章,"}, {"start": 1478.25, "end": 1480.25, "text": "虽然是皇室宗亲,"}, {"start": 1480.25, "end": 1484.25, "text": "不过是御阶下的一条看门狗而已。"}, {"start": 1484.25, "end": 1488.2, "text": "再有一人,"}, {"start": 1488.2, "end": 1490.2, "text": "血气方刚,"}, {"start": 1490.2, "end": 1492.2, "text": "江东领袖,"}, {"start": 1492.2, "end": 1493.2, "text": "孙伯福,"}, {"start": 1493.2, "end": 1495.2, "text": "一定可称得上英雄了。"}, {"start": 1495.2, "end": 1498.2, "text": "孙策是靠其父孙坚成名的,"}, {"start": 1498.2, "end": 1500.2, "text": "不算英雄。"}, {"start": 1500.2, "end": 1501.2, "text": "那,"}, {"start": 1501.2, "end": 1504.77, "text": "马腾张秀,"}, {"start": 1504.77, "end": 1506.77, "text": "韩髓等辈,"}, {"start": 1506.77, "end": 1508.77, "text": "丞相认为如何?"}, {"start": 1508.77, "end": 1511.77, "text": "都是些昏昏沥沥的徒,"}, {"start": 1511.77, "end": 1512.77, "text": "陆路小人,"}, {"start": 1512.77, "end": 1513.77, "text": "何足寡持?"}, {"start": 1513.77, "end": 1514.77, "text": "除了这些,"}, {"start": 1514.77, "end": 1518.43, "text": "在下实不知道,"}, {"start": 1518.43, "end": 1520.43, "text": "该有谁称得起英雄。"}, {"start": 1520.43, "end": 1522.43, "text": "那我告诉你,"}, {"start": 1522.43, "end": 1523.43, "text": "所谓英雄,"}, {"start": 1523.43, "end": 1526.43, "text": "应该胸怀大志,"}, {"start": 1526.43, "end": 1528.43, "text": "负有良谋,"}, {"start": 1528.43, "end": 1530.43, "text": "上,"}, {"start": 1530.43, "end": 1532.43, "text": "能洞察宇宙之妙,"}, {"start": 1532.43, "end": 1534.43, "text": "下,"}, {"start": 1534.43, "end": 1536.43, "text": "能吞吐天地之机。"}, {"start": 1536.43, "end": 1538.43, "text": "丞相说得好,"}, {"start": 1538.43, "end": 1539.43, "text": "可是,"}, {"start": 1539.43, "end": 1541.43, "text": "如此高的评价,"}, {"start": 1541.43, "end": 1543.43, "text": "天下谁人挡得起?"}, {"start": 1543.43, "end": 1545.43, "text": "天下英雄,"}, {"start": 1545.43, "end": 1547.43, "text": "唯有刘备,"}, {"start": 1547.43, "end": 1549.43, "text": "和曹操。"}, {"start": 1549.43, "end": 1559.43, "text": "丞相言重了,"}, {"start": 1559.43, "end": 1561.43, "text": "刘备岂敢,"}, {"start": 1561.43, "end": 1563.43, "text": "丞相相提并问。"}, {"start": 1563.43, "end": 1565.43, "text": "宣德,"}, {"start": 1565.43, "end": 1571.38, "text": "你觉得我不会识人是吗?"}, {"start": 1571.38, "end": 1573.38, "text": "我只说几件事,"}, {"start": 1573.38, "end": 1575.38, "text": "便可简短想。"}, {"start": 1575.38, "end": 1577.38, "text": "请丞相识想。"}, {"start": 1577.38, "end": 1579.38, "text": "你我初次相识,"}, {"start": 1579.38, "end": 1582.38, "text": "是在袁绍的盟军大营。"}, {"start": 1582.38, "end": 1583.38, "text": "当日,"}, {"start": 1583.38, "end": 1586.38, "text": "西梁的勇将华雄挑战,"}, {"start": 1586.38, "end": 1590.38, "text": "一连斩了我盟军三元上将,"}, {"start": 1590.38, "end": 1592.38, "text": "诸侯将士,"}, {"start": 1592.38, "end": 1594.38, "text": "诸侯接经。"}, {"start": 1594.38, "end": 1596.38, "text": "你二弟关羽,"}, {"start": 1596.38, "end": 1598.38, "text": "杯酒喂粮,"}, {"start": 1598.38, "end": 1600.38, "text": "单刀匹马,"}, {"start": 1600.38, "end": 1602.38, "text": "就斩了华雄。"}, {"start": 1602.38, "end": 1604.38, "text": "当他把华雄的头颅"}, {"start": 1604.38, "end": 1606.38, "text": "抛到大堂上的时候,"}, {"start": 1606.38, "end": 1608.38, "text": "满堂诸侯接经,"}, {"start": 1608.38, "end": 1610.38, "text": "唯有你,"}, {"start": 1610.38, "end": 1612.38, "text": "连眼皮都没动一下。"}, {"start": 1612.38, "end": 1615.73, "text": "其二,"}, {"start": 1615.73, "end": 1617.73, "text": "当我率五万铁骑,"}, {"start": 1617.73, "end": 1619.73, "text": "攻伐徐州的时候,"}, {"start": 1619.73, "end": 1621.73, "text": "各路诸侯做官成败,"}, {"start": 1621.73, "end": 1623.73, "text": "没有一个人,"}, {"start": 1623.73, "end": 1625.73, "text": "敢因为逃迁,"}, {"start": 1625.73, "end": 1627.73, "text": "而跟我草草作对。"}, {"start": 1627.73, "end": 1629.73, "text": "唯有你,"}, {"start": 1629.73, "end": 1631.73, "text": "带了区区不到两千人马。"}, {"start": 1631.73, "end": 1633.73, "text": "来了,"}, {"start": 1633.73, "end": 1635.73, "text": "你明知道斩不过我,"}, {"start": 1635.73, "end": 1637.73, "text": "你明知,"}, {"start": 1637.73, "end": 1639.73, "text": "不可为而为之。"}, {"start": 1639.73, "end": 1643.14, "text": "为何?"}, {"start": 1643.14, "end": 1645.14, "text": "仁义。"}, {"start": 1645.14, "end": 1647.14, "text": "你为仁义而死,"}, {"start": 1647.14, "end": 1650.9, "text": "可以不计生死,"}, {"start": 1650.9, "end": 1652.9, "text": "愿为天下贤。"}, {"start": 1652.9, "end": 1654.9, "text": "皇帝,"}, {"start": 1654.9, "end": 1656.9, "text": "我奉旨逃逆,"}, {"start": 1656.9, "end": 1658.9, "text": "照天下诸侯来源,"}, {"start": 1658.9, "end": 1660.9, "text": "却没有一个人来助我。"}, {"start": 1660.9, "end": 1662.9, "text": "当我到达前线的时候,"}, {"start": 1662.9, "end": 1664.9, "text": "又是你,"}, {"start": 1664.9, "end": 1666.9, "text": "在那儿等我。"}, {"start": 1666.9, "end": 1668.9, "text": "虚之我根本就没有"}, {"start": 1668.9, "end": 1670.9, "text": "发诏给你,"}, {"start": 1670.9, "end": 1672.9, "text": "你却来了,"}, {"start": 1672.9, "end": 1674.9, "text": "为何呢?"}, {"start": 1674.9, "end": 1676.9, "text": "因为你是汉帝后裔,"}, {"start": 1676.9, "end": 1682.06, "text": "你最恨奸贼篡你。"}, {"start": 1682.06, "end": 1684.06, "text": "是。"}, {"start": 1684.06, "end": 1686.06, "text": "原来我以为,"}, {"start": 1686.06, "end": 1688.06, "text": "仁义就是仁义,"}, {"start": 1688.06, "end": 1690.06, "text": "却有它在。"}, {"start": 1692.06, "end": 1694.06, "text": "后来我明白了,"}, {"start": 1694.06, "end": 1696.06, "text": "仁义到了你这儿,"}, {"start": 1696.06, "end": 1698.06, "text": "就不光是"}, {"start": 1698.06, "end": 1700.06, "text": "世道人心了,"}, {"start": 1702.06, "end": 1704.06, "text": "它还是杀人的利器。"}, {"start": 1704.06, "end": 1708.62, "text": "你的兵器不是双骨剑吗?"}, {"start": 1708.62, "end": 1710.62, "text": "在我看来,"}, {"start": 1710.62, "end": 1712.62, "text": "一把叫仁之剑,"}, {"start": 1712.62, "end": 1714.62, "text": "一把叫义之剑。"}, {"start": 1716.62, "end": 1718.62, "text": "有了这两把剑,"}, {"start": 1718.62, "end": 1720.62, "text": "还能不是英雄吗?"}, {"start": 1720.62, "end": 1741.41, "text": "见笑,见笑。"}, {"start": 1741.41, "end": 1743.41, "text": "一阵之危,"}, {"start": 1743.41, "end": 1745.41, "text": "乃至于此。"}, {"start": 1745.41, "end": 1747.41, "text": "这雷把我吓死了。"}, {"start": 1747.41, "end": 1749.41, "text": "英雄还怕打雷吗?"}, {"start": 1749.41, "end": 1754.7, "text": "迅雷乃天意。"}, {"start": 1754.7, "end": 1756.7, "text": "世人谁敢不为天意?"}, {"start": 1758.7, "end": 1760.7, "text": "况且,"}, {"start": 1760.7, "end": 1762.7, "text": "刚才丞相所言,"}, {"start": 1762.7, "end": 1764.7, "text": "句句也如雷关耳啊。"}, {"start": 1764.7, "end": 1766.7, "text": "你看我说的对吗?"}, {"start": 1766.7, "end": 1768.7, "text": "说的对。"}, {"start": 1768.7, "end": 1770.7, "text": "在下,"}, {"start": 1770.7, "end": 1772.7, "text": "也有一点疑问。"}, {"start": 1772.7, "end": 1774.7, "text": "敢请丞相直言相告。"}, {"start": 1774.7, "end": 1776.7, "text": "请讲。"}, {"start": 1776.7, "end": 1778.7, "text": "如我所料不错,"}, {"start": 1778.7, "end": 1780.7, "text": "丞相好几次,"}, {"start": 1780.7, "end": 1782.7, "text": "都想杀在下。"}, {"start": 1782.7, "end": 1784.7, "text": "为何到现在,"}, {"start": 1784.7, "end": 1786.7, "text": "还不杀呢?"}, {"start": 1786.7, "end": 1790.37, "text": "问得好啊。"}, {"start": 1790.37, "end": 1794.22, "text": "贤弟问得极是。"}, {"start": 1794.22, "end": 1796.22, "text": "我也把实话告诉你吧。"}, {"start": 1796.22, "end": 1798.22, "text": "第一,"}, {"start": 1798.22, "end": 1801.7, "text": "得不得。"}, {"start": 1801.7, "end": 1803.7, "text": "自古以来就是英雄相系嘛。"}, {"start": 1803.7, "end": 1805.7, "text": "第二,"}, {"start": 1805.7, "end": 1807.7, "text": "你虽是英雄,"}, {"start": 1807.7, "end": 1809.7, "text": "却无用武之地。"}, {"start": 1809.7, "end": 1811.7, "text": "一个无用武之地的英雄,"}, {"start": 1811.7, "end": 1813.7, "text": "是无害于我曹操的。"}, {"start": 1813.7, "end": 1815.7, "text": "所以,"}, {"start": 1815.7, "end": 1817.7, "text": "我才能跟你相敬如宾,"}, {"start": 1817.7, "end": 1819.7, "text": "青梅竹酒,"}, {"start": 1819.7, "end": 1829.63, "text": "论英雄。"}, {"start": 1829.63, "end": 1831.63, "text": "谢丞相。"}, {"start": 1831.63, "end": 1833.63, "text": "来。"}, {"start": 1833.63, "end": 1846.96, "text": "大马来报,"}, {"start": 1846.96, "end": 1848.96, "text": "公孙瓒。"}, {"start": 1848.96, "end": 1850.96, "text": "七日内,连下幽州七郡,"}, {"start": 1850.96, "end": 1852.96, "text": "并得祥族十八万,"}, {"start": 1852.96, "end": 1854.96, "text": "粮草三十一万弹。"}, {"start": 1854.96, "end": 1861.63, "text": "各种兵马器械无数。"}, {"start": 1861.63, "end": 1865.84, "text": "徐先生,"}, {"start": 1865.84, "end": 1869.38, "text": "公孙瓒生死如何?"}, {"start": 1869.38, "end": 1871.38, "text": "公孙瓒战败之后,"}, {"start": 1871.38, "end": 1873.38, "text": "筑起了一座易经楼,"}, {"start": 1873.38, "end": 1875.38, "text": "楼高十丈,是坚不可摧。"}, {"start": 1875.38, "end": 1877.38, "text": "内屯兵六万,储粮三十一万,"}, {"start": 1877.38, "end": 1879.38, "text": "试图坚守待变。"}, {"start": 1879.38, "end": 1881.38, "text": "谁料想,"}, {"start": 1881.38, "end": 1883.38, "text": "袁绍派人,"}, {"start": 1883.38, "end": 1885.38, "text": "三尺穿洞而入,"}, {"start": 1885.38, "end": 1887.38, "text": "直倒易经楼下,"}, {"start": 1887.38, "end": 1889.38, "text": "然后放起了大火,"}, {"start": 1889.38, "end": 1891.38, "text": "公孙瓒是走投无路,"}, {"start": 1891.38, "end": 1893.38, "text": "先杀了自己的妻妻,"}, {"start": 1893.38, "end": 1895.38, "text": "再杀此内,"}, {"start": 1895.38, "end": 1897.38, "text": "最后,他自尽了。"}, {"start": 1899.38, "end": 1901.38, "text": "公孙瓒是我至娇,"}, {"start": 1901.38, "end": 1903.38, "text": "待我有厚恩,"}, {"start": 1903.38, "end": 1905.38, "text": "不料,"}, {"start": 1905.38, "end": 1907.38, "text": "就是这般下场,"}, {"start": 1907.38, "end": 1909.38, "text": "惜在痛在。"}, {"start": 1909.38, "end": 1911.38, "text": "公孙瓒"}, {"start": 1911.38, "end": 1913.38, "text": "能败于袁绍这我,"}, {"start": 1913.38, "end": 1915.38, "text": "早有预料。"}, {"start": 1915.38, "end": 1917.38, "text": "但我没有料到的是,"}, {"start": 1917.38, "end": 1919.38, "text": "他败得这么快。"}, {"start": 1919.38, "end": 1921.38, "text": "我原以为,"}, {"start": 1921.38, "end": 1923.38, "text": "他再怎么窝囊,"}, {"start": 1923.38, "end": 1925.38, "text": "也能挺到明年吧。"}, {"start": 1925.38, "end": 1932.14, "text": "人算不如天算。"}, {"start": 1932.14, "end": 1934.14, "text": "丞相日理万机,"}, {"start": 1934.14, "end": 1936.14, "text": "容在下告退。"}, {"start": 1936.14, "end": 1938.14, "text": "你坐这儿。"}, {"start": 1938.14, "end": 1940.14, "text": "徇玉,"}, {"start": 1940.14, "end": 1949.12, "text": "玄德是我贤弟,"}, {"start": 1949.12, "end": 1951.12, "text": "你但说无妨。"}, {"start": 1951.12, "end": 1953.12, "text": "实力大增,"}, {"start": 1953.12, "end": 1955.12, "text": "现有兵马六十万到七十万,"}, {"start": 1955.12, "end": 1957.12, "text": "战将上千元,"}, {"start": 1957.12, "end": 1959.12, "text": "并熊居寄青幽病四周,"}, {"start": 1959.12, "end": 1961.12, "text": "东临沧海,"}, {"start": 1961.12, "end": 1963.12, "text": "西至河内,"}, {"start": 1963.12, "end": 1965.12, "text": "三分天下,"}, {"start": 1965.12, "end": 1967.12, "text": "他自己独占一分以上,"}, {"start": 1967.12, "end": 1969.12, "text": "而且协大胜之势,"}, {"start": 1969.12, "end": 1971.12, "text": "兵风正劲。"}, {"start": 1971.12, "end": 1973.12, "text": "在下担心,"}, {"start": 1973.12, "end": 1975.12, "text": "主公与袁绍的决战,"}, {"start": 1975.12, "end": 1977.12, "text": "就在眼前了。"}, {"start": 1977.12, "end": 1979.12, "text": "立刻你一道诏书,"}, {"start": 1979.12, "end": 1981.12, "text": "以天子之名,"}, {"start": 1981.12, "end": 1983.12, "text": "给袁绍赐恩赏功,"}, {"start": 1983.12, "end": 1985.12, "text": "马上给他加官进爵,"}, {"start": 1985.12, "end": 1987.12, "text": "把他夺到手的城池土地,"}, {"start": 1987.12, "end": 1989.12, "text": "统统封赏给他。"}, {"start": 1991.12, "end": 2000.13, "text": "遵命。"}, {"start": 2000.13, "end": 2002.13, "text": "你不想与袁绍决战了吗?"}, {"start": 2002.13, "end": 2004.13, "text": "决战已经开始了。"}, {"start": 2006.13, "end": 2008.13, "text": "就从我的魅缘示弱,"}, {"start": 2008.13, "end": 2010.13, "text": "开始。"}, {"start": 2019.23, "end": 2021.23, "text": "平身。"}, {"start": 2021.23, "end": 2048.03, "text": "臣谨奏,"}, {"start": 2048.03, "end": 2053.3, "text": "大将军袁绍,"}, {"start": 2053.3, "end": 2055.3, "text": "成天威,率王氏,"}, {"start": 2055.3, "end": 2057.3, "text": "身兼士卒,"}, {"start": 2057.3, "end": 2059.3, "text": "为朝廷一举剿灭公孙瓒,"}, {"start": 2059.3, "end": 2061.3, "text": "收取幽州七郡之地,"}, {"start": 2061.3, "end": 2065.3, "text": "朝廷应于恩旨奖赏,"}, {"start": 2065.3, "end": 2067.3, "text": "竟封袁绍为"}, {"start": 2067.3, "end": 2069.3, "text": "护国公,"}, {"start": 2069.3, "end": 2073.3, "text": "想九夕领天下兵马大元帅。"}, {"start": 2073.3, "end": 2075.3, "text": "爱卿竟然为袁绍请功。"}, {"start": 2075.3, "end": 2077.3, "text": "朕"}, {"start": 2077.3, "end": 2079.3, "text": "朕准奏。"}, {"start": 2079.3, "end": 2093.74, "text": "禀陛下,"}, {"start": 2093.74, "end": 2095.74, "text": "逆贼袁绍在淮南交涉淫役,"}, {"start": 2095.74, "end": 2097.74, "text": "使得部下纷纷叛乱。"}, {"start": 2097.74, "end": 2099.74, "text": "据报,袁绍与将传国玉玺"}, {"start": 2099.74, "end": 2101.74, "text": "转赠袁绍。"}, {"start": 2101.74, "end": 2103.74, "text": "请袁绍称帝,自己甘为其臣属,"}, {"start": 2103.74, "end": 2105.74, "text": "并率领本部参与兵马,"}, {"start": 2105.74, "end": 2107.74, "text": "前往济州投靠袁绍。"}, {"start": 2107.74, "end": 2120.24, "text": "现在玉玺还在袁绍手中。"}, {"start": 2120.24, "end": 2123.94, "text": "不好,"}, {"start": 2123.94, "end": 2125.94, "text": "袁绍和袁绍这对堂兄弟"}, {"start": 2125.94, "end": 2127.94, "text": "要是一旦相和,"}, {"start": 2127.94, "end": 2129.94, "text": "势头就更大了。"}, {"start": 2129.94, "end": 2139.74, "text": "禀陛下,"}, {"start": 2139.74, "end": 2143.98, "text": "丞相,"}, {"start": 2143.98, "end": 2145.98, "text": "臣意绝不可使二人合兵。"}, {"start": 2145.98, "end": 2147.98, "text": "袁绍如投袁绍,"}, {"start": 2147.98, "end": 2149.98, "text": "必经由徐州一带。"}, {"start": 2149.98, "end": 2151.98, "text": "臣对那里的山川地势"}, {"start": 2151.98, "end": 2153.98, "text": "了如指掌。"}, {"start": 2153.98, "end": 2155.98, "text": "臣愿率军劫击,"}, {"start": 2155.98, "end": 2157.98, "text": "生秦袁绍,"}, {"start": 2157.98, "end": 2171.28, "text": "现于朝廷。"}, {"start": 2171.28, "end": 2173.28, "text": "皇叔壮志可嘉呀!"}, {"start": 2173.28, "end": 2177.36, "text": "丞相,"}, {"start": 2177.36, "end": 2179.36, "text": "袁绍是一定要阻击的,"}, {"start": 2179.36, "end": 2181.36, "text": "但是刘备兵少,"}, {"start": 2181.36, "end": 2183.36, "text": "我怕他不是袁绍的对手。"}, {"start": 2183.36, "end": 2185.36, "text": "那么丞相可以助他一些兵马,"}, {"start": 2185.36, "end": 2187.36, "text": "令他为朝廷建功啊?"}, {"start": 2189.36, "end": 2191.36, "text": "爱卿啊,"}, {"start": 2191.36, "end": 2193.36, "text": "刘备乃是皇亲后裔,"}, {"start": 2193.36, "end": 2195.36, "text": "如果可以让他生秦逆贼袁绍的话,"}, {"start": 2195.36, "end": 2197.36, "text": "正可大展我列祖列宗的天威,"}, {"start": 2197.36, "end": 2199.36, "text": "告慰天下呀!"}, {"start": 2201.36, "end": 2206.24, "text": "禀陛下,"}, {"start": 2206.24, "end": 2208.24, "text": "丞相,"}, {"start": 2208.24, "end": 2210.24, "text": "臣愿以十五日为期限,"}, {"start": 2210.24, "end": 2212.24, "text": "如不能擒拿袁绍,"}, {"start": 2212.24, "end": 2214.24, "text": "臣愿受军法处置。"}, {"start": 2214.24, "end": 2218.29, "text": "刘皇叔如此忠义,"}, {"start": 2218.29, "end": 2220.29, "text": "丞相,"}, {"start": 2220.29, "end": 2222.29, "text": "难道你..."}, {"start": 2222.29, "end": 2245.79, "text": "宣德,"}, {"start": 2245.79, "end": 2247.79, "text": "我助你五万精兵阻击袁绍,"}, {"start": 2247.79, "end": 2249.79, "text": "但这些人马,"}, {"start": 2249.79, "end": 2251.79, "text": "要由朱京,"}, {"start": 2251.79, "end": 2253.79, "text": "陆昭二位将军执掌,"}, {"start": 2253.79, "end": 2255.79, "text": "由他们助你出征。"}, {"start": 2255.79, "end": 2257.79, "text": "我令你,"}, {"start": 2257.79, "end": 2259.79, "text": "速速赶往徐州,"}, {"start": 2259.79, "end": 2261.79, "text": "阻击袁绍,"}, {"start": 2261.79, "end": 2263.79, "text": "务必,"}, {"start": 2263.79, "end": 2265.79, "text": "禀袁绍回朝。"}, {"start": 2265.79, "end": 2267.79, "text": "刘备,领命。"}, {"start": 2267.79, "end": 2295.3, "text": "刘皇叔,"}, {"start": 2295.3, "end": 2297.3, "text": "国舅为何在此?"}, {"start": 2297.3, "end": 2299.3, "text": "陛下无法出宫,"}, {"start": 2299.3, "end": 2301.3, "text": "特令我前来为将军送行。"}, {"start": 2301.3, "end": 2303.3, "text": "陛下说,"}, {"start": 2303.3, "end": 2305.3, "text": "他之所以极力促成你出征袁绍,"}, {"start": 2305.3, "end": 2307.3, "text": "就是要你在外,"}, {"start": 2307.3, "end": 2309.3, "text": "谋利大业。"}, {"start": 2309.3, "end": 2311.3, "text": "今后,"}, {"start": 2311.3, "end": 2313.3, "text": "汉室的安危荣辱,"}, {"start": 2313.3, "end": 2315.3, "text": "就托付于你了。"}, {"start": 2315.3, "end": 2319.73, "text": "臣理解圣意,"}, {"start": 2319.73, "end": 2321.73, "text": "绝不辜负陛下。"}, {"start": 2321.73, "end": 2323.73, "text": "陛下还说,"}, {"start": 2323.73, "end": 2325.73, "text": "自今日起,"}, {"start": 2325.73, "end": 2327.73, "text": "他会在宫里,"}, {"start": 2327.73, "end": 2329.73, "text": "为将军奔向祈祷,"}, {"start": 2329.73, "end": 2331.73, "text": "祝将军成功。"}, {"start": 2331.73, "end": 2333.73, "text": "臣刘备,"}, {"start": 2333.73, "end": 2340.59, "text": "誓慕皇恩,"}, {"start": 2340.59, "end": 2342.59, "text": "万死必报。"}, {"start": 2344.59, "end": 2346.59, "text": "崇先生,"}, {"start": 2346.59, "end": 2348.59, "text": "我找一下丞相。"}, {"start": 2348.59, "end": 2350.59, "text": "您看,"}, {"start": 2350.59, "end": 2352.59, "text": "丞相还没起床。"}, {"start": 2352.59, "end": 2354.59, "text": "那你赶紧把丞相叫起来,"}, {"start": 2354.59, "end": 2356.59, "text": "我有要事向他禀报。"}, {"start": 2356.59, "end": 2358.59, "text": "丞相尚在睡梦中,"}, {"start": 2358.59, "end": 2360.59, "text": "在下万万不敢。"}, {"start": 2360.59, "end": 2365.73, "text": "你是怕丞相梦中杀人是吧?"}, {"start": 2365.73, "end": 2367.73, "text": "是啊,"}, {"start": 2367.73, "end": 2369.73, "text": "丞相睡梦中,"}, {"start": 2369.73, "end": 2371.73, "text": "任何人不得靠近。"}, {"start": 2371.73, "end": 2373.73, "text": "丞先生,"}, {"start": 2373.73, "end": 2384.21, "text": "丞先生,"}, {"start": 2384.21, "end": 2386.21, "text": "丞先生,"}, {"start": 2386.21, "end": 2388.21, "text": "丞先生,"}, {"start": 2388.21, "end": 2393.02, "text": "丞先生,"}, {"start": 2393.02, "end": 2396.27, "text": "丞先生,"}, {"start": 2396.27, "end": 2398.27, "text": "丞先生,"}, {"start": 2398.27, "end": 2400.27, "text": "丞先生,"}, {"start": 2400.27, "end": 2402.27, "text": "丞先生,"}, {"start": 2402.27, "end": 2407.89, "text": "丞先生,"}, {"start": 2407.89, "end": 2409.89, "text": "丞先生,"}, {"start": 2409.89, "end": 2411.89, "text": "恐怕 sufficiently鬼 csak hoard"}, {"start": 2411.89, "end": 2413.89, "text": "相信我 điều理。"}, {"start": 2413.89, "end": 2415.89, "text": "一败两归。"}, {"start": 2417.89, "end": 2419.89, "text": "这四个人,"}, {"start": 2419.89, "end": 2421.89, "text": "恨不得韩 amplifier,"}, {"start": 2421.89, "end": 2423.89, "text": "preciphythm,"}, {"start": 2423.89, "end": 2425.89, "text": "人,"}, {"start": 2425.89, "end": 2427.89, "text": "人,"}, {"start": 2429.46, "end": 2430.18, "text": "传命"}, {"start": 2431.66, "end": 2433.02, "text": "钟将军张辽"}, {"start": 2433.54, "end": 2434.86, "text": "偏将军徐楚"}, {"start": 2435.78, "end": 2438.46, "text": "率五百铁骑星夜追赶"}, {"start": 2439.22, "end": 2441.58, "text": "务必追刘备回朝"}, {"start": 2442.14, "end": 2443.18, "text": "我这就去办"}]