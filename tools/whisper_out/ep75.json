[{"start": 5.42, "end": 8.42, "text": "只有天子才能册封王位啊。"}, {"start": 8.42, "end": 10.42, "text": "臣通晓律法一规。"}, {"start": 10.42, "end": 28.52, "text": "你是暗示我废了汉帝,改朝换代。"}, {"start": 28.52, "end": 34.52, "text": "汉左延续四百年,早已日波西山,名孙世王。"}, {"start": 34.52, "end": 40.52, "text": "天下人对他早就已绝望,卫王应该承天道顺人心。"}, {"start": 44.59, "end": 52.16, "text": "那,你认为我的谋略、声望,比父王如何?"}, {"start": 52.16, "end": 63.1, "text": "卫王虽是雄主,但卫王不及先王。"}, {"start": 65.1, "end": 70.18, "text": "那我的文志武功,比父王如何?"}, {"start": 71.18, "end": 80.18, "text": "先王乃创业之主,百战艰难,其丰功未尽,足以朝日月垂千古。"}, {"start": 80.18, "end": 95.64, "text": "卫王不及先王,正因为卫王不及先王,卫王才应该尽位称帝。"}, {"start": 95.64, "end": 99.46, "text": "为何?"}, {"start": 99.46, "end": 110.24, "text": "并卫王不敢废汉,而是不需要。"}, {"start": 110.24, "end": 116.24, "text": "以先王之才之志之恩威,要做皇帝早就做了。"}, {"start": 116.24, "end": 124.81, "text": "先王不想做皇帝,先王深深明白,不做皇帝胜死皇帝。"}, {"start": 124.81, "end": 129.81, "text": "不做皇帝却圈养了一个皇帝,执于掌中运用自如。"}, {"start": 130.81, "end": 137.81, "text": "卫王的情况却恰恰相反,卫王继位未久,人心不稳。"}, {"start": 137.81, "end": 148.09, "text": "曹人、徐晃、张辽那批老将,成玉、贾许、汪朗那批老臣,都是先王培养提拔起来的。"}, {"start": 148.09, "end": 154.09, "text": "敢问卫王提拔过哪些文臣武将,卫王恩威何在?"}, {"start": 154.09, "end": 162.09, "text": "卫王只有晋位称帝,改朝换代,才能生拔自己的文臣武将,"}, {"start": 162.09, "end": 166.09, "text": "封满自己的羽毛,建立自己的恩威。"}, {"start": 166.09, "end": 182.15, "text": "臣敢肯定,他们那些人,比卫王更渴望卫王称帝,提壶宽庭。"}, {"start": 182.15, "end": 213.85, "text": "爷爷,依此。"}, {"start": 213.85, "end": 253.7, "text": "饭食已备好,请用膳。"}, {"start": 254.7, "end": 257.7, "text": "再等等,让我算完。"}, {"start": 257.7, "end": 261.11, "text": "父亲在算什么?"}, {"start": 261.11, "end": 266.11, "text": "我想和卫王做笔生意,卖给他一样东西。"}, {"start": 266.11, "end": 269.94, "text": "你能卖给卫王什么?"}, {"start": 269.94, "end": 273.6, "text": "汉室。"}, {"start": 273.6, "end": 277.6, "text": "父亲,劝卫王进帝位了?"}, {"start": 278.6, "end": 285.6, "text": "卫王早就有此心,我不过是说出了他想说而不能说的话。"}, {"start": 285.6, "end": 293.98, "text": "太好了,汉室早已经名存实亡了。"}, {"start": 293.98, "end": 298.98, "text": "父亲为卫王立此功勋,卫王肯定会重重地升拔父亲。"}, {"start": 298.98, "end": 303.98, "text": "开国以后,父亲必能位居三宫。"}, {"start": 303.98, "end": 306.98, "text": "说不定,汉室首任丞相。"}, {"start": 306.98, "end": 312.98, "text": "我不做这个首任丞相,甚至不想做首唱大臣。"}, {"start": 312.98, "end": 315.98, "text": "这份功劳让给别人吧。"}, {"start": 315.98, "end": 316.98, "text": "为何?"}, {"start": 316.98, "end": 325.81, "text": "招儿啊,怎么就如此浅薄呢?"}, {"start": 325.81, "end": 331.34, "text": "你想让后人逃我司马氏祖坟吗?"}, {"start": 331.34, "end": 342.35, "text": "司马氏是百年大祖,世事寒露。"}, {"start": 342.35, "end": 347.35, "text": "祖宗的功德名望,不可不顾啊。"}, {"start": 347.35, "end": 351.35, "text": "这个开国功臣,还是让给别人吧。"}, {"start": 351.35, "end": 354.35, "text": "父亲教训得是。"}, {"start": 354.35, "end": 358.35, "text": "那,那父亲想让谁做这件事呢?"}, {"start": 358.35, "end": 364.63, "text": "华新,他抱主建功之心,早就如持如醉了。"}, {"start": 364.63, "end": 425.75, "text": "陛下,臣有事上奏。"}, {"start": 425.75, "end": 427.75, "text": "爱卿,请讲。"}, {"start": 427.75, "end": 431.75, "text": "陛下,朝廷诸臣皆以为,"}, {"start": 431.75, "end": 437.75, "text": "汉室历经四百余年,游盛而衰,游荣而枯。"}, {"start": 437.75, "end": 440.75, "text": "如今更是气数已尽。"}, {"start": 440.75, "end": 447.75, "text": "魏王父子两代,德不四方,人即万物,超谷月金,光照天地。"}, {"start": 447.75, "end": 454.75, "text": "陛下,何不效尧顺之道,把山川社稷,擅让于魏王。"}, {"start": 454.75, "end": 458.75, "text": "如此,上合天心,下合民意。"}, {"start": 458.75, "end": 462.75, "text": "陛下也可以享受清贤之福了。"}, {"start": 462.75, "end": 466.75, "text": "此事臣等已经一决,请陛下准奏。"}, {"start": 466.75, "end": 472.44, "text": "宜祥退位。"}, {"start": 472.44, "end": 479.44, "text": "擅让,尧善于顺,意见其贤。"}, {"start": 479.44, "end": 484.44, "text": "文王善于武王,更张君王功德。"}, {"start": 484.44, "end": 489.44, "text": "陛下虽然不是什么圣君,不想效圣君之道吗?"}, {"start": 489.44, "end": 498.9, "text": "我们都是这个意思。"}, {"start": 498.9, "end": 500.9, "text": "请陛下大发大兴。"}, {"start": 500.9, "end": 516.72, "text": "忠言,这等忠言,孽祖是君。"}, {"start": 516.72, "end": 518.72, "text": "陛下休要糊涂。"}, {"start": 518.72, "end": 524.72, "text": "乾坤流转,万象更新,此乃天道也。"}, {"start": 525.72, "end": 528.72, "text": "何不一戒毒夫,永居阻挡?"}, {"start": 528.72, "end": 543.99, "text": "我知我不可成为天下之主。"}, {"start": 543.99, "end": 556.48, "text": "但高祖要斩蛇其翼,必胜拼杀,除暴其灭强主,才能开创大汉天下。"}, {"start": 556.48, "end": 563.48, "text": "我们是世代,受国恩识汉禄,何不如此不易?"}, {"start": 564.48, "end": 573.95, "text": "如果我失去祖宗的国家,在九泉之下,如何面对先皇?"}, {"start": 573.95, "end": 586.46, "text": "陛下可以带着这本图镇去见祖宗。"}, {"start": 586.46, "end": 591.46, "text": "在九泉之下,我一定能安心。"}, {"start": 591.46, "end": 600.23, "text": "请陛下顺应上天之意。"}, {"start": 600.23, "end": 607.4, "text": "请陛下顺应上天之意。"}, {"start": 607.4, "end": 624.43, "text": "归身图镇,都是虚妄之事,朕不敢从。"}, {"start": 624.43, "end": 637.22, "text": "陛下,自古以来,有兴亦有废,有胜亦有衰,岂有不亡不败者乎?"}, {"start": 637.22, "end": 649.22, "text": "汉室相传四百余年,言之陛下气数缺已殆尽,一早退避,不可遲疑。"}, {"start": 649.22, "end": 657.22, "text": "陛下,恕老臣道一句威严,遲则生变矣。"}, {"start": 657.22, "end": 660.22, "text": "上面之事,关系重大。"}, {"start": 660.22, "end": 673.49, "text": "朕,朕,朕须前往太庙,问过祖先,方可决断。"}, {"start": 673.49, "end": 706.68, "text": "祖宗啊,你们看见了吗?"}, {"start": 706.68, "end": 722.92, "text": "皇上,见臣逆子要夺足江山了,我无能。"}, {"start": 722.92, "end": 736.5, "text": "臣愧对祖宗,臣生不如死啊。"}, {"start": 736.5, "end": 743.01, "text": "皇上。"}, {"start": 743.01, "end": 747.01, "text": "你别站在那儿,祖宗不想见到你们曹家的人。"}, {"start": 747.01, "end": 759.67, "text": "皇上,臣妾虽姓曹,但臣妾是刘家的人,是皇上把臣妾立为皇后的。"}, {"start": 759.67, "end": 774.95, "text": "你给朕困出去!"}, {"start": 774.95, "end": 775.95, "text": "你没伤着吧?"}, {"start": 775.95, "end": 782.09, "text": "皇上,你叫我皇后了。"}, {"start": 782.09, "end": 794.02, "text": "朕不该动手,朕心神大乱,朕,朕已经不再是朕了。"}, {"start": 794.02, "end": 801.02, "text": "都是家训不好,惹皇上生气了,臣妾无碍。"}, {"start": 801.02, "end": 807.02, "text": "若是打一仗,能让皇上心里痛快些,臣妾愿意天天给皇上打。"}, {"start": 807.02, "end": 830.22, "text": "陛下,你怎么敢打皇后呢?"}, {"start": 830.22, "end": 837.66, "text": "男人可以打老婆,天子就不可以打皇后吗?"}, {"start": 837.66, "end": 844.66, "text": "男人是可以打老婆,天子也可以打后妃,但是你不行!"}, {"start": 844.66, "end": 847.66, "text": "你可别忘了,她是先位王之女。"}, {"start": 847.66, "end": 851.66, "text": "曹洪、曹秀,你们来干什么?"}, {"start": 851.66, "end": 856.66, "text": "陛下、皇后,我等是促嫁而来。"}, {"start": 856.66, "end": 863.66, "text": "我先告诉你们,我不光是陛下的皇后,也是陛下的臣民。"}, {"start": 863.66, "end": 869.66, "text": "别说今天陛下打了我,就是杀了我,也是天经地义的。"}, {"start": 869.66, "end": 876.66, "text": "同样的,你们两个不光是曹氏子孙,更是陛下的臣民。"}, {"start": 876.66, "end": 883.66, "text": "你们若是助纣为虐,今天就是杀了你们,也是天经地义的。"}, {"start": 883.66, "end": 884.66, "text": "皇后。"}, {"start": 884.66, "end": 885.66, "text": "皇后。"}, {"start": 885.66, "end": 890.73, "text": "是吗?常见在此。"}, {"start": 890.73, "end": 894.73, "text": "陛下若要杀我,就请拔剑吧。"}, {"start": 894.73, "end": 896.73, "text": "曹洪,你敢放肆。"}, {"start": 898.73, "end": 906.73, "text": "皇后,咱们虽然同是曹氏血脉,但是今日之事,臣不敢以私废公。"}, {"start": 906.73, "end": 913.73, "text": "陛下,起行吧,满朝文武都在门外等着,请陛下临朝。"}, {"start": 914.73, "end": 921.73, "text": "曹洪、曹兄,我父王公盖环语,名满天下,还不敢窃取神器。"}, {"start": 921.73, "end": 925.73, "text": "而你们两个竟敢帮着曹匹行篡你之事。"}, {"start": 925.73, "end": 930.73, "text": "如果是这样,必遭天歉雷劈。"}, {"start": 931.73, "end": 937.73, "text": "陛下,快快临朝吧,否则我等要嫁你出去了。"}, {"start": 937.73, "end": 944.71, "text": "你不用理这些恶奴们,你是天子啊。"}, {"start": 944.71, "end": 946.71, "text": "他们不敢拔你怎么样的。"}, {"start": 946.71, "end": 961.68, "text": "天子,掌上天子,群小所逼,可奈其何。"}, {"start": 961.68, "end": 1036.54, "text": "陛下已经计盖过祖宗了,是不是可以做决断了?"}, {"start": 1036.54, "end": 1068.18, "text": "是汉禄久矣,其中多有大汉功臣子孙。"}, {"start": 1068.18, "end": 1075.18, "text": "你们,你们真忍心做此不臣之事?"}, {"start": 1075.18, "end": 1082.18, "text": "陛下,臣等劝你善让,皆是对山川社稷的一片忠心啊。"}, {"start": 1082.18, "end": 1089.18, "text": "说实话,先王在世时,我等就想拥立先王,改朝换代了。"}, {"start": 1089.18, "end": 1094.18, "text": "可惜啊,先王天不假年,未及如愿。"}, {"start": 1094.18, "end": 1098.18, "text": "现在新王继位,仍是执意不从。"}, {"start": 1098.18, "end": 1104.18, "text": "但臣等宁可让新王斩了,也要推新王及大位。"}, {"start": 1104.18, "end": 1110.18, "text": "若是陛下坚持不肯善让,只怕祸起萧强。"}, {"start": 1110.18, "end": 1114.39, "text": "还杀朕?"}, {"start": 1114.39, "end": 1123.39, "text": "天下人都知道,陛下一箭雍举,盘复朝中,毫无人主之福。"}, {"start": 1123.39, "end": 1130.39, "text": "如果不是魏王坐在你的身边,想杀陛下者何止成千上万。"}, {"start": 1131.39, "end": 1141.38, "text": "时之于此,你有何意啊?"}, {"start": 1141.38, "end": 1156.34, "text": "臣回府代诏。"}, {"start": 1156.34, "end": 1171.66, "text": "从与不从,陛下快发一言。"}, {"start": 1178.71, "end": 1194.86, "text": "大汗事言言四百年,今日竟无一中良开言,都是朕的国。"}, {"start": 1195.86, "end": 1205.42, "text": "玉玺关何在?"}, {"start": 1205.42, "end": 1206.42, "text": "臣在。"}, {"start": 1206.42, "end": 1250.05, "text": "不,帝王之习,得之于天,岂能交于贼子。"}, {"start": 1252.05, "end": 1255.05, "text": "臣宁断头,不交习。"}, {"start": 1256.05, "end": 1257.05, "text": "祖辟!"}, {"start": 1257.05, "end": 1261.77, "text": "你想殉葬啊?"}, {"start": 1261.77, "end": 1274.07, "text": "春秋游董湖宫,祖辟愿意不起后臣。"}, {"start": 1274.07, "end": 1281.07, "text": "儿等奸逆,篡得了汉庭,却篡不了青石。"}, {"start": 1282.07, "end": 1289.07, "text": "千古骂兵,万夫所指,便是你们的下场。"}, {"start": 1291.07, "end": 1310.76, "text": "一千玉玺关,胜过满朝宁臣。"}, {"start": 1311.76, "end": 1315.76, "text": "下旨,否则,陛下也将血剑单毙。"}, {"start": 1315.76, "end": 1317.76, "text": "请陛下下旨。"}, {"start": 1317.76, "end": 1318.76, "text": "借莫如此。"}, {"start": 1318.76, "end": 1396.22, "text": "魏王,还认我这个皇后?还认我这个姐姐吗?"}, {"start": 1396.22, "end": 1403.91, "text": "当然,同胞姐弟,生生世世如此。"}, {"start": 1403.91, "end": 1415.22, "text": "那么,你可否容我说几句话呢?"}, {"start": 1416.22, "end": 1417.22, "text": "姐姐请讲。"}, {"start": 1417.22, "end": 1426.72, "text": "魏王啊,你继承王位,才几天啊,就想着要军临天下了。"}, {"start": 1426.72, "end": 1435.82, "text": "你难道不怕父王的在天之灵会诅咒你吗?"}, {"start": 1436.82, "end": 1439.82, "text": "不怕,非但不怕。"}, {"start": 1440.82, "end": 1448.78, "text": "我想父王的在天之灵看到了,肯定会为我高兴的。"}, {"start": 1448.78, "end": 1450.78, "text": "那天下的臣民呢?"}, {"start": 1450.78, "end": 1463.72, "text": "只要我是我的子民们,食有粮,居有所,供有赏罪有罚,他们会称我为圣君。"}, {"start": 1465.72, "end": 1469.72, "text": "圣逃脾,你可真是无耻啊。"}, {"start": 1469.72, "end": 1472.72, "text": "那我要做什么?你知不知道我要做什么?"}, {"start": 1472.72, "end": 1475.72, "text": "我今天端实情,远远高于人尺。"}, {"start": 1475.72, "end": 1495.15, "text": "我也要劝你一句,你,是曹氏子孙,你身上流着我们曹家的血。"}, {"start": 1495.15, "end": 1507.18, "text": "你的父王让你成为皇后的,你知道父王当年问过你吗?"}, {"start": 1507.18, "end": 1510.18, "text": "父王不想让你成为皇后的,"}, {"start": 1510.18, "end": 1515.61, "text": "父王不想让你成为皇后的,"}, {"start": 1515.61, "end": 1521.61, "text": "父王让你成为皇后的,你知道父王当年为什么要这么做吗?"}, {"start": 1521.61, "end": 1535.64, "text": "他是想让天子,为我们曹家的女婿,背叛了曹家的祖宗。"}, {"start": 1535.64, "end": 1542.9, "text": "在天之灵,才真的要诅咒你。"}, {"start": 1542.9, "end": 1553.98, "text": "真的?"}, {"start": 1553.98, "end": 1624.01, "text": "对应天意,身上这身细甲,是父王留给我的。"}, {"start": 1624.01, "end": 1627.01, "text": "你就不要逆天行事了。"}, {"start": 1627.01, "end": 1634.7, "text": "回宫去吧,我保证,你终身父母。"}, {"start": 1634.7, "end": 1661.5, "text": "朕在位三十二年,屡遭天下盗附,信赖祖宗之灵,"}, {"start": 1661.5, "end": 1671.63, "text": "为尔附存,今瞻仰天下,"}, {"start": 1672.63, "end": 1686.19, "text": "父察民心,言经之朔,行运在乎曹氏。"}, {"start": 1686.19, "end": 1698.63, "text": "你前往,既属威武之际,今往,"}, {"start": 1698.63, "end": 1702.63, "text": "有光耀明德,亦应其技。"}, {"start": 1702.63, "end": 1706.63, "text": "隶属昭明,信可知矣。"}, {"start": 1706.63, "end": 1711.63, "text": "夫大道之行,天下为功。"}, {"start": 1711.63, "end": 1716.63, "text": "唐遥不思已绝子,而明波于无穷。"}, {"start": 1716.63, "end": 1721.63, "text": "朕妾沐焉,今其追踵遥典,"}, {"start": 1721.63, "end": 1725.63, "text": "善位于丞相魏王。"}, {"start": 1725.63, "end": 1729.63, "text": "望其务慈,钦旨。"}, {"start": 1729.63, "end": 1738.06, "text": "花仙,你觉得这道善位诏书,如何?"}, {"start": 1739.06, "end": 1742.06, "text": "言此还算恳妾。"}, {"start": 1742.06, "end": 1748.33, "text": "与其说是恳妾,不如说是欺妾。"}, {"start": 1748.33, "end": 1754.33, "text": "听上去,好像是魏王用刀,逼着他善让似的。"}, {"start": 1754.33, "end": 1758.22, "text": "殿下的意思是?"}, {"start": 1758.22, "end": 1780.26, "text": "慈,诸你替我上一道表彰,慈恩不受,"}, {"start": 1780.26, "end": 1783.26, "text": "以绝小人之棒。"}, {"start": 1783.26, "end": 1784.26, "text": "遵命。"}, {"start": 1784.26, "end": 1800.84, "text": "陛下,这是魏王殿下的慈恩表彰。"}, {"start": 1800.84, "end": 1830.32, "text": "如此谦虚,朕为之奈何呀?"}, {"start": 1830.32, "end": 1835.32, "text": "陛下,这道善位诏书,是谁笔录的?"}, {"start": 1835.32, "end": 1838.32, "text": "是,是下官。"}, {"start": 1838.32, "end": 1843.32, "text": "这等让人误以为魏王失德的言辞,"}, {"start": 1843.32, "end": 1845.32, "text": "你也敢录下?"}, {"start": 1845.32, "end": 1848.89, "text": "你是何居心?"}, {"start": 1848.89, "end": 1849.89, "text": "拿出去!"}, {"start": 1849.89, "end": 1850.89, "text": "斩首!"}, {"start": 1850.89, "end": 1851.89, "text": "诺!"}, {"start": 1851.89, "end": 1853.89, "text": "陛下!陛下!"}, {"start": 1853.89, "end": 1854.89, "text": "陛下,救命!"}, {"start": 1854.89, "end": 1855.89, "text": "陛下!"}, {"start": 1855.89, "end": 1866.22, "text": "陛下,再受一诏。"}, {"start": 1866.22, "end": 1870.98, "text": "朕就再受一诏吧。"}, {"start": 1870.98, "end": 1871.98, "text": "拿卷来。"}, {"start": 1871.98, "end": 1872.98, "text": "诺。"}, {"start": 1872.98, "end": 1881.06, "text": "霍卿啊,这一次就由你执笔草照好吗?"}, {"start": 1881.06, "end": 1886.06, "text": "陛下这话说得不对,臣怎敢僭越?"}, {"start": 1886.06, "end": 1896.9, "text": "要朕亲自你写诏书?"}, {"start": 1896.9, "end": 1900.9, "text": "这样才能显示出天子的至诚之心吗?"}, {"start": 1901.9, "end": 1951.96, "text": "写完了。"}, {"start": 1951.96, "end": 1956.91, "text": "妾上天子玉玺。"}, {"start": 1956.91, "end": 1964.11, "text": "陛下,可以临朝了。"}, {"start": 1964.11, "end": 1968.11, "text": "你得亲自把这道善位诏书,"}, {"start": 1968.11, "end": 1970.11, "text": "授予魏王殿下。"}, {"start": 1970.11, "end": 2062.77, "text": "魏王何在?"}, {"start": 2062.77, "end": 2065.77, "text": "微闻陛下旨意,"}, {"start": 2065.77, "end": 2068.77, "text": "魏王只能在宫外待找。"}, {"start": 2068.77, "end": 2071.77, "text": "召魏王入宫。"}, {"start": 2071.77, "end": 2075.77, "text": "陛下口谕,召魏王入宫。"}, {"start": 2075.77, "end": 2077.77, "text": "召魏王入宫。"}, {"start": 2077.77, "end": 2108.27, "text": "陛下。"}, {"start": 2108.27, "end": 2125.74, "text": "生逢乱世,天下三分,战乱朕,"}, {"start": 2125.74, "end": 2130.74, "text": "蒙受魏王恩德,"}, {"start": 2130.74, "end": 2134.74, "text": "才得以继续悍者。"}, {"start": 2134.74, "end": 2138.74, "text": "今瞻仰天象,"}, {"start": 2138.74, "end": 2141.74, "text": "抚察民心,"}, {"start": 2141.74, "end": 2146.74, "text": "大汉气数已然精进,"}, {"start": 2146.74, "end": 2149.99, "text": "天心民意,"}, {"start": 2149.99, "end": 2157.45, "text": "无不惧过魏王。"}, {"start": 2157.45, "end": 2164.07, "text": "朕愿以奉天命,"}, {"start": 2164.07, "end": 2166.07, "text": "顺民心,"}, {"start": 2166.07, "end": 2169.07, "text": "效法先贤遥典,"}, {"start": 2169.07, "end": 2173.45, "text": "臣安慰于魏王。"}, {"start": 2173.45, "end": 2178.26, "text": "禀陛下,"}, {"start": 2178.26, "end": 2181.26, "text": "臣德行薄浅,"}, {"start": 2181.26, "end": 2184.26, "text": "岂敢见居九五之尊?"}, {"start": 2184.26, "end": 2186.26, "text": "请陛下令求大贤,"}, {"start": 2186.26, "end": 2188.26, "text": "以似天位,"}, {"start": 2188.26, "end": 2190.26, "text": "臣只当尽忠孝命,"}, {"start": 2190.26, "end": 2204.69, "text": "别无他求。"}, {"start": 2204.69, "end": 2209.69, "text": "朕以在下善国之兆,"}, {"start": 2209.69, "end": 2213.69, "text": "魏王仍然不接。"}, {"start": 2213.69, "end": 2217.69, "text": "朕如此奈何?"}, {"start": 2217.69, "end": 2219.69, "text": "陛下,"}, {"start": 2219.69, "end": 2222.69, "text": "天子善让受善者,"}, {"start": 2222.69, "end": 2225.69, "text": "应当一词再词三词,"}, {"start": 2225.69, "end": 2228.69, "text": "为之圣德呀。"}, {"start": 2228.69, "end": 2230.69, "text": "陛下难道不明白吗?"}, {"start": 2230.69, "end": 2233.69, "text": "你想要朕怎样?"}, {"start": 2233.69, "end": 2236.69, "text": "请陛下再受第三诏,"}, {"start": 2236.69, "end": 2239.69, "text": "亦见天子之诚啊。"}, {"start": 2239.69, "end": 2245.56, "text": "天哪!"}, {"start": 2245.56, "end": 2248.56, "text": "杀朕两次,还要杀朕第三次吗?"}, {"start": 2248.56, "end": 2276.32, "text": "他们没有为难你吧?"}, {"start": 2276.32, "end": 2300.94, "text": "陛下,陛下!"}, {"start": 2300.94, "end": 2333.28, "text": "人食草肉,"}, {"start": 2333.28, "end": 2334.28, "text": "我从之见吗?"}, {"start": 2334.28, "end": 2345.5, "text": "你为让给他,陛下,"}, {"start": 2345.5, "end": 2349.5, "text": "臣妾愿以终生陪朕,"}, {"start": 2349.5, "end": 2379.54, "text": "生死不离。"}, {"start": 2379.54, "end": 2381.54, "text": "司马仪叩见吾皇。"}, {"start": 2381.54, "end": 2393.74, "text": "司马仪,"}, {"start": 2393.74, "end": 2399.21, "text": "很久都没有人向朕叩首了,"}, {"start": 2399.21, "end": 2401.21, "text": "你又何必多此一举呢?"}, {"start": 2401.21, "end": 2404.21, "text": "臣世代为汉臣,"}, {"start": 2404.21, "end": 2406.21, "text": "只要陛下一日为天子,"}, {"start": 2406.21, "end": 2410.21, "text": "臣就恭守一日君臣之道。"}, {"start": 2410.21, "end": 2414.42, "text": "真是难得啊,"}, {"start": 2414.42, "end": 2418.42, "text": "还有人记得君臣之道。"}, {"start": 2418.42, "end": 2423.26, "text": "平身吧。"}, {"start": 2423.26, "end": 2427.24, "text": "谢陛下。"}, {"start": 2427.24, "end": 2432.49, "text": "这么晚了,你来做甚?"}, {"start": 2432.49, "end": 2434.49, "text": "华新大人,"}, {"start": 2434.49, "end": 2436.49, "text": "奉陛下旨意,"}, {"start": 2436.49, "end": 2439.49, "text": "也令人在城外住起受善高谈。"}, {"start": 2439.49, "end": 2441.49, "text": "这没有下旨啊?"}, {"start": 2443.49, "end": 2446.49, "text": "那一定是陛下记错了,"}, {"start": 2446.49, "end": 2448.49, "text": "华新大人不会错,"}, {"start": 2448.49, "end": 2450.49, "text": "是吗陛下?"}]