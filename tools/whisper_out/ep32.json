[{"start": 3.98, "end": 9.58, "text": "我意 吉祥 金周用兵 攻伐刘备"}, {"start": 11.1, "end": 15.34, "text": "父亲 此时京乡正是秋雨季节"}, {"start": 15.82, "end": 18.06, "text": "恐怕不利于骑兵作战"}, {"start": 18.54, "end": 21.74, "text": "是否等到雨季过后"}, {"start": 22.14, "end": 26.7, "text": "我儿长进了 知道天时地利了"}, {"start": 30.06, "end": 34.94, "text": "不过 金乡雨季即将结束"}, {"start": 35.58, "end": 39.1, "text": "而我们从许昌进军到金乡"}, {"start": 39.1, "end": 40.62, "text": "需要五天时间"}, {"start": 41.18, "end": 43.58, "text": "等我们的人马到金乡的时候"}, {"start": 43.9, "end": 45.9, "text": "不但雨季已经结束了"}, {"start": 46.06, "end": 48.78, "text": "就连地面也已经风干了"}, {"start": 49.02, "end": 51.26, "text": "丝毫无碍战马奔驰"}, {"start": 51.58, "end": 52.54, "text": "你说对吗"}, {"start": 53.82, "end": 54.86, "text": "父亲说得是"}, {"start": 55.02, "end": 57.34, "text": "我忽略了先君的时间"}, {"start": 60.0, "end": 61.28, "text": "曹人听令"}, {"start": 61.68, "end": 62.56, "text": "末将在"}, {"start": 62.96, "end": 64.48, "text": "命你为主将"}, {"start": 64.8, "end": 66.48, "text": "李典为副将"}, {"start": 66.64, "end": 69.36, "text": "率金兵五万进驻樊城"}, {"start": 69.68, "end": 71.36, "text": "虎视京乡各郡"}, {"start": 71.76, "end": 74.32, "text": "待我令相则攻取新野"}, {"start": 75.12, "end": 76.32, "text": "末将领命"}, {"start": 77.12, "end": 79.2, "text": "你们这就去整军待命"}, {"start": 79.52, "end": 80.96, "text": "明日出发"}, {"start": 81.2, "end": 81.76, "text": "诺"}, {"start": 82.32, "end": 82.8, "text": "诺"}, {"start": 84.74, "end": 85.38, "text": "李典"}, {"start": 88.53, "end": 89.09, "text": "丞相"}, {"start": 91.15, "end": 93.87, "text": "我知道你出事谨慎"}, {"start": 94.11, "end": 97.23, "text": "所以才派你给曹人做副将"}, {"start": 98.35, "end": 100.67, "text": "曹人虽勇"}, {"start": 101.31, "end": 102.43, "text": "但他性急"}, {"start": 103.39, "end": 104.59, "text": "立功心切"}, {"start": 104.99, "end": 105.79, "text": "必要时"}, {"start": 106.03, "end": 108.11, "text": "你要劝他妥当用兵"}, {"start": 109.23, "end": 109.79, "text": "遵命"}, {"start": 111.82, "end": 113.98, "text": "刘备兵虽少却是近敌"}, {"start": 115.02, "end": 117.1, "text": "你们屯兵樊城后"}, {"start": 117.42, "end": 119.26, "text": "要关起虎视"}, {"start": 119.74, "end": 121.74, "text": "再择动兵时机"}, {"start": 123.34, "end": 124.54, "text": "末将明白了"}, {"start": 124.86, "end": 125.58, "text": "去忙吧"}, {"start": 126.14, "end": 126.62, "text": "诺"}, {"start": 139.98, "end": 140.62, "text": "将军"}, {"start": 141.26, "end": 142.86, "text": "前面就是樊城了"}, {"start": 143.58, "end": 144.7, "text": "令城守开门"}, {"start": 144.86, "end": 146.3, "text": "说上将军曹人到了"}, {"start": 146.3, "end": 149.39, "text": "上将军"}, {"start": 149.39, "end": 149.95, "text": "将军"}, {"start": 150.43, "end": 151.23, "text": "我们进城吧"}, {"start": 151.79, "end": 153.15, "text": "你领军进城休息吧"}, {"start": 153.63, "end": 156.43, "text": "我亲领树记到新野查探一番"}, {"start": 156.99, "end": 159.47, "text": "听说新野居此八十余里"}, {"start": 159.63, "end": 161.63, "text": "探宁可派少记前去"}, {"start": 161.95, "end": 163.55, "text": "何劳将军亲往呢"}, {"start": 165.23, "end": 166.83, "text": "大战已迫在眉睫"}, {"start": 167.07, "end": 170.27, "text": "为将者应当知己知彼"}, {"start": 170.51, "end": 172.59, "text": "丞相让我们屯居樊城"}, {"start": 172.99, "end": 174.19, "text": "待命出击"}, {"start": 174.67, "end": 175.87, "text": "听将军的意思"}, {"start": 176.19, "end": 178.03, "text": "仿佛即刻就要出战了"}, {"start": 180.03, "end": 180.67, "text": "不错"}, {"start": 181.95, "end": 183.15, "text": "你传令各部"}, {"start": 183.47, "end": 185.47, "text": "今日让他们好生休息"}, {"start": 185.71, "end": 186.91, "text": "明日五更出发"}, {"start": 187.47, "end": 190.19, "text": "随我踏平新野生擒留备"}, {"start": 191.07, "end": 192.67, "text": "将军不可轻敌"}, {"start": 193.31, "end": 195.79, "text": "我们还是等候丞相的军令到时"}, {"start": 195.79, "end": 196.83, "text": "再进军吧"}, {"start": 199.31, "end": 201.71, "text": "我看你是害怕刘关璋啊"}, {"start": 202.27, "end": 203.71, "text": "我不怕刘关璋"}, {"start": 204.43, "end": 206.43, "text": "却也不轻视刘关璋啊"}, {"start": 206.67, "end": 207.31, "text": "那好"}, {"start": 207.79, "end": 209.31, "text": "明日我给你五千军马"}, {"start": 210.11, "end": 210.99, "text": "你守城吧"}, {"start": 211.39, "end": 212.59, "text": "我自去取群野"}, {"start": 212.91, "end": 214.19, "text": "将军不可呀"}, {"start": 214.43, "end": 214.99, "text": "李鼎"}, {"start": 216.19, "end": 217.87, "text": "你嫉妒我独剑大功吗"}, {"start": 218.59, "end": 220.35, "text": "末将绝无此意啊"}, {"start": 220.59, "end": 222.83, "text": "那你为何违抗我的命令"}, {"start": 227.22, "end": 228.26, "text": "在下奉命"}, {"start": 230.18, "end": 230.74, "text": "跟我走"}, {"start": 231.22, "end": 231.78, "text": "撤"}, {"start": 236.3, "end": 236.86, "text": "进城"}, {"start": 243.25, "end": 243.73, "text": "主公"}, {"start": 243.81, "end": 244.45, "text": "草军到了"}, {"start": 244.45, "end": 246.13, "text": "上将军草儿已在关前部下战阵"}, {"start": 246.13, "end": 246.85, "text": "生生挑战"}, {"start": 247.41, "end": 248.45, "text": "草军来得好快啊"}, {"start": 248.45, "end": 250.21, "text": "军师还说三十日兵当"}, {"start": 250.21, "end": 251.65, "text": "前后差不过两天"}, {"start": 251.65, "end": 253.09, "text": "现在足足差了三天"}, {"start": 253.09, "end": 255.41, "text": "只差一天军师已经是料敌入城"}, {"start": 255.41, "end": 256.53, "text": "三天不要强辩"}, {"start": 257.25, "end": 258.05, "text": "余计位置"}, {"start": 258.53, "end": 259.97, "text": "草草已经向新野领兵"}, {"start": 260.29, "end": 262.37, "text": "在他进军堂中余计结束"}, {"start": 262.85, "end": 263.73, "text": "地面也干了"}, {"start": 264.77, "end": 265.89, "text": "草草不反抗"}, {"start": 267.09, "end": 337.82, "text": "真有上将军之才啊"}, {"start": 337.82, "end": 347.81, "text": "中中饭酒之辈"}, {"start": 348.13, "end": 350.05, "text": "识得草人将军阵法吗"}, {"start": 350.77, "end": 352.05, "text": "快快出城迎战"}, {"start": 352.45, "end": 353.89, "text": "否则攻破城池"}, {"start": 354.21, "end": 355.49, "text": "集一拳不留"}, {"start": 363.7, "end": 365.38, "text": "令将士坚守不战"}, {"start": 365.78, "end": 367.46, "text": "只用弓弩射出两翼击了"}, {"start": 368.02, "end": 369.06, "text": "待中午过后"}, {"start": 369.54, "end": 370.5, "text": "离使烧录"}, {"start": 371.38, "end": 372.58, "text": "我再射弓弓"}, {"start": 374.48, "end": 374.96, "text": "子龙"}, {"start": 375.36, "end": 376.08, "text": "快去布置"}, {"start": 376.4, "end": 393.89, "text": "既正盛"}, {"start": 418.03, "end": 419.55, "text": "草军所住的凡城"}, {"start": 420.03, "end": 422.19, "text": "乃是一座五百多年的古城了"}, {"start": 422.91, "end": 424.99, "text": "在下曾经登城观景"}, {"start": 425.87, "end": 428.19, "text": "看到城楼西角处"}, {"start": 428.43, "end": 430.51, "text": "长着一层菩萨大的灵芝"}, {"start": 430.99, "end": 433.15, "text": "黑里透红极为珍贵"}, {"start": 433.47, "end": 434.51, "text": "难得 难得"}, {"start": 436.11, "end": 437.15, "text": "连年兵火"}, {"start": 437.55, "end": 439.47, "text": "也不知那灵芝焚毁了没有"}, {"start": 440.03, "end": 440.51, "text": "是啊"}, {"start": 441.15, "end": 442.03, "text": "如果在的话"}, {"start": 442.35, "end": 443.63, "text": "早晚取来泡茶"}, {"start": 444.11, "end": 444.91, "text": "那可是"}, {"start": 452.14, "end": 452.86, "text": "军师"}, {"start": 453.98, "end": 455.26, "text": "茶喝够了吗"}, {"start": 456.3, "end": 457.1, "text": "都正午了"}, {"start": 457.42, "end": 458.3, "text": "破敌之策"}, {"start": 458.54, "end": 459.42, "text": "想出来了没有"}, {"start": 468.88, "end": 469.92, "text": "草人引阵"}, {"start": 470.16, "end": 471.76, "text": "名叫八门金锁阵"}, {"start": 472.56, "end": 473.04, "text": "修"}, {"start": 474.16, "end": 474.64, "text": "升"}, {"start": 475.6, "end": 476.16, "text": "伤"}, {"start": 477.12, "end": 477.52, "text": "渡"}, {"start": 478.32, "end": 478.96, "text": "警"}, {"start": 481.3, "end": 481.78, "text": "经"}, {"start": 482.9, "end": 483.3, "text": "开"}, {"start": 483.62, "end": 484.1, "text": "八门"}, {"start": 484.98, "end": 487.14, "text": "此阵本是孙兵所创的阵"}, {"start": 487.7, "end": 489.3, "text": "经历代兵家发展"}, {"start": 489.7, "end": 490.5, "text": "已有变化"}, {"start": 492.78, "end": 494.22, "text": "阵中这座将台"}, {"start": 494.94, "end": 495.82, "text": "名叫龙眼"}, {"start": 497.26, "end": 498.38, "text": "就是后来所创"}, {"start": 499.26, "end": 499.82, "text": "不过"}, {"start": 500.3, "end": 502.38, "text": "草人只学得阵形阵法"}, {"start": 502.78, "end": 503.98, "text": "却没有学得精髓"}, {"start": 505.26, "end": 506.38, "text": "只需一员猛将"}, {"start": 506.7, "end": 507.82, "text": "带五百金甲"}, {"start": 508.78, "end": 511.02, "text": "从东南升门杀入"}, {"start": 512.7, "end": 514.62, "text": "从正西景门杀出"}, {"start": 515.34, "end": 516.54, "text": "此阵必破"}, {"start": 516.94, "end": 521.86, "text": "我去"}, {"start": 523.3, "end": 523.94, "text": "我去"}, {"start": 524.5, "end": 527.46, "text": "子龙啊"}, {"start": 528.82, "end": 531.3, "text": "听说你一颗铁胆七尺长枪"}, {"start": 532.02, "end": 533.3, "text": "除入万军从中"}, {"start": 533.62, "end": 535.06, "text": "有如关羽赏花"}, {"start": 536.1, "end": 536.66, "text": "那就"}, {"start": 537.46, "end": 538.9, "text": "请你辛苦一趟如何"}, {"start": 539.22, "end": 539.94, "text": "末将领命"}, {"start": 540.34, "end": 544.19, "text": "徐叔"}, {"start": 544.83, "end": 546.43, "text": "你是故意去按张义德啊"}, {"start": 548.43, "end": 548.99, "text": "岂敢"}, {"start": 550.51, "end": 552.19, "text": "待赵将军破阵后"}, {"start": 552.67, "end": 554.11, "text": "张将军与关将军"}, {"start": 554.43, "end": 555.63, "text": "就可以随主公"}, {"start": 556.03, "end": 557.15, "text": "大举杀入"}, {"start": 560.59, "end": 561.07, "text": "好"}, {"start": 562.35, "end": 562.91, "text": "来人哪"}, {"start": 563.07, "end": 563.47, "text": "在"}, {"start": 563.71, "end": 564.75, "text": "取我战甲来"}, {"start": 564.83, "end": 565.39, "text": "遵命"}, {"start": 975.52, "end": 976.32, "text": "伤势重吗"}, {"start": 978.02, "end": 978.66, "text": "不碍事"}, {"start": 981.33, "end": 982.13, "text": "你说得对"}, {"start": 983.41, "end": 984.05, "text": "此阵"}, {"start": 984.53, "end": 985.41, "text": "我轻敌了"}, {"start": 988.48, "end": 989.44, "text": "没想到"}, {"start": 990.72, "end": 992.32, "text": "刘备手下有能人"}, {"start": 992.8, "end": 994.88, "text": "竟然破了我的八百金锁阵"}, {"start": 996.56, "end": 997.36, "text": "在下建议"}, {"start": 998.24, "end": 999.52, "text": "退军驻守凡城"}, {"start": 1000.0, "end": 1000.8, "text": "立即遣人"}, {"start": 1001.04, "end": 1002.4, "text": "将敌情报给丞相"}, {"start": 1002.96, "end": 1004.64, "text": "待丞相的大军到后"}, {"start": 1005.04, "end": 1006.08, "text": "再取新野"}, {"start": 1008.4, "end": 1009.76, "text": "这新野淡丸之地"}, {"start": 1010.08, "end": 1011.36, "text": "何劳丞相亲征啊"}, {"start": 1013.28, "end": 1013.76, "text": "此外"}, {"start": 1015.44, "end": 1016.56, "text": "今日的拜训"}, {"start": 1016.8, "end": 1018.16, "text": "你也不必禀报丞相"}, {"start": 1019.2, "end": 1020.96, "text": "待我今夜攻下新野"}, {"start": 1021.68, "end": 1022.96, "text": "你再一并禀报吧"}, {"start": 1023.36, "end": 1023.76, "text": "什么"}, {"start": 1024.48, "end": 1024.96, "text": "将军"}, {"start": 1024.96, "end": 1026.32, "text": "你想夜袭新野"}, {"start": 1029.63, "end": 1030.27, "text": "正是"}, {"start": 1030.99, "end": 1032.96, "text": "刘备"}, {"start": 1033.52, "end": 1034.8, "text": "刚刚胜了一场"}, {"start": 1035.68, "end": 1037.6, "text": "他肯定是性高才烈"}, {"start": 1038.32, "end": 1039.6, "text": "他见我军兵败"}, {"start": 1040.96, "end": 1042.08, "text": "我又受了伤"}, {"start": 1042.72, "end": 1045.52, "text": "必然以为我不敢再轻举妄动了"}, {"start": 1046.0, "end": 1049.82, "text": "我偏要出其所料"}, {"start": 1050.46, "end": 1051.42, "text": "夜袭新野"}, {"start": 1052.06, "end": 1053.18, "text": "兵法于"}, {"start": 1053.5, "end": 1056.22, "text": "出其不易"}, {"start": 1056.86, "end": 1057.98, "text": "攻其无妨"}, {"start": 1058.3, "end": 1059.9, "text": "正是至此时啊"}, {"start": 1060.38, "end": 1060.94, "text": "将军"}, {"start": 1061.5, "end": 1062.62, "text": "不可轻敌啊"}, {"start": 1062.62, "end": 1063.66, "text": "不可轻敌啊"}, {"start": 1064.14, "end": 1065.66, "text": "刘备身边如有高人"}, {"start": 1065.98, "end": 1067.34, "text": "那他定有防备啊"}, {"start": 1067.58, "end": 1068.06, "text": "将军"}, {"start": 1068.22, "end": 1070.06, "text": "不能一物再物啊 敏典"}, {"start": 1071.42, "end": 1072.54, "text": "你这么胆小"}, {"start": 1073.02, "end": 1074.06, "text": "你还打什么仗"}, {"start": 1077.49, "end": 1078.45, "text": "你如果害怕"}, {"start": 1079.17, "end": 1080.13, "text": "还是留守吧"}, {"start": 1080.45, "end": 1081.89, "text": "我自领军前去 将军"}, {"start": 1082.85, "end": 1084.45, "text": "将军如果非去不可"}, {"start": 1084.93, "end": 1086.85, "text": "在下也当领一支兵马"}, {"start": 1087.25, "end": 1088.29, "text": "用以接应"}, {"start": 1090.53, "end": 1091.01, "text": "成"}, {"start": 1091.57, "end": 1092.69, "text": "我分你五千军"}, {"start": 1093.65, "end": 1095.25, "text": "据我二十里根茧"}, {"start": 1096.21, "end": 1097.65, "text": "一方不测"}, {"start": 1098.21, "end": 1100.29, "text": "他们那是什么破八门鸡所战"}, {"start": 1101.57, "end": 1103.01, "text": "被子龙的铁骑一冲"}, {"start": 1103.57, "end": 1105.25, "text": "现在全成了破关烂岛了"}, {"start": 1107.65, "end": 1109.25, "text": "朝军杀亡足足两千人马"}, {"start": 1109.49, "end": 1110.85, "text": "再加上关将军这么一射"}, {"start": 1111.17, "end": 1112.13, "text": "草人掉下台来"}, {"start": 1112.37, "end": 1113.49, "text": "差点性命不保啊"}, {"start": 1115.01, "end": 1116.93, "text": "看来朝军也是不堪一击啊"}, {"start": 1117.33, "end": 1118.29, "text": "不过如此事"}, {"start": 1119.25, "end": 1120.21, "text": "不过如此嘛"}, {"start": 1124.53, "end": 1125.09, "text": "先生"}, {"start": 1136.03, "end": 1136.51, "text": "先生"}, {"start": 1137.87, "end": 1139.79, "text": "曹人虽然折了一阵"}, {"start": 1140.27, "end": 1141.31, "text": "但并没有完败"}, {"start": 1142.03, "end": 1144.11, "text": "接下来我们该当如何啊"}, {"start": 1144.99, "end": 1146.99, "text": "我料曹人今夜必来接应"}, {"start": 1147.39, "end": 1149.07, "text": "这也是曹操惯用的手法"}, {"start": 1149.79, "end": 1150.67, "text": "败而不退"}, {"start": 1151.23, "end": 1153.31, "text": "反而出其不意再次进攻"}, {"start": 1154.59, "end": 1157.15, "text": "曹人平生就喜欢效仿曹操"}, {"start": 1158.03, "end": 1160.03, "text": "只可惜他学曹操"}, {"start": 1160.43, "end": 1161.87, "text": "就像学八阵法一样"}, {"start": 1162.19, "end": 1163.63, "text": "只学了个皮毛而已"}, {"start": 1164.43, "end": 1165.71, "text": "曹人兵风所向"}, {"start": 1165.95, "end": 1167.15, "text": "是我们城外的大营"}, {"start": 1167.55, "end": 1169.63, "text": "我们应当在曹人进军的半路上"}, {"start": 1169.63, "end": 1170.19, "text": "伏击他"}, {"start": 1171.47, "end": 1172.91, "text": "凡成于心野之间"}, {"start": 1173.39, "end": 1174.27, "text": "有一片山瓦"}, {"start": 1174.67, "end": 1175.55, "text": "名叫蛇口"}, {"start": 1176.83, "end": 1177.55, "text": "张飞 赵云"}, {"start": 1178.59, "end": 1180.43, "text": "准你们领一万军马"}, {"start": 1180.83, "end": 1183.15, "text": "埋伏于蛇口前后两端"}, {"start": 1183.87, "end": 1185.71, "text": "待曹人军到放他进来"}, {"start": 1186.67, "end": 1187.87, "text": "待他军过其败"}, {"start": 1188.19, "end": 1189.63, "text": "你俩再分头杀出"}, {"start": 1190.19, "end": 1191.71, "text": "叫曹军守尾难顾"}, {"start": 1191.87, "end": 1193.15, "text": "必然大获全胜"}, {"start": 1193.71, "end": 1194.35, "text": "遵命"}, {"start": 1199.06, "end": 1199.62, "text": "绝尺"}, {"start": 1200.26, "end": 1200.98, "text": "那我呢"}, {"start": 1203.18, "end": 1204.38, "text": "官将军辛苦些"}, {"start": 1204.94, "end": 1206.62, "text": "去凡成采灵芝吧"}, {"start": 1207.02, "end": 1210.61, "text": "什么意思"}, {"start": 1211.49, "end": 1212.85, "text": "曹人大军既出"}, {"start": 1213.09, "end": 1214.29, "text": "凡成必然空虚"}, {"start": 1215.09, "end": 1216.69, "text": "主你带八千兵马"}, {"start": 1217.17, "end": 1218.13, "text": "直取凡成"}, {"start": 1218.93, "end": 1221.01, "text": "顺便把城楼那朵灵芝采回来"}, {"start": 1221.57, "end": 1222.77, "text": "给主公泡茶喝"}, {"start": 1223.33, "end": 1223.73, "text": "当然"}, {"start": 1224.13, "end": 1225.25, "text": "如果他还在的话"}, {"start": 1226.21, "end": 1226.61, "text": "遵命"}, {"start": 1226.93, "end": 1283.65, "text": "大速前进"}, {"start": 1283.89, "end": 1284.85, "text": "穿住阵口"}, {"start": 1287.23, "end": 1287.71, "text": "别活"}, {"start": 1376.78, "end": 1377.82, "text": "叫我不必杀你"}, {"start": 1378.06, "end": 1378.7, "text": "否则"}, {"start": 1378.94, "end": 1380.62, "text": "你只有葬身这城下了"}, {"start": 1381.66, "end": 1382.22, "text": "归于"}, {"start": 1382.7, "end": 1383.1, "text": "你"}, {"start": 1384.62, "end": 1385.82, "text": "你不是我的对手"}, {"start": 1386.22, "end": 1387.74, "text": "回许昌叫曹操来"}, {"start": 1405.15, "end": 1406.19, "text": "禀主公 军师"}, {"start": 1406.51, "end": 1408.11, "text": "征召两位将军在蛇口大盛"}, {"start": 1408.27, "end": 1408.99, "text": "间敌两万"}, {"start": 1409.23, "end": 1410.59, "text": "俘获战马兵器无数"}, {"start": 1411.07, "end": 1411.47, "text": "好"}, {"start": 1420.83, "end": 1421.63, "text": "禀主公 军师"}, {"start": 1421.87, "end": 1422.91, "text": "曹人已逃回许昌"}, {"start": 1423.07, "end": 1424.27, "text": "所在残兵不到百计"}, {"start": 1426.03, "end": 1426.43, "text": "好"}, {"start": 1435.9, "end": 1436.7, "text": "禀主公 军师"}, {"start": 1436.86, "end": 1437.98, "text": "官将军已取下凡成"}, {"start": 1438.38, "end": 1439.98, "text": "城中有曹军军粮二十万大"}, {"start": 1440.14, "end": 1441.74, "text": "前十万全部归于我军"}, {"start": 1442.46, "end": 1442.86, "text": "好"}, {"start": 1443.74, "end": 1444.14, "text": "好"}, {"start": 1447.01, "end": 1448.13, "text": "你手里捧的是什么"}, {"start": 1449.81, "end": 1450.53, "text": "徐凡成后"}, {"start": 1450.69, "end": 1452.13, "text": "官将军亲自登上城楼"}, {"start": 1452.29, "end": 1453.73, "text": "又亲自采下这朵灵芝"}, {"start": 1453.89, "end": 1455.49, "text": "献与主公军师泡茶喝"}, {"start": 1455.97, "end": 1479.84, "text": "先生啊"}, {"start": 1481.95, "end": 1484.99, "text": "这灵芝待百草之盛"}, {"start": 1487.65, "end": 1488.13, "text": "先生"}, {"start": 1488.53, "end": 1491.97, "text": "你便是人中之盛啊"}, {"start": 1493.89, "end": 1494.37, "text": "主公"}, {"start": 1495.41, "end": 1496.29, "text": "主公此话"}, {"start": 1496.45, "end": 1497.73, "text": "在下万万不敢当"}, {"start": 1498.21, "end": 1520.43, "text": "刘备起兵二十余年"}, {"start": 1521.55, "end": 1522.19, "text": "屡战"}, {"start": 1524.86, "end": 1525.74, "text": "从来没有过"}, {"start": 1525.74, "end": 1527.34, "text": "像今天这样的大盛"}, {"start": 1530.03, "end": 1532.11, "text": "而且战胜的是曹军主将"}, {"start": 1533.71, "end": 1534.19, "text": "先生"}, {"start": 1534.51, "end": 1537.02, "text": "这我胜利"}, {"start": 1537.1, "end": 1568.5, "text": "百而归"}, {"start": 1569.14, "end": 1570.26, "text": "凡成也给丢了"}, {"start": 1571.86, "end": 1572.98, "text": "他把自己捆起来"}, {"start": 1573.46, "end": 1574.26, "text": "跪在府外"}, {"start": 1574.9, "end": 1576.02, "text": "等候丞相吃醉"}, {"start": 1578.4, "end": 1579.28, "text": "李典啊"}, {"start": 1580.72, "end": 1581.68, "text": "同归带罪"}, {"start": 1583.52, "end": 1584.56, "text": "叫李典进来"}, {"start": 1585.04, "end": 1595.58, "text": "给李典送榜"}, {"start": 1595.82, "end": 1596.14, "text": "诺"}, {"start": 1604.26, "end": 1606.66, "text": "罪将李典拜见丞相"}, {"start": 1609.78, "end": 1611.62, "text": "因为你处事谨慎"}, {"start": 1612.26, "end": 1614.1, "text": "我才叫你辅助曹仁"}, {"start": 1615.38, "end": 1617.22, "text": "曹仁亲敌冒进"}, {"start": 1617.94, "end": 1619.14, "text": "你为何不阻止他"}, {"start": 1619.78, "end": 1621.94, "text": "末将曾经再三地劝阻"}, {"start": 1622.1, "end": 1622.58, "text": "可是"}, {"start": 1624.34, "end": 1625.46, "text": "劝不住我"}, {"start": 1626.26, "end": 1627.54, "text": "请丞相治罪"}, {"start": 1628.5, "end": 1631.3, "text": "胜败乃兵家常事"}, {"start": 1632.66, "end": 1634.9, "text": "损几万兵丢个城池"}, {"start": 1635.78, "end": 1636.66, "text": "我不在意"}, {"start": 1637.62, "end": 1638.82, "text": "我没料到的是"}, {"start": 1639.62, "end": 1641.38, "text": "刘备居然能够识破"}, {"start": 1641.38, "end": 1642.74, "text": "我的金锁阵法"}, {"start": 1643.3, "end": 1645.89, "text": "禀丞相"}, {"start": 1646.29, "end": 1647.73, "text": "破金锁八门阵的"}, {"start": 1647.73, "end": 1648.69, "text": "不是刘备"}, {"start": 1649.01, "end": 1650.69, "text": "而是他新拜的军师"}, {"start": 1651.01, "end": 1652.13, "text": "名叫徐树"}, {"start": 1653.73, "end": 1655.01, "text": "徐树是什么人"}, {"start": 1655.41, "end": 1659.66, "text": "丞相"}, {"start": 1660.38, "end": 1661.5, "text": "此人我认识"}, {"start": 1661.98, "end": 1663.26, "text": "他叫徐元直"}, {"start": 1663.9, "end": 1665.18, "text": "襄阳明世"}, {"start": 1665.5, "end": 1666.62, "text": "精通兵法"}, {"start": 1666.7, "end": 1667.98, "text": "深明套略"}, {"start": 1669.02, "end": 1670.62, "text": "他的才华比你如何"}, {"start": 1672.3, "end": 1673.5, "text": "胜我数倍"}, {"start": 1673.66, "end": 1674.54, "text": "不可能"}, {"start": 1675.18, "end": 1677.02, "text": "数倍乃至数十倍"}, {"start": 1683.52, "end": 1685.36, "text": "刘备过去只有"}, {"start": 1686.0, "end": 1688.24, "text": "张飞 关羽等武将"}, {"start": 1689.04, "end": 1691.12, "text": "现在又添了个军师"}, {"start": 1692.0, "end": 1693.12, "text": "岂不是要"}, {"start": 1693.84, "end": 1695.44, "text": "龙生双翼了吗"}, {"start": 1712.22, "end": 1712.78, "text": "先生"}, {"start": 1715.63, "end": 1716.11, "text": "怎么了"}, {"start": 1716.43, "end": 1716.99, "text": "主公"}, {"start": 1718.19, "end": 1719.79, "text": "我小弟徐康去世了"}, {"start": 1720.35, "end": 1721.79, "text": "母亲一年过六旬"}, {"start": 1721.79, "end": 1722.67, "text": "无人公养"}, {"start": 1723.07, "end": 1724.35, "text": "正好出门乞讨"}, {"start": 1724.67, "end": 1726.11, "text": "此事被曹操知道"}, {"start": 1726.67, "end": 1727.87, "text": "曹操派人把我母亲"}, {"start": 1727.87, "end": 1729.63, "text": "抓进了续昌 下了大牢"}, {"start": 1730.27, "end": 1730.83, "text": "主公"}, {"start": 1731.39, "end": 1733.15, "text": "这是我母亲在牢里的手术"}, {"start": 1733.79, "end": 1735.39, "text": "说我如不归降曹操"}, {"start": 1735.87, "end": 1737.23, "text": "曹操就要把我母亲"}, {"start": 1737.23, "end": 1738.19, "text": "架到火炉上"}, {"start": 1738.19, "end": 1739.63, "text": "活生生烤死"}, {"start": 1740.35, "end": 1741.15, "text": "恕我无力"}, {"start": 1742.19, "end": 1743.31, "text": "我要前往续昌"}, {"start": 1744.27, "end": 1745.55, "text": "一身孰母"}, {"start": 1746.51, "end": 1747.31, "text": "先生请慢"}, {"start": 1749.89, "end": 1750.69, "text": "先生请慢"}, {"start": 1752.05, "end": 1753.17, "text": "曹操虽然奸恶"}, {"start": 1753.81, "end": 1754.93, "text": "但我想他断断"}, {"start": 1754.93, "end": 1756.21, "text": "不能把六旬老人"}, {"start": 1756.21, "end": 1757.49, "text": "架在火上生生烤死"}, {"start": 1757.49, "end": 1758.53, "text": "请先生安心"}, {"start": 1758.53, "end": 1759.89, "text": "容我设法相救如何"}, {"start": 1760.29, "end": 1760.77, "text": "不不不"}, {"start": 1761.17, "end": 1762.29, "text": "我要去续昌"}, {"start": 1762.29, "end": 1763.25, "text": "现在就去"}, {"start": 1763.25, "end": 1764.69, "text": "早到一刻是一刻"}, {"start": 1764.69, "end": 1765.65, "text": "我不能让老母"}, {"start": 1765.65, "end": 1766.85, "text": "在牢里受罪啊"}, {"start": 1767.49, "end": 1767.89, "text": "先生"}, {"start": 1773.17, "end": 1775.09, "text": "这也许是曹操的奸计呢"}, {"start": 1775.81, "end": 1776.29, "text": "主公"}, {"start": 1776.77, "end": 1777.89, "text": "这事我想过了"}, {"start": 1778.37, "end": 1779.73, "text": "哪怕是曹操的奸计"}, {"start": 1779.73, "end": 1780.53, "text": "我也要回去"}, {"start": 1781.25, "end": 1782.61, "text": "荡漾乃济州侠"}, {"start": 1782.61, "end": 1784.29, "text": "而济州早就归于曹操了"}, {"start": 1786.34, "end": 1787.78, "text": "曹操如想拿我母亲"}, {"start": 1788.5, "end": 1789.94, "text": "那简直是易如反掌"}, {"start": 1791.38, "end": 1791.78, "text": "主公"}, {"start": 1792.98, "end": 1794.34, "text": "容我告辞吧"}, {"start": 1805.57, "end": 1805.97, "text": "主公"}, {"start": 1807.73, "end": 1808.77, "text": "我身为人子"}, {"start": 1809.33, "end": 1810.45, "text": "母亲有难"}, {"start": 1810.45, "end": 1811.41, "text": "岂能做事"}, {"start": 1813.54, "end": 1813.94, "text": "此外"}, {"start": 1814.66, "end": 1815.62, "text": "我心神余乱"}, {"start": 1816.18, "end": 1817.7, "text": "已不能辅佐主公了"}, {"start": 1818.82, "end": 1819.3, "text": "主公"}, {"start": 1820.74, "end": 1822.26, "text": "这一切都是天意"}, {"start": 1827.01, "end": 1827.97, "text": "容我去吧"}, {"start": 1867.66, "end": 1869.5, "text": "宋军千里终有一别"}, {"start": 1869.5, "end": 1870.38, "text": "主公请回答"}, {"start": 1870.38, "end": 1883.92, "text": "不知何年何月"}, {"start": 1883.92, "end": 1884.72, "text": "才能相见"}, {"start": 1885.68, "end": 1886.8, "text": "与主公相遇"}, {"start": 1888.08, "end": 1890.16, "text": "是我平生一大快事"}, {"start": 1890.8, "end": 1894.61, "text": "不幸中途而别"}, {"start": 1895.17, "end": 1904.86, "text": "请主公放心"}, {"start": 1906.14, "end": 1907.34, "text": "我到许长之后"}, {"start": 1908.22, "end": 1909.58, "text": "终生不为曹操"}, {"start": 1910.06, "end": 1911.66, "text": "你以谋 社以计"}, {"start": 1912.22, "end": 1915.31, "text": "只求侍奉母亲"}, {"start": 1916.43, "end": 1917.47, "text": "一尽天年"}, {"start": 1917.95, "end": 1925.57, "text": "拜别主公"}, {"start": 1925.89, "end": 1951.1, "text": "听令"}, {"start": 1951.74, "end": 1952.14, "text": "主公"}, {"start": 1952.14, "end": 1952.86, "text": "明天"}, {"start": 1953.9, "end": 1955.34, "text": "把前面那片树林"}, {"start": 1955.82, "end": 1957.02, "text": "全部伐尽"}, {"start": 1958.06, "end": 1958.78, "text": "主公"}, {"start": 1958.78, "end": 1959.58, "text": "为何要"}, {"start": 1960.22, "end": 1961.5, "text": "要砍掉那片树林"}, {"start": 1961.5, "end": 1963.58, "text": "它挡住了徐元之的身影"}, {"start": 1964.7, "end": 1965.1, "text": "遵命"}, {"start": 1965.1, "end": 1965.98, "text": "主公"}, {"start": 1983.58, "end": 1984.22, "text": "主公"}, {"start": 1984.7, "end": 1985.26, "text": "先生"}, {"start": 1986.14, "end": 1987.18, "text": "你不走了是吗"}, {"start": 1988.06, "end": 1989.1, "text": "是不是不走了"}, {"start": 1989.1, "end": 1989.74, "text": "不"}, {"start": 1989.74, "end": 1990.3, "text": "主公"}, {"start": 1991.34, "end": 1992.46, "text": "你我心乱如麻"}, {"start": 1992.94, "end": 1994.62, "text": "竟然忘了件天大的事情"}, {"start": 1996.3, "end": 1996.94, "text": "何事"}, {"start": 1997.9, "end": 1999.18, "text": "襄阳城外三十里"}, {"start": 2000.06, "end": 2001.34, "text": "有一片山野"}, {"start": 2001.34, "end": 2002.22, "text": "名叫龙珠"}, {"start": 2003.18, "end": 2004.7, "text": "诸这一位当代奇才"}, {"start": 2005.5, "end": 2006.78, "text": "主公如果得到它"}, {"start": 2008.3, "end": 2009.02, "text": "无异于"}, {"start": 2009.74, "end": 2010.78, "text": "周公得吕王"}, {"start": 2011.26, "end": 2012.46, "text": "汉王得张良啊"}, {"start": 2012.94, "end": 2016.26, "text": "此人才华"}, {"start": 2016.26, "end": 2017.06, "text": "比君如何"}, {"start": 2018.74, "end": 2019.54, "text": "那我比他"}, {"start": 2020.5, "end": 2021.14, "text": "那真是"}, {"start": 2022.34, "end": 2023.46, "text": "奴马比西林"}, {"start": 2024.1, "end": 2025.22, "text": "韩鸦比凤凰"}, {"start": 2026.18, "end": 2028.02, "text": "此人有惊天伟地之才"}, {"start": 2028.5, "end": 2030.1, "text": "堪称天下第一人"}, {"start": 2030.1, "end": 2030.66, "text": "当真"}, {"start": 2031.54, "end": 2032.5, "text": "千真万确"}, {"start": 2035.18, "end": 2037.02, "text": "此人姓诸葛"}, {"start": 2037.02, "end": 2037.66, "text": "自孔明"}, {"start": 2039.18, "end": 2040.62, "text": "因为住于卧龙岗上"}, {"start": 2041.18, "end": 2042.94, "text": "所以又好卧龙先生"}, {"start": 2044.06, "end": 2044.62, "text": "卧龙"}, {"start": 2046.14, "end": 2046.94, "text": "多年来"}, {"start": 2046.94, "end": 2048.14, "text": "他身边的师朋们"}, {"start": 2048.94, "end": 2050.22, "text": "纷纷各寻其主"}, {"start": 2050.94, "end": 2051.98, "text": "或是曹操"}, {"start": 2051.98, "end": 2053.02, "text": "或是袁绍"}, {"start": 2053.02, "end": 2053.98, "text": "或是公孙瓒"}, {"start": 2054.78, "end": 2056.62, "text": "以便成就功名大业"}, {"start": 2058.54, "end": 2061.02, "text": "唯有孔明独居山野"}, {"start": 2061.02, "end": 2061.9, "text": "七身操控"}, {"start": 2062.46, "end": 2063.5, "text": "危然不动啊"}, {"start": 2064.94, "end": 2065.66, "text": "他为何这样"}, {"start": 2067.5, "end": 2068.78, "text": "我也曾问过孔明"}, {"start": 2069.9, "end": 2070.94, "text": "你因何如此"}, {"start": 2072.22, "end": 2072.94, "text": "孔明笑到"}, {"start": 2073.82, "end": 2075.74, "text": "曹操 袁绍"}, {"start": 2075.74, "end": 2076.94, "text": "公孙瓒治疗"}, {"start": 2076.94, "end": 2078.06, "text": "不配做他的主公"}, {"start": 2079.34, "end": 2079.98, "text": "我再问他"}, {"start": 2080.7, "end": 2081.42, "text": "那么天下"}, {"start": 2082.06, "end": 2083.34, "text": "谁配做你的主公"}, {"start": 2084.54, "end": 2085.66, "text": "孔明叹道"}, {"start": 2087.7, "end": 2088.66, "text": "只怕没有啊"}, {"start": 2090.1, "end": 2092.1, "text": "与其寻找主公"}, {"start": 2092.66, "end": 2093.54, "text": "不如为自己"}, {"start": 2093.54, "end": 2094.5, "text": "创造一个主公"}, {"start": 2095.46, "end": 2096.58, "text": "与其寻找主公"}, {"start": 2098.67, "end": 2100.11, "text": "不如自己创造一个主公"}, {"start": 2100.11, "end": 2103.84, "text": "住得空前绝好"}, {"start": 2103.84, "end": 2104.56, "text": "千古悲闻"}, {"start": 2104.56, "end": 2107.62, "text": "这世间"}, {"start": 2108.26, "end": 2109.78, "text": "竟然真有此等大仙"}, {"start": 2110.9, "end": 2112.18, "text": "此前我不说此人"}, {"start": 2112.74, "end": 2113.78, "text": "就是因为我知道"}, {"start": 2114.5, "end": 2115.94, "text": "他胸怀云霄之志"}, {"start": 2118.19, "end": 2119.23, "text": "只怕不愿意"}, {"start": 2119.23, "end": 2120.11, "text": "偷笑主公"}, {"start": 2122.22, "end": 2122.94, "text": "多谢先生"}, {"start": 2123.9, "end": 2125.34, "text": "刘备就算肝脑涂地"}, {"start": 2125.9, "end": 2127.58, "text": "也一定会请得孔明出山"}, {"start": 2130.56, "end": 2131.04, "text": "难哪"}, {"start": 2133.17, "end": 2133.97, "text": "但愿主公"}, {"start": 2134.61, "end": 2135.49, "text": "有此幸运"}, {"start": 2175.71, "end": 2176.51, "text": "寻找主公"}, {"start": 2177.15, "end": 2179.07, "text": "不如为自己创造一个主公"}, {"start": 2179.07, "end": 2227.2, "text": "请问来者"}, {"start": 2227.2, "end": 2228.24, "text": "可是徐原侄吗"}, {"start": 2229.04, "end": 2229.84, "text": "不错"}, {"start": 2229.84, "end": 2231.28, "text": "在下正是徐述"}, {"start": 2231.28, "end": 2232.48, "text": "请问阁下是谁"}, {"start": 2232.48, "end": 2233.6, "text": "我就是被先生"}, {"start": 2233.6, "end": 2234.72, "text": "打败的上将军"}, {"start": 2235.6, "end": 2236.16, "text": "曹仁"}, {"start": 2236.88, "end": 2238.56, "text": "听在下此名者将"}, {"start": 2238.56, "end": 2240.32, "text": "主公罚我在此迎候先生"}, {"start": 2241.12, "end": 2241.84, "text": "我在这儿"}, {"start": 2241.84, "end": 2243.76, "text": "已经是站了三天三夜了"}, {"start": 2243.76, "end": 2245.04, "text": "你要是再不来"}, {"start": 2245.04, "end": 2246.16, "text": "我的腿"}, {"start": 2246.16, "end": 2247.2, "text": "可就要站断了"}, {"start": 2250.7, "end": 2251.26, "text": "曹将军"}, {"start": 2251.9, "end": 2253.74, "text": "请将军带我去见丞相吧"}, {"start": 2253.74, "end": 2254.22, "text": "请请请"}, {"start": 2259.79, "end": 2260.43, "text": "原侄"}, {"start": 2269.55, "end": 2270.83, "text": "戴罪之徒徐述"}, {"start": 2270.83, "end": 2271.63, "text": "拜见丞相"}, {"start": 2273.47, "end": 2274.19, "text": "原侄啊"}, {"start": 2274.91, "end": 2277.23, "text": "我对你真是朝思暮想"}, {"start": 2277.23, "end": 2278.11, "text": "敢问丞相"}, {"start": 2278.11, "end": 2278.75, "text": "姜母在哪里"}, {"start": 2279.47, "end": 2281.71, "text": "灵堂大人正在客馆歇息"}, {"start": 2282.75, "end": 2283.63, "text": "姜母没在牢里"}, {"start": 2284.19, "end": 2286.99, "text": "这是谁人给我草草草的谣言"}, {"start": 2287.87, "end": 2290.35, "text": "先生的母亲就如同我的母亲"}, {"start": 2290.35, "end": 2292.03, "text": "我怎么会把自个儿的母亲"}, {"start": 2292.03, "end": 2293.39, "text": "关进牢狱里呢"}, {"start": 2294.35, "end": 2294.99, "text": "放心吧"}, {"start": 2295.55, "end": 2297.47, "text": "唐老人家正在客馆里歇息"}, {"start": 2298.11, "end": 2299.23, "text": "你就放心吧"}, {"start": 2299.23, "end": 2300.27, "text": "容我见过母亲"}, {"start": 2300.27, "end": 2301.31, "text": "再来拜见丞相"}, {"start": 2301.31, "end": 2301.87, "text": "好"}, {"start": 2301.87, "end": 2302.59, "text": "好"}, {"start": 2302.59, "end": 2302.91, "text": "请"}, {"start": 2306.64, "end": 2307.6, "text": "快去快回"}, {"start": 2308.32, "end": 2308.96, "text": "我等你"}, {"start": 2313.25, "end": 2313.57, "text": "娘"}, {"start": 2314.13, "end": 2314.45, "text": "娘"}, {"start": 2316.05, "end": 2316.93, "text": "儿来了"}, {"start": 2316.93, "end": 2323.89, "text": "是你吗"}, {"start": 2324.93, "end": 2325.97, "text": "真的是你吗"}, {"start": 2326.69, "end": 2326.93, "text": "娘"}, {"start": 2327.81, "end": 2328.85, "text": "儿来迟了"}, {"start": 2328.85, "end": 2329.89, "text": "让母亲受罪了"}, {"start": 2331.73, "end": 2332.29, "text": "姝儿"}, {"start": 2333.01, "end": 2333.89, "text": "你来了就好"}, {"start": 2334.45, "end": 2336.13, "text": "你来了就好啊"}, {"start": 2337.33, "end": 2338.61, "text": "娘想你"}, {"start": 2339.57, "end": 2344.05, "text": "娘在梦里都惦记着你呀"}, {"start": 2352.88, "end": 2353.44, "text": "儿啊"}, {"start": 2354.8, "end": 2357.04, "text": "你不是在刘皇叔那儿效力吗"}, {"start": 2358.08, "end": 2359.28, "text": "为何来许昌"}, {"start": 2360.08, "end": 2360.48, "text": "娘"}, {"start": 2361.12, "end": 2362.16, "text": "儿接到一封信"}, {"start": 2362.64, "end": 2364.32, "text": "说母亲被草草抓入牢中"}, {"start": 2364.8, "end": 2365.68, "text": "要儿来许昌"}, {"start": 2366.24, "end": 2367.2, "text": "以身相赎"}, {"start": 2368.88, "end": 2371.68, "text": "为娘从来就不曾写过什么信"}, {"start": 2372.4, "end": 2373.52, "text": "这是奸计"}, {"start": 2373.84, "end": 2374.16, "text": "你"}, {"start": 2375.12, "end": 2377.6, "text": "你难道看不出来吗"}, {"start": 2377.6, "end": 2378.56, "text": "儿看出来了"}, {"start": 2379.04, "end": 2380.96, "text": "可是儿不能不来呀"}, {"start": 2380.96, "end": 2381.6, "text": "为什么"}, {"start": 2382.24, "end": 2383.28, "text": "儿身为人子"}, {"start": 2384.4, "end": 2385.28, "text": "母亲被囚"}, {"start": 2385.84, "end": 2387.44, "text": "儿岂能不来相救啊"}, {"start": 2389.7, "end": 2390.9, "text": "姝儿啊"}, {"start": 2391.38, "end": 2397.54, "text": "你从小饱读诗书"}, {"start": 2398.18, "end": 2399.7, "text": "你不会不知道"}, {"start": 2400.82, "end": 2405.14, "text": "这自古忠孝难两全哪"}, {"start": 2407.22, "end": 2409.7, "text": "刘皇叔乃仁义之君"}, {"start": 2410.66, "end": 2412.1, "text": "贤德之志"}, {"start": 2412.74, "end": 2414.42, "text": "名满天下呀"}, {"start": 2414.98, "end": 2416.82, "text": "他又是皇室宗亲"}, {"start": 2417.46, "end": 2419.06, "text": "你能够为他效命"}, {"start": 2419.86, "end": 2422.58, "text": "就是为大汉金钟啊"}, {"start": 2423.62, "end": 2425.46, "text": "那草草是什么人"}, {"start": 2428.99, "end": 2431.79, "text": "他是欺君罔上的奸贼"}, {"start": 2432.75, "end": 2434.27, "text": "徐述啊徐述"}, {"start": 2435.55, "end": 2437.63, "text": "为娘万万想不到"}, {"start": 2438.59, "end": 2441.71, "text": "你竟会弃名投案"}, {"start": 2442.91, "end": 2443.71, "text": "成了个"}, {"start": 2444.91, "end": 2449.7, "text": "余福蠢汉"}, {"start": 2449.7, "end": 2450.18, "text": "娘"}, {"start": 2467.47, "end": 2469.23, "text": "徐述虽生有死"}, {"start": 2470.43, "end": 2472.19, "text": "他终生不为草草"}, {"start": 2472.19, "end": 2474.11, "text": "献一策出义谋"}, {"start": 2474.91, "end": 2475.31, "text": "由此"}, {"start": 2476.11, "end": 2478.83, "text": "徐述进曹营一言不发"}, {"start": 2478.83, "end": 2480.83, "text": "成为千古名殿"}, {"start": 2480.83, "end": 2481.47, "text": "娘"}]