[{"start": 12.53, "end": 15.53, "text": "主公,刘备派人送来一份拜帖。"}, {"start": 16.53, "end": 18.53, "text": "我就知道他会给我来信。"}, {"start": 19.53, "end": 21.53, "text": "你猜猜那信上的我都说了些什么。"}, {"start": 23.53, "end": 25.53, "text": "这,我可猜不出来。"}, {"start": 26.53, "end": 27.53, "text": "连这都猜不出来。"}, {"start": 29.53, "end": 31.53, "text": "今后如何做到料敌于先?"}, {"start": 32.53, "end": 34.53, "text": "如何才能做军中主将呢?"}, {"start": 35.53, "end": 36.53, "text": "这。"}, {"start": 37.53, "end": 38.53, "text": "我替你猜一猜吧。"}, {"start": 39.53, "end": 44.11, "text": "刘备此信,"}, {"start": 44.11, "end": 48.11, "text": "开头嘛,肯定是奉承我一番。"}, {"start": 49.11, "end": 50.11, "text": "他会替陶谦赔罪。"}, {"start": 52.81, "end": 55.81, "text": "因为毕竟是他的部将,杀了家父。"}, {"start": 56.81, "end": 59.81, "text": "最后,他会劝我退军。"}, {"start": 60.81, "end": 64.82, "text": "你念吧。"}, {"start": 70.2, "end": 72.2, "text": "孟德兄如物,玄德百败。"}, {"start": 73.2, "end": 75.2, "text": "长安一会,在下铭心刻骨。"}, {"start": 76.2, "end": 79.2, "text": "兄台之文韬武略,如日照昆仑。"}, {"start": 79.2, "end": 82.2, "text": "兄台之心胸大志,如江海奔腾。"}, {"start": 83.2, "end": 84.2, "text": "在下不胜仰慕。"}, {"start": 85.2, "end": 88.2, "text": "徐州刺史陶谦,实乃宽厚仁德之君。"}, {"start": 89.2, "end": 92.2, "text": "其部下叛逆之罪,不能敬归于其主。"}, {"start": 93.2, "end": 97.2, "text": "如今,兄之先父已逝,如逝水不可復归。"}, {"start": 98.2, "end": 101.2, "text": "陶谦愧恨无地,愿倾其财物。"}, {"start": 102.2, "end": 104.2, "text": "赔偿兄台,以收赎其罪。"}, {"start": 105.2, "end": 107.2, "text": "刘备斗胆尽言,"}, {"start": 107.2, "end": 110.2, "text": "盼兄台撤军沿河,化干戈为玉帛。"}, {"start": 111.2, "end": 114.2, "text": "常能如此,不但徐州百姓敢兄台大恩,"}, {"start": 115.2, "end": 118.2, "text": "天下人也必称颂兄台之名义。"}, {"start": 119.2, "end": 122.2, "text": "否则,战端已开,玉石同焚。"}, {"start": 123.2, "end": 127.2, "text": "刘备不才,愿与陶史君生死与共。"}, {"start": 128.2, "end": 129.2, "text": "放肆。"}, {"start": 130.2, "end": 133.2, "text": "那刘备不过是一个知习犯律的匹夫,"}, {"start": 133.2, "end": 134.2, "text": "竟敢来通我作对。"}, {"start": 135.2, "end": 136.2, "text": "传令下去。"}, {"start": 137.2, "end": 138.2, "text": "破城之后,"}, {"start": 139.2, "end": 142.2, "text": "徐州城的男女老幼全部斩尽杀绝,"}, {"start": 143.2, "end": 145.2, "text": "以为家父在天之灵。"}, {"start": 146.2, "end": 147.2, "text": "主公,这……"}, {"start": 148.2, "end": 152.2, "text": "我们没有那么多的粮食供养几十万战俘。"}, {"start": 153.2, "end": 154.2, "text": "末将,明白了。"}, {"start": 155.2, "end": 157.64, "text": "拜报到了。"}, {"start": 157.64, "end": 158.64, "text": "远州出事了?"}, {"start": 158.64, "end": 167.16, "text": "正是。"}, {"start": 167.16, "end": 171.39, "text": "昨天夜里,"}, {"start": 171.39, "end": 173.39, "text": "雷部率兵一举偷袭了远州,"}, {"start": 174.39, "end": 175.39, "text": "攻破了城。"}, {"start": 176.39, "end": 179.39, "text": "城中我军残部正在浴血奋战中。"}, {"start": 180.39, "end": 181.39, "text": "一届匹夫?"}, {"start": 182.39, "end": 188.5, "text": "他哪里来的如此胆识劲敢偷袭我的远州?"}, {"start": 188.5, "end": 189.5, "text": "主公,"}, {"start": 189.5, "end": 191.5, "text": "陈公做了吕部的军师。"}, {"start": 192.5, "end": 193.5, "text": "这就不奇怪了。"}, {"start": 194.5, "end": 197.86, "text": "这就不奇怪了。"}, {"start": 198.86, "end": 203.62, "text": "原来是陈公台在指使他。"}, {"start": 203.62, "end": 204.62, "text": "主公,"}, {"start": 204.62, "end": 206.62, "text": "远州一旦失陷,"}, {"start": 206.62, "end": 209.62, "text": "那我数万大军可就无家可归了。"}, {"start": 210.62, "end": 211.62, "text": "传命,"}, {"start": 211.62, "end": 213.62, "text": "全军即刻回驶远州。"}, {"start": 214.62, "end": 215.62, "text": "那徐州怎么办?"}, {"start": 215.62, "end": 218.76, "text": "等我战霸吕部。"}, {"start": 221.36, "end": 222.36, "text": "回来再说吧。"}, {"start": 222.36, "end": 223.36, "text": "现在嘛,"}, {"start": 225.93, "end": 232.24, "text": "不妨"}, {"start": 233.24, "end": 237.96, "text": "做个顺水人情,"}, {"start": 237.96, "end": 239.96, "text": "卖刘备个面子。"}, {"start": 240.96, "end": 242.96, "text": "你替我做个顺水人情。"}, {"start": 242.96, "end": 244.96, "text": "就说我接受他的建议。"}, {"start": 245.96, "end": 246.96, "text": "撤军,"}, {"start": 246.96, "end": 247.96, "text": "言和。"}, {"start": 247.96, "end": 248.96, "text": "遵命。"}, {"start": 248.96, "end": 249.96, "text": "不敢当,"}, {"start": 249.96, "end": 250.96, "text": "不敢当,"}, {"start": 250.96, "end": 251.96, "text": "万万不敢当。"}, {"start": 252.96, "end": 256.34, "text": "全德一纸信文,"}, {"start": 256.34, "end": 262.11, "text": "撤退了曹军,"}, {"start": 262.11, "end": 263.11, "text": "无万铁骑。"}, {"start": 265.11, "end": 267.11, "text": "使徐州免于战祸,"}, {"start": 267.11, "end": 269.11, "text": "转危为干。"}, {"start": 270.11, "end": 272.11, "text": "此事足以证明"}, {"start": 272.11, "end": 274.11, "text": "陈公的军事。"}, {"start": 274.11, "end": 276.11, "text": "徐州五十万官民,"}, {"start": 277.11, "end": 280.11, "text": "深感玄德军再造之恩。"}, {"start": 280.11, "end": 282.11, "text": "拜见玄德公。"}, {"start": 283.11, "end": 284.11, "text": "玄德老弟啊,"}, {"start": 284.11, "end": 286.11, "text": "老夫年迈,"}, {"start": 286.11, "end": 287.11, "text": "全死无财。"}, {"start": 288.11, "end": 290.11, "text": "徐州六军,"}, {"start": 290.11, "end": 295.67, "text": "只有在刘十军的治愈之下,"}, {"start": 295.67, "end": 299.59, "text": "才能够成功。"}, {"start": 300.59, "end": 302.59, "text": "玄德老弟啊,"}, {"start": 302.59, "end": 304.59, "text": "老夫年迈,"}, {"start": 304.59, "end": 305.59, "text": "全死无财。"}, {"start": 306.59, "end": 307.59, "text": "徐州六军,"}, {"start": 307.59, "end": 309.59, "text": "只有在刘十军的治愈之下,"}, {"start": 309.59, "end": 311.59, "text": "才可能太平昌盛。"}, {"start": 312.59, "end": 314.59, "text": "我已经征求过徐州"}, {"start": 314.59, "end": 317.59, "text": "所有文武官员的心意。"}, {"start": 317.59, "end": 319.59, "text": "他们都愿意你"}, {"start": 319.59, "end": 321.59, "text": "提领徐州啊。"}, {"start": 322.59, "end": 324.59, "text": "请看在纵人分上,"}, {"start": 324.59, "end": 328.48, "text": "单此任罢。"}, {"start": 328.48, "end": 329.48, "text": "陶公,"}, {"start": 329.48, "end": 331.48, "text": "陶公深情厚意,"}, {"start": 331.48, "end": 333.48, "text": "刘备极为感化。"}, {"start": 333.48, "end": 335.48, "text": "但此尊官方,"}, {"start": 335.48, "end": 337.48, "text": "刘备绝不感受。"}, {"start": 337.48, "end": 338.48, "text": "我早就说过了,"}, {"start": 338.48, "end": 340.48, "text": "徐州是来救徐州,"}, {"start": 340.48, "end": 342.48, "text": "而不是图徐州的。"}, {"start": 342.48, "end": 343.48, "text": "现在,"}, {"start": 343.48, "end": 345.48, "text": "曹操大军已撤。"}, {"start": 345.48, "end": 346.48, "text": "待我引罢此差,"}, {"start": 346.48, "end": 347.48, "text": "也该履行诺言,"}, {"start": 347.48, "end": 349.48, "text": "重归平原县。"}, {"start": 349.48, "end": 350.48, "text": "请留步,"}, {"start": 350.48, "end": 351.48, "text": "留步,"}, {"start": 351.48, "end": 352.48, "text": "留步,"}, {"start": 352.48, "end": 353.48, "text": "留步,"}, {"start": 353.48, "end": 354.48, "text": "留步,"}, {"start": 354.48, "end": 355.48, "text": "留步,"}, {"start": 355.48, "end": 356.48, "text": "留步,"}, {"start": 356.48, "end": 357.48, "text": "留步,"}, {"start": 357.48, "end": 358.48, "text": "留步,"}, {"start": 358.48, "end": 359.48, "text": "留步,"}, {"start": 359.48, "end": 360.48, "text": "留步,"}, {"start": 360.48, "end": 361.48, "text": "留步,"}, {"start": 361.48, "end": 362.48, "text": "留步,"}, {"start": 362.48, "end": 363.48, "text": "留步,"}, {"start": 363.48, "end": 364.48, "text": "留步,"}, {"start": 364.48, "end": 365.48, "text": "留步,"}, {"start": 365.48, "end": 366.48, "text": "留步,"}, {"start": 366.48, "end": 368.48, "text": "您看在众人的份上,"}, {"start": 368.48, "end": 370.48, "text": "单此任罢。"}, {"start": 370.48, "end": 371.48, "text": "不成,"}, {"start": 371.48, "end": 372.48, "text": "陶公啊,"}, {"start": 372.48, "end": 375.48, "text": "你这是逼我现在就离开徐州啊。"}, {"start": 375.48, "end": 376.48, "text": "请留步,"}, {"start": 376.48, "end": 377.48, "text": "请留步,"}, {"start": 377.48, "end": 378.48, "text": "请留步,"}, {"start": 378.48, "end": 379.48, "text": "请留步,"}, {"start": 379.48, "end": 381.48, "text": "即使你不统领徐州,"}, {"start": 381.48, "end": 383.48, "text": "也不能弃徐州而去啊。"}, {"start": 383.48, "end": 385.48, "text": "否则曹操定然复返,"}, {"start": 385.48, "end": 389.48, "text": "徐州早晚要落到奸凶的难中啊。"}, {"start": 389.48, "end": 391.82, "text": "董,"}, {"start": 391.82, "end": 392.82, "text": "这样吧,"}, {"start": 392.82, "end": 394.82, "text": "我搏出一个编程小配,"}, {"start": 394.82, "end": 396.82, "text": "你可领军暂住,"}, {"start": 396.82, "end": 399.82, "text": "我们可以形成一个蹊跷之势,"}, {"start": 399.82, "end": 401.82, "text": "一旦有景,"}, {"start": 401.82, "end": 404.82, "text": "我们可以相互应援啊。"}, {"start": 404.82, "end": 407.82, "text": "至于你不所需良详,"}, {"start": 407.82, "end": 409.82, "text": "全部由我供给,"}, {"start": 409.82, "end": 411.82, "text": "你看如何呀?"}, {"start": 411.82, "end": 418.26, "text": "刘备,"}, {"start": 418.26, "end": 420.26, "text": "谨遵陶公所命。"}, {"start": 420.26, "end": 421.26, "text": "好,"}, {"start": 421.26, "end": 422.26, "text": "好,"}, {"start": 422.26, "end": 423.26, "text": "好,"}, {"start": 423.26, "end": 424.26, "text": "开宴,"}, {"start": 424.26, "end": 425.26, "text": "上酒。"}, {"start": 425.26, "end": 426.26, "text": "太好了,"}, {"start": 426.26, "end": 427.26, "text": "太好了,"}, {"start": 427.26, "end": 428.26, "text": "太好了,"}, {"start": 428.26, "end": 429.26, "text": "请请请。"}, {"start": 429.26, "end": 440.38, "text": "六公,"}, {"start": 440.38, "end": 441.38, "text": "快请。"}, {"start": 441.38, "end": 442.38, "text": "何呀?"}, {"start": 442.38, "end": 478.77, "text": "陶公,"}, {"start": 478.77, "end": 484.09, "text": "你的病,"}, {"start": 484.09, "end": 487.85, "text": "不算是祸事,"}, {"start": 487.85, "end": 489.85, "text": "待来年开春,"}, {"start": 489.85, "end": 491.85, "text": "定可康复,"}, {"start": 491.85, "end": 493.85, "text": "你只需安心静养。"}, {"start": 493.85, "end": 501.37, "text": "我不是说我的病,"}, {"start": 501.37, "end": 503.37, "text": "我是说,"}, {"start": 503.37, "end": 508.37, "text": "徐州要大难临头了,"}, {"start": 508.37, "end": 512.48, "text": "刚刚接报,"}, {"start": 512.48, "end": 515.48, "text": "曹操就半日,"}, {"start": 515.48, "end": 517.48, "text": "大败吕布,"}, {"start": 517.48, "end": 519.48, "text": "这就意味着,"}, {"start": 519.48, "end": 522.48, "text": "他可以腾出手来,"}, {"start": 522.48, "end": 527.48, "text": "马上在大徐州了。"}, {"start": 527.48, "end": 530.48, "text": "玄德呀,"}, {"start": 530.48, "end": 533.48, "text": "鸟子将死,"}, {"start": 533.48, "end": 536.48, "text": "其鸣也哀,"}, {"start": 536.48, "end": 539.48, "text": "人之将死,"}, {"start": 539.48, "end": 542.48, "text": "其言也善哪。"}, {"start": 542.48, "end": 543.48, "text": "老夫,"}, {"start": 543.48, "end": 547.48, "text": "我有几句话,"}, {"start": 547.48, "end": 550.48, "text": "想跟你说,"}, {"start": 550.48, "end": 553.48, "text": "但我希望,"}, {"start": 553.48, "end": 556.48, "text": "在这个时候,"}, {"start": 556.48, "end": 559.48, "text": "你我之间,"}, {"start": 559.48, "end": 561.48, "text": "不要再有什么"}, {"start": 561.48, "end": 564.48, "text": "虚言客套,"}, {"start": 564.48, "end": 565.48, "text": "行吗?"}, {"start": 565.48, "end": 573.15, "text": "我知道,"}, {"start": 573.15, "end": 575.15, "text": "你们六官的"}, {"start": 575.15, "end": 577.15, "text": "三兄弟,"}, {"start": 577.15, "end": 580.62, "text": "必须"}, {"start": 580.62, "end": 583.62, "text": "以防蜀地,"}, {"start": 583.62, "end": 586.62, "text": "作为立身之本。"}, {"start": 586.62, "end": 591.26, "text": "我还知道,"}, {"start": 591.26, "end": 593.26, "text": "你刘备,"}, {"start": 593.26, "end": 598.26, "text": "不是不想得到徐州,"}, {"start": 598.26, "end": 601.26, "text": "恰恰相反,"}, {"start": 601.26, "end": 603.26, "text": "你想,"}, {"start": 603.26, "end": 607.26, "text": "你比任何人都想得到,"}, {"start": 607.26, "end": 610.26, "text": "是不是?"}, {"start": 610.26, "end": 612.26, "text": "只不过,"}, {"start": 612.26, "end": 615.26, "text": "你与性命,"}, {"start": 615.26, "end": 622.74, "text": "不想趁我之危罢了。"}, {"start": 622.74, "end": 624.74, "text": "吕涛公明鉴,"}, {"start": 624.74, "end": 629.1, "text": "请收下吧,"}, {"start": 629.1, "end": 633.89, "text": "徐州,"}, {"start": 633.89, "end": 636.89, "text": "只有托付于你,"}, {"start": 636.89, "end": 637.89, "text": "无他人,"}, {"start": 637.89, "end": 642.68, "text": "我给听的奏章,"}, {"start": 642.68, "end": 649.33, "text": "已经写在我的遗珠里了。"}, {"start": 649.33, "end": 652.47, "text": "套公,"}, {"start": 652.47, "end": 654.47, "text": "天下英雄众多,"}, {"start": 654.47, "end": 657.78, "text": "无论如何,"}, {"start": 657.78, "end": 662.36, "text": "也轮不到我刘备"}, {"start": 662.36, "end": 664.36, "text": "做徐州牧啊。"}, {"start": 664.36, "end": 667.36, "text": "那还有谁?"}, {"start": 667.36, "end": 668.36, "text": "袁绍四十三宫,"}, {"start": 668.36, "end": 670.36, "text": "威名满天下。"}, {"start": 670.36, "end": 671.36, "text": "不。"}, {"start": 671.36, "end": 673.36, "text": "袁蜀胸怀大志,"}, {"start": 673.36, "end": 674.36, "text": "一直想进取中原。"}, {"start": 674.36, "end": 675.36, "text": "不。"}, {"start": 675.36, "end": 676.36, "text": "还有,"}, {"start": 676.36, "end": 677.36, "text": "还有荆州刘表,"}, {"start": 677.36, "end": 678.36, "text": "刘表也是,"}, {"start": 678.36, "end": 679.36, "text": "皇监国纪。"}, {"start": 679.36, "end": 680.36, "text": "不,"}, {"start": 680.36, "end": 681.36, "text": "不,"}, {"start": 681.36, "end": 682.36, "text": "不,"}, {"start": 682.36, "end": 683.36, "text": "徐州,"}, {"start": 683.36, "end": 684.36, "text": "非你,"}, {"start": 684.36, "end": 686.36, "text": "不可。"}, {"start": 686.36, "end": 687.36, "text": "刘备,"}, {"start": 687.36, "end": 698.97, "text": "谨遵陶公所命,"}, {"start": 698.97, "end": 700.97, "text": "暂领徐州,"}, {"start": 700.97, "end": 703.97, "text": "待朝廷旨意到达,"}, {"start": 703.97, "end": 705.97, "text": "再遵旨办理。"}, {"start": 705.97, "end": 707.97, "text": "何处鸣钟?"}, {"start": 707.97, "end": 773.14, "text": "声音像是西门顶钟,"}, {"start": 773.14, "end": 776.14, "text": "城守正在鸣钟报警。"}, {"start": 776.14, "end": 778.14, "text": "曹军来得好快啊。"}, {"start": 778.14, "end": 779.14, "text": "报!"}, {"start": 779.14, "end": 780.14, "text": "禀太太!"}, {"start": 780.14, "end": 781.14, "text": "吕布率数千铁骑,"}, {"start": 781.14, "end": 783.14, "text": "正在西门叩关。"}, {"start": 783.14, "end": 788.31, "text": "是吕布?"}, {"start": 788.31, "end": 789.31, "text": "刘将军,"}, {"start": 789.31, "end": 792.31, "text": "你看吕布想攻我徐州城了。"}, {"start": 792.31, "end": 810.05, "text": "关旗阵势,"}, {"start": 810.05, "end": 811.05, "text": "不像是攻城。"}, {"start": 811.05, "end": 812.05, "text": "将军,"}, {"start": 812.05, "end": 813.05, "text": "吕布拜关!"}, {"start": 813.05, "end": 815.05, "text": "捉人取来!"}, {"start": 815.05, "end": 830.04, "text": "公太先生,"}, {"start": 830.04, "end": 833.38, "text": "如果刘备不让我们进城,"}, {"start": 833.38, "end": 851.83, "text": "那我们该怎么办?"}, {"start": 851.83, "end": 852.83, "text": "将军放心吧,"}, {"start": 852.83, "end": 855.83, "text": "刘备是个仁义之君。"}, {"start": 855.83, "end": 858.62, "text": "刘备,"}, {"start": 858.62, "end": 861.62, "text": "现在他最大的敌人是曹操。"}, {"start": 861.62, "end": 863.62, "text": "要抵抗曹操大军,"}, {"start": 863.62, "end": 865.62, "text": "尤其需要我们的帮助。"}, {"start": 865.62, "end": 866.62, "text": "好,"}, {"start": 866.62, "end": 869.62, "text": "那如果刘备收留了我们,"}, {"start": 869.62, "end": 873.7, "text": "我们该怎么办呢?"}, {"start": 873.7, "end": 877.01, "text": "那就更好办了。"}, {"start": 877.01, "end": 878.01, "text": "官时待变,"}, {"start": 878.01, "end": 880.01, "text": "乡机行事。"}, {"start": 880.01, "end": 882.45, "text": "好啊,"}, {"start": 882.45, "end": 884.45, "text": "吕布被曹操击败后,"}, {"start": 884.45, "end": 901.87, "text": "无处容身,"}, {"start": 901.87, "end": 904.87, "text": "现在想来投靠我了。"}, {"start": 904.87, "end": 905.87, "text": "这司,"}, {"start": 905.87, "end": 907.87, "text": "还有脸来投靠咱们。"}, {"start": 907.87, "end": 909.87, "text": "像当初咱哥儿仨揍他的时候,"}, {"start": 909.87, "end": 910.87, "text": "没砍下他的脑袋,"}, {"start": 910.87, "end": 912.87, "text": "就算他命大了。"}, {"start": 912.87, "end": 914.87, "text": "此一时比一时嘛,"}, {"start": 914.87, "end": 915.87, "text": "别忘了,"}, {"start": 915.87, "end": 917.87, "text": "后来吕布改邪归正了,"}, {"start": 917.87, "end": 919.87, "text": "亲手斩杀了国贼董卓,"}, {"start": 919.87, "end": 921.87, "text": "被汉庭立下了大功。"}, {"start": 921.87, "end": 923.87, "text": "不愧是当时英雄,"}, {"start": 923.87, "end": 924.87, "text": "此一劫"}, {"start": 924.87, "end": 926.87, "text": "也得到了天下人的赞赏。"}, {"start": 926.87, "end": 927.87, "text": "再说,"}, {"start": 927.87, "end": 929.87, "text": "吕布是个猛将,"}, {"start": 929.87, "end": 931.87, "text": "部下八千铁骑,"}, {"start": 931.87, "end": 933.87, "text": "如果能得到他的帮助,"}, {"start": 933.87, "end": 936.87, "text": "我们就不怕曹操来犯了。"}, {"start": 936.87, "end": 938.87, "text": "大哥,"}, {"start": 938.87, "end": 939.87, "text": "吕布虽勇,"}, {"start": 939.87, "end": 941.87, "text": "却素无信义,"}, {"start": 941.87, "end": 942.87, "text": "把他留在身边"}, {"start": 942.87, "end": 944.87, "text": "等于养虎为患,"}, {"start": 944.87, "end": 946.87, "text": "当心被他咬伤了。"}, {"start": 946.87, "end": 947.87, "text": "就是,"}, {"start": 947.87, "end": 949.87, "text": "二哥说得是,"}, {"start": 949.87, "end": 950.87, "text": "吕布这司"}, {"start": 950.87, "end": 951.87, "text": "倒是有一处好,"}, {"start": 951.87, "end": 952.87, "text": "人长得漂亮,"}, {"start": 952.87, "end": 953.87, "text": "讨女人喜欢,"}, {"start": 953.87, "end": 956.87, "text": "其他的一无是处。"}, {"start": 956.87, "end": 957.87, "text": "吕布,"}, {"start": 958.87, "end": 959.87, "text": "哥,"}, {"start": 959.87, "end": 960.87, "text": "你想想看,"}, {"start": 960.87, "end": 962.87, "text": "吕布一共有多少个爹?"}, {"start": 962.87, "end": 963.87, "text": "丁远一个,"}, {"start": 963.87, "end": 964.87, "text": "董卓一个,"}, {"start": 964.87, "end": 965.87, "text": "王远一个,"}, {"start": 965.87, "end": 967.87, "text": "再加上他自个儿的亲爹一个,"}, {"start": 967.87, "end": 968.87, "text": "这前前后后"}, {"start": 968.87, "end": 970.87, "text": "共有四个爹。"}, {"start": 970.87, "end": 971.87, "text": "这四个爹"}, {"start": 971.87, "end": 972.87, "text": "都因吕布而死,"}, {"start": 972.87, "end": 973.87, "text": "可见"}, {"start": 973.87, "end": 975.87, "text": "他是个大灾星啊,"}, {"start": 975.87, "end": 977.87, "text": "谁要是做了他的爹,"}, {"start": 977.87, "end": 979.87, "text": "可准不得好死啊。"}, {"start": 979.87, "end": 980.87, "text": "吕布,"}, {"start": 980.87, "end": 982.87, "text": "吕布,"}, {"start": 982.87, "end": 983.87, "text": "吕布,"}, {"start": 983.87, "end": 984.87, "text": "吕布,"}, {"start": 984.87, "end": 985.87, "text": "吕布,"}, {"start": 985.87, "end": 986.87, "text": "吕布,"}, {"start": 987.87, "end": 988.87, "text": "我只想做他的友,"}, {"start": 988.87, "end": 990.87, "text": "没想做他的爹。"}, {"start": 990.87, "end": 991.87, "text": "可这回"}, {"start": 991.87, "end": 992.87, "text": "吕布不甘心"}, {"start": 992.87, "end": 993.87, "text": "做人家儿子,"}, {"start": 993.87, "end": 995.87, "text": "他想做人家的爹啊,"}, {"start": 995.87, "end": 998.87, "text": "他这回来投靠咱们这儿,"}, {"start": 998.87, "end": 999.87, "text": "我看"}, {"start": 999.87, "end": 1001.87, "text": "就是来图谋徐州来了,"}, {"start": 1001.87, "end": 1002.87, "text": "肯定吗?"}, {"start": 1002.87, "end": 1027.05, "text": "先生,"}, {"start": 1027.05, "end": 1029.05, "text": "我们走吧,"}, {"start": 1029.05, "end": 1031.05, "text": "看来刘备是不会接到我们的,"}, {"start": 1033.05, "end": 1034.05, "text": "再等一等,"}, {"start": 1034.05, "end": 1038.71, "text": "我们都已经等了两个时辰了,"}, {"start": 1038.71, "end": 1040.71, "text": "当初我见董卓,"}, {"start": 1040.71, "end": 1042.71, "text": "都不需要等这么久,"}, {"start": 1042.71, "end": 1044.71, "text": "现在不是当初,"}, {"start": 1044.71, "end": 1048.22, "text": "刘备更不是董卓,"}, {"start": 1048.22, "end": 1050.22, "text": "咱们平心静气地想一想,"}, {"start": 1050.22, "end": 1052.22, "text": "前段日子,"}, {"start": 1052.22, "end": 1053.22, "text": "如果没有吕布"}, {"start": 1053.22, "end": 1056.22, "text": "偷袭曹操的根据地衍州,"}, {"start": 1056.22, "end": 1058.22, "text": "曹操岂能退兵,"}, {"start": 1058.22, "end": 1061.22, "text": "徐州岂有今日之平安,"}, {"start": 1061.22, "end": 1062.22, "text": "现在,"}, {"start": 1062.22, "end": 1065.22, "text": "吕布仕穷来投我,"}, {"start": 1065.22, "end": 1066.22, "text": "如果聚而不纳,"}, {"start": 1066.22, "end": 1068.22, "text": "成何道理,"}, {"start": 1068.22, "end": 1069.22, "text": "再说,"}, {"start": 1069.22, "end": 1070.22, "text": "我等,"}, {"start": 1070.22, "end": 1072.22, "text": "如想匡扶汉室,"}, {"start": 1072.22, "end": 1073.22, "text": "成就大业,"}, {"start": 1073.22, "end": 1075.22, "text": "就必须结交各路英雄,"}, {"start": 1075.22, "end": 1076.22, "text": "眼下,"}, {"start": 1076.22, "end": 1078.22, "text": "我们的大敌是曹操,"}, {"start": 1078.22, "end": 1080.22, "text": "吕布的大敌也是曹操,"}, {"start": 1080.22, "end": 1082.22, "text": "我们两家,"}, {"start": 1082.22, "end": 1084.22, "text": "只有和军聚曹,"}, {"start": 1084.22, "end": 1086.22, "text": "方能胜算在握,"}, {"start": 1086.22, "end": 1088.22, "text": "曹操不是有句名言吗,"}, {"start": 1088.22, "end": 1094.42, "text": "叫宁肯我负天下人,"}, {"start": 1094.42, "end": 1096.42, "text": "休叫天下人负我,"}, {"start": 1096.42, "end": 1100.27, "text": "我也有句名言,"}, {"start": 1100.27, "end": 1105.63, "text": "宁肯天下人负我,"}, {"start": 1105.63, "end": 1107.63, "text": "我不负天下人,"}, {"start": 1107.63, "end": 1110.78, "text": "诸公明鉴,"}, {"start": 1110.78, "end": 1116.39, "text": "开城相迎,"}, {"start": 1116.39, "end": 1117.39, "text": "诺,"}, {"start": 1117.39, "end": 1119.39, "text": "格格要见死来见,"}, {"start": 1119.39, "end": 1120.39, "text": "我不见就死,"}, {"start": 1120.39, "end": 1136.7, "text": "先生你看,"}, {"start": 1136.7, "end": 1138.7, "text": "刘备他亲自出城相迎,"}, {"start": 1138.7, "end": 1140.7, "text": "记住,"}, {"start": 1140.7, "end": 1141.7, "text": "见面的时候,"}, {"start": 1141.7, "end": 1144.7, "text": "对刘备一定要十分恭敬,"}, {"start": 1144.7, "end": 1145.7, "text": "知道了,"}, {"start": 1149.97, "end": 1156.54, "text": "拜军之将吕布,"}, {"start": 1156.54, "end": 1159.54, "text": "拜见徐州刺史刘玄德,"}, {"start": 1159.54, "end": 1161.54, "text": "刘备俏望已久,"}, {"start": 1161.54, "end": 1164.54, "text": "终于把奉献和攻台盼望来了,"}, {"start": 1164.54, "end": 1167.54, "text": "今日之会令人无限欢喜,"}, {"start": 1167.54, "end": 1169.54, "text": "快随我进城,"}, {"start": 1169.54, "end": 1172.78, "text": "来,请,"}, {"start": 1172.78, "end": 1178.71, "text": "刘备,"}, {"start": 1178.71, "end": 1180.71, "text": "你可知道,"}, {"start": 1180.71, "end": 1183.71, "text": "天底下哪家骑兵是最厉害的,"}, {"start": 1183.71, "end": 1184.71, "text": "不知道,"}, {"start": 1184.71, "end": 1186.71, "text": "请将军赐教,"}, {"start": 1186.71, "end": 1189.71, "text": "是我吕布统帅的八千铁骑呀,"}, {"start": 1189.71, "end": 1191.71, "text": "那你可知道,"}, {"start": 1191.71, "end": 1194.71, "text": "那八千铁骑当中,"}, {"start": 1194.71, "end": 1196.71, "text": "最勇猛善战的是谁吗,"}, {"start": 1196.71, "end": 1197.71, "text": "这个我知道,"}, {"start": 1197.71, "end": 1199.71, "text": "是吕布,"}, {"start": 1201.71, "end": 1202.71, "text": "正是,"}, {"start": 1202.71, "end": 1203.71, "text": "正是,"}, {"start": 1203.71, "end": 1205.71, "text": "我有赤兔马,"}, {"start": 1205.71, "end": 1207.71, "text": "可日行千里,"}, {"start": 1207.71, "end": 1208.71, "text": "有方天化际,"}, {"start": 1208.71, "end": 1210.71, "text": "能破金断石,"}, {"start": 1210.71, "end": 1212.71, "text": "你可知道,"}, {"start": 1212.71, "end": 1215.71, "text": "世人是怎么称赞我的吗,"}, {"start": 1215.71, "end": 1216.71, "text": "人中吕布,"}, {"start": 1216.71, "end": 1218.71, "text": "马中赤兔,"}, {"start": 1218.71, "end": 1220.71, "text": "正是,"}, {"start": 1220.71, "end": 1221.71, "text": "正是,"}, {"start": 1221.71, "end": 1222.71, "text": "来,"}, {"start": 1222.71, "end": 1223.71, "text": "奉献,"}, {"start": 1223.71, "end": 1224.71, "text": "奉献,"}, {"start": 1224.71, "end": 1225.71, "text": "你喝醉了,"}, {"start": 1225.71, "end": 1226.71, "text": "我们还是早点歇息吧,"}, {"start": 1226.71, "end": 1228.71, "text": "不醉不醉,"}, {"start": 1228.71, "end": 1229.71, "text": "酒风知己,"}, {"start": 1229.71, "end": 1230.71, "text": "千杯少,"}, {"start": 1230.71, "end": 1231.71, "text": "来,"}, {"start": 1231.71, "end": 1232.71, "text": "斟酒,"}, {"start": 1232.71, "end": 1233.71, "text": "斟酒,"}, {"start": 1233.71, "end": 1234.71, "text": "刘备,"}, {"start": 1234.71, "end": 1237.71, "text": "只要你我联手,"}, {"start": 1237.71, "end": 1238.71, "text": "自然是,"}, {"start": 1238.71, "end": 1240.71, "text": "大业有成,"}, {"start": 1240.71, "end": 1241.71, "text": "你呢,"}, {"start": 1241.71, "end": 1243.71, "text": "只要坐守成官,"}, {"start": 1243.71, "end": 1245.71, "text": "每日,"}, {"start": 1245.71, "end": 1246.71, "text": "喝酒,"}, {"start": 1246.71, "end": 1247.71, "text": "吃茶,"}, {"start": 1247.71, "end": 1249.71, "text": "听歌赏月就够了,"}, {"start": 1249.71, "end": 1251.71, "text": "剩下的事情呢,"}, {"start": 1251.71, "end": 1252.71, "text": "交给我,"}, {"start": 1252.71, "end": 1253.71, "text": "我呢,"}, {"start": 1253.71, "end": 1255.71, "text": "率领八千铁骑,"}, {"start": 1255.71, "end": 1256.71, "text": "征战四方,"}, {"start": 1256.71, "end": 1258.71, "text": "为你打天下,"}, {"start": 1258.71, "end": 1260.71, "text": "等天下打下来,"}, {"start": 1260.71, "end": 1262.71, "text": "你我一人一半,"}, {"start": 1262.71, "end": 1264.71, "text": "你看可好?"}, {"start": 1265.71, "end": 1267.71, "text": "奉献将军,"}, {"start": 1267.71, "end": 1269.71, "text": "你既然如此英雄,"}, {"start": 1269.71, "end": 1271.71, "text": "为何在眼州城下,"}, {"start": 1271.71, "end": 1273.71, "text": "败于曹操呢?"}, {"start": 1273.71, "end": 1275.71, "text": "不是我败于曹操,"}, {"start": 1275.71, "end": 1277.71, "text": "是曹操败于我!"}, {"start": 1277.71, "end": 1278.71, "text": "行了,"}, {"start": 1278.71, "end": 1280.71, "text": "不提了不提了,"}, {"start": 1280.71, "end": 1281.71, "text": "你知道,"}, {"start": 1281.71, "end": 1283.71, "text": "星洋大战中,"}, {"start": 1283.71, "end": 1286.71, "text": "我是怎么痛击曹操的吗?"}, {"start": 1286.71, "end": 1288.71, "text": "不知道,"}, {"start": 1288.71, "end": 1290.71, "text": "请将军赐教,"}, {"start": 1291.71, "end": 1292.71, "text": "奉献哪,"}, {"start": 1292.71, "end": 1293.71, "text": "来来来,"}, {"start": 1293.71, "end": 1295.71, "text": "咱们多敬敬神德兄,"}, {"start": 1295.71, "end": 1296.71, "text": "哪一日,"}, {"start": 1296.71, "end": 1301.18, "text": "天昏地暗,"}, {"start": 1301.18, "end": 1304.46, "text": "日月无光,"}, {"start": 1304.46, "end": 1306.46, "text": "我单骑冲入敌阵当中,"}, {"start": 1306.46, "end": 1308.46, "text": "看见一个穿红袍的家伙,"}, {"start": 1308.46, "end": 1310.46, "text": "正在逃命,"}, {"start": 1310.46, "end": 1312.46, "text": "我直击朝他头盔上,"}, {"start": 1312.46, "end": 1314.46, "text": "我直击朝他头盔上一击,"}, {"start": 1314.46, "end": 1315.46, "text": "大鹤,"}, {"start": 1315.46, "end": 1320.34, "text": "曹操何在?"}, {"start": 1320.34, "end": 1322.34, "text": "他回答我说,"}, {"start": 1323.34, "end": 1325.34, "text": "前面骑黄马的便是,"}, {"start": 1326.34, "end": 1328.34, "text": "我赶紧追上骑黄马的家伙,"}, {"start": 1328.34, "end": 1330.34, "text": "一击把他刺翻,"}, {"start": 1330.34, "end": 1334.98, "text": "你看,"}, {"start": 1334.98, "end": 1338.78, "text": "这是一个小小的小鬼,"}, {"start": 1339.78, "end": 1341.78, "text": "后来我才知道,"}, {"start": 1341.78, "end": 1343.78, "text": "刚才在我几下的家伙,"}, {"start": 1343.78, "end": 1347.18, "text": "竟然就是该死的曹操,"}, {"start": 1349.18, "end": 1350.18, "text": "我一时大意,"}, {"start": 1350.18, "end": 1353.56, "text": "竟然让他在我几下逃生了,"}, {"start": 1355.56, "end": 1356.56, "text": "你说,"}, {"start": 1356.56, "end": 1358.81, "text": "曹贼,"}, {"start": 1359.81, "end": 1360.81, "text": "他奸是不奸,"}, {"start": 1360.81, "end": 1361.81, "text": "奸,"}, {"start": 1362.81, "end": 1363.81, "text": "竟然,"}, {"start": 1364.81, "end": 1366.81, "text": "都把奉先将军给蒙骗了,"}, {"start": 1367.81, "end": 1368.81, "text": "他们虽奸,"}, {"start": 1369.81, "end": 1370.81, "text": "却有雄才大略,"}, {"start": 1371.81, "end": 1372.81, "text": "人言,"}, {"start": 1372.81, "end": 1373.81, "text": "治世之能臣,"}, {"start": 1374.81, "end": 1375.81, "text": "乱世之奸雄,"}, {"start": 1376.81, "end": 1377.81, "text": "奸贼与奸雄,"}, {"start": 1377.81, "end": 1378.81, "text": "虽只差一字,"}, {"start": 1379.81, "end": 1381.81, "text": "却有天地玄书啊,"}, {"start": 1381.81, "end": 1383.81, "text": "只要有我吕布在,"}, {"start": 1384.81, "end": 1387.81, "text": "不管他是奸贼还是奸雄,"}, {"start": 1388.81, "end": 1390.81, "text": "都是待死鼠辈,"}, {"start": 1390.81, "end": 1394.11, "text": "柳辈,"}, {"start": 1394.11, "end": 1396.11, "text": "咱俩约定,"}, {"start": 1396.11, "end": 1397.11, "text": "我打天下,"}, {"start": 1398.11, "end": 1399.11, "text": "你,"}, {"start": 1399.11, "end": 1401.11, "text": "坐数徐州,"}, {"start": 1403.11, "end": 1406.11, "text": "你只需按月供我两想即可,"}, {"start": 1407.11, "end": 1410.06, "text": "好,"}, {"start": 1411.06, "end": 1413.06, "text": "我这个徐州刺史,"}, {"start": 1414.06, "end": 1415.06, "text": "只是暂时带领而已,"}, {"start": 1416.06, "end": 1418.06, "text": "天子并没有下旨,"}, {"start": 1418.06, "end": 1420.06, "text": "各镇诸侯也未必心服,"}, {"start": 1420.06, "end": 1422.06, "text": "奉先兄兵强马壮,"}, {"start": 1422.06, "end": 1423.06, "text": "英勇盖世,"}, {"start": 1424.06, "end": 1427.06, "text": "又加上天子钦封奋威将军,"}, {"start": 1428.06, "end": 1429.06, "text": "授忠义侯,"}, {"start": 1429.06, "end": 1430.06, "text": "一统三司,"}, {"start": 1431.06, "end": 1432.06, "text": "我刘辈,"}, {"start": 1432.06, "end": 1433.06, "text": "却什么封号都没有,"}, {"start": 1433.06, "end": 1436.06, "text": "实在是不配体领着徐州啊,"}, {"start": 1437.06, "end": 1438.06, "text": "难道,"}, {"start": 1439.06, "end": 1440.06, "text": "你不想要徐州啊?"}, {"start": 1450.76, "end": 1451.76, "text": "请奉先将军,"}, {"start": 1451.76, "end": 1452.76, "text": "收下此印,"}, {"start": 1452.76, "end": 1454.76, "text": "领徐州刺史,"}, {"start": 1455.76, "end": 1456.76, "text": "奉先,"}, {"start": 1456.76, "end": 1457.76, "text": "奉先,"}, {"start": 1457.76, "end": 1460.3, "text": "刘将军,"}, {"start": 1460.3, "end": 1462.3, "text": "我们兵败相投,"}, {"start": 1462.3, "end": 1464.3, "text": "能得刘将军荣流,"}, {"start": 1464.3, "end": 1465.3, "text": "已经是感激不尽,"}, {"start": 1465.3, "end": 1467.3, "text": "岂能有非分之想,"}, {"start": 1467.3, "end": 1470.3, "text": "请将军万万不要生疑啊,"}, {"start": 1470.3, "end": 1474.53, "text": "是,"}, {"start": 1475.53, "end": 1476.53, "text": "强兵不压主,"}, {"start": 1477.53, "end": 1478.53, "text": "在下,"}, {"start": 1478.53, "end": 1480.53, "text": "只想为玄德效劳,"}, {"start": 1480.53, "end": 1481.53, "text": "共聚操操,"}, {"start": 1482.53, "end": 1483.53, "text": "保徐州太平,"}, {"start": 1483.53, "end": 1484.53, "text": "奉先,"}, {"start": 1484.53, "end": 1485.53, "text": "公台,"}, {"start": 1485.53, "end": 1486.53, "text": "你们二位,"}, {"start": 1487.53, "end": 1489.53, "text": "以为我在做态势吧,"}, {"start": 1490.53, "end": 1491.53, "text": "非夜,"}, {"start": 1492.53, "end": 1494.53, "text": "我是真心愿让徐州,"}, {"start": 1495.53, "end": 1496.53, "text": "因为,"}, {"start": 1496.53, "end": 1498.53, "text": "一者吕布名震天下,"}, {"start": 1498.53, "end": 1499.53, "text": "兵强马壮,"}, {"start": 1499.53, "end": 1500.53, "text": "二者,"}, {"start": 1500.53, "end": 1501.53, "text": "得公台兄相助,"}, {"start": 1501.53, "end": 1503.53, "text": "和仇大业不成,"}, {"start": 1503.53, "end": 1504.53, "text": "三者,"}, {"start": 1504.53, "end": 1506.53, "text": "曹操不怕我刘备,"}, {"start": 1506.53, "end": 1507.53, "text": "却惧怕吕布,"}, {"start": 1508.53, "end": 1509.53, "text": "所以,"}, {"start": 1509.53, "end": 1511.53, "text": "只有将徐州交由你们,"}, {"start": 1511.53, "end": 1513.53, "text": "才可得保太平,"}, {"start": 1514.53, "end": 1515.53, "text": "玄德兄,"}, {"start": 1515.53, "end": 1516.53, "text": "你如此说来,"}, {"start": 1516.53, "end": 1518.53, "text": "真是在撵我们走啊,"}, {"start": 1518.53, "end": 1519.53, "text": "绝非此意,"}, {"start": 1519.53, "end": 1520.53, "text": "绝非此意,"}, {"start": 1521.53, "end": 1522.53, "text": "奉先哪,"}, {"start": 1523.53, "end": 1525.53, "text": "我们还是快快离开徐州,"}, {"start": 1525.53, "end": 1526.53, "text": "别逃他处吧,"}, {"start": 1527.53, "end": 1528.53, "text": "以免,"}, {"start": 1528.53, "end": 1529.53, "text": "玄德兄生疑啊,"}, {"start": 1530.53, "end": 1531.53, "text": "且慢,"}, {"start": 1531.53, "end": 1532.53, "text": "这样,"}, {"start": 1532.53, "end": 1534.53, "text": "二位暂且歇下,"}, {"start": 1534.53, "end": 1535.53, "text": "此事我们从长计议,"}, {"start": 1535.53, "end": 1536.53, "text": "可好?"}, {"start": 1539.26, "end": 1540.26, "text": "多谢,"}, {"start": 1540.26, "end": 1554.98, "text": "奉先哪,"}, {"start": 1555.98, "end": 1556.98, "text": "奉先哪,"}, {"start": 1556.98, "end": 1557.98, "text": "你听我说,"}, {"start": 1558.98, "end": 1559.98, "text": "刚才在酒宴上,"}, {"start": 1559.98, "end": 1561.98, "text": "你真是太情帅了,"}, {"start": 1561.98, "end": 1563.98, "text": "刘备那是做事要让徐州,"}, {"start": 1563.98, "end": 1565.98, "text": "你怎么能去接他的官房呢?"}, {"start": 1566.98, "end": 1568.98, "text": "是他要给,"}, {"start": 1568.98, "end": 1569.98, "text": "又不是我要躲他的,"}, {"start": 1570.98, "end": 1572.98, "text": "他那是试探我们,"}, {"start": 1573.98, "end": 1575.98, "text": "刘备根本不是真心诚意,"}, {"start": 1575.98, "end": 1577.98, "text": "就算他真心诚意要让徐州,"}, {"start": 1577.98, "end": 1579.98, "text": "他两个兄弟关于张飞,"}, {"start": 1579.98, "end": 1580.98, "text": "难道会答应吗?"}, {"start": 1581.98, "end": 1582.98, "text": "行行行,"}, {"start": 1583.98, "end": 1585.98, "text": "那刘备的真意到底是什么呢?"}, {"start": 1586.98, "end": 1587.98, "text": "刘备的真意嘛,"}, {"start": 1588.98, "end": 1590.98, "text": "是想施加恩典于你,"}, {"start": 1591.98, "end": 1593.98, "text": "将你引为己用,"}, {"start": 1594.98, "end": 1595.98, "text": "共聚曹操,"}, {"start": 1598.98, "end": 1599.98, "text": "那不一样嘛,"}, {"start": 1600.98, "end": 1601.98, "text": "我也正想跟他共聚曹操,"}, {"start": 1602.98, "end": 1603.98, "text": "当然不一样了,"}, {"start": 1604.98, "end": 1605.98, "text": "你想一想,"}, {"start": 1605.98, "end": 1607.98, "text": "他的想法是以他为主,"}, {"start": 1607.98, "end": 1608.98, "text": "用你为将,"}, {"start": 1608.98, "end": 1610.98, "text": "你的想法是以你为主,"}, {"start": 1610.98, "end": 1611.98, "text": "用他为仆,"}, {"start": 1612.98, "end": 1614.98, "text": "你甚至想取而代之,"}, {"start": 1614.98, "end": 1615.98, "text": "做徐州刺史,"}, {"start": 1615.98, "end": 1616.98, "text": "这能一样吗?"}, {"start": 1626.56, "end": 1627.56, "text": "那我该怎么做?"}, {"start": 1627.56, "end": 1631.45, "text": "看来刘备是真心要用我们,"}, {"start": 1632.45, "end": 1633.45, "text": "也好,"}, {"start": 1634.45, "end": 1635.45, "text": "那我们就投其所好,"}, {"start": 1635.45, "end": 1636.45, "text": "趁热打铁,"}, {"start": 1638.7, "end": 1640.7, "text": "可以结拜为异性兄弟,"}, {"start": 1640.7, "end": 1641.7, "text": "把关系搞好,"}, {"start": 1642.7, "end": 1643.7, "text": "至于以后嘛,"}, {"start": 1643.7, "end": 1644.7, "text": "看情况,"}, {"start": 1644.7, "end": 1645.7, "text": "再定进退,"}, {"start": 1650.58, "end": 1651.58, "text": "明白了,"}, {"start": 1651.58, "end": 1661.89, "text": "你照我的,"}, {"start": 1666.76, "end": 1667.76, "text": "数月来,"}, {"start": 1667.76, "end": 1672.48, "text": "我劳师远征,"}, {"start": 1672.48, "end": 1675.48, "text": "在衍州和徐州两地,"}, {"start": 1675.48, "end": 1676.48, "text": "浴血苦战,"}, {"start": 1677.48, "end": 1679.48, "text": "花费了几十万的粮饷,"}, {"start": 1679.48, "end": 1681.48, "text": "却连半寸土地都没有得到,"}, {"start": 1682.48, "end": 1684.82, "text": "可这个刘备,"}, {"start": 1684.82, "end": 1688.55, "text": "不费吹灰之力,"}, {"start": 1689.55, "end": 1691.55, "text": "坐收徐州六郡,"}, {"start": 1692.55, "end": 1693.55, "text": "由此可见,"}, {"start": 1694.55, "end": 1695.55, "text": "这个人是,"}, {"start": 1695.55, "end": 1696.55, "text": "忠厚其表,"}, {"start": 1697.55, "end": 1698.55, "text": "奸恶其心,"}, {"start": 1699.55, "end": 1701.55, "text": "在下早就说过,"}, {"start": 1702.55, "end": 1705.55, "text": "刘备表面上看像个人与君子,"}, {"start": 1705.55, "end": 1706.55, "text": "但他大之若鱼,"}, {"start": 1706.55, "end": 1707.55, "text": "大北四中,"}, {"start": 1707.55, "end": 1708.55, "text": "厉害啊,"}, {"start": 1708.55, "end": 1709.55, "text": "主公,"}, {"start": 1709.55, "end": 1710.55, "text": "绝不能小事,"}, {"start": 1710.55, "end": 1712.55, "text": "我从来都没有小看过他,"}, {"start": 1714.55, "end": 1715.55, "text": "倒是他,"}, {"start": 1715.55, "end": 1718.55, "text": "在内心里小看我,"}, {"start": 1718.55, "end": 1719.55, "text": "主公想怎么办,"}, {"start": 1722.22, "end": 1723.22, "text": "我找你来,"}, {"start": 1726.46, "end": 1727.46, "text": "就是想跟你商量,"}, {"start": 1728.46, "end": 1729.46, "text": "我想等,"}, {"start": 1729.46, "end": 1731.46, "text": "粮草备齐之后,"}, {"start": 1732.46, "end": 1733.46, "text": "就攻打刘备,"}, {"start": 1733.46, "end": 1734.46, "text": "夺回徐州,"}, {"start": 1735.46, "end": 1736.46, "text": "不妥,"}, {"start": 1736.46, "end": 1737.46, "text": "有何不妥,"}, {"start": 1738.46, "end": 1739.46, "text": "徐州,"}, {"start": 1739.46, "end": 1740.46, "text": "徐州,"}, {"start": 1740.46, "end": 1742.46, "text": "来夺取中原之要地,"}, {"start": 1743.46, "end": 1744.46, "text": "我们豫城大业,"}, {"start": 1745.46, "end": 1746.46, "text": "必须得占领徐州,"}, {"start": 1747.46, "end": 1748.46, "text": "主公三思,"}, {"start": 1749.46, "end": 1751.46, "text": "徐州和以前不同了,"}, {"start": 1751.46, "end": 1755.25, "text": "现在刘备与吕不联手,"}, {"start": 1755.25, "end": 1757.25, "text": "徐州城是更加强大,"}, {"start": 1758.25, "end": 1760.25, "text": "如果主公率军急攻,"}, {"start": 1760.25, "end": 1762.25, "text": "势必会逼得两人生死同心,"}, {"start": 1762.25, "end": 1763.25, "text": "合力抵抗,"}, {"start": 1764.25, "end": 1765.25, "text": "相反,"}, {"start": 1765.25, "end": 1767.25, "text": "主公要是能够容忍一下,"}, {"start": 1767.25, "end": 1770.25, "text": "徐州城肯定是一山难容二虎,"}, {"start": 1771.25, "end": 1773.25, "text": "吕布和刘备这两个人,"}, {"start": 1773.25, "end": 1775.25, "text": "一个是贪耳好女,"}, {"start": 1775.25, "end": 1777.25, "text": "一个是虚伪自士,"}, {"start": 1777.25, "end": 1779.25, "text": "早晚会争起来,"}, {"start": 1779.25, "end": 1780.25, "text": "到那个时候,"}, {"start": 1780.25, "end": 1782.25, "text": "主公再踢兵取徐州,"}, {"start": 1782.25, "end": 1784.25, "text": "岂不是更加,"}, {"start": 1784.25, "end": 1796.26, "text": "言之有理,"}, {"start": 1796.26, "end": 1798.86, "text": "急攻,"}, {"start": 1798.86, "end": 1799.86, "text": "则,"}, {"start": 1800.86, "end": 1801.86, "text": "同心相聚,"}, {"start": 1803.86, "end": 1804.86, "text": "宽忍,"}, {"start": 1804.86, "end": 1805.86, "text": "则,"}, {"start": 1805.86, "end": 1807.86, "text": "必胜分裂,"}, {"start": 1807.86, "end": 1808.86, "text": "徐御,"}, {"start": 1808.86, "end": 1810.86, "text": "你想得深远,"}, {"start": 1810.86, "end": 1812.86, "text": "我不如你,"}, {"start": 1812.86, "end": 1813.86, "text": "主公,"}, {"start": 1813.86, "end": 1815.86, "text": "只是一时脑怒罢,"}, {"start": 1815.86, "end": 1817.86, "text": "如果主公心平气和,"}, {"start": 1817.86, "end": 1819.86, "text": "静起心来,"}, {"start": 1819.86, "end": 1822.86, "text": "片刻就能看出这里的要害,"}, {"start": 1822.86, "end": 1824.86, "text": "这话说得倒是,"}, {"start": 1824.86, "end": 1825.86, "text": "以后,"}, {"start": 1825.86, "end": 1827.86, "text": "如果我再脑怒过头,"}, {"start": 1827.86, "end": 1828.86, "text": "你马上骂我,"}, {"start": 1828.86, "end": 1829.86, "text": "把我骂醒,"}, {"start": 1829.86, "end": 1831.86, "text": "在下断了,"}, {"start": 1831.86, "end": 1832.86, "text": "我命令你骂,"}, {"start": 1832.86, "end": 1834.86, "text": "留我们在徐州小住,"}, {"start": 1834.86, "end": 1865.02, "text": "日日宴请,"}, {"start": 1865.02, "end": 1867.02, "text": "百般关照,"}, {"start": 1867.02, "end": 1869.02, "text": "奉献将军和本人啊,"}, {"start": 1869.02, "end": 1870.02, "text": "都是,"}, {"start": 1870.02, "end": 1872.02, "text": "又感动又不安哪,"}, {"start": 1872.02, "end": 1874.02, "text": "龚太兄这话,"}, {"start": 1874.02, "end": 1876.02, "text": "倒让我不安了,"}, {"start": 1876.02, "end": 1878.02, "text": "徐州就是你们的家,"}, {"start": 1878.02, "end": 1880.02, "text": "你们若能长居于此,"}, {"start": 1880.02, "end": 1881.02, "text": "非但,"}, {"start": 1881.02, "end": 1882.02, "text": "刘备之幸,"}, {"start": 1882.02, "end": 1885.02, "text": "而是徐州全城军民之幸,"}, {"start": 1885.02, "end": 1887.02, "text": "谢谢谢谢,"}, {"start": 1887.02, "end": 1888.02, "text": "奉献将军,"}, {"start": 1888.02, "end": 1889.02, "text": "确实,"}, {"start": 1889.02, "end": 1891.02, "text": "感恩不尽,"}, {"start": 1891.02, "end": 1892.02, "text": "今天特设嘉宴,"}, {"start": 1892.02, "end": 1894.02, "text": "请刘公光临哪,"}, {"start": 1895.02, "end": 1897.02, "text": "奉献把嘉卷都带来了,"}, {"start": 1898.02, "end": 1899.02, "text": "贤弟,"}, {"start": 1899.02, "end": 1900.02, "text": "来来来,"}, {"start": 1900.02, "end": 1901.02, "text": "快来,"}, {"start": 1901.02, "end": 1903.02, "text": "于兄恭候多时了,"}, {"start": 1903.02, "end": 1904.02, "text": "宣德兄慢用,"}, {"start": 1904.02, "end": 1905.02, "text": "好,"}, {"start": 1907.81, "end": 1908.81, "text": "贤弟,"}, {"start": 1908.81, "end": 1909.81, "text": "于兄现在是,"}, {"start": 1909.81, "end": 1910.81, "text": "一日不见,"}, {"start": 1910.81, "end": 1911.81, "text": "如隔三秋,"}, {"start": 1911.81, "end": 1913.81, "text": "今日我们要痛饮三百杯,"}, {"start": 1913.81, "end": 1914.81, "text": "好,"}, {"start": 1914.81, "end": 1915.81, "text": "就是你嫂子,"}, {"start": 1916.81, "end": 1917.81, "text": "雕柴,"}, {"start": 1917.81, "end": 1928.09, "text": "嫂夫人,"}, {"start": 1928.09, "end": 1929.09, "text": "美名天下,"}, {"start": 1929.09, "end": 1930.09, "text": "刘备拜见,"}, {"start": 1932.69, "end": 1933.69, "text": "平妾不敢,"}, {"start": 1933.69, "end": 1934.69, "text": "刘将军,"}, {"start": 1934.69, "end": 1936.69, "text": "才是人中龙凤,"}, {"start": 1937.69, "end": 1938.69, "text": "贤弟,"}, {"start": 1938.69, "end": 1939.69, "text": "于兄是,"}, {"start": 1939.69, "end": 1940.69, "text": "略备薄拙,"}, {"start": 1940.69, "end": 1944.98, "text": "为答谢你,"}, {"start": 1944.98, "end": 1945.98, "text": "代我之厚恩,"}, {"start": 1945.98, "end": 1946.98, "text": "多谢,"}, {"start": 1947.98, "end": 1948.98, "text": "雕柴,"}, {"start": 1948.98, "end": 1950.98, "text": "唱几出你拿手的曲子,"}, {"start": 1950.98, "end": 1951.98, "text": "为刘贤弟助兴吧,"}, {"start": 1952.98, "end": 1954.98, "text": "贤妾遵命,"}, {"start": 1955.98, "end": 1956.98, "text": "多谢,"}, {"start": 1957.98, "end": 1958.98, "text": "来,"}, {"start": 1958.98, "end": 1959.98, "text": "贤弟请,"}, {"start": 1959.98, "end": 1960.98, "text": "刘将军,"}, {"start": 1960.98, "end": 1961.98, "text": "请刘将军,"}, {"start": 1961.98, "end": 1962.98, "text": "来,"}, {"start": 1962.98, "end": 1963.98, "text": "贤弟请,"}, {"start": 1980.02, "end": 1981.02, "text": "贤弟,"}, {"start": 1981.02, "end": 2029.86, "text": "请,"}, {"start": 2029.86, "end": 2030.86, "text": "贤弟,"}, {"start": 2030.86, "end": 2031.86, "text": "喝酒,"}, {"start": 2031.86, "end": 2079.54, "text": "这什么家宴,"}, {"start": 2079.54, "end": 2084.52, "text": "把咱大哥也叫起来,"}, {"start": 2084.52, "end": 2087.44, "text": "倒是喝喝酒嘛,"}, {"start": 2087.44, "end": 2088.44, "text": "试宴的是谁嘛,"}, {"start": 2088.44, "end": 2089.44, "text": "谁啊,"}, {"start": 2089.44, "end": 2092.23, "text": "雕柴,"}, {"start": 2093.23, "end": 2095.23, "text": "就是吕布抢来的那个女人,"}, {"start": 2095.23, "end": 2097.23, "text": "听说此女美艳无双,"}, {"start": 2097.23, "end": 2098.23, "text": "男人碰到她呀,"}, {"start": 2098.23, "end": 2100.23, "text": "都会鼓吐神秘,"}, {"start": 2101.23, "end": 2103.23, "text": "这吕布叫她试宴,"}, {"start": 2103.23, "end": 2105.23, "text": "这是给大哥摆的什么阵,"}, {"start": 2105.23, "end": 2107.23, "text": "大哥熔马半生,"}, {"start": 2107.23, "end": 2108.23, "text": "心肠又软,"}, {"start": 2108.23, "end": 2109.23, "text": "这不,"}, {"start": 2109.23, "end": 2110.23, "text": "好啊,"}, {"start": 2110.23, "end": 2111.23, "text": "吕布这丝,"}, {"start": 2111.23, "end": 2113.23, "text": "用自家家门勾引咱哥,"}, {"start": 2113.23, "end": 2114.23, "text": "这还得了啊,"}, {"start": 2115.23, "end": 2116.23, "text": "咱得想个办法,"}, {"start": 2116.23, "end": 2117.23, "text": "把大哥弄回来,"}, {"start": 2117.23, "end": 2118.23, "text": "别中了吕布的圈套,"}, {"start": 2119.23, "end": 2120.23, "text": "想个什么办法,"}, {"start": 2120.23, "end": 2121.23, "text": "我一天跳了天就是,"}, {"start": 2122.23, "end": 2123.23, "text": "三弟,"}, {"start": 2123.23, "end": 2124.23, "text": "不可莽撞,"}, {"start": 2124.23, "end": 2136.4, "text": "将军请,"}, {"start": 2136.4, "end": 2138.4, "text": "多谢嫂夫人,"}, {"start": 2138.4, "end": 2141.32, "text": "玄德,"}, {"start": 2141.32, "end": 2144.32, "text": "今天起咱们就是自家兄弟了,"}, {"start": 2144.32, "end": 2145.32, "text": "生死同舟,"}, {"start": 2145.32, "end": 2146.32, "text": "荣辱与共,"}, {"start": 2147.32, "end": 2148.32, "text": "来来来,"}, {"start": 2148.32, "end": 2149.32, "text": "喝酒,"}, {"start": 2150.32, "end": 2157.5, "text": "我哥哥金枝玉叶,"}, {"start": 2157.5, "end": 2159.5, "text": "你这丝竟敢叫他做贤弟,"}, {"start": 2159.5, "end": 2160.5, "text": "你是什么东西啊,"}, {"start": 2161.5, "end": 2162.5, "text": "三姓家奴,"}, {"start": 2162.5, "end": 2163.5, "text": "大灾星,"}, {"start": 2163.5, "end": 2164.5, "text": "临元董卓王云,"}, {"start": 2164.5, "end": 2166.5, "text": "都是被你这家奴害死的,"}, {"start": 2167.5, "end": 2168.5, "text": "你现在又舔着脸,"}, {"start": 2168.5, "end": 2169.5, "text": "来拔救我哥不成,"}, {"start": 2169.5, "end": 2171.5, "text": "羞死来了,"}, {"start": 2173.5, "end": 2174.5, "text": "三弟,"}, {"start": 2174.5, "end": 2175.5, "text": "快快出口,"}, {"start": 2175.5, "end": 2176.5, "text": "吕布你听着,"}, {"start": 2176.5, "end": 2178.5, "text": "张爷爷把你的小姐带来了,"}, {"start": 2179.5, "end": 2180.5, "text": "赶快拿上你的兵器,"}, {"start": 2180.5, "end": 2182.5, "text": "过来跟张爷爷大战三百回合,"}, {"start": 2182.5, "end": 2183.5, "text": "快快退下,"}, {"start": 2185.5, "end": 2186.5, "text": "吕布,"}, {"start": 2186.5, "end": 2187.5, "text": "你听着啊,"}, {"start": 2187.5, "end": 2189.5, "text": "爷爷在关前等着你,"}, {"start": 2189.5, "end": 2193.38, "text": "将军不要,"}, {"start": 2194.38, "end": 2197.4, "text": "奉贤兄,"}, {"start": 2197.4, "end": 2198.4, "text": "嫂夫人,"}, {"start": 2198.4, "end": 2199.4, "text": "真是对不住,"}, {"start": 2199.4, "end": 2200.4, "text": "我三弟是个粗人,"}, {"start": 2200.4, "end": 2201.4, "text": "不知礼法,"}, {"start": 2201.4, "end": 2203.4, "text": "我替他向你们赔罪,"}, {"start": 2203.4, "end": 2204.4, "text": "得罪,"}, {"start": 2204.4, "end": 2208.5, "text": "得罪,"}, {"start": 2208.5, "end": 2210.5, "text": "将军其实不必在意的,"}, {"start": 2210.5, "end": 2211.5, "text": "我们都知道,"}, {"start": 2211.5, "end": 2213.5, "text": "这刘光章三兄弟,"}, {"start": 2213.5, "end": 2215.5, "text": "是天下的大英雄,"}, {"start": 2216.5, "end": 2217.5, "text": "玄子你别说了,"}, {"start": 2218.5, "end": 2220.5, "text": "我吕布再傻也明白事理,"}, {"start": 2221.5, "end": 2223.5, "text": "徐州我是不能留了,"}, {"start": 2223.5, "end": 2224.5, "text": "我今天就走,"}, {"start": 2225.5, "end": 2226.5, "text": "奉贤兄想哪里去了?"}, {"start": 2227.5, "end": 2228.5, "text": "大战斧,"}, {"start": 2228.5, "end": 2229.5, "text": "四海为家,"}, {"start": 2229.5, "end": 2231.5, "text": "我兵方天化及赤兔马,"}, {"start": 2232.5, "end": 2233.5, "text": "何处没容身之地,"}, {"start": 2241.64, "end": 2242.64, "text": "可否这样,"}, {"start": 2242.64, "end": 2245.64, "text": "徐州城外五十里处有边城小配,"}, {"start": 2246.64, "end": 2248.64, "text": "那也是我先前驻兵之处,"}, {"start": 2248.64, "end": 2250.64, "text": "奉贤可率军暂时驻扎小配,"}, {"start": 2251.64, "end": 2254.64, "text": "粮草军饷具有徐州共济,"}, {"start": 2254.64, "end": 2255.64, "text": "可否?"}, {"start": 2258.64, "end": 2259.64, "text": "我看可以啊,"}, {"start": 2260.64, "end": 2261.64, "text": "这样,"}, {"start": 2262.64, "end": 2264.64, "text": "小配和徐州城曾计较之事,"}, {"start": 2265.64, "end": 2266.64, "text": "一旦有警,"}, {"start": 2266.64, "end": 2268.64, "text": "咱们两军可以互相应援,"}, {"start": 2269.64, "end": 2270.64, "text": "奉贤哪,"}, {"start": 2270.64, "end": 2271.64, "text": "快,"}, {"start": 2271.64, "end": 2281.5, "text": "谢过玄德,"}, {"start": 2281.5, "end": 2282.5, "text": "请如此,"}, {"start": 2282.5, "end": 2285.3, "text": "拜谢玄德了,"}, {"start": 2285.3, "end": 2286.3, "text": "不谢,"}, {"start": 2288.74, "end": 2289.74, "text": "在下这就领命,"}, {"start": 2289.74, "end": 2290.74, "text": "前往小配,"}, {"start": 2290.74, "end": 2312.13, "text": "我竟然入到这个地步,"}, {"start": 2312.13, "end": 2313.13, "text": "竟然看门守关,"}, {"start": 2314.13, "end": 2315.13, "text": "当年韩信友,"}, {"start": 2315.13, "end": 2316.13, "text": "跨夏之日,"}, {"start": 2316.13, "end": 2318.13, "text": "张良有十里之修,"}, {"start": 2319.13, "end": 2321.13, "text": "将军和他们相比,"}, {"start": 2321.13, "end": 2322.13, "text": "修与辱还差得远,"}, {"start": 2323.13, "end": 2325.13, "text": "卫羽博倒是要多得多了,"}, {"start": 2325.13, "end": 2328.82, "text": "咱们下一步,"}, {"start": 2328.82, "end": 2329.82, "text": "该怎么做?"}, {"start": 2329.82, "end": 2332.06, "text": "暂驻小配,"}, {"start": 2333.06, "end": 2334.06, "text": "招兵买马,"}, {"start": 2334.06, "end": 2335.06, "text": "官时待变,"}, {"start": 2336.06, "end": 2344.46, "text": "这灾情糟了,"}, {"start": 2344.46, "end": 2346.46, "text": "咱们少了个大麻烦啊,"}, {"start": 2346.46, "end": 2348.46, "text": "麻烦事在后面哪,"}, {"start": 2348.46, "end": 2352.34, "text": "曹操战败吕布已有半日,"}, {"start": 2352.34, "end": 2355.34, "text": "按理早就该向徐州用兵了,"}, {"start": 2355.34, "end": 2357.34, "text": "可是到现在,"}, {"start": 2357.34, "end": 2360.34, "text": "远州方向已是没有任何动作,"}, {"start": 2360.34, "end": 2361.34, "text": "不知在谋划什么,"}, {"start": 2362.34, "end": 2363.34, "text": "怕什么,"}, {"start": 2363.34, "end": 2365.34, "text": "徐州城是座监城,"}, {"start": 2365.34, "end": 2366.34, "text": "粮饷充足,"}, {"start": 2366.34, "end": 2368.34, "text": "曹操赶来犯,"}, {"start": 2368.34, "end": 2370.34, "text": "我必迎头通缉,"}, {"start": 2370.34, "end": 2371.34, "text": "就是就是,"}, {"start": 2371.34, "end": 2372.34, "text": "这多日不打仗,"}, {"start": 2372.34, "end": 2374.34, "text": "这手都痒痒了,"}, {"start": 2374.34, "end": 2376.34, "text": "这整天除了喝酒,"}, {"start": 2376.34, "end": 2377.34, "text": "也没有别的事情做,"}, {"start": 2377.34, "end": 2379.34, "text": "难过得紧的,"}, {"start": 2381.34, "end": 2383.34, "text": "这曹操要是再不来,"}, {"start": 2383.34, "end": 2387.34, "text": "干脆我们打到远州去找他算了,"}, {"start": 2388.34, "end": 2396.9, "text": "在下遵命,"}, {"start": 2396.9, "end": 2397.9, "text": "禀主公,"}, {"start": 2397.9, "end": 2399.9, "text": "董城从长安派来一密使,"}, {"start": 2399.9, "end": 2402.9, "text": "秘密传达天子诏书,"}, {"start": 2403.9, "end": 2404.9, "text": "人呢?"}, {"start": 2405.9, "end": 2406.9, "text": "那许臣啊,"}, {"start": 2406.9, "end": 2409.9, "text": "饿的只剩下一把锅头了,"}, {"start": 2409.9, "end": 2411.9, "text": "刚刚进门就昏过去了,"}, {"start": 2411.9, "end": 2413.9, "text": "我派人把他送到后院喝粥去了,"}, {"start": 2413.9, "end": 2458.21, "text": "究竟发生什么事?"}, {"start": 2458.21, "end": 2460.21, "text": "让末将也知道一点吧,"}]