[{"start": 15.63, "end": 18.63, "text": "凤仙,幸会,幸会。"}, {"start": 20.31, "end": 22.31, "text": "孟德,多年不见。"}, {"start": 23.71, "end": 27.91, "text": "是啊,咱们上一次见面还是在董卓的府上。"}, {"start": 28.75, "end": 31.35, "text": "久别重逢,格外亲切啊。"}, {"start": 33.47, "end": 37.03, "text": "实话告诉你,我还有五万多军士,"}, {"start": 37.67, "end": 38.87, "text": "有百日囤粮。"}, {"start": 39.91, "end": 41.23, "text": "夏毕成你也看见了,"}, {"start": 42.15, "end": 43.71, "text": "他高三杖,厚两杖。"}, {"start": 44.67, "end": 47.27, "text": "三面环似水,易守难攻。"}, {"start": 47.87, "end": 51.19, "text": "凤仙,我今天来不是想听这些啊,"}, {"start": 51.67, "end": 54.19, "text": "我是过来跟老友叙旧的。"}, {"start": 54.75, "end": 55.47, "text": "叙旧?"}, {"start": 56.31, "end": 59.83, "text": "是啊,我老实告诉你吧,"}, {"start": 60.59, "end": 63.59, "text": "天下住侯当中,我谁都不怕,"}, {"start": 64.11, "end": 65.43, "text": "就怕你吕凤仙。"}, {"start": 66.15, "end": 68.83, "text": "天下住侯当中,我谁都不敬,"}, {"start": 69.31, "end": 72.19, "text": "就敬你吕凤仙,一言一笔之。"}, {"start": 72.71, "end": 75.07, "text": "我对你是又敬又畏啊。"}, {"start": 77.03, "end": 77.63, "text": "真的?"}, {"start": 77.95, "end": 80.15, "text": "那当然,你想啊,"}, {"start": 81.03, "end": 82.75, "text": "自从董卓进京以来,"}, {"start": 83.35, "end": 87.15, "text": "袁术,袁绍,刘表,陶谦,公孙瓒,"}, {"start": 87.35, "end": 90.39, "text": "还有我草草,相继列土称霸。"}, {"start": 90.75, "end": 93.67, "text": "可是没有一个人能一统天下,为什么呢?"}, {"start": 94.03, "end": 96.51, "text": "还不是因为有你吕凤仙吗?"}, {"start": 99.27, "end": 100.75, "text": "你住董卓的时候,"}, {"start": 101.15, "end": 103.19, "text": "董卓就可以独霸京师。"}, {"start": 103.91, "end": 106.95, "text": "你住袁术的时候,袁术他就敢称帝。"}, {"start": 108.27, "end": 111.23, "text": "你住刘备,甚至不需一刀一枪,"}, {"start": 111.63, "end": 114.95, "text": "只要袁门射击就可以一箭定太平。"}, {"start": 117.42, "end": 119.94, "text": "人中吕布,马中吃兔,"}, {"start": 120.26, "end": 121.42, "text": "此言不虚啊。"}, {"start": 121.9, "end": 124.54, "text": "再加上你手中这敢方天化己,"}, {"start": 124.78, "end": 126.82, "text": "真看天下无敌啊。"}, {"start": 127.14, "end": 130.9, "text": "那是,那是,有此可见。"}, {"start": 131.74, "end": 133.54, "text": "只要将军愿意助我,"}, {"start": 134.02, "end": 136.02, "text": "则草草的大业必成。"}, {"start": 137.26, "end": 138.14, "text": "可惜啊,"}, {"start": 139.14, "end": 142.5, "text": "可惜你这些年来一直东征西讨,"}, {"start": 142.9, "end": 144.34, "text": "战守不定,"}, {"start": 144.82, "end": 147.06, "text": "积择时,保则去,"}, {"start": 147.54, "end": 150.06, "text": "专门给各路诸侯添麻烦。"}, {"start": 151.46, "end": 152.86, "text": "人家收容你吧,"}, {"start": 153.38, "end": 155.42, "text": "你反过来夺人诚实,"}, {"start": 155.86, "end": 157.14, "text": "人家想狡杀你,"}, {"start": 157.46, "end": 158.46, "text": "又斗不过你,"}, {"start": 158.66, "end": 160.18, "text": "最后反被你所杀,"}, {"start": 160.34, "end": 161.42, "text": "你说是不是啊?"}, {"start": 162.94, "end": 163.46, "text": "是啊,"}, {"start": 164.46, "end": 165.62, "text": "蒙德兄说的是。"}, {"start": 166.02, "end": 167.98, "text": "所以,我思来想去啊,"}, {"start": 169.34, "end": 171.02, "text": "与其咱们俩拼个,"}, {"start": 171.58, "end": 173.58, "text": "你死我活两败俱伤,"}, {"start": 174.26, "end": 175.66, "text": "不如我冒个风险,"}, {"start": 176.06, "end": 177.18, "text": "冒个什么风险呢?"}, {"start": 179.34, "end": 180.3, "text": "我跟你结盟,"}, {"start": 181.06, "end": 182.3, "text": "咱们共同大业,"}, {"start": 182.98, "end": 184.26, "text": "只要咱们俩联手,"}, {"start": 184.66, "end": 186.02, "text": "定能一统天下。"}, {"start": 188.1, "end": 188.82, "text": "奉先啊,"}, {"start": 189.82, "end": 190.5, "text": "你听好,"}, {"start": 191.5, "end": 194.14, "text": "我想把所有的兵马都交给你,"}, {"start": 194.94, "end": 196.78, "text": "你来当这个三军大元帅,"}, {"start": 196.86, "end": 197.94, "text": "专事征战,"}, {"start": 198.58, "end": 202.38, "text": "我给你提供粮饷,军械,"}, {"start": 202.66, "end": 203.78, "text": "打仗我不行,"}, {"start": 204.26, "end": 205.86, "text": "但是辅助善战者,"}, {"start": 206.02, "end": 208.38, "text": "那正是曹操之所长啊。"}, {"start": 211.26, "end": 212.78, "text": "董卓当年要肯这么做,"}, {"start": 213.22, "end": 214.46, "text": "他早就当皇帝了。"}, {"start": 214.62, "end": 216.22, "text": "是是是是是是,"}, {"start": 216.62, "end": 217.7, "text": "董卓愚蠢,"}, {"start": 218.26, "end": 220.18, "text": "不识将军的价值啊,"}, {"start": 221.5, "end": 222.3, "text": "奉先,"}, {"start": 223.22, "end": 224.42, "text": "咱们讲和吧,"}, {"start": 226.1, "end": 227.54, "text": "就在这城关下,"}, {"start": 227.7, "end": 228.74, "text": "四水边,"}, {"start": 228.94, "end": 230.38, "text": "咱们沙雪为盟,"}, {"start": 230.46, "end": 231.74, "text": "载马为士,"}, {"start": 231.82, "end": 232.98, "text": "结为兄弟,"}, {"start": 233.06, "end": 234.22, "text": "你看可好啊?"}, {"start": 235.7, "end": 240.86, "text": "你还认得我吗?"}, {"start": 241.06, "end": 249.9, "text": "宫太兄啊,"}, {"start": 250.74, "end": 252.74, "text": "多年不见你可想死我了,"}, {"start": 252.86, "end": 255.06, "text": "咱们还有一壶酒没有喝完呢,"}, {"start": 255.58, "end": 256.86, "text": "先把酒撂下,"}, {"start": 257.02, "end": 257.66, "text": "来,"}, {"start": 258.22, "end": 259.26, "text": "吃我一剑。"}, {"start": 267.05, "end": 267.85, "text": "奉先啊,"}, {"start": 268.13, "end": 269.45, "text": "快快回城。"}, {"start": 269.77, "end": 307.17, "text": "如果不是成功放箭,"}, {"start": 307.73, "end": 309.73, "text": "那个呆子几乎被我说动了,"}, {"start": 310.81, "end": 312.37, "text": "我一定要杀了成功。"}, {"start": 312.93, "end": 313.57, "text": "主公,"}, {"start": 314.05, "end": 315.21, "text": "既然吕布不祥,"}, {"start": 315.37, "end": 316.69, "text": "末将领军强攻吧。"}, {"start": 319.13, "end": 321.05, "text": "我仔细看过那个城防,"}, {"start": 321.33, "end": 322.97, "text": "它确如吕布所言,"}, {"start": 324.05, "end": 325.21, "text": "高约三仗,"}, {"start": 325.37, "end": 326.45, "text": "后约两仗,"}, {"start": 327.17, "end": 328.29, "text": "如果强攻,"}, {"start": 328.49, "end": 329.85, "text": "恐怕伤亡太大。"}, {"start": 333.82, "end": 334.5, "text": "主公,"}, {"start": 334.94, "end": 336.1, "text": "在下有主意了。"}, {"start": 338.15, "end": 339.03, "text": "你说什么?"}, {"start": 340.9, "end": 341.94, "text": "在下认为,"}, {"start": 342.5, "end": 343.62, "text": "四合可用。"}, {"start": 345.78, "end": 347.3, "text": "那合是用来护城的,"}, {"start": 347.86, "end": 349.22, "text": "怎么可以用来攻城吗?"}, {"start": 350.74, "end": 351.42, "text": "你说。"}, {"start": 354.02, "end": 355.1, "text": "为何不可呀?"}, {"start": 356.78, "end": 357.9, "text": "得于死者,"}, {"start": 358.22, "end": 359.14, "text": "毁于私。"}, {"start": 360.02, "end": 360.66, "text": "主公啊,"}, {"start": 361.34, "end": 363.26, "text": "雨季就快到了。"}, {"start": 372.83, "end": 383.78, "text": "天公助我。"}, {"start": 383.78, "end": 385.58, "text": "曹军是远道而来,"}, {"start": 386.42, "end": 387.78, "text": "冰封绝不能久,"}, {"start": 388.86, "end": 390.58, "text": "只要我们坚守两个月以上,"}, {"start": 390.9, "end": 392.38, "text": "他们非退军不可。"}, {"start": 392.54, "end": 396.54, "text": "难道曹操就不攻城了吧?"}, {"start": 397.02, "end": 398.26, "text": "他肯定要攻城,"}, {"start": 398.82, "end": 401.1, "text": "只是现在雨中不便用兵。"}, {"start": 402.78, "end": 405.38, "text": "曹操在等雨势稍减啊。"}, {"start": 405.9, "end": 407.97, "text": "这样,"}, {"start": 408.33, "end": 409.05, "text": "奉献哪,"}, {"start": 409.53, "end": 411.57, "text": "不如趁现在雨水未停歇,"}, {"start": 412.17, "end": 413.65, "text": "您率铁骑出城,"}, {"start": 414.13, "end": 416.25, "text": "在城外高处见营在。"}, {"start": 417.29, "end": 418.97, "text": "我率布军团与城内,"}, {"start": 419.13, "end": 421.01, "text": "我们互为击脚之势。"}, {"start": 421.93, "end": 423.73, "text": "为大战预做准备。"}, {"start": 424.93, "end": 425.89, "text": "等到雨停之后,"}, {"start": 426.25, "end": 428.05, "text": "曹军若敢攻打将军,"}, {"start": 428.61, "end": 429.49, "text": "我袭其后。"}, {"start": 430.41, "end": 431.65, "text": "如果曹军敢攻城,"}, {"start": 431.93, "end": 432.97, "text": "将军袭其后,"}, {"start": 433.41, "end": 434.25, "text": "如此一来,"}, {"start": 435.77, "end": 437.61, "text": "曹军是内外小弟,"}, {"start": 437.81, "end": 442.57, "text": "必败无疑。"}, {"start": 442.77, "end": 443.73, "text": "依先生之策。"}, {"start": 444.45, "end": 444.85, "text": "好,"}, {"start": 445.85, "end": 446.69, "text": "不可再耽误了,"}, {"start": 447.13, "end": 448.33, "text": "我们分头行事吧。"}, {"start": 457.94, "end": 458.5, "text": "尚将军,"}, {"start": 458.74, "end": 459.82, "text": "夫人乍受风寒,"}, {"start": 460.02, "end": 460.62, "text": "病倒了。"}, {"start": 460.94, "end": 489.74, "text": "怎么会病成这样的?"}, {"start": 489.86, "end": 509.03, "text": "丢了徐州,"}, {"start": 510.03, "end": 511.75, "text": "何至于让你颠沛流离?"}, {"start": 514.26, "end": 516.14, "text": "何至于让你受如此大罪?"}, {"start": 516.42, "end": 519.19, "text": "吕布军的受苦,"}, {"start": 519.47, "end": 522.82, "text": "能和将军在一起,"}, {"start": 524.02, "end": 525.1, "text": "今愿已足。"}, {"start": 526.26, "end": 527.54, "text": "可是我又要出城了。"}, {"start": 529.54, "end": 530.06, "text": "怎么?"}, {"start": 531.22, "end": 532.46, "text": "不是刚回来吗?"}, {"start": 533.22, "end": 534.5, "text": "城宫设下了计谋,"}, {"start": 534.74, "end": 540.76, "text": "城中蒙蒸几年。"}, {"start": 540.76, "end": 543.22, "text": "那将军,"}, {"start": 543.7, "end": 545.02, "text": "应该听先生的话,"}, {"start": 545.78, "end": 547.18, "text": "依他的计谋行事。"}, {"start": 547.62, "end": 550.09, "text": "你正在病中。"}, {"start": 555.99, "end": 556.63, "text": "将军,"}, {"start": 558.31, "end": 559.75, "text": "将军大战在即,"}, {"start": 560.71, "end": 563.63, "text": "心中岂能悬念于奴婢?"}, {"start": 563.99, "end": 566.77, "text": "你还是快走吧,"}, {"start": 567.89, "end": 569.61, "text": "别让公太先生等急了。"}, {"start": 571.37, "end": 579.82, "text": "将军,"}, {"start": 581.34, "end": 582.3, "text": "你走吧,"}, {"start": 586.6, "end": 587.36, "text": "走啊,"}, {"start": 594.7, "end": 595.5, "text": "走啊,"}, {"start": 596.02, "end": 596.98, "text": "别误了事,"}, {"start": 597.58, "end": 598.26, "text": "走啊。"}, {"start": 601.03, "end": 601.51, "text": "调查,"}, {"start": 601.99, "end": 602.55, "text": "调查,"}, {"start": 603.91, "end": 604.63, "text": "快追医官!"}, {"start": 604.99, "end": 626.01, "text": "兵马早已集结完毕,"}, {"start": 626.13, "end": 627.97, "text": "赶快率军出城吧!"}, {"start": 633.67, "end": 634.11, "text": "先生,"}, {"start": 634.35, "end": 637.91, "text": "你怎么了?"}, {"start": 638.31, "end": 640.9, "text": "调查并未,"}, {"start": 641.86, "end": 642.86, "text": "我岂能离开?"}, {"start": 643.9, "end": 644.62, "text": "什么?"}, {"start": 646.1, "end": 647.02, "text": "我想了一下,"}, {"start": 647.86, "end": 648.86, "text": "保退后几日,"}, {"start": 650.26, "end": 651.78, "text": "等调查并且稍缓,"}, {"start": 652.66, "end": 653.66, "text": "再出城里迎。"}, {"start": 654.1, "end": 655.18, "text": "奉先哪,"}, {"start": 655.54, "end": 656.66, "text": "大战在即,"}, {"start": 656.86, "end": 658.02, "text": "生死关头啊!"}, {"start": 658.18, "end": 659.66, "text": "你作为三军统帅,"}, {"start": 659.86, "end": 662.66, "text": "怎么能为一件女子而依无战计呢?"}, {"start": 662.94, "end": 666.39, "text": "调查是我一生至爱,"}, {"start": 666.51, "end": 666.99, "text": "可,"}, {"start": 676.37, "end": 677.77, "text": "我活着没有任何意义!"}, {"start": 678.81, "end": 680.13, "text": "再说我并非不出城,"}, {"start": 680.49, "end": 681.61, "text": "只想年后几日。"}, {"start": 682.13, "end": 682.89, "text": "奉先哪,"}, {"start": 683.49, "end": 685.49, "text": "机不可失,时不再来啊!"}, {"start": 685.93, "end": 686.85, "text": "你回头看看,"}, {"start": 687.21, "end": 690.05, "text": "三军将士已经候命多时了呀!"}, {"start": 690.33, "end": 693.42, "text": "意已决,"}, {"start": 694.7, "end": 696.14, "text": "等调查并好后出城,"}, {"start": 697.18, "end": 698.62, "text": "先生,回去歇息吧。"}, {"start": 698.78, "end": 699.14, "text": "你!"}, {"start": 699.38, "end": 701.9, "text": "奉先!"}, {"start": 702.5, "end": 703.46, "text": "奉先哪!"}, {"start": 705.84, "end": 706.72, "text": "众将听令!"}, {"start": 707.84, "end": 708.88, "text": "你们暂且归营,"}, {"start": 709.28, "end": 710.08, "text": "待我号令!"}, {"start": 710.68, "end": 711.52, "text": "遵命!"}, {"start": 711.72, "end": 712.36, "text": "奉先!"}, {"start": 713.16, "end": 714.36, "text": "你如此残民,"}, {"start": 714.52, "end": 716.56, "text": "会祸及三军哪!"}, {"start": 716.88, "end": 733.21, "text": "调缠于吕布,"}, {"start": 733.69, "end": 736.01, "text": "难道真是天命已定?"}, {"start": 736.37, "end": 739.78, "text": "我等将士,"}, {"start": 739.94, "end": 745.17, "text": "回身之地了!"}, {"start": 778.59, "end": 779.99, "text": "将军为何在此啊?"}, {"start": 780.67, "end": 781.27, "text": "为何,"}, {"start": 781.55, "end": 782.83, "text": "没有出城立营啊?"}, {"start": 791.53, "end": 792.25, "text": "将军,"}, {"start": 793.37, "end": 795.17, "text": "你真应该听先生的话。"}, {"start": 795.57, "end": 799.98, "text": "发水进城啦!"}, {"start": 812.74, "end": 813.82, "text": "将军小心啊!"}, {"start": 813.82, "end": 815.1, "text": "将军!将军!"}, {"start": 815.42, "end": 816.22, "text": "发水啦!"}, {"start": 838.47, "end": 839.27, "text": "怎么会这样?"}, {"start": 839.55, "end": 843.7, "text": "允绝开河地,"}, {"start": 845.54, "end": 846.38, "text": "把夏毕城,"}, {"start": 847.1, "end": 848.5, "text": "换成邦阳啦!"}, {"start": 850.18, "end": 850.78, "text": "先生,"}, {"start": 852.1, "end": 853.1, "text": "我现在该怎么办?"}, {"start": 855.47, "end": 856.55, "text": "兵律将军,"}, {"start": 857.63, "end": 859.51, "text": "你现在只有两种选择。"}, {"start": 861.65, "end": 863.85, "text": "一是坐水中鱼下,"}, {"start": 864.53, "end": 866.37, "text": "二是开城投降。"}, {"start": 866.37, "end": 882.6, "text": "你的儿女缠绵,"}, {"start": 883.12, "end": 884.48, "text": "祸及三军。"}, {"start": 891.77, "end": 892.25, "text": "不!"}, {"start": 893.09, "end": 893.69, "text": "没完!"}, {"start": 895.46, "end": 896.46, "text": "我有赤兔马!"}, {"start": 897.78, "end": 898.66, "text": "我将和胡塘,"}, {"start": 898.66, "end": 899.54, "text": "如律平地!"}, {"start": 900.14, "end": 901.34, "text": "我何惧曹贼!"}, {"start": 902.42, "end": 903.54, "text": "你有赤兔马,"}, {"start": 903.54, "end": 906.48, "text": "又方天际。"}, {"start": 907.48, "end": 908.76, "text": "可将士们有吗?"}, {"start": 908.96, "end": 950.87, "text": "安城内守军,"}, {"start": 951.23, "end": 952.59, "text": "只此剪归乡,"}, {"start": 953.11, "end": 954.35, "text": "据论功行赏。"}, {"start": 954.99, "end": 956.43, "text": "由取吕布守击者,"}, {"start": 956.67, "end": 958.31, "text": "赠五千金封办户侯。"}, {"start": 958.43, "end": 959.11, "text": "叛贼!"}, {"start": 959.55, "end": 960.43, "text": "将军!将军!"}, {"start": 960.43, "end": 961.59, "text": "想取我守击,"}, {"start": 962.47, "end": 963.79, "text": "我先把你们给斩了!"}, {"start": 964.07, "end": 964.51, "text": "来人!"}, {"start": 964.51, "end": 964.91, "text": "在!"}, {"start": 964.91, "end": 965.35, "text": "拿上!"}, {"start": 965.35, "end": 966.03, "text": "上将军!"}, {"start": 966.03, "end": 967.43, "text": "我只是虽然看了一下,"}, {"start": 967.43, "end": 968.63, "text": "却无祥朝之心!"}, {"start": 968.63, "end": 969.87, "text": "无祥朝之心哪!"}, {"start": 969.87, "end": 970.39, "text": "上将军!"}, {"start": 970.39, "end": 970.91, "text": "将军!"}, {"start": 971.11, "end": 972.35, "text": "我等为将军效命,"}, {"start": 972.35, "end": 973.47, "text": "宁死不祥啊!"}, {"start": 973.91, "end": 976.56, "text": "若无事军贵,"}, {"start": 977.2, "end": 978.0, "text": "便为部族!"}, {"start": 978.4, "end": 979.04, "text": "脱将军!"}, {"start": 979.04, "end": 980.12, "text": "将军!将军!"}, {"start": 980.12, "end": 980.96, "text": "将军!"}, {"start": 980.96, "end": 982.28, "text": "我们冤枉了!"}, {"start": 982.28, "end": 983.76, "text": "将军!将军!"}, {"start": 984.08, "end": 985.08, "text": "将军!"}, {"start": 995.35, "end": 995.99, "text": "无兄啊,"}, {"start": 996.75, "end": 997.39, "text": "你不无道,"}, {"start": 998.35, "end": 999.91, "text": "根本不顾我等死活!"}, {"start": 1000.51, "end": 1001.75, "text": "看来我们也犯不着,"}, {"start": 1003.23, "end": 1004.31, "text": "再为他卖命了!"}, {"start": 1004.59, "end": 1005.23, "text": "是啊!"}, {"start": 1071.03, "end": 1071.79, "text": "可否进城?"}, {"start": 1072.07, "end": 1076.49, "text": "请将军快入城吧!"}, {"start": 1078.04, "end": 1079.16, "text": "生命的人,"}, {"start": 1082.06, "end": 1083.66, "text": "我一眼就识破了!"}, {"start": 1084.42, "end": 1086.62, "text": "这不过是成功布下的诡计,"}, {"start": 1086.62, "end": 1087.98, "text": "想转我进城,"}, {"start": 1088.14, "end": 1089.3, "text": "取我守击,"}, {"start": 1089.9, "end": 1090.94, "text": "如此把戏,"}, {"start": 1091.38, "end": 1093.22, "text": "谁能瞒得过我曹操?"}, {"start": 1098.09, "end": 1098.97, "text": "曹将军!"}, {"start": 1100.05, "end": 1101.97, "text": "我们真的伤及吕布!"}, {"start": 1102.89, "end": 1104.53, "text": "请将军不要多疑!"}, {"start": 1106.72, "end": 1108.92, "text": "尔等若是真的擒住了吕布,"}, {"start": 1109.72, "end": 1112.08, "text": "就将他的兵器置下我看!"}, {"start": 1113.36, "end": 1113.96, "text": "将军拿来!"}, {"start": 1117.06, "end": 1118.1, "text": "将军请看!"}, {"start": 1118.78, "end": 1120.3, "text": "吕布兵器在此!"}, {"start": 1135.13, "end": 1135.89, "text": "是吕布的棘!"}, {"start": 1136.21, "end": 1137.49, "text": "还真是吕布的棘!"}, {"start": 1138.01, "end": 1139.25, "text": "看来我又多疑了!"}, {"start": 1140.21, "end": 1140.61, "text": "曹人!"}, {"start": 1140.61, "end": 1140.89, "text": "在!"}, {"start": 1141.37, "end": 1142.57, "text": "须须进城!"}, {"start": 1143.41, "end": 1143.69, "text": "去吧!"}, {"start": 1143.69, "end": 1143.97, "text": "遵命!"}, {"start": 1144.29, "end": 1144.73, "text": "进城!"}, {"start": 1194.24, "end": 1195.2, "text": "我带你们不保,"}, {"start": 1195.4, "end": 1196.32, "text": "为何出卖我?"}, {"start": 1196.8, "end": 1197.2, "text": "吕布!"}, {"start": 1197.76, "end": 1198.6, "text": "你有吃兔马?"}, {"start": 1199.12, "end": 1200.24, "text": "渡水如履平地!"}, {"start": 1201.12, "end": 1202.4, "text": "你还有美妾貂蝉?"}, {"start": 1203.2, "end": 1204.4, "text": "你视它众与三军!"}, {"start": 1205.0, "end": 1205.96, "text": "为将如此,"}, {"start": 1206.44, "end": 1208.52, "text": "竟然还敢说带我们不保!"}, {"start": 1209.0, "end": 1218.27, "text": "帮得太近,"}, {"start": 1219.07, "end": 1219.91, "text": "松一下好吗?"}, {"start": 1239.73, "end": 1240.29, "text": "冯夕,"}, {"start": 1241.57, "end": 1243.09, "text": "你是一只猛虎啊!"}, {"start": 1243.81, "end": 1244.45, "text": "绑虎,"}, {"start": 1245.49, "end": 1246.25, "text": "能不紧吗?"}, {"start": 1255.94, "end": 1257.3, "text": "我说过的话有很多,"}, {"start": 1257.3, "end": 1258.78, "text": "不知道你问的是哪一句?"}, {"start": 1261.05, "end": 1262.05, "text": "最怕的人是我!"}, {"start": 1262.57, "end": 1263.65, "text": "最敬的人也是我!"}, {"start": 1264.65, "end": 1266.29, "text": "你我做你的三军大元帅,"}, {"start": 1266.93, "end": 1267.93, "text": "为你横扫天下,"}, {"start": 1267.93, "end": 1268.85, "text": "共创大业!"}, {"start": 1273.92, "end": 1274.48, "text": "在下,"}, {"start": 1274.64, "end": 1277.51, "text": "你做你的三军大元帅!"}, {"start": 1280.1, "end": 1281.26, "text": "我确实说过这话,"}, {"start": 1282.26, "end": 1283.74, "text": "但我说这个话的时候,"}, {"start": 1284.06, "end": 1285.1, "text": "是你在城上,"}, {"start": 1285.1, "end": 1285.98, "text": "我在城下,"}, {"start": 1286.5, "end": 1288.22, "text": "我不能不跟你共创大业!"}, {"start": 1288.86, "end": 1289.66, "text": "但是现在,"}, {"start": 1290.34, "end": 1290.9, "text": "你看看你!"}, {"start": 1291.7, "end": 1292.7, "text": "接下之求,"}, {"start": 1292.7, "end": 1293.98, "text": "你怎么跟我共创大业?"}, {"start": 1294.62, "end": 1298.26, "text": "如此简单的道理,"}, {"start": 1299.06, "end": 1299.86, "text": "你都不懂吗?"}, {"start": 1304.0, "end": 1304.8, "text": "玄德贤弟,"}, {"start": 1305.04, "end": 1316.48, "text": "还记得原本社稷吗?"}, {"start": 1319.04, "end": 1319.64, "text": "记得,"}, {"start": 1326.82, "end": 1327.98, "text": "奉先此恩,"}, {"start": 1328.3, "end": 1329.54, "text": "在下永生不忘!"}, {"start": 1330.82, "end": 1332.14, "text": "那你还不开遵口!"}, {"start": 1332.62, "end": 1333.9, "text": "快帮我求求曹操!"}, {"start": 1335.66, "end": 1337.87, "text": "遵命!"}, {"start": 1338.27, "end": 1341.63, "text": "禀曹公,"}, {"start": 1342.27, "end": 1348.91, "text": "在下有一事相求!"}, {"start": 1349.19, "end": 1350.19, "text": "无论何事,"}, {"start": 1350.43, "end": 1352.9, "text": "但说无妨!"}, {"start": 1353.5, "end": 1355.46, "text": "吕布曾经拜过三位义父,"}, {"start": 1357.22, "end": 1358.5, "text": "其一是丁元,"}, {"start": 1359.1, "end": 1360.5, "text": "其二是董卓,"}, {"start": 1360.78, "end": 1361.98, "text": "其三是王允,"}, {"start": 1362.54, "end": 1363.74, "text": "这三位义父,"}, {"start": 1363.98, "end": 1365.46, "text": "都托福吕布不浅!"}, {"start": 1366.58, "end": 1368.06, "text": "今日恳请曹公,"}, {"start": 1368.58, "end": 1369.98, "text": "收吕布为义子,"}, {"start": 1370.74, "end": 1372.38, "text": "做他的第四位义父!"}, {"start": 1375.34, "end": 1376.1, "text": "听见了吧?"}, {"start": 1381.33, "end": 1385.07, "text": "吕布是吕布的义父!"}, {"start": 1385.55, "end": 1390.32, "text": "吕布是吕布的义父!"}, {"start": 1391.24, "end": 1391.72, "text": "啊?"}, {"start": 1393.04, "end": 1393.72, "text": "谁?"}, {"start": 1395.12, "end": 1396.6, "text": "做吕布的义父,"}, {"start": 1397.04, "end": 1399.12, "text": "谁就不得好死?"}, {"start": 1403.2, "end": 1403.88, "text": "大尔贼!"}, {"start": 1404.68, "end": 1405.88, "text": "你忘恩负义!"}, {"start": 1415.22, "end": 1415.94, "text": "吕奉先,"}, {"start": 1417.34, "end": 1419.06, "text": "你也知恩义二字吗?"}, {"start": 1421.09, "end": 1422.85, "text": "早先我让徐州与你,"}, {"start": 1424.29, "end": 1426.21, "text": "就是盼望你知恩知义,"}, {"start": 1427.49, "end": 1428.97, "text": "可是你非但不容我,"}, {"start": 1429.57, "end": 1430.97, "text": "还屡屡攻杀我,"}, {"start": 1431.77, "end": 1433.25, "text": "你懂什么叫恩义吗?"}, {"start": 1434.53, "end": 1435.65, "text": "若你我联手,"}, {"start": 1436.65, "end": 1438.13, "text": "你岂有今日之祸?"}, {"start": 1451.85, "end": 1452.37, "text": "押下!"}, {"start": 1453.05, "end": 1453.57, "text": "走!"}, {"start": 1453.89, "end": 1457.8, "text": "走!"}, {"start": 1460.86, "end": 1462.78, "text": "大仗务断头不可断致,"}, {"start": 1462.98, "end": 1464.46, "text": "你何居之有啊?"}, {"start": 1464.46, "end": 1464.78, "text": "走!"}, {"start": 1467.98, "end": 1468.9, "text": "此人是谁?"}, {"start": 1470.22, "end": 1470.66, "text": "主公,"}, {"start": 1471.5, "end": 1473.54, "text": "他就是吕布手下第一勇将,"}, {"start": 1473.82, "end": 1474.62, "text": "姓张明辽,"}, {"start": 1474.9, "end": 1475.46, "text": "自闻元,"}, {"start": 1477.26, "end": 1477.98, "text": "跪下!"}, {"start": 1478.42, "end": 1478.82, "text": "跪下!"}, {"start": 1483.55, "end": 1484.27, "text": "张辽,"}, {"start": 1485.59, "end": 1486.95, "text": "张闻元,"}, {"start": 1528.36, "end": 1529.28, "text": "你这是为何?"}, {"start": 1540.5, "end": 1541.3, "text": "说话呀!"}, {"start": 1544.17, "end": 1544.89, "text": "闻元,"}, {"start": 1546.05, "end": 1547.21, "text": "你是个真英雄,"}, {"start": 1548.33, "end": 1551.37, "text": "我有心想留你为我建功立业,"}, {"start": 1552.25, "end": 1553.61, "text": "但是我怕你骂我,"}, {"start": 1554.77, "end": 1557.21, "text": "所以你走吧!"}, {"start": 1566.1, "end": 1566.54, "text": "走吧!"}, {"start": 1587.97, "end": 1588.53, "text": "将军,"}, {"start": 1591.13, "end": 1593.61, "text": "在下愿为将军效命,"}, {"start": 1593.97, "end": 1604.0, "text": "我等的就是你这句话!"}, {"start": 1606.8, "end": 1607.2, "text": "主公!"}, {"start": 1623.46, "end": 1624.02, "text": "宣德,"}, {"start": 1624.7, "end": 1625.62, "text": "看看谁来了?"}, {"start": 1626.14, "end": 1626.54, "text": "来了!"}, {"start": 1633.55, "end": 1633.91, "text": "坐!"}, {"start": 1637.96, "end": 1638.6, "text": "龚太兄,"}, {"start": 1640.28, "end": 1641.8, "text": "钟某县相救之情,"}, {"start": 1642.08, "end": 1644.24, "text": "曹某感恩于心,"}, {"start": 1645.88, "end": 1647.84, "text": "曹孟德也长得一颗心,"}, {"start": 1651.5, "end": 1652.58, "text": "我真是后悔呀,"}, {"start": 1654.3, "end": 1656.06, "text": "当年成稿县那天夜里,"}, {"start": 1657.46, "end": 1659.58, "text": "我就该将你一箭穿心,"}, {"start": 1659.7, "end": 1660.34, "text": "理解,"}, {"start": 1661.3, "end": 1662.1, "text": "完全理解,"}, {"start": 1663.1, "end": 1664.5, "text": "连我都替你后悔,"}, {"start": 1665.9, "end": 1667.26, "text": "可奸诈小人,"}, {"start": 1669.66, "end": 1670.78, "text": "无耻之徒!"}, {"start": 1672.78, "end": 1673.94, "text": "龚太兄,"}, {"start": 1674.58, "end": 1677.02, "text": "我又一世不能理解,"}, {"start": 1678.46, "end": 1680.74, "text": "你既然欲图大业为何不来找我,"}, {"start": 1680.9, "end": 1682.14, "text": "而去找了吕布,"}, {"start": 1682.66, "end": 1685.34, "text": "他配不上你的才华和抱负,"}, {"start": 1685.74, "end": 1686.82, "text": "不会有今天,"}, {"start": 1687.66, "end": 1697.37, "text": "吕布虽然无知人,"}, {"start": 1698.17, "end": 1701.29, "text": "但是为人要比你干净得多,"}, {"start": 1702.13, "end": 1702.85, "text": "是干净,"}, {"start": 1703.33, "end": 1704.77, "text": "干净得像个傻子,"}, {"start": 1707.01, "end": 1708.05, "text": "龚太兄啊,"}, {"start": 1708.81, "end": 1711.41, "text": "我还有一件事想请你赐教,"}, {"start": 1712.01, "end": 1712.57, "text": "说吧,"}, {"start": 1713.05, "end": 1716.01, "text": "你说我是应该杀你呢?"}, {"start": 1716.61, "end": 1717.29, "text": "江浩白,"}, {"start": 1718.49, "end": 1722.82, "text": "快快杀我,"}, {"start": 1723.14, "end": 1723.94, "text": "真的舍不得?"}, {"start": 1723.94, "end": 1725.3, "text": "那我就给你个理由,"}, {"start": 1732.74, "end": 1736.4, "text": "让你舍得杀我,"}, {"start": 1736.84, "end": 1739.0, "text": "只要我成功一天不死,"}, {"start": 1739.48, "end": 1741.88, "text": "我会当年那些丑事挂在嘴边,"}, {"start": 1742.36, "end": 1744.24, "text": "我会天天讲日日说,"}, {"start": 1744.76, "end": 1749.14, "text": "我让世人借民皆知,"}, {"start": 1749.66, "end": 1751.5, "text": "让你一丑万年,"}, {"start": 1753.1, "end": 1754.54, "text": "大家伙都听着,"}, {"start": 1755.5, "end": 1758.46, "text": "当年曹孟德在成岗县逃亡的时候,"}, {"start": 1765.94, "end": 1768.14, "text": "被他的伯父吕波舍所救,"}, {"start": 1769.06, "end": 1771.06, "text": "可是他却恩恨不得,"}, {"start": 1772.06, "end": 1774.06, "text": "他就不想再逃亡了,"}, {"start": 1774.66, "end": 1776.46, "text": "可是他却恩将仇报,"}, {"start": 1776.66, "end": 1777.86, "text": "杀了吕波舍,"}, {"start": 1778.46, "end": 1780.46, "text": "这些都是我亲眼所见,"}, {"start": 1780.98, "end": 1782.58, "text": "他恩将仇报啊,"}, {"start": 1782.86, "end": 1784.58, "text": "杀了自家的伯父,"}, {"start": 1785.06, "end": 1786.98, "text": "他就是个奸诈小人,"}, {"start": 1787.1, "end": 1788.54, "text": "无耻之徒啊,"}, {"start": 1788.54, "end": 1789.06, "text": "来人,"}, {"start": 1789.06, "end": 1789.46, "text": "在,"}, {"start": 1789.58, "end": 1790.14, "text": "拉下去,"}, {"start": 1790.3, "end": 1790.86, "text": "快拉下去,"}, {"start": 1790.86, "end": 1791.18, "text": "诺,"}, {"start": 1791.18, "end": 1791.46, "text": "诺,"}, {"start": 1791.46, "end": 1792.3, "text": "放肆,"}, {"start": 1796.82, "end": 1798.26, "text": "龚太兄是何人哪,"}, {"start": 1800.99, "end": 1802.23, "text": "那是我的救命恩人,"}, {"start": 1803.19, "end": 1804.23, "text": "骂我两句怎么了,"}, {"start": 1805.03, "end": 1806.55, "text": "又掉不了一根汗毛,"}, {"start": 1807.71, "end": 1808.47, "text": "再说,"}, {"start": 1808.87, "end": 1809.95, "text": "龚太兄说的,"}, {"start": 1810.55, "end": 1811.15, "text": "有道理,"}, {"start": 1812.27, "end": 1812.87, "text": "骂得对,"}, {"start": 1814.47, "end": 1814.87, "text": "骂,"}, {"start": 1816.27, "end": 1816.87, "text": "接着骂,"}, {"start": 1817.99, "end": 1818.87, "text": "骂痛快了,"}, {"start": 1819.23, "end": 1819.95, "text": "咱们喝酒,"}, {"start": 1825.04, "end": 1826.28, "text": "曹孟德呀,"}, {"start": 1827.44, "end": 1828.56, "text": "我真没想到,"}, {"start": 1829.12, "end": 1830.68, "text": "你竟然如此疲厚,"}, {"start": 1844.66, "end": 1845.42, "text": "并非我,"}, {"start": 1846.02, "end": 1847.02, "text": "曹操疲厚,"}, {"start": 1849.94, "end": 1851.46, "text": "而是我把这世上,"}, {"start": 1851.9, "end": 1854.14, "text": "那些忠俗不堪的刚昌伦理,"}, {"start": 1854.5, "end": 1855.18, "text": "早已经,"}, {"start": 1855.86, "end": 1856.94, "text": "不放在心上了,"}, {"start": 1857.58, "end": 1859.18, "text": "世人都说我是奸雄,"}, {"start": 1859.98, "end": 1861.26, "text": "可又都拿我这个奸雄,"}, {"start": 1861.26, "end": 1862.02, "text": "莫可奈何,"}, {"start": 1862.78, "end": 1863.54, "text": "你们这些,"}, {"start": 1864.06, "end": 1865.58, "text": "自许为君子的人,"}, {"start": 1866.14, "end": 1868.14, "text": "也都败在了我这个奸雄手里,"}, {"start": 1868.5, "end": 1870.34, "text": "如果当君子的代价就是,"}, {"start": 1870.82, "end": 1871.38, "text": "被凌辱,"}, {"start": 1872.18, "end": 1872.78, "text": "被践踏,"}, {"start": 1873.46, "end": 1875.02, "text": "被消灭甚至被杀的话,"}, {"start": 1876.06, "end": 1877.22, "text": "我宁愿当一个,"}, {"start": 1877.78, "end": 1879.54, "text": "能够实现自己报复的,"}, {"start": 1879.98, "end": 1880.5, "text": "奸雄,"}, {"start": 1882.02, "end": 1882.78, "text": "自古以来,"}, {"start": 1884.3, "end": 1885.26, "text": "大奸死忠,"}, {"start": 1886.58, "end": 1887.5, "text": "大为死针,"}, {"start": 1888.22, "end": 1889.46, "text": "忠义和奸恶,"}, {"start": 1890.18, "end": 1892.9, "text": "都不是能够从表面就能看得出来的,"}, {"start": 1893.74, "end": 1894.9, "text": "也许你们从前,"}, {"start": 1895.9, "end": 1897.06, "text": "错看了我曹操,"}, {"start": 1898.06, "end": 1899.66, "text": "现在又看错了,"}, {"start": 1900.34, "end": 1901.06, "text": "可是我,"}, {"start": 1901.38, "end": 1902.26, "text": "仍然是我,"}, {"start": 1902.94, "end": 1904.34, "text": "我从来都不怕别人,"}, {"start": 1904.74, "end": 1905.34, "text": "错看我,"}, {"start": 1906.02, "end": 1906.62, "text": "弓太兄,"}, {"start": 1907.82, "end": 1908.78, "text": "平心而论,"}, {"start": 1910.06, "end": 1911.3, "text": "你觉得我说的对吗?"}, {"start": 1915.61, "end": 1916.57, "text": "什么也别说了,"}, {"start": 1918.58, "end": 1919.26, "text": "赶快上酒吧,"}, {"start": 1924.51, "end": 1924.91, "text": "小酒,"}, {"start": 1947.83, "end": 1948.99, "text": "刀斧手何在,"}, {"start": 1950.03, "end": 1950.79, "text": "快送我,"}, {"start": 1951.15, "end": 1952.07, "text": "成功上路,"}, {"start": 1952.43, "end": 1967.53, "text": "容我,"}, {"start": 1970.18, "end": 1971.5, "text": "送你最后一程,"}, {"start": 1971.58, "end": 2016.25, "text": "与将军同行,"}, {"start": 2016.41, "end": 2017.33, "text": "与我同行,"}, {"start": 2021.98, "end": 2022.94, "text": "难道你没有看到,"}, {"start": 2023.22, "end": 2048.05, "text": "与同死,"}, {"start": 2048.37, "end": 2054.88, "text": "你的心意我明白,"}, {"start": 2055.24, "end": 2059.03, "text": "我李伯要你这句话,"}, {"start": 2059.03, "end": 2067.54, "text": "但你万万不可如此,"}, {"start": 2067.54, "end": 2074.52, "text": "快走啊,"}, {"start": 2074.88, "end": 2084.14, "text": "展金天穿的,"}, {"start": 2086.1, "end": 2088.14, "text": "是将军最敬仰的妥当,"}, {"start": 2090.55, "end": 2092.03, "text": "就让平妾披着它,"}, {"start": 2092.95, "end": 2093.67, "text": "和将军,"}, {"start": 2095.07, "end": 2096.55, "text": "共赴九泉吧,"}, {"start": 2096.99, "end": 2100.43, "text": "天地之间梦,"}, {"start": 2278.77, "end": 2280.21, "text": "家中还有七世老母,"}, {"start": 2281.89, "end": 2283.05, "text": "你若死了,"}, {"start": 2283.97, "end": 2284.77, "text": "她怎么办,"}, {"start": 2285.65, "end": 2286.57, "text": "你舍得下吗?"}, {"start": 2289.91, "end": 2291.11, "text": "我陈功文,"}, {"start": 2293.16, "end": 2294.68, "text": "仁孝之君,"}, {"start": 2295.12, "end": 2296.28, "text": "依法诛罪,"}, {"start": 2297.2, "end": 2298.2, "text": "不会罪及父母,"}, {"start": 2299.84, "end": 2301.32, "text": "我谅你曹孟德,"}, {"start": 2301.4, "end": 2302.72, "text": "也不会杀我老母,"}, {"start": 2304.04, "end": 2304.84, "text": "反而会,"}, {"start": 2305.32, "end": 2306.48, "text": "供她钱粮,"}, {"start": 2306.76, "end": 2307.96, "text": "养其终生,"}, {"start": 2308.68, "end": 2309.4, "text": "不错,"}, {"start": 2315.85, "end": 2316.85, "text": "我还知道,"}, {"start": 2316.85, "end": 2318.37, "text": "你家中有两个娃儿,"}, {"start": 2319.25, "end": 2320.25, "text": "一娃儿七岁,"}, {"start": 2320.25, "end": 2321.17, "text": "还娃儿五岁,"}, {"start": 2322.49, "end": 2323.57, "text": "她们还小,"}, {"start": 2324.13, "end": 2325.17, "text": "你若走了,"}, {"start": 2325.77, "end": 2326.77, "text": "她们怎么办,"}, {"start": 2326.77, "end": 2327.73, "text": "你舍得下吗?"}, {"start": 2329.09, "end": 2330.33, "text": "我儿我女,"}, {"start": 2331.25, "end": 2333.65, "text": "自然会参风引路,"}, {"start": 2333.65, "end": 2335.45, "text": "顺天应命,"}, {"start": 2335.45, "end": 2340.45, "text": "就不劳孟德操心了,"}, {"start": 2340.65, "end": 2369.41, "text": "宫太兄,"}, {"start": 2370.61, "end": 2371.97, "text": "我从来都不求人,"}, {"start": 2372.61, "end": 2373.61, "text": "但是今天,"}, {"start": 2373.93, "end": 2380.82, "text": "我是真的舍不得你,"}, {"start": 2383.35, "end": 2384.55, "text": "这个我知道,"}, {"start": 2386.56, "end": 2388.12, "text": "但需许我自己,"}, {"start": 2388.12, "end": 2389.28, "text": "真真的要走,"}, {"start": 2391.51, "end": 2392.31, "text": "还请孟德,"}, {"start": 2394.74, "end": 2395.78, "text": "随我心愿吧,"}, {"start": 2396.14, "end": 2437.94, "text": "老沙河,"}, {"start": 2437.94, "end": 2439.02, "text": "我怎么会流泪?"}]