[{"start": 18.77, "end": 20.77, "text": "我渴了,去,我打过球。"}, {"start": 20.77, "end": 21.77, "text": "好的。"}, {"start": 21.77, "end": 26.51, "text": "来,我去打。"}, {"start": 26.51, "end": 33.09, "text": "刘皇叔,你怎么在这儿?"}, {"start": 33.09, "end": 36.43, "text": "大哥听说了先生的事,"}, {"start": 36.43, "end": 39.43, "text": "急迟了一夜,天亮前就赶到这里了。"}, {"start": 39.43, "end": 41.43, "text": "你这个家伙只顾着死睡,"}, {"start": 41.43, "end": 46.41, "text": "害得我大哥在这儿等。"}, {"start": 46.41, "end": 48.41, "text": "先生,你喜欢喝什么酒?"}, {"start": 48.41, "end": 50.41, "text": "杏花村。"}, {"start": 50.41, "end": 52.41, "text": "好,我这就给你打来。"}, {"start": 52.41, "end": 57.74, "text": "禀主公,夫人派我来给你送信,"}, {"start": 57.74, "end": 60.74, "text": "说阿斗已经昏迷不醒,请主公快快回去。"}, {"start": 60.74, "end": 65.36, "text": "你回去禀告夫人,"}, {"start": 65.36, "end": 67.36, "text": "就说我还有公事,让他好生照应阿斗。"}, {"start": 67.36, "end": 69.36, "text": "遵命。"}, {"start": 69.36, "end": 71.36, "text": "大哥,你可就剩下这点骨血了,"}, {"start": 71.36, "end": 73.36, "text": "快回去吧。"}, {"start": 73.36, "end": 77.06, "text": "先前我已经对不住龙先生了,"}, {"start": 77.06, "end": 79.06, "text": "现在他想喝酒,"}, {"start": 79.06, "end": 81.06, "text": "我若能帮他打来,"}, {"start": 81.06, "end": 83.06, "text": "也可以让我心安一些。"}, {"start": 106.66, "end": 108.66, "text": "先生,酒来了。"}, {"start": 108.66, "end": 122.43, "text": "刘皇叔,"}, {"start": 122.43, "end": 124.43, "text": "你以为一壶酒,"}, {"start": 124.43, "end": 126.43, "text": "就可以收下一颗已经被你伤过的心吗?"}, {"start": 126.43, "end": 128.43, "text": "龙广去意已决,"}, {"start": 128.43, "end": 130.43, "text": "你就是强留下我,"}, {"start": 130.43, "end": 132.43, "text": "我也不会为你效力的。"}, {"start": 132.43, "end": 137.63, "text": "这只怪我刘备有眼无珠,"}, {"start": 137.63, "end": 139.63, "text": "先生一定要走,"}, {"start": 139.63, "end": 141.63, "text": "那我有什么理由阻拦呢?"}, {"start": 141.63, "end": 143.63, "text": "来,我送先生一张。"}, {"start": 145.63, "end": 179.6, "text": "先生,"}, {"start": 179.6, "end": 183.9, "text": "我刘备,"}, {"start": 183.9, "end": 185.9, "text": "是个没钱的周目,"}, {"start": 185.9, "end": 187.9, "text": "赤贫的皇叔,"}, {"start": 187.9, "end": 189.9, "text": "虽然心爱先生之才,"}, {"start": 189.9, "end": 191.9, "text": "却没什么珍贵的东西可以送你。"}, {"start": 191.9, "end": 193.9, "text": "这样,"}, {"start": 193.9, "end": 195.9, "text": "这匹狄鲁,"}, {"start": 195.9, "end": 197.9, "text": "是我的爱居,"}, {"start": 197.9, "end": 199.9, "text": "也算得上是一匹良马,"}, {"start": 199.9, "end": 201.9, "text": "就赠与先生上路吧。"}, {"start": 201.9, "end": 207.68, "text": "听着,"}, {"start": 207.68, "end": 209.68, "text": "这马名字叫狄鲁,"}, {"start": 209.68, "end": 211.68, "text": "它可曾救过咱大哥的性命。"}, {"start": 211.68, "end": 217.14, "text": "这还真是匹好马。"}, {"start": 217.14, "end": 219.14, "text": "那,"}, {"start": 219.14, "end": 221.14, "text": "在下恭敬不如从命了。"}, {"start": 221.14, "end": 223.14, "text": "先生请上吧。"}, {"start": 230.38, "end": 232.38, "text": "这狄鲁太高了,"}, {"start": 232.38, "end": 234.38, "text": "能不能帮帮忙?"}, {"start": 234.38, "end": 236.38, "text": "三弟,扶先生上马。"}, {"start": 236.38, "end": 238.38, "text": "好,"}, {"start": 238.38, "end": 256.96, "text": "先生请。"}, {"start": 256.96, "end": 258.96, "text": "像他这种人,"}, {"start": 258.96, "end": 260.96, "text": "不可落入别人手中。"}, {"start": 260.96, "end": 262.96, "text": "既然不能为我所用,"}, {"start": 262.96, "end": 264.96, "text": "干脆让我杀了他。"}, {"start": 264.96, "end": 275.47, "text": "你出后患。"}, {"start": 275.47, "end": 283.84, "text": "休得胡言。"}, {"start": 283.84, "end": 285.84, "text": "把剑收起来。"}, {"start": 285.84, "end": 287.84, "text": "虽然我不能留住此人,"}, {"start": 287.84, "end": 289.84, "text": "但我还是希望他能够找到一个比我更强的人,"}, {"start": 289.84, "end": 293.18, "text": "一展才华,"}, {"start": 293.18, "end": 295.18, "text": "除贼复害。"}, {"start": 295.18, "end": 297.18, "text": "我一定会记住我今天犯的过失。"}, {"start": 297.18, "end": 299.18, "text": "先生别再犹豫了,"}, {"start": 299.18, "end": 316.67, "text": "走吧。"}, {"start": 316.67, "end": 320.4, "text": "先生怎么不走了?"}, {"start": 320.4, "end": 322.4, "text": "这马,"}, {"start": 322.4, "end": 324.4, "text": "它不听使喚,"}, {"start": 324.4, "end": 326.4, "text": "可能太流量它的主人了。"}, {"start": 326.4, "end": 328.4, "text": "走着走着,"}, {"start": 328.4, "end": 330.4, "text": "它自个儿往回奔,"}, {"start": 330.4, "end": 334.29, "text": "我还是把它还给你吧。"}, {"start": 334.29, "end": 337.54, "text": "那先生你怎么走呢?"}, {"start": 337.54, "end": 339.54, "text": "我用那匹,可以吧?"}, {"start": 339.54, "end": 351.39, "text": "当然可以。"}, {"start": 351.39, "end": 353.39, "text": "主公,你还愣着干什么?"}, {"start": 353.39, "end": 361.73, "text": "回荆州啊。"}, {"start": 361.73, "end": 363.73, "text": "你叫我什么?"}, {"start": 363.73, "end": 367.3, "text": "叫我主公。"}, {"start": 367.3, "end": 369.3, "text": "主公,"}, {"start": 369.3, "end": 371.3, "text": "龙广这一辈子就想找一个"}, {"start": 371.3, "end": 373.3, "text": "真正能识千里马的英主。"}, {"start": 373.3, "end": 375.3, "text": "今天终于找到了。"}, {"start": 375.3, "end": 377.3, "text": "龙广愿意跟随主公"}, {"start": 377.3, "end": 379.3, "text": "回荆州,"}, {"start": 379.3, "end": 381.3, "text": "跟随主公东征西逃,"}, {"start": 381.3, "end": 383.3, "text": "助主公成就功名大业。"}, {"start": 383.3, "end": 391.02, "text": "来来来,"}, {"start": 391.02, "end": 393.02, "text": "快快快,"}, {"start": 393.02, "end": 395.02, "text": "等我来。"}, {"start": 395.02, "end": 397.02, "text": "我帮你引荐一位大才。"}, {"start": 397.02, "end": 399.02, "text": "好。"}, {"start": 399.02, "end": 401.02, "text": "龙先生,"}, {"start": 401.02, "end": 403.02, "text": "龙先生,孔明巡视四郡回来了。"}, {"start": 403.02, "end": 405.02, "text": "来来来,我介绍给你认识。"}, {"start": 405.02, "end": 407.02, "text": "庞士元?"}, {"start": 407.02, "end": 409.02, "text": "孔明?"}, {"start": 411.02, "end": 413.02, "text": "你是庞统庞士元?"}, {"start": 413.02, "end": 415.02, "text": "原来龙先生"}, {"start": 415.02, "end": 417.02, "text": "就是凤雏先生。"}, {"start": 417.02, "end": 419.02, "text": "士元,你到荆州"}, {"start": 419.02, "end": 421.02, "text": "怎么不和我说一声?"}, {"start": 421.02, "end": 423.02, "text": "我一直在找你呢。"}, {"start": 423.02, "end": 425.02, "text": "原来他是考我呀。"}, {"start": 427.02, "end": 429.02, "text": "请主公恕我"}, {"start": 429.02, "end": 431.02, "text": "欺君之罪。"}, {"start": 431.02, "end": 434.27, "text": "何罪之有啊?"}, {"start": 434.27, "end": 436.27, "text": "昔日,"}, {"start": 436.27, "end": 438.27, "text": "水晶先生就说过,"}, {"start": 438.27, "end": 440.27, "text": "卧龙凤雏,"}, {"start": 440.27, "end": 442.27, "text": "两人得一便可安天下。"}, {"start": 442.27, "end": 444.27, "text": "而如今,我二人皆得,"}, {"start": 444.27, "end": 446.27, "text": "汉氏定可忠心啊。"}, {"start": 446.27, "end": 448.27, "text": "先生,"}, {"start": 448.27, "end": 450.27, "text": "听说你也喜欢喝酒啊。"}, {"start": 450.27, "end": 452.27, "text": "我也喜欢得很啊。"}, {"start": 452.27, "end": 454.27, "text": "今日定要饮上三百杯啊。"}, {"start": 454.27, "end": 456.27, "text": "好好好。"}, {"start": 456.27, "end": 458.27, "text": "等我看完这幅地图,咱们再饮。"}, {"start": 458.27, "end": 462.32, "text": "先生,这是看什么呢?"}, {"start": 462.32, "end": 473.28, "text": "西川。"}, {"start": 473.28, "end": 475.28, "text": "三弟啊,辛苦了。"}, {"start": 475.28, "end": 477.28, "text": "这几个月,你征讨误换。"}, {"start": 477.28, "end": 479.28, "text": "我心里真是为你担心啊。"}, {"start": 479.28, "end": 481.28, "text": "好在我们张帝所向披靡。"}, {"start": 481.28, "end": 483.28, "text": "捷保平川。"}, {"start": 485.28, "end": 487.28, "text": "我跟父亲真是为你高兴啊。"}, {"start": 487.28, "end": 489.28, "text": "二哥,父亲"}, {"start": 489.28, "end": 491.28, "text": "突然召我回来,不知为何事啊。"}, {"start": 491.28, "end": 493.28, "text": "这铜雀台要完工了。"}, {"start": 493.28, "end": 495.28, "text": "来,三弟。"}, {"start": 495.28, "end": 497.28, "text": "这可是件盛事啊。"}, {"start": 497.28, "end": 499.28, "text": "父亲就把朱弟都招来了。"}, {"start": 499.28, "end": 501.28, "text": "大眼宾客嘛。"}, {"start": 501.28, "end": 503.28, "text": "原来是这么回事。"}, {"start": 503.28, "end": 505.28, "text": "那,这值得找我回来吗?"}, {"start": 505.28, "end": 507.28, "text": "其实啊,这就是个油头。"}, {"start": 507.28, "end": 509.28, "text": "乌桓之乱已平。"}, {"start": 509.28, "end": 511.28, "text": "父亲心里面"}, {"start": 511.28, "end": 513.28, "text": "能不挂念你吗?"}, {"start": 513.28, "end": 515.28, "text": "自然是想让你"}, {"start": 515.28, "end": 517.28, "text": "早些回到他的身边嘛。"}, {"start": 517.28, "end": 519.28, "text": "好。"}, {"start": 519.28, "end": 521.28, "text": "高典沙。"}, {"start": 521.28, "end": 523.28, "text": "四弟。"}, {"start": 523.28, "end": 525.28, "text": "四弟。"}, {"start": 525.28, "end": 527.28, "text": "见过二公子、三公子。"}, {"start": 527.28, "end": 529.28, "text": "杨兄,四弟这是怎么了?"}, {"start": 529.28, "end": 531.28, "text": "今天啊,四公子跟城内的几位"}, {"start": 531.28, "end": 533.28, "text": "临时相聚,把酒作附。"}, {"start": 533.28, "end": 535.28, "text": "这一时兴起啊,便多喝了几杯。"}, {"start": 535.28, "end": 537.28, "text": "四弟,嘴都不清了。"}, {"start": 537.28, "end": 539.28, "text": "快快快,进屋将信,快。"}, {"start": 539.28, "end": 541.28, "text": "青江。"}, {"start": 543.28, "end": 545.28, "text": "行,走,游。"}, {"start": 545.28, "end": 547.28, "text": "我们游。"}, {"start": 547.28, "end": 549.28, "text": "小心,慢点,慢点啊。"}, {"start": 549.28, "end": 551.28, "text": "中储,半风扇。"}, {"start": 551.28, "end": 553.28, "text": "是是是。"}, {"start": 553.28, "end": 555.28, "text": "去拿水。"}, {"start": 555.28, "end": 557.28, "text": "青江。"}, {"start": 557.28, "end": 559.28, "text": "公子小心啊。"}, {"start": 559.28, "end": 562.78, "text": "快,快躺下。"}, {"start": 562.78, "end": 566.74, "text": "中储。"}, {"start": 566.74, "end": 568.74, "text": "半风扇。"}, {"start": 570.74, "end": 572.74, "text": "争一争呀。"}, {"start": 572.74, "end": 574.74, "text": "宰肥牛。"}, {"start": 576.74, "end": 580.24, "text": "见毒。"}, {"start": 580.24, "end": 582.24, "text": "脸都不会擦啊。"}, {"start": 582.24, "end": 584.24, "text": "四弟,不斗武力。"}, {"start": 584.24, "end": 592.03, "text": "三弟。"}, {"start": 594.03, "end": 596.03, "text": "二哥。"}, {"start": 596.03, "end": 598.03, "text": "四弟。"}, {"start": 598.03, "end": 600.03, "text": "二哥。"}, {"start": 600.03, "end": 602.03, "text": "我刚才把你。"}, {"start": 602.03, "end": 604.03, "text": "我把你当。"}, {"start": 606.03, "end": 608.03, "text": "四弟。"}, {"start": 615.22, "end": 617.22, "text": "当成吓人了。"}, {"start": 621.22, "end": 632.08, "text": "众大先生。"}, {"start": 632.08, "end": 636.93, "text": "你有何事?"}, {"start": 636.93, "end": 638.93, "text": "丞相让我禀告三位公子。"}, {"start": 638.93, "end": 640.93, "text": "铜雀台之会。"}, {"start": 640.93, "end": 642.93, "text": "定在明天辰时开始。"}, {"start": 642.93, "end": 644.93, "text": "知道了。"}, {"start": 644.93, "end": 649.55, "text": "众大先生。"}, {"start": 649.55, "end": 651.55, "text": "你请留步。"}, {"start": 651.55, "end": 657.01, "text": "二公子有何吩咐?"}, {"start": 657.01, "end": 659.01, "text": "既然是宴会。"}, {"start": 659.01, "end": 661.01, "text": "为何要辰时啊?"}, {"start": 661.01, "end": 663.01, "text": "这也太早了吧。"}, {"start": 663.01, "end": 665.01, "text": "二公子问得好。"}, {"start": 665.01, "end": 667.01, "text": "据在下所知啊。"}, {"start": 667.01, "end": 669.01, "text": "除了宴会。"}, {"start": 669.01, "end": 671.01, "text": "丞相还有别的安排。"}, {"start": 671.01, "end": 673.01, "text": "武将比射。"}, {"start": 673.01, "end": 675.01, "text": "文臣比副。"}, {"start": 677.01, "end": 679.01, "text": "三公子。"}, {"start": 679.01, "end": 681.01, "text": "可要备足强攻力荐啊。"}, {"start": 681.01, "end": 683.01, "text": "多谢主部大人相告。"}, {"start": 683.01, "end": 685.01, "text": "至于文臣比副的题目啊。"}, {"start": 689.54, "end": 691.54, "text": "二公子。"}, {"start": 691.54, "end": 694.98, "text": "四公子。"}, {"start": 694.98, "end": 696.98, "text": "想知道吗?"}, {"start": 696.98, "end": 702.56, "text": "司法爷。"}, {"start": 702.56, "end": 704.56, "text": "你要解题吗?"}, {"start": 704.56, "end": 706.56, "text": "活人给死人当宾客。"}, {"start": 706.56, "end": 708.56, "text": "一定是耐不住寂寞。"}, {"start": 708.56, "end": 710.56, "text": "四爷。"}, {"start": 710.56, "end": 712.56, "text": "背着主子讨好我们是吗?"}, {"start": 712.56, "end": 714.56, "text": "既是考试。"}, {"start": 714.56, "end": 718.13, "text": "就该展现真才实学才是。"}, {"start": 718.13, "end": 720.13, "text": "给我出去。"}, {"start": 720.13, "end": 722.13, "text": "我绝不听你的。"}, {"start": 722.13, "end": 725.7, "text": "四公子指教的是。"}, {"start": 725.7, "end": 727.7, "text": "众大先生。"}, {"start": 727.7, "end": 729.7, "text": "二哥。"}, {"start": 729.7, "end": 731.7, "text": "二哥。"}, {"start": 731.7, "end": 735.9, "text": "二哥。"}, {"start": 735.9, "end": 741.81, "text": "二哥。"}, {"start": 741.81, "end": 743.81, "text": "众大先生。"}, {"start": 743.81, "end": 745.81, "text": "众大先生。"}, {"start": 745.81, "end": 747.81, "text": "二公子还有何事?"}, {"start": 747.81, "end": 748.81, "text": "众大先生。"}, {"start": 748.81, "end": 750.81, "text": "你可千万不要介意。"}, {"start": 750.81, "end": 752.81, "text": "四弟他就是这个体系。"}, {"start": 752.81, "end": 753.81, "text": "试才奥。"}, {"start": 753.81, "end": 755.81, "text": "方才是多演了几倍。"}, {"start": 755.81, "end": 757.81, "text": "二公子是想知道"}, {"start": 757.81, "end": 759.81, "text": "师父的题目是吧?"}, {"start": 759.81, "end": 767.34, "text": "众大先生。"}, {"start": 767.34, "end": 769.34, "text": "天资愚钝。"}, {"start": 769.34, "end": 771.34, "text": "军功武略。"}, {"start": 771.34, "end": 773.34, "text": "不济三弟。"}, {"start": 773.34, "end": 775.34, "text": "这文策论。"}, {"start": 775.34, "end": 777.34, "text": "又不如四弟。"}, {"start": 777.34, "end": 779.34, "text": "当然是提早做准备的好啊。"}, {"start": 779.34, "end": 781.34, "text": "免得来日在百官面前。"}, {"start": 781.34, "end": 783.34, "text": "丢父亲的脸嘛。"}, {"start": 783.34, "end": 785.34, "text": "那好。"}, {"start": 785.34, "end": 787.34, "text": "这题目就是铜雀台。"}, {"start": 787.34, "end": 789.34, "text": "铜雀台。"}, {"start": 789.34, "end": 794.48, "text": "正是。"}, {"start": 794.48, "end": 796.48, "text": "在下还有一事禀报。"}, {"start": 796.48, "end": 798.48, "text": "二公子想知道吗?"}, {"start": 798.48, "end": 804.51, "text": "先生请请。"}, {"start": 804.51, "end": 806.51, "text": "在下没有歇题。"}, {"start": 806.51, "end": 808.51, "text": "丞相早有口谕。"}, {"start": 808.51, "end": 810.51, "text": "二公子谁想知道师父的题目。"}, {"start": 810.51, "end": 815.52, "text": "尽可以告知。"}, {"start": 815.52, "end": 829.3, "text": "可四公子过意清高了。"}, {"start": 829.3, "end": 831.3, "text": "铜雀台。"}, {"start": 831.3, "end": 833.3, "text": "这可不是一道普通的题目啊。"}, {"start": 833.3, "end": 839.94, "text": "此话怎讲?"}, {"start": 839.94, "end": 841.94, "text": "依古里。"}, {"start": 841.94, "end": 843.94, "text": "只有帝王才可铸高台。"}, {"start": 843.94, "end": 845.94, "text": "以仗王位。"}, {"start": 845.94, "end": 847.94, "text": "而铜雀台。"}, {"start": 847.94, "end": 849.94, "text": "几乎是古往今来第一大高台。"}, {"start": 849.94, "end": 851.94, "text": "丞相借高台之会。"}, {"start": 851.94, "end": 853.94, "text": "大集群臣。"}, {"start": 853.94, "end": 855.94, "text": "必是想表明帝王之志。"}, {"start": 855.94, "end": 868.66, "text": "帝是?"}, {"start": 868.66, "end": 872.7, "text": "由此可见。"}, {"start": 872.7, "end": 874.7, "text": "明天是决定诸公子的重要日子。"}, {"start": 874.7, "end": 876.7, "text": "主公要考察诸子。"}, {"start": 876.7, "end": 878.7, "text": "也借考察众闻母。"}, {"start": 878.7, "end": 882.66, "text": "所以这篇副如何做。"}, {"start": 882.66, "end": 884.66, "text": "公子可要想明白了。"}, {"start": 884.66, "end": 886.66, "text": "既然事情如此重要。"}, {"start": 886.66, "end": 894.42, "text": "还得请先生教我呀。"}, {"start": 894.42, "end": 896.42, "text": "此副一定要彰显主公帝王之志。"}, {"start": 896.42, "end": 898.42, "text": "气势洪韵。"}, {"start": 898.42, "end": 900.42, "text": "意贯古今。"}, {"start": 900.42, "end": 902.42, "text": "文弱招侠。"}, {"start": 902.42, "end": 904.42, "text": "尤其是帝王之志。"}, {"start": 904.42, "end": 906.42, "text": "文弱招侠。"}, {"start": 906.42, "end": 918.72, "text": "势弱奔马。"}, {"start": 918.72, "end": 923.5, "text": "完了。"}, {"start": 923.5, "end": 925.5, "text": "先生啊。"}, {"start": 925.5, "end": 927.5, "text": "就算是我请来全界的文人。"}, {"start": 927.5, "end": 930.75, "text": "写出来的文章。"}, {"start": 930.75, "end": 932.75, "text": "也无法和子剑相比呀。"}, {"start": 934.75, "end": 936.75, "text": "公子莫慌。"}, {"start": 936.75, "end": 938.75, "text": "这场户比得不止是户。"}, {"start": 938.75, "end": 940.75, "text": "还有户外之意。"}, {"start": 940.75, "end": 947.17, "text": "此话怎讲?"}, {"start": 947.17, "end": 949.17, "text": "公子可知"}, {"start": 949.17, "end": 951.17, "text": "汉门帝罢休露台之掌控。"}, {"start": 951.17, "end": 953.17, "text": "这柱台不是什么人都能做的事情。"}, {"start": 953.17, "end": 955.17, "text": "偏偏主公做了。"}, {"start": 955.17, "end": 957.17, "text": "这回他让文臣比副。"}, {"start": 957.17, "end": 959.17, "text": "武臣比武。"}, {"start": 959.17, "end": 961.17, "text": "实际上是。"}, {"start": 961.17, "end": 963.17, "text": "我明白了。"}, {"start": 963.17, "end": 969.2, "text": "我明白了。"}, {"start": 969.2, "end": 971.2, "text": "先生。"}, {"start": 971.2, "end": 975.7, "text": "实际上是在。"}, {"start": 975.7, "end": 977.7, "text": "是在。"}, {"start": 977.7, "end": 979.7, "text": "考验群臣。"}, {"start": 979.7, "end": 981.7, "text": "试探群臣。"}, {"start": 981.7, "end": 983.7, "text": "也是在试探我们这些"}, {"start": 983.7, "end": 985.7, "text": "做儿子的心意呀。"}, {"start": 985.7, "end": 992.43, "text": "这样。"}, {"start": 992.43, "end": 994.43, "text": "我明日准备两篇幅。"}, {"start": 994.43, "end": 996.43, "text": "如果这些重要的大臣"}, {"start": 996.43, "end": 998.43, "text": "都称送父亲的帝王之志。"}, {"start": 998.43, "end": 1000.43, "text": "我就用其中的一篇。"}, {"start": 1000.43, "end": 1002.43, "text": "如果他们推托不来。"}, {"start": 1002.43, "end": 1004.43, "text": "或者来了。"}, {"start": 1004.43, "end": 1006.43, "text": "不肯称送父亲。"}, {"start": 1006.43, "end": 1008.43, "text": "我就用另外一篇。"}, {"start": 1008.43, "end": 1010.43, "text": "公子真是心有灵犀呀。"}, {"start": 1012.43, "end": 1016.61, "text": "先生。"}, {"start": 1016.61, "end": 1018.61, "text": "先生一枪掏掠。"}, {"start": 1018.61, "end": 1020.61, "text": "这乃当时之奇才呀。"}, {"start": 1020.61, "end": 1022.61, "text": "这样。"}, {"start": 1022.61, "end": 1024.61, "text": "过两天我禀奏父亲。"}, {"start": 1024.61, "end": 1026.61, "text": "尽先生为宾客。"}, {"start": 1026.61, "end": 1028.61, "text": "不。"}, {"start": 1028.61, "end": 1030.61, "text": "公子万物生此念。"}, {"start": 1030.61, "end": 1032.61, "text": "我若做了公子的宾客。"}, {"start": 1032.61, "end": 1034.61, "text": "那司马仪还能来吗?"}, {"start": 1034.61, "end": 1036.61, "text": "和他比。"}, {"start": 1036.61, "end": 1038.61, "text": "我不过是大树下的"}, {"start": 1038.61, "end": 1040.61, "text": "一棵小草罢了。"}, {"start": 1040.61, "end": 1042.61, "text": "先生。"}, {"start": 1042.61, "end": 1044.61, "text": "先生如此推托。"}, {"start": 1044.61, "end": 1046.61, "text": "你让我心里面怎么好受啊?"}, {"start": 1046.61, "end": 1048.61, "text": "我这么推托。"}, {"start": 1048.61, "end": 1050.61, "text": "公子啊。"}, {"start": 1050.61, "end": 1052.61, "text": "心里好受。"}, {"start": 1052.61, "end": 1054.61, "text": "不但公子好受。"}, {"start": 1054.61, "end": 1056.61, "text": "我也坦然。"}, {"start": 1056.61, "end": 1058.61, "text": "因为为公子效力。"}, {"start": 1058.61, "end": 1060.61, "text": "不必飞入府。"}, {"start": 1060.61, "end": 1066.93, "text": "在府外不是更好吗?"}, {"start": 1066.93, "end": 1120.74, "text": "谢谢先生。"}, {"start": 1120.74, "end": 1122.74, "text": "谢谢先生教诲。"}, {"start": 1131.65, "end": 1133.65, "text": "这些空位是谁没来啊?"}, {"start": 1135.65, "end": 1137.65, "text": "丞相。"}, {"start": 1137.65, "end": 1139.65, "text": "我这就让人去查查。"}, {"start": 1139.65, "end": 1141.65, "text": "人家不来,就有人家不来的道理。"}, {"start": 1143.65, "end": 1145.65, "text": "我怎么没见着寻玉叔侄呢?"}, {"start": 1145.65, "end": 1147.65, "text": "听说是病吧?"}, {"start": 1147.65, "end": 1149.65, "text": "叔侄一起生病。"}, {"start": 1149.65, "end": 1153.02, "text": "是心病吧?"}, {"start": 1153.02, "end": 1155.02, "text": "不等了。开心。"}, {"start": 1155.02, "end": 1157.02, "text": "让大伙坐吧。"}, {"start": 1157.02, "end": 1161.07, "text": "诺。"}, {"start": 1161.07, "end": 1163.07, "text": "诸位。丞相请大家落座。"}, {"start": 1163.07, "end": 1165.07, "text": "谢谢丞相。"}, {"start": 1165.07, "end": 1184.1, "text": "这三年以来。"}, {"start": 1184.1, "end": 1186.1, "text": "承蒙上苍庇佑。"}, {"start": 1186.1, "end": 1188.1, "text": "与顺风调。国泰民安。"}, {"start": 1190.1, "end": 1192.1, "text": "我驻此台。"}, {"start": 1192.1, "end": 1194.1, "text": "就是为了感谢上苍。"}, {"start": 1194.1, "end": 1196.1, "text": "今日请大伙来。"}, {"start": 1196.1, "end": 1198.1, "text": "一起为贺。"}, {"start": 1198.1, "end": 1200.1, "text": "谢谢丞相。"}, {"start": 1200.1, "end": 1203.73, "text": "今日是。"}, {"start": 1203.73, "end": 1209.7, "text": "美酒佳肴。"}, {"start": 1209.7, "end": 1211.7, "text": "高朋满座。"}, {"start": 1211.7, "end": 1213.7, "text": "少长贤妻。"}, {"start": 1213.7, "end": 1215.7, "text": "此会。"}, {"start": 1215.7, "end": 1217.7, "text": "难得啊。"}, {"start": 1217.7, "end": 1219.7, "text": "待会。"}, {"start": 1219.7, "end": 1221.7, "text": "我们还要请。"}, {"start": 1221.7, "end": 1223.7, "text": "武将比射。"}, {"start": 1223.7, "end": 1225.7, "text": "文官比副。"}, {"start": 1225.7, "end": 1227.7, "text": "一起来。"}, {"start": 1227.7, "end": 1229.7, "text": "盛同此会。"}, {"start": 1229.7, "end": 1231.7, "text": "大家意下如何?"}, {"start": 1231.7, "end": 1236.19, "text": "敬请。"}, {"start": 1236.19, "end": 1251.7, "text": "敬您此尊。"}, {"start": 1251.7, "end": 1253.7, "text": "徐叔。"}, {"start": 1253.7, "end": 1255.7, "text": "丞相。"}, {"start": 1255.7, "end": 1257.7, "text": "有何吩咐?"}, {"start": 1257.7, "end": 1259.7, "text": "你把这件西川红锦战袍。"}, {"start": 1259.7, "end": 1261.7, "text": "挂到湖心那个小岛上。"}, {"start": 1261.7, "end": 1263.7, "text": "以百步为界设一剑舵。"}, {"start": 1263.7, "end": 1265.7, "text": "用剑舵上的红锦。"}, {"start": 1265.7, "end": 1267.7, "text": "就把这个袍子赏给他。"}, {"start": 1267.7, "end": 1269.7, "text": "否则,罚酒一杯。"}, {"start": 1269.7, "end": 1391.34, "text": "诺。"}, {"start": 1391.34, "end": 1396.0, "text": "谢国父亲。"}, {"start": 1396.0, "end": 1398.0, "text": "丞相啊。"}, {"start": 1398.0, "end": 1400.0, "text": "三公子的旗射之技。"}, {"start": 1400.0, "end": 1402.0, "text": "真是盖世无双啊。"}, {"start": 1402.0, "end": 1404.0, "text": "不读书,而好功马。"}, {"start": 1404.0, "end": 1406.0, "text": "此匹夫之用也。"}, {"start": 1406.0, "end": 1408.0, "text": "何足归乎?"}, {"start": 1408.0, "end": 1410.0, "text": "而以为,出生于乱世。"}, {"start": 1410.0, "end": 1412.0, "text": "就应该学卫青获取病。"}, {"start": 1412.0, "end": 1414.0, "text": "立功沙漠。"}, {"start": 1414.0, "end": 1416.0, "text": "救黎民,出水火之中。"}, {"start": 1416.0, "end": 1418.0, "text": "别的,"}, {"start": 1418.0, "end": 1420.0, "text": "别的有什么用啊?"}, {"start": 1420.0, "end": 1422.0, "text": "听你这口气,"}, {"start": 1422.0, "end": 1424.0, "text": "你的志向就是当个大将军了。"}, {"start": 1424.0, "end": 1426.0, "text": "是。"}, {"start": 1426.0, "end": 1428.0, "text": "那我问你,你知道怎么才能当好一个大将军吗?"}, {"start": 1428.0, "end": 1430.0, "text": "赏必行,"}, {"start": 1430.0, "end": 1432.0, "text": "罚必信。"}, {"start": 1432.0, "end": 1434.0, "text": "披肩执锐,"}, {"start": 1434.0, "end": 1438.08, "text": "身先士卒,临危不惧。"}, {"start": 1438.08, "end": 1440.08, "text": "听这几句,"}, {"start": 1440.08, "end": 1442.08, "text": "还真能当个大将军?"}, {"start": 1442.08, "end": 1444.08, "text": "是。"}, {"start": 1444.08, "end": 1448.42, "text": "诺。"}, {"start": 1448.42, "end": 1450.42, "text": "武将以骑射为乐,足以彰显为勇。"}, {"start": 1450.42, "end": 1452.42, "text": "下面,"}, {"start": 1452.42, "end": 1454.42, "text": "该你们这些宝学之士,"}, {"start": 1454.42, "end": 1456.42, "text": "一展才华了。"}, {"start": 1456.42, "end": 1458.42, "text": "请丞相主席。"}, {"start": 1458.42, "end": 1460.42, "text": "就以铜雀台为题。"}, {"start": 1460.42, "end": 1571.89, "text": "公子,"}, {"start": 1571.89, "end": 1573.89, "text": "丞相可一直在欣赏你的大作呢。"}, {"start": 1575.89, "end": 1595.33, "text": "就好,"}, {"start": 1595.33, "end": 1618.54, "text": "就好。"}, {"start": 1618.54, "end": 1620.54, "text": "丞相,这是二公子所做的服务。"}, {"start": 1620.54, "end": 1622.54, "text": "请丞相欣赏。"}, {"start": 1622.54, "end": 1641.92, "text": "司马仪。"}, {"start": 1641.92, "end": 1647.44, "text": "在。"}, {"start": 1647.44, "end": 1651.36, "text": "你把这两篇符给诸位念念。"}, {"start": 1651.36, "end": 1663.98, "text": "先念曹芝的吧。"}, {"start": 1663.98, "end": 1665.98, "text": "符,黄都之弘历兮,"}, {"start": 1665.98, "end": 1667.98, "text": "看云霞之浮动,"}, {"start": 1667.98, "end": 1669.98, "text": "心群彩之来翠兮,"}, {"start": 1669.98, "end": 1671.98, "text": "邪飞雄之极梦,"}, {"start": 1671.98, "end": 1673.98, "text": "仰春风之和睦兮,"}, {"start": 1673.98, "end": 1675.98, "text": "听百鸟之归鸣,"}, {"start": 1675.98, "end": 1677.98, "text": "同天地之归亮兮,"}, {"start": 1677.98, "end": 1679.98, "text": "起日月之辉光,"}, {"start": 1679.98, "end": 1681.98, "text": "永贵尊,"}, {"start": 1681.98, "end": 1683.98, "text": "永贵尊,"}, {"start": 1683.98, "end": 1685.98, "text": "永贵尊,"}, {"start": 1685.98, "end": 1687.98, "text": "而无极兮,"}, {"start": 1687.98, "end": 1689.98, "text": "等君寿于东王。"}, {"start": 1689.98, "end": 1695.02, "text": "再念曹芝的。"}, {"start": 1695.02, "end": 1706.88, "text": "临台行高,"}, {"start": 1706.88, "end": 1708.88, "text": "高以轩,下有水,"}, {"start": 1708.88, "end": 1710.88, "text": "清且寒,"}, {"start": 1710.88, "end": 1712.88, "text": "中有黄狐王且翻,"}, {"start": 1712.88, "end": 1714.88, "text": "行为臣当尽忠,"}, {"start": 1714.88, "end": 1716.88, "text": "愿令皇帝陛下三千岁。"}, {"start": 1718.88, "end": 1720.88, "text": "你们别光摇土啊。"}, {"start": 1720.88, "end": 1722.88, "text": "说说看。"}, {"start": 1722.88, "end": 1726.16, "text": "这两篇符怎么样?"}, {"start": 1726.16, "end": 1728.16, "text": "四公子的驸马一采流光,"}, {"start": 1728.16, "end": 1730.16, "text": "气象万千。"}, {"start": 1730.16, "end": 1732.16, "text": "二公子的驸马平顺有余,"}, {"start": 1732.16, "end": 1734.16, "text": "精彩不足。"}, {"start": 1736.16, "end": 1743.63, "text": "曹芝。"}, {"start": 1743.63, "end": 1745.63, "text": "孩儿在。"}, {"start": 1745.63, "end": 1747.63, "text": "芝儿,"}, {"start": 1747.63, "end": 1749.63, "text": "看得出你读书是"}, {"start": 1749.63, "end": 1754.58, "text": "颇为用功的。"}, {"start": 1754.58, "end": 1756.58, "text": "刚才章儿"}, {"start": 1756.58, "end": 1758.58, "text": "骑射拿了个第一,"}, {"start": 1758.58, "end": 1760.58, "text": "我赐给他一件锦袍。"}, {"start": 1760.58, "end": 1762.58, "text": "你写了这么好一篇符,"}, {"start": 1762.58, "end": 1764.58, "text": "我也要赏你。"}, {"start": 1766.58, "end": 1771.84, "text": "赏你点什么呢?"}, {"start": 1771.84, "end": 1773.84, "text": "我要上表给天子,"}, {"start": 1773.84, "end": 1775.84, "text": "让他封你为"}, {"start": 1775.84, "end": 1781.81, "text": "平原侯。"}, {"start": 1781.81, "end": 1783.81, "text": "谢副相。"}, {"start": 1783.81, "end": 1785.81, "text": "恭喜四公子,"}, {"start": 1785.81, "end": 1793.34, "text": "恭喜平原侯。"}, {"start": 1793.34, "end": 1795.34, "text": "丞相。"}, {"start": 1795.34, "end": 1797.34, "text": "远长,你有什么话说?"}, {"start": 1797.34, "end": 1799.34, "text": "四公子是才在"}, {"start": 1799.34, "end": 1801.34, "text": "副中写得好啊。"}, {"start": 1801.34, "end": 1803.34, "text": "同天地之归两兮,"}, {"start": 1803.34, "end": 1805.34, "text": "是月之辉光。"}, {"start": 1805.34, "end": 1807.34, "text": "我看这章句用来"}, {"start": 1807.34, "end": 1809.34, "text": "计数丞相的功绩"}, {"start": 1809.34, "end": 1811.34, "text": "是最恰当不过。"}, {"start": 1811.34, "end": 1813.34, "text": "但是,"}, {"start": 1813.34, "end": 1815.34, "text": "我等丞相都希望丞相"}, {"start": 1815.34, "end": 1819.81, "text": "以天下为己任,"}, {"start": 1819.81, "end": 1821.81, "text": "更进一步。"}, {"start": 1821.81, "end": 1823.81, "text": "钟大人所言极是,"}, {"start": 1823.81, "end": 1825.81, "text": "丞相功德微微,"}, {"start": 1825.81, "end": 1827.81, "text": "如能承受天命,"}, {"start": 1827.81, "end": 1829.81, "text": "真乃社稷之福啊。"}, {"start": 1831.81, "end": 1833.81, "text": "主公啊,"}, {"start": 1833.81, "end": 1835.81, "text": "稳重了。"}, {"start": 1835.81, "end": 1837.81, "text": "我本是个"}, {"start": 1837.81, "end": 1839.81, "text": "娱乐的人,"}, {"start": 1839.81, "end": 1841.81, "text": "举孝敛出身,"}, {"start": 1841.81, "end": 1843.81, "text": "正好赶上乱世,"}, {"start": 1843.81, "end": 1845.81, "text": "朝廷征我为典军校尉,"}, {"start": 1845.81, "end": 1847.81, "text": "我不得不首踢三尺剑,"}, {"start": 1847.81, "end": 1849.81, "text": "为朝廷孝敛薄之礼。"}, {"start": 1849.81, "end": 1851.81, "text": "当时我只有一个念想,"}, {"start": 1851.81, "end": 1853.81, "text": "就是死后在墓碑上能客上,"}, {"start": 1853.81, "end": 1855.81, "text": "已故征西将军"}, {"start": 1855.81, "end": 1857.81, "text": "曹侯之墓,"}, {"start": 1857.81, "end": 1859.81, "text": "我这辈子就知足了。"}, {"start": 1859.81, "end": 1861.81, "text": "可是没有想到,"}, {"start": 1861.81, "end": 1863.81, "text": "上了马鞍子就下不来了。"}, {"start": 1863.81, "end": 1865.81, "text": "几十年纵横天下,"}, {"start": 1865.81, "end": 1867.81, "text": "做了些事情,"}, {"start": 1867.81, "end": 1869.81, "text": "无非是为国讨贼,"}, {"start": 1869.81, "end": 1871.81, "text": "救百姓于水火,"}, {"start": 1871.81, "end": 1873.81, "text": "没有想到啊,"}, {"start": 1873.81, "end": 1875.81, "text": "竟蒙天恩,"}, {"start": 1875.81, "end": 1877.81, "text": "为登福载,"}, {"start": 1877.81, "end": 1879.81, "text": "贵己人臣,"}, {"start": 1879.81, "end": 1881.81, "text": "我已经是追追不安了。"}, {"start": 1881.81, "end": 1883.81, "text": "这个时候我还能奢望什么呢?"}, {"start": 1885.81, "end": 1887.81, "text": "说实话,其实我早就想把兵权交出来,"}, {"start": 1887.81, "end": 1889.81, "text": "以表明我的心意,"}, {"start": 1889.81, "end": 1891.81, "text": "可是为了汉室着想,"}, {"start": 1891.81, "end": 1893.81, "text": "为了天下百姓着想,"}, {"start": 1893.81, "end": 1895.81, "text": "我不能这么做。"}, {"start": 1895.81, "end": 1897.81, "text": "你们想想,"}, {"start": 1897.81, "end": 1899.81, "text": "如果现在,"}, {"start": 1899.81, "end": 1901.81, "text": "天下没有我曹侯,"}, {"start": 1901.81, "end": 1903.81, "text": "不只有几人称帝,"}, {"start": 1903.81, "end": 1905.81, "text": "几人称王呢?"}, {"start": 1907.81, "end": 1912.11, "text": "丞相真是一片担心啊,"}, {"start": 1912.11, "end": 1914.11, "text": "就是一隐周公的胸怀,"}, {"start": 1914.11, "end": 1916.11, "text": "也不及丞相万一。"}, {"start": 1918.11, "end": 1920.11, "text": "可是不是所有的人都像你原常"}, {"start": 1920.11, "end": 1922.11, "text": "这么想的。"}, {"start": 1922.11, "end": 1927.7, "text": "有些人,"}, {"start": 1927.7, "end": 1929.7, "text": "他觉得我权重,"}, {"start": 1931.7, "end": 1933.7, "text": "忘家寸朵,"}, {"start": 1933.7, "end": 1937.78, "text": "以我有异心,"}, {"start": 1937.78, "end": 1941.02, "text": "甚至,"}, {"start": 1941.02, "end": 1943.02, "text": "刺激当于想暗害我。"}, {"start": 1943.02, "end": 1946.56, "text": "我今天就告诉你们,"}, {"start": 1946.56, "end": 1948.56, "text": "你们想错了。"}, {"start": 1948.56, "end": 1953.15, "text": "请你们诸位大人今天回去,"}, {"start": 1953.15, "end": 1955.15, "text": "告诉那些今天没有来的官员。"}, {"start": 1957.15, "end": 1959.15, "text": "我曹葬,"}, {"start": 1959.15, "end": 1961.15, "text": "我曹葬,"}, {"start": 1961.15, "end": 1963.15, "text": "绝非,"}, {"start": 1963.15, "end": 1965.15, "text": "他们才记得那种人。"}, {"start": 1965.15, "end": 1974.67, "text": "公子昨日之父,"}, {"start": 1974.67, "end": 1976.67, "text": "灿若昭霞,"}, {"start": 1976.67, "end": 1978.67, "text": "朗若群星,"}, {"start": 1978.67, "end": 1980.67, "text": "气吞山河,"}, {"start": 1980.67, "end": 1982.67, "text": "横扫古今。"}, {"start": 1982.67, "end": 1984.67, "text": "由此父在,"}, {"start": 1984.67, "end": 1986.67, "text": "屈子的离嫂和九哥,"}, {"start": 1986.67, "end": 1988.67, "text": "也该休矣啊。"}, {"start": 1988.67, "end": 1990.67, "text": "更加值得可喜的是,"}, {"start": 1990.67, "end": 1992.67, "text": "公子被册封为平原侯,"}, {"start": 1992.67, "end": 1994.67, "text": "此事足以见得,"}, {"start": 1994.67, "end": 1996.67, "text": "大业啊,"}, {"start": 1996.67, "end": 2003.98, "text": "并非因为此父啊。"}, {"start": 2003.98, "end": 2005.98, "text": "父相,"}, {"start": 2005.98, "end": 2007.98, "text": "还含有别的深意吗?"}, {"start": 2007.98, "end": 2009.98, "text": "丞相,"}, {"start": 2009.98, "end": 2011.98, "text": "是奖赏公子劝尽的功劳,"}, {"start": 2011.98, "end": 2013.98, "text": "并以此向百官,"}, {"start": 2013.98, "end": 2015.98, "text": "展示恩威。"}, {"start": 2015.98, "end": 2017.98, "text": "不错,"}, {"start": 2017.98, "end": 2023.06, "text": "二哥的父中,"}, {"start": 2025.06, "end": 2027.06, "text": "就隐约含有着,"}, {"start": 2029.06, "end": 2031.06, "text": "宗从汉士之。"}, {"start": 2031.06, "end": 2035.36, "text": "使得父相,"}, {"start": 2035.36, "end": 2038.64, "text": "深。"}, {"start": 2038.64, "end": 2040.64, "text": "批公子过于厚实憨直,"}, {"start": 2040.64, "end": 2042.64, "text": "不明势力,"}, {"start": 2042.64, "end": 2044.64, "text": "汉庭,"}, {"start": 2044.64, "end": 2046.64, "text": "就剩下张破番了。"}, {"start": 2046.64, "end": 2048.64, "text": "如果不是丞相扶着,"}, {"start": 2048.64, "end": 2050.64, "text": "一阵风就能给吹倒了。"}, {"start": 2050.64, "end": 2052.64, "text": "批公子还在汉庭做事,"}, {"start": 2052.64, "end": 2054.64, "text": "天下仍无不盼望丞相,"}, {"start": 2054.64, "end": 2056.64, "text": "均临天下啊。"}, {"start": 2056.64, "end": 2058.64, "text": "可是父相那最后"}, {"start": 2058.64, "end": 2060.64, "text": "一番表白,"}, {"start": 2060.64, "end": 2062.64, "text": "又是何意?"}, {"start": 2062.64, "end": 2066.14, "text": "听起来,"}, {"start": 2066.14, "end": 2068.14, "text": "父相似乎并不想畏惧九五。"}, {"start": 2072.14, "end": 2074.14, "text": "那是丞相客气,"}, {"start": 2074.14, "end": 2076.14, "text": "客气给天下人看的。"}, {"start": 2076.14, "end": 2078.14, "text": "即便是有一天,"}, {"start": 2078.14, "end": 2080.14, "text": "天子真的上位了,"}, {"start": 2080.14, "end": 2083.58, "text": "丞相也要三词才行啊。"}, {"start": 2089.5, "end": 2102.06, "text": "请敬此杯。"}, {"start": 2102.06, "end": 2104.06, "text": "公子请。"}, {"start": 2104.06, "end": 2106.06, "text": "来。"}, {"start": 2106.06, "end": 2112.83, "text": "请。"}, {"start": 2125.66, "end": 2128.98, "text": "仲达先生,"}, {"start": 2128.98, "end": 2130.98, "text": "百官们都到四弟那儿去贺喜了,"}, {"start": 2130.98, "end": 2132.98, "text": "你怎么到我这儿来了?"}, {"start": 2132.98, "end": 2134.98, "text": "他有什么喜可贺?"}, {"start": 2134.98, "end": 2136.98, "text": "该贺喜的是公子你。"}, {"start": 2136.98, "end": 2143.1, "text": "我?"}, {"start": 2143.1, "end": 2145.1, "text": "这我就不懂了。"}, {"start": 2145.1, "end": 2147.1, "text": "四弟因一父而名扬天下,"}, {"start": 2147.1, "end": 2149.1, "text": "得到了侯爵的重赏,"}, {"start": 2149.1, "end": 2157.15, "text": "回头吐脸的。"}, {"start": 2157.15, "end": 2160.5, "text": "他因为一篇副"}, {"start": 2160.5, "end": 2162.5, "text": "得到了侯爵封赏,"}, {"start": 2162.5, "end": 2164.5, "text": "也会因为一篇副"}, {"start": 2164.5, "end": 2172.54, "text": "失去整个天下。"}, {"start": 2172.54, "end": 2175.92, "text": "这我就更不明白了。"}, {"start": 2175.92, "end": 2179.78, "text": "公子已经看见了,"}, {"start": 2179.78, "end": 2181.78, "text": "那天腾雪台职会,"}, {"start": 2181.78, "end": 2183.78, "text": "很多大臣没到,"}, {"start": 2183.78, "end": 2185.78, "text": "别人不说,"}, {"start": 2185.78, "end": 2187.78, "text": "玄玉追随丞相多年,"}, {"start": 2187.78, "end": 2189.78, "text": "功勋卓著,"}, {"start": 2189.78, "end": 2191.78, "text": "丞相视他为公,"}, {"start": 2191.78, "end": 2195.41, "text": "连他都告病在家。"}, {"start": 2195.41, "end": 2197.41, "text": "公子想没想过这是为什么?"}, {"start": 2197.41, "end": 2199.41, "text": "御闻先生指教。"}, {"start": 2199.41, "end": 2201.41, "text": "一类为草帽武将,"}, {"start": 2201.41, "end": 2203.41, "text": "他们只知征战,"}, {"start": 2203.41, "end": 2205.41, "text": "不明玄机。"}, {"start": 2205.41, "end": 2207.41, "text": "一类为没有实权的文官,"}, {"start": 2207.41, "end": 2209.41, "text": "因为手中没权,"}, {"start": 2209.41, "end": 2211.41, "text": "更需要扼余丞相,"}, {"start": 2211.41, "end": 2213.41, "text": "得到封赏。"}, {"start": 2213.41, "end": 2217.17, "text": "他们从四公子的府里,"}, {"start": 2217.17, "end": 2219.17, "text": "拼出了劝禁之意,"}, {"start": 2219.17, "end": 2221.17, "text": "便大肆献媚。"}, {"start": 2221.17, "end": 2224.45, "text": "因为赞扬此父,"}, {"start": 2224.45, "end": 2226.45, "text": "就等于拥戴丞相称帝。"}, {"start": 2226.45, "end": 2228.45, "text": "反过来,"}, {"start": 2228.45, "end": 2230.45, "text": "二公子的府里,"}, {"start": 2230.45, "end": 2232.45, "text": "却含着心存汉史的意思,"}, {"start": 2232.45, "end": 2234.45, "text": "他们自然摇手叹息了。"}, {"start": 2234.45, "end": 2236.45, "text": "向丞相表明立场,"}, {"start": 2236.45, "end": 2241.01, "text": "更重要的是,"}, {"start": 2241.01, "end": 2247.84, "text": "足以测出,"}, {"start": 2247.84, "end": 2249.84, "text": "许多人的心里,"}, {"start": 2249.84, "end": 2253.63, "text": "还是拥护汉史的。"}, {"start": 2253.63, "end": 2255.63, "text": "铜雀台之会,"}, {"start": 2255.63, "end": 2259.26, "text": "令天下人注目,"}, {"start": 2259.26, "end": 2261.26, "text": "铜雀台上所有的父,"}, {"start": 2261.26, "end": 2263.26, "text": "均已不进而走,"}, {"start": 2263.26, "end": 2265.26, "text": "早晚会传遍天下。"}, {"start": 2265.26, "end": 2267.26, "text": "四公子的父,"}, {"start": 2267.26, "end": 2269.26, "text": "虽然得到了丞相的赞扬,"}, {"start": 2269.26, "end": 2271.26, "text": "但却会失去,"}, {"start": 2271.26, "end": 2273.26, "text": "天下世子之心。"}, {"start": 2273.26, "end": 2275.26, "text": "而二公子的父,"}, {"start": 2275.26, "end": 2277.26, "text": "虽然令丞相不悦,"}, {"start": 2277.26, "end": 2279.26, "text": "但心存汉史的世子,"}, {"start": 2279.26, "end": 2281.26, "text": "却会对二公子,"}, {"start": 2281.26, "end": 2283.26, "text": "心怀感激。"}, {"start": 2283.26, "end": 2285.26, "text": "所谓,"}, {"start": 2285.26, "end": 2287.26, "text": "得民心者得天下,"}, {"start": 2287.26, "end": 2289.26, "text": "一颗世子之心,"}, {"start": 2289.26, "end": 2291.26, "text": "往往聚得住一片民心。"}, {"start": 2291.26, "end": 2299.7, "text": "先生过奖了,"}, {"start": 2299.7, "end": 2301.7, "text": "所有的人都知道,"}, {"start": 2301.7, "end": 2303.7, "text": "曹皮在诸公子里面,"}, {"start": 2303.7, "end": 2305.7, "text": "最为努顿。"}, {"start": 2305.7, "end": 2307.7, "text": "即便真的如先生所言,"}, {"start": 2307.7, "end": 2309.7, "text": "我那篇幅,"}, {"start": 2309.7, "end": 2312.98, "text": "得侥幸。"}, {"start": 2312.98, "end": 2314.98, "text": "侥幸不能吧?"}, {"start": 2316.98, "end": 2318.98, "text": "公子,"}, {"start": 2318.98, "end": 2320.98, "text": "书房里的灯亮了一夜,"}, {"start": 2320.98, "end": 2322.98, "text": "难道只写出了"}, {"start": 2322.98, "end": 2324.98, "text": "区区百来字的一篇小幅?"}, {"start": 2324.98, "end": 2336.29, "text": "是我冒昧猜测。"}, {"start": 2336.29, "end": 2338.29, "text": "公子也许写出了"}, {"start": 2338.29, "end": 2340.29, "text": "另一篇幅,"}, {"start": 2340.29, "end": 2342.29, "text": "而另一篇幅是劝尽的。"}, {"start": 2342.29, "end": 2344.29, "text": "如果那篇,"}, {"start": 2344.29, "end": 2346.29, "text": "大臣们通通到齐,"}, {"start": 2346.29, "end": 2348.29, "text": "公子就会拿出另一篇,"}, {"start": 2348.29, "end": 2350.29, "text": "我猜测得对吗?"}, {"start": 2350.29, "end": 2363.55, "text": "刁章卓具算什么?"}, {"start": 2363.55, "end": 2365.55, "text": "懂得审时度势,"}, {"start": 2365.55, "end": 2367.55, "text": "相机行事,"}, {"start": 2367.55, "end": 2369.55, "text": "乃更高境界。"}, {"start": 2369.55, "end": 2371.55, "text": "而达到此境界的公子,"}, {"start": 2371.55, "end": 2373.55, "text": "还装成一无所知,"}, {"start": 2373.55, "end": 2375.55, "text": "善于掏毁藏着。"}, {"start": 2375.55, "end": 2377.55, "text": "那么我对这样的公子"}, {"start": 2377.55, "end": 2382.75, "text": "只有两个字评价了。"}, {"start": 2382.75, "end": 2394.86, "text": "两个什么字?"}, {"start": 2394.86, "end": 2413.47, "text": "自少公子走后,"}, {"start": 2413.47, "end": 2415.47, "text": "我每月都去他坟前"}, {"start": 2415.47, "end": 2417.47, "text": "画一本书。"}, {"start": 2417.47, "end": 2419.47, "text": "到今天三年已过,"}, {"start": 2419.47, "end": 2423.81, "text": "我已经画了三十六本书。"}, {"start": 2423.81, "end": 2425.81, "text": "我想我可以遵奉丞相先曰,"}, {"start": 2425.81, "end": 2427.81, "text": "在朱公子中"}, {"start": 2427.81, "end": 2429.81, "text": "选择一位做他的目客了。"}, {"start": 2429.81, "end": 2433.6, "text": "您选中了哪位公子?"}, {"start": 2433.6, "end": 2438.67, "text": "曹匹。"}]