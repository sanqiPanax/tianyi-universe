[{"start": 4.56, "end": 30.45, "text": "吴王口谕,传蜀汉使臣马肃觐见。"}, {"start": 30.45, "end": 33.45, "text": "吴王笑蜀汉故事,离声顺其。"}, {"start": 34.45, "end": 39.45, "text": "看来,今天我和魏使之间,必有一人要被烹杀了。"}, {"start": 57.18, "end": 60.18, "text": "蜀参军马肃,拜见吴王殿下。"}, {"start": 60.18, "end": 64.18, "text": "既为使臣,见我王为何不贵?"}, {"start": 65.18, "end": 69.18, "text": "上国天使,不败小帮之主。"}, {"start": 69.18, "end": 78.57, "text": "马肃啊,你此行来无,是想施展三寸之舌。"}, {"start": 78.57, "end": 80.57, "text": "效仿立声顺其罢。"}, {"start": 80.57, "end": 88.9, "text": "告诉你,孤平生最讨厌顺格。"}, {"start": 88.9, "end": 89.9, "text": "来人啊。"}, {"start": 89.9, "end": 90.9, "text": "在。"}, {"start": 90.9, "end": 93.9, "text": "将这狂徒扔入油顶,扎了。"}, {"start": 93.9, "end": 94.9, "text": "诺。"}, {"start": 95.9, "end": 96.9, "text": "且慢。"}, {"start": 97.9, "end": 101.9, "text": "本使,无需尔等玷污。"}, {"start": 101.9, "end": 104.9, "text": "待我,自己下顶货。"}, {"start": 112.97, "end": 114.97, "text": "人言东吾多贤。"}, {"start": 114.97, "end": 118.97, "text": "没想到,竟然寄句我一如生。"}, {"start": 119.97, "end": 120.97, "text": "慢。"}, {"start": 120.97, "end": 129.4, "text": "何惧一匹夫啊?"}, {"start": 130.4, "end": 135.4, "text": "大王既然不惧马肃,为何不敢听我一言?"}, {"start": 137.4, "end": 140.4, "text": "你无非是想替诸葛亮作说口。"}, {"start": 140.4, "end": 148.4, "text": "劝我连蜀聚魏,救蜀出险禁。"}, {"start": 148.4, "end": 149.4, "text": "非也。"}, {"start": 150.4, "end": 155.4, "text": "马肃此来,不为救蜀,乃为救吾。"}, {"start": 155.4, "end": 157.65, "text": "救吾?"}, {"start": 159.65, "end": 165.65, "text": "可笑至极。"}, {"start": 165.65, "end": 172.47, "text": "现在被包围的可是蜀汉,并非东吾。"}, {"start": 173.47, "end": 178.47, "text": "殿下,你既然知李生税其之典故,"}, {"start": 178.47, "end": 182.47, "text": "为何却不知扁鹊与蔡桓公之典呢?"}, {"start": 182.47, "end": 187.47, "text": "在扁鹊眼里,患有重病的王公,"}, {"start": 187.47, "end": 191.47, "text": "往往却不知道自己的病症之所在。"}, {"start": 192.47, "end": 207.46, "text": "你可是言之,如言不重我意。"}, {"start": 207.46, "end": 209.46, "text": "自己下顶货去吧。"}, {"start": 209.46, "end": 210.46, "text": "谢大王。"}, {"start": 210.46, "end": 213.18, "text": "谢大王。"}, {"start": 213.18, "end": 221.76, "text": "大王,你乃是当今明主。"}, {"start": 221.76, "end": 226.76, "text": "我家丞相,亦是当世之俊杰。"}, {"start": 226.76, "end": 230.76, "text": "互为盟友,则天下太平。"}, {"start": 230.76, "end": 233.76, "text": "若互为仇敌,则纯王齿寒。"}, {"start": 234.76, "end": 235.76, "text": "同理。"}, {"start": 236.76, "end": 241.76, "text": "孰有山川之险,吾有三江之故。"}, {"start": 241.76, "end": 244.76, "text": "若两国联合共为纯耻,"}, {"start": 244.76, "end": 249.76, "text": "则进可兼去天下,退可顶足而立。"}, {"start": 249.76, "end": 255.55, "text": "如果大王贪信曹蔚所许之小利,"}, {"start": 255.55, "end": 257.55, "text": "助贼攻蜀,"}, {"start": 257.55, "end": 260.55, "text": "试问蜀一旦灭亡,"}, {"start": 260.55, "end": 264.55, "text": "东吾又能和魏抗衡多久呢?"}, {"start": 264.55, "end": 267.55, "text": "早晚毙王爷。"}, {"start": 267.55, "end": 272.55, "text": "反之,蜀如果击退了曹蔚的各路军马,"}, {"start": 272.55, "end": 276.55, "text": "国主以后还会与殿下为盟吗?"}, {"start": 276.55, "end": 280.55, "text": "蜀吾必将反目成仇啊!"}, {"start": 280.55, "end": 284.86, "text": "启禀殿下,魏蜀吾三方,"}, {"start": 284.86, "end": 287.86, "text": "就好比这只顶的三族,"}, {"start": 287.86, "end": 290.86, "text": "短及一族必然天下轻富,"}, {"start": 290.86, "end": 292.86, "text": "而吾蜀两国,"}, {"start": 292.86, "end": 294.86, "text": "就好比一个人的两只脚,"}, {"start": 294.86, "end": 296.86, "text": "缺了任何一志,"}, {"start": 296.86, "end": 299.86, "text": "此人必然难以立足。"}, {"start": 299.86, "end": 301.86, "text": "敢问殿下,"}, {"start": 301.86, "end": 305.86, "text": "你见过有谁拿着刀剁自己的脚吗?"}, {"start": 305.86, "end": 321.66, "text": "也罢,也罢。"}, {"start": 321.66, "end": 328.89, "text": "既然殿下愿意备盟毁约,"}, {"start": 328.89, "end": 333.89, "text": "向曹蔚拱手贡献江东八十一郡,"}, {"start": 333.89, "end": 339.94, "text": "在下也愿自下顶货,"}, {"start": 339.94, "end": 341.94, "text": "以权明解。"}, {"start": 341.94, "end": 346.02, "text": "慢。"}, {"start": 346.02, "end": 348.02, "text": "怎么?"}, {"start": 348.02, "end": 351.02, "text": "殿下嫌顶中的费油不够多吗?"}, {"start": 351.02, "end": 364.98, "text": "先生好口才,好胆识啊。"}, {"start": 364.98, "end": 367.98, "text": "请到后殿一叙。"}, {"start": 367.98, "end": 372.57, "text": "启禀殿下,"}, {"start": 372.57, "end": 375.57, "text": "那么大一顶费油,"}, {"start": 375.57, "end": 377.57, "text": "不能白费了。"}, {"start": 377.57, "end": 381.1, "text": "此话何意啊?"}, {"start": 383.1, "end": 386.1, "text": "既然蜀使没有入顶之福,"}, {"start": 386.1, "end": 389.1, "text": "还请殿下指魏使入顶,"}, {"start": 389.1, "end": 392.1, "text": "以表明吾王连蜀抗魏之志。"}, {"start": 392.1, "end": 397.1, "text": "并以此整天下视听。"}, {"start": 397.1, "end": 405.99, "text": "召魏使上殿。"}, {"start": 405.99, "end": 410.97, "text": "召魏使上殿。"}, {"start": 410.97, "end": 432.18, "text": "禀主公,探马来报,"}, {"start": 432.18, "end": 436.18, "text": "四路法蜀大军均被诛隔量,"}, {"start": 436.18, "end": 439.18, "text": "社稷杀退了。"}, {"start": 439.18, "end": 442.18, "text": "说我听听。"}, {"start": 442.18, "end": 446.18, "text": "方王可必能军治西平关,"}, {"start": 446.18, "end": 449.18, "text": "御蜀上将军马超所祖,"}, {"start": 449.18, "end": 452.18, "text": "竟然不战自退。"}, {"start": 452.18, "end": 454.18, "text": "蟒王孟霍,"}, {"start": 454.18, "end": 457.18, "text": "虽起兵攻至蜀南部四郡,"}, {"start": 457.18, "end": 461.18, "text": "可伟延却使用移兵之计,"}, {"start": 461.18, "end": 464.18, "text": "令孟霍损兵折将,"}, {"start": 464.18, "end": 467.18, "text": "只能退败瞒洞。"}, {"start": 467.18, "end": 470.18, "text": "新城梦达起兵至半道,"}, {"start": 470.18, "end": 472.18, "text": "突然换兵,"}, {"start": 472.18, "end": 475.18, "text": "自此再也不能前进一步。"}, {"start": 475.18, "end": 478.18, "text": "伟大都督曹真,"}, {"start": 478.18, "end": 481.18, "text": "兵出扬平关后,"}, {"start": 481.18, "end": 484.18, "text": "与赵子龙举手各出险道,"}, {"start": 484.18, "end": 486.18, "text": "战退梁南,"}, {"start": 486.18, "end": 489.18, "text": "待梁草带进之后,"}, {"start": 489.18, "end": 492.18, "text": "也只能办事回国了。"}, {"start": 492.18, "end": 496.18, "text": "曹匹果然非诸葛亮之敌啊。"}, {"start": 498.18, "end": 502.18, "text": "主公那天如果不把魏使置进鼎祸,"}, {"start": 502.18, "end": 506.18, "text": "我只怕我们又要结怨于蜀了。"}, {"start": 507.18, "end": 510.18, "text": "不结怨于蜀,"}, {"start": 510.18, "end": 512.18, "text": "必结怨于魏。"}, {"start": 514.86, "end": 516.86, "text": "魏国法蜀不成,"}, {"start": 516.86, "end": 518.86, "text": "反来东无报复。"}, {"start": 518.86, "end": 520.86, "text": "主公无虑,"}, {"start": 520.86, "end": 523.86, "text": "这一次主公有恩于蜀,"}, {"start": 523.86, "end": 526.86, "text": "曹匹如敢犯境,"}, {"start": 526.86, "end": 528.86, "text": "主公也可亲蜀,"}, {"start": 528.86, "end": 531.86, "text": "发兵相援。"}, {"start": 531.86, "end": 535.91, "text": "这些年,"}, {"start": 535.91, "end": 537.91, "text": "无论是战,"}, {"start": 537.91, "end": 539.91, "text": "是何,"}, {"start": 539.91, "end": 542.91, "text": "都取决于自身国力,"}, {"start": 542.91, "end": 545.91, "text": "只有自身强胜了,"}, {"start": 545.91, "end": 548.91, "text": "别人才肯怨你。"}, {"start": 548.91, "end": 557.98, "text": "子昀,"}, {"start": 557.98, "end": 559.98, "text": "告诉荆州陆迅,"}, {"start": 559.98, "end": 561.98, "text": "上采诸环,"}, {"start": 561.98, "end": 564.98, "text": "严加操练三军,"}, {"start": 564.98, "end": 578.99, "text": "严防曹匹来犯。"}, {"start": 578.99, "end": 580.99, "text": "丞相,"}, {"start": 580.99, "end": 584.99, "text": "草魏的四路大军全都败退了。"}, {"start": 584.99, "end": 586.99, "text": "据报,"}, {"start": 586.99, "end": 588.99, "text": "吴王森权的四路大军"}, {"start": 588.99, "end": 590.99, "text": "未派一兵一组。"}, {"start": 590.99, "end": 592.99, "text": "尤长啊,"}, {"start": 592.99, "end": 594.99, "text": "此次退敌,"}, {"start": 594.99, "end": 596.99, "text": "你可居首功,"}, {"start": 596.99, "end": 598.99, "text": "本相要多谢你了。"}, {"start": 598.99, "end": 601.99, "text": "学生蒙先生教诲多年,"}, {"start": 601.99, "end": 603.99, "text": "略尽棉薄而已,"}, {"start": 603.99, "end": 605.99, "text": "万万不敢居功。"}, {"start": 605.99, "end": 608.99, "text": "此次草批五路法蜀之策,"}, {"start": 609.99, "end": 612.99, "text": "你知道是出自谁的主意吗?"}, {"start": 612.99, "end": 614.99, "text": "消息虽不确切,"}, {"start": 614.99, "end": 616.99, "text": "但在下听说,"}, {"start": 616.99, "end": 618.99, "text": "是一个叫司马怡的人,"}, {"start": 618.99, "end": 620.99, "text": "给草批出的主意。"}, {"start": 620.99, "end": 626.58, "text": "司马怡,"}, {"start": 626.58, "end": 628.58, "text": "字重达,"}, {"start": 628.58, "end": 630.58, "text": "年近五十,"}, {"start": 630.58, "end": 632.58, "text": "未居尚书右虎叶,"}, {"start": 632.58, "end": 634.58, "text": "一直是个文臣。"}, {"start": 634.58, "end": 637.58, "text": "在草批登大位之前,"}, {"start": 637.58, "end": 639.58, "text": "他一直是秦木流,"}, {"start": 639.58, "end": 642.58, "text": "此人从未领兵征战过,"}, {"start": 642.58, "end": 645.58, "text": "尚不知其兵法韬略如何。"}, {"start": 645.58, "end": 649.58, "text": "就凭他泄语草批的这一策,"}, {"start": 649.58, "end": 652.58, "text": "此人早晚会成为辅辟重臣。"}, {"start": 652.58, "end": 656.34, "text": "往后,"}, {"start": 656.34, "end": 658.34, "text": "你替我多留意着他。"}, {"start": 658.34, "end": 660.34, "text": "遵命。"}, {"start": 660.34, "end": 693.82, "text": "平身,"}, {"start": 693.82, "end": 706.42, "text": "此次法蜀,"}, {"start": 706.42, "end": 708.42, "text": "各路大军,"}, {"start": 708.42, "end": 710.42, "text": "皆是无功而返,"}, {"start": 710.42, "end": 712.42, "text": "徒号前两,"}, {"start": 713.42, "end": 715.42, "text": "你们说,"}, {"start": 715.42, "end": 717.42, "text": "此义,"}, {"start": 717.42, "end": 719.42, "text": "何在?"}, {"start": 719.42, "end": 728.87, "text": "殿下,"}, {"start": 728.87, "end": 730.87, "text": "我认为法蜀无功,"}, {"start": 730.87, "end": 732.87, "text": "它是孙权。"}, {"start": 732.87, "end": 734.87, "text": "他表面上答应殿下,"}, {"start": 734.87, "end": 736.87, "text": "出兵帮助,"}, {"start": 736.87, "end": 738.87, "text": "却却与蜀为盟。"}, {"start": 738.87, "end": 740.87, "text": "更可恨的是,"}, {"start": 740.87, "end": 742.87, "text": "孙权竟敢碰上我大魏之使。"}, {"start": 742.87, "end": 743.87, "text": "是可忍,"}, {"start": 743.87, "end": 744.87, "text": "孰不可忍。"}, {"start": 744.87, "end": 746.87, "text": "不错。"}, {"start": 746.87, "end": 750.34, "text": "花心,"}, {"start": 750.34, "end": 752.34, "text": "你做好了水师战船吗?"}, {"start": 752.34, "end": 755.82, "text": "殿下,"}, {"start": 755.82, "end": 757.82, "text": "三千艘战船"}, {"start": 757.82, "end": 759.82, "text": "已经完成了。"}, {"start": 759.82, "end": 761.82, "text": "五万水师将士"}, {"start": 761.82, "end": 763.82, "text": "正在整训中。"}, {"start": 763.82, "end": 765.82, "text": "龙舟十支,"}, {"start": 765.82, "end": 767.82, "text": "二十支,"}, {"start": 767.82, "end": 769.82, "text": "每周两千支。"}, {"start": 769.82, "end": 771.82, "text": "好。"}, {"start": 771.82, "end": 774.77, "text": "曹兄。"}, {"start": 774.77, "end": 776.77, "text": "在。"}, {"start": 776.77, "end": 778.77, "text": "两艘武器,"}, {"start": 778.77, "end": 780.77, "text": "如何?"}, {"start": 780.77, "end": 782.77, "text": "一百五十万弹,"}, {"start": 782.77, "end": 783.77, "text": "五十万弹,"}, {"start": 783.77, "end": 793.0, "text": "已运往河北等地。"}, {"start": 793.0, "end": 795.95, "text": "听旨!"}, {"start": 795.95, "end": 797.95, "text": "我决定。"}, {"start": 797.95, "end": 799.95, "text": "其水陆大军,"}, {"start": 799.95, "end": 801.95, "text": "三十五万,"}, {"start": 801.95, "end": 802.95, "text": "秋后,"}, {"start": 802.95, "end": 804.95, "text": "会试发武。"}, {"start": 804.95, "end": 808.35, "text": "此意,"}, {"start": 808.35, "end": 812.62, "text": "要御驾钦证,"}, {"start": 812.62, "end": 814.62, "text": "破京乡。"}, {"start": 814.62, "end": 816.62, "text": "吃入环座!"}, {"start": 816.62, "end": 823.61, "text": "是!"}, {"start": 823.61, "end": 824.61, "text": "殿下,"}, {"start": 824.61, "end": 826.61, "text": "我法蜀无功,"}, {"start": 826.61, "end": 827.61, "text": "愧恨无疾。"}, {"start": 827.61, "end": 829.61, "text": "请殿下允许我,"}, {"start": 829.61, "end": 831.61, "text": "代罪出师。"}, {"start": 831.61, "end": 833.61, "text": "殿下,"}, {"start": 833.61, "end": 835.61, "text": "我愿做法蜀先锋,"}, {"start": 835.61, "end": 836.61, "text": "如若不赦,"}, {"start": 836.61, "end": 838.61, "text": "甘当军法。"}, {"start": 838.61, "end": 839.61, "text": "陛下,"}, {"start": 839.61, "end": 841.61, "text": "我愿随驾出征。"}, {"start": 841.61, "end": 842.61, "text": "陛下,"}, {"start": 842.61, "end": 844.61, "text": "我愿随驾出征。"}, {"start": 844.61, "end": 845.61, "text": "陛下,"}, {"start": 845.61, "end": 847.61, "text": "我也愿随驾出征。"}, {"start": 847.61, "end": 850.37, "text": "好。"}, {"start": 850.37, "end": 853.37, "text": "清党雄心壮志。"}, {"start": 853.37, "end": 854.37, "text": "我,"}, {"start": 854.37, "end": 862.83, "text": "深感欣慰。"}, {"start": 862.83, "end": 865.56, "text": "仲达,"}, {"start": 865.56, "end": 878.09, "text": "你为何不开言呢?"}, {"start": 878.09, "end": 882.55, "text": "臣请陛下降罪。"}, {"start": 882.55, "end": 883.55, "text": "爱卿,"}, {"start": 883.55, "end": 885.55, "text": "何罪之有?"}, {"start": 885.55, "end": 888.55, "text": "先前五路大军法蜀,"}, {"start": 888.55, "end": 890.55, "text": "盖出于臣。"}, {"start": 890.55, "end": 891.55, "text": "不料想,"}, {"start": 891.55, "end": 893.55, "text": "劳师无功,"}, {"start": 893.55, "end": 896.55, "text": "此臣之罪也。"}, {"start": 896.55, "end": 898.55, "text": "虽然陛下没有降罪,"}, {"start": 898.55, "end": 901.55, "text": "臣心何安?"}, {"start": 901.55, "end": 903.55, "text": "朕说过,"}, {"start": 903.55, "end": 905.55, "text": "法蜀无功,"}, {"start": 905.55, "end": 906.55, "text": "祸在孙泉。"}, {"start": 906.55, "end": 910.22, "text": "你不必自责。"}, {"start": 910.22, "end": 912.22, "text": "谢陛下宽容。"}, {"start": 912.22, "end": 916.22, "text": "不过臣还是要请陛下降罪。"}, {"start": 916.22, "end": 918.22, "text": "还有何罪?"}, {"start": 918.22, "end": 919.22, "text": "臣有一言,"}, {"start": 919.22, "end": 920.22, "text": "不说则无罪。"}, {"start": 920.22, "end": 921.22, "text": "说了,"}, {"start": 921.22, "end": 923.22, "text": "陛下定会降罪。"}, {"start": 923.22, "end": 925.66, "text": "说,说,说,说。"}, {"start": 925.66, "end": 926.66, "text": "说,说。"}, {"start": 926.66, "end": 944.93, "text": "臣请陛下不要兴兵伐吾。"}, {"start": 944.93, "end": 945.93, "text": "为何?"}, {"start": 945.93, "end": 947.93, "text": "既然法蜀无功,"}, {"start": 947.93, "end": 949.93, "text": "此祸在孙泉。"}, {"start": 949.93, "end": 951.93, "text": "如果我军伐吾,"}, {"start": 951.93, "end": 954.93, "text": "诸葛亮就不会圆吾了吗?"}, {"start": 954.93, "end": 955.93, "text": "臣以为,"}, {"start": 955.93, "end": 957.93, "text": "蜀无,"}, {"start": 957.93, "end": 960.93, "text": "如果联盟不出现劣系,"}, {"start": 960.93, "end": 963.93, "text": "法蜀法吾都难有胜算。"}, {"start": 963.93, "end": 965.93, "text": "那你有何建议?"}, {"start": 965.93, "end": 968.93, "text": "臣建议陛下效仿先帝,"}, {"start": 968.93, "end": 970.93, "text": "养兵屯田十年。"}, {"start": 970.93, "end": 971.93, "text": "十年之后,"}, {"start": 971.93, "end": 974.93, "text": "魏国将一发强大。"}, {"start": 974.93, "end": 975.93, "text": "而不用十年,"}, {"start": 975.93, "end": 978.93, "text": "吾蜀将再生裂痕。"}, {"start": 978.93, "end": 979.93, "text": "要么,"}, {"start": 979.93, "end": 981.93, "text": "诸葛亮起兵攻取荆州,"}, {"start": 981.93, "end": 982.93, "text": "要么,"}, {"start": 982.93, "end": 984.93, "text": "孙泉起兵攻取义州。"}, {"start": 984.93, "end": 986.93, "text": "而此时陛下,"}, {"start": 986.93, "end": 988.93, "text": "只需乘势用兵,"}, {"start": 988.93, "end": 990.93, "text": "军可一鼓而下。"}, {"start": 990.93, "end": 991.93, "text": "这,"}, {"start": 991.93, "end": 993.93, "text": "年近四巡,"}, {"start": 993.93, "end": 995.93, "text": "岂能坐等十年?"}, {"start": 995.93, "end": 1004.94, "text": "再者,"}, {"start": 1004.94, "end": 1006.94, "text": "如果吾蜀之间,"}, {"start": 1006.94, "end": 1008.94, "text": "不但不生劣系,"}, {"start": 1008.94, "end": 1010.94, "text": "反而联手用兵攻位,"}, {"start": 1010.94, "end": 1012.94, "text": "那朕不是坐视两地了吗?"}, {"start": 1012.94, "end": 1018.17, "text": "朕,"}, {"start": 1018.17, "end": 1020.17, "text": "法吾之志已决,"}, {"start": 1020.17, "end": 1021.17, "text": "断不刚改。"}, {"start": 1021.17, "end": 1026.08, "text": "司马夷,"}, {"start": 1027.08, "end": 1028.08, "text": "朕,"}, {"start": 1028.08, "end": 1030.08, "text": "不降罪于你,"}, {"start": 1030.08, "end": 1035.02, "text": "你就不必坠颜了。"}, {"start": 1035.02, "end": 1036.02, "text": "回家去吧。"}, {"start": 1036.02, "end": 1041.67, "text": "朕,"}, {"start": 1041.67, "end": 1042.67, "text": "要义兵了。"}, {"start": 1042.67, "end": 1053.79, "text": "臣遵旨。"}, {"start": 1053.79, "end": 1076.9, "text": "关门,"}, {"start": 1076.9, "end": 1083.92, "text": "为何劝陛下罢兵?"}, {"start": 1083.92, "end": 1084.92, "text": "那,"}, {"start": 1084.92, "end": 1088.2, "text": "那不是自寻其辱吗?"}, {"start": 1088.2, "end": 1090.2, "text": "我若不禁键,"}, {"start": 1090.2, "end": 1092.2, "text": "陛下更要降罪于我。"}, {"start": 1092.2, "end": 1093.2, "text": "什么?"}, {"start": 1093.2, "end": 1095.2, "text": "难道法吾之意会失败?"}, {"start": 1095.2, "end": 1096.2, "text": "必败无意。"}, {"start": 1096.2, "end": 1101.71, "text": "可,"}, {"start": 1101.71, "end": 1102.71, "text": "陛下建功之心,"}, {"start": 1102.71, "end": 1104.71, "text": "又如当年法吾的刘备。"}, {"start": 1105.71, "end": 1106.71, "text": "孙权,"}, {"start": 1106.71, "end": 1107.71, "text": "陆迅和等人呢?"}, {"start": 1108.71, "end": 1109.71, "text": "曹真,"}, {"start": 1109.71, "end": 1110.71, "text": "曹修,"}, {"start": 1110.71, "end": 1111.71, "text": "岂是他们的敌手?"}, {"start": 1111.71, "end": 1112.71, "text": "加之,"}, {"start": 1112.71, "end": 1113.71, "text": "诸葛亮,"}, {"start": 1113.71, "end": 1115.71, "text": "必然会在陛下法吾之时,"}, {"start": 1115.71, "end": 1116.71, "text": "遣上一上将,"}, {"start": 1116.71, "end": 1117.71, "text": "从西川出兵,"}, {"start": 1117.71, "end": 1118.71, "text": "直袭长安。"}, {"start": 1118.71, "end": 1120.71, "text": "陛下胜负可想而知。"}, {"start": 1120.71, "end": 1122.71, "text": "我是说也得罪,"}, {"start": 1122.71, "end": 1124.71, "text": "不说也得罪。"}, {"start": 1124.71, "end": 1126.71, "text": "既然罪则难辞,"}, {"start": 1126.71, "end": 1128.71, "text": "倒不如直面请罪,"}, {"start": 1128.71, "end": 1130.71, "text": "省得人家攻见我,"}, {"start": 1130.71, "end": 1131.71, "text": "心怀奸诈。"}, {"start": 1131.71, "end": 1135.24, "text": "父亲,"}, {"start": 1135.24, "end": 1137.24, "text": "自取今日享罪,"}, {"start": 1137.24, "end": 1139.24, "text": "以免日后大祸,"}, {"start": 1139.24, "end": 1142.81, "text": "而钦佩之至。"}, {"start": 1142.81, "end": 1144.81, "text": "此外你也看到了,"}, {"start": 1144.81, "end": 1147.81, "text": "陛下仍然气我不用啊,"}, {"start": 1147.81, "end": 1150.81, "text": "还是曹氏亲贵们随征。"}, {"start": 1177.27, "end": 1178.27, "text": "坐进来,"}, {"start": 1178.27, "end": 1179.27, "text": "你的劝阻,"}, {"start": 1179.27, "end": 1329.37, "text": "但朕此生,"}, {"start": 1329.37, "end": 1335.66, "text": "也只是个,"}, {"start": 1335.66, "end": 1337.66, "text": "无为之君罢了。"}, {"start": 1337.66, "end": 1339.66, "text": "陛下法吾,"}, {"start": 1339.66, "end": 1343.42, "text": "为何不让臣去呢?"}, {"start": 1343.42, "end": 1346.42, "text": "臣做梦都想着,"}, {"start": 1346.42, "end": 1349.42, "text": "能为陛下沙场建功啊?"}, {"start": 1349.42, "end": 1350.42, "text": "会用你的,"}, {"start": 1350.42, "end": 1356.45, "text": "先帝说过,"}, {"start": 1356.45, "end": 1357.45, "text": "只有你,"}, {"start": 1357.45, "end": 1363.96, "text": "不可量的对我一句话。"}, {"start": 1363.96, "end": 1366.4, "text": "陛下,"}, {"start": 1366.4, "end": 1378.86, "text": "司马怡,"}, {"start": 1378.86, "end": 1444.06, "text": "进中王室二十五年,"}, {"start": 1444.06, "end": 1446.06, "text": "勤勉扶正,"}, {"start": 1446.06, "end": 1448.06, "text": "志勇超群,"}, {"start": 1448.06, "end": 1449.06, "text": "任劳任怨,"}, {"start": 1449.06, "end": 1451.06, "text": "坚忍不拔,"}, {"start": 1451.06, "end": 1452.06, "text": "即,"}, {"start": 1452.06, "end": 1453.06, "text": "加授,"}, {"start": 1453.06, "end": 1456.06, "text": "彪继大将军一职,"}, {"start": 1456.06, "end": 1457.06, "text": "与大将军,"}, {"start": 1457.06, "end": 1458.06, "text": "曹真,"}, {"start": 1458.06, "end": 1460.06, "text": "大司马曹修,"}, {"start": 1460.06, "end": 1461.06, "text": "共同执掌,"}, {"start": 1461.06, "end": 1463.06, "text": "为国君政,"}, {"start": 1463.06, "end": 1465.06, "text": "钦此,"}, {"start": 1465.06, "end": 1467.06, "text": "相年四十。"}, {"start": 1467.06, "end": 1568.19, "text": "更好啦,"}, {"start": 1568.19, "end": 1569.19, "text": "你的主子,"}, {"start": 1569.19, "end": 1627.54, "text": "是老爷呀。"}, {"start": 1627.54, "end": 1630.11, "text": "也是我主子。"}, {"start": 1630.11, "end": 1634.83, "text": "你说的是皇上,"}, {"start": 1634.83, "end": 1646.04, "text": "这才四十岁啊。"}, {"start": 1646.04, "end": 1657.93, "text": "皇上四十岁就走了,"}, {"start": 1657.93, "end": 1664.83, "text": "可我司马怡五十多岁,"}, {"start": 1664.83, "end": 1666.83, "text": "才邓到张兵之权,"}, {"start": 1666.83, "end": 1667.83, "text": "曹天子,"}, {"start": 1667.83, "end": 1668.83, "text": "臣妻和,"}, {"start": 1668.83, "end": 1679.02, "text": "曹真,"}, {"start": 1679.02, "end": 1694.74, "text": "曹修,"}, {"start": 1694.74, "end": 1719.2, "text": "拜见吾皇。"}, {"start": 1719.2, "end": 1720.2, "text": "三叔四伯,"}, {"start": 1720.2, "end": 1721.2, "text": "不必多礼,"}, {"start": 1721.2, "end": 1722.2, "text": "来,"}, {"start": 1722.2, "end": 1723.2, "text": "看座。"}, {"start": 1723.2, "end": 1724.2, "text": "谢陛下。"}, {"start": 1724.2, "end": 1726.2, "text": "哎呀,"}, {"start": 1726.2, "end": 1729.77, "text": "哎呀,"}, {"start": 1729.77, "end": 1730.77, "text": "哎呀,"}, {"start": 1730.77, "end": 1731.77, "text": "哎呀,"}, {"start": 1731.77, "end": 1732.77, "text": "哎呀,"}, {"start": 1732.77, "end": 1733.77, "text": "哎呀,"}, {"start": 1733.77, "end": 1734.77, "text": "哎呀,"}, {"start": 1734.77, "end": 1737.77, "text": "陛下真乃天人哪,"}, {"start": 1737.77, "end": 1739.77, "text": "神采四溢,"}, {"start": 1739.77, "end": 1740.77, "text": "皇位灿烂,"}, {"start": 1740.77, "end": 1741.77, "text": "哎呀,"}, {"start": 1741.77, "end": 1742.77, "text": "昼得臣,"}, {"start": 1742.77, "end": 1744.77, "text": "眼睛都花了。"}, {"start": 1744.77, "end": 1747.77, "text": "臣刚进宫门,"}, {"start": 1747.77, "end": 1751.77, "text": "便感觉一股阴气扑面而至。"}, {"start": 1751.77, "end": 1754.77, "text": "我大魏有如此的圣君,"}, {"start": 1754.77, "end": 1756.77, "text": "真是天赐之幸也,"}, {"start": 1756.77, "end": 1758.77, "text": "天赐之幸啊。"}, {"start": 1758.77, "end": 1761.77, "text": "二位不但是朕的长辈,"}, {"start": 1761.77, "end": 1763.77, "text": "更是铸国重臣,"}, {"start": 1763.77, "end": 1766.77, "text": "以后要多教导朕才是。"}, {"start": 1766.77, "end": 1769.77, "text": "太祖和先帝未静之夜,"}, {"start": 1769.77, "end": 1772.77, "text": "定要在朕这一朝里完成。"}, {"start": 1772.77, "end": 1773.77, "text": "陛下壮志,"}, {"start": 1773.77, "end": 1775.77, "text": "如日当头,"}, {"start": 1775.77, "end": 1777.77, "text": "臣等陛下全马之劳。"}, {"start": 1777.77, "end": 1779.77, "text": "臣觉得,"}, {"start": 1779.77, "end": 1781.77, "text": "让外必先安内,"}, {"start": 1781.77, "end": 1783.77, "text": "陛下欲成大业,"}, {"start": 1783.77, "end": 1785.77, "text": "应当重整朝纲,"}, {"start": 1785.77, "end": 1787.77, "text": "提出宁臣才是。"}, {"start": 1787.77, "end": 1788.77, "text": "哦,"}, {"start": 1788.77, "end": 1790.77, "text": "谁是宁臣?"}, {"start": 1790.77, "end": 1791.77, "text": "陛下,"}, {"start": 1791.77, "end": 1795.77, "text": "太祖五皇帝曾对臣密言,"}, {"start": 1795.77, "end": 1798.77, "text": "司马仪应是狼顾,"}, {"start": 1798.77, "end": 1799.77, "text": "不可负于兵权,"}, {"start": 1799.77, "end": 1802.77, "text": "久之必为国之大患。"}, {"start": 1802.77, "end": 1806.77, "text": "司马仪暗藏大志,"}, {"start": 1806.77, "end": 1808.77, "text": "性情艰人,"}, {"start": 1808.77, "end": 1811.77, "text": "曾在先帝身边讨会多年。"}, {"start": 1811.77, "end": 1814.77, "text": "当年先帝没用,"}, {"start": 1814.77, "end": 1816.77, "text": "也必致之。"}, {"start": 1816.77, "end": 1817.77, "text": "不料,"}, {"start": 1817.77, "end": 1820.77, "text": "先帝临终前一时不察,"}, {"start": 1820.77, "end": 1822.77, "text": "竟让他篡得"}, {"start": 1822.77, "end": 1824.77, "text": "标记大将军之职,"}, {"start": 1824.77, "end": 1827.77, "text": "此甚为可忧啊。"}, {"start": 1827.77, "end": 1828.77, "text": "陛下,"}, {"start": 1828.77, "end": 1831.77, "text": "请恕臣直言,"}, {"start": 1831.77, "end": 1834.77, "text": "陛下临朝出政,"}, {"start": 1834.77, "end": 1836.77, "text": "非曹氏清贵,"}, {"start": 1836.77, "end": 1838.77, "text": "不可加以兵权。"}, {"start": 1838.77, "end": 1840.77, "text": "司马仪久蓄大志,"}, {"start": 1840.77, "end": 1842.77, "text": "精通兵略,"}, {"start": 1842.77, "end": 1844.77, "text": "其长子司马师,"}, {"start": 1844.77, "end": 1845.77, "text": "次子司马昭,"}, {"start": 1845.77, "end": 1847.77, "text": "也都生有异乡,"}, {"start": 1847.77, "end": 1849.77, "text": "这个司马家族,"}, {"start": 1849.77, "end": 1851.77, "text": "乃是百年之望族啊,"}, {"start": 1851.77, "end": 1853.77, "text": "其门生故旧,"}, {"start": 1853.77, "end": 1854.77, "text": "亲信蓬荡,"}, {"start": 1854.77, "end": 1856.77, "text": "遍布朝廷内外。"}, {"start": 1856.77, "end": 1860.08, "text": "陛下啊,"}, {"start": 1860.08, "end": 1864.08, "text": "昨夜臣偶得一噩梦,"}, {"start": 1864.08, "end": 1865.08, "text": "梦见三匹马,"}, {"start": 1865.08, "end": 1867.08, "text": "同草食草,"}, {"start": 1867.08, "end": 1868.08, "text": "梦醒,"}, {"start": 1868.08, "end": 1871.08, "text": "并觉豁然心惊。"}, {"start": 1871.08, "end": 1873.08, "text": "陛下,"}, {"start": 1873.08, "end": 1874.08, "text": "三马,"}, {"start": 1874.08, "end": 1875.08, "text": "便是司马仪,"}, {"start": 1875.08, "end": 1876.08, "text": "司马昭,"}, {"start": 1876.08, "end": 1877.08, "text": "司马师,"}, {"start": 1877.08, "end": 1878.08, "text": "食草,"}, {"start": 1878.08, "end": 1879.08, "text": "啊,"}, {"start": 1879.08, "end": 1881.08, "text": "食草啊。"}, {"start": 1881.08, "end": 1884.08, "text": "那朕该怎么办?"}, {"start": 1884.08, "end": 1891.81, "text": "依臣之见,"}, {"start": 1891.81, "end": 1894.81, "text": "应该把他贬出京都,"}, {"start": 1894.81, "end": 1895.81, "text": "派往边城,"}, {"start": 1895.81, "end": 1898.81, "text": "日后再逐步收拾。"}, {"start": 1898.81, "end": 1900.81, "text": "这样也好,"}, {"start": 1900.81, "end": 1903.81, "text": "司马仪罪行未险,"}, {"start": 1903.81, "end": 1905.81, "text": "如果咒然剿除,"}, {"start": 1905.81, "end": 1906.81, "text": "必起风波。"}, {"start": 1906.81, "end": 1907.81, "text": "这样吧,"}, {"start": 1907.81, "end": 1909.81, "text": "受司马仪为"}, {"start": 1909.81, "end": 1910.81, "text": "雍粮大都督,"}, {"start": 1910.81, "end": 1912.81, "text": "让他驻守边城,"}, {"start": 1912.81, "end": 1916.09, "text": "没有朕的旨意,"}, {"start": 1916.09, "end": 1918.09, "text": "不准回京。"}, {"start": 1918.09, "end": 1919.09, "text": "父亲,"}, {"start": 1919.09, "end": 1952.61, "text": "肯定有什么喜事,"}, {"start": 1952.61, "end": 1953.61, "text": "是吗?"}, {"start": 1953.61, "end": 1954.61, "text": "到底什么喜事?"}, {"start": 1954.61, "end": 1963.86, "text": "关门,"}, {"start": 1963.86, "end": 1964.86, "text": "快关门,"}, {"start": 1964.86, "end": 1965.86, "text": "父亲,"}, {"start": 1965.86, "end": 1968.94, "text": "你倒是说呀。"}, {"start": 1968.94, "end": 1977.5, "text": "如大海,"}, {"start": 1977.5, "end": 1979.5, "text": "龙出生天哪!"}, {"start": 1979.5, "end": 1985.86, "text": "若再待在京都,"}, {"start": 1985.86, "end": 1988.86, "text": "早晚会被奸人给害死。"}, {"start": 1988.86, "end": 1990.86, "text": "谁料曹尘"}, {"start": 1990.86, "end": 1992.86, "text": "曹修两个蠢负"}, {"start": 1992.86, "end": 1995.86, "text": "把我给贬到雍粮去了。"}, {"start": 1997.86, "end": 1999.86, "text": "他们不知啊,"}, {"start": 1999.86, "end": 2004.55, "text": "正是我梦寐以求的地方。"}, {"start": 2004.55, "end": 2006.55, "text": "更何况,"}, {"start": 2006.55, "end": 2008.55, "text": "雍粮虽属边城,"}, {"start": 2008.55, "end": 2011.55, "text": "却是魏国燕侯重镇。"}, {"start": 2011.55, "end": 2013.55, "text": "诸葛亮若敢犯境,"}, {"start": 2013.55, "end": 2016.55, "text": "天赐我剑功之机啊!"}, {"start": 2016.55, "end": 2026.14, "text": "帝创业未半,"}, {"start": 2026.14, "end": 2028.14, "text": "而中道崩促,"}, {"start": 2028.14, "end": 2030.14, "text": "今天下三分,"}, {"start": 2030.14, "end": 2032.14, "text": "一周疲弊,"}, {"start": 2032.14, "end": 2035.14, "text": "此城危及存亡之求也。"}, {"start": 2035.14, "end": 2036.14, "text": "然,"}, {"start": 2036.14, "end": 2039.14, "text": "侍卫之臣不屑于内,"}, {"start": 2039.14, "end": 2042.14, "text": "忠治之事望身于外州,"}, {"start": 2042.14, "end": 2044.14, "text": "改追先帝之疏欲,"}, {"start": 2044.14, "end": 2047.14, "text": "欲报于陛下也。"}, {"start": 2047.14, "end": 2051.14, "text": "臣本不宜功耕于南洋,"}, {"start": 2051.14, "end": 2053.14, "text": "勾全性命于乱世,"}, {"start": 2053.14, "end": 2056.14, "text": "不求文达于诸侯。"}, {"start": 2057.14, "end": 2059.14, "text": "先帝不以臣卑鄙,"}, {"start": 2059.14, "end": 2061.14, "text": "唯以自枉趣,"}, {"start": 2061.14, "end": 2064.14, "text": "三顾臣于草庐之中,"}, {"start": 2064.14, "end": 2066.14, "text": "资臣以当世之事,"}, {"start": 2066.14, "end": 2068.14, "text": "犹世感激,"}, {"start": 2068.14, "end": 2071.14, "text": "遂许先帝以屈耻。"}, {"start": 2071.14, "end": 2072.14, "text": "后职清复,"}, {"start": 2072.14, "end": 2074.14, "text": "授任于败君之际,"}, {"start": 2074.14, "end": 2076.14, "text": "奉命于危难之间,"}, {"start": 2076.14, "end": 2079.14, "text": "而来二十又一年矣。"}, {"start": 2079.14, "end": 2083.51, "text": "先帝知臣谨慎,"}, {"start": 2083.51, "end": 2086.51, "text": "故灵崩祭臣以大事矣,"}, {"start": 2086.51, "end": 2088.51, "text": "臣受命以来,"}, {"start": 2088.51, "end": 2090.51, "text": "夙夜忧叹,"}, {"start": 2090.51, "end": 2092.51, "text": "唯恐托付不孝,"}, {"start": 2092.51, "end": 2094.51, "text": "以伤先帝之命。"}, {"start": 2094.51, "end": 2096.51, "text": "今南方已定,"}, {"start": 2096.51, "end": 2098.51, "text": "兵甲已足,"}, {"start": 2098.51, "end": 2100.51, "text": "当蒋率三军,"}, {"start": 2100.51, "end": 2102.51, "text": "北定中原,"}, {"start": 2102.51, "end": 2104.51, "text": "竖截弩盾,"}, {"start": 2104.51, "end": 2105.51, "text": "让除奸凶,"}, {"start": 2105.51, "end": 2107.51, "text": "兴复汉室,"}, {"start": 2107.51, "end": 2109.51, "text": "还于旧都。"}, {"start": 2109.51, "end": 2117.58, "text": "愿陛下托臣以讨贼兴复之孝,"}, {"start": 2117.58, "end": 2119.58, "text": "不孝则治臣之罪,"}, {"start": 2119.58, "end": 2121.58, "text": "以告先帝之灵,"}, {"start": 2121.58, "end": 2124.58, "text": "臣不慎受恩感激,"}, {"start": 2124.58, "end": 2126.58, "text": "灵表替灵,"}, {"start": 2126.58, "end": 2131.62, "text": "不知所欲。"}, {"start": 2131.62, "end": 2133.62, "text": "相父七情梦霍,"}, {"start": 2133.62, "end": 2135.62, "text": "刚刚顶定了南荒,"}, {"start": 2135.62, "end": 2137.62, "text": "现在座位未安,"}, {"start": 2137.62, "end": 2139.62, "text": "又要北伐中原,"}, {"start": 2139.62, "end": 2140.62, "text": "这,"}, {"start": 2140.62, "end": 2143.62, "text": "这叫震兴和安哪。"}, {"start": 2143.62, "end": 2145.62, "text": "臣之所以南征,"}, {"start": 2145.62, "end": 2147.62, "text": "正是为了北伐,"}, {"start": 2147.62, "end": 2149.62, "text": "后方不定,"}, {"start": 2149.62, "end": 2150.62, "text": "不可举兵,"}, {"start": 2150.62, "end": 2152.62, "text": "如今南方已平,"}, {"start": 2152.62, "end": 2153.62, "text": "无后顾之忧,"}, {"start": 2153.62, "end": 2156.62, "text": "如不趁此讨贼恢复中原,"}, {"start": 2156.62, "end": 2158.62, "text": "更待何时。"}, {"start": 2158.62, "end": 2163.98, "text": "丞相壮志,"}, {"start": 2163.98, "end": 2165.98, "text": "令在下敬畏不已,"}, {"start": 2165.98, "end": 2166.98, "text": "不过,"}, {"start": 2166.98, "end": 2167.98, "text": "曹尉势大,"}, {"start": 2167.98, "end": 2170.98, "text": "极难图之。"}, {"start": 2170.98, "end": 2172.98, "text": "我川蜀,"}, {"start": 2172.98, "end": 2174.98, "text": "乃天府之国,"}, {"start": 2174.98, "end": 2176.98, "text": "山川显耀,"}, {"start": 2176.98, "end": 2178.98, "text": "田广良丰,"}, {"start": 2178.98, "end": 2180.98, "text": "即使不图之,"}, {"start": 2180.98, "end": 2183.98, "text": "也足可以立足于天下。"}, {"start": 2183.98, "end": 2189.39, "text": "丞相何必轻身负险呢?"}, {"start": 2189.39, "end": 2191.39, "text": "正方此言差矣,"}, {"start": 2191.39, "end": 2193.39, "text": "川蜀之地虽广,"}, {"start": 2193.39, "end": 2195.39, "text": "却是偏居异余。"}, {"start": 2195.39, "end": 2197.39, "text": "如果只图顾守,"}, {"start": 2197.39, "end": 2199.39, "text": "那么十年二十年尚可,"}, {"start": 2199.39, "end": 2201.39, "text": "五十年之后就难说了。"}, {"start": 2201.39, "end": 2203.39, "text": "如果川蜀之地"}, {"start": 2203.39, "end": 2205.39, "text": "真的可以永保太平,"}, {"start": 2205.39, "end": 2207.39, "text": "那么四百年前太祖皇帝刘邦"}, {"start": 2207.39, "end": 2209.39, "text": "为何还要出川北伐,"}, {"start": 2209.39, "end": 2211.39, "text": "夺中原征天下?"}, {"start": 2211.39, "end": 2215.39, "text": "因为太祖皇帝目光远大,"}, {"start": 2215.39, "end": 2218.39, "text": "他声明我不伐人,"}, {"start": 2218.39, "end": 2220.39, "text": "人必伐我,"}, {"start": 2220.39, "end": 2221.39, "text": "只求自保,"}, {"start": 2221.39, "end": 2222.39, "text": "断不能自保,"}, {"start": 2222.39, "end": 2224.39, "text": "唯有进取,"}, {"start": 2224.39, "end": 2226.39, "text": "方能成大业。"}, {"start": 2226.39, "end": 2232.16, "text": "陛下,"}, {"start": 2232.16, "end": 2234.16, "text": "臣夜观天下,"}, {"start": 2234.16, "end": 2236.16, "text": "北方王器正盛,"}, {"start": 2236.16, "end": 2239.16, "text": "只恐未可图言。"}, {"start": 2239.16, "end": 2242.57, "text": "臣既观天下,"}, {"start": 2242.57, "end": 2244.57, "text": "夜观天道,"}, {"start": 2244.57, "end": 2246.57, "text": "甚至天道无常,"}, {"start": 2246.57, "end": 2248.57, "text": "岂可拘泥。"}, {"start": 2248.57, "end": 2255.14, "text": "陛下,"}, {"start": 2255.14, "end": 2257.14, "text": "臣举兵后,"}, {"start": 2257.14, "end": 2259.14, "text": "当先驻军在汉中,"}, {"start": 2259.14, "end": 2260.14, "text": "居高临下,"}, {"start": 2260.14, "end": 2261.14, "text": "虎尸洛阳,"}, {"start": 2261.14, "end": 2263.14, "text": "待查明情形,"}, {"start": 2263.14, "end": 2265.14, "text": "便直取两经。"}, {"start": 2265.14, "end": 2266.14, "text": "若不胜,"}, {"start": 2266.14, "end": 2269.14, "text": "臣甘受枉法。"}, {"start": 2269.14, "end": 2274.6, "text": "听旨。"}, {"start": 2274.6, "end": 2280.58, "text": "朕拜诸葛亮为平北大都督,"}, {"start": 2280.58, "end": 2281.58, "text": "兼领臣相,"}, {"start": 2281.58, "end": 2282.58, "text": "易周牧,"}, {"start": 2282.58, "end": 2284.58, "text": "五湘侯,"}, {"start": 2284.58, "end": 2286.58, "text": "择日进军法位。"}, {"start": 2286.58, "end": 2289.58, "text": "择日。"}, {"start": 2289.58, "end": 2290.58, "text": "蜀国将领,"}, {"start": 2290.58, "end": 2292.58, "text": "竟凭相父选用。"}, {"start": 2292.58, "end": 2308.62, "text": "众将听令。"}, {"start": 2308.62, "end": 2310.62, "text": "龙湘将军关兴,"}, {"start": 2310.62, "end": 2312.62, "text": "为左护卫士。"}, {"start": 2312.62, "end": 2314.62, "text": "虎翼将军张包,"}, {"start": 2314.62, "end": 2316.62, "text": "为右护卫士。"}, {"start": 2316.62, "end": 2318.62, "text": "督廷侯卫延,"}, {"start": 2318.62, "end": 2320.62, "text": "为正北将军。"}, {"start": 2320.62, "end": 2321.62, "text": "臣苍侯马代,"}, {"start": 2321.62, "end": 2323.62, "text": "为平北将军。"}, {"start": 2323.62, "end": 2324.62, "text": "参军马苏,"}, {"start": 2324.62, "end": 2327.62, "text": "为安远将军。"}, {"start": 2327.62, "end": 2328.62, "text": "遵命。"}, {"start": 2328.62, "end": 2329.62, "text": "李辉,"}, {"start": 2329.62, "end": 2332.62, "text": "为安汉将军。"}, {"start": 2332.62, "end": 2333.62, "text": "廖化,"}, {"start": 2333.62, "end": 2335.62, "text": "为前军副将。"}, {"start": 2335.62, "end": 2336.62, "text": "王平,"}, {"start": 2336.62, "end": 2337.62, "text": "为毕将军。"}, {"start": 2337.62, "end": 2338.62, "text": "元凌,"}, {"start": 2338.62, "end": 2339.62, "text": "为前将军。"}, {"start": 2339.62, "end": 2340.62, "text": "吴易,"}, {"start": 2340.62, "end": 2341.62, "text": "为左将军。"}, {"start": 2341.62, "end": 2342.62, "text": "高祥,"}, {"start": 2342.62, "end": 2343.62, "text": "为右将军。"}, {"start": 2343.62, "end": 2344.62, "text": "邓芝,"}, {"start": 2344.62, "end": 2346.62, "text": "为监军使。"}, {"start": 2346.62, "end": 2347.62, "text": "丁贤,"}, {"start": 2347.62, "end": 2348.62, "text": "刘敏,"}, {"start": 2348.62, "end": 2350.62, "text": "为左右护军。"}, {"start": 2350.62, "end": 2351.62, "text": "杜易,"}, {"start": 2351.62, "end": 2352.62, "text": "为参军。"}, {"start": 2352.62, "end": 2353.62, "text": "严彦,"}, {"start": 2353.62, "end": 2355.62, "text": "为行参军。"}, {"start": 2355.62, "end": 2356.62, "text": "樊齐,"}, {"start": 2356.62, "end": 2358.62, "text": "为随军主部。"}, {"start": 2358.62, "end": 2359.62, "text": "樊建,"}, {"start": 2359.62, "end": 2361.62, "text": "为典军书记。"}, {"start": 2361.62, "end": 2367.87, "text": "高祥,"}, {"start": 2367.87, "end": 2368.87, "text": "为何不用我呀?"}, {"start": 2368.87, "end": 2378.1, "text": "子隆啊,"}, {"start": 2378.1, "end": 2380.1, "text": "你已年过半百。"}, {"start": 2380.1, "end": 2383.47, "text": "数日前,"}, {"start": 2383.47, "end": 2385.47, "text": "马超刚刚禀告,"}, {"start": 2385.47, "end": 2388.47, "text": "先帝的五湖上将,"}, {"start": 2388.47, "end": 2391.47, "text": "如今只剩你一个人了。"}, {"start": 2391.47, "end": 2394.47, "text": "我不愿让你再驰骋战场了,"}, {"start": 2394.47, "end": 2397.47, "text": "还是留守成都吧。"}, {"start": 2397.47, "end": 2401.14, "text": "自我随先帝以来,"}, {"start": 2401.14, "end": 2404.54, "text": "大小战事,"}, {"start": 2404.54, "end": 2406.54, "text": "无不当先。"}, {"start": 2406.54, "end": 2412.24, "text": "今日五湖上将已故其次,"}, {"start": 2412.24, "end": 2415.24, "text": "我是更觉得寂寞呀。"}, {"start": 2415.24, "end": 2418.65, "text": "若今天丞相,"}, {"start": 2418.65, "end": 2421.65, "text": "不令我做这个先锋,"}, {"start": 2421.65, "end": 2424.65, "text": "我便一头撞死在这柱子上。"}, {"start": 2424.65, "end": 2429.85, "text": "子隆听礼,"}, {"start": 2429.85, "end": 2432.85, "text": "封你为先锋大将,"}, {"start": 2432.85, "end": 2434.85, "text": "应精兵两万,"}, {"start": 2434.85, "end": 2436.85, "text": "副将十元。"}, {"start": 2436.85, "end": 2439.1, "text": "领命。"}, {"start": 2449.79, "end": 2451.79, "text": "在平定南方后,"}, {"start": 2451.79, "end": 2453.79, "text": "为保刘备兴旱之日,"}, {"start": 2453.79, "end": 2455.79, "text": "脱孤之人,"}, {"start": 2455.79, "end": 2457.79, "text": "禁起蜀军出秦山,"}, {"start": 2457.79, "end": 2461.79, "text": "开始第一次北伐大业。"}, {"start": 2462.79, "end": 2464.79, "text": "蜀军一出,"}, {"start": 2464.79, "end": 2466.79, "text": "天下震动。"}]